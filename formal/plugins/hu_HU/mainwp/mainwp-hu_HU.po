msgstr "A biztonsági mentés alkalmazásához használja a visszaállítást."

#: pages/backup/page-mainwp-backup-snapshots-view.php:480
msgid "Retry rollback"
msgstr "A visszaállás újrapróbálása"

#: pages/backup/page-mainwp-backup-snapshots-view.php:498
msgid "A backup or restore is running on this site. Wait for it to finish."
msgstr "Ezen a webhelyen biztonsági mentés vagy visszaállítás van folyamatban. Kérjük, várja meg a befejezését."

#: pages/backup/page-mainwp-backup-snapshots-view.php:499
