#: pages/page-mainwp-password-policy-settings.php:437
#: pages/page-mainwp-password-policy-settings.php:584
msgid "Users with wp-admin access (edit_posts and above)"
msgstr "wp-admin-hozzáféréssel rendelkező felhasználók (edit_posts jogosultsággal vagy magasabb jogosultsággal)"

#: pages/page-mainwp-password-policy-settings.php:438
