msgstr "A visszaállítás leállása előtt a biztonsági mentésből származó fájlok egy része már átkerülhetett a webhelyre. Az átmásolt fájlok a helyükön maradnak."

#: pages/backup/page-mainwp-backup-snapshots-view.php:468
msgid "No files were changed."
msgstr "Egyetlen fájl sem változott."

#: pages/backup/page-mainwp-backup-snapshots-view.php:469
msgid "The database was restored from the backup."
msgstr "Az adatbázist visszaállították a biztonsági mentésből."

#: pages/backup/page-mainwp-backup-snapshots-view.php:470
msgid "The database may be partly restored and may not match the backup."
msgstr "Előfordulhat, hogy az adatbázis visszaállítása csak részben történt meg, ezért nem feltétlenül egyezik a biztonsági mentéssel."

#: pages/backup/page-mainwp-backup-snapshots-view.php:471
msgid "The database was not changed."
msgstr "Az adatbázis nem változott."

#: pages/backup/page-mainwp-backup-snapshots-view.php:472
msgid "The database was put back the way it was before the restore."
msgstr "Az adatbázis visszakerült a visszaállítás előtti állapotába."

#: pages/backup/page-mainwp-backup-snapshots-view.php:473
msgid "The restore stopped before it changed anything on the site."
msgstr "A visszaállítás még azelőtt leállt, hogy bármit megváltoztatott volna a webhelyen."

#: pages/backup/page-mainwp-backup-snapshots-view.php:474
msgid ""
"The site's restore report could not be read, so files or database tables may"
" be partly restored."
msgstr "A webhely visszaállítási jelentése nem volt olvasható, ezért előfordulhat, hogy a fájlok vagy adatbázistáblák visszaállítása csak részben történt meg."

#: pages/backup/page-mainwp-backup-snapshots-view.php:475
