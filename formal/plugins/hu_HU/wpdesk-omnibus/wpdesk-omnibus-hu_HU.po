#. Plugin Name of the plugin
#: wpdesk-omnibus.php:3
msgid "Omnibus for WooCommerce"
msgstr "Omnibus for WooCommerce"

#. Plugin URI of the plugin
#: wpdesk-omnibus.php:4
msgid "https://www.wpdesk.pl/sk/wp-desk-omnibus-plugin/"
msgstr "https://www.wpdesk.pl/sk/wp-desk-omnibus-plugin/"

#. Description of the plugin
#: wpdesk-omnibus.php:5
msgid ""
"100% compliance with the EU Omnibus directive. Automatically displays the "
"lowest product price from the last 30 days."
msgstr "100%-os megfelelés az EU omnibusz irányelvének. Automatikusan megjeleníti az elmúlt 30 nap legalacsonyabb termékárát."

#. Author of the plugin
#: wpdesk-omnibus.php:8
msgid "WP Desk"
msgstr "WP Desk"

#. Author URI of the plugin
#: wpdesk-omnibus.php:9
msgid "https://www.wpdesk.pl/sk/wp-desk-omnibus-author/"
msgstr "https://www.wpdesk.pl/sk/wp-desk-omnibus-author/"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:49
msgid "General Omnibus settings"
msgstr "Általános Omnibus-beállítások"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:53
msgid "Date interval"
msgstr "Dátumintervallum"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:54
msgid "Decide how many days to look back, when searching for lowest price"
msgstr "Adja meg, hány napra visszamenőleg keresse a legalacsonyabb árat"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:64
msgid "Method of finding the lowest price"
msgstr "A legalacsonyabb ár megkeresésének módja"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:65
msgid "Choose how to seek for product's lowest price."
msgstr "Válassza ki, hogyan keresse meg a termék legalacsonyabb árát."

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:69
msgid "Find the lowest price for product since current date"
msgstr "A termék legalacsonyabb árának megkeresése az aktuális dátumtól kezdve"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:70
msgid "Find the lowest price since product's last promotion date"
msgstr "A legalacsonyabb ár megkeresése a termék legutóbbi akciójának dátumától kezdve"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:76
msgid "Current price is the lowest"
msgstr "Az aktuális ár a legalacsonyabb"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:77
msgid ""
"Choose how to behave, when current product's price is the lowest, e.g. you "
"didn't change price longer than lookup period or you just start to use "
"Omnibus."
msgstr "Válassza ki, hogyan járjon el, ha az aktuális termékár a legalacsonyabb, például ha a keresési időszak alatt nem módosította az árat, vagy most kezdi használni az Omnibus bővítményt."

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:81
msgid "Display message as usual"
msgstr "Üzenet megjelenítése a megszokott módon"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:82
msgid "Don't display any message"
msgstr "Üzenet megjelenítésének mellőzése"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:88
msgid "Display the lowest price only for promotional products"
msgstr "A legalacsonyabb ár megjelenítése csak akciós termékeknél"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:89
msgid ""
"When displaying a message about the lowest price for a product, show it only"
" for a product which is currently on promotion."
msgstr "A termék legalacsonyabb áráról szóló üzenet megjelenítésekor csak az éppen akciós termékeknél jelenjen meg az üzenet."

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:96
msgid "Method of displaying message for product variations"
msgstr "Az üzenet megjelenítésének módja a termékváltozatoknál"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:97
msgid ""
"Decide whether you want to show a cumulative value for your products' "
"variants or each of them should be treated separately."
msgstr "Döntse el, hogy a termékváltozatok összesített értékét szeretné megjeleníteni, vagy mindegyiket külön szeretné kezelni."

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:101
msgid "Display each product variant separately"
msgstr "Minden termékváltozat külön megjelenítése"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:102
msgid "Show one, the lowest price from across all product's variants"
msgstr "Egy ár megjelenítése: az összes termékváltozat közül a legalacsonyabb"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:108
msgid "Use sale prices"
msgstr "Akciós árak használata"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:109
msgid "Include sale prices when counting the lowest price."
msgstr "Az akciós árak figyelembevétele a legalacsonyabb ár kiszámításakor."

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:116
msgid "The lowest price message"
msgstr "A legalacsonyabb árra vonatkozó üzenet"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:122
#: src/WPDesk/Omnibus/Core/PriceMessage/Formatter/RichMessageFormatter.php:65
msgid "The lowest price ({date}): {price}"
msgstr "A legalacsonyabb ár ({date}): {price}"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:124
#, php-format
msgid ""
"Available tags:</br><code>{date}</code>: the lowest price date formatted as "
"<em>%s</em></br><code>{price}</code>: the lowest price "
"value</br><code>{days}</code>: the value of date interval option"
msgstr "Elérhető címkék:</br><code>{date}</code>: a legalacsonyabb ár dátuma <em>%s</em> formátumban</br><code>{price}</code>: a legalacsonyabb ár értéke</br><code>{days}</code>: a dátumintervallum beállítás értéke"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:127
msgid "Customize the message displaying the lowest price."
msgstr "A legalacsonyabb árat megjelenítő üzenet testreszabása."

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:136
msgid "Omnibus message placement settings"
msgstr "Az Omnibus-üzenet elhelyezésének beállításai"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:137
msgid ""
"Choose, where to place the message. You can pick one of standard WooCommerce"
" hooks or add here your own custom hook which will be used to display "
"message.</br>Use the shortcodes <code>[omnibus_price]</code> and "
"<code>[omnibus_price_message]</code> to display the price thru text "
"editors.</br>If you'd like to display the price of a variable product by the"
" shortcode add the variant ID to it. Example: <code>[omnibus_price "
"ID=\"111\"]</code>"
msgstr "Válassza ki, hol jelenjen meg az üzenet. Választhat a szabványos WooCommerce hookok közül, vagy megadhat egy egyéni hookot, amely az üzenet megjelenítésére szolgál.</br>Az ár szövegszerkesztőkben történő megjelenítéséhez használja a <code>[omnibus_price]</code> és a <code>[omnibus_price_message]</code> shortcode-ot.</br>Ha egy változó termék árát szeretné megjeleníteni shortcode-dal, adja hozzá a termékváltozat ID-ját. Példa: <code>[omnibus_price ID=\"111\"]</code>"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:141
msgid "Display message on product page"
msgstr "Üzenet megjelenítése a termékoldalon"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:153
msgid "Display message on archive page (shop page, category, tag, attributes)"
msgstr "Üzenet megjelenítése az archívumoldalon (áruházoldal, kategória, címke, attribútumok)"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:164
msgid "Display message on cart page"
msgstr "Üzenet megjelenítése a kosároldalon"

#: src/WPDesk/Omnibus/Core/Admin/PluginOptions.php:219
