#: vendor_prefixed/wpdesk/wp-plugin-update-reminder/src/NoticeReminder.php:48
#, php-format
msgid ""
"You're using an outdated version of the following plugin: %s This may cause "
"serious compatibility issues with WooCommerce. Update it immediately to "
"avoid potential disruptions."
msgid_plural ""
"You're using outdated versions of the following plugins: %s This may cause "
"serious compatibility issues with WooCommerce. Update them immediately to "
"avoid potential disruptions."
msgstr[0] "Az alábbi bővítmény elavult verzióját használja: %s. Ez súlyos kompatibilitási problémákat okozhat a WooCommerce-szel. A fennakadások elkerülése érdekében azonnal frissítse."
msgstr[1] "Az alábbi bővítmények elavult verzióit használja: %s. Ezek súlyos kompatibilitási problémákat okozhatnak a WooCommerce-szel. A fennakadások elkerülése érdekében azonnal frissítse őket."

#: vendor_prefixed/wpdesk/wp-plugin-update-reminder/src/NoticeReminder.php:55
#, php-format
msgid ""
