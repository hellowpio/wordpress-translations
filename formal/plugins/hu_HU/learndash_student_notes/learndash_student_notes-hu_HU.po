msgid "Email"
msgstr "E-mail"

#: admin/sections/class-learndash-notes-settings-section-email.php:80
msgid "New Student Note: {student_first_name} {student_last_name}"
msgstr "Új tanulói jegyzet: {student_first_name} {student_last_name}"

#: admin/sections/class-learndash-notes-settings-section-email.php:81
msgid ""
"Hello {instructor_first_name},<br><br>A student has submitted a new note for"
" your review.<br><br><strong>Student:</strong> {student_first_name} "
"{student_last_name} ({student_user_name})<br><strong>Course/Lesson:</strong>"
" {instructor_post_link}<br><br>Please review the note and respond as "
"needed.<br>"
msgstr "Kedves {instructor_first_name}!<br><br>Egy tanuló új jegyzetet küldött be ellenőrzésre.<br><br><strong>Tanuló:</strong> {student_first_name} {student_last_name} ({student_user_name})<br><strong>Kurzus/lecke:</strong> {instructor_post_link}<br><br>Kérjük, tekintse át a jegyzetet, és szükség szerint válaszoljon rá.<br>"

