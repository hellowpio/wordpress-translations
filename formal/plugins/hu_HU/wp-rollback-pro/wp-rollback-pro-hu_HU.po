msgstr "Nem találhatók történések"

#. translators: %s: Type of activity (Plugin/Theme)
#: build/tools.js:10
#, js-format
msgid "%s activity will be logged here."
msgstr "%s történései itt lesznek naplózva."

#: build/tools.js:10
msgid "Available updates"
