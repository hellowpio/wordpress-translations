msgstr "Telepítve: %1$s %2$s"

#: build/tools.js:7
msgid "Choose version"
msgstr "Verzió kiválasztása"

#. translators: %s: search term
#: build/tools.js:8
#, js-format
msgid "No installed plugin or theme matches “%s”."
msgstr "Nincs olyan telepített bővítmény vagy sablon, amely illeszkedik ehhez: „%s”."

#. translators: %s: count of installed plugins/themes
#: build/tools.js:9
#, js-format
msgid "%s installed plugin or theme is ready to roll back."
msgid_plural "%s installed plugins and themes are ready to roll back."
msgstr[0] "%s telepített bővítmény vagy sablon készen áll a visszaállításra."
msgstr[1] "A visszaállításra kész telepített bővítmények és sablonok száma: %s."

#: build/tools.js:9
