#: build/tools.js:2
msgid ""
"Your WP Rollback Pro license has expired. Please renew your license or enter"
" an active license key below to continue using Pro features."
msgstr "A WP Rollback Pro licence lejárt. Kérjük, újítsa meg a licencét, vagy adjon meg alább egy aktív licenckulcsot a Pro-funkciók további használatához."

#: build/tools.js:2
msgid ""
"Your license is active but not registered for this domain. Please register "
"your license below to continue."
msgstr "A licence aktív, de nincs regisztrálva ehhez a domainhez. Kérjük, a folytatáshoz regisztrálja alább a licencét."

#: build/tools.js:2
msgid ""
"Your WP Rollback Pro license key is invalid or has been disabled. Please "
"enter a valid license key below to continue."
msgstr "A WP Rollback Pro licenckulcsa hibás vagy ki van kapcsolva. Kérjük, adjon meg alább egy érvényes licenckulcsot a folytatáshoz."

#: build/tools.js:2
msgid ""
"A valid license is required to access WP Rollback Pro features. Please "
"activate your license below to continue."
msgstr "A WP Rollback Pro funkcióinak eléréséhez érvényes licenc szükséges. Kérjük, aktiválja lent a licencet a folytatáshoz."

#: build/tools.js:2
msgid "License Management"
msgstr "Licenckezelés"

#: build/tools.js:2
msgid ""
"Activate your WP Rollback Pro license to unlock Plugin Vault, premium "
"plugin/theme rollbacks, the WP-CLI commands, and email status reports."
msgstr "Aktiválja a WP Rollback Pro licencét a Plugin Vault, a prémium bővítmények és sablonok visszaállítása, a WP-CLI-parancsok és az e-mailes állapotjelentések használatához."

#: build/tools.js:2
msgid "License status"
msgstr "A licenc állapota"

#: build/tools.js:2
msgid "Current activation state and the domain this license is bound to."
msgstr "A licenc aktuális aktiválási állapota és az a domain, amelyhez a licenc hozzá van rendelve."

#: build/tools.js:2
msgid "Domain"
msgstr "Domain"

#: build/tools.js:2
msgid "License key"
msgstr "Licenckulcs"

#: build/tools.js:2 build/tools.js:35
msgid "Activate your license"
msgstr "Aktiválja licencét"

#: build/tools.js:2
msgid "Manage your license"
msgstr "Licenc kezelése"

#: build/tools.js:2
msgid ""
"Paste the license key from your purchase confirmation email to activate this"
" site."
msgstr "A webhely aktiválásához illessze be a vásárlást visszaigazoló e-mailben kapott licenckulcsot."

#: build/tools.js:2
msgid ""
"Deactivate this license here if you need to move it to a different site."
msgstr "Ha másik webhelyre szeretné áthelyezni, itt kapcsolja ki ezt a licencet."

#: build/tools.js:2
msgid "Configuration error"
msgstr "Konfigurációs hiba"

#: build/tools.js:2
msgid ""
"License configuration could not be loaded. Please check your plugin setup or"
" contact support."
msgstr "A licenc konfigurációja nem tölthető be. Kérjük, ellenőrizze a bővítmény beállításait, vagy kérjen támogatást."

#: build/tools.js:2
msgid "Archive Settings"
msgstr "Archívumbeállítások"

#: build/tools.js:2
msgid ""
"Configure how many version archives are stored for each plugin and theme. "
"When an asset is updated, the previous version is automatically backed up "
"for rollback purposes."
msgstr "Állítsa be, hogy bővítményenként és sablononként hány verzióarchívumot tároljon. Egy elem frissítésekor az előző verzió automatikusan biztonsági mentésként kerül tárolásra a visszaállításhoz."

#: build/tools.js:2
msgid "Storage limits"
msgstr "Tárolási korlátok"

#: build/tools.js:2
msgid ""
"Each plugin and theme keeps up to this many backup versions on disk. Older "
"backups roll off automatically when the limit is reached."
msgstr "Minden bővítmény és sablon legfeljebb ennyi biztonsági mentési verziót tárol a lemezen. A korlát elérésekor a régebbi mentések automatikusan törlődnek."

#: build/tools.js:2
msgid "Number of version archives per asset"
msgstr "Verzióarchívumok száma elemenként"

#: build/tools.js:2
msgid ""
"The maximum number of backup versions to keep for each plugin and theme. "
"Minimum: 1, Maximum: 100."
msgstr "Az egyes bővítményekhez és sablonokhoz megőrzendő biztonsági mentési verziók maximális száma. Minimum: 1, maximum: 100."

#: build/tools.js:2
msgid ""
"Reducing the archive limit will permanently delete older backup versions to "
"match the new limit. This action cannot be undone."
msgstr "Az archívumkorlát csökkentése véglegesen törli a régebbi biztonsági mentési verziókat, hogy megfeleljenek az új korlátnak. Ez a művelet nem vonható vissza."

#: build/tools.js:2 build/tools.js:5
msgid "Saving…"
msgstr "Mentés…"

#: build/tools.js:2 build/tools.js:5
msgid "Save changes"
msgstr "Módosítások mentése"

#: build/tools.js:2 build/tools.js:6 build/tools.js:31 build/tools.js:35
#: build/tools.js:36
msgid "Cancel"
msgstr "Mégse"

#: build/tools.js:2
msgid "Clear all archives"
msgstr "Összes archívum kiürítése"

#: build/tools.js:2
msgid ""
"Permanently remove every stored backup archive. This will delete all "
"previous versions of every plugin and theme. This action cannot be undone."
msgstr "Véglegesen eltávolítja az összes tárolt biztonsági mentési archívumot. Ezzel törli az összes bővítmény és sablon összes korábbi verzióját. Ez a művelet nem vonható vissza."

#: build/tools.js:2
msgid "Loading…"
msgstr "Betöltés…"

#: build/tools.js:2
msgid ""
"You have unsaved changes. Save them before leaving this page — closing the "
"tab or switching pages will discard them."
msgstr "Nem mentette a módosításokat. Kérjük, mentse őket, mielőtt elhagyja ezt az oldalt — a fül bezárásával vagy másik oldalra váltással elveszíti őket."

#: build/tools.js:2 build/tools.js:5
msgid "Discard changes"
msgstr "Módosítások elvetése"

#: build/tools.js:2
msgid "Unsaved changes"
msgstr "Nem mentett módosítások"

#: build/tools.js:2
msgid ""
"You have unsaved changes on this page. If you leave now, your changes will "
"be discarded."
msgstr "Nem mentette a módosításokat ezen az oldalon. Ha most elhagyja az oldalt, elveszíti őket."

#: build/tools.js:2
msgid "Stay on this page"
msgstr "Maradás ezen az oldalon"

#: build/tools.js:2
msgid "Discard changes and leave"
msgstr "Módosítások elvetése és kilépés"

#: build/tools.js:2
msgid "Weekly"
msgstr "Heti"

#: build/tools.js:2
msgid "Monthly"
msgstr "Havi"

#: build/tools.js:2
msgid "Quarterly"
msgstr "Negyedéves"

#: build/tools.js:2
msgid "Loading email report settings…"
msgstr "E-mail-jelentések beállításainak betöltése…"

#: build/tools.js:2 build/tools.js:6
msgid "Email Reports"
msgstr "E-mail-jelentések"

#: build/tools.js:2
msgid ""
"Email reports are not yet available on multisite installs. Track progress at"
" docs.wprollback.com/status-reports."
msgstr "A többwebhelyes telepítéseken az e-mail-jelentések még nem érhetők el. Kövesse a fejleményeket a docs.wprollback.com/status-reports oldalon."

#: build/tools.js:2
msgid ""
"Recurring email reports that show admins exactly how WP Rollback Pro is "
"protecting this site — rollbacks performed, archives stored, and premium "
"plugins covered."
msgstr "Rendszeresen küldött e-mail-jelentések, amelyek pontosan megmutatják az adminisztrátoroknak, hogyan védi a WP Rollback Pro ezt a webhelyet — a végrehajtott visszaállításokat, a tárolt archívumokat és a lefedett prémium bővítményeket."

#: build/tools.js:2
msgid ""
"Email reports require HTTPS because the unsubscribe link must be HTTPS-only "
"per RFC 8058. Configure HTTPS before enabling reports in production."
msgstr "Az e-mail-jelentésekhez HTTPS szükséges, mert az RFC 8058 előírása szerint a leiratkozási link csak HTTPS-t használhat. A jelentések éles környezetben történő bekapcsolása előtt állítsa be a HTTPS-t."

#: build/tools.js:2
msgid ""
"Local development site detected — reports will send over HTTP for testing. "
"Production sites must be served over HTTPS for unsubscribe links to comply "
"with RFC 8058."
msgstr "Helyi fejlesztői webhelyet észleltünk — a jelentések tesztelés céljából HTTP-n keresztül lesznek elküldve. Az éles webhelyeket HTTPS-en kell kiszolgálni, hogy a leiratkozási linkek megfeleljenek az RFC 8058 előírásainak."

#: build/tools.js:2
msgid ""
"Your site’s admin email address is missing or invalid. Set a valid address "
"in Settings → General before enabling email reports."
msgstr "Hiányzik vagy hibás a webhely admin e-mail címe. Adjon meg egy érvényes címet a Beállítások → Általános résznél, mielőtt engedélyezi az e-mail-jelentéseket."

#: build/tools.js:2
msgid "Schedule"
msgstr "Ütemezés"

#: build/tools.js:2
msgid ""
"Choose how often a report is sent and confirm when the next one will "
"dispatch."
msgstr "Válassza ki, milyen gyakran küldjön jelentést, és erősítse meg, mikor kerül sor a következő küldésre."

#: build/tools.js:2
msgid "Send email reports"
msgstr "E-mail-jelentések küldése"

#: build/tools.js:2
msgid ""
"When enabled, recipients receive an email summary on the cadence you choose "
"below."
msgstr "Bekapcsolás esetén a címzettek az alább kiválasztott ütemezés szerint kapnak e-mailes összefoglalót."

#: build/tools.js:2
msgid "Frequency"
msgstr "Gyakoriság"

#: build/tools.js:2
msgid "Next scheduled report"
msgstr "Következő ütemezett jelentés"

#: build/tools.js:2
msgid "Not scheduled"
msgstr "Nincs időzítve"

#: build/tools.js:2
msgid "(after saving)"
msgstr "(mentés után)"

#: build/tools.js:2
msgid "Recipients"
msgstr "Címzettek"

#: build/tools.js:2
msgid ""
"Reports are sent individually to each recipient with a per-recipient one-"
"click unsubscribe link."
msgstr "A jelentéseket minden címzettnek külön küldjük el, címzettenként egykattintásos leiratkozási linkkel."

#. translators: %d: total recipients
#: build/tools.js:3
#, js-format
msgid ""
"You have %d recipients on the list. Sending to many recipients may slow down"
" the cron run; the hard cap is 50."
msgstr "%d címzett szerepel a listán. Sok címzett esetén lelassulhat a cron-futtatás; a felső korlát 50."

#: build/tools.js:3
msgid "WordPress administrators"
msgstr "WordPress-adminisztrátorok"

#: build/tools.js:3
msgid ""
"You’ve customized the recipient list. New administrators added later will "
"not automatically receive reports unless added here."
msgstr "Testre szabta a címzettek listáját. A később hozzáadott új adminisztrátorok nem kapnak automatikusan jelentéseket, hacsak nem adja hozzá őket itt."

#: build/tools.js:3
msgid ""
"Currently sending to all current and future administrators. Un-check anyone "
"below to lock the list to specific users."
msgstr "Jelenleg az összes jelenlegi és jövőbeli adminisztrátornak küldünk. Az egyes személyek kijelölésének törlésével csak meghatározott felhasználókra korlátozhatja a listát."

#: build/tools.js:3
msgid "(unsubscribed)"
msgstr "(leiratkozott)"

#. translators: %d: count of stale user IDs
#: build/tools.js:4
#, js-format
msgid "%d stored recipient no longer matches an active administrator."
msgid_plural "%d stored recipients no longer match an active administrator."
msgstr[0] "%d tárolt címzett már nem egyezik meg egy aktív adminisztrátorral."
msgstr[1] "%d tárolt címzett már nem egyezik meg egy aktív adminisztrátorral."

#. translators: %d: user ID
#: build/tools.js:5
#, js-format
msgid "Remove user #%d"
msgstr "A #%d azonosítójú felhasználó eltávolítása"

#: build/tools.js:5
msgid "External email addresses"
msgstr "Külső e-mail-címek"

#: build/tools.js:5
msgid ""
"Add anyone without a WordPress account on this site (developers, agency "
"partners, ops contacts)."
msgstr "Adjon hozzá bárkit, akinek nincs WordPress-fiókja ezen a webhelyen (fejlesztőket, ügynökségi partnereket, üzemeltetési kapcsolattartókat)."

#: build/tools.js:5
msgid ""
"It has been over 90 days since you reviewed the external recipient list. "
"Take a moment to confirm everyone here should still receive reports."
msgstr "Több mint 90 napja ellenőrizte utoljára a külső címzettek listáját. Szánjon rá egy percet, és erősítse meg, hogy az itt szereplőknek továbbra is meg kell kapniuk a jelentéseket."

#: build/tools.js:5
msgid "No external recipients yet."
msgstr "Még nincsenek külső címzettek."

#: build/tools.js:5
msgid "Remove"
msgstr "Eltávolítás"

#: build/tools.js:5
msgid "Add a recipient"
msgstr "Címzett hozzáadása"

#: build/tools.js:5
msgid "Please enter a valid email address."
msgstr "Kérjük, adjon meg érvényes e-mail-címet."

#: build/tools.js:5
msgid "Add"
msgstr "Hozzáadás"

#: build/tools.js:5
msgid "Previously unsubscribed"
msgstr "Korábban leiratkozott"

#: build/tools.js:5
msgid ""
"These recipients clicked an unsubscribe link in a past report. They will not"
" receive future reports unless you re-subscribe them here."
msgstr "Ezek a címzettek egy korábbi jelentésben a leiratkozási linkre kattintottak. Nem kapnak további jelentéseket, hacsak itt újra fel nem iratkoztatja őket."

#: build/tools.js:5
msgid "Re-subscribe"
msgstr "Újrafeliratkozás"

#: build/tools.js:5
msgid "Deliverability tips"
msgstr "Kézbesítési tippek"

#: build/tools.js:5
msgid "Use authenticated SMTP."
msgstr "Használjon hitelesített SMTP-t."

#: build/tools.js:5
msgid ""
"WordPress’s default mailer often delivers reports to spam. Install WP Mail "
"SMTP or FluentSMTP and configure an authenticated SMTP provider for reliable"
" delivery."
msgstr "A WordPress alapértelmezett levelezője gyakran a spam mappába kézbesíti a jelentéseket. Telepítse a WP Mail SMTP vagy FluentSMTP bővítményt, és állítson be hitelesített SMTP-szolgáltatót a megbízható kézbesítéshez."

#: build/tools.js:5
msgid "Check DKIM coverage."
msgstr "Ellenőrizze a DKIM-lefedettséget."

#: build/tools.js:5
msgid ""
"For Gmail’s one-click unsubscribe button to appear, your sending domain’s "
"DKIM signature must cover the List-Unsubscribe headers. Most transactional "
"providers handle this automatically."
msgstr "Ahhoz, hogy megjelenjen a Gmail egykattintásos leiratkozási gombja, a küldő domain DKIM-aláírásának ki kell terjednie a List-Unsubscribe fejlécekre. A legtöbb tranzakciós e-mail-szolgáltató ezt automatikusan kezeli."

#: build/tools.js:5
msgid ""
"You have unsaved changes. Save them before leaving this tab — closing the "
"page or switching tabs will discard them."
msgstr "Nem mentett módosításai vannak. Mielőtt elhagyja ezt a fület, mentse el őket — az oldal bezárásakor vagy a fülek közötti váltáskor elvesznek."

#: build/tools.js:5
msgid "Email report settings saved."
msgstr "Az e-mail-jelentés beállításai elmentve."

#: build/tools.js:5
msgid "Could not save settings."
msgstr "Nem sikerült menteni a beállításokat."

#: build/tools.js:5
msgid "Test send failed."
msgstr "A tesztküldés sikertelen."

#: build/tools.js:5
msgid "Test send limit reached."
msgstr "Elérte a tesztküldési korlátot."

#. translators: %d: seconds remaining
#: build/tools.js:6
#, js-format
msgid "Try again in %ds"
msgstr "Próbálja újra %d másodperc múlva"

#: build/tools.js:6
msgid "Send test report"
msgstr "Tesztjelentés küldése"

#: build/tools.js:6
msgid ""
"You have unsaved changes to your email report settings. If you leave now, "
"those changes will be lost."
msgstr "Nem mentett módosításai vannak az e-mail-jelentés beállításaiban. Ha most kilép, ezek a módosítások elvesznek."

#: build/tools.js:6
msgid "Confirm Archive Cleanup"
msgstr "Archívumok törlésének megerősítése"

#: build/tools.js:6
msgid ""
"You are about to reduce the archive limit. This will permanently delete "
"older backup versions for all plugins and themes to match the new limit."
msgstr "Éppen csökkenteni készül az archívumkorlátot. Ezzel véglegesen törli az összes bővítmény és sablon régebbi biztonsági mentéseit, hogy megfeleljenek az új korlátnak."

#: build/tools.js:6 build/tools.js:35
msgid "This action cannot be undone."
msgstr "Ez a művelet nem vonható vissza."

#: build/tools.js:6
msgid "Delete Excess Archives"
msgstr "Felesleges archívumok törlése"

#: build/tools.js:6
msgid "Clear All Archives?"
msgstr "Összes archívum kiürítése?"

#: build/tools.js:6
msgid ""
"Are you sure you want to delete all backup archives? This will permanently "
"remove all stored versions of plugins and themes."
msgstr "Biztosan törli az összes biztonsági mentési archívumot? Ezzel véglegesen eltávolítja a bővítmények és sablonok összes tárolt verzióját."

#: build/tools.js:6
msgid "Delete All Archives"
msgstr "Összes archívum törlése"

#: build/tools.js:6
msgid "License configuration not available"
msgstr "A licencbeállítások nem érhetők el"

#: build/tools.js:6
msgid "License is active and registered"
msgstr "A licenc aktív és regisztrálva van"

#: build/tools.js:6
msgid "License activation required"
msgstr "A licenc aktiválása kötelező"

#: build/tools.js:6
msgid "License is active but not registered"
msgstr "A licenc aktív, de nincs regisztrálva"

#: build/tools.js:6
msgid "Settings saved and archives cleaned up successfully."
msgstr "A beállítások mentése és az archívumok tisztítása sikerült."

#: build/tools.js:6
msgid "Settings saved successfully."
msgstr "A beállítások sikeresen elmentve."

#: build/tools.js:6
msgid "Failed to save settings. Please try again."
msgstr "Nem sikerült menteni a beállításokat. Kérjük, próbálja újra."

#: build/tools.js:6
msgid "WP Rollback Pro Settings"
msgstr "WP Rollback Pro beállításai"

#: build/tools.js:6
msgid "Manage your WP Rollback Pro license and configure plugin settings."
msgstr "Kezelje a WP Rollback Pro licencét, és állítsa be a bővítmény beállításait."

#: build/tools.js:6
msgid "Pro License"
msgstr "Pro licenc"

#: build/tools.js:6
msgid "All archives have been cleared successfully."
msgstr "Az összes archívum kiürítése sikerült."

#: build/tools.js:6
msgid "Failed to clear archives. Please try again."
msgstr "Nem sikerült kiüríteni az archívumokat. Kérjük, próbálja újra."

#: build/tools.js:6
msgid "All"
msgstr "Összes"

#: build/tools.js:6
msgid "Restore a previous version"
msgstr "Korábbi verzió visszaállítása"

#: build/tools.js:6
msgid ""
"Switch any installed WordPress plugin or theme, free or premium, to another "
"available version. A restore point is created automatically."
msgstr "Váltson bármely telepített WordPress-bővítményt vagy -sablont – akár ingyenes, akár prémium kategóriájú – egy másik elérhető verzióra. A rendszer automatikusan létrehoz egy visszaállítási pontot."

#: build/tools.js:6
msgid "Search plugins and themes"
msgstr "Bővítmények és sablonok keresése"

#: build/tools.js:6
msgid "Search plugins & themes…"
msgstr "Bővítmények és sablonok keresése…"

