#: ../includes/class-admin.php:28
msgid "Signup Referrals"
msgstr "Regisztrációs ajánlások"

#: ../includes/class-admin.php:34
msgid "Referral Types"
msgstr "Ajánlástípusok"

#: ../includes/class-admin.php:35
msgid "Select which types of signups should generate a referral"
msgstr "Válassza ki, mely regisztrációtípusok generáljanak ajánlást"

#: ../includes/class-admin.php:42
msgid "Referral Status"
msgstr "Ajánlás állapota"

#: ../includes/class-admin.php:43
msgid "Select the default status the referral will be set to."
msgstr "Válassza ki az ajánlás alapértelmezett állapotát."

#: ../includes/class-admin.php:46
msgid "Pending"
msgstr "Függőben"

#: ../includes/class-admin.php:47
msgid "Unpaid"
msgstr "Kifizetetlen"

#: ../includes/class-admin.php:54
msgid "Affiliate Registration - Referral Amount"
msgstr "Partnerregisztráció - ajánlási összeg"

#: ../includes/class-admin.php:55
msgid ""
"Enter the dollar amount the affiliate should receive when a user registers "
"as an affiliate."
msgstr ""
"Adja meg a dollárösszeget, amelyet a partner kap, amikor egy felhasználó "
"partnerként regisztrál."

#: ../includes/class-admin.php:66
msgid "EDD - Registration Referral Amount"
msgstr "EDD - Regisztrációs ajánlási összeg"

#: ../includes/class-admin.php:67
msgid ""
"Enter the dollar amount the affiliate should receive if the user registers "
"for an account through Easy Digital Downloads."
msgstr ""
"Adja meg a dollárösszeget, amelyet a partner kap, ha a felhasználó fiókot "
"hoz létre az Easy Digital Downloads rendszeren keresztül."

#: ../includes/class-admin.php:75
msgid "EDD - Disable Checkout Referral"
msgstr "EDD - Pénztári ajánlás letiltása"

#: ../includes/class-admin.php:76 ../includes/class-admin.php:95
msgid ""
"Disables referral creation at checkout if a user registers for an account."
msgstr ""
"Kikapcsolja az ajánlás létrehozását a pénztárnál, ha a felhasználó fiókot "
"hoz létre."

#: ../includes/class-admin.php:85
msgid "WooCommerce - Registration Referral Amount"
msgstr "WooCommerce - Regisztrációs ajánlási összeg"

#: ../includes/class-admin.php:86
msgid ""
"Enter the dollar amount the affiliate should receive if the user registers "
"for an account through WooCommerce."
msgstr ""
"Adja meg a dollárösszeget, amelyet a partner kap, ha a felhasználó fiókot "
"hoz létre a WooCommerce rendszeren keresztül."

#: ../includes/class-admin.php:94
msgid "WooCommerce - Disable Checkout Referral"
msgstr "WooCommerce - Pénztári ajánlás letiltása"

#: ../includes/class-admin.php:104
msgid "Gravity Forms - User Registration Referral Amount"
msgstr "Gravity Forms - Felhasználói regisztráció ajánlási összege"

#: ../includes/class-admin.php:105
msgid ""
"Enter the dollar amount the affiliate should receive if the user registers "
"for an account through the Gravity Forms User Registration add-on."
msgstr ""
"Adja meg azt a dollárösszeget, amelyet a partner akkor kap, ha a felhasználó"
" a Gravity Forms User Registration kiegészítőn keresztül fiókot hoz létre."

#: ../includes/class-admin.php:116
msgid "Ultimate Member - Registration Referral Amount"
msgstr "Ultimate Member - Regisztrációért járó jutalék"

#: ../includes/class-admin.php:117
msgid ""
"Enter the dollar amount the affiliate should receive if the user registers "
"for an account through Ultimate Member"
msgstr ""
"Adja meg azt a dollárösszeget, amelyet a partner akkor kap, ha a felhasználó"
" az Ultimate Member rendszeren keresztül fiókot hoz létre"

#: ../includes/class-admin.php:127
msgid "User Pro - Registration Referral Amount"
msgstr "User Pro - Regisztrációért járó jutalék"

#: ../includes/class-admin.php:128
msgid ""
"Enter the dollar amount the affiliate should receive if the user registers "
"for an account through User Pro"
msgstr ""
"Adja meg azt a dollárösszeget, amelyet a partner akkor kap, ha a felhasználó"
" a User Pro rendszeren keresztül fiókot hoz létre"

#: ../includes/class-admin.php:155
msgid "Referring Affiliate"
msgstr "Ajánló partner"

