#: includes/Actions/Subscriptions/UpdateNextPaymentDate.php:29
msgid "Update Next Payment Date"
msgstr "Következő fizetési dátum frissítése"

#: includes/Actions/Subscriptions/UpdateNextPaymentDate.php:30
