#: admin/settings-tabs/general.php:172
#, php-format
msgid ""
"The communication preferences page is where customers can opt-in or opt-out "
"of workflows. It must contain the shortcode %1$s. To set up a signup page "
"use the shortcode %2$s and specify the page in the setting below."
msgstr "A kommunikációs beállítások oldalán a vásárlók feliratkozhatnak a munkafolyamatokra, illetve leiratkozhatnak róluk. Tartalmaznia kell ezt a shortcode-ot: %1$s. Feliratkozási oldal beállításához használja a(z) %2$s shortcode-ot, és adja meg az oldalt az alábbi beállításban."

#: admin/settings-tabs/general.php:188
msgid "Communication signup page (optional)"
msgstr "Kommunikációs feliratkozási oldal (opcionális)"

#: admin/settings-tabs/general.php:189
msgid ""
"The signup page is similar to the preferences page but allows customers to "
"enter their email address."
msgstr ""
"A feliratkozási oldal hasonló a beállítások oldalához, de lehetővé teszi a "
"vásárlóknak az e-mail-címük megadását."

