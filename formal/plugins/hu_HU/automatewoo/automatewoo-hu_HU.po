#. translators: %1$s anchor tag with the link to the documentation link, %2$s
#. closing tag for the anchor
#: includes/Actions/Send_Email.php:35
#, php-format
msgid ""
"This action sends an HTML email using a template. The default template "
"matches the style of your WooCommerce transactional emails. <%1$s>View email"
" templates documentation<%2$s>."
msgstr ""
"Ez a művelet sablonnal HTML e-mailt küld. Az alapértelmezett sablon "
"illeszkedik a WooCommerce tranzakciós e-mailjeinek stílusához. <%1$s>E-mail "
"sablonok dokumentációjának megtekintése<%2$s>."

#: includes/Actions/Send_Email.php:49
msgid "Email heading"
msgstr "E-mail címsor"

#: includes/Actions/Send_Email.php:52
msgid ""
"The appearance will depend on your email template. Not all templates support"
" this field."
msgstr "A megjelenés az e-mail sablontól függ. Nem minden sablon támogatja ezt a mezőt."

#: includes/Actions/Send_Email.php:56
msgid "Email preheader"
msgstr "E-mail-előfejléc"

#: includes/Actions/Send_Email.php:58
msgid ""
"A preheader is a short text summary that follows the subject line when an "
"email is viewed in the inbox. If no preheader is set the first text found in"
" the email is used."
msgstr ""
"Az előfejléc egy rövid szöveges összefoglaló, amely a tárgysor után jelenik "
"meg a beérkező levelekben. Ha nincs előfejléc beállítva, az e-mailben "
"található első szöveg kerül felhasználásra."

#: includes/Actions/Send_Email.php:62
msgid "Template"
msgstr "Sablon"

#: includes/Actions/Send_Email.php:63
msgid ""
"Select which template to use when formatting the email. If you select "
"'None', the email will have no template but the email will still be sent as "
"an HTML email."
msgstr "Válassza ki, melyik sablonmintát használja az e-mail formázásához. Ha a „Nincs” lehetőséget választja, az e-mail sablonminta nélkül is HTML-e-mailként kerül elküldésre."

#: includes/Actions/Send_Email_Abstract.php:43
msgid "To"
msgstr "Címzett"

#: includes/Actions/Send_Email_Abstract.php:44
msgid ""
"Enter emails here or use variables such as {{ customer.email }}. Multiple "
"emails can be separated by commas. Add <b>--notracking</b> after an email to"
" disable open and click tracking for that recipient."
msgstr ""
"Adja meg itt az e-mail címeket, vagy használjon változókat, például: {{ "
"customer.email }}. Több e-mail címet vesszővel válasszon el. Adjon az e-mail"
" cím után egy <b>--notracking</b> jelölést, hogy ennél a címzettnél letiltsa"
" a megnyitás- és kattintáskövetést."

#: includes/Actions/Send_Email_Abstract.php:45
msgid "E.g. {{ customer.email }}, admin@example.org --notracking"
msgstr "Pl.: {{ customer.email }}, admin@example.org --notracking"

#: includes/Actions/Send_Email_Abstract.php:51
msgid "CC"
msgstr "CC"

#: includes/Actions/Send_Email_Abstract.php:52
msgid ""
"Enter CC email addresses here or use variables. Multiple emails can be "
"separated by commas. Please note that CC recipients share the same tracking "
"link as the \"To\" recipient. Tracking activity from CC will be recorded as "
"activity from the main recipient."
msgstr "Adja meg itt a másolatot kapó e-mail címeket, vagy használjon változókat. Több e-mail cím vesszővel választható el. Kérjük, vegye figyelembe, hogy a másolatot kapó címzettek ugyanazt a követési linket kapják, mint a „címzett”. A másolatot kapó címzettek történéseit a rendszer a fő címzett történéseiként rögzíti."

#: includes/Actions/Send_Email_Abstract.php:53
#: includes/Actions/Send_Email_Abstract.php:60
msgid "E.g. {{ customer.email }}, admin@example.org"
msgstr "Pl.: {{ customer.email }}, admin@example.org"

#: includes/Actions/Send_Email_Abstract.php:58
msgid "BCC"
msgstr "BCC"

#: includes/Actions/Send_Email_Abstract.php:59
msgid ""
"Enter BCC email addresses here or use variables. Multiple emails can be "
"separated by commas. Please note that BCC recipients share the same tracking"
" link as the \"To\" recipient. Tracking activity from BCC will be recorded "
"as activity from the main recipient."
msgstr "Adja meg itt a titkos másolatot kapó e-mail címeket, vagy használjon változókat. Több e-mail cím vesszővel választható el. Kérjük, vegye figyelembe, hogy a titkos másolatot kapó címzettek ugyanazt a követési linket kapják, mint a „címzett”. A titkos másolatot kapó címekről érkező történések a fő címzett tevékenységeként lesznek rögzítve."

#: includes/Actions/Send_Email_Abstract.php:65
msgid "Email subject"
msgstr "E-mail tárgya"

#: includes/Actions/Send_Email_Abstract.php:71
msgid "Reply to"
msgstr "Válaszcím"

#: includes/Actions/Send_Email_Abstract.php:74
msgid ""
"Optionally set a reply-to email for the email. Please note that not all "
"email delivery services support \"Reply-To\" email headers."
msgstr "Opcionálisan beállíthat válaszcímet az e-mailhez. Kérjük, vegye figyelembe, hogy nem minden e-mail-kézbesítő szolgáltatás támogatja a „Reply-To” e-mail-fejléceket."

#: includes/Actions/Send_Email_Abstract.php:118
msgid "Email successfully sent."
msgstr "E-mail sikeresen elküldve."

#: includes/Actions/Send_Email_Plain_Text.php:31
msgid "Send Email - Plain Text"
msgstr "E-mail küldése - Egyszerű szöveg"

#: includes/Actions/Send_Email_Plain_Text.php:32
msgid ""
"This action sends a plain text email. It will contain no HTML which means "
"open tracking and click tracking will not work. Some variables may display "
"unexpectedly due to having HTML removed. If necessary, an unsubscribe link "
"will be added after the email content."
msgstr ""
"Ez a művelet egyszerű szöveges e-mailt küld. Nem tartalmaz HTML-t, így a "
"megnyitás- és kattintáskövetés nem fog működni. Egyes változók váratlanul "
"jelenhetnek meg a HTML eltávolítása miatt. Szükség esetén a leiratkozási "
"hivatkozás az e-mail tartalma után kerül hozzáadásra."

#: includes/Actions/Send_Email_Plain_Text.php:43
#: includes/Fields/Email_Content.php:33
msgid "Email content"
msgstr "E-mail tartalma"

#: includes/Actions/Send_Email_Plain_Text.php:44
msgid ""
"All HTML will be removed from this field when sending. Variables that use "
"HTML may display unexpectedly because of this."
msgstr ""
"Küldéskor az összes HTML el lesz távolítva ebből a mezőből. A HTML-t "
"használó változók emiatt váratlanul jelenhetnek meg."

#: includes/Actions/Send_Email_Raw.php:32
msgid "Send Email - Raw HTML"
msgstr "E-mail küldése - Nyers HTML"

#: includes/Actions/Send_Email_Raw.php:33
msgid ""
"This action sends emails with only the HTML/CSS entered in the action's HTML"
" field and is designed for advanced use only. This is different from the "
"standard Send Email action, which inserts the email content into a template."
" Some variables may display unexpectedly due to the different CSS. Please "
"note that you should include an unsubscribe link by using the variable {{ "
"unsubscribe_url }}."
msgstr ""
"Ez a művelet csak a művelet HTML mezőjébe beírt HTML/CSS-sel küld "
"e-maileket, és kizárólag haladó felhasználásra készült. Ez különbözik a "
"standard E-mail küldése művelettől, amely a sablonba illeszti az e-mail "
"tartalmát. Egyes változók a különböző CSS miatt váratlanul jelenhetnek meg. "
"Kérjük, vegye figyelembe, hogy tartalmaznia kell egy leiratkozási "
"hivatkozást a {{ unsubscribe_url }} változó használatával."

#: includes/Actions/Send_Email_Raw.php:44
msgid "Include AutomateWoo CSS"
msgstr "AutomateWoo CSS hozzáadása"

#: includes/Actions/Send_Email_Raw.php:46
msgid ""
"Checking this box adds the basic AutomateWoo CSS that is used to style "
"variables to your custom HTML."
msgstr "A jelölőnégyzet bejelölése hozzáadja az egyéni HTML-hez az AutomateWoo alapvető CSS-ét, amely a változók megjelenésének formázására szolgál."

#: includes/Actions/Send_Email_Raw.php:50
msgid "Email HTML"
msgstr "E-mail HTML"

#: includes/Actions/Send_Email_Raw.php:51
msgid "Any CSS included in the HTML will be automatically inlined."
msgstr "A HTML-ben szereplő CSS automatikusan soron belüli stílusként lesz beillesztve."

#: includes/Actions/Send_SMS_Twilio.php:19
msgid "Send SMS (Twilio)"
msgstr "SMS küldése (Twilio)"

#: includes/Actions/Send_SMS_Twilio.php:20
