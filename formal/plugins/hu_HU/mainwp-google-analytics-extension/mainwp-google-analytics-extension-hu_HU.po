#. Plugin Name of the plugin
#: mainwp-google-analytics-extension.php
msgid "MainWP Google Analytics Extension"
msgstr "MainWP Google Analytics Extension"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-google-analytics-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-google-analytics-extension.php
msgid ""
"MainWP Google Analytics Extension is an extension for the MainWP plugin that"
" enables you to monitor detailed statistics about your child sites traffic. "
"It integrates seamlessly with your Google Analytics account."
msgstr "A MainWP Google Analytics-kiterjesztés a MainWP bővítményhez készült, és lehetővé teszi, hogy nyomon kövesse az alárendelt webhelyei forgalmának részletes statisztikáit. Zökkenőmentesen integrálódik a Google Analytics-fiókjával."

