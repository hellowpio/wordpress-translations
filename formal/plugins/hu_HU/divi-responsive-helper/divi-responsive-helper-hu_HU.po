"Set the default maximum width for all rows at the Widescreen breakpoint."
msgstr "Állítsa be az összes sor alapértelmezett maximális szélességét a szélesvásznú töréspontnál."

#: d5/dashboard/build/bundle.js:2
msgid "Set the default maximum width for all rows at the Desktop breakpoint."
msgstr "Állítsa be az összes sor alapértelmezett maximális szélességét az asztali töréspontnál."

#: d5/dashboard/build/bundle.js:2
msgid ""
"Set the default maximum width for all rows at the Tablet Wide breakpoint."
msgstr "Állítsa be az összes sor alapértelmezett maximális szélességét a széles táblagépes töréspontnál."

#: d5/dashboard/build/bundle.js:2
msgid "Set the default maximum width for all rows at the Tablet breakpoint."
msgstr "Állítsa be az összes sor alapértelmezett maximális szélességét a táblagépes töréspontnál."

#: d5/dashboard/build/bundle.js:2
