#: d4/includes/setup/theme-options.php:414
msgid ""
"Enter a custom value to set the minimum device size for the code to take "
"effect in the custom media query."
msgstr ""
"Adjon meg egy egyéni értéket a minimális eszközméret beállításához, amelynél"
" a kód érvénybe lép az egyéni media queryben."

#: d4/includes/setup/theme-options.php:418
msgid "Custom Max-Width Value"
msgstr "Egyéni max-width érték"

#: d4/includes/setup/theme-options.php:422
msgid ""
"Enter a custom value to set the maximum device size for the code to take "
"effect in the custom media query. "
msgstr ""
"Adjon meg egy egyéni értéket a maximális eszközméret beállításához, amelynél"
" a kód érvénybe lép az egyéni media queryben. "

#: d4/includes/setup/theme-options.php:426
msgid "Custom CSS Media Query"
msgstr "Egyéni CSS media query"

#: d4/includes/setup/theme-options.php:430
msgid ""
"Place any custom CSS here that you want to apply only on device sizes "
"between the custom min-width and max-width values."
msgstr ""
"Helyezze ide azokat az egyéni CSS-kódokat, amelyeket kizárólag az egyéni "
"min-width és max-width értékek közé eső eszközméreteken kíván alkalmazni."

#: d4/includes/setup/theme-options.php:449 d5/dashboard/build/bundle.js:2
msgid "Show/Hide Menu Items Per Device"
msgstr "Menüelemek megjelenítése/elrejtése eszközönként"

#: d4/includes/setup/theme-options.php:453
msgid ""
"Enable this feature to add new checkmarks in the WordPress navigation menu "
"items to show or hide the menu items on Desktop, Tablet, or Phone."
msgstr "Kapcsolja be ezt a funkciót, hogy új jelölőnégyzeteket adhasson hozzá a WordPress navigációs menüpontjaihoz, és ezeken beállíthassa a menüpontok mutatását vagy elrejtését asztali, táblagépes vagy telefonos nézetben."

#: d4/includes/setup/theme-options.php:456
msgid "Enable Settings In Menu Module"
msgstr "Beállítások bekapcsolása a menümodulban"

#: d4/includes/setup/theme-options.php:460
msgid ""
"Choose to enable all the menu related settings in the Divi Menu module."
msgstr "Válassza az összes menüvel kapcsolatos beállítás bekapcsolását a Divi menümodulban."

#: d4/includes/setup/theme-options.php:463 d5/dashboard/build/bundle.js:2
msgid "Enable Settings For Default Header Menu"
msgstr "Beállítások bekapcsolása az alapértelmezett fejlécmenühöz"

#: d4/includes/setup/theme-options.php:467
msgid ""
"Choose to enable all menu related settings for the default Divi header menu."
msgstr "Válassza az alapértelmezett Divi fejlécmenü összes menüvel kapcsolatos beállításának bekapcsolását."

#: d4/includes/setup/theme-options.php:470 d5/dashboard/build/bundle.js:2
msgid "Show X Icon When Opened (Default Header)"
msgstr "X ikon megjelenítése megnyitáskor (Alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:474
msgid ""
"Change the mobile menu hamburger icon to an X when the menu it is toggled "
"open."
msgstr "Cserélje X-re a mobilmenü hamburgerikonját, amikor a menüt megnyitják."

#: d4/includes/setup/theme-options.php:477 d5/dashboard/build/bundle.js:2
msgid "Show A Hamburger Menu On Desktop (Default Header)"
msgstr "Hamburger menü megjelenítése asztali nézetben (Alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:484 d5/dashboard/build/bundle.js:2
msgid "Add Text Beside Hamburger Menu Icon (Default Header)"
msgstr "Szöveg hozzáadása a hamburger menü ikonja mellé (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:491 d5/dashboard/build/bundle.js:2
msgid "Hamburger Menu Text (Default Header)"
msgstr "Hamburger menü szövege (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:495
msgid "Enter custom text to show on the left side of the hamburger menu."
msgstr "Adja meg az egyéni szöveget, amelyet a hamburger menü bal oldalán szeretne mutatni."

#: d4/includes/setup/theme-options.php:498 d5/dashboard/build/bundle.js:2
msgid "Collapse Mobile Menu Submenus (Default Header)"
msgstr "Mobilmenü almenüinek összecsukása (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:521 d5/dashboard/build/bundle.js:2
msgid "Collapse Submenu When Another Is Opened (Default Header)"
msgstr "Almenü összecsukása, amikor egy másik megnyílik (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:528 d5/dashboard/build/bundle.js:2
msgid "Open/Close Submenus By Clicking Parent Menu Item (Default Header)"
msgstr "Almenük megnyitása/bezárása a szülő menüelemre kattintva (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:535 d5/dashboard/build/bundle.js:2
msgid "Close Mobile Menu By Clicking Outside Dropdown (Default Header)"
msgstr "Mobilmenü bezárása a legördülő menün kívülre kattintva (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:542 d5/dashboard/build/bundle.js:2
msgid "Fixed Navigation Bar On Mobile (Default Header)"
msgstr "Rögzített navigációs sáv mobilon (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:546
msgid ""
"Enable this setting to make the header menu navigation bar stay fixed at the"
" top of the screen on Tablet and Phone device sizes."
msgstr "Kapcsolja be ezt a beállítást, hogy a fejlécmenü navigációs sávja rögzítve maradjon a képernyő tetején táblagépes és telefonos nézetben."

#: d4/includes/setup/theme-options.php:549 d5/dashboard/build/bundle.js:2
msgid "Menu Breakpoint (Default Header)"
msgstr "Menü töréspontja (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:553
msgid ""
"Enter the screen width pixel value for the responsive breakpoint for when "
"the menu changes between desktop and mobile versions. The default value in "
"Divi is 981px."
msgstr "Adja meg a képernyőszélesség képpontértékét ahhoz a reszponzív törésponthoz, amikor a menü az asztali és a mobil verzió között vált. A Divi alapértelmezett értéke: 981px."

#: d4/includes/setup/theme-options.php:556
msgid "Make Mobile Menu Height Scrollable (Default Header)"
msgstr "A mobilmenü magasságának görgethetővé tétele (alapértelmezett fejléc)"

#: d4/includes/setup/theme-options.php:563 d5/dashboard/build/bundle.js:2
msgid "Mobile Menu Scrollable Max Height (Default Header)"
msgstr "A mobilmenü maximális görgethető magassága (alapértelmezett fejléc)"

