#: d4/includes/setup/theme-options.php:1109
msgid "Main Breakpoints"
msgstr "Fő töréspontok"

#: d4/includes/setup/theme-options.php:1114
msgid "Change Desktop/Tablet Breakpoint (Default 981px)"
msgstr "Asztali és táblagépes nézet közötti töréspont módosítása (alapértelmezett: 981px)"

#: d4/includes/setup/theme-options.php:1118
msgid ""
"Enter a number (without 'px') to change the pixel value of the breakpoint "
"where your design switches from Desktop to Tablet layout. The default is "
"981px, but you can customize it to fit your design needs."
msgstr "Adjon meg egy számot („px” nélkül) a töréspont képpontértékének módosításához, amelynél a dizájn az asztali elrendezésről a táblagépes elrendezésre vált. Az alapértelmezett érték 981px, de a dizájn igényeinek megfelelően testre szabhatja."

#: d4/includes/setup/theme-options.php:1121
msgid "Change Tablet/Phone Breakpoint (767px)"
msgstr "Táblagépes és telefonos nézet közötti töréspont módosítása (767px)"

