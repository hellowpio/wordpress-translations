#: d4/includes/setup/theme-options.php:932
msgid "Headings"
msgstr "Címsorok"

#: d4/includes/setup/theme-options.php:936
msgid "Enable the Widow Fixer feature for headings (H1-H6)."
msgstr "Kapcsolja be a Widow Fixer funkciót a címsoroknál (H1-H6)."

