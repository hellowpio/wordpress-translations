msgstr "Állítson be színt a Chrome böngészőt használó Android-eszközök mobil címsávjához."

#: d4/includes/setup/theme-options.php:195
msgid "Tabs Module Tab Layout"
msgstr "A Tabs modul füleinek elrendezése"

#: d4/includes/setup/theme-options.php:199 d5/dashboard/build/bundle.js:2
msgid ""
"Enable this feature to show settings in the Design tab of the Divi Tabs "
