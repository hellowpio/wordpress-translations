msgstr "Jelvény háttere"

#: divi-5/public/modules.js:34
msgid "Best Value Ribbon"
msgstr "Legjobb ár-érték arányú szalag"

#: divi-5/public/modules.js:34
msgid "Show the ribbon before or after the column label text."
msgstr "A szalag megjelenítése az oszlopcímke szövege előtt vagy után."

#: divi-5/public/modules.js:34
msgid "Before label"
msgstr "Címke előtt"

#: divi-5/public/modules.js:34
msgid "After label"
msgstr "Címke után"

#: divi-5/public/modules.js:34
msgid "Ribbon Font"
msgstr "Szalag betűtípusa"

#: divi-5/public/modules.js:34
msgid "Ribbon Background"
msgstr "Szalag háttere"

#: divi-5/public/modules.js:34
msgid "Ribbon Border"
msgstr "Szalag kerete"

#: divi-5/public/modules.js:34
msgid "Ribbon Box Shadow"
msgstr "Szalag árnyéka"

#: divi-5/public/modules.js:34
msgid "Ribbon Spacing"
msgstr "Szalag térköze"

#: divi-5/public/modules.js:34
msgid "Sorting Arrows"
msgstr "Rendezési nyilak"

#: divi-5/public/modules.js:34
msgid "Arrow color"
msgstr "Nyíl színe"

#: divi-5/public/modules.js:34
msgid ""
"Color of the sort carets. Leave empty to inherit the header text color."
msgstr "A rendezési nyilak színe. Hagyja üresen, hogy a fejléc szövegének színét örökölje."

#: divi-5/public/modules.js:34
msgid "Active arrow color"
msgstr "Aktív nyíl színe"

#: divi-5/public/modules.js:34
msgid ""
"Color of the active sort direction. Leave empty to match the arrow color."
msgstr "Az aktív rendezési irány színe. Hagyja üresen, hogy megegyezzen a nyíl színével."

#: divi-5/public/modules.js:34
msgid "Arrow size"
msgstr "Nyíl mérete"

#: divi-5/public/modules.js:34
msgid "Size of the sort carets next to header labels."
msgstr "A fejléc címkéi melletti rendezési nyilak mérete."

#: divi-5/public/modules.js:34
msgid "Toolbar"
msgstr "Eszköztár"

#: divi-5/public/modules.js:34
msgid "Search Field"
msgstr "Keresőmező"

#: divi-5/public/modules.js:34
msgid "Pager & Export"
msgstr "Lapozás és exportálás"

#: divi-5/public/modules.js:34
msgid "Icons"
msgstr "Ikonok"

#: divi-5/public/modules.js:34
msgid "Table Border"
msgstr "Táblázat kerete"

#: divi-5/public/modules.js:34
msgid "Cell Spacing"
msgstr "Cellák közötti térköz"

#: divi-5/public/modules.js:34
msgid ""
"Default vertical alignment for every cell. Header, body, and footer settings"
" override this."
msgstr "Alapértelmezett függőleges illesztés minden cellához. A fejléc, a törzs és a lábléc beállításai felülbírálják ezt."

#: divi-5/public/modules.js:34
msgid "Sticky Header Offset"
msgstr "Rögzített fejléc eltolása"

#: divi-5/public/modules.js:34
msgid "Space above the sticky header so it sits below a fixed site header."
msgstr "A rögzített fejléc fölötti térköz, hogy az a rögzített webhelyfejléc alatt jelenjen meg."

#: divi-5/public/modules.js:34
msgid "Stacked Card Gap"
msgstr "Egymásra helyezett kártyák közötti térköz"

#: divi-5/public/modules.js:34
msgid "Space between stacked card rows on small screens."
msgstr "A kis képernyőkön egymásra helyezett kártyasorok közötti térköz."

#: divi-5/public/modules.js:34
msgid ""
"Upload your image. SVG files work best with display fixes applied "
"automatically."
msgstr "Töltse fel a képét. Az SVG-fájlok működnek a legjobban, a megjelenítési javítások automatikusan alkalmazásra kerülnek."

#: divi-5/public/modules.js:34
msgid "Slide direction for the hover reveal effect."
msgstr "A rámutatáskor megjelenő hatás beúszásának iránya."

#: divi-5/public/modules.js:34
msgid "Choose the animation used when the tooltip is shown."
msgstr "Válassza ki az eszköztipp megjelenítésekor használt animációt."

#: divi-5/public/modules.js:34
msgid "Adjust the delay of the tooltip showing."
msgstr "Állítsa be az eszköztipp megjelenítésének késleltetését."

#: divi-5/public/modules.js:34
msgid "Adjust the delay of the tooltip hiding."
msgstr "Állítsa be az eszköztipp elrejtésének késleltetését."

#: divi-5/public/modules.js:34
msgid ""
"Leave empty to use the parent hotspot tooltip background. Set a color here "
"to override this item only."
msgstr "Hagyja üresen, hogy a szülő hotspot eszköztippjének hátterét használja. Adjon meg itt egy színt, ha csak ezt a tételt szeretné felülbírálni."

#: divi-5/public/modules.js:34
msgid ""
"Leave empty to use the parent tooltip max width. Set a value here to "
"override this item only."
msgstr "Hagyja üresen, hogy a szülő eszköztippjének maximális szélességét használja. Adjon meg itt egy értéket, ha csak ezt a tételt szeretné felülbírálni."

#. translators: 1: module type title, 2: admin label
#: divi-5/public/modules.js:35
msgid "%1$s — %2$s"
msgstr "%1$s — %2$s"

#: divi-5/public/modules.js:35
msgid "Module"
msgstr "Modul"

#: divi-5/public/modules.js:35
msgid "Select a module…"
msgstr "Modul kiválasztása…"

#: divi-5/public/modules.js:35
msgid "Search this page…"
msgstr "Keresés ezen az oldalon…"

#: divi-5/public/modules.js:35
msgid "Target Mode"
msgstr "Célzási mód"

#: divi-5/public/modules.js:35
msgid ""
"How this step finds its page element. Module picker stores a block ID. CSS "
"selector is an escape hatch. No target centers the step."
msgstr "Így találja meg ez a lépés az oldalon lévő elemet. A modulválasztó egy blokk ID-ját tárolja. A CSS-szelektor kerülőmegoldásként használható. Célpont nélkül a lépés középre kerül."

#: divi-5/public/modules.js:35
msgid "Module on this page"
msgstr "Modul ezen az oldalon"

#: divi-5/public/modules.js:35
msgid "CSS selector"
msgstr "CSS-szelektor"

#: divi-5/public/modules.js:35
msgid "No target (centered)"
msgstr "Nincs célpont (középre igazítva)"

#: divi-5/public/modules.js:35
msgid "Target Module"
msgstr "Célmodul"

#: divi-5/public/modules.js:35
msgid ""
"Pick a section, row, column, or module on this page. After save, inspect "
"that module on the published page (not this tour wrapper) for data-dsm-tour-"
"anchor. Theme Builder header and footer are not listed — use CSS selector "
"for those."
msgstr "Válasszon ki egy szakaszt, sort, oszlopot vagy modult ezen az oldalon. Mentés után a közzétett oldalon (nem ebben az útmutatókeretben) ellenőrizze, hogy a modulnál szerepel-e a data-dsm-tour-anchor. A Theme Builder fejléc- és láblécelemei nem szerepelnek a listában – ezekhez használjon CSS-választót."

#: divi-5/public/modules.js:35
msgid ""
"Escape hatch for elements the module picker cannot list (Theme Builder "
"header/footer, custom markup). Invalid selectors are ignored."
msgstr "Alternatív megoldás azokhoz az elemekhez, amelyeket a modulválasztó nem tud felsorolni (Theme Builder fejléc/lábléc, egyéni jelölőkód). A hibás szelektorokat a rendszer figyelmen kívül hagyja."

#: divi-5/public/modules.js:35
msgid ""
"This step has no page target. The tour will show it centered (intro/outro)."
msgstr "Ennek a lépésnek nincs oldalbeli célpontja. Az útmutató középre igazítva jeleníti meg (bevezető/záró lépés)."

#: divi-5/public/modules.js:35
msgid "Add New Step"
msgstr "Új lépés hozzáadása"

#: divi-5/public/modules.js:35
msgid "Show Preview"
msgstr "Előnézet megjelenítése"

#: divi-5/public/modules.js:35
msgid ""
"Shows the tour tooltip and dim overlay on this canvas so you can check "
"Title, Content, and Design styles. Not shown to visitors. Next and Back work"
" in the preview; Done or Esc closes it until you turn this on again."
msgstr "A túra eszköztippjét és halványító átfedését jeleníti meg ezen a vásznon, így ellenőrizheti a cím, a tartalom és a Design stílusát. A látogatók nem látják. A következő és a vissza művelet működik az előnézetben; a kész gomb vagy az Esc bezárja az előnézetet, amíg újra be nem kapcsolja ezt a beállítást."

#: divi-5/public/modules.js:35
msgid "Shown on the Visual Builder card and used to identify this tour."
msgstr "A vizuális szerkesztő kártyáján jelenik meg, és az útmutató azonosítására szolgál."

#: divi-5/public/modules.js:35
msgid ""
"When the tour starts for visitors. On Click uses the selector below (or any "
"element with data-dsm-page-tour-start). On Interaction listens for the dsm-"
"page-tour:start event."
msgstr "Az útmutató látogatók számára történő indításának módja. Kattintáskor az alábbi szelektort (vagy bármely data-dsm-page-tour-start attribútummal rendelkező elemet) használja. Interakciókor a dsm-page-tour:start eseményre figyel."

#: divi-5/public/modules.js:35
msgid ""
"CSS selector for the element that starts this tour. Invalid selectors are "
"ignored."
msgstr "Az útmutatót elindító elem CSS-szelektora. A hibás szelektorokat a rendszer figyelmen kívül hagyja."

#: divi-5/public/modules.js:35
msgid ""
"Starts from the first step on every page load. Finish and Skip only close "
"this visit."
msgstr "Minden oldalbetöltéskor az első lépéssel indul. A Befejezés és a Kihagyás csak az aktuális alkalomra zárják be az útmutatót."

#: divi-5/public/modules.js:35
msgid ""
"Starts on every page load until the visitor clicks Skip. Skip is remembered "
"after refresh. Finishing the tour does not hide future visits."
msgstr "Minden oldalbetöltéskor elindul, amíg a látogató a Kihagyás gombra nem kattint. Az oldal frissítése után is megjegyzi a kihagyást. Az útmutató befejezése nem akadályozza meg, hogy későbbi látogatásokkor is megjelenjen."

#: divi-5/public/modules.js:35
msgid ""
"Shows automatically the first time. After Finish or Skip, this visitor will "
"not see it again on refresh. Leaving mid-tour (Esc) resumes on the next "
"visit."
msgstr "Első alkalommal automatikusan megjelenik. A Befejezés vagy a Kihagyás után a látogató frissítéskor már nem látja újra. Ha félbehagyja az útmutatót (Esc), a következő látogatáskor onnan folytathatja."

#: divi-5/public/modules.js:35
msgid ""
"On page load the tour immediately scrolls to the first step target. Use this"
" for app-style tours that should jump to the first highlight."
msgstr "Az oldal betöltésekor az útmutató azonnal az első lépés célpontjához görget. Olyan alkalmazásszerű útmutatóknál használja, amelyeknek az első kiemelt elemhez kell ugraniuk."

#: divi-5/public/modules.js:35
msgid ""
"Does not jump the page. If the first step is below the fold, the tour waits "
"until that module reaches the in-view offset, then starts. Next and Back "
"still scroll between steps."
msgstr "Az útmutató felugró ablaka mögötti elsötétített fedőréteg színe."

#: divi-5/public/modules.js:35
msgid ""
"How far into the screen the target must travel before the tour starts. 0% "
"starts as soon as it peeks in. 45% waits until it is near the middle of the "
"viewport. 100% waits until the target has reached the far edge."
msgstr "A célpontnak ennyire kell behaladnia a képernyőre ahhoz, hogy az útmutató elinduljon. 0% esetén azonnal elindul, amint a célpont éppen megjelenik. 45% esetén megvárja, amíg a célpont a nézetablak közepe közelébe ér. 100% esetén megvárja, amíg a célpont eléri a nézetablak túlsó szélét."

#: divi-5/public/modules.js:35
msgid "Color of the dimmed overlay behind the tour popover."
msgstr "Az útmutató felugró ablaka mögötti halványított fedőréteg színe."

#: divi-5/public/modules.js:35
msgid "Corner radius of the spotlight hole around the target."
msgstr "A célpont körüli kiemelő kivágás saroklekerekítésének sugara."

#: divi-5/public/modules.js:35
msgid ""
"Default background color for every tour popover. A step can override this."
msgstr "Az összes útmutató felugró ablakának alapértelmezett háttérszíne. Egy lépés felülbírálhatja ezt."

#: divi-5/public/modules.js:35
msgid ""
"Default maximum width for every tour popover. A step can override this."
msgstr "Az összes útmutató felugró ablakának alapértelmezett maximális szélessége. Egy lépés felülbírálhatja ezt."

#: divi-5/public/modules.js:35
msgid "Tippy Animation"
msgstr "Tippy-animáció"

#: divi-5/public/modules.js:35
msgid "Animation used when the tour popover appears."
msgstr "Az útmutató felugró ablakának megjelenésekor használt animáció."

#: divi-5/public/modules.js:35
msgid "Progress Color"
msgstr "Folyamatjelző sáv színe"

#: divi-5/public/modules.js:35
msgid "Fill color of the step progress bar."
msgstr "A lépés folyamatjelző sávjának kitöltőszíne."

#: divi-5/public/modules.js:35
msgid "Background color of the progress track."
msgstr "A folyamatjelző sáv hátterének színe."

#: divi-5/public/modules.js:35
msgid "Control the size of the Primary button icon."
msgstr "Állítsa be az elsődleges gomb ikonjának méretét."

#: divi-5/public/modules.js:35
msgid "Control the size of the Secondary button icon."
msgstr "Állítsa be a másodlagos gomb ikonjának méretét."

#: divi-5/public/modules.js:35
msgid "Example heading"
msgstr "Példa címsor"

#: divi-5/public/modules.js:35
msgid "This is an example description for this tour step."
msgstr "Ez egy példaleírás az útmutató ezen lépéséhez."

#: divi-5/public/modules.js:35
msgid "CSS selector (not set)"
msgstr "CSS-szelektor (nincs beállítva)"

#: divi-5/public/modules.js:35
msgid "Module (not selected)"
msgstr "Modul (nincs kiválasztva)"

#: divi-5/public/modules.js:35
msgid "Heading shown in this tour step popover."
msgstr "Az útmutató lépésének felugró ablakában megjelenő címsor."

#: divi-5/public/modules.js:35
msgid "Body copy shown in this tour step popover."
msgstr "Az útmutató lépésének felugró ablakában megjelenő szöveg."

#: divi-5/public/modules.js:35
msgid ""
"Where the tour popover sits relative to the target. Centered steps ignore "
"this."
msgstr "Az útmutató felugró ablaka a célponthoz képest itt jelenik meg. A középre igazított lépések figyelmen kívül hagyják ezt a beállítást."

#: divi-5/public/modules.js:35
msgid "Cut a hole in the overlay so the target stays visible and clickable."
msgstr "Kivágás létrehozása a fedőrétegen, hogy a célpont látható és kattintható maradjon."

#: divi-5/public/modules.js:35
msgid "Overrides the parent tour popover background for this step."
msgstr "Ennél a lépésnél felülbírálja a szülő útmutató felugró ablakának háttérszínét."

#: divi-5/public/modules.js:35
msgid "Overrides the parent tour popover max width for this step."
msgstr "Ennél a lépésnél felülbírálja a szülő útmutató felugró ablakának maximális szélességét."

#: divi-5/public/modules.js:35
msgid "Describe this step for your visitors."
msgstr "Írja le ezt a lépést a látogatók számára."

#: divi-5/public/modules.js:35
msgid ""
"How the reveal runs and how the text animates (Animate.css). Click / tap "
"disables image lightbox on the preview; use Module Link for a custom URL."
msgstr "A felfedés módja és a szöveg animációja (Animate.css). Kattintásra/koppintásra az előnézetben kikapcsol a képet megjelenítő lightbox; egyéni URL használatához a Modul link beállítást használja."

#: divi-5/public/modules.js:35
msgid "Reveal trigger"
msgstr "Felfedés indítása"

#: divi-5/public/modules.js:35
msgid ""
"Hover: pointer enter/leave. Click: tap to toggle (best for touch). In view "
"once: plays when the module scrolls into view (stays revealed). Click "
"disables image lightbox so the tap can toggle the reveal."
msgstr "Rámutatás: az egérmutató belépésekor/kilépésekor. Kattintás: koppintással kapcsolható be vagy ki (érintőképernyőhöz ajánlott). Egyszeri indítás a nézetablakba kerüléskor: az animáció akkor indul el, amikor a modul görgetés közben láthatóvá válik, a modul pedig felfedett állapotban marad. Kattintáskor kikapcsol a képet megjelenítő lightbox, így koppintással kapcsolható a felfedés."

#: divi-5/public/modules.js:35
msgid "Click / tap (toggle)"
msgstr "Kattintás / koppintás (váltás)"

#: divi-5/public/modules.js:35
msgid "In view once"
msgstr "Egyszeri indítás a nézetablakba kerüléskor"

#: divi-5/public/modules.js:35
msgid "Reveal Duration Text"
msgstr "A szöveg felfedésének időtartama"

#: divi-5/public/modules.js:35
msgid "Duration for each character reveal animation."
msgstr "Az egyes karakterek felfedési animációjának időtartama."

#: divi-5/public/modules.js:35
msgid "Reveal Delay Text"
msgstr "A szöveg felfedésének késleltetése"

#: divi-5/public/modules.js:35
msgid "Base delay before staggered character animation."
msgstr "Alapkésleltetés a karakterek lépcsőzetes animációja előtt."

#: divi-5/public/modules.js:35
msgid ""
"Opens the image in a lightbox on the front end. In the Visual Builder, "
"Magnific Popup is initialized on the preview link when this is enabled."
msgstr "A képet lightboxban nyitja meg a nyilvános oldalon. Ha ez be van kapcsolva, a vizuális szerkesztőben a Magnific Popup inicializálódik az előnézeti linken."

#: divi-5/public/modules.js:35
msgid "Overlay Wipe Direction"
msgstr "A fedőréteg eltűnésének iránya"

#: divi-5/public/modules.js:35
msgid "How the colored overlay moves before the reveal text animates."
msgstr "A színes fedőréteg mozgásának módja a felfedési szöveg animációja előtt."

#: divi-5/public/modules.js:35
msgid "Left → Right"
msgstr "Balról jobbra"

#: divi-5/public/modules.js:35
msgid "Right → Left"
msgstr "Jobbról balra"

#: divi-5/public/modules.js:35
msgid "Top → Bottom"
msgstr "Fentről lefelé"

#: divi-5/public/modules.js:35
msgid "Bottom → Top"
msgstr "Lentről felfelé"

#: divi-5/public/modules.js:35
msgid "Zoom From Center"
msgstr "Nagyítás középről"

#: divi-5/public/modules.js:35
msgid ""
"Accessible name for the tab list, announced by screen readers. Use when the "
"default label is not clear enough."
msgstr "A füllista képernyőolvasók által felolvasott neve. Akkor használja, ha az alapértelmezett címke nem elég egyértelmű."

#: divi-5/public/modules.js:35
msgid "Tab labels"
msgstr "Fülfeliratok"

#: divi-5/public/modules.js:35
msgid "Title & appearance"
msgstr "Cím és megjelenés"

#: divi-5/public/modules.js:35
msgid "Tab appearance"
msgstr "Fül megjelenése"

#: divi-5/public/modules.js:35
msgid "Title Color"
msgstr "Cím színe"

#: divi-5/public/modules.js:35
msgid "Subtitle Color"
msgstr "Alcím színe"

#: divi-5/public/modules.js:35
msgid "Tab title"
msgstr "Fül címe"

#: divi-5/public/modules.js:35
msgid "Tab image & icon"
msgstr "Fül képe és ikonja"

#: divi-5/public/modules.js:35
msgid ""
"Aligns the tab image or icon when Tabs Image/Icon Placement is Top. Does not"
" move the tab title."
msgstr "A fül képének vagy ikonjának illesztése, ha a fülek képének/ikonjának elhelyezése fent van. A fül címének helyét nem módosítja."

#: divi-5/public/modules.js:35
msgid "Icon colors"
msgstr "Ikonszínek"

#: divi-5/public/modules.js:35
msgid "Content area image & icon"
msgstr "Tartalomterület képe és ikonja"

#: divi-5/public/modules.js:35
msgid "Layout & sizing"
msgstr "Elrendezés és méretezés"

#: divi-5/public/modules.js:35
msgid "Align the image or icon inside the content area."
msgstr "A kép vagy ikon illesztése a tartalomterületen belül."

#: divi-5/public/modules.js:35
msgid "Border & shadow"
msgstr "Keret és árnyék"

#: divi-5/public/modules.js:35
msgid "Content panel"
msgstr "Tartalompanel"

#: divi-5/public/modules.js:35
msgid "Choose whether to edit the content title or body text."
msgstr "Válassza ki, hogy a tartalom címét vagy törzsszövegét szeretné szerkeszteni."

#: divi-5/public/modules.js:35
msgid ""
"Overrides the parent alignment for this tab image or icon when placement is "
"Top. Default follows the parent."
msgstr "Felülre helyezés esetén felülírja a szülőelem illesztését ennél a fülképnél vagy -ikonnál. Alapértelmezés szerint a szülőelem beállítását követi."

#: divi-5/public/modules.js:35
msgid "Content panel spacing"
msgstr "Tartalompanel térköze"

#: divi-5/public/modules.js:35
msgid "Filter Content"
msgstr "Szűrőtartalom"

#: divi-5/public/modules.js:35
msgid ""
"Modules that render in the results area (Row, Group, Card, or a Loop-enabled"
" module). Filter-bar controls are under Filter Elements."
msgstr "Az eredmények területén megjelenített modulok (sor, csoport, kártya vagy Loop funkcióval rendelkező modul). A szűrősáv vezérlőelemei a Szűrőelemek alatt találhatók."

#: divi-5/public/modules.js:35
msgid "Add Element"
msgstr "Elem hozzáadása"

#: divi-5/public/modules.js:35
