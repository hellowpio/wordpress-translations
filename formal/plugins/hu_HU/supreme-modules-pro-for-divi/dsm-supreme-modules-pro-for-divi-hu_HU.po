msgstr "Középre igazított diák"

#: divi-5/public/modules.js:13
msgid "Center the active card instead of lining cards up on the left."
msgstr "Az aktív kártya középre igazítása a kártyák balra igazítása helyett."

#: divi-5/public/modules.js:13
msgid "Which way the reviews scroll."
msgstr "Az értékelések görgetési iránya."

#: divi-5/public/modules.js:13
msgid "Duration"
msgstr "Időtartam"

#: divi-5/public/modules.js:13
msgid "How long one full loop takes. A larger number is slower."
msgstr "Egy teljes ismétlődés időtartama. A nagyobb érték lassabb sebességet jelent."

