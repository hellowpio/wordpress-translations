msgid "Distribution Bars"
msgstr "Eloszlássávok"

#: divi-5/public/modules.js:37
msgid "How many of those bars to show."
msgstr "A megjelenítendő sávok száma."

#: divi-5/public/modules.js:37
msgid "Rating UI"
msgstr "Értékelési felület"

#: divi-5/public/modules.js:37
msgid "How people pick a star rating."
msgstr "A csillagos értékelés kiválasztásának módja."

#: divi-5/public/modules.js:37
msgid "Filters products by star rating."
msgstr "A termékek szűrése csillagos értékelés szerint."

#: divi-5/public/modules.js:37
msgid "Filters products by in stock, out of stock, or on backorder."
msgstr "A termékek szűrése készleten lévő, elfogyott vagy utánrendelhető állapot szerint."

#: divi-5/public/modules.js:37
msgid "Option Gap"
msgstr "Opciók közötti távolság"

#: divi-5/public/modules.js:37
msgid "Wrap Options"
msgstr "Tördelési opciók"

