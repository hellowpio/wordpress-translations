msgid "Space between the rating choices."
msgstr "Az értékelési lehetőségek közötti távolság."

#: divi-5/public/modules.js:37
msgid "Space between the radio choices."
msgstr "A rádiógombos lehetőségek közötti távolság."

#: divi-5/public/modules.js:37
msgid "Space between the checkbox choices."
msgstr "A jelölőnégyzetes lehetőségek közötti távolság."

