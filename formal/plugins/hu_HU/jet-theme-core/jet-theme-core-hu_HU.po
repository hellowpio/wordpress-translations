#: includes/api.php:148
msgid "Your license is missing. Please check your key again."
msgstr "Hiányzik az Ön licence. Kérjük, ellenőrizze újra a kulcsát."

#: includes/api.php:149
#, php-format
msgid ""
"<strong>You have no more activations left.</strong> <a href=\"%s\" "
"target=\"_blank\">Please upgrade to a more advanced license</a> (you'll only"
" need to cover the difference)."
msgstr "<strong>Önnek nem maradt több aktiválása.</strong> <a href=\"%s\" target=\"_blank\">Kérjük, frissítsen egy magasabb szintű, haladó licencre</a> (csak a különbözetet kell fedeznie)."

#: includes/api.php:150
#, php-format
msgid ""
"<strong>Your License Has Expired.</strong> <a href=\"%s\" "
"target=\"_blank\">Renew your license today</a> to keep getting feature "
"updates, premium support and unlimited access to the template library."
msgstr ""
"<strong>Az Ön licence lejárt.</strong> <a href=\"%s\" "
"target=\"_blank\">Újítsa meg licencét még ma</a>, hogy továbbra is megkapja "
"a funkciófrissítéseket, a prémium támogatást és korlátlan hozzáférést a "
"sablonkönyvtárhoz."

#: includes/api.php:151 includes/api.php:152
msgid ""
"<strong>Your license key has been cancelled</strong> (most likely due to a "
"refund request). Please consider acquiring a new license."
msgstr ""
"<strong>Az Ön licenckulcsát visszavonták</strong> (feltehetően "
"visszatérítési kérelem miatt). Kérjük, fontolja meg új licenc beszerzését."

#: includes/api.php:153 includes/api.php:155
msgid ""
"<strong>Your license key doesn't match your current domain</strong>. This is"
" most likely due to a change in the domain URL of your site (including "
"HTTPS/SSL migration). Please deactivate the license and then reactivate it "
"again."
msgstr "<strong>Az Ön licenckulcsa nem egyezik az aktuális domainnel</strong>. Ez feltehetően a webhelye domainjének URL-jében bekövetkezett változás miatt történt (beleértve a HTTPS/SSL-áttelepítést). Kérjük, kapcsolja ki a licencet, majd kapcsolja be újra."

#: includes/api.php:154
msgid ""
"<strong>Your license key doesn't match your current domain</strong>. This is"
" most likely due to a change in the domain URL. Please deactivate the "
"license and then reactivate it again."
msgstr "<strong>Az Ön licenckulcsa nem egyezik az aktuális domainnel</strong>. Ez feltehetően a domain URL-jének megváltozása miatt történt. Kérjük, kapcsolja ki a licencet, majd kapcsolja be újra."

#: includes/api.php:158
msgid ""
"An error occurred. Please check your internet connection and try again. If "
"the problem persists, contact our support."
msgstr ""
"Hiba történt. Kérjük, ellenőrizze az internetkapcsolatát, majd próbálja meg "
"újra. Ha a probléma továbbra is fennáll, lépjen kapcsolatba "
"ügyfélszolgálatunkkal."

