#. Plugin Name of the plugin
#: affiliatewp-multi-tier-commissions.php
msgid "AffiliateWP - Multi-Tier Commissions"
msgstr "AffiliateWP - Többszintű jutalékok"

#. Plugin URI of the plugin
#: affiliatewp-multi-tier-commissions.php
msgid "https://affiliatewp.com/addons/multi-tier-commissions/"
msgstr "https://affiliatewp.com/addons/multi-tier-commissions/"

#. Description of the plugin
#: affiliatewp-multi-tier-commissions.php
msgid ""
"Enables your affiliates to grow their networks and boost earnings through "
"recruit sales, improving overall sales and benefiting both your business and"
" your affiliates."
msgstr "Lehetővé teszi partnerei számára, hogy bővítsék hálózatukat, és növeljék bevételeiket a toborzott partnerek értékesítései révén. Ezáltal az összértékesítés is növekszik, ami mind a vállalkozásának, mind a partnereinek előnyére válik."

#. Author of the plugin
#: affiliatewp-multi-tier-commissions.php
#: includes/lib/affwp/class-affiliatewp-activation.php:118
msgid "AffiliateWP"
msgstr "AffiliateWP"

