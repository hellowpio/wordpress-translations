msgstr "A WP All Import licencének állapota:"

#: views/admin/settings/_tab_licenses.php:52
#: views/admin/settings/_tab_licenses.php:127
msgid "Checking…"
msgstr "Ellenőrzés…"

#: views/admin/settings/_tab_licenses.php:63
msgid "Activate WP All Import license"
msgstr "WP All Import-licenc bekapcsolása"

#: views/admin/settings/_tab_licenses.php:66
#: views/admin/settings/_tab_licenses.php:136
