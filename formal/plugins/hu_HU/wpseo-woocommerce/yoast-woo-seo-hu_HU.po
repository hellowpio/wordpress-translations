#. Plugin Name of the plugin
#: wpseo-woocommerce.php
msgid "Yoast SEO: WooCommerce"
msgstr "Yoast SEO: WooCommerce"

#. Plugin URI of the plugin
#: wpseo-woocommerce.php
msgid "https://yoa.st/4fu"
msgstr "https://yoa.st/4fu"

#. Description of the plugin
#: wpseo-woocommerce.php
msgid ""
"This extension to WooCommerce and Yoast SEO makes sure there's perfect "
"communication between the two plugins."
msgstr "Ez a WooCommerce-hez és a Yoast SEO-hoz készült kiegészítő gondoskodik a két bővítmény közötti tökéletes kommunikációról."

#. Author of the plugin
#: wpseo-woocommerce.php
msgid "Team Yoast"
msgstr "Team Yoast"

#. Author URI of the plugin
#: wpseo-woocommerce.php
msgid "https://yoa.st/team-yoast-woocommerce"
msgstr "https://yoa.st/team-yoast-woocommerce"

