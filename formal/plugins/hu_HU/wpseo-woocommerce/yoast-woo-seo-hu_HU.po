msgstr "Elfogyott"

#: classes/woocommerce-slack.php:46
msgid "In stock"
msgstr "Raktáron"

#: classes/woocommerce-slack.php:50
msgid "On backorder"
msgstr "Visszarendelhető"

#: classes/woocommerce-slack.php:63
msgid "Price"
msgstr "Ár"

#: classes/woocommerce-slack.php:65
msgid "Availability"
msgstr "Elérhetőség"

#: classes/woocommerce-yoast-ids.php:44
msgid "Yoast SEO options"
msgstr "Yoast SEO beállítások"

#: classes/woocommerce-yoast-ids.php:45
msgid ""
"If this product variation has unique identifiers, you can enter them here"
msgstr ""
"Ha ennek a termékváltozatnak vannak egyedi azonosítói, itt adhatja meg őket"

#: classes/woocommerce-yoast-tab.php:63
msgid "Product identifiers"
msgstr "Termékazonosítók"

#. translators: %1$s resolves to Yoast SEO
#: classes/woocommerce-yoast-tab.php:66
#, php-format
msgid ""
"If you have any of these unique identifiers for your products, please add "
"them here. %1$s will use them in your Schema and OpenGraph output."
msgstr "Ha rendelkezik a termékeihez ilyen egyedi azonosítókkal, adja meg őket itt. A(z) %1$s ezeket felhasználja a Schema és az OpenGraph kimenetben."

