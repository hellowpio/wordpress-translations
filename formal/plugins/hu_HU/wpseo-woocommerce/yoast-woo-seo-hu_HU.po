msgid_plural "%s alt texts"
msgstr[0] "%s alternatív szöveg"
msgstr[1] "%s alternatív szövegek"

#. translators: %d expands to the number of rows with unsaved changes.
#: js/dist/yoastseo-woo-bulk-editor-image-alt-text-1700.js:6
#: js/dist/yoastseo-woo-product-images-1700.js:6
msgid "%d row with unsaved changes"
msgid_plural "%d rows with unsaved changes"
msgstr[0] "%d sor nem mentett módosításokkal"
msgstr[1] "%d sor nem mentett módosításokkal"

#: js/dist/yoastseo-woo-bulk-editor-image-alt-text-1700.js:6
#: js/dist/yoastseo-woo-product-images-1700.js:6
msgid "Apply all"
msgstr "Összes alkalmazása"

#: js/dist/yoastseo-woo-bulk-editor-image-alt-text-1700.js:6
#: js/dist/yoastseo-woo-product-images-1700.js:6
