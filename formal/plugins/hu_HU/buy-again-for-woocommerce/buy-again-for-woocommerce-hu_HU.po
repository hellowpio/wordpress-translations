msgstr "Beállítja a címsor alatt megjelenő leírást."

#: inc/admin/menu/tabs/shortcodes.php:240
msgid "Displays the form using the labels configured under Localization."
msgstr "A honosítás alatt beállított címkékkel jeleníti meg az űrlapot."

#: inc/admin/menu/tabs/shortcodes.php:244
