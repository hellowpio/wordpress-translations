#. Plugin Name of the plugin
#: userregistration.php
msgid "Gravity Forms User Registration Add-On"
msgstr "Gravity Forms felhasználói regisztrációs kiegészítő"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: userregistration.php
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
#: userregistration.php
msgid ""
"Allows WordPress users to be automatically created upon submitting a Gravity"
" Form."
msgstr "Lehetővé teszi WordPress-felhasználók automatikus létrehozását egy Gravity Form űrlap beküldésekor."

#. Author of the plugin
#: userregistration.php
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-user-registration.php:110
msgid "Process the feed only when a payment is received."
msgstr "A feed feldolgozása csak a fizetés beérkezésekor történjen."

#: class-gf-user-registration.php:217
msgid "User Activation URL"
msgstr "Felhasználóaktiválási URL"

#: class-gf-user-registration.php:218
msgid "Set Password URL"
msgstr "Jelszóbeállítási URL"

#: class-gf-user-registration.php:555
msgid "Passwords may not contain the character \"\\\""
msgstr "A jelszó nem tartalmazhatja a „\\” karaktert"

#: class-gf-user-registration.php:637
msgid "The email address can not be empty"
msgstr "Az e-mail cím nem lehet üres"

#: class-gf-user-registration.php:643
msgid ""
"That email address has already been used. Please check your inbox for an "
"activation email. It will become available in a couple of days if you do "
"nothing."
msgstr "Ezt az e-mail címet már használták. Kérjük, ellenőrizze a beérkező leveleit, és keresse az aktiváló e-mailt. Ha nem tesz semmit, néhány nap múlva elérhetővé válik."

#: class-gf-user-registration.php:648 class-gf-user-registration.php:650
msgid "This email address is already registered"
msgstr "Ez az e-mail cím már regisztrálva van"

#: class-gf-user-registration.php:662
msgid "The username can not be empty"
msgstr "A felhasználónév nem lehet üres"

#: class-gf-user-registration.php:668
msgid ""
"This username is invalid because it uses illegal characters. Please enter a "
"valid username."
msgstr "Ez a felhasználónév érvénytelen, mert tiltott karaktereket tartalmaz. Kérjük, adjon meg érvényes felhasználónevet."

#: class-gf-user-registration.php:674
msgid ""
"The username can only contain alphanumeric characters (A-Z, 0-9), "
"underscores and dashes"
msgstr "A felhasználónév csak alfanumerikus karaktereket (A–Z, 0–9), aláhúzásjeleket és kötőjeleket tartalmazhat"

#: class-gf-user-registration.php:680
msgid "This username is already registered"
msgstr "Ez a felhasználónév már regisztrálva van"

#: class-gf-user-registration.php:685
msgid ""
"That username is currently reserved but may be available in a couple of days"
msgstr "Ez a felhasználónév jelenleg foglalt, de néhány nap múlva elérhető lehet"

#: class-gf-user-registration.php:863
#, php-format
msgid "User already exists. ID: %d."
msgstr "A felhasználó már létezik. ID: %d."

#. translators: %s is the error message from wp_create_user()
#: class-gf-user-registration.php:877
#, php-format
msgid "Unable to create user. Error from wp_create_user(): %s"
msgstr "Nem sikerült létrehozni a felhasználót. A wp_create_user() függvény hibája: %s"

#: class-gf-user-registration.php:943
#, php-format
msgid "User created. ID: %d."
msgstr "A felhasználó létrejött. ID: %d."

#: class-gf-user-registration.php:1190
msgid "Use the password you set at registration to login."
msgstr "A belépéshez használja a regisztrációkor beállított jelszót."

#: class-gf-user-registration.php:1195
msgid ""
"Forgot your password? Visit the following address to reset your password:"
msgstr "Elfelejtette a jelszavát? A jelszó alaphelyzetbe állításához keresse fel a következő címet:"

#: class-gf-user-registration.php:1265
msgid "Oops! You need to be logged in to use this form."
msgstr "Hoppá! Az űrlap használatához be kell jelentkeznie."

#. translators: %d is the user ID, %s is the error message from
#. wp_update_user()
#: class-gf-user-registration.php:1544
#, php-format
msgid ""
"Unable to complete updating user (ID: %1$d). Error from wp_update_user(): "
"%2$s"
msgstr "Nem sikerült befejezni a felhasználó frissítését (ID: %1$d). A wp_update_user() függvény hibája: %2$s"

#: class-gf-user-registration.php:1574
#, php-format
msgid "User updated. ID: %d."
msgstr "A felhasználó frissült. ID: %d."

#: class-gf-user-registration.php:1966
#, php-format
msgid "User already exists for %s."
msgstr "Már létezik felhasználó ehhez: %s."

#: class-gf-user-registration.php:2006
msgid "User is pending activation."
msgstr "A felhasználó aktiválása függőben van."

#: class-gf-user-registration.php:2100
msgid "Select BuddyPress Field"
msgstr "BuddyPress-mező kiválasztása"

#. Translators: %s: BuddyPress group name. %d: BuddPress group ID.
#: class-gf-user-registration.php:2122
#, php-format
msgid "%s (ID: %d)"
msgstr "%s (ID: %d)"

#: class-gf-user-registration.php:2321 includes/class-gf-login-widget.php:221
msgid "Register"
msgstr "Regisztráció"

#: class-gf-user-registration.php:2323
msgid "Forgot Password"
msgstr "Elfelejtett jelszó"

#: class-gf-user-registration.php:2427
#, php-format
msgid "You are currently logged in as %s%s%s. %sLog out?%s"
msgstr "Ön jelenleg %s%s%s felhasználóként van bejelentkezve. %sKijelentkezik?%s"

#: class-gf-user-registration.php:2432
msgid "Logout"
msgstr "Kijelentkezés"

#: class-gf-user-registration.php:2640
msgid "Login Form"
msgstr "Bejelentkezési űrlap"

#: class-gf-user-registration.php:2644 includes/class-gf-login-widget.php:36
#: includes/class-gf-login-widget.php:211
msgid "Login"
msgstr "Belépés"

#: class-gf-user-registration.php:2654 class-gf-user-registration.php:3043
#: class-gf-user-registration.php:3051 includes/class-gf-field-username.php:85
#: includes/class-gf-pending-activations-list.php:19
msgid "Username"
msgstr "Felhasználónév"

#: class-gf-user-registration.php:2662 class-gf-user-registration.php:3111
#: class-gf-user-registration.php:3119
msgid "Password"
msgstr "Jelszó"

#: class-gf-user-registration.php:2671 class-gf-user-registration.php:2678
msgid "Remember Me"
msgstr "Bejelentkezés megjegyzése"

#: class-gf-user-registration.php:2786 class-gf-user-registration.php:2791
msgid "Access denied."
msgstr "Hozzáférés megtagadva."

#: class-gf-user-registration.php:2911
msgid "Global Settings"
msgstr "Globális beállítások"

#: class-gf-user-registration.php:2916 class-gf-user-registration.php:2924
msgid "Custom Registration Page"
msgstr "Egyéni regisztrációs oldal"

#: class-gf-user-registration.php:2920
msgid "Enable Custom Registration Page"
msgstr "Egyéni regisztrációs oldal bekapcsolása"

#: class-gf-user-registration.php:2924
msgid ""
"When users attempt to access the default WordPress registration page, they "
"will be redirected to this custom page instead."
msgstr "Ha a felhasználók megpróbálják megnyitni az alapértelmezett WordPress-regisztrációs oldalt, a rendszer erre az egyéni oldalra irányítja át őket."

#: class-gf-user-registration.php:2929
msgid "Registration Page"
msgstr "Regisztrációs oldal"

#: class-gf-user-registration.php:2931
msgid "Select a Page"
msgstr "Oldal kiválasztása"

#: class-gf-user-registration.php:2956
msgid "Pages"
msgstr "Oldalak"

#: class-gf-user-registration.php:2973
msgid "Other"
msgstr "Egyéb"

#: class-gf-user-registration.php:2976
msgid "Custom URL"
msgstr "Egyéni URL"

#: class-gf-user-registration.php:3005
msgid "Feed Settings"
msgstr "Adatfolyam-beállítások"

#: class-gf-user-registration.php:3010 class-gf-user-registration.php:3014
#: class-gf-user-registration.php:4036
msgid "Name"
msgstr "Név"

#: class-gf-user-registration.php:3014
msgid "Enter a feed name to uniquely identify this setup."
msgstr "Adjon meg egy feednevet, amellyel egyedileg azonosítható ez a beállítás."

#: class-gf-user-registration.php:3018 class-gf-user-registration.php:3023
#: class-gf-user-registration.php:4037
msgid "Action"
msgstr "Művelet"

#: class-gf-user-registration.php:3024
msgid ""
"Select the type of feed you would like to create. \"Create\" feeds will "
"create a new user. \"Update\" feeds will update users."
msgstr "Válassza ki a létrehozni kívánt feed típusát. A „létrehozás” típusú feedek új felhasználót hoznak létre. A „frissítés” típusú feedek frissítik a felhasználókat."

#: class-gf-user-registration.php:3025
msgid ""
"A form can have multiple \"Create\" feeds <strong>or</strong> a single "
"\"Update\" feed. A form cannot have both a \"Create\" feed and an \"Update\""
" feed."
msgstr "Egy űrlaphoz több „létrehozás” típusú feed <strong>vagy</strong> egyetlen „frissítés” típusú feed tartozhat. Egy űrlaphoz nem tartozhat egyszerre „létrehozás” és „frissítés” típusú feed."

#: class-gf-user-registration.php:3034
msgid "User Settings"
msgstr "Felhasználói beállítások"

#: class-gf-user-registration.php:3051
msgid "Select the form field that should be used for the user's username."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a felhasználóneveként kell használni."

#: class-gf-user-registration.php:3059 class-gf-user-registration.php:3065
msgid "First Name"
msgstr "Keresztnév"

#: class-gf-user-registration.php:3065
msgid "Select the form field that should be used for the user's first name."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a felhasználó keresztneveként kell használni."

#: class-gf-user-registration.php:3069 class-gf-user-registration.php:3075
msgid "Last Name"
msgstr "Vezetéknév"

#: class-gf-user-registration.php:3075
msgid "Select the form field that should be used for the user's last name."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a felhasználó vezetékneveként kell használni."

#: class-gf-user-registration.php:3079 class-gf-user-registration.php:3085
msgid "Nickname"
msgstr "Becenév"

#: class-gf-user-registration.php:3085
msgid "Select the form field that should be used for the user's nickname."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a felhasználó beceneveként kell használni."

#: class-gf-user-registration.php:3089 class-gf-user-registration.php:3093
msgid "Display Name"
msgstr "Megjelenített név"

#: class-gf-user-registration.php:3093
msgid "Select how the user's name should be displayed publicly."
msgstr "Válassza ki, hogyan jelenjen meg nyilvánosan a felhasználó neve."

#: class-gf-user-registration.php:3097 class-gf-user-registration.php:3107
msgid "Email Address"
msgstr "E-mail cím"

#: class-gf-user-registration.php:3106
msgid "You must have at least one Email Address field."
msgstr "Legalább egy e-mail-cím mező szükséges."

#: class-gf-user-registration.php:3107
msgid ""
"Select the form field that should be used for the user's email address."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a felhasználó e-mail-címeként kell használni."

#: class-gf-user-registration.php:3119
msgid ""
"Select the form field that should be used for the user's password or select "
"\"Set Password via Email Link\" to have a URL emailed to the user where they"
" can set their password."
msgstr "Válassza ki azt az űrlapmezőt, amely a felhasználó jelszavát tartalmazza, vagy válassza a „Jelszó beállítása e-mailben küldött linken keresztül” lehetőséget, hogy a felhasználó e-mailben megkapja a jelszava beállításához használható URL-t."

#: class-gf-user-registration.php:3123 class-gf-user-registration.php:3128
msgid "Role"
msgstr "Szerep"

#: class-gf-user-registration.php:3128
msgid "Select the role the user should be assigned."
msgstr "Válassza ki, melyik szerepkört kapja a felhasználó."

#: class-gf-user-registration.php:3139
msgid "User Meta"
msgstr "Felhasználói metaadat"

#: class-gf-user-registration.php:3158
msgid "BuddyPress Profile"
msgstr "BuddyPress-profil"

#: class-gf-user-registration.php:3171
msgid "Name or Name|GroupID"
msgstr "Név vagy Név|Csoportazonosító"

#: class-gf-user-registration.php:3183
msgid "Network Options"
msgstr "Hálózati opciók"

#: class-gf-user-registration.php:3192
msgid "Create Site"
msgstr "Webhely létrehozása"

#: class-gf-user-registration.php:3196
msgid "Create new site when a user registers."
msgstr "Új webhely létrehozása felhasználói regisztrációkor."

#: class-gf-user-registration.php:3204 class-gf-user-registration.php:3207
msgid "Site Address"
msgstr "Webhely címe"

#: class-gf-user-registration.php:3207
msgid "Select the form field that should be used for the site address."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a webhely címeként kell használni."

#: class-gf-user-registration.php:3216 class-gf-user-registration.php:3219
msgid "Site Title"
msgstr "Webhely címe"

#: class-gf-user-registration.php:3219
msgid "Select the form field that should be used for the site title."
msgstr "Válassza ki azt az űrlapmezőt, amelyet a webhely címeként kell használni."

#: class-gf-user-registration.php:3229 class-gf-user-registration.php:3233
msgid "Site Role"
msgstr "Webhelyszerepkör"

#: class-gf-user-registration.php:3233
msgid "Select role the user should be assigned on the newly created site."
msgstr "Válassza ki, melyik szerepkört kapja a felhasználó az újonnan létrehozott webhelyen."

#: class-gf-user-registration.php:3242 class-gf-user-registration.php:3246
msgid "Current Site Role"
msgstr "Aktuális webhelyszerepkör"

#: class-gf-user-registration.php:3246
msgid ""
"Select role the user should be assigned on the site they registered from. "
"This option overrides the \"Role\" option under User Settings."
msgstr "Válassza ki, melyik szerepkört kapja a felhasználó azon a webhelyen, ahonnan regisztrált. Ez az opció felülírja a felhasználói beállítások „Szerepkör” opcióját."

#: class-gf-user-registration.php:3255 class-gf-user-registration.php:3265
#: class-gf-user-registration.php:3281 class-gf-user-registration.php:3312
msgid "Send Email?"
msgstr "E-mail küldése?"

#: class-gf-user-registration.php:3259
msgid "Send the new site details to the user by email."
msgstr "Az új webhely részleteinek elküldése e-mailben a felhasználónak."

#: class-gf-user-registration.php:3265
#, php-format
msgid ""
"Specify whether to send the new site details to the user by email. %sEnabled"
" by default.%s"
msgstr "Adja meg, hogy elküldje-e e-mailben az új webhely részleteit a felhasználónak. %sAlapértelmezés szerint bekapcsolva.%s"

#: class-gf-user-registration.php:3272
msgid "Additional Options"
msgstr "További opciók"

#: class-gf-user-registration.php:3284
msgid "Send the new user an email about their account."
msgstr "Küldjön e-mailt az új felhasználónak a fiókjáról."

#: class-gf-user-registration.php:3285
msgid "Send the new user an email about their account:"
msgstr "E-mail küldése az új felhasználónak a fiókjáról:"

#: class-gf-user-registration.php:3292 class-gf-user-registration.php:3329
msgid "by email from WordPress"
msgstr "e-mailben a WordPresstől"

#: class-gf-user-registration.php:3296
msgid "by form notification"
msgstr "űrlapértesítéssel"

#: class-gf-user-registration.php:3302
msgid "Send Email Options"
msgstr "E-mail-küldési opciók"

#: class-gf-user-registration.php:3304
#, php-format
msgid ""
"%3$s\n"
"\t\t\t\t\t\t\t\t\t%1$sBy email from WordPress:%2$s%3$s WordPress will send the user an email with their login and a login URL. If the %1$sPassword%2$s setting is configured to \"Set Password via Email Link\", WordPress will include a link where the user can set their password.%3$s%3$s\n"
"\t\t\t\t\t\t\t\t\t%1$sBy form notification:%2$s%3$s Configure a form notification for the desired User Registration event. If the %1$sPassword%2$s setting is configured to \"Set Password via Email Link\", you must include the %4$s{set_password_url}%5$s merge tag in your notification to provide a URL where the user can set their password."
msgstr "%3$s\n\t\t\t\t\t\t\t\t\t%1$sWordPress által küldött e-mailben:%2$s%3$s A WordPress e-mailt küld a felhasználónak a belépési adataival és a belépési URL-lel. Ha a %1$sJelszó%2$s beállítás értéke „Jelszó beállítása e-mailben küldött linken keresztül”, a WordPress egy olyan linket is küld, ahol a felhasználó beállíthatja a jelszavát.%3$s%3$s\n\t\t\t\t\t\t\t\t\t%1$sŰrlapértesítésben:%2$s%3$s Állítson be űrlapértesítést a kívánt felhasználó-regisztrációs eseményhez. Ha a %1$sJelszó%2$s beállítás értéke „Jelszó beállítása e-mailben küldött linken keresztül”, az értesítésben szerepelnie kell a %4$s{set_password_url}%5$s egyesítési címkének, amely megadja a felhasználó jelszóbeállításához szükséges URL-t."

#: class-gf-user-registration.php:3312
#, php-format
msgid ""
"Specify whether an email (or notification) should be sent to the new user "
"about their account. %sEnabled by default.%s"
msgstr "Adja meg, hogy kapjon-e az új felhasználó e-mailt (vagy értesítést) a fiókjáról. %sAlapértelmezés szerint bekapcsolva.%s"

#: class-gf-user-registration.php:3320 class-gf-user-registration.php:3347
msgid "User Activation"
msgstr "Felhasználó aktiválása"

#: class-gf-user-registration.php:3323
msgid "Enable user activation."
msgstr "Felhasználó-aktiválás bekapcsolása."

#: class-gf-user-registration.php:3324
msgid "Enable user activation:"
msgstr "Felhasználó-aktiválás bekapcsolása:"

#: class-gf-user-registration.php:3333
msgid "manually or by form notification"
msgstr "manuálisan vagy űrlapértesítéssel"

#: class-gf-user-registration.php:3338
msgid "User Activation Type"
msgstr "Felhasználó-aktiválás típusa"

#: class-gf-user-registration.php:3340
#, php-format
msgid ""
"%3$s\n"
"\t\t\t\t\t\t\t\t%1$sBy Email:%2$s%3$sWordPress will send the user an email with an activation link.%3$s%3$s\n"
"\t\t\t\t\t\t\t\t%1$sManually:%2$s%3$sActivate each user manually from the Pending Activations page or send a form notification for the User Activation event with an activation link (via the %4$s{activation_url}%5$s merge tag)."
msgstr "%3$s\n\t\t\t\t\t\t\t\t%1$sE-mailben:%2$s%3$sA WordPress e-mailt küld a felhasználónak egy bekapcsolási linkkel.%3$s%3$s\n\t\t\t\t\t\t\t\t%1$sManuálisan:%2$s%3$sA felhasználókat egyenként kapcsolja be a Függőben lévő bekapcsolások oldalon, vagy küldjön űrlapértesítést a Felhasználó bekapcsolása eseményhez, amely bekapcsolási linket tartalmaz (a %4$s{activation_url}%5$s egyesítési címkén keresztül)."

#: class-gf-user-registration.php:3347
msgid ""
"Send users an email with an activation link. Users are only registered once "
"they have activated their accounts."
msgstr "Küldjön a felhasználóknak e-mailt aktiváló linkkel. A felhasználók csak a fiókjuk aktiválása után kerülnek regisztrálásra."

#: class-gf-user-registration.php:3355 class-gf-user-registration.php:3360
msgid "Update Condition"
msgstr "Frissítési feltétel"

#: class-gf-user-registration.php:3355 class-gf-user-registration.php:3361
msgid "Registration Condition"
msgstr "Regisztrációs feltétel"

#: class-gf-user-registration.php:3357
msgid "Enable"
msgstr "Bekapcsolás"

#: class-gf-user-registration.php:3358
msgid "Update user if"
msgstr "Felhasználó frissítése, ha"

#: class-gf-user-registration.php:3358
msgid "Register user if"
msgstr "Felhasználó regisztrálása, ha"

#: class-gf-user-registration.php:3360
msgid ""
"When the update condition is enabled, form submissions will only update the "
"user when the condition is met. The user data will always be populated into "
"the form."
msgstr "Ha a frissítési feltétel be van kapcsolva, az űrlap beküldése csak akkor frissíti a felhasználót, ha a feltétel teljesül. A felhasználói adatok mindig bekerülnek az űrlapba."

#: class-gf-user-registration.php:3361
msgid ""
"When the registration condition is enabled, form submissions will only "
"register the user when the condition is met."
msgstr "Ha a regisztrációs feltétel be van kapcsolva, az űrlap beküldése csak akkor regisztrálja a felhasználót, ha a feltétel teljesül."

#: class-gf-user-registration.php:3371 class-gf-user-registration.php:3381
msgid "Set Post Author"
msgstr "Bejegyzés szerzőjének beállítása"

#: class-gf-user-registration.php:3375
msgid "Set user as post author."
msgstr "Felhasználó beállítása bejegyzés szerzőjeként."

#: class-gf-user-registration.php:3381
#, php-format
msgid ""
