#. Plugin Name of the plugin
#: mainwp-cost-tracker-assistant-extension.php
msgid "MainWP Cost Tracker Assistant Extension"
msgstr "MainWP Cost Tracker Assistant Extension"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-cost-tracker-assistant-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-cost-tracker-assistant-extension.php
msgid ""
"Enhance your MainWP Dashboard by adding timely notifications for upcoming "
"subscription renewals and automates cost tracking for newly installed "
"plugins and themes through zip uploads, streamlining cost management tasks."
msgstr "Bővítse MainWP vezérlőpultját a közelgő előfizetés-megújításokról szóló időbeni értesítésekkel, és automatizálja az újonnan telepített bővítmények és sablonok költségkövetését ZIP-fájlok feltöltésével, így egyszerűsítve a költségkezelést."

#. Author of the plugin
#: mainwp-cost-tracker-assistant-extension.php
#: templates/emails/mainwp-cost-tracker-assistant-email.php:72
msgid "MainWP"
msgstr "MainWP"

#: class/class-mainwp-cost-tracker-assistant-abilities.php:34
msgid "MainWP Cost Tracker Assistant"
msgstr "MainWP Cost Tracker Assistant"

#: class/class-mainwp-cost-tracker-assistant-abilities.php:35
msgid "Read Assistant status and costs inside its renewal alert window."
msgstr "Az Assistant állapotának és költségeinek megtekintése a megújítási értesítési időszakon belül."

#: class/class-mainwp-cost-tracker-assistant-abilities.php:47
msgid "Get Cost Tracker Assistant Status"
msgstr "A Cost Tracker Assistant állapotának lekérése"

#: class/class-mainwp-cost-tracker-assistant-abilities.php:47
msgid ""
"Read Assistant settings and alert schedule without email settings or "
"recipients."
msgstr "Az Assistant beállításainak és értesítési időzítésének megtekintése e-mail-beállítások és címzettek nélkül."

#: class/class-mainwp-cost-tracker-assistant-abilities.php:48
msgid "List Upcoming Cost Renewal Alerts"
msgstr "A közelgő költségmegújítási értesítések listázása"

#: class/class-mainwp-cost-tracker-assistant-abilities.php:48
msgid ""
"List active non-lifetime costs inside the configured renewal alert window, "
"including recently alerted costs. Alert due reflects only the seven-day "
"resend rule; no alerts are sent."
msgstr "A beállított megújítási értesítési időszakon belüli aktív, nem élettartamra szóló költségek listázása, beleértve a nemrég értesített költségeket is. Az értesítés esedékessége csak a hétnapos újraküldési szabályt tükrözi; a rendszer nem küld ki értesítéseket."

#: class/class-mainwp-cost-tracker-assistant-abilities.php:231
msgid "You cannot read Cost Tracker Assistant."
msgstr "Ön nem olvashatja a Cost Tracker Assistant adatait."

#: class/class-mainwp-cost-tracker-assistant-abilities.php:236
msgid "The Cost Tracker Assistant input is invalid."
msgstr "A Cost Tracker Assistant bemenete hibás."

