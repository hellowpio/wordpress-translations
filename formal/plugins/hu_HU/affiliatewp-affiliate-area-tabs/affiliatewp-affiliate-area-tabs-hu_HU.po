msgstr "Adja meg a fül címét."

#: includes/class-admin.php:359
msgid "Tab Content"
msgstr "Fül tartalma"

#: includes/class-admin.php:360
msgid ""
"Select which page will be used for the tab's content. This page will be "
"blocked for non-affiliates."
msgstr "Válassza ki, melyik oldal tartalma jelenjen meg a fülön. Ez az oldal nem lesz elérhető a nem partnerek számára."

#: includes/class-admin.php:382
msgid "Hide tab in Affiliate Area"
msgstr "Fül elrejtése az Affiliate Area-ban"

#: includes/class-admin.php:394
msgid "Delete tab"
msgstr "Fül törlése"

#: includes/class-affiliatewp-affiliate-area-tabs.php:108
#: includes/class-affiliatewp-affiliate-area-tabs.php:120
