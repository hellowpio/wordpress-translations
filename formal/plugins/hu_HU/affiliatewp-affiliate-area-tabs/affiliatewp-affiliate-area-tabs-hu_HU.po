#: includes/class-activation.php:108
#, php-format
msgid ""
"Your version of PHP is below the minimum version of PHP required by %s. "
"Please contact your host and request that your version be upgraded to 5.3 or"
" later."
msgstr "Az Ön PHP-verziója alacsonyabb a %s által megkövetelt minimális PHP-verziónál. Kérjük, vegye fel a kapcsolatot a tárhelyszolgáltatójával, és kérje a PHP-verzió 5.3-as vagy újabb verzióra történő frissítését."

#: includes/class-admin.php:22 includes/class-admin.php:39
#: includes/class-admin.php:61
msgid "Affiliate Area Tabs"
msgstr "Affiliate Area-fülek"

#: includes/class-admin.php:78 includes/class-admin.php:233
