msgstr "További AffiliateWP-kiegészítők beszerzése"

#: includes/class-affiliatewp-affiliate-area-tabs.php:507
msgid "More add-ons"
msgstr "További kiegészítők"

#: includes/class-functions.php:139
msgid "Coupons"
msgstr "Kuponok"

#: includes/class-functions.php:322
#, php-format
msgid ""
"This tab has been added from the %s add-on. Only affiliates with direct link"
" tracking enabled will see this tab in the Affiliate Area."
msgstr "Ezt a fület a(z) %s kiegészítő adta hozzá. Az Affiliate Area-ban csak azok a partnerek látják, akiknél be van kapcsolva a közvetlen linkkövetés."

#: includes/class-functions.php:326
#, php-format
msgid ""
"This tab has been added from the %s add-on. Only affiliates with access to "
"order details will see this tab in the Affiliate Area."
msgstr "Ezt a fület a(z) %s kiegészítő adta hozzá. Az Affiliate Area-ban csak azok a partnerek látják, akik hozzáférnek a rendelési adatokhoz."

#: includes/class-functions.php:330
#, php-format
msgid ""
"This tab has been added from the %s add-on. Only affiliates with coupons "
"assigned will see this tab in the Affiliate Area."
msgstr "Ezt a fület a(z) %s kiegészítő adta hozzá. Az Affiliate Area-ban csak azok a partnerek látják, akikhez kuponokat rendeltek."

#: includes/class-functions.php:334
#, php-format
msgid ""
"This tab has been added from the %s add-on. Only affiliates with access to "
"their lifetime customers will see this tab in the Affiliate Area."
msgstr "Ezt a fület a(z) %s kiegészítő adta hozzá. Az Affiliate Area-ban csak azok a partnerek látják, akik hozzáférnek az összes eddigi vásárlójukhoz."
