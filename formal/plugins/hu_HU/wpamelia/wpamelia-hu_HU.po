msgid ""
"You can import the following columns: First name, Last name, Email, Phone, "
"Gender, Birthday, Note."
msgstr "A következő oszlopokat importálhatja: keresztnév, vezetéknév, e-mail cím, telefonszám, nem, születésnap, megjegyzés."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1552
msgid "Industries"
msgstr "Iparágak"

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1553
msgid "The first row should not contain column names."
msgstr "Az első sor nem tartalmazhat oszlopneveket."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1554
msgid "Valid first and last names are required fields."
msgstr "Az érvényes keresztnév és vezetéknév kötelező mezők."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1555
msgid "First and last names must be in two separate fields."
msgstr "A kereszt- és vezetéknévnek két külön mezőben kell szerepelnie."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1556
msgid ""
"Date of birth must be in the same format as chosen in your WP settings. If a"
" date format with a comma is used, the dates should be in quotes."
msgstr "A születési dátumnak a WP-beállításokban kiválasztott dátumformátumot kell követnie. Ha a dátumformátum vesszőt tartalmaz, a dátumokat idézőjelek közé kell tenni."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1557
msgid "Phone number must include a country code."
msgstr "A telefonszámnak tartalmaznia kell az ország hívószámát."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1558
msgid "Gender should be specified as either 'male' or 'female'."
msgstr "A nemet „male” vagy „female” értékként kell megadni."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1559
msgid ""
"If multiple customers have the same email address, only the first one will "
"be imported."
msgstr "Ha több vásárlónak ugyanaz az e-mail címe, csak az első vásárló kerül importálásra."

#: src/Infrastructure/WP/Translations/LiteBackendStrings.php:1560
msgid "If invalid, other values will be skipped and not imported."
msgstr "Hibás érték esetén a többi érték kimarad, és nem kerül importálásra."

