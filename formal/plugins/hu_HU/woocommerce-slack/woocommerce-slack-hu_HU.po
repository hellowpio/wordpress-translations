#: includes/class-wcslack-settings.php:428
#, php-format
msgid ""
"Enter the code for an emoji you want to include with each message by "
"default. You can find all codes on a site like %1$s or you can even upload "
"your own icon as an emoji in %2$s"
msgstr "Adja meg annak az emojinak a kódját, amelyet alapértelmezés szerint minden üzenethez szeretne hozzáadni. Az összes kódot megtalálja például egy olyan oldalon, mint a %1$s, vagy akár saját ikont is feltölthet emojiként a %2$s felületén"

#: includes/class-wcslack-settings-legacy.php:222
#: includes/class-wcslack-settings.php:433
msgid "Sender name"
msgstr "Feladó neve"

#: includes/class-wcslack-settings-legacy.php:225
#: includes/class-wcslack-settings.php:436
