#. Plugin Name of the plugin
#: mainwp-ssl-monitor-extension.php
msgid "MainWP SSL Monitor Extension"
msgstr "MainWP SSL Monitor Extension"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-ssl-monitor-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-ssl-monitor-extension.php
msgid ""
"MainWP SSL Monitor Add-on lets you keep a watchful eye on your SSL "
"Certificates. It alerts you via email when monitored certificates are "
"nearing expiration."
msgstr ""
"A MainWP SSL Monitor kiegészítő lehetővé teszi, hogy szemmel tartsa SSL-"
"tanúsítványait. E-mailben értesít, amikor a megfigyelt tanúsítványok "
"közelednek a lejárathoz."

#. Author of the plugin
#: mainwp-ssl-monitor-extension.php
#: templates/emails/mainwp-ssl-monitor-notification-email.php:70
msgid "MainWP"
msgstr "MainWP"

#: class/class-mainwp-ssl-monitor-abilities.php:58
msgid "MainWP SSL Monitor"
msgstr "MainWP SSL Monitor"

#: class/class-mainwp-ssl-monitor-abilities.php:59
msgid "Read stored certificate status and monitoring settings."
msgstr "A tárolt tanúsítvány állapotának és a figyelési beállításoknak a beolvasása."

#: class/class-mainwp-ssl-monitor-abilities.php:99
msgid "List SSL Monitor Site Statuses"
msgstr "SSL Monitor webhelyállapotainak listázása"

#: class/class-mainwp-ssl-monitor-abilities.php:100
msgid ""
"List accessible monitored HTTPS sites with stored certificates. Days left "
"are rounded as on the Dashboard; expiring soon uses the effective "
"notification threshold. No certificate checks run."
msgstr "A tárolt tanúsítvánnyal rendelkező, hozzáférhető, felügyelt HTTPS-webhelyek listája. A hátralévő napok száma a vezérlőpulton látható módon kerekített; a közelgő lejáratot a tényleges értesítési küszöbérték alapján határozza meg. Nem történik tanúsítvány-ellenőrzés."

#: class/class-mainwp-ssl-monitor-abilities.php:122
msgid "Get SSL Monitor Site Status"
msgstr "SSL Monitor webhelyállapotának lekérése"

#: class/class-mainwp-ssl-monitor-abilities.php:123
msgid ""
"Read one accessible site’s stored certificate and automatic check times. "
"Expiring soon uses its effective notification threshold and rounded days "
"left. Missing timestamps are null. No certificate checks run."
msgstr "Egy hozzáférhető webhely tárolt tanúsítványának és automatikus ellenőrzési időpontjainak beolvasása. A közelgő lejárat megállapításához a webhely tényleges értesítési küszöbértékét és a kerekített hátralévő napok számát veszi alapul. A hiányzó időbélyegek értéke null. Nem történik tanúsítvány-ellenőrzés."

#: class/class-mainwp-ssl-monitor-abilities.php:130
msgid "Get SSL Monitor Site Policy"
msgstr "SSL Monitor webhelyszabályzatának lekérése"

#: class/class-mainwp-ssl-monitor-abilities.php:131
msgid ""
"Read one accessible site’s effective monitoring settings and whether they "
"come from global settings or a site override."
msgstr "Egy hozzáférhető webhely tényleges figyelési beállításainak beolvasása, valamint annak megállapítása, hogy ezek a globális beállításokból vagy egy webhelyszintű felülbírálásból származnak-e."

#: class/class-mainwp-ssl-monitor-abilities.php:194
