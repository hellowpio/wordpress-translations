msgstr "Válassza ki a megváltoztatandó konkrét állapotot vagy állapotokat."

#: templates/admin/jet-abaf-settings/settings-advanced.php:83
msgid "Processing"
msgstr "Feldolgozás alatt"

#: templates/admin/jet-abaf-settings/settings-advanced.php:87
msgid "On hold"
msgstr "Felfüggesztve"

#: templates/admin/jet-abaf-settings/settings-advanced.php:91
msgid "Pending"
msgstr "Függőben"

#: templates/admin/jet-abaf-settings/settings-advanced.php:103
