#: templates/admin/jet-abaf-set-up/set-up.php:250
msgid "Custom database columns"
msgstr "Egyéni adatbázisoszlopok"

#: templates/admin/jet-abaf-set-up/set-up.php:253
msgid "Add more database columns if needed. Spaces will be converted to \"_\" ."
msgstr "Szükség esetén adjon hozzá további adatbázisoszlopokat. A szóközök „_” karakterré lesznek átalakítva."

#: templates/admin/jet-abaf-set-up/set-up.php:267
