msgstr "Új állapot"

#: templates/admin/jet-abaf-settings/settings-advanced.php:104
msgid ""
"Select the new status to which the selected target status(es) will be "
"changed."
msgstr "Válassza ki, melyik új állapotra módosuljanak a kiválasztott célállapot(ok)."

#: templates/admin/jet-abaf-settings/settings-advanced.php:108
msgid "Cancelled"
msgstr "Lemondva"

#: templates/admin/jet-abaf-settings/settings-advanced.php:112
msgid "Failed"
msgstr "Sikertelen"

#: templates/admin/jet-abaf-settings/settings-advanced.php:116
msgid "Created"
msgstr "Létrehozva"

#: templates/admin/jet-abaf-settings/settings-advanced.php:126
msgid "Automatically remove temporary bookings"
msgstr "Ideiglenes foglalások automatikus eltávolítása"

#: templates/admin/jet-abaf-settings/settings-advanced.php:127
msgid ""
"Check this to allow automatically remove bookings from database with "
"temporary status: 'Created' after selected period of time."
msgstr ""
"Jelölje be ezt, hogy a kiválasztott időtartam elteltével automatikusan "
"eltávolítsa az adatbázisból az ideiglenes, 'Létrehozva' állapotú "
"foglalásokat."

#: templates/admin/jet-abaf-settings/settings-advanced.php:135
msgid "Remove interval"
msgstr "Eltávolítási időköz"

#: templates/admin/jet-abaf-settings/settings-advanced.php:136
msgid "Select interval between removing bookings with temporary status."
