#: includes/base/functions-part-payments.php:57
msgid "Something went wrong. Please check if your API keys are correct."
msgstr ""
"Valami hiba történt. Kérjük, ellenőrizze, hogy az API-kulcsok helyesek-e."

#: includes/base/functions-actions-paypal.php:162
#: includes/base/functions-part-payments.php:83
msgid "Something went wrong. Please check your browser console for details."
msgstr ""
"Valami hiba történt. További részletekért ellenőrizze a böngésző konzolját."

#: includes/base/functions-actions-paypal.php:68
msgid "Something went wrong. Please refresh the page and try again."
msgstr ""
"Valami hiba történt. Kérjük, frissítse az oldalt, majd próbálja meg újra."

#: includes/base/functions-actions-paypal.php:89
msgid "The minimum payable amount is 0.01$"
msgstr "A minimálisan fizetendő összeg 0.01$"

#: includes/base/admin/settings/views/view-payment-settings-paypal.php:85
msgid ""
"The name of the product that appears on the PayPal invoice. Eg. \"Booking at"
" Anne's house.\""
msgstr "A PayPal-számlán megjelenő termék neve. Pl. „Foglalás Anne házában.”"

#: includes/base/admin/settings/views/view-payment-settings-paypal.php:57
msgid "The payment method description that appears on the booking form."
msgstr "A foglalási űrlapon megjelenő fizetési mód leírása."

#: includes/base/admin/settings/views/view-payment-settings-paypal.php:29
msgid "The payment method name that appears on the booking form."
msgstr "A foglalási űrlapon megjelenő fizetési mód neve."

#: includes/base/functions-actions-paypal.php:99
