msgid "Active"
msgstr "Aktív"

#. Description of the plugin
msgid "Allow customers to pay with PayPal when making bookings"
msgstr "Engedélyezze a vásárlóknak, hogy foglaláskor PayPal-lal fizessenek"

#: includes/base/admin/settings/views/view-payment-settings-paypal.php:111
msgid "API Credentials"
msgstr "API-hitelesítő adatok"

#: includes/base/admin/settings/views/view-payment-settings-paypal.php:56
msgid "Description"
