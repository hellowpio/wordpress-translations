msgstr "Markdown-sablon"

#: build/markdown.js:9
msgid ""
"Leave empty to generate Markdown automatically from the post content, "
"including metadata."
msgstr "Hagyja üresen, ha automatikusan szeretne Markdown-formátumú kimenetet létrehozni a bejegyzés tartalmából, a metaadatokat is beleértve."

#: build/markdown.js:9
msgid "No post types are available. Choose them in Content Settings first."
msgstr "Nem érhetők el bejegyzéstípusok. Először válassza ki őket a tartalombeállítások között."

#: build/markdown.js:9
msgid "All allowed post types are already configured."
msgstr "Már minden engedélyezett bejegyzéstípus be van állítva."

#: build/markdown.js:9
msgid ""
"JetGEO could not confirm the saved Markdown settings. Reload the page before"
" trying again."
msgstr "A JetGEO nem tudta megerősíteni az elmentett Markdown-beállításokat. Próbálkozás előtt töltse be újra az oldalt."

#: build/markdown.js:9
msgid "Markdown settings saved."
msgstr "A Markdown-beállítások elmentve."

#: build/markdown.js:9
