msgstr "Beállítás kihagyása"

#: build/onboarding.js:1
msgid "Setup step actions"
msgstr "A beállítási lépés műveletei"

#. translators: %s: Full JetGEO settings destination.
#: build/onboarding.js:2
#, js-format
msgid ""
"You can skip this step and change these settings later under JetGEO → %s."
msgstr "Kihagyhatja ezt a lépést, és később is módosíthatja ezeket a beállításokat a JetGEO → %s menüpontban."

#: build/onboarding.js:2
msgid "Welcome"
msgstr "Üdvözöljük"

#: build/onboarding.js:2
msgid "Summary"
msgstr "Összegzés"

#: build/onboarding.js:2
msgid "Setup progress"
msgstr "A beállítás előrehaladása"

#: build/onboarding.js:2
msgid "Review your setup"
msgstr "Tekintse át a beállításokat"

#: build/onboarding.js:2
msgid "Refresh summary"
msgstr "Összefoglaló frissítése"

#: build/onboarding.js:2
msgid ""
"Your JetGEO configuration is ready. Review the settings below before "
"finishing setup."
msgstr "A JetGEO konfigurációja elkészült. A beállítás befejezése előtt tekintse át az alábbi beállításokat."

#: build/onboarding.js:2
msgid "Loading setup…"
msgstr "A beállítás betöltése…"

#: build/onboarding.js:2
msgid "Choose the public post types JetGEO can use."
msgstr "Válassza ki, mely nyilvános bejegyzéstípusokat használhatja a JetGEO."

#: build/onboarding.js:2
msgid ""
"Only the selected post types will be used. You can leave the selection empty"
" if this output should contain no content."
msgstr "A rendszer csak a kijelölt bejegyzéstípusokat használja. Ha ennek a kimenetnek üresnek kell lennie, hagyja üresen a kijelölést."

#: build/onboarding.js:2
msgid "Make item-level post exclusions available"
msgstr "Tételszintű bejegyzéskizárások elérhetővé tétele"

#: build/onboarding.js:2
msgid "Search engines are discouraged"
msgstr "A keresőmotorok indexelését nem javasoljuk"

#: build/onboarding.js:2
msgid ""
"Your site currently asks search engines not to index it. Change Search "
"Engine Visibility in WordPress if this is not intentional."
msgstr "A webhelye jelenleg arra kéri a keresőmotorokat, hogy ne indexeljék. Ha ez nem szándékos, módosítsa a keresőmotorok láthatóságára vonatkozó beállítást a WordPressben."

#: build/onboarding.js:2
msgid ""
"No published content is available for the selected post types yet. You can "
"still save this setup."
msgstr "A kiválasztott bejegyzéstípusokhoz még nem érhető el közzétett tartalom. A beállítást így is mentheti."

#: build/onboarding.js:2
msgid "Record visits from recognized AI crawlers?"
msgstr "Rögzítse az ismert AI-feltérképezőrobotok látogatásait?"

#: build/onboarding.js:2
msgid ""
"Turning Crawler Logs off stops new logging but keeps existing records and "
"retention settings."
msgstr "A feltérképezőrobotok naplózásának kikapcsolása leállítja az új naplóbejegyzések rögzítését, de megőrzi a meglévő bejegyzéseket és a megőrzési beállításokat."

#: build/onboarding.js:2
msgid ""
"Crawler log records older than this period are removed during the scheduled "
"daily cleanup."
msgstr "Az ennél régebbi feltérképezőrobot-naplóbejegyzéseket az ütemezett napi törlés távolítja el."

#: build/onboarding.js:2
msgid "Enter a valid whole number of retention days."
msgstr "Adjon meg egy érvényes egész számot a megőrzési napok számaként."

#: build/onboarding.js:2
msgid "Scheduled cleanup needs WP-Cron"
msgstr "Az ütemezett törléshez WP-Cron szükséges"

#: build/onboarding.js:2
msgid ""
"WP-Cron is disabled. Configure an external cron runner so old crawler logs "
"can be removed on schedule."
msgstr "A WP-Cron ki van kapcsolva. Állítson be külső cron-futtatót, hogy a régi feltérképezőrobot-naplók ütemezetten törlődjenek."

#: build/onboarding.js:2
msgid ""
"This retention period is longer than the age of the available logs, so the "
"next cleanup may not remove anything."
msgstr "Ez a megőrzési idő hosszabb a rendelkezésre álló naplók koránál, ezért előfordulhat, hogy a következő törlés semmit sem távolít el."

#: build/onboarding.js:8
msgid ""
"JetGEO cannot safely update the existing llms.txt file. Check its file "
"permissions or keep using dynamic output."
msgstr "A JetGEO nem tudja biztonságosan frissíteni a meglévő llms.txt fájlt. Ellenőrizze a fájl jogosultságait, vagy használja továbbra is a dinamikus kimenetet."

#: build/onboarding.js:8
msgid ""
"JetGEO cannot create llms.txt in the site root. Check directory permissions "
"or keep using dynamic output."
msgstr "A JetGEO nem tudja létrehozni az llms.txt fájlt a webhely gyökérkönyvtárában. Ellenőrizze a könyvtár jogosultságait, vagy használja továbbra is a dinamikus kimenetet."

#: build/onboarding.js:8
msgid ""
"JetGEO could not verify the llms.txt location. Review the file from LLMs.txt"
" settings after setup."
msgstr "A JetGEO nem tudta ellenőrizni az llms.txt helyét. A beállítás befejezése után tekintse át a fájlt az LLMs.txt beállításainál."

#: build/onboarding.js:8
msgid "Enable LLMs.txt?"
msgstr "LLMs.txt bekapcsolása?"

#: build/onboarding.js:8
msgid ""
"Turning LLMs.txt off keeps its saved template and regeneration settings for "
"later."
msgstr "Az LLMs.txt kikapcsolásakor a mentett sablonminta és az újragenerálási beállítások későbbre megmaradnak."

#: build/onboarding.js:8
msgid "Configure the template now"
msgstr "Sablonminta beállítása most"

#: build/onboarding.js:8
msgid "LLMs.txt template"
msgstr "LLMs.txt-sablonminta"

#: build/onboarding.js:8
msgid "JetGEO could not generate the template preview. Try again."
msgstr "A JetGEO nem tudta létrehozni a sablonminta előnézetét. Próbálja meg újra."

#: build/onboarding.js:8
msgid ""
"Dynamic tags are stored as raw syntax and resolved when the template is "
"rendered."
msgstr "A dinamikus címkék nyers szintaxisként tárolódnak, és a sablonminta megjelenítésekor kerülnek feloldásra."

#: build/onboarding.js:8
msgid "Regenerate on a schedule"
msgstr "Újragenerálás ütemezése"

#: build/onboarding.js:8
msgid "Regeneration frequency"
msgstr "Újragenerálás gyakorisága"

#: build/onboarding.js:8
msgid "Regenerate after relevant content updates"
msgstr "Újragenerálás a kapcsolódó tartalmak frissítése után"

#: build/onboarding.js:8
msgid "No public post types are available for automatic regeneration."
msgstr "Nincsenek elérhető nyilvános bejegyzéstípusok az automatikus újrageneráláshoz."

#: build/onboarding.js:8
msgid ""
"Scheduled regeneration runs through WP-Cron or your site’s external cron "
"runner."
msgstr "Az ütemezett újragenerálást a WP-Cron vagy a webhely külső cron-futtatója végzi."

#: build/onboarding.js:8
msgid "Scheduled regeneration needs WP-Cron"
msgstr "Az ütemezett újrageneráláshoz WP-Cron szükséges"

#: build/onboarding.js:8
msgid ""
"WP-Cron is disabled. Configure an external cron runner so llms.txt can "
"regenerate on schedule."
msgstr "A WP-Cron ki van kapcsolva. Állítson be külső cron-futtatót, hogy az llms.txt ütemezetten újragenerálódjon."

#: build/onboarding.js:8
msgid ""
"After you save, the dynamic llms.txt output will be public at /llms.txt."
msgstr "Mentés után a dinamikus llms.txt kimenet nyilvánosan elérhető lesz a /llms.txt címen."

#: build/onboarding.js:8
msgid "Review the llms.txt file"
msgstr "Az llms.txt fájl áttekintése"

#: build/onboarding.js:8
msgid "Enable Markdown?"
msgstr "Markdown bekapcsolása?"

#: build/onboarding.js:8
msgid ""
"Turning Markdown off keeps its saved post types and custom templates for "
"later."
msgstr "A Markdown kikapcsolása megőrzi a mentett bejegyzéstípusokat és az egyéni sablonmintákat későbbre."

#: build/onboarding.js:8
msgid "Should Markdown copy the current Content Settings post types?"
msgstr "Másolja át a Markdown az aktuális tartalombeállítások bejegyzéstípusait?"

#: build/onboarding.js:8
msgid ""
"Copying saves a one-time snapshot in Markdown’s own settings. Later Content "
"Settings changes and future post types will not update it automatically."
msgstr "A másolás egyszeri pillanatfelvételt ment a Markdown saját beállításaiba. A tartalombeállítások későbbi módosításai és az új bejegyzéstípusok nem frissítik automatikusan ezt a pillanatfelvételt."

#: build/onboarding.js:8
msgid ""
"Selected post types use automatic HTML-to-Markdown conversion. You can add "
"custom templates later in Markdown settings."
msgstr "A kiválasztott bejegyzéstípusok automatikus HTML–Markdown átalakítást használnak. Később egyéni sablonmintákat is hozzáadhat a Markdown beállításaiban."

#: build/onboarding.js:8
msgid "Allow AI search crawlers?"
msgstr "Engedélyezi az AI-keresőrobotokat?"

#: build/onboarding.js:8
msgid "These crawlers gather content for AI-powered search results."
msgstr "Ezek a robotok AI-alapú keresési találatokhoz gyűjtenek tartalmat."

#: build/onboarding.js:8
msgid "Allow user-requested AI assistants?"
msgstr "Engedélyezi a felhasználó által kért AI-asszisztenseket?"

#: build/onboarding.js:8
msgid "These assistants fetch content in response to a user request."
msgstr "Ezek az asszisztensek felhasználói kérésre kérnek le tartalmat."

#: build/onboarding.js:8
msgid "Allow model-training crawlers?"
msgstr "Engedélyezi a modellbetanító feltérképező robotokat?"

#: build/onboarding.js:8
msgid "These crawlers gather content for model training."
msgstr "Ezek a feltérképező robotok modellbetanításhoz gyűjtenek tartalmat."

#: build/onboarding.js:8
msgid ""
"A physical robots.txt file is taking precedence. Update or remove that file "
"before expecting these dynamic rules to appear."
msgstr "Egy tényleges robots.txt-fájl élvez elsőbbséget. Frissítse vagy távolítsa el ezt a fájlt, mielőtt arra számítana, hogy ezek a dinamikus szabályok megjelennek."

#: build/onboarding.js:8
msgid "Should JetGEO manage AI crawler rules?"
msgstr "A JetGEO kezelje a mesterséges intelligenciát használó feltérképező robotokra vonatkozó szabályokat?"

#: build/onboarding.js:8
msgid "Turning Robots.txt off keeps its saved rules and template for later."
msgstr "A Robots.txt kikapcsolásakor a mentett szabályok és a sablonminta későbbre megmaradnak."

#: build/onboarding.js:8
msgid "Review these settings"
msgstr "Beállítások áttekintése"

#: build/onboarding.js:8
msgid "Mixed-purpose crawlers use the most restrictive answer."
msgstr "A vegyes célú feltérképező robotok a legszigorúbb választ veszik figyelembe."

#: build/onboarding.js:8
msgid "JetGEO could not generate the Robots.txt preview. Try again."
msgstr "A JetGEO nem tudta létrehozni a Robots.txt előnézetét. Próbálja meg újra."

#: build/onboarding.js:8 build/robots-txt.js:3
msgid "Robots.txt Preview"
msgstr "Robots.txt előnézete"

#: build/onboarding.js:8
msgid "Final robots.txt preview"
msgstr "Végleges robots.txt-előnézet"

#: build/onboarding.js:8
msgid "Configured"
msgstr "Beállítva"

#: build/onboarding.js:8
msgid "Disabled"
msgstr "Kikapcsolva"

#: build/onboarding.js:8
msgid "Skipped and unchanged"
msgstr "Kihagyva és változatlan"

#: build/onboarding.js:8
msgid "Needs attention"
msgstr "Figyelmet igényel"

#: build/onboarding.js:8
msgid "Status:"
msgstr "Állapot:"

#: build/onboarding.js:8
msgid ""
"Set up the modules you want to use and skip the rest. Nothing changes until "
"you save a step, and every setting remains available in JetGEO afterward."
msgstr "Állítsa be a használni kívánt modulokat, a többit pedig hagyja ki. Semmi sem változik, amíg el nem menti az adott lépés beállításait, és utána minden beállítás elérhető marad a JetGEO-ban."

#: build/onboarding.js:8
msgid "Continue"
msgstr "Folytatás"

#: build/onboarding.js:8
msgid "Another setup change is still being saved."
msgstr "Egy másik beállítás mentése még folyamatban van."

#: build/onboarding.js:8
msgid ""
"Skipping setup opts out of future automatic launches. Your current-screen "
"changes will not be saved, and existing saved settings will remain "
"unchanged."
msgstr "A beállítási folyamat kihagyásával lemond a későbbi automatikus indításokról. Az aktuális képernyő módosításai nem lesznek elmentve, a korábban elmentett beállítások pedig változatlanok maradnak."

#: build/onboarding.js:8
msgid ""
"Saved values may have changed. Your unsaved draft is still visible; reload "
"server values only when you are ready to replace it."
msgstr "A mentett értékek megváltozhattak. A mentetlen vázlat továbbra is látható; csak akkor töltse be újra a szerverértékeket, ha készen áll a vázlat lecserélésére."

#: build/onboarding.js:8
msgid "Reload server values"
msgstr "Szerverértékek újratöltése"

#: build/robots-txt.js:1
msgid "Robots.txt content"
msgstr "Robots.txt-tartalom"

#: build/robots-txt.js:1
msgid "Generate from Basic rules"
msgstr "Generálás az alapszabályokból"

#: build/robots-txt.js:1 build/robots-txt.js:3
msgid "User-Agent"
msgstr "User-Agent"

#. translators: %s: User agent name.
#: build/robots-txt.js:2
#, js-format
msgid "Collapse %s agent group"
msgstr "A(z) %s felhasználóiügynök-csoport összecsukása"

#. translators: %s: User agent name.
#: build/robots-txt.js:3
#, js-format
msgid "Expand %s agent group"
msgstr "A(z) %s felhasználóiügynök-csoport kibontása"

#: build/robots-txt.js:3
msgid "Not specified"
msgstr "Nincs megadva"

#: build/robots-txt.js:3
msgid "Restrict"
msgstr "Korlátozás"

#: build/robots-txt.js:3
msgid "Duplicate group"
msgstr "Csoport duplikálása"

#: build/robots-txt.js:3
msgid "Delete group"
msgstr "Csoport törlése"

#: build/robots-txt.js:3
msgid "This group has no rules yet."
msgstr "Ebben a csoportban még nincsenek szabályok."

#: build/robots-txt.js:3
msgid "Content-Signal"
msgstr "Content-Signal"

#: build/robots-txt.js:3
msgid ""
"These preferences describe how accessible content may be used. They do not "
"guarantee crawler compliance. Only explicit Allow or Restrict choices are "
"published."
msgstr "Ezek a beállítások azt írják le, hogyan használható fel a hozzáférhető tartalom. Nem garantálják, hogy a feltérképező robotok betartják őket. Csak a kifejezetten az engedélyezést vagy a korlátozást választó beállítások kerülnek közzétételre."

#: build/robots-txt.js:3
msgid "Add agent group"
msgstr "Felhasználóiügynök-csoport hozzáadása"

#: build/robots-txt.js:3
msgid ""
"Copy includes the complete JetGEO block and its BEGIN/END markers, not the "
"full WordPress preview."
msgstr "A másolás a teljes JetGEO-blokkot és annak BEGIN/END jelölőit tartalmazza, nem a teljes WordPress-előnézetet."

#: build/robots-txt.js:3
msgid "This preview does not contain a JetGEO block to copy."
msgstr "Ez az előnézet nem tartalmaz másolható JetGEO-blokkot."

#: build/robots-txt.js:3
msgid "Final robots.txt content"
msgstr "Végleges robots.txt-tartalom"

#: build/robots-txt.js:3
msgid "Copy JetGEO Robots.txt block"
msgstr "JetGEO robots.txt-blokk másolása"

#: build/robots-txt.js:3
msgid ""
"JetGEO could not load the Content-Signal options. Reload the page before "
"using Basic mode."
msgstr "A JetGEO nem tudta betölteni a Content-Signal opcióit. Az Alapmód használata előtt töltse újra az oldalt."

#: build/robots-txt.js:3
msgid ""
"Duplicate User-agent groups use different Content-Signal choices. Make their"
" choices match, rename a group, or combine their rules."
msgstr "Az azonos User-agent értékű csoportokhoz különböző Content-Signal választások tartoznak. Egyeztesse a választásokat, nevezze át az egyik csoportot, vagy vonja össze a szabályaikat."

#: build/robots-txt.js:3
msgid "JetGEO could not generate the robots.txt preview. Try again."
msgstr "A JetGEO nem tudta létrehozni a robots.txt előnézetét. Próbálja meg újra."

#: build/robots-txt.js:3
msgid "Open Robots.txt"
msgstr "Robots.txt megnyitása"

#: build/robots-txt.js:3
msgid ""
"robots.txt is a plain-text file at the site root. Allow and Disallow control"
" crawler access to paths; Content Signals separately express advisory "
"preferences for uses of accessible content."
msgstr "A robots.txt egy egyszerű szöveges fájl a webhely gyökérkönyvtárában. Az Allow és a Disallow szabályozza a feltérképező robotok hozzáférését az útvonalakhoz; a Content-Signal ettől különállóan, tájékoztató jelleggel fejezi ki a hozzáférhető tartalom felhasználására vonatkozó preferenciákat."

#: build/robots-txt.js:3
msgid ""
"JetGEO stores these rules in WordPress and adds them when WordPress serves "
"robots.txt."
msgstr "A JetGEO ezeket a szabályokat a WordPressben tárolja, és hozzáadja őket, amikor a WordPress kiszolgálja a robots.txt-t."

#: build/robots-txt.js:3
msgid "Robots.txt management is off"
msgstr "A robots.txt kezelése ki van kapcsolva"

#: build/robots-txt.js:3
msgid ""
"You can edit these settings, but JetGEO will not add its rules to public "
"robots.txt output until you enable the module."
msgstr "Szerkesztheti ezeket a beállításokat, de a JetGEO nem adja hozzá a szabályait a nyilvános robots.txt-kimenethez, amíg be nem kapcsolja a modult."

#: build/robots-txt.js:3
msgid "A physical robots.txt file is taking precedence"
msgstr "Egy fizikai robots.txt-fájl elsőbbséget élvez"

#: build/robots-txt.js:3
msgid ""
"JetGEO will not edit this file. Copy the JetGEO block from Preview into it, "
"or remove the file to let WordPress serve the dynamic version."
msgstr "A JetGEO nem szerkeszti ezt a fájlt. Másolja be a JetGEO-blokkot az előnézetből a fájlba, vagy távolítsa el a fájlt, hogy a WordPress a dinamikus verziót szolgálja ki."

#: build/robots-txt.js:3
msgid "Preview JetGEO block"
msgstr "JetGEO-blokk előnézete"

#: build/robots-txt.js:3
msgid "Fix Basic mode before continuing"
msgstr "Alapmód javítása a folytatás előtt"

#: build/robots-txt.js:3
msgid "Reload page"
msgstr "Oldal újratöltése"

#: build/robots-txt.js:3
msgid "Robots.txt editor mode"
msgstr "Robots.txt-szerkesztési mód"

#: build/robots-txt.js:3
msgid "Base mode"
msgstr "Alapmód"

#: build/robots-txt.js:3
msgid "Advanced mode"
msgstr "Haladó mód"

#: build/robots-txt.js:3
msgid ""
"JetGEO could not confirm the saved Robots.txt settings. Reload the page "
"before trying again."
msgstr "A JetGEO nem tudta megerősíteni a mentett Robots.txt-beállításokat. Próbálja meg újra az oldal újratöltése után."

#: build/robots-txt.js:3
msgid "Robots.txt settings saved."
msgstr "A robots.txt beállításai elmentve."

#: build/robots-txt.js:3
msgid ""
"JetGEO could not save the Robots.txt settings. Review them and try again."
msgstr "A JetGEO nem tudta elmenteni a robots.txt beállításait. Tekintse át őket, majd próbálja meg újra."
