"The setup server returned an unexpected response. Reload and try again."
msgstr "A beállítási kiszolgáló váratlan választ adott. Töltse be újra az oldalt, majd próbálja újra."

#: build/onboarding.js:1
msgid "Setup could not continue"
msgstr "A beállítás nem folytatható"

#: build/onboarding.js:1
