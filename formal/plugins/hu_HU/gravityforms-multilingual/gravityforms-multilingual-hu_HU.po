#. translators: Joins the last two plugin names in the list inside the notice
#. "Gravity Forms Multilingual is enabled but not effective. It requires ...
#. in order to work." The names before it are separated by commas.
#: classes/class-wpml-gfml-requirements.php:81
msgid "and"
msgstr "és"

#. translators: Warning notice in the WordPress admin. %s: the names of the
#. plugins that are missing, each one a link, joined by commas and the word
#. "and". "Gravity Forms Multilingual" is the name of this plugin and stays in
#. English.
#: classes/class-wpml-gfml-requirements.php:95
#, php-format
msgid ""
"Gravity Forms Multilingual is enabled but not effective. It requires %s in "
"order to work."
msgstr "A Gravity Forms Multilingual be van kapcsolva, de nem működik. A működéséhez %s szükséges."

#. translators: Names the kind of content a translation job holds, shown in
#. WPML's Translation Management beside each form. Singular: one form of the
#. Gravity Forms plugin, whose name stays in English.
#: inc/gravity-forms-multilingual.class.php:139
msgid "Gravity Form"
msgstr "Gravity Forms-űrlap"

