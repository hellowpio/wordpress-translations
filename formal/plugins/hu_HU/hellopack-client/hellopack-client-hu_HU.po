msgstr "Az API-kapcsolat sikeres!"

#: includes/Admin/Rest/ConnectionController.php:111
#: includes/Admin/Rest/ConnectionController.php:160
#: includes/Cli/LicenseCommand.php:70
msgid "Invalid token or insufficient permissions."
msgstr "Hibás token vagy elégtelen jogosultságok."

#: includes/Admin/Rest/ConnectionController.php:124
#: includes/Admin/SettingsPage.php:327
