#: includes/Abilities.php:897 includes/Abilities.php:1074
#: includes/Cli/PluginCommand.php:371
#, php-format
msgid "Plugin \"%s\" is not installed."
msgstr "A(z) „%s” bővítmény nincs telepítve."

#: includes/Abilities.php:926
msgid "Update theme"
msgstr "Sablon frissítése"

#: includes/Abilities.php:927
msgid "Update an installed HelloPack theme to its latest available version."
msgstr "Egy telepített HelloPack-sablon frissítése a legújabb elérhető verzióra."

#: includes/Abilities.php:934
msgid "Theme slug to update."
msgstr "A frissítendő sablon slugja."

#. translators: %s: theme slug
