msgstr "Egy telepített HelloPack-sablon eltávolítása erről a webhelyről (az aktív sablon nem törölhető)."

#: includes/Abilities.php:1109
msgid "Theme slug to remove."
msgstr "Az eltávolítandó sablon slugja."

#: includes/Abilities.php:1183
msgid "Refresh catalog"
msgstr "Katalógus frissítése"

#: includes/Abilities.php:1184
