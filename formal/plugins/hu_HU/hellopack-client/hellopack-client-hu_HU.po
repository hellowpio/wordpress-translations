#: includes/Abilities.php:1012
msgid "Delete plugin"
msgstr "Bővítmény törlése"

#: includes/Abilities.php:1013
msgid "Remove an installed HelloPack plugin from this site."
msgstr "Egy telepített HelloPack-bővítmény eltávolítása erről a webhelyről."

#: includes/Abilities.php:1020
