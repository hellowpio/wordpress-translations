msgstr "Egy telepített HelloPack-bővítmény frissítése a legújabb elérhető verzióra."

#: includes/Abilities.php:848
msgid "Plugin slug to update."
msgstr "Frissítendő plugin slug."

#: includes/Abilities.php:889 includes/Abilities.php:975
#: includes/Abilities.php:1066 includes/Abilities.php:1148
