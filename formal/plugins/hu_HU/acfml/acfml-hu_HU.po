#. Plugin Name of the plugin
#: wpml-acf.php
msgid "Advanced Custom Fields Multilingual"
msgstr "Advanced Custom Fields Multilingual"

#. Plugin URI of the plugin
#: wpml-acf.php
msgid "https://wpml.org/documentation/wpml-core-and-add-on-plugins/acfml/"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/acfml/"

#. Description of the plugin
#: wpml-acf.php
msgid ""
"Adds compatibility between WPML and Advanced Custom Fields | <a "
"href=\"https://wpml.org/documentation/translating-your-"
"contents/acf/?utm_source=plugin&utm_medium=gui&utm_campaign=acfml\">Documentation</a>"
msgstr "Kompatibilitást biztosít a WPML és az Advanced Custom Fields között | <a href=\"https://wpml.org/documentation/translating-your-contents/acf/?utm_source=plugin&utm_medium=gui&utm_campaign=acfml\">dokumentáció</a>"

#. Author of the plugin
#: wpml-acf.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: wpml-acf.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: Displayed when editing an ACF field in a translation, showing
#. its value in the original language; %1$s and %2$s turn the string into
#. bold, and %3$s is the actual original value.
#: classes/class-wpml-acf-field-annotations.php:62
#, php-format
msgctxt ""
"Displayed when editing an ACF field in a translation, showing its value in "
"the original language; %1$s and %2$s turn the string into bold, and %3$s is "
"the actual original value."
msgid "%1$sOriginal%2$s: %3$s"
msgstr "%1$sEredeti%2$s: %3$s"

#. translators: Note under a field in the translation editor. The quoted text
#. is the name of a translation preference and is translated the same way in
#. the preference list.
#: classes/class-wpml-acf-field-annotations.php:124
msgid "This type of ACF field will always be set to \"Copy once\"."
msgstr "Az ilyen típusú ACF-mezőnél mindig az „Egyszeri másolás” lesz beállítva."

#. translators: Label of the field's name in the note shown under a field in
#. the translation editor; the name follows the colon.
#: classes/class-wpml-acf-field-annotations.php:129
msgid "ACF field name:"
msgstr "ACF-mező neve:"

#. translators: Label of the field's kind in the note shown under a field in
#. the translation editor; the kind follows the colon.
#: classes/class-wpml-acf-field-annotations.php:132
msgid "ACF field type:"
msgstr "ACF-mező típusa:"

#. translators: Label of the radio group on an ACF field that sets how the
#. field is translated.
#: classes/class-wpml-acf-field-settings.php:56
msgid "Translation preferences"
msgstr "Fordítási beállítások"

#. translators: Explanation under the translation-preferences radio group of
#. an ACF field.
#: classes/class-wpml-acf-field-settings.php:58
msgid "What to do with field's value when post/page is going to be translated"
msgstr ""
"Mi történjen a mező értékével, amikor a bejegyzés/oldal fordításra kerül"

#. translators: Option kept on a field that was already set to Translate, for
#. a field type where the option is no longer offered. "Translate" is the
#. preference's name, translated the same way in the preference list.
#: classes/class-wpml-acf-field-settings.php:148
msgid ""
"Translate (your current setting, no longer offered for this field type)"
msgstr "Fordítás (az Ön aktuális beállítása, amely ennél a mezőtípusnál már nem érhető el)"

#. translators: Explanation under the Translate option that was kept on a
#. field type where it is no longer offered.
#: classes/class-wpml-acf-field-settings.php:206
msgid ""
"Kept because it is your current setting. This value is no longer offered for"
" this field type."
msgstr "Megmaradt, mert ez az Ön aktuális beállítása. Ez az érték ennél a mezőtípusnál már nem érhető el."

#. translators: Warning under a translation preference that WPML advises
#. against for the field being edited.
#: classes/class-wpml-acf-field-settings.php:211
msgid "Not recommended for this field type."
msgstr "Ennél a mezőtípusnál nem ajánlott."

#. translators: First line describing the "Don't translate" preference of an
#. ACF field.
#: classes/class-wpml-acf-field-settings.php:221
msgid "Translated pages start without this content."
msgstr "A lefordított oldalak e tartalom nélkül indulnak."

#. translators: Second line describing the "Don't translate" preference of an
#. ACF field.
#: classes/class-wpml-acf-field-settings.php:223
msgid "Editable in other languages, and starts empty."
msgstr "Más nyelveken szerkeszthető, és üresen indul."

#. translators: First line describing the "Copy" preference of an ACF field.
#: classes/class-wpml-acf-field-settings.php:227
msgid "Visitors in every language always see exactly what the original shows."
msgstr "A látogatók minden nyelven pontosan azt látják, ami az eredetiben szerepel."

#. translators: Second line describing the "Copy" preference of an ACF field;
#. "it" is the field.
#: classes/class-wpml-acf-field-settings.php:229
msgid "Shown locked in other languages, so it cannot be edited there."
msgstr "Más nyelveken zárolva jelenik meg, ezért ott nem szerkeszthető."

#. translators: First line describing the "Copy once" preference of an ACF
#. field.
#: classes/class-wpml-acf-field-settings.php:233
msgid "Starts the same as the original, then each language goes its own way."
msgstr "Az eredetivel azonos tartalommal indul, majd minden nyelv a saját útját járja."

#. translators: Second line describing the "Copy once" preference of an ACF
#. field.
#: classes/class-wpml-acf-field-settings.php:235
msgid "Editable in every language, and permanently yours to maintain by hand."
msgstr "Minden nyelven szerkeszthető, a tartalom kézi karbantartása pedig végig az Ön feladata."

#. translators: First line describing the "Translate" preference of an ACF
#. field; "this" is the field's value.
#: classes/class-wpml-acf-field-settings.php:239
msgid "Visitors see this in their own language."
msgstr "A látogatók a saját nyelvükön látják ezt."

#. translators: Second line describing the "Translate" preference of an ACF
#. field.
#: classes/class-wpml-acf-field-settings.php:241
msgid "Filled by the translation and edited in the translation editor."
msgstr "A fordítás tölti ki, és a fordításszerkesztőben szerkeszthető."

#. translators: Tooltip of the warning icon next to a field whose translation
#. preference has not been chosen.
#: classes/class-wpml-acf-field-settings.php:543
msgid "Edit the field to set the translation preference."
msgstr "Szerkessze a mezőt a fordítási beállítás megadásához."

#. translators: Admin notice shown while the plugin updates preferences in the
#. background. "ACFML" is the plugin's short name and "Gutenberg" is the
#. WordPress editor's name; both stay in English.
#: classes/class-wpml-acf-migrate-block-preferences.php:44
msgid ""
"ACFML is updating translation preferences for strings in Gutenberg Blocks. "
"Keep using your site as usual. This notice will disappear when the process "
"is done."
msgstr ""
"Az ACFML frissíti a Gutenberg-blokkokban lévő sztringek fordítási "
"beállításait. Használja tovább a webhelyét a szokott módon. Ez az értesítés "
"eltűnik, amikor a folyamat befejeződik."

#. translators: Admin notice shown when the plugin is active but WPML is not;
#. "It" is this plugin.
#: classes/class-wpml-acf-requirements.php:24
msgid "ACFML is enabled but not effective. It requires WPML in order to work."
msgstr "Az ACFML engedélyezve van, de nem működik. A működéshez WPML szükséges."

#. translators: Admin notice shown when this plugin is active but Advanced
#. Custom Fields is not; "It" is this plugin.
#: classes/class-wpml-acf-requirements.php:40
msgid ""
"ACFML is enabled but not effective. It requires Advanced Custom Fields or "
"ACF PRO in order to work."
msgstr "Az ACFML be van kapcsolva, de nem működik. A működéséhez az Advanced Custom Fields vagy az ACF PRO szükséges."

#. translators: Button on the notice shown when Advanced Custom Fields is
#. installed but not active.
#: classes/class-wpml-acf-requirements.php:52
msgid "Activate Advanced Custom Fields"
msgstr "Advanced Custom Fields bekapcsolása"

#. translators: Button on the notice shown when Advanced Custom Fields is not
#. installed.
#: classes/class-wpml-acf-requirements.php:69
msgid "Install Advanced Custom Fields"
msgstr "Advanced Custom Fields telepítése"

#. translators: First sentence of the admin notice about the ACF field group
#. post type being translatable. The quoted word is the setting's value in
#. WPML and is translated the same way there.
#: classes/class-wpml-acf-translatable-groups-checker.php:86
msgid ""
"Field groups are set to \"Translatable\" in WPML settings, which prevents "
"ACF fields from being translated."
msgstr "A WPML beállításaiban a mezőcsoportok „Fordítható” értékre vannak állítva, ami megakadályozza az ACF-mezők fordítását."

#. translators: Second sentence of that notice; "This" is the field groups
#. being set to Translatable.
#: classes/class-wpml-acf-translatable-groups-checker.php:88
msgid "This is almost never intended."
msgstr "Ez szinte soha nem szándékos."

#. translators: Line in that notice when the setting comes from a file. Keep
#. the file name in English; "Not translatable" is the setting's value in
#. WPML.
#: classes/class-wpml-acf-translatable-groups-checker.php:92
msgid ""
"A configuration file (wpml-config.xml) controls this setting on this site, "
"so it cannot be changed from here. Edit that file, or ask whoever maintains "
"it to set the ACF field group post type to Not translatable."
msgstr "Ezen a webhelyen egy konfigurációs fájl (wpml-config.xml) szabályozza ezt a beállítást, ezért itt nem módosítható. Szerkessze a fájlt, vagy kérje meg a karbantartásáért felelős személyt, hogy állítsa be az ACF mezőcsoport bejegyzéstípusát nem fordíthatóra."

#. translators: Last line of that notice; "them" are the copies of the field
#. groups.
#: classes/class-wpml-acf-translatable-groups-checker.php:96
msgid ""
"Field group copies already created in other languages stay on the site. "
"Changing this setting does not delete them."
msgstr "A más nyelveken már létrehozott mezőcsoport-másolatok a webhelyen maradnak. A beállítás módosítása nem törli őket."

#. translators: Button in the admin notice about translatable field groups; it
#. applies the fix. "Not translatable" is the setting's value in WPML and is
#. translated the same way there. Verb phrase, imperative.
#: classes/class-wpml-acf-translatable-groups-checker.php:118
msgid "Set field groups to Not translatable"
msgstr "Mezőcsoportok beállítása nem fordíthatóra"

#. translators: Link in that notice; it opens the ACFML documentation.
#: classes/class-wpml-acf-translatable-groups-checker.php:129
msgid "Why this matters"
msgstr "Miért fontos ez"

#. translators: %d is the number of posts using this field group.
#: classes/FieldGroup/AttachedPosts.php:46
#, php-format
msgid ""
"If any field is set to \"Translatable\", WPML will re-translate the %d posts"
" using this field group."
msgstr "Ha bármelyik mező „Fordítható” értékre van állítva, a WPML újrafordítja az ezt a mezőcsoportot használó %d bejegyzést."

#. translators: Warning shown before a field group's translation option is
#. changed, when the update will take under a minute.
#: classes/FieldGroup/AttachedPosts.php:54
msgid ""
"Some posts using this field group have translations. Once you change the "
"translation option, WPML needs to update the translation status of the "
"posts. This can take up to 1 minute."
msgstr ""
"Néhány, ezt a mezőcsoportot használó bejegyzésnek van fordítása. A fordítási"
" opció módosítása után a WPML-nek frissítenie kell a bejegyzések fordítási "
"állapotát. Ez legfeljebb 1 percet vehet igénybe."

#. translators: %d is the number of hours.
#: classes/FieldGroup/AttachedPosts.php:57
#, php-format
msgid ""
"Some posts using this field group have translations. Once you change the "
"translation option, WPML needs to update the translation status of the "
"posts. This can take up to %d hours."
msgstr ""
"Néhány, ezt a mezőcsoportot használó bejegyzésnek van fordítása. A fordítási"
" opció módosítása után a WPML-nek frissítenie kell a bejegyzések fordítási "
"állapotát. Ez akár %d órát is igénybe vehet."

#. translators: %d is the number of minutes.
#: classes/FieldGroup/AttachedPosts.php:61
#, php-format
msgid ""
"Some posts using this field group have translations. Once you change the "
"translation option, WPML needs to update the translation status of the "
"posts. This can take up to %d minutes."
msgstr ""
"Néhány, ezt a mezőcsoportot használó bejegyzésnek van fordítása. A fordítási"
" opció módosítása után a WPML-nek frissítenie kell a bejegyzések fordítási "
"állapotát. Ez akár %d percet is igénybe vehet."

#. translators: Tooltip of the padlock next to a post type's translation
#. setting that WPML holds; "it" is that setting.
#: classes/FieldGroup/CptLockHooks.php:91
msgid ""
"Locked by WPML so that ACF fields stay translatable. Click here to unlock "
"and change it anyway."
msgstr "A WPML zárolta, hogy az ACF-mezők fordíthatók maradjanak. Kattintson ide a zárolás feloldásához, ha mégis módosítani szeretné."

#. translators: Title of the notice on a field group whose taxonomy cannot be
#. translated yet. Verb phrase, imperative.
#: classes/FieldGroup/DetectNonTranslatableLocations.php:106
msgid "Set translation preferences for the attached taxonomy"
msgstr "Fordítási beállítások megadása a csatolt osztályozáshoz (taxonomy)"

#. translators: Title of the notice on a field group whose post type cannot be
#. translated yet. Verb phrase, imperative.
#: classes/FieldGroup/DetectNonTranslatableLocations.php:108
msgid "Set translation preferences for the attached post type"
msgstr "Fordítási beállítások megadása a csatolt bejegyzéstípushoz"

#. translators: Body of the notice on a field group whose taxonomy cannot be
#. translated yet. Keep the trailing space: a link follows on the same line.
#: classes/FieldGroup/DetectNonTranslatableLocations.php:120
msgid ""
"If you want to translate your fields, go to the WPML Settings page and make "
"the taxonomy attached to this field group translatable. "
msgstr ""
"Ha szeretné lefordítani a mezőit, lépjen a WPML beállítások oldalra, és "
"tegye fordíthatóvá az ehhez a mezőcsoporthoz kapcsolt taxonómiát. "

#. translators: %1$s and %2$s will wrap the string in a <a> link html tag
#: classes/FieldGroup/DetectNonTranslatableLocations.php:123
#, php-format
msgid ""
"If you want to translate your fields, go to the WPML Settings page and "
"%1$smake the post type attached to this field group translatable%2$s."
msgstr ""
"Ha szeretné lefordítani a mezőit, lépjen a WPML beállítások oldalra, és "
"%1$stegye fordíthatóvá az ehhez a mezőcsoporthoz kapcsolt "
"bejegyzéstípust%2$s."

#. translators: Name of the field group translation mode where each field's
#. preference is set by hand. Noun used as a mode name.
#: classes/FieldGroup/Mode.php:39
msgid "Expert"
msgstr "Haladó"

#. translators: Name of the field group translation mode where the fields are
#. sent for translation.
#: classes/FieldGroup/Mode.php:41
msgid "Same content in every language, translated"
msgstr "Ugyanaz a tartalom minden nyelven, lefordítva"

#. translators: Name of the field group translation mode where every language
#. keeps its own field values.
#: classes/FieldGroup/Mode.php:43
msgid "Each language has its own content"
msgstr "Minden nyelv saját tartalommal rendelkezik"

#. translators: Explanation shown on a repeater, group or flexible-content
#. field. "Translate" is the name of a translation preference and is
#. translated the same way it is in the preference list.
#: classes/FieldGroup/ModeValidity.php:79
msgid ""
"Translate is not offered on container fields, because it replaces the value "
"your theme reads. The fields inside carry their own preferences."
msgstr "A „Fordítás” beállítás nem érhető el a konténermezőknél, mert lecseréli a sablon által beolvasott értéket. A bennük lévő mezők saját beállításokkal rendelkeznek."

#. translators: Explanation shown on a URL field. "Translate" is the name of a
#. translation preference.
#: classes/FieldGroup/ModeValidity.php:85
msgid ""
"Translate lets each language point at its own address, which an external "
"link often needs. A link to a page on this site already points at that page "
"in the reader's language, so leave it as it is."
msgstr "A „Fordítás” lehetővé teszi, hogy minden nyelv a saját címére mutasson, amire egy külső link esetében gyakran szükség van. A webhely egyik oldalára mutató link már az olvasó nyelvén jeleníti meg az oldalt, ezért hagyja változatlanul."

#. translators: Explanation shown on a link field, which stores a link text, a
#. URL and a target.
#: classes/FieldGroup/ModeValidity.php:88
msgid ""
"Translate sends the link text and the URL. The target keeps the value you "
"set, and a URL you leave as it is points at the page in the reader's "
"language."
msgstr "A „Fordítás” a linkszöveget és az URL-t is elküldi fordításra. A link célbeállítása az Ön által megadott érték marad, a változatlanul hagyott URL pedig az olvasó nyelvén jeleníti meg az oldalt."

#. translators: Explanation shown on an e-mail field for why translation is
#. not offered.
#: classes/FieldGroup/ModeValidity.php:91
msgid ""
"Translating an address produces one that does not exist. An e-mail address "
"is the same in every language."
msgstr "Egy cím lefordításával nem létező cím jöhet létre. Az e-mail-cím minden nyelven azonos."

#. translators: Explanation shown on a colour-picker field for why translation
#. is not offered.
#: classes/FieldGroup/ModeValidity.php:94
msgid ""
"A color code is not language content. Translating it changes the color your "
"visitors see."
msgstr "A színkód nem nyelvi tartalom. A lefordítása megváltoztatja a látogatók által látott színt."

#. translators: Explanation shown on a date or time field for why translation
#. is not offered.
#: classes/FieldGroup/ModeValidity.php:99
msgid ""
"The stored value is a fixed date format that your theme reads. Translating "
"it breaks the format."
msgstr "A tárolt érték egy rögzített dátumformátum, amelyet a sablon olvas be. A lefordítása tönkreteszi a formátumot."

#. translators: Explanation shown on a select, checkbox, radio or button-group
#. field for why translation is not offered. Keep the bold tags around the
#. WPML screen name.
#: classes/FieldGroup/ModeValidity.php:105
msgid ""
"The stored value is the choice key, not the label your visitors see. "
"Translating it stops the key from matching your choices. Translate the "
"labels in <b>String Translation</b> instead."
msgstr "A tárolt érték a választási lehetőség kulcsa, nem a látogatók által látható címke. Ha lefordítja, a kulcs többé nem fog egyezni a választási lehetőségekkel. Ehelyett a címkéket a <b>String Translation</b> bővítményben fordítsa le."

#. translators: Explanation shown on a number or true/false field for why
#. translation is not offered.
#: classes/FieldGroup/ModeValidity.php:109
msgid ""
"This value is read by your theme or plugin code. A translated value can stop"
" matching what the code expects."
msgstr "Ezt az értéket a sablon vagy a bővítmény kódja olvassa be. A lefordított érték nem feltétlenül egyezik azzal, amit a kód elvár."

#. translators: Line in the tooltip of a field whose translation preference
#. comes from a wpml-config.xml file; "this" is the preference.
#: classes/FieldGroup/PreferenceSource.php:230
msgid ""
"The file decides this again on every import, so changes made elsewhere do "
"not stick."
msgstr "Az importálás során a fájl minden alkalommal újra megadja ezt az értéket, ezért a máshol végzett módosítások nem maradnak meg."

#. translators: %s is a configuration file path, for example themes/acme/wpml-
#. config.xml.
#: classes/FieldGroup/PreferenceSource.php:233
#, php-format
msgid ""
"Edit %s, or remove the entry there, to manage this field on this screen."
msgstr "Szerkessze a(z) %s elemet, vagy távolítsa el ott a bejegyzést a mező kezeléséhez ezen a képernyőn."

#. translators: Last line of the tooltip of a field whose preference comes
#. from a configuration file whose path is unknown.
#: classes/FieldGroup/PreferenceSource.php:235
msgid ""
"Edit the configuration file, or remove the entry there, to manage this field"
" on this screen."
msgstr "Szerkessze a konfigurációs fájlt, vagy távolítsa el belőle a bejegyzést a mező kezeléséhez ezen a képernyőn."

#. translators: Warning in the tooltip when the stored preference of a field
#. differs from the one now chosen on the screen.
#: classes/FieldGroup/PreferenceSource.php:247
msgid ""
"That is not the value selected above. Saving this field group applies the "
"value above."
msgstr "Ez nem a fent kiválasztott érték. A mezőcsoport mentése a fenti értéket alkalmazza."

#. translators: %s is a local JSON file path, for example acf-
#. json/group_640ab1.json.
#: classes/FieldGroup/PreferenceSource.php:253
#, php-format
msgid ""
"This field group is also in %s. That file re-applies these settings the next"
" time the group is synced."
msgstr "Ez a mezőcsoport a(z) %s fájlban is szerepel. A fájl a csoport következő szinkronizálásakor újra alkalmazza ezeket a beállításokat."

#. translators: First line of the tooltip of a field whose translation
#. preference the theme sets. Keep the file name in English.
#: classes/FieldGroup/PreferenceSource.php:268
msgid "Locked. Managed by your theme, in its wpml-config.xml file."
msgstr "Zárolva. A sablon kezeli a saját wpml-config.xml fájljában."

#. translators: First line of the tooltip of a field whose translation
#. preference a plugin sets. Keep the file name in English.
#: classes/FieldGroup/PreferenceSource.php:272
msgid "Locked. Managed by a plugin, in its wpml-config.xml file."
msgstr "Zárolva. Egy bővítmény kezeli a saját wpml-config.xml fájljában."

#. translators: First line of the tooltip of a field whose translation
#. preference comes from a configuration file WPML fetched.
#: classes/FieldGroup/PreferenceSource.php:276
msgid ""
"Locked. Managed by a configuration file WPML downloaded for one of your "
"plugins or themes."
msgstr "Zárolva. Egy olyan konfigurációs fájl kezeli, amelyet a WPML az egyik bővítményhez vagy sablonhoz töltött le."

#. translators: First line of the tooltip of a field whose translation
#. preference comes from the XML the site owner pasted into WPML's settings.
#: classes/FieldGroup/PreferenceSource.php:280
msgid ""
"Locked. Managed by the custom XML configuration saved in WPML settings."
msgstr "Zárolva. A WPML beállításaiban mentett egyéni XML-konfiguráció kezeli."

#. translators: First line of the tooltip of a field whose translation
#. preference comes from a configuration file WPML cannot name.
#: classes/FieldGroup/PreferenceSource.php:284
msgid "Locked. Managed by a configuration file on this site."
