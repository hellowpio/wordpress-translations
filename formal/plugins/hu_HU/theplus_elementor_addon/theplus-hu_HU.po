#: modules/widgets/tp_navigation_menu.php:974
msgid "Enter Class Name"
msgstr "Adja meg az osztály nevét"

#: modules/widgets/tp_navigation_menu.php:988
msgid ""
"Use the Custom Class field to assign a specific CSS class to the menu item, "
"allowing you to apply custom styles via CSS. This option provides the "
