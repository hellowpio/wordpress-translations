msgid "https://www.peeayecreative.com/"
msgstr "https://www.peeayecreative.com/"

#: includes/classes/class-divi-blog-module.php:29
msgid "Only Show Posts In Current Category Level"
msgstr "Csak az aktuális kategóriaszint bejegyzéseinek megjelenítése"

