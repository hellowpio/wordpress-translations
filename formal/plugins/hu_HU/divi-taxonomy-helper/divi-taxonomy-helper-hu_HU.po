msgstr "Válassza ezt a lehetőséget, ha a teljes kifejezés területét kattinthatóvá szeretné tenni."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:841
msgid "Your Dynamic Taxonomies will display here."
msgstr "A dinamikus osztályozások itt jelennek meg."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1531
msgid "Background Color"
msgstr "Háttérszín"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1532
msgid "Set a background color for the taxonomy grid items."
msgstr "Állítson be háttérszínt az osztályozási rács tételeihez."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1541
msgid "Default Icon"
msgstr "Alapértelmezett ikon"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1542
msgid "Set a default icon that applies to all taxonomy terms."
msgstr "Állítson be egy alapértelmezett ikont az összes osztályozási kifejezéshez."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1553
msgid "Taxonomy Type"
msgstr "Osztályozás típusa"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1554
msgid "Choose the type of taxonomies you want to display."
msgstr "Válassza ki a megjeleníteni kívánt osztályozások típusát."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1565
msgid "Dynamic Taxonomies"
msgstr "Dinamikus osztályozások"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1566
msgid ""
"Choose to enable dynamic content which allows you to place the module in a "
"Divi Theme Builder layout to dynamically display taxonomies based on the "
"template assignment."
msgstr "Kapcsolja be a dinamikus tartalmat, hogy a modult a Divi Theme Builder egyik elrendezésébe helyezhesse, és a hozzárendelt sablonminta alapján dinamikusan jeleníthesse meg az osztályozásokat."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1579
msgid "Include Or Exclude Taxonomy Terms"
msgstr "Osztályozási kifejezések belefoglalása vagy kizárása"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1580
msgid "Choose whether selected taxonomy terms should be included or excluded."
msgstr "Válassza ki, hogy a kijelölt osztályozási kifejezéseket belefoglalja-e vagy kizárja."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1583
msgid "Include"
msgstr "Belefoglalás"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1584
msgid "Exclude"
msgstr "Kizárás"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1628
msgid "Included Taxonomy Terms"
msgstr "Belefoglalt osztályozási kifejezések"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1629
msgid "Choose which taxonomies you would like to include in the feed."
msgstr "Válassza ki, mely osztályozásokat szeretné belefoglalni a hírfolyamba."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1644
msgid "Excluded Taxonomy Terms"
msgstr "Kizárt osztályozási kifejezések"

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1645
msgid "Choose which taxonomy terms you would like to exclude from the feed."
msgstr "Válassza ki, mely osztályozási kifejezéseket szeretné kizárni a hírfolyamból."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1663
msgid "Set a background color for the taxonomy grid item."
msgstr "Állítson be háttérszínt az osztályozási rács tételéhez."

#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:1676
msgid "Choose icon to display with the taxonomy term."
msgstr "Válassza ki az osztályozási kifejezés mellett megjelenítendő ikont."
