#. Plugin Name of the plugin
#: divi-taxonomy-helper.php includes/classes/class-divi-theme-options.php:27
#: includes/modules/TaxonomyHelper/TaxonomyHelper.php:16
msgid "Divi Taxonomy Helper"
msgstr "Divi Taxonomy Helper"

#. Plugin URI of the plugin
#: divi-taxonomy-helper.php
msgid "https://www.elegantthemes.com/marketplace/divi-taxonomy-helper/"
msgstr "https://www.elegantthemes.com/marketplace/divi-taxonomy-helper/"

#. Description of the plugin
#: divi-taxonomy-helper.php
msgid ""
"Add images to taxonomy terms like categories and tags, enable taxonomy "
"featured image support in the Divi Theme Builder templates, display "
"taxonomies in a fully customizable grid similar to the blog module, and show"
" posts and products by current hierarchy level in the Blog and Woo products "
"modules."
msgstr "Adjon hozzá képeket az osztályozási kifejezésekhez, például a kategóriákhoz és a címkékhez, kapcsolja be az osztályozásokhoz tartozó kiemelt képek támogatását a Divi Theme Builder sablonjaiban, jelenítse meg az osztályozásokat a blogmodulhoz hasonló, teljesen testre szabható rácsban, továbbá jelenítse meg a bejegyzéseket és a termékeket az aktuális hierarchiaszint alapján a Blog és a Woo termékmodulokban."

#. Author of the plugin
#: divi-taxonomy-helper.php
msgid "Pee Aye Creative"
msgstr "Pee Aye Creative"

#. Author URI of the plugin
