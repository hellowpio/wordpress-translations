#. translators: 1: address support mail currently goes to, 2: the account's
#. current address
#: app/Hooks/Handlers/CustomerPortalHandler.php:134
#, php-format
msgid ""
"Support messages are being sent to %1$s, but your account email is now %2$s."
msgstr "A támogatási üzenetek ide érkeznek: %1$s, de a fiókjához tartozó e-mail cím mostantól %2$s."

#: app/Hooks/Handlers/CustomerPortalHandler.php:142
msgid ""
"Confirm the new address to move your support messages and bring across any "
"tickets you opened from it. We will email a link to that address."
msgstr "Erősítse meg az új címet, hogy áthelyezhessük a támogatási üzeneteit, és áthozhassuk az erről a címről megnyitott jegyeit. E-mailben küldünk egy linket erre a címre."

#: app/Hooks/Handlers/CustomerPortalHandler.php:144
msgid "Send confirmation email"
msgstr "Megerősítő e-mail küldése"

#. translators: %s is the email address the confirmation was sent to
#: app/Hooks/Handlers/CustomerPortalHandler.php:166
#, php-format
msgid "Confirmation email sent to %s. Open the link in that inbox to finish."
msgstr "A megerősítő e-mailt elküldtük a következő címre: %s. A befejezéshez nyissa meg a linket a postafiókban."

#: app/Hooks/Handlers/CustomerPortalHandler.php:169
msgid "Your support email address has been updated."
msgstr "A támogatási e-mail címe frissült."

#: app/Hooks/Handlers/CustomerPortalHandler.php:170
msgid ""
"Too many confirmation emails have been requested for this address. Please "
"try again later."
msgstr "Túl sok megerősítő e-mailt kértek ehhez a címhez. Kérjük, próbálja meg később újra."

#: app/Hooks/Handlers/CustomerPortalHandler.php:171
msgid "That confirmation link has expired. You can request a new one below."
msgstr "Ez a megerősítő link lejárt. Alább kérhet újat."

#: app/Hooks/Handlers/CustomerPortalHandler.php:172
msgid ""
"That confirmation link is no longer valid, usually because it was already "
"used or the address changed again. You can request a new one below."
msgstr "Ez a megerősítő link már nem érvényes. Ennek oka általában az, hogy a linket már felhasználták, vagy a cím ismét megváltozott. Alább kérhet újat."

#: app/Hooks/Handlers/CustomerPortalHandler.php:173
msgid ""
"That confirmation link belongs to a different account. Sign in as that "
"account and open the link again."
msgstr "Ez a megerősítő link egy másik fiókhoz tartozik. Jelentkezzen be azzal a fiókkal, és nyissa meg újra a linket."

#: app/Hooks/Handlers/CustomerPortalHandler.php:174
msgid ""
"Another support profile already uses that address, so it cannot be moved "
"automatically. Please contact support."
msgstr "Ezt a címet már használja egy másik támogatási profil, ezért az nem helyezhető át automatikusan. Kérjük, lépjen kapcsolatba a támogatással."

#: app/Hooks/Handlers/CustomerPortalHandler.php:175
msgid ""
"That confirmation link could not be read. You can request a new one below."
msgstr "Ezt a megerősítő linket nem sikerült beolvasni. Alább kérhet újat."

#: app/Hooks/Handlers/CustomerPortalHandler.php:176
msgid ""
"We could not send the confirmation email just now. Please try again in a few"
" minutes."
msgstr "Most nem sikerült elküldeni a megerősítő e-mailt. Kérjük, próbálja meg újra néhány perc múlva."

