#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundApproved.php:11
msgid "[Flexible Refund] Refund Request Approved"
msgstr "[Flexible Refund] visszatérítési kérelem jóváhagyva"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundApproved.php:12
msgid ""
"Order cancellation request approved email is sent to customer when "
"cancellation request is approved by store manager."
msgstr "A vásárló e-mail értesítést kap, amikor az üzlet kezelője jóváhagyja a rendelés lemondására vonatkozó kérelmet."

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundApproved.php:17
msgid ""
"[{shop_title}] Refund request for order number #{order_number} is approved"
msgstr "[{shop_title}] A(z) #{order_number} rendelés visszatérítési kérelmét jóváhagyták"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundApproved.php:21
msgid "The order refund request has been approved!"
msgstr "A rendelés visszatérítési kérelmét jóváhagyták!"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundApproved.php:25
msgid ""
"Hi {customer_name},\n"
"\n"
"Your refund request has been accepted! Your refund payment has been processed automatically by {order_payment_method}.\n"
"\n"
"Let us know how you liked our service and rate us on Google Map or Trustpilot.Note from store team: {refund_note}. \n"
"\n"
"Sincerely,\n"
"Store Team"
msgstr "Tisztelt {customer_name}!\n\nVisszatérítési kérelmét elfogadtuk! A visszatérítés összegének kifizetése automatikusan megtörtént a(z) {order_payment_method} fizetési móddal.\n\nKérjük, jelezze, hogyan tetszett szolgáltatásunk, és értékeljen minket a Google Térképen vagy a Trustpiloton. Megjegyzés az üzlet csapatától: {refund_note}. \n\nÜdvözlettel,\nAz üzlet csapata"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRefused.php:11
msgid "[Flexible Refund] Refund Request Refused"
msgstr "[Flexible Refund] visszatérítési kérelem elutasítva"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRefused.php:12
msgid ""
"Order cancellation request declined email is sent to customer when "
"cancellation request is declined by store manager."
msgstr "A vásárló e-mail értesítést kap, amikor az üzlet kezelője elutasítja a rendelés lemondására vonatkozó kérelmet."

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRefused.php:17
msgid ""
"[{shop_title}] Refund request for order number #{order_number} is refused"
msgstr "[{shop_title}] A(z) #{order_number} rendelés visszatérítési kérelmét elutasították"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRefused.php:21
msgid "The order refund request has been refused!"
msgstr "A rendelés visszatérítési kérelmét elutasították!"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRefused.php:25
msgid ""
"Hi {customer_name},\n"
"\n"
"Unfortunately, we could not agree to a refund. Below you will find information about the reason for the refund:\n"
"\n"
"{refund_note}\n"
"\n"
"If you do not agree with our feedback, please email us at support@store.com and include the order ID you are writing about.{refund_info_page}\n"
"\n"
"Sincerely,\n"
"Store Team"
msgstr "Tisztelt {customer_name}!\n\nSajnálattal tájékoztatjuk, hogy nem tudjuk jóváhagyni a visszatérítést. A visszatérítés elutasításának indokát alább találja:\n\n{refund_note}\n\nHa nem ért egyet a döntésünkkel, kérjük, írjon nekünk a support@store.com e-mail címre, és tüntesse fel az érintett rendelés azonosítóját (Rendelés ID).{refund_info_page}\n\nÜdvözlettel,\nAz üzlet csapata"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequested.php:11
msgid "[Flexible Refund] Refund Request Requested"
msgstr "[Flexible Refund] visszatérítési kérelem beérkezett"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequested.php:12
#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundShipment.php:13
msgid ""
"Order cancellation request emails are sent to chosen recipient(s) when a new"
" cancellation request is received."
msgstr "Új lemondási kérelem beérkezésekor e-mail értesítést küldünk a kiválasztott címzett(ek)nek."

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequested.php:17
msgid "[{shop_title}] New refund request for order number #{order_number}"
msgstr "[{shop_title}] Új visszatérítési kérelem a(z) #{order_number} rendeléshez"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequested.php:21
#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundShipment.php:22
msgid "The order refund request has been requested!"
msgstr "A rendelés visszatérítési kérelmét benyújtották!"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequested.php:25
msgid ""
"Hi {customer_name},\n"
"\n"
"Thank you for your return request! We will review it and let you know in the next email if a refund will be granted. <a href='{refund_url}' target='_blank'>Click here to cancel your refund</a>.\n"
"\n"
"Below you will find a table with the products you requested to refund.\n"
"\n"
"{refund_order_table}\n"
"\n"
"{refund_info_page}\n"
"\n"
"Sincerely,\n"
"Store Team"
msgstr "Tisztelt {customer_name}!\n\nKöszönjük a visszaküldési kérelmét! Ellenőrizzük, és a következő e-mailben tájékoztatjuk arról, hogy jóváhagyjuk-e a visszatérítést. <a href='{refund_url}' target='_blank'>Kattintson ide a visszatérítési kérelem visszavonásához</a>.\n\nAlább talál egy táblázatot azokról a termékekről, amelyek visszatérítését kérte.\n\n{refund_order_table}\n\n{refund_info_page}\n\nÜdvözlettel,\nAz üzlet csapata"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:14
msgid "[Flexible Refund] New Refund Request"
msgstr "[Flexible Refund] Új visszatérítési kérelem"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:15
msgid "New refund request"
msgstr "Új visszatérítési kérelem"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:26
msgid "Recipient(s)"
msgstr "Címzett(ek)"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:26
msgid "Enter recipient(s). Defaults to administrator email address."
msgstr "Adja meg a címzett(ek)et. Alapértelmezés szerint az adminisztrátor e-mail címét használja."

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:26
#, php-format
msgid ""
"Edit the recipient’s email, or add a new address with the PRO version of the"
" plugin. %1$sUpgrade to PRO &rarr;%2$s"
msgstr "A címzett e-mail címének szerkesztéséhez vagy új cím hozzáadásához használja a bővítmény PRO verzióját. %1$sFrissítés PRO verzióra &rarr;%2$s"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:31
msgid "[{shop_title}] New refund request #{order_number}"
msgstr "[{shop_title}] Új visszatérítési kérelem #{order_number}"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:35
msgid "The new order refund request has been requested!"
msgstr "Új visszatérítési kérelmet nyújtottak be a rendeléshez!"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundRequestedAdmin.php:39
msgid ""
"Hi Admin,\n"
"\n"
"A new refund request for the order {order_number} appeared in {shop_url}\n"
"\n"
"<a href=\"{admin_order_url}\" target=\"_blank\">Click here to go to the order.</a>\n"
"<a href=\"{admin_refunds_url}\" target=\"_blank\">Or click here to go to refund requests list.</a>"
msgstr "Kedves admin!\n\nÚj visszatérítési kérelem érkezett a(z) {order_number} rendeléshez a(z) {shop_url} áruházban.\n\n<a href=\"{admin_order_url}\" target=\"_blank\">Kattintson ide a rendelés megtekintéséhez.</a>\n<a href=\"{admin_refunds_url}\" target=\"_blank\">VAGY kattintson ide a visszatérítési kérelmek listájának megtekintéséhez.</a>"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundShipment.php:12
msgid "[Flexible Refund] Refund Request Shipping"
msgstr "[Flexible Refund] visszatérítési kérelem: szállítás"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundShipment.php:18
msgid ""
"[{shop_title}] Refund request for order number #{order_number} is changed to"
" shipping"
msgstr "[{shop_title}] A(z) #{order_number} rendelés visszatérítési kérelmének állapota szállításra módosult"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundShipment.php:26
msgid ""
"Hi {customer_name},\n"
"\n"
"I wanted to let you know that we have accepted your return and are waiting for a package from you. Please send it to the following address: {shop_address}\n"
"\n"
"The money for the order will be refunded as soon as the package arrives.\n"
"\n"
"Optional administrator note: {refund_note}\n"
"\n"
"If you have changed your mind and wish to withdraw the return - please email us at {shop_email}\n"
"\n"
"Sincerely,\n"
"Store Team"
msgstr "Tisztelt {customer_name}!\n\nTájékoztatjuk, hogy elfogadtuk a visszaküldési kérelmét, és várjuk a csomagját. Kérjük, küldje el a következő címre: {shop_address}\n\nA rendelés árát a csomag beérkezése után visszatérítjük.\n\nOpcionális adminisztrátori megjegyzés: {refund_note}\n\nHa meggondolta magát, és vissza szeretné vonni a visszaküldést, kérjük, írjon nekünk a következő e-mail címre: {shop_email}\n\nÜdvözlettel,\nAz üzlet csapata"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundVerifying.php:11
msgid "[Flexible Refund] E-mail for shipment status"
msgstr "[Flexible Refund] E-mail a szállítmány állapotáról"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundVerifying.php:12
msgid "E-mail about waiting for customer to send shipment"
msgstr "E-mail arról, hogy várjuk a vásárlótól a szállítmány feladását"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundVerifying.php:17
msgid ""
"[{shop_title}] Refund request for order number #{order_number} is verified"
msgstr "[{shop_title}] A #{order_number} számú rendelés visszatérítési kérelmét ellenőriztük"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundVerifying.php:21
msgid "The order refund request is verifying"
msgstr "A rendelés visszatérítési kérelmének ellenőrzése folyamatban van"

#: vendor_prefixed/wpdesk/flexible-refunds-core/src/Emails/EmailRefundVerifying.php:25
msgid ""
"Hi {customer_name},\n"
"\n"
"I wanted to let you know that your refund request is currently being reviewed.\n"
"We have 7 days to do so and will let you know if a refund has been granted.\n"
"\n"
"{refund_info_page}\n"
"\n"
"Note from store team: {refund_note}\n"
"\n"
"<a href='{refund_url}' target='_blank'>Click here if you wish to cancel your refund</a>.\n"
"\n"
"Sincerely,\n"
"Store Team"
msgstr "Kedves {customer_name}!\n\nSzeretném tájékoztatni, hogy visszatérítési kérelmének elbírálása folyamatban van.\nErre 7 napunk van, és értesítjük, ha jóváhagytuk a visszatérítést.\n\n{refund_info_page}\n\nMegjegyzés az üzlet csapatától: {refund_note}\n\n<a href='{refund_url}' target='_blank'>Kattintson ide, ha vissza szeretné vonni a visszatérítési kérelmét</a>.\n\nTisztelettel,\nAz üzlet csapata"

