msgid "Enter a custom subject line for the admin email."
msgstr "Adja meg az adminnak küldött e-mail egyéni tárgyát."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:299
msgid "Admin Email From Name"
msgstr "Admin e-mail feladóneve"

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:301
msgid ""
"Enter a custom from name for the admin email message. The default is the "
"name of the person submitting the form."
msgstr "Adja meg az adminnak küldött e-mail egyéni feladónevét. Alapértelmezés szerint az űrlapot beküldő személy neve szerepel itt."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:307
msgid "Admin Email Address CC"
msgstr "Admin e-mail másolatának címe"

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:309
msgid ""
"Input a carbon copy email address for the admin message. Multiple email "
"addresses can be added separated by a comma."
msgstr "Adja meg az adminnak küldött üzenet másolatának e-mail címét. Több e-mail címet vesszővel elválasztva adhat meg."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:315
msgid "Admin Email Address BCC"
msgstr "Admin e-mail titkos másolatának címe"

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:317
msgid ""
"Input a blind carbon copy email address for the admin message. Multiple "
"email addresses can be added separated by a comma."
msgstr "Adja meg az adminnak küldött üzenet titkos másolatának e-mail címét. Több e-mail címet vesszővel elválasztva adhat meg."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:327
msgid "Save Entries To Database"
msgstr "Bejegyzések mentése az adatbázisba"

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:329
msgid ""
"Choose to save all form entries to the website database. This is helpful to "
