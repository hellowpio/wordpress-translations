msgid ""
"Enter a custom message to display on the frontend in place of the form when "
"the maximum number of entries have already been submitted for this form."
msgstr "Adja meg azt az egyéni üzenetet, amely a webhely felületén az űrlap helyén jelenik meg, ha már elérték az űrlappal beküldhető bejegyzések maximális darabszámát."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:447
msgid "Change Attachments Custom Message"
msgstr "Egyéni üzenet megadása a mellékletekhez"

