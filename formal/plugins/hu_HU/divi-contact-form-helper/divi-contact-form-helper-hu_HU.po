msgstr "Szabja testre a lejárt letöltési hivatkozás megnyitásakor megjelenő fő címsort. Hagyja üresen az alapértelmezett szöveg használatához."

#: d4/app/Admin/Pages/Page_Epanel_Settings.php:451
#: d5/dashboard/build/bundle.js:2
msgid "Expired Link Message"
msgstr "Lejárt hivatkozás üzenete"

#: d4/app/Admin/Pages/Page_Epanel_Settings.php:454
