#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:2824
#: d5/dashboard/build/bundle.js:2
msgid "Button Text"
msgstr "Gomb szöveg"

#: d4/app/Admin/Pages/Page_Epanel_Settings.php:476
msgid ""
"Customize the text shown on the button displayed on expired and invalid "
"download link pages. Leave this empty to use the default wording."
msgstr "Szabja testre a lejárt vagy érvénytelen letöltési hivatkozások oldalán megjelenő gomb szövegét. Hagyja üresen az alapértelmezett szöveg használatához."

#: d4/app/Admin/Pages/Page_Epanel_Settings.php:481
