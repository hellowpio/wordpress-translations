"Media Library."
msgstr "Válassza ki, hogy az űrlapbeküldések összes fájlfeltöltése bekerüljön-e a WordPress médiatárába."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:365
msgid "Send File Uploads As Attachments With Emails"
msgstr "Fájlfeltöltések csatolása az e-mail üzenetekhez"

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:367
msgid "Choose to attach all file uploads to the admin email."
msgstr "Válassza ki, hogy az összes fájlfeltöltést csatolja-e az admin e-mail címére küldött üzenethez."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:377
