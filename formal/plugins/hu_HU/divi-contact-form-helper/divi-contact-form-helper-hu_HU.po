msgstr "Nem található naplófájl, de a művelet sikeresen befejeződött."

#: d5/dashboard/build/bundle.js:2
msgid "All log entries have been permanently deleted."
msgstr "Az összes naplóbejegyzés véglegesen törölve."

#: d5/dashboard/build/bundle.js:2
msgid "Delete Failed"
msgstr "A törlés sikertelen"

#: d5/dashboard/build/bundle.js:2
msgid "There was a problem deleting the log file."
msgstr "Probléma merült fel a naplófájl törlésekor."

#: d5/dashboard/build/bundle.js:2
msgid "Loading logs..."
msgstr "Naplók betöltése..."

#: d5/dashboard/build/bundle.js:2
msgid "Download Log File"
msgstr "Naplófájl letöltése"

#: d5/dashboard/build/bundle.js:2
