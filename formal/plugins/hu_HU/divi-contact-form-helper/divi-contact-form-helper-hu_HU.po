msgstr "Válassza ki a lejárt vagy érvénytelen letöltési hivatkozások oldalán az ikonhoz és a gombhoz használt színt."

#: d4/app/Admin/Pages/Page_Epanel_Settings.php:500
#: d5/dashboard/build/bundle.js:2
msgid "Automatic Conversion"
msgstr "Automatikus átalakítás"

#: d4/app/Admin/Pages/Page_Epanel_Settings.php:507
#: d5/dashboard/build/bundle.js:2
