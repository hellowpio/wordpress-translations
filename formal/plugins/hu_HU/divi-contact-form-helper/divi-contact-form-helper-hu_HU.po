msgid "Choose to save any URL parameters to the website database."
msgstr "Válassza ki, hogy elmentse-e az URL-paramétereket a webhely adatbázisába."

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:416
msgid "Limit Maximum Number Of Entries"
msgstr "A bejegyzések maximális darabszámának korlátozása"

#: d4/app/Frontend/DiviContactForm/Filter_Contact_Form.php:418
msgid ""
"Choose to set a limit for the total number of entries that can be submitted "
