msgstr[1] "%d előrendelést nem sikerült befejezni."

#. translators: %d = The count of emails dispatched
#: includes/admin/class-wc-pre-orders-admin-pre-orders.php:479
msgid "%d email dispatched."
msgid_plural "%d emails dispatched."
msgstr[0] "%d e-mail kiküldve."
msgstr[1] "%d e-mail kiküldve."

