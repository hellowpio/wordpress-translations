#: includes/Actions/Checkout.php:94
msgid "PayPal Checkout"
msgstr "PayPal Checkout"

#: includes/Actions/Checkout.php:758 includes/Actions/SotCheckout.php:773
msgid "Your payment was declined. Please try a different payment method."
msgstr "A fizetést elutasították. Kérjük, próbálkozzon másik fizetési móddal."

#: includes/Actions/Checkout.php:760 includes/Actions/SotCheckout.php:775
msgid ""
"Your payment is pending. Please contact the merchant for more information."
msgstr "A fizetése függőben van. További információért kérjük, vegye fel a kapcsolatot az eladóval."

#: includes/Actions/Checkout.php:762 includes/Actions/SotCheckout.php:777
msgid "Your payment was voided. Please try again."
msgstr "A fizetését érvénytelenítették. Kérjük, próbálkozzon újra."

#: includes/Actions/Checkout.php:764 includes/Actions/SotCheckout.php:779
msgid ""
"Your payment failed. Please try again or use a different payment method."
msgstr "A fizetés sikertelen volt. Kérjük, próbálkozzon újra, vagy használjon másik fizetési módot."

#: includes/Actions/Checkout.php:766 includes/Actions/SotCheckout.php:781
msgid "There was a problem processing your payment. Please try again."
msgstr "Hiba történt a fizetés feldolgozása közben. Kérjük, próbálkozzon újra."

