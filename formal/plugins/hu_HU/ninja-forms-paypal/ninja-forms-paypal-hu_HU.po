msgstr "Sofort"

#: includes/Config/ActionPayPalCheckoutSettings.php:223
msgid "Venmo"
msgstr "Venmo"

#: includes/Config/ActionPayPalCheckoutSettings.php:232
msgid "Order Description"
msgstr "Rendelés leírása"

#: includes/Config/ActionPayPalCheckoutSettings.php:236
#, php-format
msgid ""
"A description of the transaction that appears in PayPal Order Details. Limit"
" %s characters."
msgstr "A tranzakció leírása a PayPal rendelési részletei között jelenik meg. Legfeljebb %s karakter adható meg."

#: includes/Config/ActionPayPalCheckoutSettings.php:243
msgid "Note to Buyer"
msgstr "Megjegyzés a vásárlónak"

#: includes/Config/ActionPayPalCheckoutSettings.php:247
#, php-format
msgid ""
"A note from the merchant displayed to the buyer during PayPal checkout. "
"Limit %s characters."
msgstr "A kereskedőtől származó megjegyzés, amely a PayPal fizetés során jelenik meg a vásárlónak. Legfeljebb %s karakter adható meg."

#: includes/Config/ActionPayPalCheckoutSettings.php:254
msgid "Include Shipping Address"
msgstr "Szállítási cím hozzáadása"

#: includes/Config/ActionPayPalCheckoutSettings.php:258
msgid ""
"Pass shipping address data to PayPal so it appears in Order Details on your "
"PayPal account."
msgstr "Továbbítsa a szállítási cím adatait a PayPalnak, hogy azok megjelenjenek a PayPal-fiókjában a rendelési részletek között."

#: includes/Config/ActionPayPalCheckoutSettings.php:264
msgid "Recipient Name"
msgstr "Címzett neve"

#: includes/Config/ActionPayPalCheckoutSettings.php:269
msgid ""
"Full name of the shipping recipient. Use merge tags to map a form field."
msgstr "A szállítási címzett teljes neve. Űrlapmező hozzárendeléséhez használjon összevonási címkéket."

#: includes/Config/ActionPayPalCheckoutSettings.php:276
msgid "Address Line 1"
msgstr "1. címsor"

#: includes/Config/ActionPayPalCheckoutSettings.php:281
msgid "Street address, P.O. Box, etc. Use merge tags to map a form field."
msgstr "Utca, házszám, postafiók stb. Űrlapmező hozzárendeléséhez használjon összevonási címkéket."

#: includes/Config/ActionPayPalCheckoutSettings.php:288
msgid "Address Line 2"
msgstr "2. címsor"

#: includes/Config/ActionPayPalCheckoutSettings.php:293
msgid ""
"Apartment, suite, unit, building, floor, etc. Use merge tags to map a form "
"field."
msgstr "Lakás, lakosztály, egység, épület, emelet stb. Űrlapmező hozzárendeléséhez használjon összevonási címkéket."

#: includes/Config/ActionPayPalCheckoutSettings.php:300
#: includes/Templates/checkout-standard.html.php:76
msgid "City"
msgstr "Város"

#: includes/Config/ActionPayPalCheckoutSettings.php:305
msgid "City, suburb, town, or village."
msgstr "Település, külváros, város vagy falu."

#: includes/Config/ActionPayPalCheckoutSettings.php:312
msgid "State / Province"
msgstr "Állam / tartomány"

#: includes/Config/ActionPayPalCheckoutSettings.php:317
msgid "State, province, prefecture, or region."
msgstr "Állam, tartomány, prefektúra vagy régió."

#: includes/Config/ActionPayPalCheckoutSettings.php:324
msgid "Postal Code"
msgstr "Irányítószám"

#: includes/Config/ActionPayPalCheckoutSettings.php:329
msgid "ZIP code, postal code, or equivalent."
msgstr "Irányítószám vagy annak megfelelő adat."

#: includes/Config/ActionPayPalCheckoutSettings.php:336
msgid "Country Code"
msgstr "Országkód"

#: includes/Config/ActionPayPalCheckoutSettings.php:341
msgid ""
"Required. Two-letter ISO country code (e.g. US, GB, CA). PayPal will not "
"accept a shipping address without it — if this is left blank, none of the "
"shipping address fields above will be sent, even if they are filled in."
msgstr "Kötelező. Kétbetűs ISO-országkód (pl. US, GB, CA). A PayPal nem fogad el szállítási címet enélkül. Ha ezt üresen hagyja, a fenti szállítási címmezők egyike sem lesz elküldve, még akkor sem, ha ki vannak töltve."

#: includes/Config/ActionPayPalCheckoutSettings.php:353
msgid "Use PayPal Checkout sandbox credentials to test transaction."
msgstr "A tranzakció teszteléséhez használja a PayPal Checkout tesztkörnyezeti hitelesítő adatait."

#: includes/Config/i18nFrontEnd.php:5
msgid "Please select a country"
msgstr "Kérjük, válasszon egy országot"

#: includes/Config/i18nFrontEnd.php:6
msgid "Invalid Name"
msgstr "Hibás név"

#: includes/Config/i18nFrontEnd.php:7
msgid "Card Type Not Accepted"
msgstr "A kártyatípust nem fogadjuk el"

#: includes/Config/i18nFrontEnd.php:8
msgid "Invalid Card Number"
msgstr "Hibás kártyaszám"

#: includes/Config/i18nFrontEnd.php:9
msgid "Invalid Expiry Date"
msgstr "Hibás lejárati dátum"

#: includes/Config/i18nFrontEnd.php:10
msgid "Invalid Security Code"
msgstr "Hibás biztonsági kód"

#: includes/Config/i18nFrontEnd.php:11
msgid ""
"Your payment could not be processed. Please check your card details and try "
"again."
msgstr "A fizetés feldolgozása nem sikerült. Kérjük, ellenőrizze a kártya adatait, majd próbálja újra."

#: includes/Config/PluginSettings.php:7
msgid "Clear debug log"
msgstr "Hibakeresési napló kiürítése"

#: includes/Config/PluginSettings.php:7
msgid ""
"Clear logs when debugging is complete and the logger has been turned off."
msgstr "A hibakeresés befejezésekor és a naplózó kikapcsolása után ürítse ki a naplókat."

#: includes/Config/PluginSettings.php:8
msgid "Download debug log"
msgstr "Hibakeresési napló letöltése"

#: includes/Config/PluginSettings.php:8
msgid "Providing log data with support requests helps diagnose issues."
msgstr "A támogatási kérésekhez mellékelt naplóadatok segítenek a problémák diagnosztizálásában."

#: includes/Config/PluginSettings.php:46
msgid "Turn on Debug Logger"
msgstr "Hibakeresési naplózó bekapcsolása"

#: includes/Config/PluginSettings.php:47
msgid ""
"The debug logger records diagnostic data that can be exported and sent to "
"our support team if you suspect there's an issue with this add-on. Only "
"active when turned on."
msgstr "A hibakeresési naplózó diagnosztikai adatokat rögzít, amelyeket exportálhat és elküldhet a támogatási csapatunknak, ha úgy gondolja, hogy probléma van ezzel a kiegészítővel. Csak bekapcsolt állapotban aktív."

#: includes/Config/PluginSettings.php:47
msgid "Learn more"
msgstr "További tudnivalók"

#: includes/Config/PluginSettings.php:52
msgid "Logger Commands"
msgstr "Naplózó parancsok"

#: includes/Config/Translate/OnboardingPage.php:8
msgid ""
"You currently are onboarded to your LIVE PayPal account, but you can "
"regenerate a new authorization at any time you wish by clicking the button "
"link."
msgstr "Jelenleg az ÉLES PayPal-fiókjához van kapcsolva, de bármikor új engedélyezést hozhat létre a gombra kattintva."

#: includes/Config/Translate/OnboardingPage.php:12
msgid "Regenerate new LIVE onboarding authorization"
msgstr "Új éles fiók-összekapcsolási engedély létrehozása"

#: includes/Config/Translate/OnboardingPage.php:17
msgid ""
"You currently are onboarded to your SANDBOX PayPal account, but you can "
"regenerate a new authorization at any time you wish by clicking the button "
"link."
msgstr "Jelenleg a PayPal tesztfiókjához van kapcsolva, de bármikor új engedélyezést hozhat létre a gombra kattintva."

#: includes/Config/Translate/OnboardingPage.php:21
msgid "Regenerate new SANDBOX onboarding authorization"
msgstr "Új tesztfiók-összekapcsolási engedély létrehozása"

#: includes/Config/Translate/OnboardingPage.php:26
msgid ""
"You currently have PayPal Express actions active.  We recommend migrating "
"those to the new PayPal Checkout. "
msgstr "Jelenleg aktív PayPal Express műveletei vannak. Javasoljuk, hogy térjen át az új PayPal Checkout rendszerre."

#: includes/Config/Translate/OnboardingPage.php:32
msgid ""
"You are not currently onboarded to your LIVE PayPal Checkout account.  "
"Please start the onboarding process."
msgstr "Jelenleg nincs összekapcsolva az éles PayPal Checkout-fiókjával. Kérjük, kezdje meg a fiók összekapcsolását."

#: includes/Config/Translate/OnboardingPage.php:36
msgid "Begin LIVE onboarding authorizaton"
msgstr "Éles fiók összekapcsolásának engedélyezése"

#: includes/Config/Translate/OnboardingPage.php:41
msgid ""
"You are not currently onboarded to your SANDBOX PayPal Checkout account.  "
"Please start the onboarding process."
msgstr "Jelenleg nincs összekapcsolva a PayPal Checkout tesztfiókjával. Kérjük, kezdje meg a fiók összekapcsolását."

#: includes/Config/Translate/OnboardingPage.php:45
msgid "Begin SANDBOX onboarding authorizaton"
msgstr "Tesztfiók összekapcsolásának engedélyezése"

#: includes/Config/Translate/OnboardingPage.php:50
msgid "Your sandbox account is set up correctly and ready to receive payments"
msgstr "A tesztfiók megfelelően van beállítva, és készen áll a fizetések fogadására"

#: includes/Config/Translate/OnboardingPage.php:55
msgid ""
"Please check your sandbox account and ensure that `payments_receivable` and "
"`primary_email_confirmed` are true"
msgstr "Kérjük, ellenőrizze a tesztfiókját, és győződjön meg arról, hogy a `payments_receivable` és a `primary_email_confirmed` értéke true"

#: includes/Config/Translate/OnboardingPage.php:59
msgid ""
"Please complete onboarding to your sandbox account so we can check the "
"settings to accept payments."
msgstr "Kérjük, fejezze be a tesztfiók összekapcsolását, hogy ellenőrizhessük a fizetések fogadásához szükséges beállításokat."

#: includes/Config/Translate/OnboardingPage.php:63
msgid "Unable to verify your sandbox merchant status"
msgstr "Nem sikerült ellenőrizni a tesztfiók kereskedői állapotát"

#: includes/Config/Translate/OnboardingPage.php:67
msgid "Your live account is set up correctly and ready to receive payments"
msgstr "Az éles fiók megfelelően van beállítva, és készen áll a fizetések fogadására"

#: includes/Config/Translate/OnboardingPage.php:71
msgid ""
"Please check your live account and ensure that `payments_receivable` and "
"`primary_email_confirmed` are true"
msgstr "Kérjük, ellenőrizze az éles fiókját, és győződjön meg arról, hogy a `payments_receivable` és a `primary_email_confirmed` értéke true"

#: includes/Config/Translate/OnboardingPage.php:75
msgid ""
"Please complete onboarding to your live account so we can check the settings"
" to accept payments."
msgstr "Kérjük, fejezze be az éles fiók összekapcsolását, hogy ellenőrizhessük a fizetések fogadásához szükséges beállításokat."

#: includes/Config/Translate/OnboardingPage.php:79
msgid "Unable to verify your live merchant status"
msgstr "Nem sikerült ellenőrizni az éles fiók kereskedői állapotát"

#: includes/Config/Translate/PluginSettingsStrings.php:10
msgid ""
"You currently have active PayPal Express payment actions on your site.  We "
"recommend you migrate those to the new PayPal Checkout payment action for "
"the best experience.  Click the button to visit the onboarding page."
msgstr "Jelenleg aktív PayPal Express fizetési műveletei vannak a webhelyén. A legjobb élmény érdekében javasoljuk, hogy térjen át az új PayPal Checkout fizetési műveletre. Kattintson a gombra a fiók-összekapcsolási oldal megnyitásához."

#: includes/Config/Translate/PluginSettingsStrings.php:16
msgid ""
"You are using PayPal Checkout.  Click the button to view/modify your "
"connection."
msgstr "A PayPal Checkoutot használja. Kattintson a gombra a kapcsolat megtekintéséhez vagy módosításához."

