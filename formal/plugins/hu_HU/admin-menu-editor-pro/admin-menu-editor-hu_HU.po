#. Plugin Name of the plugin
#: menu-editor.php
msgid "Admin Menu Editor Pro"
msgstr "Admin Menu Editor Pro"

#. Plugin URI of the plugin
#: menu-editor.php
msgid "http://adminmenueditor.com/"
msgstr "http://adminmenueditor.com/"

#. Description of the plugin
#: menu-editor.php
msgid ""
"Lets you directly edit the WordPress admin menu. You can re-order, hide or "
"rename existing menus, add custom menus, and more."
msgstr ""
"Lehetővé teszi a WordPress adminmenü közvetlen szerkesztését. Átrendezheti, "
"elrejtheti vagy átnevezheti a meglévő menüket, egyéni menüket adhat hozzá és"
" még sok mást."

#. Author of the plugin
#: menu-editor.php
msgid "Janis Elsts"
msgstr "Janis Elsts"

#. Author URI of the plugin
#: menu-editor.php
msgid "http://w-shadow.com/"
msgstr "http://w-shadow.com/"

#: extras.php:869
msgid "You're not allowed to do that!"
msgstr "Ezt nem teheti meg!"

#: extras/modules/visible-users/visible-users.php:23
#: modules/actor-selector/actor-selector.php:57
msgid "You don't have permission to use Admin Menu Editor Pro."
msgstr "Nincs jogosultsága az Admin Menu Editor Pro használatához."

#: extras/modules/visible-users/visible-users.php:29
#: modules/actor-selector/actor-selector.php:54
msgid "Access denied. Invalid nonce."
msgstr "Hozzáférés megtagadva. Érvénytelen nonce."

#: includes/menu-editor-core.php:460
msgid "You will still see the default admin menu content."
msgstr "Továbbra is az alapértelmezett admin menü tartalmát fogja látni."

#: includes/menu-editor-core.php:461
msgid "Custom admin menu is disabled for your account."
msgstr "A fiókjában az egyéni admin menü le van tiltva."

#: modules/content-permissions/content-permissions.php:180
msgid "Disable content permissions enforcement"
msgstr "Tartalmi jogosultságok érvényesítésének letiltása"

#: modules/content-permissions/content-permissions.php:182
msgid ""
"You can still edit post and page permissions, but they won't have any "
"effect. Useful for troubleshooting."
msgstr ""
"A bejegyzések és oldalak jogosultságait továbbra is szerkesztheti, de nem "
"lesz hatásuk. Hasznos a hibakereséshez."

#: modules/content-permissions/content-permissions.php:191
msgid ""
"Detect post type capabilities by checking them with a non-existent user"
msgstr ""
"Bejegyzéstípus-jogosultságok észlelése nem létező felhasználóval történő "
"ellenőrzéssel"

#: modules/content-permissions/content-permissions.php:193
msgid ""
"This usually produces more accurate results, but it can cause errors in some"
" plugins and themes. If you see errors in the post editor, try disabling "
"this option."
msgstr ""
"Ez általában pontosabb eredményeket ad, de egyes bővítményekben és témákban "
"hibákat okozhat. Ha hibákat lát a bejegyzésszerkesztőben, próbálja meg "
"kikapcsolni ezt a beállítást."

#: modules/content-permissions/content-permissions.php:214
msgctxt "\"Settings\" tab section"
msgid "Content permissions"
msgstr "Tartalmi jogosultságok"

