#. Name of the plugin
#: wpai-linkcloak-add-on.php:250
msgid "WP All Import - Link Cloaking Add-on"
msgstr "WP All Import - Link-álcázó kiegészítő"

#: wpai-linkcloak-add-on.php:363 wpai-linkcloak-add-on.php:399
msgid "Link Cloaking Add-On"
msgstr "Linkelrejtő kiegészítő"

#: wpai-linkcloak-add-on.php:372 wpai-linkcloak-add-on.php:402
msgid "Do not cloak links"
msgstr "Linkek elrejtésének mellőzése"

#: wpai-linkcloak-add-on.php:374 wpai-linkcloak-add-on.php:404
msgid "Cloak all links present during import"
msgstr "Az importálás során található összes link elrejtése"

#: wpai-linkcloak-add-on.php:376 wpai-linkcloak-add-on.php:406
msgid "Only cloak WooCommerce External/Affiliate Product Buy URL "
msgstr "Csak a WooCommerce külső/partneri termékek vásárlási URL-jének elrejtése"

#: wpai-linkcloak-add-on.php:380
msgid "Link prefix"
msgstr "Linkelőtag"

#. Description of the plugin
msgid "Cloak all links present during import."
msgstr "Álcázza az import során jelen lévő összes linket."

#. URI of the plugin
msgid "http://www.wpallimport.com/"
msgstr "http://www.wpallimport.com/"

#. Author of the plugin
msgid "Soflyy"
msgstr "Soflyy"
