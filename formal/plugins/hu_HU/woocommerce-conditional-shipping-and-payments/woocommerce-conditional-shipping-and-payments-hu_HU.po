"https://woocommerce.com/products/woocommerce-conditional-shipping-and-"
"payments"
msgstr ""
"https://woocommerce.com/products/woocommerce-conditional-shipping-and-"
"payments"

#. Description of the plugin
#: woocommerce-conditional-shipping-and-payments.php
msgid ""
"Exclude shipping methods, payment gateways and shipping destinations using "
"conditional logic."
msgstr ""
"Zárja ki a szállítási módokat, a fizetési átjárókat és a szállítási "
"célállomásokat feltételes logika használatával."

#. Author of the plugin
#: woocommerce-conditional-shipping-and-payments.php
msgid "WooCommerce"
msgstr "WooCommerce"

#. Author URI of the plugin
#: woocommerce-conditional-shipping-and-payments.php
msgid "https://woocommerce.com/"
msgstr "https://woocommerce.com/"

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:52
msgid "Get Conditional Shipping and Payments restriction rules"
msgstr "A Conditional Shipping and Payments korlátozási szabályainak lekérése"

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:53
msgid ""
"Retrieve configured Conditional Shipping and Payments rules with curated "
"targets and condition summaries."
msgstr "A konfigurált Conditional Shipping and Payments szabályok lekérése válogatott célokkal és feltétel-összefoglalókkal."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:75
msgid "Sorry, you are not allowed to read these restriction rules."
msgstr "Sajnáljuk, nincs jogosultsága ezeknek a korlátozási szabályoknak az olvasásához."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:95
msgid "A product_id is required when scope is product."
msgstr "Ha a hatókör értéke product, a product_id megadása kötelező."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:103
msgid "The requested restriction_id is not supported."
msgstr "A kért restriction_id nem támogatott."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:115
msgid "The requested product was not found."
msgstr "A kért termék nem található."

#. translators: %1$s shipping method title, %2$s shipping rate id.
#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:329
#, php-format
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:464
#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:154
msgid "Conditional Shipping and Payments is not initialized."
msgstr "A Conditional Shipping and Payments nincs inicializálva."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:503
msgid "Return global rules, product-level rules, or both."
msgstr "Globális szabályok, termékszintű szabályok vagy mindkettő visszaadása."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:509
msgid ""
"Product ID to read product-level rules for. Required when scope is product."
msgstr "A termékszintű szabályok lekéréséhez használandó termék ID-je. Kötelező, ha a hatókör értéke product."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:514
msgid "Restriction family to return rules for."
msgstr "Az a korlátozási család, amelynek szabályait vissza kell adni."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:519
msgid "Filter rules by enabled state."
msgstr "Szabályok szűrése bekapcsolt állapot szerint."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:579
msgid "Product ID for product-level rules, or 0 for global rules."
msgstr "Termék-ID a termékszintű szabályokhoz, vagy 0 a globális szabályokhoz."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:588
msgid "One-based position of this rule within its restriction family."
msgstr "A szabály 1-től számozott pozíciója a korlátozási családon belül."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:593
msgid "Human-readable summary of the restricted targets."
msgstr "A korlátozott célok közérthető összefoglalója."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:620
msgid ""
"Condition operator, normalized from stored values such as <, <=, in, or not-"
"in."
msgstr "A feltétel operátora, amelyet a tárolt értékek alapján normalizálnak, például: <, <=, in vagy not-in."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:624
msgid ""
"Number of configured condition values without exposing the values "
"themselves."
msgstr "A beállított feltételértékek darabszáma anélkül, hogy maguk az értékek megjelennének."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:628
msgid ""
"Always true when condition values are intentionally omitted from this public"
" ability output."
msgstr "Mindig igaz, ha a feltételértékeket szándékosan kihagyják a nyilvános képességkimenetből."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:636
msgid "Whether restricted options remain visible to shoppers."
msgstr "Annak jelzése, hogy a korlátozott opciók továbbra is láthatók-e a vásárlók számára."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:640
msgid ""
"Whether the storefront displays notices for restricted options that remain "
"visible."
msgstr "Annak jelzése, hogy az áruház megjelenít-e értesítéseket a továbbra is látható, korlátozott opciókról."

#: includes/abilities/class-wc-csp-get-restriction-rules-ability.php:644
msgid "Whether this rule has a custom restriction notice configured."
msgstr "Annak jelzése, hogy ehhez a szabályhoz be van-e állítva egyéni korlátozási értesítés."

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:43
msgid "List Conditional Shipping and Payments restriction types"
msgstr "A Conditional Shipping and Payments korlátozástípusainak listázása"

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:44
msgid ""
"List the restriction types and condition types supported by Conditional "
"Shipping and Payments."
msgstr "A Conditional Shipping and Payments által támogatott korlátozástípusok és feltételtípusok listázása."

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:193
msgid ""
"Return restriction metadata for global rules, product-level rules, or both."
msgstr "Korlátozási metaadatok visszaadása globális szabályokhoz, termékszintű szabályokhoz vagy mindkettőhöz."

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:222
msgid "Checkout/cart validation contexts where this restriction type can run."
msgstr "Pénztári/kosár-ellenőrzési környezetek, amelyekben ez a korlátozástípus alkalmazható."

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:230
msgid ""
"Primary rule option key that stores IDs affected by this restriction type."
msgstr "Az elsődleges szabályopció-kulcs, amely az e korlátozástípus által érintett ID-ket tárolja."

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:234
msgid ""
"Rule option keys that can store IDs affected by this restriction type. "
"Shipping destination rules can use countries and states."
msgstr "Azok a szabályopció-kulcsok, amelyek az e korlátozástípus által érintett ID-ket tárolhatják. A szállítási célokra vonatkozó szabályok országokat és államokat használhatnak."

#: includes/abilities/class-wc-csp-list-restriction-types-ability.php:239
msgid "Condition types available for global and product-level rules."
msgstr "A globális és termékszintű szabályokhoz elérhető feltételtípusok."

