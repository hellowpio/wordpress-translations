#: akismet.php
msgid "Gravity Forms Akismet Add-On"
msgstr "Gravity Forms Akismet Add-On"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: akismet.php
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
#: akismet.php
msgid ""
"Enhance Gravity Forms with advanced spam protection, powered by Akismet."
msgstr "Bővítse a Gravity Forms képességeit az Akismet által biztosított fejlett spamvédelemmel."

#. Author of the plugin
#: akismet.php
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-akismet.php:354
msgid "Akismet notified that the entry was marked as spam."
msgstr "Az Akismet értesítést küldött arról, hogy a bejegyzést spamnek jelölték."

#: class-gf-akismet.php:357
msgid "Akismet notified that the entry was marked as not spam."
msgstr "Az Akismet értesítést küldött arról, hogy a bejegyzést nem spamnek jelölték."

#: class-gf-akismet.php:705
msgid "The Akismet plugin is either inactive or not installed."
msgstr "Az Akismet bővítmény vagy ki van kapcsolva, vagy nincs telepítve."

#: class-gf-akismet.php:710
msgid ""
"To use this add-on, please visit the Forms -> Settings page to enable "
"Akismet integration"
msgstr "A kiegészítő használatához keresse fel az Űrlapok → Beállítások oldalt, és kapcsolja be az Akismet-integrációt"

#: class-gf-akismet.php:923
msgid "This entry has been marked as spam."
msgstr "Ezt a bejegyzést spamnek jelölték."

