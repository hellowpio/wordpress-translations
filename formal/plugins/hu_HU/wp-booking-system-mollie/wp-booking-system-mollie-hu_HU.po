msgstr "Előleg"

#: includes/base/functions-refunds.php:41
msgid "Final Payment"
msgstr "Végső fizetés"

#: includes/base/views/mollie-payment-form.php:2
msgid "Mollie Test mode is enabled."
msgstr "A Mollie tesztmódja be van kapcsolva."

