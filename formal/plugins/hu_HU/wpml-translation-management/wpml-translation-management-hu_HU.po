#: menu/wpml-tm-menus-management.php:926
msgid ""
"This is a log of the communication between your site and the translation "
"system. It doesn't include any private information and allows WPML support "
"to help with problems related to sending content to translation."
msgstr "Ez a webhely és a fordítórendszer közötti kommunikáció naplója. Nem tartalmaz bizalmas információkat, és lehetővé teszi a WPML támogatás számára, hogy segítsen a tartalom fordításra küldésével kapcsolatos problémák megoldásában."

#: menu/wpml-tm-menus-management.php:934
msgid "Clear log"
msgstr "Napló törlése"

#: menu/wpml-tm-menus-management.php:936
msgid "The communication log is empty."
msgstr "A kommunikációs napló üres."

#: menu/wpml-tm-menus-management.php:941
msgid "Disable logging"
msgstr "Naplózás kikapcsolása"

#: menu/wpml-tm-menus-management.php:944
msgid ""
"Communication logging is currently disabled. To allow WPML support to help "
"you with issues related to sending content to translation, you need to "
"enable the communication logging."
msgstr "A kommunikáció naplózása jelenleg ki van kapcsolva. Ahhoz, hogy a WPML támogatás segítséget nyújthasson a tartalom fordításra küldésével kapcsolatos problémákban, be kell kapcsolnia a kommunikáció naplózását."

#: menu/wpml-tm-menus-management.php:948
msgid "Enable logging"
msgstr "Naplózás engedélyezése"

