#. Plugin Name of the plugin
#: mainwp-virusdie-extension.php
msgid "MainWP Virusdie Extension"
msgstr "MainWP Virusdie bővítmény"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-virusdie-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-virusdie-extension.php
msgid ""
"MainWP Virusdie Extension uses Virusdie, a powerful, user-friendly, and "
"professional-grade antivirus for your websites. It helps you monitor all "
"your sites directly from your MainWP Dashboard."
msgstr "A MainWP Virusdie bővítmény a Virusdie nevű, hatékony, felhasználóbarát és professzionális színvonalú vírusirtót használja honlapjai védelmére. Segítségével közvetlenül a MainWP vezérlőpultjáról felügyelheti az összes webhelyét."

