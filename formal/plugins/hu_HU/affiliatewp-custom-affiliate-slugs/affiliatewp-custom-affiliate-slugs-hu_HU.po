#. Plugin Name of the plugin
#: affiliatewp-custom-affiliate-slugs.php
msgid "AffiliateWP - Custom Affiliate Slugs"
msgstr "AffiliateWP - Custom Affiliate Slugs"

#. Plugin URI of the plugin
#: affiliatewp-custom-affiliate-slugs.php
msgid "https://affiliatewp.com/add-ons/custom-affiliate-slugs/"
msgstr "https://affiliatewp.com/add-ons/custom-affiliate-slugs/"

#. Description of the plugin
#: affiliatewp-custom-affiliate-slugs.php
msgid ""
"Automatically generate custom slugs for your affiliates, or let your "
"affiliates create their own"
msgstr "Automatikusan létrehozhat egyéni slugokat a partnerei számára, vagy engedélyezheti, hogy a partnerei maguk hozzanak létre slugokat"

#. Author of the plugin
#: affiliatewp-custom-affiliate-slugs.php
msgid "AffiliateWP"
msgstr "AffiliateWP"

#. Author URI of the plugin
#: affiliatewp-custom-affiliate-slugs.php
msgid "https://affiliatewp.com"
msgstr "https://affiliatewp.com"

#: affiliatewp-custom-affiliate-slugs.php:141
msgid "AffiliateWP - Custom Affiliate Slugs Requirements"
msgstr "AffiliateWP - Egyedi partneri slugok követelményei"

#: includes/class-activation.php:47
msgid "This plugin"
msgstr "Ez a bővítmény"

#: includes/class-activation.php:82
#, php-format
msgid "requires %s. Please activate it to continue."
msgstr "A(z) %s szükséges. Kérjük, a folytatáshoz aktiválja azt."

#: includes/class-activation.php:85
#, php-format
msgid "requires %s. Please install it to continue."
msgstr "A(z) %s szükséges. Kérjük, a folytatáshoz telepítse azt."

#: includes/class-admin.php:93 includes/class-admin.php:147
#: includes/class-admin.php:223
msgid "Custom Slug"
msgstr "Egyedi slug"

#: includes/class-admin.php:133
msgid "Allow Custom Slug"
msgstr "Egyedi slug engedélyezése"

#: includes/class-admin.php:138
msgid "Allow affiliate to create a custom slug."
msgstr "Engedélyezze, hogy a partner egyedi slugot hozzon létre."

#: includes/class-admin.php:154 includes/class-admin.php:230
msgid "The affiliate's custom slug."
msgstr "A partner egyedi slugja."

#: includes/class-admin.php:173
msgid "You do not have permission to manage affiliates"
msgstr "Nincs jogosultsága a partnerek kezeléséhez"

#: includes/class-admin.php:173 includes/class-admin.php:181
msgid "Error"
msgstr "Hiba"

#: includes/class-admin.php:181
msgid "Security check failed"
msgstr "A biztonsági ellenőrzés sikertelen"

#: includes/class-admin.php:245
msgid "Custom Affiliate Slugs"
msgstr "Egyedi partneri slugok"

#: includes/class-admin.php:261
msgid "Allow Custom Affiliate Slugs"
msgstr "Egyedi partneri slugok engedélyezése"

#: includes/class-admin.php:262
msgid ""
"Allow all affiliates to create a custom slug. Leave unchecked if you would "
"like to enable custom slugs on a per-affiliate basis."
msgstr "Engedélyezze minden partnernek egyedi slug létrehozását. Hagyja jelöletlenül, ha az egyedi slugokat partnerenként szeretné engedélyezni."

#: includes/class-admin.php:266
msgid "Show Custom Slug"
msgstr "Egyedi slug megjelenítése"

#: includes/class-admin.php:267
#, php-format
msgid ""
"Show the affiliate's custom slug in the <strong>Affiliate URLs</strong> tab "
"of the Affiliate Area. This will only show if the affiliate has a custom "
"slug, and the %sDefault Referral Format%s is set to <strong>ID</strong> or "
"<strong>Username</strong>."
msgstr "A partner egyéni slugjának megjelenítése a Partnerfelület <strong>Partneri URL-ek</strong> lapján. Ez csak akkor jelenik meg, ha a partnernek van egyéni slugja, és a %sAlapértelmezett ajánlási formátum%s <strong>ID</strong>-re vagy <strong>felhasználónévre</strong> van állítva."

#: includes/class-admin.php:271
msgid "Auto-create Custom Slugs"
msgstr "Egyedi slugok automatikus létrehozása"

#: includes/class-admin.php:272
msgid ""
"Enable this if you'd like custom slugs to be automatically created for "
"affiliates when they register, or when affiliates are added manually."
msgstr "Engedélyezze, ha azt szeretné, hogy a partnerek számára a regisztrációkor, illetve kézi hozzáadáskor automatikusan létrejöjjenek az egyedi slugok."

#: includes/class-admin.php:276
msgid "Auto-create Slug Settings"
msgstr "Slug automatikus létrehozásának beállításai"

#: includes/class-admin.php:280
msgid "Slug Type"
msgstr "Slug típusa"

#: includes/class-admin.php:281
msgid "Select how the slug should appear, Alphanumeric or Alphabetic."
msgstr ""
"Válassza ki, hogyan nézzen ki a slug: betűk és számok vagy csak betűk."

#: includes/class-admin.php:290
msgid "Slug Length"
msgstr "Slug hossza"

#: includes/class-admin.php:291
msgid ""
"The length of the custom slug. Will only apply to newly generated slugs."
msgstr "Az egyedi slug hossza. Csak az újonnan generált slugokra vonatkozik."

#: includes/class-admin.php:311 includes/class-base.php:316
msgid "Custom Affiliate Slug"
msgstr "Egyedi partneri slug"

#: includes/class-admin.php:495
msgid "Slug Preview"
msgstr "Slug előnézete"

#: includes/class-admin.php:495
msgid ""
"This is an example of how the slug might look for the affiliate, based on "
"the settings below."
msgstr ""
"Ez egy példa arra, hogyan nézhet ki a slug a partner számára az alábbi "
"beállítások alapján."

#: includes/class-affiliatewp-custom-affiliate-slugs.php:106
#: includes/class-affiliatewp-custom-affiliate-slugs.php:118
msgid "Cheatin&#8217; huh?"
msgstr "Csalunk, mi?"

#: includes/class-affiliatewp-custom-affiliate-slugs.php:286
msgid "Get more add-ons for AffiliateWP"
msgstr "További kiegészítők beszerzése az AffiliateWP-hez"

#: includes/class-affiliatewp-custom-affiliate-slugs.php:286
msgid "More add-ons"
msgstr "További kiegészítők"

#: includes/class-base.php:85 includes/class-base.php:95
msgid ""
"This username is already in use. Please contact the site administrator."
msgstr "Ez a felhasználónév már használatban van. Kérjük, lépjen kapcsolatba a webhely rendszergazdájával."

#: includes/class-base.php:183
msgid "Slugs do not match!"
msgstr "A slugok nem egyeznek!"

#: includes/class-base.php:188 includes/class-base.php:637
#: includes/class-base.php:643
msgid "This slug cannot be used."
msgstr "Ez a slug nem használható."

#: includes/class-base.php:194 includes/class-base.php:651
msgid "This slug contains invalid characters."
msgstr "Ez a slug érvénytelen karaktereket tartalmaz."

#: includes/class-base.php:199 includes/class-base.php:660
msgid "This slug is too long."
msgstr "Ez a slug túl hosszú."

#: includes/class-base.php:204 includes/class-base.php:672
msgid "This is your current slug."
msgstr "Ez az aktuális slugja."

#: includes/class-base.php:209 includes/class-base.php:666
msgid "Your slug cannot contain all numbers."
msgstr "A slug nem állhat kizárólag számokból."

#: includes/class-base.php:314
msgid "Custom Slug Settings"
msgstr "Egyedi slug beállításai"

#: includes/class-base.php:340
msgid ""
"This function is no longer needed. It will be removed in a future version."
msgstr ""
"Erre a funkcióra már nincs szükség. Egy későbbi verzióban el lesz távolítva."

#: includes/class-base.php:348 includes/class-base.php:350
#, php-format
msgid "Your custom slug is: <strong>%s</strong>"
msgstr "Az Ön egyedi slugja: <strong>%s</strong>"

#: includes/class-base.php:712
msgid "Confirm Affiliate Slug"
msgstr "Partneri slug megerősítése"

#: includes/class-base.php:714
msgid ""
"By changing your affiliate slug you acknowledge that any existing links "
"using an older affiliate slug may no longer work. Type your new custom slug "
"one more time to confirm, and then click the \"Save Profile Settings\" "
"button below."
msgstr "Az Ön partneri slugjának megváltoztatásával tudomásul veszi, hogy a régi partneri slugot használó meglévő linkek esetleg már nem fognak működni. Írja be az új egyéni slugját még egyszer a megerősítéshez, majd kattintson az alábbi „Profilbeállítások mentése” gombra."

#: includes/class-base.php:733
msgid "Confirm Removal"
msgstr "Eltávolítás megerősítése"

#: includes/class-base.php:735
msgid ""
"By removing your affiliate slug you acknowledge that any existing links "
"using an older affiliate slug may no longer work."
msgstr ""
"A partneri slugjának eltávolításával tudomásul veszi, hogy a régebbi "
"partneri slugot használó meglévő hivatkozások lehet, hogy már nem fognak "
"működni."

#: includes/class-base.php:755
msgid "Confirm Slug Change"
msgstr "Slug módosításának megerősítése"

#: includes/class-base.php:760
msgid ""
"I acknowledge that by changing this affiliate's custom slug, any existing "
"referral links using the old slug may no longer work."
msgstr "Tudomásul veszem, hogy ennek a partnernek az egyéni slugja megváltoztatásakor a régi slugot használó meglévő ajánlói linkek esetleg már nem fognak működni."

