msgstr "Az Ön személyes adatai tekintetében a következő jogok illetik meg"

#: pro/config/documents/ca/privacy-policy.php:123
msgctxt "Legal document privacy statement"
msgid "You may submit a request for access to the data we process about you."
msgstr "Kérelmezheti az Önről általunk kezelt adatokhoz való hozzáférést."

#: pro/config/documents/ca/privacy-policy.php:124
msgctxt "Legal document privacy statement"
msgid ""
"You may request an overview, in a commonly used format, of the data we "
"process about you."
msgstr ""
