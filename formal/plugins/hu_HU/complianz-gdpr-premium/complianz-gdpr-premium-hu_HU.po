msgstr "Hirdetésblokkoló észlelve."

#: settings/build/626.dd904f912f3c1c7071aa.js:1
msgid ""
"Your browser has the Do Not Track or Global Privacy Control setting enabled."
msgstr "A böngészőjében be van kapcsolva a Do Not Track vagy a Global Privacy Control beállítás."

#: settings/build/626.dd904f912f3c1c7071aa.js:1
msgid "This will prevent most cookies from being placed."
msgstr "Ez megakadályozza a cookie-k többségének elhelyezését."

#: settings/build/626.dd904f912f3c1c7071aa.js:1
msgid "Please run the scan with these browser options disabled."
msgstr "Kérjük, kapcsolja ki ezeket a böngészőopciókat, és úgy futtassa a vizsgálatot."

#: settings/build/626.dd904f912f3c1c7071aa.js:1
msgid "DNT or GPC enabled."
msgstr "DNT vagy GPC bekapcsolva."

#: settings/build/626.dd904f912f3c1c7071aa.js:1
