msgid "Learn more about using cookieless tracking with Matomo."
msgstr "További tudnivalók a Matomóval végzett cookie-k nélküli követésről."

#: settings/config/fields/wizard/consent.php:171
msgid ""
"In some countries, like Germany, Austria, Belgium or Spain, consent is "
"required for statistics, even if the data is anonymized."
msgstr ""
"Egyes országokban, például Németországban, Ausztriában, Belgiumban vagy "
"Spanyolországban, a statisztikához hozzájárulás szükséges akkor is, ha az "
"adatok anonimizáltak."

#: settings/config/fields/wizard/consent.php:173
msgid "Do you want to ask consent for statistics?"
msgstr "Szeretne hozzájárulást kérni a statisztikához?"

