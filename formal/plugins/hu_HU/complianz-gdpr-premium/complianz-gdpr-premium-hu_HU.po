#: pro/config/documents/eu/privacy-policy.php:159
#: pro/config/documents/za/privacy-policy.php:188
msgctxt "Legal document privacy statement"
msgid ""
"Right of access: You have the right to access your personal data that is "
"known to us."
msgstr ""
"Hozzáférési jog: joga van hozzáférni az általunk ismert személyes adataihoz."

#: pro/config/documents/eu/privacy-policy.php:160
#: pro/config/documents/za/privacy-policy.php:189
msgctxt "Legal document privacy statement"
msgid ""
"Right to rectification: you have the right to supplement, correct, have "
