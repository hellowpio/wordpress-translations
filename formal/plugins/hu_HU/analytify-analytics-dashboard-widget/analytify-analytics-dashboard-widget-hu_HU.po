#, php-format
msgid "%1$s vs %2$s"
msgstr "%1$s kontra %2$s"

#: classes/class-analytify-widget-rest-api.php:443
msgid "Sessions"
msgstr "Munkamenetek"

#: classes/class-analytify-widget-rest-api.php:444
msgid ""
"A session is a time period in which a user is actively engaging your "
"website."
msgstr "A munkamenet az az időszak, amely alatt egy felhasználó aktívan használja a webhelyét."

#: classes/class-analytify-widget-rest-api.php:447
msgid "Visitors"
msgstr "Látogatók"

#: classes/class-analytify-widget-rest-api.php:448
msgid "Users who complete a minimum one session on your website or content."
msgstr "A webhelyét vagy annak tartalmait legalább egy munkamenetben használó felhasználók."

#: classes/class-analytify-widget-rest-api.php:451
msgid "Bounce Rate"
msgstr "Visszafordulási arány"

#: classes/class-analytify-widget-rest-api.php:453
msgid ""
"Percentage of Single page visits (i.e number of visits in which a visitor "
"leaves your website from the landing page without browsing your website)."
msgstr "Az egyoldalas látogatások százalékos aránya (vagyis azoknak a látogatásoknak a száma, amelyek során a látogató a céloldal megtekintése után további böngészés nélkül hagyja el a honlapot)."

#: classes/class-analytify-widget-rest-api.php:456
msgid "Avg. time on site"
msgstr "A webhelyen töltött átlagos idő"

#: classes/class-analytify-widget-rest-api.php:457
msgid "Total time that a single user spends on your website."
msgstr "Egy felhasználó által a honlapján töltött teljes idő."

#: classes/class-analytify-widget-rest-api.php:460
msgid "Pages/Session"
msgstr "Oldalak/munkamenet"

#: classes/class-analytify-widget-rest-api.php:461
msgid ""
"Pages/Session (Average Page Depth) is the number of pages viewed by a user "
"during a session. Repeated views are counted."
msgstr "Az oldalak/munkamenet (átlagos oldalmélység) azt mutatja meg, hogy egy felhasználó hány oldalt tekintett meg egy munkamenet során. Az ismételt megtekintések is beleszámítanak."

#: classes/class-analytify-widget-rest-api.php:464
msgid "Page Views"
msgstr "Oldalmegtekintések"

#: classes/class-analytify-widget-rest-api.php:465
msgid ""
"Page Views are the total number of Pageviews. This including repeated views."
msgstr "Az oldalmegtekintések teljes száma az ismételt megtekintéseket is tartalmazza."

#: classes/class-analytify-widget-rest-api.php:468
msgid "New Users"
msgstr "Új felhasználók"

#: classes/class-analytify-widget-rest-api.php:469
msgid ""
"The number of users who interacted with your site or launched your website "
"for the first time"
msgstr "Azoknak a felhasználóknak a száma, akik kapcsolatba léptek a webhelyével, vagy először keresték fel a honlapját"

#: classes/class-analytify-widget-rest-api.php:472
msgid "%New Sessions"
msgstr "Új munkamenetek százaléka"

#: classes/class-analytify-widget-rest-api.php:473
msgid ""
"A new session is a time period when a new user comes to your website and is "
"actively engaged with your website."
msgstr "Az új munkamenet az az időszak, amikor egy új felhasználó felkeresi a webhelyét, és aktívan használja azt."

#: classes/class-analytify-widget-rest-api.php:476
msgid "New vs Returning Visitors"
msgstr "Új és visszatérő látogatók"

#: classes/class-analytify-widget-rest-api.php:477
msgid ""
"New visitors are those who land to your site for the first time, whereas "
"Returning Visitors are the ones who come back to your site after a recent "
"visit."
msgstr "Az új látogatók először keresik fel a webhelyét, míg a visszatérő látogatók egy korábbi látogatás után térnek vissza."

#. Translators: %s total time.
#: classes/class-analytify-widget-rest-api.php:494
#, php-format
msgid "Total time visitors spent on your site: %s"
msgstr "A látogatók által a webhelyén töltött teljes idő: %s"

