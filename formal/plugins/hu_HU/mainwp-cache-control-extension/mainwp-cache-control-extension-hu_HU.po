msgstr "Gyorsítótár törlése"

#: class/class-mainwp-cache-control-purge-view.php:979
msgid "View Cache Control Logs"
msgstr "Cache Control naplók megtekintése"

#: class/class-mainwp-cache-control-purge-view.php:1000
msgid "Purge Cache (Cache Control)"
msgstr "Gyorsítótár ürítése (Cache Control)"

