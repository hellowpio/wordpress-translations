#. Plugin Name of the plugin
#: class-addify-edit-order-by-customer-main.php
msgid "Edit Order by Customer"
msgstr "Rendelés szerkesztése a vásárló által"

#. Plugin URI of the plugin
#: class-addify-edit-order-by-customer-main.php
msgid "https://woocommerce.com/products/edit-order-by-customer/"
msgstr "https://woocommerce.com/products/edit-order-by-customer/"

#. Description of the plugin
#: class-addify-edit-order-by-customer-main.php
msgid ""
"Allow your customers to edit specific details of your order based on the "
"current status."
msgstr "Engedélyezze vásárlói számára, hogy az aktuális állapot alapján szerkesszék a rendelés bizonyos részleteit."

#. Author of the plugin
#: class-addify-edit-order-by-customer-main.php
msgid "Addify"
msgstr "Addify"

#. Author URI of the plugin
#: class-addify-edit-order-by-customer-main.php
msgid "https://woocommerce.com/vendor/addify/"
msgstr "https://woocommerce.com/vendor/addify/"

#: cart-table.php:18 class-addify-edit-order-by-customer-front.php:180
msgid "Name"
msgstr "Név"

#: cart-table.php:19 class-addify-edit-order-by-customer-front.php:181
msgid "Price"
msgstr "Ár"

#: cart-table.php:20 class-addify-edit-order-by-customer-front.php:182
#: class-addify-edit-order-by-customer-front.php:267
msgid "Quantity"
msgstr "Mennyiség"

#: cart-table.php:21 class-addify-edit-order-by-customer-front.php:183
msgid "Subtotal"
msgstr "Részösszeg"

#: class-addify-edit-order-by-customer-admin.php:54
msgid "Edit order by customer Settings"
msgstr "Edit Order by Customer beállításai"

#: class-addify-edit-order-by-customer-admin.php:58
msgid "General Settings"
msgstr "Általános beállítások"

#: class-addify-edit-order-by-customer-admin.php:59
msgid "Billing Address Settings"
msgstr "Számlázási cím beállításai"

#: class-addify-edit-order-by-customer-admin.php:61
msgid "Shipping Address Settings"
msgstr "Szállítási cím beállításai"

#: class-addify-edit-order-by-customer-admin.php:63
msgid "Product Settings"
msgstr "Termékbeállítások"

#: class-addify-edit-order-by-customer-admin.php:65
msgid "Shipping Method Settings"
msgstr "Szállítási mód beállításai"

#: class-addify-edit-order-by-customer-admin.php:67
msgid "Payment Method Settings"
msgstr "Fizetési mód beállításai"

#: class-addify-edit-order-by-customer-admin.php:106
msgid "Save Settings"
msgstr "Beállítások mentése"

#: class-addify-edit-order-by-customer-admin.php:521
msgid ""
"Hello your customer {customer_full_name} email: {customer_email} edited his "
"order {order_number}."
msgstr "Üdvözöljük! A vásárló ({customer_full_name}, e-mail-cím: {customer_email}) szerkesztette a(z) {order_number} számú rendelést."

#: class-addify-edit-order-by-customer-admin.php:539
msgid ""
"Use {customer_full_name} for customer name,use {customer_email} for customer"
" email and use {order_number} for order id for sending email to admin."
msgstr "Használja a {customer_full_name} értéket a vásárló nevéhez, a {customer_email} értéket a vásárló e-mail-címéhez, a {order_number} értéket pedig a rendelés ID-jéhez az adminnak küldött e-mailben."

#: class-addify-edit-order-by-customer-admin.php:574
msgid "Select billing address that you want to change in order."
msgstr "Válassza ki a számlázási címet, amelyet a rendelésben módosítani szeretne."

#: class-addify-edit-order-by-customer-admin.php:606
msgid "Select specific user role which you want to show edit order button."
msgstr "Válassza ki azt a konkrét felhasználói szerepkört, amelynek tagjai számára meg szeretné jeleníteni a rendelés szerkesztésére szolgáló gombot."

#: class-addify-edit-order-by-customer-admin.php:632
msgid "Select user role which you want to show edit order button."
msgstr "Válassza ki azt a felhasználói szerepkört, amelynek tagjai számára meg szeretné jeleníteni a rendelés szerkesztésére szolgáló gombot."

#: class-addify-edit-order-by-customer-admin.php:716
msgid "Select payment method which you want to show in edit order view page."
msgstr "Válassza ki a fizetési módot, amelyet a rendelés szerkesztési oldalán meg szeretne jeleníteni."

#: class-addify-edit-order-by-customer-admin.php:737
msgid "Checkbox for enable payment method settings."
msgstr "Jelölőnégyzet a fizetési mód beállításainak engedélyezéséhez."

#: class-addify-edit-order-by-customer-admin.php:785
msgid "Select shipping method which you want to show in edit order view page."
msgstr "Válassza ki a szállítási módot, amelyet a rendelés szerkesztési oldalán meg szeretne jeleníteni."

#: class-addify-edit-order-by-customer-admin.php:806
msgid "Checkbox for enable shipping method settings."
msgstr "Jelölőnégyzet a szállítási mód beállításainak engedélyezéséhez."

#: class-addify-edit-order-by-customer-admin.php:839
msgid "Choose specific product that you want to edit in order."
msgstr "Válassza ki azt a konkrét terméket, amelyet a megrendelésben szerkeszteni szeretne."

#: class-addify-edit-order-by-customer-admin.php:874
msgid "Choose specific product category that you want to edit in order."
msgstr "Válassza ki azt a konkrét termékkategóriát, amelyet a megrendelésben szerkeszteni szeretne."

#: class-addify-edit-order-by-customer-admin.php:895
msgid "Checkbox for enable product settings."
msgstr "Jelölőnégyzet a termékbeállítások engedélyezéséhez."

#: class-addify-edit-order-by-customer-admin.php:917
msgid "Checkbox for enable all product settings."
msgstr "Jelölőnégyzet az összes termékbeállítás engedélyezéséhez."

#: class-addify-edit-order-by-customer-admin.php:952
msgid "Select shipping address that you want to change in order."
msgstr ""
"Válassza ki a szállítási címet, amelyet a rendelésben módosítani szeretne."

#: class-addify-edit-order-by-customer-admin.php:1038
msgid "Checkbox for enable edit button settings."
msgstr "Jelölőnégyzet a szerkesztés gomb beállításainak engedélyezéséhez."

#: class-addify-edit-order-by-customer-admin.php:1116
msgid "Checkbox for enable edit billing address settings."
msgstr "Jelölőnégyzet a számlázási cím szerkesztési beállításainak engedélyezéséhez."

#: class-addify-edit-order-by-customer-admin.php:1136
msgid "Checkbox for enable edit shipping address settings."
msgstr "Jelölőnégyzet a szállítási cím szerkesztési beállításainak engedélyezéséhez."

#: class-addify-edit-order-by-customer-front.php:102
msgid "Billing address"
msgstr "Számlázási cím"

#: class-addify-edit-order-by-customer-front.php:139
msgid "Shipping address"
msgstr "Szállítási cím"

#: class-addify-edit-order-by-customer-front.php:174
msgid "Cart items"
msgstr "Kosár tételei"

#: class-addify-edit-order-by-customer-front.php:243
msgid "Add Product"
msgstr "Termék hozzáadása"

#: class-addify-edit-order-by-customer-front.php:247
msgid "Product"
msgstr "Termék"

#: class-addify-edit-order-by-customer-front.php:248
msgid "Select product..."
msgstr "Válasszon terméket..."

#: class-addify-edit-order-by-customer-front.php:294
msgid "Shipping methods"
msgstr "Szállítási módok"

#: class-addify-edit-order-by-customer-front.php:359
msgid "Payment methods"
msgstr "Fizetési módok"

#: class-addify-edit-order-by-customer-front.php:663
msgid "Edit Order"
msgstr "Megrendelés szerkesztése"

#: class-addify-edit-order-by-customer-main.php:81
msgid "Edit Order by Customer plugin is inactive."
msgstr "Az Edit Order by Customer bővítmény ki van kapcsolva."

#: class-addify-edit-order-by-customer-main.php:81
msgid ""
"must be active for this plugin to work. Please install &amp; activate "
"WooCommerce."
msgstr "aktívnak kell lennie ahhoz, hogy ez a bővítmény működjön. Kérjük, telepítse &amp; kapcsolja be a WooCommerce-t."

#. translators: %s: Product name
#: class-addify-edit-order-by-customer-main.php:133
#, php-format
msgid " For “%s” You must enter 1 quantity."
msgstr " „%s” esetén 1-et kell megadni mennyiségként."

#. translators: %s: Product name
#: class-addify-edit-order-by-customer-main.php:141
#, php-format
msgid " For “%s” You must enter positive number for quantity."
msgstr " „%s” esetén a mennyiségnek pozitív számnak kell lennie."

#. translators: %s: Product name
#: class-addify-edit-order-by-customer-main.php:154
#, php-format
msgid " “%1$s” has not enough stock. You can add only %2$s quantity."
msgstr " „%1$s” esetén nincs elegendő készlet. Csak %2$s mennyiséget adhat hozzá."

#. translators: %s: Product name
#: class-addify-edit-order-by-customer-main.php:164
#, php-format
msgid " “%s” is out of stock."
msgstr " „%s” elfogyott."

#. translators: %s: Product name
#: class-addify-edit-order-by-customer-main.php:218
#, php-format
msgid "Cart table is not update for “%s”."
msgstr "A kosár táblázata nem frissül „%s” esetén."

#: class-addify-eobc-email.php:52
msgid "[{site_title}]: Order order has been edited"
msgstr "[{site_title}]: A rendelés módosítva lett"

#: class-addify-eobc-email.php:59
msgid "Order has been edited by customer."
msgstr "A rendelést az ügyfél módosította."

