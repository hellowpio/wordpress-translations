#. Plugin Name of the plugin
#: plugin.php
msgid "WPML String Translation"
msgstr "WPML Karakterlánc-fordítás"

#. Plugin URI of the plugin
#: plugin.php
msgid ""
"https://wpml.org/documentation/wpml-core-and-add-on-plugins/string-"
"translation/"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/string-translation/"

#. Description of the plugin
#: plugin.php
msgid ""
"Adds theme and plugins localization capabilities to WPML | <a "
"href=\"https://wpml.org/documentation/translating-your-"
"contents/strings/\">Documentation</a> | <a "
"href=\"https://wpml.org/version/wpml-string-translation-5-2-0/\">WPML String"
" Translation 5.2.0 release notes</a>"
msgstr "A sablonok és bővítmények honosítási lehetőségeit adja hozzá a WPML-hez | <a href=\"https://wpml.org/documentation/translating-your-contents/strings/\">dokumentáció</a> | <a href=\"https://wpml.org/version/wpml-string-translation-5-2-0/\">WPML String Translation 5.2.0 kiadási megjegyzések</a>"

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: Message on the Theme and plugins localization page after a
#. scan. %s: the number of translation files found. "Their" refers to those
#. files. Keep the word "WPML" and both full stops: the page starts the
#. message at "WPML" and puts the first sentence in bold.
#: classes/API/rest/mo/Import.php:66
#, php-format
msgid ""
"WPML found %s new or updated .mo files. Their texts were added to the "
"translations table."
msgstr "A WPML %s új vagy frissített .mo fájlt talált. A fájlok szövegei bekerültek a fordítások táblázatába."

#. translators: Notice on the WPML screens when automatic string registration
#. is off. %1$s: opening link tag, %2$s: closing link tag; the words between
#. them become the link.
#: classes/AutoRegisterStringsNotice.php:28
#, php-format
msgid "String auto registration is disabled. %1$sClick here to enable it%2$s"
msgstr "Az automatikus karakterlánc-regisztráció ki van kapcsolva. %1$sKattintson ide a bekapcsolásához%2$s"

#: classes/BackgroundTask/LoadExistingTranslationsTask.php:96
msgid "Importing existing string translations for the new languages"
msgstr "Meglévő karakterlánc-fordítások importálása az új nyelvekhez"

#: classes/BackgroundTask/UpdateStringsStatusTask.php:48
msgid "Updating string translation statuses"
msgstr "A karakterlánc-fordítások állapotának frissítése"

#: classes/batch-action/ChangeLanguageOfStringsInDomain.php:47
#: classes/batch-action/CountStringsInDomain.php:16
#: classes/batch-action/DeleteStringsInDomain.php:33
#: classes/batch-action/InitChangeStringLangOfDomain.php:53
#: classes/strings-cleanup/ajax/InitStringsRemoving.php:52
#: classes/strings-cleanup/ajax/RemoveStringsFromDomains.php:42
msgid "Error: please try again"
msgstr "Hiba: próbálja meg újra"

#. translators: Status value on the String Translation page: every language of
#. the text has a translation.
#: classes/class-wpml-st-string-statuses.php:15
msgid "Translation complete"
msgstr "Fordítás kész"

#. translators: Status value on the String Translation page: some languages of
#. the text have a translation and some do not.
#: classes/class-wpml-st-string-statuses.php:19
msgid "Partial translation"
msgstr "Részleges fordítás"

#: classes/class-wpml-st-string-statuses.php:22
msgid "Translation needs update"
msgstr "A fordítás frissítést igényel"

#. translators: Status value on the String Translation and Packages pages: the
#. text has no translation yet.
#: classes/class-wpml-st-string-statuses.php:26
#: inc/package-translation/inc/wpml-package-translation-metabox.class.php:414
#: inc/package-translation/inc/wpml-package-translation-metabox.class.php:452
msgid "Not translated"
msgstr "Nincs lefordítva"

#: classes/class-wpml-st-string-statuses.php:29
#: inc/package-translation/inc/wpml-package-translation-metabox.class.php:399
#: menu/string-translation.php:193
msgid "Waiting for translator"
msgstr "Fordítóra vár"

#. translators: Admin notice shown when WPML String Translation is active but
#. WPML core is missing. %1$s: the URL of the client's wpml.org account
#. downloads page, which fills the first link. %2$s: the URL of this site's
#. Plugins screen, which fills the second link.
#: classes/class-wpml-st-verify-dependencies.php:63
#, php-format
msgid ""
"WPML String Translation is active, but it needs WPML Multilingual CMS, which"
" is not installed or not active. String Translation stays off until WPML "
"runs. Download WPML from <a href=\"%1$s\">your wpml.org account</a> and "
"activate it on the <a href=\"%2$s\">Plugins screen</a>."
msgstr "A WPML String Translation aktív, de működéséhez szükség van a WPML Multilingual CMS-re, amely nincs telepítve vagy nem aktív. A String Translation ki van kapcsolva, amíg a WPML nem fut. Töltse le a WPML-t a <a href=\"%1$s\">wpml.org-fiókjából</a>, és kapcsolja be a <a href=\"%2$s\">bővítmények</a> képernyőn."

#. translators: Admin notice shown when the installed WPML core is older than
#. WPML String Translation needs. %1$s: String Translation's own version.
#. %2$s: the minimum WPML version it needs. %3$s: the WPML version this site
#. runs. %4$s: the URL of this site's Plugins screen, which fills the link.
#: classes/class-wpml-st-verify-dependencies.php:84
#, php-format
msgid ""
"WPML String Translation %1$s needs WPML Multilingual CMS %2$s or newer. This"
" site runs WPML %3$s, so String Translation stays off until WPML is updated."
" Update WPML on the <a href=\"%4$s\">Plugins screen</a>."
msgstr "A WPML String Translation %1$s működéséhez a WPML Multilingual CMS %2$s vagy újabb verziója szükséges. Ezen a webhelyen a WPML %3$s verziója fut, ezért a String Translation ki van kapcsolva a WPML frissítéséig. Frissítse a WPML-t a <a href=\"%4$s\">bővítmények</a> képernyőn."

#. translators: Error message shown when the user does not have the rights to
#. do what they asked for. Past participle used as a state, lower case in the
#. source.
#: classes/filters/class-wpml-st-taxonomy-labels-translation.php:318
#: classes/filters/class-wpml-st-taxonomy-labels-translation.php:376
#: classes/gettext-hooks/AutoRegisterSettings.php:191
#: classes/strings-scanning/class-wpml-st-theme-plugin-scan-files-ajax.php:24
#: classes/strings-scanning/wpml-st-theme-plugin-scan-dir-ajax.php:26
msgid "not allowed"
msgstr "nem engedélyezett"

#. translators: Error message shown when a request to the server arrives
#. without the information it needs.
#: classes/filters/class-wpml-st-taxonomy-labels-translation.php:389
msgid "Missing parameters"
msgstr "Hiányzó paraméterek"

#. translators: Error message on the String Translation page when the security
#. check of a request fails.
#: classes/filters/class-wpml-st-taxonomy-labels-translation.php:430
msgid "Invalid nonce"
msgstr "Érvénytelen nonce"

#: classes/gettext-hooks/AutoRegisterSettings.php:214
msgid "Nonce value is invalid"
msgstr "A nonce értéke érvénytelen"

#. translators: Note on the String Translation page under the automatic string
#. registration setting. %s: how much time is left, counted down in the page
#. as hours, minutes and seconds.
#: classes/gettext-hooks/AutoRegisterSettings.php:222
#, php-format
msgid ""
"Automatic string registration will remain active for <span class='counter-"
"msg'>%s</span>. Please visit the site's front-end to allow WPML to find "
"strings for translation."
msgstr "Az automatikus karakterlánc-regisztráció még ennyi ideig marad aktív: <span class='counter-msg'>%s</span>. Kérjük, látogassa meg a webhely nyilvános felületét, hogy a WPML megtalálhassa a lefordítandó karakterláncokat."

#. translators: Note on the String Translation page under the automatic string
#. registration setting, shown while the setting is off. "It" is that setting.
#: classes/gettext-hooks/AutoRegisterSettings.php:228
msgid ""
"* This feature is only intended for sites that are in development. It will "
"significantly slow down the site, but help you find strings that WPML cannot"
" detect in the PHP code."
msgstr "* Ez a funkció csak fejlesztés alatt álló webhelyekhez készült. Jelentősen lelassítja a webhelyet, de segít megtalálni azokat a karakterláncokat, amelyeket a WPML nem tud észlelni a PHP-kódban."

#: classes/menus/theme-plugin-localization-ui/class-st-theme-plugin-localization-options-ui.php:30
msgid ""
"Use theme or plugin text domains when gettext calls do not use a string "
"literal"
msgstr "Használja a sablon vagy a bővítmény textdomainjét, ha a GetText-hívásokban nem karakterlánc-literál szerepel."

#: classes/menus/theme-plugin-localization-ui/class-st-theme-plugin-localization-options-ui.php:31
msgid ""
"Some themes and plugins don't properly set the textdomain (second argument) "
"in GetText calls. When you select this option, WPML will assume that the "
"strings found in GetText calls in the PHP files of the theme and plugin "
"should have the textdomain with the theme/plugin's name."
msgstr "Egyes sablonok és bővítmények nem állítják be megfelelően a textdomain értékét (a második argumentumot) a GetText-hívásokban. Ha ezt az opciót választja, a WPML feltételezi, hogy a sablon és a bővítmény PHP-fájljaiban található GetText-hívásokban szereplő karakterláncok textdomainje a sablon/bővítmény neve."

#: classes/menus/theme-plugin-localization-ui/strategy/class-wpml-st-plugin-localization-ui.php:40
#: classes/menus/theme-plugin-localization-ui/strategy/OtherLocalizationUI.php:40
msgid "Scan selected plugins for strings"
msgstr "Karakterláncok keresése a kijelölt bővítményekben"

