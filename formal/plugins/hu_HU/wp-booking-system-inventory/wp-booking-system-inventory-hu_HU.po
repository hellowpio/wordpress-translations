#. Description of the plugin
msgid ""
"Allow multiple bookings per day and automatically make the dates unavailable"
" when the maximum number of bookings is reached."
msgstr "Engedélyezze, hogy naponta több foglalás is történhessen, és a maximális foglalásszám elérésekor a dátumok automatikusan nem lesznek elérhetők."

#: includes/base/admin/functions.php:919
#, php-format
msgid "Booking #%s was automatically created by this booking."
msgstr "A #%s foglalást ez a foglalás hozta létre automatikusan."

#: includes/base/admin/functions.php:942
msgid "Child Booking"
msgstr "Gyermekfoglalás"

#: includes/base/admin/functions.php:958
msgid "Created Automatically"
msgstr "Automatikusan létrehozva"

#: includes/base/admin/functions.php:345
msgid "Embedded Calendar"
msgstr "Beágyazott naptár"

#: includes/base/admin/functions.php:978
#, php-format
msgid "For payment details, please see Booking #%s."
msgstr "A fizetési részletekért tekintse meg a #%s foglalást."

#. URI of the plugin
#. Author URI of the plugin
msgid "https://www.wpbookingsystem.com/"
msgstr "https://www.wpbookingsystem.com/"

#: includes/base/admin/functions.php:70
msgid ""
"In this column you can see number of bookings that can be made for each day."
" When a booking is made, the number decreases by 1."
msgstr "Ebben az oszlopban láthatja, hogy naponta hány foglalás tehető. Egy foglalás létrehozásakor ez a szám 1-gyel csökken."

#: includes/base/admin/functions.php:180
msgid "Invalid date selection. Please refresh the page and try again."
msgstr "Érvénytelen dátumválasztás. Kérjük, frissítse az oldalt, majd próbálja újra."

#: includes/base/admin/functions.php:590
msgid "Invalid date selection. The inventory for the selected dates is 0."
msgstr "Hibás dátumkijelölés. A kiválasztott dátumokhoz tartozó készlet 0."

#: includes/base/admin/functions.php:608
msgid "Invalid Inventory"
msgstr "Érvénytelen készlet"

#: includes/base/admin/functions.php:20 includes/base/admin/functions.php:70
#: includes/base/admin/functions.php:125
msgid "Inventory"
msgstr "Készlet"

#: includes/base/admin/functions.php:24
msgid "Maximum Bookings per Day"
msgstr "Naponta foglalható alkalmak maximális száma"

#: includes/base/admin/functions.php:352
msgid "Maximum Limit"
msgstr "Felső korlát"

#: includes/base/admin/functions.php:351
msgid "Multiply by Calendar Price"
msgstr "Szorzás a naptár árával"

#: includes/base/admin/functions.php:351
msgid "None"
msgstr "Nincs"

#: includes/base/admin/functions.php:591
msgid "Not available for the selected dates."
msgstr "A kiválasztott dátumokon nem érhető el."

#: includes/base/admin/functions.php:895
msgid "Parent Booking"
msgstr "Szülőfoglalás"

#: includes/base/admin/functions.php:351
msgid "Price Calculation"
msgstr "Árkalkuláció"

#: includes/base/admin/functions.php:31
msgid "Set Default Limit"
msgstr "Alapértelmezett korlát beállítása"

#: includes/base/admin/functions.php:353
msgid "Source"
msgstr "Forrás"

#: includes/base/admin/functions.php:873
#, php-format
msgid "This booking was automatically created by Booking #%s."
msgstr "Ezt a foglalást automatikusan a #%s számú foglalás hozta létre."

#. Author of the plugin
msgid "Veribo, Roland Murg"
msgstr "Veribo, Roland Murg"

#. Name of the plugin
msgid "WP Booking System - Inventory"
msgstr "WP Booking System - Készlet"

#: includes/base/admin/functions.php:611
msgid "Zero Inventory"
msgstr "Nulla készlet"

