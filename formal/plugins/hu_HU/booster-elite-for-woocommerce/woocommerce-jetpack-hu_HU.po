#: includes/settings/wcj-settings-price-by-country.php:122
#: includes/settings/wcj-settings-product-price-by-formula.php:126
#: includes/shipping/class-wc-shipping-wcj-custom-with-shipping-zones.php:308
msgid "Round down"
msgstr "Lefelé kerekítés"

#: includes/settings/wcj-settings-multicurrency.php:108
msgid ""
"Control how converted prices are rounded. \"No rounding\" shows exact "
"conversions like $19.47. \"Round\" gives clean prices like $19.50. \"Round "
"up\" always rounds up (better for profit margins). \"Round down\" always "
"rounds down (better for customer perception)."
msgstr "Állítsa be az átváltott árak kerekítését. A „Nincs kerekítés” pontos átváltott árakat jelenít meg, például 19,47 $. A „Kerekítés” kerek árakat ad, például 19,50 $. A „Felfelé kerekítés” mindig felfelé kerekít (ez kedvezőbb a haszonkulcs szempontjából). A „Lefelé kerekítés” mindig lefelé kerekít (ez kedvezőbb a vásárlók megítélése szempontjából)."

#: includes/settings/wcj-settings-multicurrency.php:111
msgid "Rounding Precision"
msgstr "Kerekítési pontosság"

#: includes/settings/wcj-settings-multicurrency.php:112
msgid "If rounding is enabled, set rounding precision here."
msgstr "Ha a kerekítés be van kapcsolva, itt adja meg a kerekítés pontosságát."

#: includes/settings/wcj-settings-multicurrency.php:117
msgid ""
"Set how many decimal places to round to. 2 is standard for most currencies "
"($19.99). 0 for whole numbers ($20). Some currencies like Japanese Yen "
"typically use 0 decimal places."
msgstr "Adja meg, hány tizedesjegyre történjen a kerekítés. A legtöbb pénznem esetén a 2 a szokásos (19,99 $). A 0 egész számokra kerekít (20 $). Egyes pénznemek, például a japán jen, jellemzően 0 tizedesjegyet használnak."

#: includes/settings/wcj-settings-multicurrency.php:118
msgid "Decimal Places"
msgstr "Tizedesjegyek száma"

#: includes/settings/wcj-settings-multicurrency.php:121
msgid "Currency Switcher Template"
msgstr "Pénznemváltó-sablon"

#: includes/settings/wcj-settings-multicurrency.php:122
msgid "Set how you want currency switcher to be displayed on frontend."
msgstr "Állítsa be, hogyan jelenjen meg a pénznemváltó a webáruház felületén."

#: includes/settings/wcj-settings-multicurrency.php:128
#, php-format
msgid ""
"Customize how currencies appear in the switcher. Use %1$currency_name% for "
"\"US Dollar\", %2$currency_symbol% for \"$\", %3$currency_code% for \"USD\"."
" Common formats: \"USD ($)\" or \"$ US Dollar\". Keep it short and "
"recognizable."
msgstr "Testreszabhatja, hogyan jelenjenek meg a pénznemek a váltóban. Az „US Dollar” megjelenítéséhez használja a %1$currency_name% helyőrzőt, a „$” megjelenítéséhez a %2$currency_symbol% helyőrzőt, az „USD” megjelenítéséhez pedig a %3$currency_code% helyőrzőt. Gyakori formátumok: „USD ($)” vagy „$ US Dollar”. A szöveg legyen rövid és könnyen felismerhető."

