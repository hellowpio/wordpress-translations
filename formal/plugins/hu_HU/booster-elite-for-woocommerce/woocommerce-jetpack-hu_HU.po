msgid "Rounding"
msgstr "Kerekítés"

#: includes/settings/wcj-settings-multicurrency.php:98
msgid "If using exchange rates, choose rounding here."
msgstr "Ha árfolyamokat használ, itt válassza ki a kerekítést."

#: includes/settings/wcj-settings-multicurrency.php:103
#: includes/settings/wcj-settings-price-by-country.php:120
#: includes/shipping/class-wc-shipping-wcj-custom-with-shipping-zones.php:305
msgid "No rounding"
msgstr "Nincs kerekítés"

