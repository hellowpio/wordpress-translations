msgstr "Mezőbeállítások"

#: includes/settings/wcj-settings-checkout-core-fields.php:40
msgid "Override Default Address Fields"
msgstr "Alapértelmezett címmezők felülbírálása"

#: includes/settings/wcj-settings-checkout-core-fields.php:45
#: includes/settings/wcj-settings-checkout-core-fields.php:56
msgid "Override with billing fields"
msgstr "Felülbírálás számlázási mezőkkel"

#: includes/settings/wcj-settings-checkout-core-fields.php:46
#: includes/settings/wcj-settings-checkout-core-fields.php:57
msgid "Override with shipping fields"
msgstr "Felülbírálás szállítási mezőkkel"

#: includes/settings/wcj-settings-checkout-core-fields.php:47
#: includes/settings/wcj-settings-checkout-core-fields.php:58
msgid "Do not override"
msgstr "Nincs felülbírálás"

#: includes/settings/wcj-settings-checkout-core-fields.php:51
msgid "Override Country Locale Fields"
msgstr "Az ország területi beállításaihoz tartozó mezők felülbírálása"

#: includes/settings/wcj-settings-checkout-core-fields.php:62
msgid "Force Fields Sort by Priority"
msgstr "Mezők prioritás szerinti rendezésének kényszerítése"

#: includes/settings/wcj-settings-checkout-core-fields.php:64
msgid ""
"Enable this if you are having theme related issues with \"priority (i.e. "
"order)\" options."
msgstr "Kapcsolja be ezt a beállítást, ha a sablonnal kapcsolatos problémákat tapasztal a „prioritás (azaz sorrend)” opciókkal."

#: includes/settings/wcj-settings-checkout-core-fields.php:70
msgid "Checking Relation"
msgstr "Feltételek kapcsolata"

#: includes/settings/wcj-settings-checkout-core-fields.php:71
msgid ""
"Use <code>Or</code> if you need that at least one condition is valid. e.g.: "
"At least one product from a specific category is in cart. Use "
"<code>All</code> if you need that all conditions are valid."
msgstr "A <code>VAGY</code> értéket akkor használja, ha legalább egy feltételnek kell teljesülnie. Például: legalább egy adott kategóriába tartozó termék van a kosárban. Az <code>összes</code> értéket akkor használja, ha minden feltételnek teljesülnie kell."

#: includes/settings/wcj-settings-checkout-core-fields.php:75
msgid "And"
msgstr "És"

#: includes/settings/wcj-settings-checkout-core-fields.php:76
msgid "Or"
msgstr "Vagy"

