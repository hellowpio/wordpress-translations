#: includes/settings/wcj-settings-price-by-country.php:123
#: includes/settings/wcj-settings-product-price-by-formula.php:125
#: includes/shipping/class-wc-shipping-wcj-custom-with-shipping-zones.php:307
msgid "Round up"
msgstr "Felfelé kerekítés"

