msgstr "A mezők után"

#: includes/settings/wcj-settings-checkout-custom-fields.php:73
msgid "Add All Fields to \"Order Received\" (i.e. \"Thank You\") and \"View Order\" Pages"
msgstr "Minden mező hozzáadása a „Megrendelés fogadva” (azaz „Köszönjük”) és a „Megrendelés megtekintése” oldalakhoz"

#: includes/settings/wcj-settings-checkout-custom-fields.php:80
msgid "\"Order Received\" Fields Template"
msgstr "A „Megrendelés fogadva” mezők sablonja"

#: includes/settings/wcj-settings-checkout-custom-fields.php:99
msgid "Textarea Field Values"
msgstr "Szövegmező értékei"

#: includes/settings/wcj-settings-checkout-custom-fields.php:100
msgid "When saving, \"clean\" textarea field values"
msgstr "Mentéskor a szövegmező értékeinek „tisztítása”"

#: includes/settings/wcj-settings-checkout-custom-fields.php:106
msgid "Textarea Line Breaks"
msgstr "Szövegmező sortörései"

#. translators: %s: translators Added
#: includes/settings/wcj-settings-checkout-custom-fields.php:108
