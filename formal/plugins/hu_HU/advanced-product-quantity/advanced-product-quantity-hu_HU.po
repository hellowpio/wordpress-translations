#: class-afadv-adv-qnt-class.php:127
msgid ""
"The minimum quantity required to proceed the cart is [min-cart-qty]. Add "
"[add-cart-qty] more items in cart."
msgstr "A kosárban való továbblépéshez szükséges minimális mennyiség: [min-cart-qty]. Adjon még [add-cart-qty] tételt a kosárhoz."

#: class-afadv-adv-qnt-class.php:128
msgid ""
"The total quantity of cart should not exceed [max-cart-qty] . Remove [rem-"
"cart-qty] items from cart to place order."
msgstr ""
"A kosár teljes mennyisége nem haladhatja meg a(z) [max-cart-qty] . "
"Távolítson el [rem-cart-qty] tételt a kosárból a rendelés leadásához."

#: class-afadv-adv-qnt-class.php:129
msgid ""
"Your cart quantity should be the multiple of [cart-mul-num]. [cart-qty] "
"quantity is not allowed."
msgstr ""
"A kosárban lévő mennyiségnek [cart-mul-num] többszörösének kell lennie. A "
"[cart-qty] mennyiség nem engedélyezett."

#: class-afadv-adv-qnt-class.php:130
msgid "The minimum amount required to proceed the cart is [min-cart-amnt]."
msgstr "A kosár folytatásához szükséges minimális összeg: [min-cart-amnt]."

#: class-afadv-adv-qnt-class.php:131
msgid ""
"You are not allowed to place an order of more than [max-cart-amnt] amount."
msgstr "Nem adhat le [max-cart-amnt] összegnél nagyobb rendelést."

