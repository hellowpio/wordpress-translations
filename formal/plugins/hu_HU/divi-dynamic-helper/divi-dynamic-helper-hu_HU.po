#: App/Setup/Settings_Manager.php:168 App/Setup/Settings_Manager.php:171
msgid "ACF Options Pages"
msgstr "ACF opciós oldalak"

#. Description of the plugin/theme
msgid ""
"Enable the missing Divi dynamic content features for adding data from custom"
" fields in the Video, Audio, Gallery, Map, Code, Number Counter, Circle "
"Counter, and Bar Counter modules, add dynamic content to color pickers, and "
"add Divi Library layouts to any textarea with dynamic content."
msgstr "Kapcsolja be a hiányzó Divi dinamikus tartalomfunkciókat, hogy egyéni mezőkből származó adatokat adjon hozzá a videó-, hang-, galéria-, térkép-, kód-, darabszámláló-, körszámláló- és sávszámláló modulokhoz, dinamikus tartalmat adjon a színválasztókhoz, és Divi-könyvtári elrendezéseket adjon hozzá bármely dinamikus tartalmat kezelő szövegmezőhöz."

