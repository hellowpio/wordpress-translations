msgstr "Nincs"

#: d4/includes/classes/column/fields/fields-hover-settings.php:10
msgid "Grow"
msgstr "Nagyítás"

#: d4/includes/classes/column/fields/fields-hover-settings.php:11
msgid "Shrink"
msgstr "Kicsinyítés"

#: d4/includes/classes/column/fields/fields-hover-settings.php:12
msgid "Bounce"
msgstr "Pattogás"

#: d4/includes/classes/column/fields/fields-hover-settings.php:13
msgid "Pulse"
msgstr "Pulzálás"

#: d4/includes/classes/column/fields/fields-hover-settings.php:14
msgid "Bob"
msgstr "Hintázás"

#: d4/includes/classes/column/fields/fields-hover-settings.php:15
msgid "Push Up"
msgstr "Felfelé tolás"

#: d4/includes/classes/column/fields/fields-hover-settings.php:16
msgid "Push Down"
msgstr "Lefelé tolás"

#: d4/includes/classes/column/fields/fields-hover-settings.php:17
