#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-atarim-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-atarim-extension.php
msgid ""
"The Atarim Extension for MainWP expands your ability to collaborate with "
"your clients through your MainWP Dashboard. Get a complete overview of tasks"
" that have been created inside your websites using Atarim to keep track of "
"all your client requests!"
msgstr "A MainWP-hez készült Atarim-kiterjesztés kibővíti az ügyfeleivel való együttműködés lehetőségeit a MainWP vezérlőpultján keresztül. Teljes áttekintést kaphat az Atarim segítségével webhelyein létrehozott feladatokról, így nyomon követheti az összes ügyfélkérést!"

