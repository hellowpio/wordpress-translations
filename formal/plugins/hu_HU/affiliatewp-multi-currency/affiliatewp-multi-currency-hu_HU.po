#. Plugin Name of the plugin
#: affiliatewp-multi-currency.php
msgid "AffiliateWP - Multi-Currency"
msgstr "AffiliateWP - Multi-Currency"

#. Plugin URI of the plugin
#: affiliatewp-multi-currency.php
msgid "https://affiliatewp.com/addons/multi-currency/"
msgstr "https://affiliatewp.com/addons/multi-currency/"

#. Description of the plugin
#: affiliatewp-multi-currency.php
msgid ""
"Enhance AffiliateWP with comprehensive multi-currency support, enabling "
"real-time exchange rates and commission conversion."
msgstr "Bővítse az AffiliateWP-t átfogó, több pénznemet támogató funkciókkal, valós idejű árfolyamokkal és a jutalékok átváltásával."

#. Author of the plugin
#: affiliatewp-multi-currency.php
msgid "AffiliateWP"
msgstr "AffiliateWP"

#. Author URI of the plugin
#: affiliatewp-multi-currency.php
msgid "https://affiliatewp.com/"
msgstr "https://affiliatewp.com/"

#: affiliatewp-multi-currency.php:151
msgid "AffiliateWP - Multi-Currency Requirements"
msgstr "AffiliateWP – Több pénznem használatának követelményei"

#: includes/admin/class-admin.php:132
msgid "(unsupported)"
msgstr "(nem támogatott)"

#: includes/admin/class-admin.php:278
msgid "Error fetching currencies. Please reload the page and try again."
msgstr ""
"Hiba a pénznemek lekérésekor. Kérjük, töltse újra az oldalt, és próbálja meg"
" újra."

#: includes/admin/class-admin.php:291
msgid "Error fetching exchange rates. Please try again."
msgstr "Hiba az árfolyamok lekérésekor. Kérjük, próbálja meg újra."

#: includes/class-events.php:133
msgid ""
"Unexpected error encountered while attempting to fetch data from the API "
"service."
msgstr ""
"Váratlan hiba történt az API-szolgáltatásból történő adatlekérés során."

#: includes/class-multi-currency.php:140 includes/class-multi-currency.php:150
msgid "Cheatin&#8217; huh?"
msgstr "Csalni próbálsz, mi?"

#: includes/provider/class-exchange-rate-api.php:131
msgid "Not connected."
msgstr "Nincs csatlakozva."

#. translators: 1: The latest updated date.
#: includes/provider/class-exchange-rate-api.php:139
msgid "Rates last updated: %s"
msgstr "Az árfolyamok utolsó frissítése: %s"

#: includes/provider/class-exchange-rate-api.php:143
msgid "Last update failed, using data from: %s"
msgstr "Az utolsó frissítés nem sikerült, az adatok innen származnak: %s"

#: includes/provider/class-exchange-rate-api.php:154
msgid "Enter your %s key and connect."
msgstr "Adja meg a(z) %s kulcsát, és csatlakozzon."

#: includes/provider/class-exchange-rate-api.php:174
msgid ""
"Your AffiliateWP currency is not supported by this API at the moment. Please"
" go to Advanced settings and review your currency before using this API."
msgstr ""
"Az AffiliateWP pénznemét jelenleg nem támogatja ez az API. Kérjük, lépjen a "
"Haladó beállításokhoz, és ellenőrizze a pénznemét, mielőtt ezt az API-t "
"használná."

#: includes/provider/class-exchange-rate-api.php:178
msgid ""
"There was an issue with your request. Please reload the page and try again."
msgstr ""
"Probléma merült fel a kérésével kapcsolatban. Kérjük, töltse újra az oldalt,"
" és próbálja meg újra."

#: includes/provider/class-exchange-rate-api.php:182
msgid "The API key provided is invalid. Please verify your key and try again."
msgstr ""
"A megadott API-kulcs érvénytelen. Kérjük, ellenőrizze a kulcsot, és próbálja"
" meg újra."

#: includes/provider/class-exchange-rate-api.php:186
msgid ""
"There seems to be an issue with your ExchangeRate-API account or key. Please"
" check your account status or API key."
msgstr ""
"Úgy tűnik, probléma van az ExchangeRate-API-fiókjával vagy az API-kulcsával."
" Kérjük, ellenőrizze a fiókja állapotát vagy az API-kulcsát."

#: includes/provider/class-exchange-rate-api.php:190
msgid ""
"Request limit reached. Please wait for a reset or upgrade your ExchangeRate-"
"API plan."
msgstr ""
"Elérte a lekérdezési korlátot. Kérjük, várja meg, amíg a keret alaphelyzetbe"
" áll, vagy frissítse az ExchangeRate-API-csomagját."

#: includes/provider/class-exchange-rate-api.php:193
msgid "An unknown error occurred. Please reload your page and try again."
msgstr ""
"Ismeretlen hiba történt. Kérjük, töltse újra az oldalt, és próbálja meg "
"újra."

