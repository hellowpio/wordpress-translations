msgstr "Videó időtartama"

#: classes/class-wpseo-video-metabox.php:72
msgid "Overwrite the video duration, or enter one if it's empty."
msgstr "Írja felül a videó időtartamát, vagy adjon meg egy értéket, ha üres."

#: classes/class-wpseo-video-metabox.php:74
msgid "Tags"
msgstr "Címkék"

#: classes/class-wpseo-video-metabox.php:75
msgid "Add extra tags for this video"
msgstr "Adjon hozzá további címkéket ehhez a videóhoz"

#: classes/class-wpseo-video-metabox.php:77
msgid "Rating"
msgstr "Értékelés"

#: classes/class-wpseo-video-metabox.php:78
