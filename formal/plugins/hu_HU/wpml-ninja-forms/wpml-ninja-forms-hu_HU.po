#. Plugin Name of the plugin
#: plugin.php
msgid "Ninja Forms Multilingual"
msgstr "Ninja Forms Multilingual"

#. Plugin URI of the plugin
#: plugin.php
msgid ""
"https://wpml.org/documentation/wpml-core-and-add-on-plugins/ninja-forms-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=ninjaforms"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/ninja-forms-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=ninjaforms"

#. Description of the plugin
#: plugin.php
msgid ""
"Add multilingual support for Ninja Forms | <a "
"href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/ninja-"
"forms-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=ninjaforms\">Documentation</a>"
msgstr "Többnyelvű támogatás hozzáadása a Ninja Forms bővítményhez | <a href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/ninja-forms-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=ninjaforms\">dokumentáció</a>"

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: %s: path to file
#: vendor/wpml/forms/classes/Translation/Config.php:54
#, php-format
msgid "WPML Forms config file does not exist: %s"
msgstr "A WPML Forms konfigurációs fájl nem létezik: %s"

#. translators: %s: path to file
#: vendor/wpml/forms/classes/Translation/Config.php:62
#, php-format
msgid "WPML Forms cannot parse config file: %s"
msgstr "A WPML Forms nem tudja feldolgozni a konfigurációs fájlt: %s"

#. translators: The placeholders are replaced by an HTML link pointing to the
#. String translation add-on FAQ article.
#: vendor/wpml/forms/classes/UI/Notices.php:21
#, php-format
msgid ""
"WPML Forms: Please activate the WPML CMS Plugin and the %1$sString "
"Translation add-on%2$s"
msgstr "WPML Forms: Kérjük, kapcsolja be a WPML CMS bővítményt és a %1$sString Translation kiegészítőt%2$s"

#: vendor/wpml/forms/templates/welcome.php:6
msgid ""
"Your website's forms were automatically detected and added to WPML > "
"Translation Management."
msgstr "A rendszer automatikusan felismerte a webhely űrlapjait, és hozzáadta őket a WPML > Fordításkezeléshez."

#: vendor/wpml/forms/templates/welcome.php:7
msgid ""
"You can send them to your local translators, use one of our partner "
"translation services, or use automatic machine translation via the Advanced "
"Translation Editor."
msgstr "Elküldheti őket a helyi fordítóknak, igénybe veheti valamelyik partnerünk fordítási szolgáltatását, vagy automatikus gépi fordítást használhat a haladó fordítószerkesztőn keresztül."

#. translators: Error notice in the WordPress admin, shown when WPML is
#. missing or too old for this plugin to do anything. "WPML Ninja Forms" is
#. the name of this plugin and stays in English; "It" is the plugin.
#: classes/Requirements.php:11
msgid ""
"WPML Ninja Forms is enabled but not effective. It requires a valid WPML "
"version activated in order to work."
msgstr "A WPML Ninja Forms be van kapcsolva, de nem működik. A működéséhez egy érvényes, bekapcsolt WPML-verzióra van szükség."

