"Use partial operations for local edits and large pages. Full replacement "
"remains available for intentional small-document resets and initial "
"assembly."
msgstr "Helyi szerkesztésekhez és nagy oldalakhoz használjon részleges műveleteket. A teljes csere továbbra is elérhető a kis dokumentumok szándékos alaphelyzetbe állításához és a kezdeti összeállításhoz."

#: assets/build/admin-dashboard.js:4
#, js-format
msgid ""
"Operation limit: %1$s bytes. Node batch limit: %2$s. Inline node styles: "
"%3$s."
msgstr "Műveleti korlát: %1$s bájt. Csomópontköteg-korlát: %2$s. Beágyazott csomópontstílusok: %3$s."

#: assets/build/admin-dashboard.js:4
msgid "not reported"
msgstr "nincs jelentve"

#: assets/build/admin-dashboard.js:4
msgid "accepted"
msgstr "elfogadva"

#: assets/build/admin-dashboard.js:4
msgid "rejected; use the separate styles map"
msgstr "elutasítva; használja a különálló stílustérképet"

#: assets/build/admin-dashboard.js:4
msgid "Media management safety"
msgstr "Médiakezelés biztonsága"

#: assets/build/admin-dashboard.js:4
