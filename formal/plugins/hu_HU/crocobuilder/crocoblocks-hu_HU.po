msgstr[0] "%d bejegyzésdomén"
msgstr[1] "%d bejegyzésdomén"

#: assets/build/admin-versioning.js:9
#, js-format
msgid "%d document domain"
msgid_plural "%d document domains"
msgstr[0] "%d dokumentumdomén"
msgstr[1] "%d dokumentumdomén"

#: assets/build/admin-versioning.js:9
#, js-format
msgid "%d global domain"
msgid_plural "%d global domains"
msgstr[0] "%d globális domén"
msgstr[1] "%d globális domén"

#: assets/build/admin-versioning.js:9
msgid "added"
msgstr "hozzáadva"

#: assets/build/admin-versioning.js:9
msgid "modified"
msgstr "módosított"

#: assets/build/admin-versioning.js:9
msgid "removed"
msgstr "eltávolított"

#: assets/build/admin-versioning.js:9
msgid "Workspace Changes"
msgstr "Munkaterület módosításai"

#: assets/build/admin-versioning.js:9
msgid "Discard changes"
msgstr "Módosítások elvetése"

#: assets/build/admin-versioning.js:9
msgid "Hide details -"
msgstr "Részletek elrejtése -"

#: assets/build/admin-versioning.js:9
msgid "Worktree status:"
msgstr "Munkafa állapota:"

#: assets/build/admin-versioning.js:9
msgid "Worktree SHA:"
msgstr "Munkafa SHA-azonosítója:"

#: assets/build/admin-versioning.js:9
msgid "Base SHA:"
msgstr "Alap SHA-azonosító:"

#: assets/build/admin-versioning.js:9
msgid "Last commit:"
msgstr "Utolsó véglegesítés:"

#: assets/build/admin-versioning.js:9
msgid "Last commit at:"
msgstr "Utolsó véglegesítés időpontja:"

#: assets/build/admin-versioning.js:9
msgid ""
"Pull the current branch into workspace, or save tracked builder data in DB-"
"first mode to initialize the worktree mirror automatically."
msgstr "Kérje le az aktuális ágat a munkaterületre, vagy DB-first módban mentse az adatbázisba a nyomon követett Builder-adatokat a munkafa-tükör automatikus inicializálásához."

#: assets/build/admin-versioning.js:9 assets/build/admin-versioning.js:10
msgid "Pull latest"
msgstr "Legújabb lekérése"

#: assets/build/admin-versioning.js:9
msgid "The workspace diff was refreshed before commit and is now clean."
msgstr "A munkaterület diffje frissült a véglegesítés előtt, és most már tiszta."

#: assets/build/admin-versioning.js:9
msgid "Connection service upgrade required."
msgstr "A kapcsolati szolgáltatás frissítése szükséges."

#: assets/build/admin-versioning.js:9
msgid ""
"Automatic portable repository selection is not available yet. Upgrade the "
"connection service, then retry; no repository data was changed."
msgstr "A hordozható tárház automatikus kiválasztása még nem érhető el. Frissítse a kapcsolati szolgáltatást, majd próbálja újra; a tárház adatai nem változtak."

#: assets/build/admin-versioning.js:9
msgid "Repository is not a compatible Builder workspace."
msgstr "A tárház nem kompatibilis a Builder munkaterülettel."

#: assets/build/admin-versioning.js:9
msgid ""
"The managed Builder root is missing, malformed, unsafe, unsupported, or "
"exceeds a configured limit. Select another repository or repair the "
"workspace before retrying."
msgstr "A felügyelt Builder-gyökér hiányzik, hibás formátumú, nem biztonságos, nem támogatott vagy túllépi a beállított korlátot. Válasszon másik tárházat, vagy javítsa ki a munkaterületet, mielőtt újra próbálkozik."

#: assets/build/admin-versioning.js:9
msgid "Choose another repository"
msgstr "Másik tárház kiválasztása"

#: assets/build/admin-versioning.js:9
msgid "Branch updated remotely."
msgstr "Az ág távolról frissült."

#: assets/build/admin-versioning.js:9
msgid ""
"The selected branch changed during the guarded operation. Refresh "
"authoritative state, then retry."
msgstr "A kiválasztott ág megváltozott a védett művelet során. Töltse be a hiteles állapotot, majd próbálja újra."

#: assets/build/admin-versioning.js:9
msgid "Branch is protected."
msgstr "Az ág védett."

#: assets/build/admin-versioning.js:9
msgid "This branch is protected and cannot be reset from WordPress."
msgstr "Ez az ág védett, és WordPressből nem állítható alaphelyzetbe."

#: assets/build/admin-versioning.js:9
msgid "Local worktree refresh failed."
msgstr "A helyi munkafa frissítése sikertelen."

#: assets/build/admin-versioning.js:9
msgid ""
"The branch may already be reset remotely, but the local worktree could not "
"be refreshed. Pull or refresh the branch and try again."
msgstr "Lehetséges, hogy az ág távolról már alaphelyzetbe állt, de a helyi munkafát nem sikerült frissíteni. Kérje le vagy frissítse az ágat, majd próbálja újra."

#: assets/build/admin-versioning.js:9
msgid "Commit cannot be reset from this branch."
msgstr "A véglegesítés nem állítható alaphelyzetbe erről az ágról."

#: assets/build/admin-versioning.js:9
msgid ""
"The selected commit is unavailable from the active branch. Refresh commit "
"history and choose an available commit."
msgstr "A kiválasztott véglegesítés nem érhető el az aktív ágról. Frissítse a véglegesítések előzményeit, és válasszon egy elérhető véglegesítést."

#: assets/build/admin-versioning.js:9 assets/build/admin-versioning.js:19
msgid "Refresh commit history"
msgstr "Véglegesítések előzményeinek frissítése"

#: assets/build/admin-versioning.js:9
msgid "Refresh commit history and choose a valid commit."
msgstr "Frissítse a véglegesítések előzményeit, és válasszon érvényes véglegesítést."

#: assets/build/admin-versioning.js:9
msgid "Review the reset details and confirm the operation before retrying."
msgstr "Tekintse át az alaphelyzetbe állítás részleteit, és a művelet újbóli megkísérlése előtt erősítse meg azt."

#: assets/build/admin-versioning.js:9
msgid "Discard confirmation is required."
msgstr "Az elvetés megerősítése kötelező."

#: assets/build/admin-versioning.js:9
msgid ""
"The worktree contains local changes. Review them before explicitly "
"confirming discard."
msgstr "A munkafa helyi módosításokat tartalmaz. Tekintse át ezeket, mielőtt kifejezetten megerősíti az elvetésüket."

#: assets/build/admin-versioning.js:9
msgid "Workspace state is out of sync."
msgstr "A munkaterület állapota nincs szinkronban."

#: assets/build/admin-versioning.js:9
msgid "Pull the latest branch into workspace and retry the commit."
msgstr "Kérje le az ág legújabb állapotát a munkaterületre, majd próbálja újra a véglegesítést."

#: assets/build/admin-versioning.js:9
msgid "Repository is not initialized for builder versioning."
msgstr "A tárház nincs inicializálva a Builder verziókezeléséhez."

#: assets/build/admin-versioning.js:9
msgid ""
"Create a guarded commit from current WordPress Builder data to replace only "
"the managed Builder root."
msgstr "Hozzon létre védett véglegesítést az aktuális WordPress Builder-adatokból, amely csak a felügyelt Builder-gyökeret cseréli le."

#: assets/build/admin-versioning.js:9 assets/build/admin-versioning.js:10
msgid "Initialize repository"
msgstr "Tárház inicializálása"

#: assets/build/admin-versioning.js:9
msgid "Repository migration required."
msgstr "A tárház áttelepítése szükséges."

#: assets/build/admin-versioning.js:10
#, js-format
msgid ""
"This repository uses schema version %d. Reinitialize the repository to "
"continue with schema v2."
msgstr "A tárház által használt sémaverzió: %d. Inicializálja újra a tárházat a v2 séma használatának folytatásához."

#: assets/build/admin-versioning.js:10
msgid ""
"This repository uses an unsupported schema version. Reinitialize the "
"repository to continue with schema v2."
msgstr "Ez a tárház nem támogatott sémaverziót használ. Inicializálja újra a tárházat a v2 séma használatának folytatásához."

#: assets/build/admin-versioning.js:10
msgid "Load the authoritative branch snapshot before retrying this action."
msgstr "Az újbóli próbálkozás előtt töltse be az ág hiteles pillanatképét."

#: assets/build/admin-versioning.js:10
msgid "Selected worktree changed before deploy."
msgstr "A kiválasztott munkafa megváltozott a közzététel előtt."

#: assets/build/admin-versioning.js:10
msgid ""
"Refresh deploy status and confirm the current local worktree before "
"retrying."
msgstr "Frissítse a közzététel állapotát, és ellenőrizze az aktuális helyi munkafát, mielőtt újra próbálkozik."

#: assets/build/admin-versioning.js:10
msgid "Live WordPress data changed before publishing."
msgstr "A közzététel előtt megváltoztak az élő WordPress-adatok."

#: assets/build/admin-versioning.js:10
msgid ""
"Refresh publication status and review the updated impact summary before "
"trying again."
msgstr "Frissítse a közzététel állapotát, és tekintse át a frissített hatásösszefoglalót, mielőtt újra próbálkozik."

#: assets/build/admin-versioning.js:10
msgid "Live site is already up to date."
msgstr "Az élő webhely már naprakész."

#: assets/build/admin-versioning.js:10
msgid ""
"Publishing this selected local worktree would not change WordPress Builder "
"storage."
msgstr "A kiválasztott helyi munkafa közzététele nem módosítaná a WordPress Builder-tárolóját."

#: assets/build/admin-versioning.js:10
msgid "Publishing did not start."
msgstr "A közzététel nem indult el."

#: assets/build/admin-versioning.js:10
msgid ""
"A recovery backup could not be stored, so live WordPress data was not "
"changed."
msgstr "Nem sikerült menteni a helyreállítási biztonsági másolatot, ezért az élő WordPress-adatok nem változtak."

#: assets/build/admin-versioning.js:10
msgid "Publishing failed and WordPress was restored."
msgstr "A közzététel sikertelen volt, és a WordPress állapota helyreállt."

#: assets/build/admin-versioning.js:10
msgid ""
"The live Builder update could not finish. The recovery backup was restored; "
"review the workspace and retry when ready."
msgstr "Az élő Builder frissítése nem fejeződött be. A helyreállítási biztonsági másolat vissza lett állítva; tekintse át a munkaterületet, és próbálja újra, amikor készen áll."

#: assets/build/admin-versioning.js:10
msgid "Live WordPress data may be partially changed."
msgstr "Az élő WordPress-adatok részben megváltozhattak."

#: assets/build/admin-versioning.js:10
msgid ""
"Publishing and automatic restoration both failed. An authorized "
"administrator should inspect the retained recovery backup and server log "
"before retrying."
msgstr "A közzététel és az automatikus helyreállítás is sikertelen volt. Újrapróbálkozás előtt egy jogosult adminisztrátornak ellenőriznie kell a megőrzött helyreállítási biztonsági másolatot és a szervernaplót."

#: assets/build/admin-versioning.js:10
msgid "WordPress was updated, but publishing could not be finalized."
msgstr "A WordPress frissült, de a közzétételt nem sikerült véglegesíteni."

#: assets/build/admin-versioning.js:10
msgid ""
"Recovery material was retained because publication records or workspace "
"state could not be saved. Refresh and ask an authorized administrator to "
"review the server log before retrying."
msgstr "A helyreállítási anyag megmaradt, mert nem sikerült menteni a közzétételi bejegyzéseket vagy a munkaterület állapotát. Frissítsen, és az újbóli próbálkozás előtt kérje meg egy jogosult adminisztrátort a szervernapló áttekintésére."

#: assets/build/admin-versioning.js:10
msgid "Publishing is blocked by a class identity conflict."
msgstr "A közzétételt egy osztályazonosító-ütközés akadályozza."

#: assets/build/admin-versioning.js:10
msgid ""
"A global class ID and name resolve to different live records. Reconcile the "
"class definitions before publishing."
msgstr "Egy globális osztály ID-ja és neve különböző élő rekordokra mutat. A közzététel előtt egyeztesse az osztálydefiníciókat."

#: assets/build/admin-versioning.js:10
msgid "Worktree replacement requires confirmation."
msgstr "A munkafa cseréjéhez megerősítés szükséges."

#: assets/build/admin-versioning.js:10
msgid "Review the local-worktree replacement warning and confirm it again."
msgstr "Tekintse át a helyi munkafa cseréjére vonatkozó figyelmeztetést, majd erősítse meg ismét."

#: assets/build/admin-versioning.js:10
msgid "Local worktree refresh could not be finalized."
msgstr "A helyi munkafa frissítését nem sikerült véglegesíteni."

#: assets/build/admin-versioning.js:10
msgid ""
"Live WordPress and GitHub data were not changed. Refresh authoritative "
"status before retrying or replacing more local changes."
msgstr "Az élő WordPress- és GitHub-adatok nem változtak. Az újbóli próbálkozás vagy további helyi módosítások lecserélése előtt frissítse a hiteles állapotot."

#: assets/build/admin-versioning.js:10
msgid "No workspace changes to commit."
msgstr "Nincs véglegesítendő módosítás a munkaterületen."

#: assets/build/admin-versioning.js:10
msgid ""
"The refreshed workspace is clean. Refresh status or pull the selected branch"
" if you expected changes."
msgstr "A frissített munkaterület tiszta. Frissítse az állapotot, vagy kérje le a kiválasztott ágat, ha módosításokra számított."

#: assets/build/admin-versioning.js:10
msgid "Connection service rate limit reached."
msgstr "Elérte a kapcsolódási szolgáltatás használati korlátját."

#: assets/build/admin-versioning.js:10
msgid "Connection service timed out."
msgstr "A kapcsolódási szolgáltatás időtúllépés miatt nem válaszolt."

#: assets/build/admin-versioning.js:10
msgid ""
"The remote service could not complete the action safely. Wait a moment and "
"retry; existing connection state is unchanged."
msgstr "A távoli szolgáltatás nem tudta biztonságosan végrehajtani a műveletet. Várjon egy kicsit, majd próbálja újra; a meglévő kapcsolódási állapot változatlan marad."

#: assets/build/admin-versioning.js:10
msgid "GitHub repository could not be inspected."
msgstr "A GitHub-adattár vizsgálata sikertelen."

#: assets/build/admin-versioning.js:10
msgid ""
"The repository could not be classified safely. Retry the selection; no "
"repository or connection state was changed."
msgstr "Az adattár biztonságos besorolása nem sikerült. Próbálja újra a kiválasztást; az adattár és a kapcsolódási állapot nem változott."

#: assets/build/admin-versioning.js:10
msgid "Retry selection"
msgstr "Kiválasztás újrapróbálása"

#: assets/build/admin-versioning.js:10
msgid "Connection service is unavailable."
msgstr "A kapcsolódási szolgáltatás nem érhető el."

#: assets/build/admin-versioning.js:10
msgid ""
"The service could not be reached or returned an invalid response. Retry "
"later; existing or pending connection state is preserved."
msgstr "A szolgáltatás nem érhető el, vagy hibás választ adott. Próbálja újra később; a meglévő vagy függőben lévő kapcsolódási állapot megmarad."

#: assets/build/admin-versioning.js:10
msgid "GitHub installation cannot access this repository."
msgstr "A GitHub-telepítés nem fér hozzá ehhez az adattárhoz."

#: assets/build/admin-versioning.js:10
msgid ""
"The repository was removed, disabled, archived, or is no longer available to"
" the authorized installation. Update installation access, then retry."
msgstr "Az adattárat eltávolították, kikapcsolták, archiválták, vagy a jogosult telepítés már nem fér hozzá. Frissítse a telepítés hozzáférési beállításait, majd próbálja újra."

#: assets/build/admin-versioning.js:10
msgid "GitHub authorization must be restarted."
msgstr "Újra kell indítani a GitHub-hitelesítést."

#: assets/build/admin-versioning.js:10
msgid ""
"The authorization was denied, expired, invalid, or superseded. Start a new "
"authorization flow."
msgstr "A hitelesítést elutasították, lejárt, hibás, vagy egy újabb hitelesítés felülírta. Indítson új hitelesítési folyamatot."

#: assets/build/admin-versioning.js:10
msgid "Too many repositories are available to this installation."
msgstr "Túl sok adattár érhető el ehhez a telepítéshez."

#: assets/build/admin-versioning.js:10
msgid ""
"Reduce the GitHub App installation repository access, then reload the list."
msgstr "Korlátozza, hogy a GitHub App telepítése mely adattárakhoz férjen hozzá, majd töltse újra a listát."

#: assets/build/admin-versioning.js:10
msgid "Local workspace migration could not be completed."
msgstr "A helyi munkaterület áttelepítése nem fejeződött be."

#: assets/build/admin-versioning.js:10
msgid ""
"The private workspace copy could not be staged, verified, or activated. "
"Retry; the legacy worktree remains available and should not be discarded."
msgstr "A munkaterület privát másolatát nem sikerült előkészíteni, ellenőrizni vagy aktiválni. Próbálja újra; a régi munkafa továbbra is elérhető, ezért ne vesse el."

#: assets/build/admin-versioning.js:10
msgid "Retry migration"
msgstr "Áttelepítés újrapróbálása"

#: assets/build/admin-versioning.js:10
msgid "Candidate workspace preparation failed."
msgstr "A jelölt munkaterület előkészítése sikertelen."

#: assets/build/admin-versioning.js:10
msgid ""
"The repository snapshot could not be prepared locally. Retry; the active "
"connection and repository were not replaced."
msgstr "Az adattár helyi pillanatképét nem sikerült előkészíteni. Próbálja újra; az aktív kapcsolat és az adattár nem változott."

#: assets/build/admin-versioning.js:10
msgid "Connection activation is still being verified."
msgstr "A kapcsolat aktiválásának ellenőrzése még folyamatban van."

#: assets/build/admin-versioning.js:10
msgid ""
"The activation response was indeterminate. Refresh to reconcile status; do "
"not reconnect or discard the pending workspace."
msgstr "Az aktiválási válasz nem volt egyértelmű. Frissítse az állapotot az egyeztetéshez; ne csatlakozzon újra, és ne törölje a függőben lévő munkaterületet."

#: assets/build/admin-versioning.js:10
msgid "Check activation status"
msgstr "Aktiválási állapot ellenőrzése"

#: assets/build/admin-versioning.js:10
msgid "Repository connection was not activated."
msgstr "Az adattárkapcsolat nem aktiválódott."

#: assets/build/admin-versioning.js:10
msgid ""
"The candidate was proven inactive and the previous connection was restored. "
"Select the repository again when ready."
msgstr "A rendszer megállapította, hogy a jelölt inaktív, és visszaállította az előző kapcsolatot. Ha készen áll, válassza ki újra az adattárat."

#: assets/build/admin-versioning.js:10
msgid "Choose a valid Git branch name and retry."
msgstr "Válasszon érvényes Git-ágnevet, majd próbálja újra."

#: assets/build/admin-versioning.js:10
msgid "Branch already exists."
msgstr "Az ág már létezik."

#: assets/build/admin-versioning.js:10
msgid "Choose a different branch name or switch to the existing branch."
msgstr "Válasszon másik ágnevet, vagy váltson a már meglévő ágra."

#: assets/build/admin-versioning.js:10
msgid "Workspace changes must be committed first."
msgstr "Először véglegesítse a munkaterület módosításait."

#: assets/build/admin-versioning.js:10
msgid ""
"Commit local changes, or use an existing explicitly confirmed discard flow, "
"before retrying."
msgstr "Véglegesítse a helyi módosításokat, vagy használja a meglévő, kifejezetten jóváhagyott elvetési folyamatot, mielőtt újra próbálkozik."

#: assets/build/admin-versioning.js:10
msgid "Pull failed."
msgstr "A lekérés sikertelen."

#: assets/build/admin-versioning.js:10
msgid ""
"The selected branch could not be loaded safely. Refresh connection state, "
"then retry the pull."
msgstr "A kiválasztott ágat nem sikerült biztonságosan betölteni. Frissítse a kapcsolat állapotát, majd próbálja újra a lekérést."

#: assets/build/admin-versioning.js:10
msgid "Branch not found."
msgstr "Az ág nem található."

#: assets/build/admin-versioning.js:10
msgid ""
"The branch is missing or no longer accessible. Refresh branches and select "
"an available branch."
msgstr "Az ág hiányzik, vagy már nem érhető el. Frissítse az ágak listáját, és válasszon egy elérhető ágat."

#: assets/build/admin-versioning.js:10
msgid "Workspace SHA changed."
msgstr "Megváltozott a munkaterület SHA-azonosítója."

#: assets/build/admin-versioning.js:10
msgid "Reload the workspace and retry your change."
msgstr "Töltse újra a munkaterületet, majd próbálja újra a módosítást."

#: assets/build/admin-versioning.js:10
msgid "Branch was created, but workspace switch failed."
msgstr "Az ág létrejött, de a munkaterületre váltás nem sikerült."

#: assets/build/admin-versioning.js:10
msgid ""
"The remote branch may exist, but the local selection was not changed. "
"Refresh authoritative branch and workspace state."
msgstr "Lehet, hogy a távoli ág létezik, de a helyi kijelölés nem változott. Frissítse az ág és a munkaterület hiteles állapotát."

#: assets/build/admin-versioning.js:11
#, js-format
msgid " Support reference: %s."
msgstr " Támogatási hivatkozás: %s."

#: assets/build/admin-versioning.js:11
msgid "Versioning action could not be completed."
msgstr "A verziókezelési művelet nem fejeződött be."

#. translators: %s: optional support reference including a bounded error code.
#: assets/build/admin-versioning.js:13
#, js-format
msgid ""
"Refresh authoritative state and retry. If the problem continues, contact "
"support.%s"
msgstr "Frissítse a hiteles állapotot, majd próbálja újra. Ha a probléma továbbra is fennáll, forduljon a támogatáshoz.%s"

#: assets/build/admin-versioning.js:13
msgid "Review expired"
msgstr "Lejárt felülvizsgálat"

#: assets/build/admin-versioning.js:13
msgid ""
"This review session expired or was already consumed. Refresh to create a new"
" authoritative review."
msgstr "Ez a felülvizsgálati munkamenet lejárt, vagy már felhasználták. Frissítsen egy új, hiteles felülvizsgálat létrehozásához."

#: assets/build/admin-versioning.js:13
msgid "Review access changed"
msgstr "Megváltozott a felülvizsgálathoz való hozzáférés"

#: assets/build/admin-versioning.js:13
msgid ""
"You no longer have permission to view this review or item. Close the dialog "
"or refresh after access is restored."
msgstr "Már nincs jogosultsága ennek a felülvizsgálatnak vagy tételnek a megtekintéséhez. Zárja be a párbeszédablakot, vagy frissítsen, miután visszaállították a hozzáférést."

#: assets/build/admin-versioning.js:13
msgid "Review is out of date"
msgstr "A felülvizsgálat elavult"

#: assets/build/admin-versioning.js:13
msgid ""
"The local worktree or live WordPress data changed. Refresh before comparing,"
" discarding, or publishing."
msgstr "Változás történt a helyi munkafában vagy az élő WordPress-adatokban. Frissítsen az összehasonlítás, az elvetés vagy a közzététel előtt."

#: assets/build/admin-versioning.js:13
msgid "Review unavailable"
msgstr "A felülvizsgálat nem érhető el"

#: assets/build/admin-versioning.js:13
msgid ""
