msgstr "Az előfizetés állapotának slugja."

#: src/Internal/Abilities/Domain/Get_Order_Subscriptions.php:78
#: src/Internal/Abilities/Domain/Get_Subscriptions.php:121
msgid "Customer (user) ID."
msgstr "Vásárlói (felhasználói) azonosító (ID)."

#: src/Internal/Abilities/Domain/Get_Order_Subscriptions.php:82
#: src/Internal/Abilities/Domain/Get_Subscriptions.php:125
msgid "Subscription grand total."
msgstr "Az előfizetés teljes összege."

