msgstr "Előfizetéshez kapcsolódó rendelések lekérése"

#: src/Internal/Abilities/Domain/Get_Subscription_Related_Orders.php:40
msgid ""
"List the parent, renewal, and switch orders associated with a subscription. "
"Each returned order carries an order_type field ∈ {parent_order, "
"renewal_order, switch_order}."
msgstr "Az előfizetéshez kapcsolódó szülő, megújítási és váltási rendelések listázása. Minden visszaadott rendelés tartalmaz egy order_type mezőt: parent_order, renewal_order vagy switch_order."

#: src/Internal/Abilities/Domain/Get_Subscription_Related_Orders.php:68
msgid "Order ID."
msgstr "Rendelésazonosító."

#: src/Internal/Abilities/Domain/Get_Subscription_Related_Orders.php:72
