#, php-format
msgid ""
"WooCommerce 2.6 added support for %1$sREST API%2$s endpoints built on "
"WordPress core's %3$sREST API%4$s infrastructure."
msgstr "A WooCommerce 2.6 támogatást adott a WordPress alaprendszerének %3$sREST API%4$s-infrastruktúrájára épülő %1$sREST API%2$s-végpontokhoz."

#: includes/core/upgrades/templates/wcs-about.php:179
msgid ""
"Subscriptions 2.1 adds support for subscription data to this infrastructure."
msgstr ""
"A Subscriptions 2.1 ezen az infrastruktúrán az előfizetési adatok kezelését "
"is támogatja."

#: includes/core/upgrades/templates/wcs-about.php:180
msgid ""
"Your applications can now create, read, update or delete subscriptions via "
"RESTful API endpoints with the same design as the latest version of "
"WooCommerce's REST API endpoints."
msgstr ""
"Alkalmazásai mostantól a WooCommerce REST API végpontjainak legújabb "
