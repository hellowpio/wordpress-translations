#. Plugin Name of the plugin
#: jet-form-builder-login-action.php
msgid "JetFormBuilder User Login Action"
msgstr "JetFormBuilder felhasználói bejelentkezési művelet"

#. Plugin URI of the plugin
#: jet-form-builder-login-action.php
msgid "https://jetformbuilder.com/addons/user-login/"
msgstr "https://jetformbuilder.com/addons/user-login/"

#. Description of the plugin
#: jet-form-builder-login-action.php
msgid ""
"A post-submit action addon allowing users to log in by the provided "
"email/login & password."
msgstr ""
"Beküldés utáni műveletet biztosító bővítmény, amely lehetővé teszi a "
"felhasználóknak, hogy a megadott e-mail-címmel vagy felhasználónévvel és "
"jelszóval bejelentkezzenek."

#. Author of the plugin
#: jet-form-builder-login-action.php
msgid "Crocoblock"
msgstr "Crocoblock"

#. Author URI of the plugin
#: jet-form-builder-login-action.php
msgid "https://crocoblock.com/"
msgstr "https://crocoblock.com/"

#: includes/JetEngine/Notifications/Manager.php:37
msgid ""
"<b>Warning</b>: <b>JetFormBuilder User Login Action</b> needs "
"<b>JetEngine</b> update."
msgstr "<b>Figyelem</b>: A <b>JetFormBuilder User Login Action</b> működéséhez frissíteni kell a <b>JetEngine</b> bővítményt."

#: includes/JetEngine/Notifications/Notification.php:16
#: includes/JetFormBuilder/Actions/Action.php:34
msgid "User Login"
msgstr "Felhasználói belépés"

#: includes/JetFormBuilder/Actions/Manager.php:64
msgid ""
"<b>Warning</b>: <b>JetFormBuilder Login Action</b> needs "
"<b>JetFormBuilder</b> update."
msgstr "<b>Figyelem</b>: A <b>JetFormBuilder Login Action</b> működéséhez frissíteni kell a <b>JetFormBuilder</b> bővítményt."

#: includes/JetFormBuilder/Actions/ResetAction.php:30
msgid "Reset Password"
msgstr "Jelszó visszaállítása"

#: includes/JetFormBuilder/RenderStates/OnInvalidResetTokenState.php:18
msgid "On invalid token for reset user password"
msgstr "Érvénytelen token esetén a felhasználói jelszó alaphelyzetbe állításakor"

#: includes/JetFormBuilder/RenderStates/OnResetPasswordState.php:30
msgid "On reset user password"
msgstr "A felhasználói jelszó alaphelyzetbe állításakor"

#: jet-form-builder-login-action.php:38
msgid ""
"<b>Error:</b> <b>JetFormBuilder User Login Action</b> plugin requires a PHP "
"version \">= 7.0.0\" to work properly!"
msgstr "<b>Hiba:</b> A <b>JetFormBuilder User Login Action</b> bővítmény megfelelő működéséhez „>= 7.0.0” verziójú PHP szükséges!"

#: assets/js/login.editor.js:1
msgid "User Login Field"
msgstr "Felhasználói bejelentkezési mező"

#: assets/js/login.editor.js:1
msgid "User Password Field"
msgstr "Felhasználói jelszómező"

#: assets/js/login.editor.js:1
msgid "Remember Field"
msgstr "Emlékezzen rám mező"

#: assets/js/login.editor.js:1
msgid "Whether to use secure cookie"
msgstr "Annak megadása, hogy használjon-e biztonságos cookie-t"

#: assets/js/login.editor.js:1
msgid "Enable custom response errors"
msgstr "Egyéni válaszhibák bekapcsolása"

#: assets/js/reset.editor.js:1
msgid "User field"
msgstr "Felhasználói mező"

#: assets/js/reset.editor.js:1
msgid "Password field"
msgstr "Jelszómező"

#: assets/js/reset.editor.js:1
msgid "Confirm password field"
msgstr "Jelszó megerősítése mező"

#: assets/js/reset.editor.js:1
msgid ""
"The reset email is now a related action. You can edit its content directly "
"in the actions list."
msgstr "A jelszó-visszaállító e-mail mostantól kapcsolódó művelet. A tartalmát közvetlenül a műveletek listájában szerkesztheti."

#: assets/js/reset.editor.js:1
msgid "Add custom reset password email"
msgstr "Egyéni jelszó-visszaállító e-mail hozzáadása"
