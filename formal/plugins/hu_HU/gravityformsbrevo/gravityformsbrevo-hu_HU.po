#. Plugin Name of the plugin
#: brevo.php
msgid "Gravity Forms Brevo Add-On"
msgstr "Gravity Forms Brevo Add-On"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: brevo.php
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
#: brevo.php
msgid ""
"Integrates Gravity Forms with Brevo, allowing form submissions to be "
"automatically sent to your Brevo account."
msgstr "Összekapcsolja a Gravity Forms bővítményt a Brevóval, így az űrlapbeküldések automatikusan elküldhetők a Brevo-fiókjába."

#. Author of the plugin
#: brevo.php
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-brevo.php:197
msgid "Send data to Brevo only when payment is received."
msgstr "Adatok küldése a Brevónak csak a fizetés beérkezésekor."

#: class-gf-brevo.php:232
msgid "Brevo Settings"
msgstr "Brevo beállításai"

#. translators: %1$s is an opening <a> tag with a link to brevo.com. %2$s is
#. the closing </a> tag
#: class-gf-brevo.php:234
#, php-format
msgid ""
"Connect your Brevo account to allow Gravity Forms to send data to Brevo. If "
"you don't have a Brevo account, you can %1$ssign up for one here.%2$s"
msgstr "Kapcsolja össze Brevo-fiókját, hogy a Gravity Forms adatokat küldhessen a Brevónak. Ha nincs Brevo-fiókja, %1$shozzon létre egyet itt.%2$s"

#: class-gf-brevo.php:239
msgid "API Key"
msgstr "API-kulcs"

#. translators: %1$s is an opening <a> tag with a link to SMTP & API page on
#. Brevo.com. %2$s is the closing </a> tag
#: class-gf-brevo.php:242
#, php-format
msgid ""
"To locate your API key, in your Brevo account, click on the company name at "
"the top right corner, then click on %1$sSMTP & API%2$s. On the SMTP & API "
"page click the 'API Keys' tab. You will see your API key here. If you "
"haven't generated one yet, click the 'Generate a new API key' button."
msgstr "Az API-kulcs megkereséséhez kattintson a Brevo-fiókjában jobbra fent a cég nevére, majd az %1$sSMTP és API%2$s elemre. Az SMTP és API oldalon kattintson az „API-kulcsok” fülre. Itt találja az API-kulcsát. Ha még nem hozott létre kulcsot, kattintson az „Új API-kulcs létrehozása” gombra."

#: class-gf-brevo.php:297
msgid "The add-on could not connect using these credentials."
msgstr "A kiegészítő nem tudott csatlakozni ezekkel a hitelesítő adatokkal."

#: class-gf-brevo.php:306
msgid "Successfully connected to Brevo."
msgstr "Sikeresen csatlakozott a Brevóhoz."

#: class-gf-brevo.php:307
msgid "Company Name"
msgstr "Cégnév"

#: class-gf-brevo.php:322
msgid "Feed Information"
msgstr "Feed információi"

#: class-gf-brevo.php:326
msgid "Feed Name"
msgstr "Feed neve"

#: class-gf-brevo.php:331 class-gf-brevo.php:714
msgid "Name"
msgstr "Név"

#: class-gf-brevo.php:332
msgid "Enter a feed name to uniquely identify this feed."
msgstr "Adjon meg egy feednevet, amellyel egyértelműen azonosíthatja ezt a feedet."

#: class-gf-brevo.php:337 class-gf-brevo.php:343 class-gf-brevo.php:715
msgid "Brevo List"
msgstr "Brevo-lista"

#: class-gf-brevo.php:344
msgid "Select the Brevo List you would like to add your contacts to."
msgstr "Válassza ki azt a Brevo-listát, amelyhez hozzá szeretné adni a kapcsolatait."

#: class-gf-brevo.php:349 class-gf-brevo.php:355
msgid "Email"
msgstr "E-mail"

#: class-gf-brevo.php:356
msgid "Select which Gravity Form field will be used as the contact email."
msgstr "Válassza ki, hogy melyik Gravity Forms-mező szolgáljon kapcsolattartói e-mail címként."

#: class-gf-brevo.php:361 class-gf-brevo.php:373
msgid "Attributes"
msgstr "Attribútumok"

#: class-gf-brevo.php:364
msgid "Attribute"
msgstr "Attribútum"

#: class-gf-brevo.php:374
msgid ""
"Save information from the form entry to Brevo attributes by selecting the "
"appropriate fields from the dropdown list."
msgstr "Mentse az űrlapbejegyzés adatait Brevo-attribútumokként a legördülő listából a megfelelő mezők kiválasztásával."

#: class-gf-brevo.php:380
msgid "Double Opt-In Options"
msgstr "Dupla feliratkozás-megerősítési opciók"

#: class-gf-brevo.php:381
msgid ""
"When double opt-in is enabled, Brevo will send a confirmation email to the "
"user and will only add them to your list upon confirmation. For this to "
"work, a Form must be configured in your Brevo account with double opt-in "
"enabled, using the same list and email template as this feed."
msgstr "Ha a dupla megerősítéses feliratkozás be van kapcsolva, a Brevo megerősítő e-mailt küld a felhasználónak, és csak a megerősítés után adja hozzá a listához. Ehhez a Brevo-fiókjában be kell állítani egy űrlapot dupla megerősítéses feliratkozással, ugyanazt a listát és e-mail-sablont használva, mint ennél az adatfolyamnál."

#: class-gf-brevo.php:385
msgid "Enable Double Opt-In"
msgstr "Dupla feliratkozás-megerősítés bekapcsolása"

#: class-gf-brevo.php:391 class-gf-brevo.php:405
msgid "Email Template"
msgstr "E-mail-sablonminta"

#: class-gf-brevo.php:406
msgid "The Brevo email template to use for double opt-in."
msgstr "A dupla feliratkozás-megerősítéshez használandó Brevo-e-mail-sablon"

#: class-gf-brevo.php:411 class-gf-brevo.php:430
msgid "Redirect URL"
msgstr "Átirányítási URL"

#: class-gf-brevo.php:417
msgid "You must specify a valid Redirect URL."
msgstr "Érvényes átirányítási URL-t kell megadnia."

#: class-gf-brevo.php:431
msgid ""
"The URL the contact is redirected to when they click the link in the double "
"opt-in email."
msgstr "Az URL, amelyre a kapcsolattartó átirányul, amikor a dupla feliratkozást megerősítő e-mailben található linkre kattint"

#: class-gf-brevo.php:437
msgid "Feed Conditional Logic"
msgstr "Adatfolyam feltételes logikája"

#: class-gf-brevo.php:442 class-gf-brevo.php:444
msgid "Conditional Logic"
msgstr "Feltételes logika"

#: class-gf-brevo.php:443
msgid "Enable"
msgstr "Bekapcsolás"

#: class-gf-brevo.php:444
msgid ""
"When conditional logic is enabled, form submissions will only be sent to "
"Brevo when the condition is met. When disabled, all form submissions will be"
" sent."
msgstr "Ha be van kapcsolva a feltételes logika, az űrlapbeküldések csak akkor kerülnek elküldésre a Brevónak, ha teljesül a feltétel. Kikapcsolt állapotban az összes űrlapbeküldés elküldésre kerül."

#: class-gf-brevo.php:503
msgid "Select a list"
msgstr "Lista kiválasztása"

#: class-gf-brevo.php:570
msgid "Select an Attribute"
msgstr "Attribútum kiválasztása"

#: class-gf-brevo.php:668
msgid "Select a template"
msgstr "Sablonminta kiválasztása"

#: class-gf-brevo.php:769
msgid "Feed was not processed because API was not initialized."
msgstr "Az adatfolyam feldolgozása nem történt meg, mert az API nincs inicializálva."

#: class-gf-brevo.php:779
msgid "A valid Email address must be provided."
msgstr "Érvényes e-mail címet kell megadni."

#: class-gf-brevo.php:806
msgid "Contact has unsubscribed and resubscription is not allowed."
msgstr "A kapcsolattartó leiratkozott, és az újbóli feliratkozás nem engedélyezett."

#. Translators: %s is the response from the API.
#: class-gf-brevo.php:903
#, php-format
msgid "Unable to update contact. Email: %s. Error: %s"
msgstr "A kapcsolattartó frissítése nem sikerült. E-mail cím: %s. Hiba: %s"

#. Translators: %s is the response from the API.
#: class-gf-brevo.php:903
#, php-format
msgid "Unable to add contact. Email: %s. Error: %s"
msgstr "A kapcsolattartó hozzáadása nem sikerült. E-mail cím: %s. Hiba: %s"

#: class-gf-brevo.php:916
#, php-format
msgid "Double opt-in triggered for existing contact. Email: %s. ID: %s."
msgstr "Elindult a dupla megerősítésű feliratkozás egy meglévő kapcsolattartónál. E-mail cím: %s. ID: %s."

#: class-gf-brevo.php:920
#, php-format
msgid "Double opt-in triggered for new contact. Email: %s."
msgstr "Elindult a dupla megerősítésű feliratkozás egy új kapcsolattartónál. E-mail cím: %s."

#: class-gf-brevo.php:927
#, php-format
msgid "Contact updated. Email: %s. ID: %s."
msgstr "A kapcsolattartó frissítve. E-mail cím: %s. ID: %s."

#: class-gf-brevo.php:930
#, php-format
msgid "Contact added. Email: %s. ID: %s."
msgstr "A kapcsolattartó hozzáadva. E-mail cím: %s. ID: %s."

#: class-gf-brevo.php:986
msgid "Brevo Feed Failure"
msgstr "Brevo-adatfolyam-hiba"

#. translators: %1$s is the date the contact was created. %2$s is the time the
#. contact was created.
#: class-gf-brevo.php:1035
#, php-format
msgid "Contact created on %1$s at %2$s. Email: %3$s. ID: %4$s."
msgstr "A kapcsolattartó létrehozva: %1$s, %2$s. E-mail cím: %3$s. ID: %4$s."

#: class-gf-brevo.php:1036
#, php-format
msgid "Contact updated on %1$s at %2$s. Email: %3$s. ID: %4$s."
msgstr "A kapcsolattartó frissítve: %1$s, %2$s. E-mail cím: %3$s. ID: %4$s."
