#. translators: %1$s = opening <a> tag, %2$s = closing </a> tag.
#: inc/Engine/Admin/Settings/Page.php:740
#, php-format
msgid ""
"Combine JavaScript files combines your site’s internal, 3rd party and inline"
" JS reducing HTTP requests. Not recommended if your site uses HTTP/2. "
"%1$sMore info%2$s"
msgstr "A JavaScript-fájlok egyesítése összevonja a webhely belső, harmadik féltől származó és beágyazott JavaScript-kódját, így csökkenti a HTTP-kérések számát. Nem ajánlott, ha a webhely HTTP/2-t használ. %1$sTovábbi információ%2$s"

#: inc/Engine/Admin/Settings/Page.php:741
msgid ""
"For compatibility and best results, this option is disabled when delay "
"javascript execution is enabled."
msgstr "A kompatibilitás és a legjobb eredmény érdekében ez a beállítás ki van kapcsolva, ha a JavaScript-végrehajtás késleltetése be van kapcsolva."

#: inc/Engine/Admin/Settings/Page.php:757
