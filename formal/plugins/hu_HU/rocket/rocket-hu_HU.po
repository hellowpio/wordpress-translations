msgid "WP Rocket Cache"
msgstr "WP Rocket Cache"

#: inc/Engine/Cache/Abilities/Subscriber.php:85
msgid "Abilities related to WP Rocket Cache."
msgstr "A WP Rocket Cache-hez kapcsolódó képességek."

