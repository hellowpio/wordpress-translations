#: inc/Engine/Admin/Settings/Page.php:1031
msgid "Enable for images"
msgstr "Engedélyezés képekre"

#. translators: %1$s = “WP Rocket”, %2$s = a list of plugin names.
#: inc/Engine/Admin/Settings/Page.php:1043
#, php-format
