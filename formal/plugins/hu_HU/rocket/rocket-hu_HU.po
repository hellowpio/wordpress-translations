#. translators: %1$s = opening <a> tag, %2$s = closing </a> tag.
#: inc/Engine/Admin/Settings/Page.php:646
#, php-format
msgid ""
"Optimize CSS Delivery features are disabled on local environments. %1$sLearn"
" more%2$s"
msgstr "A CSS-betöltés optimalizálására szolgáló funkciók helyi környezetekben ki vannak kapcsolva. %1$sTovábbi információ%2$s"

#: inc/Engine/Admin/Settings/Page.php:666
#: inc/Engine/Optimization/RUCSS/Admin/OptionSubscriber.php:74
msgid "Remove Unused CSS"
msgstr "Felesleges CSS eltávolítása"

#. translators: %1$s = opening <a> tag, %2$s = closing </a> tag.
#: inc/Engine/Admin/Settings/Page.php:669
#, php-format
msgid ""
"Removes unused CSS per page and helps to reduce page size and HTTP requests."
" Recommended for best performance. Test thoroughly! %1$sMore info%2$s"
msgstr ""
"Oldalanként eltávolítja a nem használt CSS-t, és segít csökkenteni az oldal "
