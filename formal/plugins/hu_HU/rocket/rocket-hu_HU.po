"fájl kizárásához."

#. translators: %1$s = opening <a> tag, %2$s = closing </a> tag.
#: inc/Engine/Admin/Settings/Page.php:784
#, php-format
msgid ""
"<strong>3rd Party:</strong> Use either the full URL path or only the domain "
"name, to exclude external JS. %1$sMore info%2$s"
msgstr ""
"<strong>Külső:</strong> Használja a teljes URL-útvonalat vagy csak a "
"domainnevet a külső JS kizárásához. %1$sTovábbi információ%2$s"

#: inc/Engine/Admin/Settings/Page.php:800
#: inc/Engine/Optimization/DeferJS/AdminSubscriber.php:76
