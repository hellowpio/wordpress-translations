msgstr "A képek LazyLoad funkciója jelenleg be van kapcsolva itt: %2$s. Ha a(z) %1$s által biztosított LazyLoad funkciót szeretné használni, kapcsolja ki ezt a beállítást itt: %2$s."

#: inc/Engine/Admin/Settings/Page.php:1051
msgid "Enable for CSS background images"
msgstr "Engedélyezés CSS háttérképekre"

#: inc/Engine/Admin/Settings/Page.php:1066
msgid "Enable for iframes and videos"
msgstr "Engedélyezés iframe-ekre és videókra"

#: inc/Engine/Admin/Settings/Page.php:1081
msgid "Replace YouTube iframe with preview image"
msgstr "YouTube iframe cseréje előnézeti képre"

#. translators: %1$s = “WP Rocket”, %2$s = a list of plugin or themes names.
#: inc/Engine/Admin/Settings/Page.php:1083
#, php-format
msgid "Replace YouTube iframe with preview image is not compatible with %2$s."
msgstr "A(z) %2$s nem kompatibilis a „YouTube iframe cseréje előnézeti képre” funkcióval."

#. translators: %1$s = “WP Rocket”, %2$s = a list of plugin or themes names.
#: inc/Engine/Admin/Settings/Page.php:1083
msgid ""
"This can significantly improve your loading time if you have a lot of "
