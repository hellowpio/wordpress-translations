#. Plugin Name of the plugin
#: plugin.php
msgid "WPML Sticky Links"
msgstr "WPML Sticky Links"

#. Plugin URI of the plugin
#: plugin.php
msgid "https://wpml.org/"
msgstr "https://wpml.org/"

#. Description of the plugin
#: plugin.php
msgid ""
"Prevents internal links from ever breaking | <a "
"href=\"https://wpml.org/documentation/getting-started-guide/sticky-"
"links/\">Documentation</a> | <a href=\"https://wpml.org/version/wpml-sticky-"
"links-5-2-0/\">WPML Sticky Links 5.2.0 release notes</a>"
msgstr "Megakadályozza, hogy a belső hivatkozások valaha is megszakadjanak | <a href=\"https://wpml.org/documentation/getting-started-guide/sticky-links/\">dokumentáció</a> | <a href=\"https://wpml.org/version/wpml-sticky-links-5-2-0/\">WPML Sticky Links 5.2.0 kiadási megjegyzések</a>"

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: Admin notice shown when WPML Sticky Links is active but WPML
#. core is missing. %1$s: the URL of the client's wpml.org account downloads
#. page, which fills the first link. %2$s: the URL of this site's Plugins
#. screen, which fills the second link.
#: classes/class-wpml-sticky-links.php:135
#, php-format
msgid ""
"WPML Sticky Links is active, but it needs WPML Multilingual CMS, which is "
"not installed or not active. Sticky Links stays off until WPML runs. "
"Download WPML from <a href=\"%1$s\">your wpml.org account</a> and activate "
"it on the <a href=\"%2$s\">Plugins screen</a>."
msgstr "A WPML Sticky Links aktív, de működéséhez szükség van a WPML Multilingual CMS-re, amely nincs telepítve vagy nem aktív. A Sticky Links ki van kapcsolva, amíg a WPML nem fut. Töltse le a WPML-t a <a href=\"%1$s\">wpml.org-fiókjából</a>, és kapcsolja be a <a href=\"%2$s\">bővítmények</a> képernyőn."

#. translators: Admin notice shown when the installed WPML core is older than
#. WPML Sticky Links needs. %1$s: Sticky Links' own version. %2$s: the minimum
#. WPML version it needs. %3$s: the WPML version this site runs. %4$s: the URL
#. of this site's Plugins screen, which fills the link.
#: classes/class-wpml-sticky-links.php:156
#, php-format
msgid ""
"WPML Sticky Links %1$s needs WPML Multilingual CMS %2$s or newer. This site "
"runs WPML %3$s, so Sticky Links stays off until WPML is updated. Update WPML"
" on the <a href=\"%4$s\">Plugins screen</a>."
msgstr "A WPML Sticky Links %1$s működéséhez a WPML Multilingual CMS %2$s vagy újabb verziója szükséges. Ezen a webhelyen a WPML %3$s verziója fut, ezért a Sticky Links ki van kapcsolva a WPML frissítéséig. Frissítse a WPML-t a <a href=\"%4$s\">bővítmények</a> képernyőn."

#. translators: Label the Scan and Start buttons on the Sticky Links page take
#. while the job is running.
#: classes/class-wpml-sticky-links.php:534
#: classes/class-wpml-sticky-links.php:614
msgid "Running"
msgstr "Fut"

#. translators: Button label on the Sticky Links page that starts checking
#. posts and turning their links into sticky links. Verb, imperative.
#: classes/class-wpml-sticky-links.php:537 menu/management.php:79
msgid "Scan"
msgstr "Vizsgálat"

#. translators: Shown in place of a broken link on the Sticky Links page once
#. it has been repaired, followed by a dash and the new address. Past
#. participle used as a state, lower case in the source.
#: classes/class-wpml-sticky-links.php:600
msgid "fixed"
msgstr "rögzített"

#. translators: Button label on the Sticky Links page that starts turning
#. sticky links back into ordinary permalinks. Verb, imperative.
#: classes/class-wpml-sticky-links.php:626 menu/management.php:148
msgid "Start"
msgstr "Indítás"

#. translators: Follows a number on the Sticky Links page, as in "42 items
#. left", while links are being turned back into permalinks.
#: classes/class-wpml-sticky-links.php:630
msgid "items left"
msgstr "hátralévő tételek"

#. translators: Name of the Sticky Links page in the WPML menu, and the
#. heading at the top of that page.
#: classes/class-wpml-sticky-links.php:653
#: classes/class-wpml-sticky-links.php:655
msgid "Sticky Links"
msgstr "Sticky Links"

#. translators: Link next to WPML Sticky Links on the WordPress plugins
#. screen: it opens the settings page. Verb, imperative.
#: classes/class-wpml-sticky-links.php:808
msgid "Configure"
msgstr "Beállítás"

#: menu/management.php:52
msgid "Setup <b>Sticky Links</b>"
msgstr "A <b>Sticky Links</b> beállítása"

#. translators: Heading above the settings form on the Sticky Links page.
#: menu/management.php:55
msgid "Options"
msgstr "Opciók"

#: menu/management.php:65
msgid "Turn links in text widgets to Sticky"
msgstr "Szöveges widgetekben lévő hivatkozások átalakítása állandó hivatkozásokká"

#. translators: Button label that saves the settings on the Sticky Links page.
#. Verb, imperative.
#: menu/management.php:70
msgid "Apply"
msgstr "Alkalmazás"

#. translators: Follows a number on the Sticky Links page, as in "42 posts and
#. pages not processed". The number sits in a separate element that the page
#. updates on its own.
#: menu/management.php:77
msgid "posts and pages not processed"
msgstr "Feldolgozatlan bejegyzések és oldalak"

#: menu/management.php:83
msgid ""
"Replace permalinks with sticky links in posts that have not been checked"
msgstr "Az ellenőrizetlen bejegyzések közvetlen hivatkozásainak cseréje állandó hivatkozásokra"

#: menu/management.php:84
msgid "Scan ALL posts"
msgstr "Összes bejegyzés átvizsgálása"

#: menu/management.php:85
msgid "Replace permalinks with sticky links in all blog posts"
msgstr "Az összes blogbejegyzés közvetlen hivatkozásainak cseréje állandó hivatkozásokra"

#. translators: Heading above the table of links on the Sticky Links page that
#. WPML could not repair.
#: menu/management.php:90
msgid "Broken Links"
msgstr "Törött linkek"

#. translators: Column heading on the Sticky Links page: the post or page the
#. broken link was found in.
#: menu/management.php:95
msgid "Post/page"
msgstr "Bejegyzés/oldal"

#. translators: Column heading on the Sticky Links page: the link that no
#. longer works.
#: menu/management.php:97
msgid "Broken link"
msgstr "Hibás link"

#. translators: Column heading on the Sticky Links page: the addresses WPML
#. offers in place of the broken link.
#: menu/management.php:99
msgid "Suggestions"
msgstr "Javaslatok"

#. translators: Link shown in brackets after each suggested address on the
#. Sticky Links page: it replaces the broken link with that address. Verb,
#. imperative, lower case in the source.
#: menu/management.php:127
msgid "use"
msgstr "Használat"

#. translators: Shown on the Sticky Links page in place of the suggestions
#. when WPML has none for a broken link.
#: menu/management.php:131
msgid "No suggestions"
msgstr "Nincsenek javaslatok"

#. translators: Shown in the middle of the broken links table on the Sticky
#. Links page when there are no broken links. Adjective, lower case in the
#. source, not the verb "to empty".
#: menu/management.php:142
msgid "empty"
msgstr "üres"

#: menu/management.php:147
msgid "Revert sticky urls to permalinks"
msgstr "Állandó URL-ek visszaállítása közvetlen hivatkozásokra"

#: menu/management.php:153
msgid "Change sticky links back to Wordpress permalinks"
msgstr "Rögzített hivatkozások visszaállítása WordPress közvetlen hivatkozásaira"

#. translators: Shown on the Sticky Links page while sticky links are turned
#. back into permalinks. %d: the number of posts and pages still in the queue.
#: menu/management.php:158
#, php-format
msgid "%d items in queue"
msgstr "%d tétel a várólistán"
