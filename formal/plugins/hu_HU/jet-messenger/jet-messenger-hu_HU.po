msgid "This diagnostic check does not support an automated fix."
msgstr "Ez a diagnosztikai ellenőrzés nem támogatja az automatikus javítást."

#: includes/admin/observability/diagnostic-fix-service.php:79
msgid "Diagnostic check was not found."
msgstr "A diagnosztikai ellenőrzés nem található."

#: includes/admin/observability/diagnostic-fix-service.php:88
msgid "This diagnostic check does not currently need an automated fix."
msgstr "Ehhez a diagnosztikai ellenőrzéshez jelenleg nincs szükség automatikus javításra."

#: includes/admin/observability/diagnostic-fix-service.php:107
msgid ""
"JetMessenger tried to fix this diagnostic check, but the check still needs "
"attention."
msgstr "A JetMessenger megpróbálta orvosolni az ellenőrzés által feltárt problémát, de az továbbra is figyelmet igényel."

#: includes/admin/observability/diagnostic-fix-service.php:152
msgid "JetMessenger refreshed the attachment protection files."
msgstr "A JetMessenger frissítette a csatolmányok védelmi fájljait."

#: includes/admin/observability/diagnostic-fix-service.php:168
msgid "JetMessenger could not recreate the SQL rate limiter table."
msgstr "A JetMessenger nem tudta újra létrehozni az SQL-sebességkorlátozó táblát."

#: includes/admin/observability/diagnostic-fix-service.php:173
#: includes/admin/observability/diagnostic-fix-service.php:241
msgid "JetMessenger recreated the SQL rate limiter table."
msgstr "A JetMessenger újra létrehozta az SQL-sebességkorlátozó táblát."

#: includes/admin/observability/diagnostic-fix-service.php:192
msgid ""
"JetMessenger refreshed the attachment protection files, but the current "
"server still appears to allow direct file access. This often means the "
"environment ignores .htaccess rules, so server-level blocking is still "
"required."
msgstr "A JetMessenger frissítette a csatolmányok védelmi fájljait, de úgy tűnik, hogy a jelenlegi szerver továbbra is engedélyezi a fájlok közvetlen elérését. Ez gyakran azt jelenti, hogy a környezet figyelmen kívül hagyja a .htaccess-szabályokat, ezért a szerver szintjén továbbra is blokkolni kell a hozzáférést."

#: includes/admin/observability/diagnostic-fix-service.php:206
msgid "Attachment storage has not been initialized yet."
msgstr "A csatolmányok tárhelye még nincs inicializálva."

#: includes/admin/observability/diagnostic-fix-service.php:214
msgid "JetMessenger could not create the attachment storage directory."
msgstr "A JetMessenger nem tudta létrehozni a csatolmányok tárolására szolgáló könyvtárat."

#: includes/admin/observability/diagnostic-fix-service.php:222
msgid "Attachment storage is not writable."
msgstr "A csatolmányok tárhelye nem írható."

#: includes/admin/observability/diagnostic-fix-service.php:245
msgid ""
"Attachment storage protection files were refreshed and direct access is now "
"blocked."
msgstr "A csatolmányok tárhelyének védelmi fájljai frissültek, és a közvetlen hozzáférés mostantól blokkolva van."

#: includes/admin/observability/diagnostic-fix-service.php:248
msgid "Attachment storage protection files were refreshed."
msgstr "A csatolmányok tárhelyének védelmi fájljai frissültek."

#: includes/admin/observability/diagnostics-service.php:101
msgid "A diagnostics check crashed"
msgstr "Egy diagnosztikai ellenőrzés összeomlott"

#: includes/admin/observability/diagnostics-service.php:102
msgid ""
"JetMessenger caught an internal diagnostics error while building the report."
msgstr "A JetMessenger belső diagnosztikai hibát észlelt a jelentés összeállítása közben."

