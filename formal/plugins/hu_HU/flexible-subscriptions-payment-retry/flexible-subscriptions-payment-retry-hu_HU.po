msgstr "Aktív"

#: src/Settings/RetrySettingsTab.php:53
msgid "Set the global subscription status when a subscription expires"
msgstr "Az előfizetés lejáratakor alkalmazott globális állapot beállítása"

#: src/Settings/RetrySettingsTab.php:59
msgid "Subscription status when expired"
msgstr "Az előfizetés állapota lejáratkor"

#: src/Settings/RetrySettingsTab.php:68 build/admin.js:1
