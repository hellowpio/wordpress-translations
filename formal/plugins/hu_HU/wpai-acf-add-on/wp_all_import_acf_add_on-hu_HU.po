#, php-format
msgid ""
"<b>%1$s Plugin</b>: <a target=\"_blank\" "
"href=\"http://wordpress.org/plugins/advanced-custom-fields/\">Advanced "
"Custom Fields</a> must be installed"
msgstr "<b>%1$s bővítmény</b>: telepíteni kell az <a target=\"_blank\" href=\"http://wordpress.org/plugins/advanced-custom-fields/\">Advanced Custom Fields</a> bővítményt"

