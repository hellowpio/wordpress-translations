#. Description of the plugin
#: plugin.php
msgid ""
"Add multilingual support for WPForms | <a "
"href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpforms-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wpforms\">Documentation</a>"
msgstr "Többnyelvű támogatás hozzáadása a WPForms bővítményhez | <a href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpforms-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wpforms\">dokumentáció</a>"

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "https://www.onthegosystems.com/"
msgstr "https://www.onthegosystems.com/"

#. translators: %s: path to file
#: vendor/wpml/forms/classes/Translation/Config.php:54
#, php-format
msgid "WPML Forms config file does not exist: %s"
msgstr "A WPML Forms konfigurációs fájl nem létezik: %s"

#. translators: %s: path to file
#: vendor/wpml/forms/classes/Translation/Config.php:62
#, php-format
msgid "WPML Forms cannot parse config file: %s"
msgstr "A WPML Forms nem tudja feldolgozni a konfigurációs fájlt: %s"

#. translators: The placeholders are replaced by an HTML link pointing to the
#. String translation add-on FAQ article.
#: vendor/wpml/forms/classes/UI/Notices.php:21
#, php-format
msgid ""
"WPML Forms: Please activate the WPML CMS Plugin and the %1$sString "
"Translation add-on%2$s"
msgstr "WPML Forms: Kérjük, kapcsolja be a WPML CMS bővítményt és a %1$sString Translation kiegészítőt%2$s"

#: vendor/wpml/forms/templates/welcome.php:6
msgid ""
"Your website's forms were automatically detected and added to WPML > "
"Translation Management."
msgstr "A rendszer automatikusan felismerte a webhely űrlapjait, és hozzáadta őket a WPML > Fordításkezeléshez."

#: vendor/wpml/forms/templates/welcome.php:7
msgid ""
"You can send them to your local translators, use one of our partner "
"translation services, or use automatic machine translation via the Advanced "
"Translation Editor."
msgstr "Elküldheti őket a helyi fordítóknak, igénybe veheti valamelyik partnerünk fordítási szolgáltatását, vagy automatikus gépi fordítást használhat a haladó fordítószerkesztőn keresztül."

