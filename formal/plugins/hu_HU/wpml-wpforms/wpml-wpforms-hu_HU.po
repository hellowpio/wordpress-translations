#: plugin.php
msgid "WPForms Multilingual"
msgstr "WPForms Multilingual"

#. Plugin URI of the plugin
#: plugin.php
msgid ""
"https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpforms-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wpforms"
