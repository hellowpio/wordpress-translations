#: src/Admin/Settings/Tabs/Misc.php:304
msgid "CAPTCHA on Checkout"
msgstr "CAPTCHA a fizetésnél"

#: src/Admin/Settings/Tabs/Misc.php:306
msgid "Enable CAPTCHA on the checkout block."
msgstr "CAPTCHA bekapcsolása a fizetési blokkban."

#: src/Admin/Settings/Tabs/Misc.php:307
msgid ""
"This setting requires the checkout block and will not work with the "
