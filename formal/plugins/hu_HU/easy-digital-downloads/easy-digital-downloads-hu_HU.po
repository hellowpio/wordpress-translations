msgstr "Meglévő termék (letöltés) frissítése. Csak a megadott mezők módosulnak: név, egyszeri ár, állapot vagy leírás."

#: src/Abilities/Products/Update.php:200
msgid "The product ID."
msgstr "A termék ID-ja."

#: src/Abilities/Products/Update.php:205
msgid "The new product name."
msgstr "Az új terméknév."

#: src/Abilities/Products/Update.php:210
msgid "The new single price for the product."
msgstr "A termék új egyszeri ára."

#: src/Abilities/Products/Update.php:215
msgid "The new post status."
msgstr "Az új bejegyzésállapot."

#: src/Abilities/Products/Update.php:220
msgid "The new full product description."
msgstr "A termék új, teljes leírása."

#: src/Abilities/Products/Update.php:244
msgid ""
"The single price after the update. Null when the product uses variable "
"pricing."
msgstr "Az egyszeri ár a frissítés után. Null, ha a termék változó árazást használ."

#: src/Abilities/Reports/Sales.php:117
msgid "Sales Report"
msgstr "Értékesítési jelentés"

#: src/Abilities/Reports/Sales.php:128
msgid ""
"Get store sales and earnings statistics for a preset period or a custom date"
" range, optionally scoped to a single product."
msgstr "Árbevételi és bevételi statisztikák lekérése előre beállított időszakra vagy egyéni dátumtartományra, igény szerint egy termékoldalra szűkítve."

#: src/Abilities/Reports/Sales.php:156
msgid ""
"Preset reporting period. Takes precedence over date_start and date_end. "
"Defaults to this_month when no dates are provided."
msgstr "Előre beállított jelentési időszak. Elsőbbséget élvez a date_start és date_end értékekkel szemben. Alapértelmezés szerint this_month, ha nincsenek megadva dátumok."

#: src/Abilities/Reports/Sales.php:162
msgid ""
"Include orders created on or after this date (YYYY-MM-DD). Ignored when "
"period is provided."
msgstr "A megadott dátumon vagy azt követően létrehozott rendelések felvétele (YYYY-MM-DD). A rendszer figyelmen kívül hagyja, ha meg van adva időszak."

#: src/Abilities/Reports/Sales.php:168
msgid ""
"Include orders created on or before this date (YYYY-MM-DD). Ignored when "
"period is provided."
msgstr "A megadott dátumon vagy azt megelőzően létrehozott rendelések felvétele (YYYY-MM-DD). A rendszer figyelmen kívül hagyja, ha meg van adva időszak."

#: src/Abilities/Reports/Sales.php:173
msgid "Also include earnings and sales for this product (download) ID."
msgstr "A megadott termék (letöltés) ID-jához tartozó bevételek és értékesítések felvétele."

#: src/Abilities/Reports/Sales.php:194
msgid "The preset period used, or null when a custom date range was used."
msgstr "A használt előre beállított időszak, vagy null egyéni dátumtartomány használata esetén."

#: src/Abilities/Reports/Sales.php:206
msgid ""
"Net earnings divided by order count, rounded to the store currency "
"precision."
msgstr "A nettó bevétel osztva a rendelések darabszámával, az áruház pénznemének pontosságára kerekítve."

#: src/Abilities/Reports/Sales.php:210
msgid "Included when a product_id was provided."
msgstr "Akkor szerepel, ha meg van adva a product_id."

#: src/Abilities/Reports/SalesSummary.php:70
msgid "Sales Summary"
msgstr "Értékesítési összefoglaló"

#: src/Abilities/Reports/SalesSummary.php:81
msgid ""
"Get net earnings and sales counts for this month, last month, today, and all"
" time."
msgstr "A nettó bevétel és az értékesítések darabszámának lekérése erre a hónapra, az előző hónapra, a mai napra és a teljes időszakra."

#: src/Abilities/Reports/SalesSummary.php:128
msgid "Net earnings for the range."
msgstr "A nettó bevétel az adott időszakra."

#: src/Abilities/Reports/SalesSummary.php:132
msgid "Number of sales for the range."
msgstr "Az értékesítések darabszáma az adott időszakra."

#: src/Abilities/Store/HealthCheck.php:75
msgid "Store Health Check"
msgstr "Áruház állapotfelmérése"

#: src/Abilities/Store/HealthCheck.php:86
msgid ""
"Get a snapshot of store health: software versions, store mode, order and "
"customer counts, and enabled payment gateways."
msgstr "Áttekintés lekérése az áruház állapotáról: szoftververziók, áruházi mód, rendelések és vásárlók darabszáma, valamint bekapcsolt fizetési átjárók."

#: src/Abilities/Store/HealthCheck.php:119
msgid "Order counts keyed by status, plus a total."
msgstr "Állapot szerint csoportosított rendelésdarabszámok, valamint az összesített darabszám."

#: src/Abilities/Store/HealthCheck.php:125
msgid "Number of published products (downloads)."
msgstr "A közzétett termékek (letöltések) darabszáma."

#: src/Abilities/Store/Settings.php:96
msgid ""
"Get a read-only summary of store configuration: currency, payment gateways, "
"taxes, key pages, and version information."
msgstr "Az áruház beállításainak csak olvasható összefoglalójának lekérése: pénznem, fizetési átjárók, adók, fontos oldalak és verzióinformációk."

#: src/Abilities/Store/Settings.php:124
msgid "Whether the currency symbol renders before or after the amount."
msgstr "Hogy a pénznem szimbóluma az összeg előtt vagy után jelenik-e meg."

#: src/Abilities/Store/Settings.php:147
msgid ""
"Whether the store allows abilities to change its data. When false, only read"
" abilities can run, and the store owner enables the rest under Downloads > "
"Tools > AI."
msgstr "Hogy az áruház engedélyezi-e a képességeknek az adatok módosítását. Ha nem, csak olvasási képességek futtathatók; a többit az áruház tulajdonosa kapcsolhatja be a Letöltések > Eszközök > AI menüpontban."

#: src/Abilities/Store/TaxRates.php:109
msgid ""
"List the store tax rates, along with whether taxes are enabled. Active rates"
