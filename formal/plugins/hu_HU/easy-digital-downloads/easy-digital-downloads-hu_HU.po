#: src/Abilities/Orders/ResendReceipt.php:143
#: src/Abilities/Orders/UpdateStatus.php:155
msgid "The order ID."
msgstr "A rendelés ID-ja."

#: src/Abilities/Orders/NoteRead.php:44
msgid "Read Order Notes"
msgstr "Megrendelési jegyzetek olvasása"

#: src/Abilities/Orders/NoteRead.php:55
msgid "List the notes recorded on an order, newest first."
msgstr "A megrendeléshez rögzített jegyzetek listázása, a legújabbal kezdve."

#: src/Abilities/Orders/Read.php:95
msgid "Read Orders"
msgstr "Megrendelések olvasása"

#: src/Abilities/Orders/Read.php:106
msgid ""
"Look up a single order by ID (including its items), or list orders filtered "
"by status, customer, product, email, or date range. Lists contain sales "
"unless the type is set to refund; a single-order lookup returns either, "
"identified by its type."
msgstr "Egyetlen megrendelés keresése ID alapján (a tételeivel együtt), vagy megrendelések listázása állapot, vásárló, termék, e-mail cím vagy dátumtartomány szerinti szűréssel. A listák értékesítéseket tartalmaznak, kivéve, ha a típus visszatérítésre van állítva; az egyetlen megrendelésre irányuló keresés értékesítést vagy visszatérítést ad vissza, a típusa alapján azonosítva."

#: src/Abilities/Orders/Read.php:135
msgid ""
"Order ID for a single-order lookup. When provided, all other filters are "
"ignored."
msgstr "Egyetlen megrendelés kereséséhez szükséges megrendelés-ID. Ha megadja, a rendszer figyelmen kívül hagy minden más szűrőt."

#: src/Abilities/Orders/Read.php:140
msgid "Filter by order status."
msgstr "Szűrés a megrendelés állapota szerint."

#: src/Abilities/Orders/Read.php:146
msgid "The type of order record to list."
msgstr "A listázandó megrendelési rekord típusa."

#: src/Abilities/Orders/Read.php:156
msgid "Filter to orders containing this product (download) ID."
msgstr "Szűrés az adott terméket (letöltést) tartalmazó megrendelésekre, a termék ID-ja alapján."

#: src/Abilities/Orders/Read.php:161
msgid "Filter by the email address on the order."
msgstr "Szűrés a megrendeléshez tartozó e-mail cím alapján."

#: src/Abilities/Orders/Read.php:167
msgid ""
"Include orders created on or after this date (YYYY-MM-DD, store timezone)."
msgstr "A megadott dátumon vagy azután létrehozott megrendelések felvétele (YYYY-MM-DD, az áruház időzónája szerint)."

#: src/Abilities/Orders/Read.php:173
#: src/Pro/Abilities/CampaignTracker/Read.php:180
msgid ""
"Include orders created on or before this date (YYYY-MM-DD, store timezone)."
msgstr "A megadott dátumon vagy azelőtt létrehozott megrendelések felvétele (YYYY-MM-DD, az áruház időzónája szerint)."

#: src/Abilities/Orders/Read.php:210
msgid "The record type: sale or refund."
msgstr "A rekord típusa: értékesítés vagy visszatérítés."

#: src/Abilities/Orders/Read.php:217
msgid ""
"The email address on the order. Included only when the current user can view"
" sensitive shop data."
msgstr "A megrendeléshez tartozó e-mail cím. Csak akkor szerepel, ha az aktuális felhasználó megtekintheti az áruház bizalmas adatait."

#: src/Abilities/Orders/Read.php:229
msgid "Order line items. Included on single-order lookups only."
msgstr "A megrendelés tételei. Csak egyetlen megrendelésre irányuló keresés esetén szerepelnek."

#: src/Abilities/Orders/ResendReceipt.php:48
#: src/Abilities/Orders/UpdateStatus.php:49
msgid "That ID belongs to a refund record rather than an order."
msgstr "Ez az ID egy visszatérítési rekordhoz tartozik, nem megrendeléshez."

#: src/Abilities/Orders/ResendReceipt.php:56
msgid "This order has no email address to send a receipt to."
msgstr "Ehhez a megrendeléshez nem tartozik e-mail cím, amelyre nyugtát lehetne küldeni."

#: src/Abilities/Orders/ResendReceipt.php:66
msgid "The order receipt email is not enabled on this store."
msgstr "A megrendelési nyugtát küldő e-mail nincs bekapcsolva ebben az áruházban."

#: src/Abilities/Orders/ResendReceipt.php:104
msgid "Resend Order Receipt"
msgstr "Megrendelési nyugta újraküldése"

#: src/Abilities/Orders/ResendReceipt.php:115
msgid ""
"Resend the purchase receipt email for an order to the email address on the "
"order."
msgstr "A megrendeléshez tartozó e-mail címre küldött vásárlási nyugta újraküldése."

#: src/Abilities/Orders/ResendReceipt.php:166
msgid "The email address the receipt was sent to."
msgstr "Az e-mail cím, amelyre a nyugtát elküldtük."

#: src/Abilities/Orders/UpdateStatus.php:98
msgid "Update Order Status"
msgstr "Megrendelés állapotának frissítése"

#: src/Abilities/Orders/UpdateStatus.php:109
msgid ""
"Change the status of an order. Status transitions fire the same hooks as "
"changing the status in the admin, so downstream integrations react normally:"
" completing an order emails the customer a purchase receipt and grants "
"download access, and moving a completed order back to pending or processing "
"subtracts it from store earnings and from the customer totals. Refunds "
"cannot be issued here; use the order screen in the admin."
msgstr "A megrendelés állapotának módosítása. Az állapotváltások ugyanazokat a hookokat aktiválják, mint az adminfelületen történő módosítás, így az integrációk a megszokott módon reagálnak: egy megrendelés befejezésekor a vásárló megkapja a vásárlási nyugtát, és hozzáférést kap a letöltéshez; egy befejezett megrendelés függőben vagy feldolgozás alatt állapotra váltása pedig csökkenti az áruház bevételét és a vásárló összesített értékeit. Itt nem lehet visszatérítést kiadni; használja az adminfelületen a megrendelés oldalát."

#: src/Abilities/Orders/UpdateStatus.php:160
msgid ""
"The new status. Refund statuses are not allowed here; refunds have to be "
"issued from the order screen in the admin."
msgstr "Az új állapot. Visszatérítési állapotok itt nem engedélyezettek; a visszatérítést az adminfelületen, a megrendelés oldaláról kell kiadni."

#: src/Abilities/Pagination.php:53
msgid "Maximum number of results to return."
msgstr "A visszaadandó eredmények maximális száma."

#: src/Abilities/Pagination.php:59
msgid "Number of results to skip, for paging through results."
msgstr "Az eredmények lapozásakor kihagyandó találatok darabszáma."

#: src/Abilities/Pagination.php:100
msgid "Total number of matching records."
msgstr "Az egyező rekordok teljes darabszáma."

#: src/Abilities/Pagination.php:110
msgid "Whether more records exist beyond this page."
msgstr "Léteznek-e további rekordok ezen az oldalon túl."

#: src/Abilities/Products/Create.php:95
msgid "Create Product"
msgstr "Termék létrehozása"

#: src/Abilities/Products/Create.php:106
msgid ""
"Create a new product (download) with an optional single price. Products are "
"created as drafts unless a publish status is requested."
msgstr "Új termék (letöltés) létrehozása opcionális egyetlen árral. A termékek vázlatként jönnek létre, kivéve, ha közzétételi állapot van megadva."

#: src/Abilities/Products/Create.php:135
msgid "The product name."
msgstr "A termék neve."

#: src/Abilities/Products/Create.php:140
msgid "The single price for the product."
msgstr "A termék egyszeri ára."

#: src/Abilities/Products/Create.php:145
msgid "The full product description."
msgstr "A termék teljes leírása."

#: src/Abilities/Products/Create.php:150
msgid "A short product summary."
msgstr "A termék rövid összefoglalója."

#: src/Abilities/Products/Create.php:156
msgid "The status for the new product."
msgstr "Az új termék állapota."

#: src/Abilities/Products/Read.php:51 src/Abilities/Products/Read.php:62
#: src/Abilities/Products/Update.php:83
msgid "No product exists with that ID."
msgstr "Nem létezik termék ezzel az ID-val."

#: src/Abilities/Products/Read.php:103
msgid "Read Products"
msgstr "Termékek lekérése"

#: src/Abilities/Products/Read.php:114
msgid ""
"Look up a single product by ID (including its pricing, files, and download "
"limit), or list products filtered by search term, status, category, or tag."
msgstr ""

#: src/Abilities/Products/Read.php:143
msgid ""
"Product ID for a single-product lookup. When provided, all other filters are"
" ignored."
msgstr "Egyetlen termék lekéréséhez szükséges termék-ID. Ha meg van adva, a rendszer figyelmen kívül hagyja az összes többi szűrőt."

#: src/Abilities/Products/Read.php:147
msgid "Search products by keyword."
msgstr "Termékek keresése kulcsszó alapján."

#: src/Abilities/Products/Read.php:152
msgid "Filter by post status. Defaults to all statuses."
msgstr "Szűrés bejegyzésállapot szerint. Alapértelmezés szerint az összes állapotot tartalmazza."

#: src/Abilities/Products/Read.php:156
msgid "Filter by download category term slug."
msgstr "Szűrés a letöltési kategóriához tartozó kifejezés slugja szerint."

#: src/Abilities/Products/Read.php:160
msgid "Filter by download tag term slug."
msgstr "Szűrés a letöltési címkéhez tartozó kifejezés slugja szerint."

#: src/Abilities/Products/Read.php:197
msgid ""
"When the product was created, in UTC. Null for a draft, which has no "
"published date yet."
msgstr "A termék létrehozásának időpontja UTC szerint. Vázlat esetén null, mivel még nincs közzétételi dátuma."

#: src/Abilities/Products/Read.php:203
msgid "The single price. Null when the product uses variable pricing."
msgstr "Az egyszeri ár. Null, ha a termék változó árazást használ."

#: src/Abilities/Products/Read.php:219
msgid ""
"Lifetime sales count. Included only when the current user can view sensitive"
" shop data."
msgstr "Az értékesítések darabszáma a teljes időszakra. Csak akkor szerepel, ha az aktuális felhasználó megtekintheti az áruház bizalmas adatait."

#: src/Abilities/Products/Read.php:223
msgid ""
"Lifetime earnings. Included only when the current user can view sensitive "
"shop data."
msgstr "A teljes időszakra vonatkozó bevétel. Csak akkor szerepel, ha az aktuális felhasználó megtekintheti az áruház bizalmas adatait."

#: src/Abilities/Products/Read.php:228
msgid "Included on single-product lookups only."
msgstr "Csak egyetlen termék lekérésekor szerepel."

#: src/Abilities/Products/Read.php:232
msgid "File download limit. Included on single-product lookups only."
msgstr "A fájl letöltési korlátja. Csak egyetlen termék lekérésekor szerepel."

#: src/Abilities/Products/Read.php:236
msgid ""
"Downloadable files, by ID and name only. File URLs are never included "
"because they can point to protected or pre-signed assets. Included on "
"single-product lookups only."
msgstr "Letölthető fájlok, kizárólag ID-val és névvel. A fájlok URL-jei soha nem szerepelnek, mivel védett vagy előre aláírt elemekre mutathatnak. Csak egyetlen termék lekérésekor szerepel."

#: src/Abilities/Products/Update.php:107
msgid ""
"This product uses variable pricing, which cannot be changed here. Update its"
