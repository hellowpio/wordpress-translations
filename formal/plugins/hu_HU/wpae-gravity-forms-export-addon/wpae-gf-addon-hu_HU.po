#. Description of the plugin
#: wpae-gf-addon.php
msgid ""
"Export Gravity Forms entries to CSV or XML, or migrate to another WordPress "
"install."
msgstr ""
"Exportálja a Gravity Forms űrlapbejegyzéseket CSV- vagy XML-formátumba, vagy"
" migrálja egy másik WordPress-telepítésre."

