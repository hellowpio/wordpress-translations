msgid "Engine types supported by this placement hook."
msgstr "Az elhelyezési hook által támogatott motortípusok."

#: includes/abilities/class-wc-prl-describe-components-ability.php:165
msgid "Whether this filter requires a configured value."
msgstr "Igényel-e ez a szűrő beállított értéket."

#: includes/abilities/class-wc-prl-describe-components-ability.php:169
msgid ""
"Whether this filter can be evaluated without shopper or request context."
msgstr "Kiértékelhető-e ez a szűrő a vásárló vagy a kérés kontextusa nélkül."

#: includes/abilities/class-wc-prl-describe-components-ability.php:184
msgid "Whether this condition requires a configured value."
msgstr "Igényel-e ez a feltétel beállított értéket."

#: includes/abilities/class-wc-prl-describe-components-ability.php:188
msgid ""
"Relative evaluation cost used by Product Recommendations when ordering "
"condition checks."
msgstr "A feltétel-ellenőrzések sorrendjének meghatározásakor a Product Recommendations által használt relatív kiértékelési költség."

#: includes/abilities/class-wc-prl-describe-components-ability.php:230
msgid "Engine types that support this component."
msgstr "Az összetevő által támogatott motortípusok."

