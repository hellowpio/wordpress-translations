#: includes/abilities/class-wc-prl-describe-components-ability.php:41
msgid "Describe recommendation components"
msgstr "Ajánlási összetevők ismertetése"

#: includes/abilities/class-wc-prl-describe-components-ability.php:42
msgid ""
"Describe available Product Recommendations engine types, locations, filters,"
" amplifiers, and conditions."
msgstr "A Product Recommendations elérhető motortípusainak, helyszíneinek, szűrőinek, erősítőinek és feltételeinek ismertetése."

#: includes/abilities/class-wc-prl-describe-components-ability.php:102
msgid ""
"Restrict returned locations, filters, amplifiers, and conditions to one "
"recommendation engine type."
msgstr "A visszaadott helyszínek, szűrők, erősítők és feltételek korlátozása egyetlen ajánlómotortípusra."

#: includes/abilities/class-wc-prl-describe-components-ability.php:137
msgid "Whether recommendation output at this location can be cached safely."
msgstr "Biztonságosan gyorsítótárazható-e az adott helyszínen megjelenített ajánlás."

