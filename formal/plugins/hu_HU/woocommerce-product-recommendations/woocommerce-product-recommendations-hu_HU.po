#: resources/js/admin/blocks/product-collections/viewed-not-purchased-products.js:74
msgid ""
"Display a list of recently viewed products excluding those in the current "
"order."
msgstr "A nemrég megtekintett termékek listájának megjelenítése, a jelenlegi rendelésben szereplők nélkül."

#, php-format
#~ msgid ""
#~ "Product Recommendations ran a quick check-up on your site, and found that "
#~ "your catalog pages are probably served from a full page cache. While this "
#~ "ensures a snappier experience for your visitors, it also prevents <a "
#~ "href=\"%1$s\" target=\"_blank\">some advanced features</a> in Product "
#~ "Recommendations from working correctly. As a workaround, you may enable "
#~ "<strong>Deployments rendering > Use AJAX</strong> under <strong>WooCommerce "
#~ "> Settings > Recommendations</strong> &ndash; but please be aware that doing"
#~ " so will have an impact on server utilization and user experience."
#~ msgstr ""
#~ "A Product Recommendations gyors ellenőrzést végzett az oldalán, és azt "
#~ "találta, hogy a katalógusoldalakat valószínűleg teljes oldalas gyorsítótár "
#~ "szolgálja ki. Ez ugyan gyorsabb élményt biztosít a látogatóinak, de "
#~ "megakadályozza, hogy a Product Recommendations <a href=\"%1$s\" "
#~ "target=\"_blank\">egyes fejlett funkciói</a> megfelelően működjenek. Kerülő "
#~ "megoldásként engedélyezheti a <strong>Deployments rendering > Use "
#~ "AJAX</strong> beállítást a <strong>WooCommerce > Settings > "
#~ "Recommendations</strong> alatt &ndash; de kérjük, vegye figyelembe, hogy ez "
#~ "hatással lesz a szerver terheltségére és a felhasználói élményre."

#~ msgid "Debug Settings"
#~ msgstr "Hibakeresési beállítások"
