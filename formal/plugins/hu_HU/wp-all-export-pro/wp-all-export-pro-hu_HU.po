#. Description of the plugin
#: wp-all-export-pro.php
msgid ""
"Export any post type to a CSV or XML file. Edit the exported data, and then "
"re-import it later using WP All Import."
msgstr ""
"Exportáljon bármilyen bejegyzéstípust CSV vagy XML fájlba. Szerkessze az "
"exportált adatokat, majd importálja vissza később a WP All Importtal."

