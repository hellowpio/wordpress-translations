#. Plugin Name of the plugin
#: divipasswords.php
msgid "DiviPasswords"
msgstr "DiviPasswords"

#. Plugin URI of the plugin
#: divipasswords.php
msgid "https://dondivi.com/divipasswords/"
msgstr "https://dondivi.com/divipasswords/"

#. Description of the plugin
#: divipasswords.php
msgid "Password Protect sections, rows, columns and modules with Divi!"
msgstr ""
"Védje jelszóval a szakaszokat, sorokat, oszlopokat és modulokat a Divivel!"

#. Author of the plugin
#: divipasswords.php
msgid "DonDivi"
msgstr "DonDivi"

#. Author URI of the plugin
#: divipasswords.php
msgid "https://dondivi.com/"
msgstr "https://dondivi.com/"

#: includes/builder.php:6
msgid "Password Protection"
msgstr "Jelszóvédelem"

#: includes/builder.php:7
msgid "Password Protect this content"
msgstr "Tartalom jelszavas védelme"

#: includes/builder.php:26
msgid "Use Padlock Icon"
msgstr "Lakatikon használata"

#: includes/builder.php:27
msgid ""
"Here you can choose whether an icon should be used instead of a custom "
"image."
msgstr "Itt kiválaszthatja, hogy egyéni kép helyett ikont használjon-e."

#: includes/builder.php:35
msgid "Upload an image to display at the top of your form."
msgstr "Töltsön fel egy képet, amely az űrlap tetején jelenik meg."

#: includes/builder.php:44
msgid "Title"
msgstr "Cím"

#: includes/builder.php:45
msgid "Type the form title."
msgstr "Adja meg az űrlap címét."

#: includes/builder.php:47
msgid "RESTRICTED ACCESS"
msgstr "KORLÁTOZOTT HOZZÁFÉRÉS"

#: includes/builder.php:50 includes/builder.php:212
msgid "Password"
msgstr "Jelszó"

#: includes/builder.php:51
msgid "Type the password. If empty, the form will not be displayed."
msgstr "Adja meg a jelszót. Ha üresen hagyja, az űrlap nem jelenik meg."

#: includes/builder.php:56
msgid "Placeholder"
msgstr "Helytartó"

#: includes/builder.php:57
msgid "Type the text you want to use as placeholder for the password field."
msgstr "Adja meg a jelszómező helytartójaként használni kívánt szöveget."

#: includes/builder.php:59
msgid "Enter your password..."
msgstr "Adja meg jelszavát..."

#: includes/builder.php:62
msgid "Error Message"
msgstr "Hibaüzenet"

#: includes/builder.php:63
msgid "Here you can define a custom error message on invalid passwords."
msgstr "Itt adhat meg egyéni hibaüzenetet hibás jelszavak esetére."

#: includes/builder.php:65 includes/builder.php:199
msgid "Invalid Password! Forgot it? Please contact the website administrator."
msgstr "Hibás jelszó! Elfelejtette? Kérjük, lépjen kapcsolatba a honlap adminisztrátorával."

#: includes/builder.php:68
msgid "Button Text"
msgstr "Gomb szöveg"

#: includes/builder.php:69
msgid "Type the button text."
msgstr "Adja meg a gomb szövegét."

#: includes/builder.php:71
msgid "Submit"
msgstr "Küldés"

#: includes/builder.php:74
msgid "Remember Password"
msgstr "Jelszó megjegyzése"

#: includes/builder.php:75
msgid ""
"Here you can choose whether or not the password should be remembered on page"
" reloads."
msgstr "Itt kiválaszthatja, hogy a jelszó megmaradjon-e az oldal újratöltése után."

#: includes/builder.php:81
msgid "Form Color"
msgstr "Űrlap színe"

#: includes/builder.php:82
msgid "Here you can define a custom color for your form elements."
msgstr "Itt adhat meg egyéni színt az űrlap elemeihez."

#: includes/builder.php:243
msgid "An error has occurred, please contact the website administrator"
msgstr "Hiba történt. Kérjük, lépjen kapcsolatba a honlap adminisztrátorával"

#: includes/dondivi/dondivi-admin.php:28
msgid "DonDivi Licensing Page"
msgstr "DonDivi licencoldala"

#: includes/dondivi/dondivi-admin.php:29
#: includes/dondivi/dondivi-admin.php:133
msgid "Licenses"
msgstr "Licencek"

#: includes/dondivi/dondivi-admin.php:55
#: includes/dondivi/dondivi-license.php:15
msgid ""
"Divi is required. Please install and activate Divi in order to use this "
"plugin"
msgstr "A bővítmény használatához telepítse és kapcsolja be a Divi sablont"

#: includes/dondivi/dondivi-admin.php:73
msgid "Settings saved"
msgstr "Beállítások mentve"

#: includes/dondivi/dondivi-admin.php:90
msgid "DonDivi Extra Tools"
msgstr "DonDivi extra eszközök"

#: includes/dondivi/dondivi-admin.php:100
msgid ""
"Inserts a quick link to the Visual Builder below the titles of your pages, "
"posts and layouts."
msgstr "Gyorslinket szúr be az oldalak, bejegyzések és elrendezések címe alá a Visual Builder megnyitásához."

#: includes/dondivi/dondivi-admin.php:111
msgid ""
"This tool provides you a shortcode for each Divi Library layout so that you "
"can use it in your modules."
msgstr "Ez az eszköz shortcode-ot biztosít minden Divi Library-elrendezéshez, amelyet a moduljaiban használhat."

#: includes/dondivi/dondivi-admin.php:117
msgid "Save changes"
msgstr "Módosítások mentése"

#: includes/dondivi/dondivi-admin.php:125
msgid "Help Center"
msgstr "Súgóközpont"

#: includes/dondivi/dondivi-admin.php:129
msgid "Documentation"
msgstr "Dokumentáció"

#: includes/dondivi/dondivi-admin.php:130
msgid "Support"
msgstr "Támogatás"

#: includes/dondivi/dondivi-admin.php:131
msgid "DonDivi Layouts"
msgstr "DonDivi elrendezések"

#: includes/dondivi/dondivi-admin.php:145
#: includes/dondivi/dondivi-license.php:84
msgid "From Spain with "
msgstr "Spanyolországból szeretettel "

#: includes/dondivi/dondivi-admin.php:210
msgid "DonDivi shortcode"
msgstr "DonDivi shortcode"

#: includes/dondivi/dondivi-license.php:61
msgid "License key"
msgstr "Licenckulcs"

#: includes/dondivi/dondivi-license.php:67
msgid "Deactivate"
msgstr "Kikapcsolás"

#: includes/dondivi/dondivi-license.php:69
msgid "Activate"
msgstr "Bekapcsolás"

#: includes/dondivi/dondivi-license.php:71
msgid "Check license"
msgstr "Licenc ellenőrzése"

#: includes/dondivi/dondivi-license.php:113
msgid "This license is active for this URL."
msgstr "Ez a licenc aktív ehhez az URL-hez."

#: includes/dondivi/dondivi-license.php:115
msgid "This license is not active for this URL."
msgstr "Ez a licenc nem aktív ehhez az URL-hez."

#: includes/dondivi/dondivi-license.php:152
#: includes/dondivi/dondivi-license.php:185
msgid "An error occurred, please try again."
msgstr "Hiba történt. Kérjük, próbálja újra."

#: includes/dondivi/dondivi-license.php:163
#, php-format
msgid "Your license key expired on %s."
msgstr "A licenckulcs %s dátumán lejárt."

#: includes/dondivi/dondivi-license.php:169
msgid "Your license key has been disabled."
msgstr "A licenckulcs ki van kapcsolva."

#: includes/dondivi/dondivi-license.php:172
msgid "Invalid license."
msgstr "Érvénytelen licenc."

#: includes/dondivi/dondivi-license.php:176
msgid "Your license is not active for this URL."
msgstr "A licenc nem aktív ehhez az URL-hez."

#: includes/dondivi/dondivi-license.php:179
msgid "This appears to be an invalid license key"
msgstr "Úgy tűnik, hogy a licenckulcs hibás"

#: includes/dondivi/dondivi-license.php:182
msgid "Your license key has reached its activation limit."
msgstr "A licenckulcs elérte a bekapcsolási korlátot."

#: includes/dondivi/dondivi-license.php:195
msgid "You have activated your license."
msgstr "Bekapcsolta a licencét."

#: includes/dondivi/dondivi-license.php:232
msgid ""
"You have deactivated your license. Remember that you need an active license "
"to get automatic upgrades and support."
msgstr "Kikapcsolta a licencét. Ne feledje, hogy az automatikus frissítésekhez és a támogatáshoz aktív licencre van szüksége."
