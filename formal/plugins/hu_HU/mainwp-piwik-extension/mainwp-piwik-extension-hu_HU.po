#. translators: %s: number of duplicate row groups.
#: mainwp-piwik-extension.php:228
#, php-format
msgid ""
"MainWP Matomo could not repair %s group of duplicate rows in its tables, so "
"analytics stay unavailable until it is fixed manually."
msgid_plural ""
"MainWP Matomo could not repair %s groups of duplicate rows in its tables, so"
" analytics stay unavailable until they are fixed manually."
msgstr[0] "A MainWP Matomo nem tudta kijavítani a tábláiban található duplikált sorok %s csoportját, ezért az analitika nem érhető el, amíg manuálisan ki nem javítja a hibát."
msgstr[1] "A MainWP Matomo nem tudta kijavítani a tábláiban található duplikált sorok %s csoportját, ezért az analitika nem érhető el, amíg manuálisan ki nem javítja a hibákat."

