msgstr "Hiányoznak a hitelesítési adatok."

#: class-gf-square.php:892
msgid ""
"No locations found. Please confirm your Square locations support credit card"
" processing with a currency matching Gravity Forms settings."
msgstr "Nem találhatók helyszínek. Kérjük, erősítse meg, hogy a Square-helyszíneken támogatott a hitelkártyás fizetés olyan pénznemben, amely megegyezik a Gravity Forms beállításaival."

#: class-gf-square.php:896
msgid "Invalid authentication data."
msgstr "Hibás hitelesítési adatok."

#: class-gf-square.php:957
msgid "Cannot complete request, please contact us for further assistance."
msgstr "A kérést nem sikerült teljesíteni. Kérjük, további segítségért vegye fel velünk a kapcsolatot."

#: class-gf-square.php:986
msgid "Access denied."
msgstr "Hozzáférés megtagadva."

#: class-gf-square.php:1038
msgid "Unable to revoke token at Square."
msgstr "Nem sikerült visszavonni a tokent a Square-nél."

#: class-gf-square.php:1092
msgid "Payment could not be captured."
msgstr "A fizetést nem sikerült terhelni."

#: class-gf-square.php:1132
msgid "Unable to find entry."
msgstr "Nem található bejegyzés."

#: class-gf-square.php:1139
msgid "Unable to find payment on Square"
msgstr "Nem található fizetés a Square-ben"

#: class-gf-square.php:1144
