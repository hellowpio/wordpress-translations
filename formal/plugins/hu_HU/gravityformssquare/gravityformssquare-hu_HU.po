#. Description of the plugin
#: square.php
msgid ""
"Integrates Gravity Forms with Square, enabling end users to purchase goods "
"and services through Gravity Forms."
msgstr "Összekapcsolja a Gravity Forms bővítményt a Square-rel, így a végfelhasználók a Gravity Forms segítségével vásárolhatnak termékeket és szolgáltatásokat."

#. Author of the plugin
#: square.php
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-square.php:279
msgid ""
"An error occurred while processing your request, please try again later."
msgstr "Hiba történt a kérés feldolgozása közben. Kérjük, próbálja meg később újra."

#: class-gf-square.php:326
msgid "The credit card field will initiate once the payment condition is met."
msgstr "A hitelkártyamező csak a fizetési feltétel teljesülésekor aktiválódik."

#: class-gf-square.php:327
msgid "Please enter a full name."
msgstr "Kérjük, adja meg a teljes nevét."

