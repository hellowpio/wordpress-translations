#: includes/class-gf-square-api.php:490
msgid "This payment has already been refunded"
msgstr "Ezt a fizetést már visszatérítették"

#: includes/class-gf-square-api.php:1045
msgid "The card issuer declined the request because the card is expired."
msgstr "A kártyakibocsátó elutasította a kérést, mert a kártya lejárt."

#: includes/class-gf-square-api.php:1046
msgid "Invalid credit card number."
msgstr "Hibás hitelkártyaszám."

#: includes/class-gf-square-api.php:1047
msgid "Card has insufficient funds."
msgstr "Nincs elegendő fedezet a kártyán."

#: includes/class-gf-square-api.php:1048
msgid "Invalid CVV."
msgstr "Hibás CVV."

#: includes/class-gf-square-api.php:1049
msgid "Invalid postal code."
msgstr "Hibás irányítószám."

#: includes/class-gf-square-api.php:1050 includes/class-gf-square-api.php:1053
msgid "The card expiration date is either missing or incorrectly formatted."
msgstr "A bankkártya lejárati dátuma hiányzik vagy hibás formátumú."

#: includes/class-gf-square-api.php:1051
msgid "The expiration year for the payment card is invalid."
msgstr "A fizetési kártya lejárati éve hibás."

#: includes/class-gf-square-api.php:1052
msgid "The expiration date for the payment card is invalid."
msgstr "A fizetési kártya lejárati dátuma hibás."

#: includes/class-gf-square-api.php:1054
msgid "The card is not supported in the merchant's geographic region."
msgstr "A kártya nem használható a kereskedő földrajzi régiójában."

#: includes/class-gf-square-api.php:1055
msgid "The credit card provided is not from a supported issuer."
msgstr "A megadott hitelkártyát nem támogatott kibocsátó bocsátotta ki."

#: includes/class-gf-square-api.php:1056
msgid ""
"The entry method for the credit card (swipe, dip, tap) is not supported."
msgstr "A hitelkártya használatának módja (lehúzás, chipolvasóba helyezés, érintés) nem támogatott."

#: includes/class-gf-square-api.php:1057
msgid "The card issuer requires that the card be read using a chip reader."
msgstr "A kártyakibocsátó megköveteli, hogy a kártyát chipolvasóval olvassák be."

#: includes/class-gf-square-api.php:1058
msgid "The encrypted card information is invalid."
msgstr "A titkosított kártyaadatok érvénytelenek."

#: includes/class-gf-square-api.php:1059
msgid "The credit card cannot be validated based on the provided details."
msgstr "A megadott részletek alapján nem érvényesíthető a hitelkártya."

#: includes/class-gf-square-api.php:1060
msgid ""
"The card expiration date is either invalid or indicates that the card is "
"expired."
msgstr "A kártya lejárati dátuma hibás, vagy azt jelzi, hogy a kártya lejárt."

#: includes/class-gf-square-api.php:1061 includes/class-gf-square-api.php:1062
msgid "The credit card was decline by the issuer for an unspecified reason."
msgstr "A kártyakibocsátó nem részletezett okból elutasította a hitelkártyát."

#: includes/class-gf-square-api.php:1063 includes/class-gf-square-api.php:1064
msgid "Required Data is missing."
msgstr "Hiányoznak a kötelező adatok."

#: includes/class-gf-square-api.php:1065
msgid "Payment amount is greater than the account supported maximum."
msgstr "A fizetési összeg meghaladja a fiókhoz tartozó maximális összeget."

#: includes/class-gf-square-api.php:1066
msgid "Payment amount is less than the account supported minimum."
msgstr "A fizetési összeg kisebb a fiókhoz tartozó minimális összegnél."

#: includes/class-gf-square-api.php:1067
msgid ""
"The card issuer declined the request because the postal code is invalid."
msgstr "A kártyakibocsátó hibás irányítószám miatt elutasította a kérést."

#: includes/class-gf-square-api.php:1068
msgid ""
"The currency associated with the payment is not valid for the provided "
"funding source."
msgstr "A fizetéshez tartozó pénznem nem érvényes a megadott fizetési forráshoz."

#: includes/class-gf-square-api.php:1069
msgid ""
"The funding source associated with the payment has limitations on how it can"
" be used. For example, it is only valid for specific merchants or "
"transaction types."
msgstr "A fizetéshez tartozó fizetési forrás használata korlátozott. Például csak meghatározott kereskedőknél vagy tranzakciótípusok esetén érvényes."

#: includes/class-gf-square-api.php:1070
msgid "Payments in this region is not allowed."
msgstr "Ebben a régióban nem engedélyezettek a fizetések."

#: includes/class-gf-square-api.php:1071
msgid "The payment amount violates an associated transaction limit."
msgstr "A fizetési összeg sérti a tranzakcióhoz tartozó valamelyik korlátozást."

#: includes/class-gf-square-api.php:1072
msgid ""
"The transaction was declined because the card issuer requires voice "
"authorization from the cardholder."
msgstr "A tranzakciót elutasították, mert a kártyakibocsátó telefonos jóváhagyást kér a kártyabirtokostól."

#: includes/class-gf-square-api.php:1073
msgid "The card issuer declined the request because the PIN is invalid."
msgstr "A kártyakibocsátó hibás PIN-kód miatt elutasította a kérést."

#: includes/class-gf-square-api.php:1074
msgid ""
"The payment was declined because manually keying-in the card information is "
"disallowed. The card must be swiped, tapped, or dipped."
msgstr "A fizetést elutasították, mert a kártyaadatok kézi megadása nem engedélyezett. A kártyát le kell húzni, oda kell érinteni az olvasóhoz, vagy chipolvasóba kell helyezni."

#: includes/class-gf-square-api.php:1075
msgid ""
"The requested payment amount is too high for the provided payment source."
msgstr "A kért fizetési összeg túl magas a megadott fizetési forráshoz."

#: includes/class-gf-square-api.php:1076
msgid "The provided card data is invalid."
msgstr "A megadott kártyaadatok hibásak."

#: includes/class-gf-square-api.php:1077
msgid "The provided email address is invalid."
msgstr "A megadott e-mail cím hibás."

#: includes/class-gf-square-api.php:1078
msgid "The provided phone number is invalid."
msgstr "A megadott telefonszám hibás."

#: includes/class-gf-square-api.php:1079
msgid "The card was declined."
msgstr "A kártyát elutasították."

#: includes/class-gf-square-api.php:1080
msgid "The CVV could not be verified."
msgstr "A CVV-kódot nem sikerült ellenőrizni."

#: includes/class-gf-square-api.php:1081
msgid "The AVS could not be verified."
msgstr "Az AVS-ellenőrzést nem sikerült elvégezni."

#: includes/class-gf-square-api.php:1082
msgid ""
"The payment card was declined with a request for the card holder to call the"
" issuer."
msgstr "A fizetési kártyát elutasították, és arra kérték a kártyabirtokost, hogy hívja fel a kártyakibocsátót."

#: includes/class-gf-square-api.php:1083
msgid ""
"The payment card was declined with a request for additional verification."
msgstr "A fizetési kártyát elutasították, és további ellenőrzést kértek."

#: includes/class-gf-square-api.php:1084
msgid ""
"The card has exhausted its available pin entry retries set by the card "
"issuer. Resolving the error typically requires the card holder to contact "
"the card issuer."
msgstr "A kártyakibocsátó által engedélyezett PIN-kód-megadási próbálkozások elfogytak. A hiba megoldásához általában a kártyabirtokosnak fel kell vennie a kapcsolatot a kártyakibocsátóval."

#: includes/class-gf-square-api.php:1085
msgid "The requested refund amount exceeds the amount available to refund."
msgstr "A kért visszatérítési összeg meghaladja a visszatérítésre rendelkezésre álló összeget."

#: includes/class-gf-square-api.php:1086
msgid "The payment already has a pending refund."
msgstr "A fizetéshez már tartozik egy függőben lévő visszatérítés."

#: includes/class-gf-square-api.php:1087
msgid ""
"The payment is not refundable. For example, a previous refund has already "
"been rejected and no new refunds can be accepted."
msgstr "A fizetés nem téríthető vissza. Például egy korábbi visszatérítést már elutasítottak, ezért újabb visszatérítés nem fogadható el."

#: includes/class-gf-square-api.php:1088
msgid "The card issuer declined the refund.."
msgstr "A kártyakibocsátó elutasította a visszatérítést."

#: includes/class-gf-square-api.php:1095
msgid "An error occurred while processing your request."
msgstr "Hiba történt a kérés feldolgozása közben."

#: includes/class-square-subscriptions-handler.php:346
#: includes/class-square-subscriptions-handler.php:447
msgid "Please provide a valid email address"
msgstr "Kérjük, adjon meg érvényes e-mail címet."

#: includes/class-square-subscriptions-handler.php:418
msgid "Unable to retrieve subscription"
msgstr "Az előfizetés nem kérhető le"

#: includes/class-square-subscriptions-handler.php:594
msgid "An unknown error has occurred."
msgstr "Ismeretlen hiba történt."
