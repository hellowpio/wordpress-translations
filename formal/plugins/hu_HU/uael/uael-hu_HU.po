#: modules/modal-popup/widgets/modal-popup.php:1642
msgid "Global (All Pages)"
msgstr "Globális (összes oldal)"

#: modules/modal-popup/widgets/modal-popup.php:1643
msgid "Current Page Only"
msgstr "Csak az aktuális oldal"

#: modules/modal-popup/widgets/modal-popup.php:1649
msgid "Choose how page views are counted for this popup."
msgstr "Válassza ki, hogyan számoljuk az oldalmegtekintéseket ennél a felugró ablaknál."

#: modules/modal-popup/widgets/modal-popup.php:1656
msgid "Show After X Page Views"
msgstr "Megjelenítés X oldalmegtekintés után"

#: modules/modal-popup/widgets/modal-popup.php:1665
msgid ""
"Display the popup after the visitor has viewed a specific number of pages on"
" your site. Page views are counted per browser session."
msgstr "A felugró ablak jelenjen meg, miután a látogató az Ön webhelyén meghatározott számú oldalt megtekintett. Az oldalmegtekintéseket böngésző-munkamenetenként számoljuk."

#: modules/modal-popup/widgets/modal-popup.php:1673
msgid ""
"Note: Page views are tracked using the browsers local storage and will reset"
" if the browser data is cleared. This condition works independently of other"
" display rules."
msgstr "Megjegyzés: Az oldalmegtekintéseket a böngésző helyi tárhelyének használatával követjük, és nullázódnak, ha törlik a böngésző adatait. Ez a feltétel a többi megjelenítési szabálytól függetlenül működik."

#: modules/modal-popup/widgets/modal-popup.php:1685
msgid "Sessions Settings"
msgstr "Munkamenet-beállítások"

#: modules/modal-popup/widgets/modal-popup.php:1697
msgid "Enable Sessions"
msgstr "Munkamenetek bekapcsolása"

#: modules/modal-popup/widgets/modal-popup.php:1703
msgid ""
"Show popup only after visitor has completed a specific number of browser "
"sessions."
msgstr "A felugró ablak csak akkor jelenjen meg, ha a látogató már meghatározott számú böngésző-munkameneten van túl."

#: modules/modal-popup/widgets/modal-popup.php:1713
msgid "Show After X Sessions"
msgstr "Megjelenítés X munkamenet után"

#: modules/modal-popup/widgets/modal-popup.php:1722
msgid ""
"The popup will show after the visitor completes the set number of browser "
"sessions. A new session starts when they reopen your site in a new browser "
"window."
msgstr "A felugró ablak akkor jelenik meg, amikor a látogató már a beállított számú böngésző-munkameneten van túl. Új munkamenet indul, amikor a látogató új böngészőablakban újra megnyitja az Ön webhelyét."

#: modules/modal-popup/widgets/modal-popup.php:1730
msgid ""
"Note: Sessions track unique browser visits to your website. A new session "
"starts when a visitor opens your site in a new browser session. Multiple "
"pages viewed in the same session count as one session. Sessions are tracked "
"using browser storage and reset when browser data is cleared."
msgstr "Megjegyzés: A munkamenetek a webhelyre érkező egyedi böngészőlátogatásokat követik nyomon. Új munkamenet indul, amikor a látogató a webhelyet új böngésző-munkamenetben nyitja meg. Az ugyanazon munkamenetben megtekintett több oldal egy munkamenetnek számít. A munkamenetek követésére a böngésző tárhelyét használjuk, a böngészőadatok törlésekor pedig a munkamenetek számlálása nullázódik."

