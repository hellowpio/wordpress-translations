msgid "Connected to Dropbox."
msgstr "Kapcsolódva a Dropboxhoz."

#: class-gf-dropbox.php:915 class-gf-dropbox.php:926
msgid ""
"The connected Dropbox app is disabled or has been deleted. Please reconnect."
msgstr "A csatlakoztatott Dropbox-alkalmazás ki van kapcsolva vagy törölve lett. Kérjük, csatlakozzon újra."

#: class-gf-dropbox.php:920 class-gf-dropbox.php:929
msgid "Reconnect to Dropbox"
msgstr "Újracsatlakozás a Dropboxhoz"

#: class-gf-dropbox.php:963
msgid "OAuth Redirect URI"
msgstr "OAuth átirányítási URI"

#: class-gf-dropbox.php:976
msgid "App Key"
msgstr "Alkalmazáskulcs"

#: class-gf-dropbox.php:987
msgid "App Secret"
msgstr "Alkalmazás titka"

#: class-gf-dropbox.php:1003
msgid "Click here to connect to Dropbox."
msgstr "Kattintson ide a Dropboxhoz való csatlakozáshoz."

#: class-gf-dropbox.php:1054 class-gf-dropbox.php:1059
#: class-gf-dropbox.php:1118 class-gf-dropbox.php:1123
#: class-gf-dropbox.php:2860 class-gf-dropbox.php:2865
msgid "Access denied."
msgstr "Hozzáférés megtagadva."

#: class-gf-dropbox.php:1150
msgid "Dropbox Feed Settings"
msgstr "Dropbox-adatfolyam beállításai"

#: class-gf-dropbox.php:1157 class-gf-dropbox.php:1161
#: class-gf-dropbox.php:1307
msgid "Name"
msgstr "Név"

#: class-gf-dropbox.php:1162
msgid "Enter a feed name to uniquely identify this setup."
msgstr "Adjon meg egy feednevet, amellyel egyedileg azonosítható ez a beállítás."

#: class-gf-dropbox.php:1169 class-gf-dropbox.php:1174
msgid "File Upload Field"
msgstr "Fájlfeltöltési mező"

#: class-gf-dropbox.php:1175
msgid ""
"Select the specific File Upload field that you want to be uploaded to "
"Dropbox."
msgstr "Válassza ki azt a fájlfeltöltési mezőt, amelyben megadott fájlokat fel szeretné tölteni a Dropboxba."

#: class-gf-dropbox.php:1182 class-gf-dropbox.php:1308
msgid "Destination Folder"
msgstr "Célmappa"

#: class-gf-dropbox.php:1184
msgid ""
"Select the folder in your Dropbox account where the files will be uploaded "
"to.  By default, all files are stored in the \"Gravity Forms Add-On\" folder"
" within the Dropbox Apps folder in your Dropbox account."
msgstr "Válassza ki a Dropbox-fiókjában azt a mappát, ahová feltölti a fájlokat. Alapértelmezés szerint az összes fájl a Dropbox-fiók Dropbox Apps mappájában található „Gravity Forms Add-On” mappába kerül."

#: class-gf-dropbox.php:1189
msgid "Upload Condition"
msgstr "Feltöltési feltétel"

#: class-gf-dropbox.php:1190
msgid "Enable Condition"
msgstr "Feltétel engedélyezése"

#: class-gf-dropbox.php:1191
msgid "Upload to Dropbox if"
msgstr "Feltöltés a Dropboxba, ha"

#: class-gf-dropbox.php:1344
#, php-format
msgid ""
"You must add a File Upload field to your form before creating a feed. Let's "
"go %sadd one%s!"
msgstr "Az adatfolyam létrehozása előtt adjon hozzá egy fájlfeltöltési mezőt az űrlaphoz. %sAdjon hozzá egyet%s!"

#: class-gf-dropbox.php:1362
msgid "All File Upload Fields"
msgstr "Összes fájlfeltöltési mező"

#: class-gf-dropbox.php:1648
msgid "Link Type"
msgstr "Hivatkozás típusa"

#: class-gf-dropbox.php:1651
msgid "Preview"
msgstr "Előnézet"

#: class-gf-dropbox.php:1654
msgid "Direct"
msgstr "Közvetlen"

#: class-gf-dropbox.php:1660
msgid "Allow multiple files to be selected"
msgstr "Több fájl kiválasztásának engedélyezése"

#: class-gf-dropbox.php:1710 class-gf-dropbox.php:1941
msgid "Feed was not processed because API was not initialized."
msgstr "Az adatfolyam feldolgozása nem történt meg, mert az API nincs inicializálva."

