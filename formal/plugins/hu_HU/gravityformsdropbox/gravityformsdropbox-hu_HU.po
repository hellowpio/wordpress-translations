#. Plugin Name of the plugin
#: dropbox.php
msgid "Gravity Forms Dropbox Add-On"
msgstr "Gravity Forms Dropbox Add-On"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: dropbox.php
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
#: dropbox.php
msgid ""
"Integrates Gravity Forms with Dropbox, enabling end users to upload files to"
" Dropbox through Gravity Forms."
msgstr "A Gravity Forms és a Dropbox integrációja, amely lehetővé teszi a felhasználók számára, hogy fájlokat töltsenek fel a Dropboxba a Gravity Forms segítségével."

#. Author of the plugin
#: dropbox.php
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-dropbox.php:273
msgid "Upload files to Dropbox only when payment is received."
msgstr "Fájlok feltöltése a Dropboxba csak a fizetés beérkezése után."

#: class-gf-dropbox.php:500
msgid "Unable to connect to Dropbox due to mismatched state."
msgstr "Nem sikerült csatlakozni a Dropboxhoz, mert az állapot nem egyezik."

#: class-gf-dropbox.php:575 class-gf-dropbox.php:585 class-gf-dropbox.php:1064
msgid "Unable to connect to Dropbox."
msgstr "Nem sikerült csatlakozni a Dropboxhoz."

#. Translators: 1. Link to forms list page, 2. Closing </a> tag.
#: class-gf-dropbox.php:755
#, php-format
msgid ""
"To configure Dropbox with your form(s), choose a form you wish to use "
"Dropbox with from the %sforms list page%s, and select Dropbox from the form "
"settings menu."
msgstr "Ha a Dropboxot szeretné beállítani az űrlapokhoz, válassza ki az űrlapok listájának %soldalán%s azt az űrlapot, amelyet a Dropboxszal szeretne használni, majd az űrlapbeállítások menüjében válassza a Dropbox lehetőséget."

#: class-gf-dropbox.php:765
msgid "Disconnect from Dropbox"
msgstr "Kapcsolat bontása a Dropboxszal"

#: class-gf-dropbox.php:775
msgid "Unable to get account information."
msgstr "Nem sikerült lekérni a fiókadatokat."

#: class-gf-dropbox.php:787
msgid ""
"To use a custom Dropbox app, you must have an SSL certificate installed and "
"enabled. Visit this page after configuring your SSL certificate to use a "
"custom Dropbox app."
msgstr "Egyéni Dropbox-alkalmazás használatához telepített és bekapcsolt SSL-tanúsítványra van szükség. Az egyéni Dropbox-alkalmazás használatához az SSL-tanúsítvány beállítása után látogasson el erre az oldalra."

#: class-gf-dropbox.php:792
#, php-format
msgid "%sI do not want to use a custom Dropbox app.%s"
msgstr "%sNem szeretnék egyéni Dropbox-alkalmazást használni.%s"

#: class-gf-dropbox.php:814
msgid ""
"The Dropbox Add-On allows you to quickly integrate Gravity Forms with "
"Dropbox, one of the industry leaders in file storage solutions in the cloud."
"  Allow users to upload files from their Dropbox account or send files "
"uploaded via Gravity Forms to your own Dropbox account."
msgstr "A Dropbox-kiegészítővel gyorsan integrálhatja a Gravity Formsot a Dropboxszal, amely a felhőalapú fájltárolás egyik piacvezető szolgáltatása. Engedélyezze a felhasználóknak, hogy fájlokat töltsenek fel a Dropbox-fiókjukból, vagy küldje a Gravity Forms segítségével feltöltött fájlokat a saját Dropbox-fiókjába."

#. Translators: 1. Link to Dropbox, 2. Closing </a> tag.
#: class-gf-dropbox.php:818
#, php-format
msgid "If you don't have a Dropbox account, you can %ssign up for one here%s."
msgstr "Ha még nincs Dropbox-fiókja, %sitt regisztrálhat egyet%s."

#: class-gf-dropbox.php:836
#, php-format
msgid ""
"%sI want to use a custom Dropbox app.%s (Recommended for advanced users "
"only.)"
msgstr "%sEgyéni Dropbox-alkalmazást szeretnék használni.%s (Csak haladó felhasználóknak ajánlott.)"

#: class-gf-dropbox.php:842
msgid "Connect to Dropbox"
msgstr "Csatlakozás a Dropboxhoz"

#: class-gf-dropbox.php:877 class-gf-dropbox.php:893
msgid "Connected to Dropbox as: "
msgstr "Kapcsolódva a Dropboxhoz a következő néven: "

