#. Plugin Name of the plugin
#: trello.php
msgid "Gravity Forms Trello Add-On"
msgstr "Gravity Forms Trello Add-On"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: trello.php
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
#: trello.php
msgid "Integrates Gravity Forms with Trello"
msgstr "Összekapcsolja a Gravity Forms bővítményt a Trellóval"

#. Author of the plugin
#: trello.php
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-trello.php:227
msgid "Create Trello card only when payment is received."
msgstr "Trello-kártya létrehozása csak a fizetés beérkezésekor."

#: class-gf-trello.php:265
msgid "Access denied."
msgstr "Hozzáférés megtagadva."

#: class-gf-trello.php:295
msgid "Unable to revoke token at Trello."
msgstr "Nem sikerült visszavonni a tokent a Trellónál."

#: class-gf-trello.php:322
msgid "Unable to connect to Trello due to mismatched state."
msgstr "Nem sikerült csatlakozni a Trellóhoz, mert az állapot nem egyezik."

#: class-gf-trello.php:329
msgid "Unable to connect your Trello account."
msgstr "Nem sikerült csatlakozni az Ön Trello-fiókjához."

#: class-gf-trello.php:490
msgid "Authorize with Trello"
msgstr "Engedélyezés a Trellóval"

#: class-gf-trello.php:542
msgid "Click here to authenticate your Trello account."
msgstr "Kattintson ide Trello-fiókja hitelesítéséhez."

#. translators: %s: Trello workspace name.
#: class-gf-trello.php:553
#, php-format
msgid "Trello has been authenticated with the %s workspace."
msgstr "A Trello hitelesítése megtörtént a(z) %s munkaterülettel."

#: class-gf-trello.php:558
msgid "Trello has been authenticated with your account."
msgstr "A Trello hitelesítése megtörtént az Ön fiókjával."

#: class-gf-trello.php:563
msgid "De-Authorize Trello"
msgstr "Trello-hitelesítés visszavonása"

#: class-gf-trello.php:697
msgid "Feed Name"
msgstr "Feed neve"

#: class-gf-trello.php:704 class-gf-trello.php:738 class-gf-trello.php:1212
msgid "Name"
msgstr "Név"

#: class-gf-trello.php:705
msgid "Enter a feed name to uniquely identify this setup."
msgstr "Adjon meg egy feednevet, amellyel egyedileg azonosítható ez a beállítás."

#: class-gf-trello.php:710 class-gf-trello.php:1213
msgid "Trello Board"
msgstr "Trello-tábla"

#: class-gf-trello.php:715
msgid "You must have at least one Trello board in your account."
msgstr "Legalább egy Trello-táblának kell lennie az Ön fiókjában."

#: class-gf-trello.php:719 class-gf-trello.php:1214
msgid "Trello List"
msgstr "Trello-lista"

#: class-gf-trello.php:725
msgid "You must select a Trello board containing lists."
msgstr "Olyan Trello-táblát kell kiválasztania, amely listákat tartalmaz."

#: class-gf-trello.php:730
msgid "Card Settings"
msgstr "Kártyabeállítások"

#: class-gf-trello.php:746
msgid "Description"
msgstr "Leírás"

#: class-gf-trello.php:751
msgid "Due Date"
msgstr "Esedékesség dátuma"

#: class-gf-trello.php:752
msgid "days after today"
msgstr "nap múlva"

#: class-gf-trello.php:759
msgid "Labels"
msgstr "Feliratok"

#: class-gf-trello.php:765
msgid "Members"
msgstr "Tagok"

#: class-gf-trello.php:771
msgid "Feed Conditional Logic"
msgstr "Adatfolyam feltételes logikája"

#: class-gf-trello.php:777 class-gf-trello.php:782
msgid "Conditional Logic"
msgstr "Feltételes logika"

#: class-gf-trello.php:778
msgid "Enable"
msgstr "Bekapcsolás"

#: class-gf-trello.php:779
msgid "Export to Trello if"
msgstr "Exportálás a Trellóra, ha"

#: class-gf-trello.php:783
msgid ""
"When conditional logic is enabled, form submissions will only be exported to"
" Trello when the condition is met. When disabled, all form submissions will "
"be posted."
msgstr "Ha a feltételes logika be van kapcsolva, az űrlapbeküldések csak a feltétel teljesülésekor lesznek exportálva a Trellóra. Kikapcsolt állapotban minden űrlapbeküldés közzétételre kerül."

#: class-gf-trello.php:800
msgid "Attachments"
msgstr "Mellékletek"

#: class-gf-trello.php:861
msgid "Select a Board"
msgstr "Tábla kiválasztása"

#: class-gf-trello.php:931
msgid "Select a List"
msgstr "Válasszon egy listát"

#: class-gf-trello.php:1313
msgid "Card was not created because API could not be initialized."
msgstr "A kártya nem jött létre, mert az API-t nem sikerült inicializálni."

#: class-gf-trello.php:1384
msgid "Card could not be created because no name was provided."
msgstr "A kártya nem hozható létre, mert nem adtak meg nevet."

#: class-gf-trello.php:1398
#, php-format
msgid "Card created. ID: %s."
msgstr "A kártya létrejött. ID: %s."

#: class-gf-trello.php:1403 class-gf-trello.php:1412
msgid "Card could not be created."
msgstr "A kártyát nem sikerült létrehozni."

#: class-gf-trello.php:1437
msgid "Label could not be added to card."
msgstr "Nem sikerült címkét hozzáadni a kártyához."

#. translators: %s: The file URL.
#: class-gf-trello.php:1490
#, php-format
msgid "Not attaching file URL: %s."
msgstr "A fájl URL-jének csatolása elmarad: %s."

#: class-gf-trello.php:1502
#, php-format
msgid "File \"%s\" could not be attached to card. %s"
msgstr "A(z) „%s” fájlt nem sikerült csatolni a kártyához. %s"

#. translators: 1: open <a> tag, 2: close </a> tag
#: class-gf-trello.php:1565
#, php-format
msgid ""
"Gravity Forms Trello requires re-authentication; %1$sPlease disconnect and "
"re-connect%2$s to continue using this add-on."
msgstr "A Gravity Forms Trello újbóli hitelesítést igényel; a kiegészítő további használatához kérjük, %1$sszüntesse meg a kapcsolatot, majd csatlakozzon újra%2$s."
