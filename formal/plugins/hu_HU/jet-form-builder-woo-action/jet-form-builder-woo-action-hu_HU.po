#: includes/ActionTrait.php:262
msgid "Link text"
msgstr "Hivatkozás szövege"

#: includes/ActionTrait.php:263 assets/build/builder.editor.js:1
msgid "Heading for Order Details"
msgstr "Rendelési adatok címsora"

#: includes/ActionTrait.php:264 assets/build/builder.editor.js:1
msgid "Secure payment amount"
msgstr "Biztonságos fizetési összeg"

