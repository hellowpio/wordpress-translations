#: assets/build/builder.editor.js:1
msgid ""
"The `Redirect to Page` action can't use the `WC.ORDER.COMPLETE` and "
"`WC.CHECKOUT.COMPLETE` events."
msgstr ""
"A `Redirect to Page` művelet nem használhatja a `WC.ORDER.COMPLETE` és "
"`WC.CHECKOUT.COMPLETE` eseményeket."

#: assets/build/builder.editor.js:1
msgid "WooCommerce order details"
msgstr "WooCommerce rendelési adatok"

#: assets/build/builder.editor.js:1
msgid "Set up"
msgstr "Beállítás"

#: assets/build/builder.editor.js:1
msgid "Set up info you want to add to the WooCommerce orders and e-mails"
msgstr ""
"Adja meg a WooCommerce rendelésekhez és e-mailekhez hozzáadni kívánt "
"információkat"
