msgstr "A képre mutatáskor megjelenő fedvény színátmenetének alsó színe"

#: includes/options/extra.php:678
msgid "Controls the bottom color of the image rollover background."
msgstr "A képre mutatáskor megjelenő fedvény hátterének alsó színét szabályozza."

#: includes/options/extra.php:692
