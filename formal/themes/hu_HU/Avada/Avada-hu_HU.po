msgstr "Kapcsolja be, ha meg szeretné jeleníteni a rácsnézet és a listanézet közötti váltási lehetőséget a fő boltoldalon és az archív boltoldalakon."

#: includes/options/woocommerce.php:583
msgid "WooCommerce Product Default View"
msgstr "WooCommerce-termékek alapértelmezett nézete"

#: includes/options/woocommerce.php:584
msgid "Sets the default product view for shop page and product archive pages."
msgstr "Beállítja a boltoldal és a termékarchívum-oldalak alapértelmezett terméknézetét."

#: includes/options/woocommerce.php:589
msgid "List"
msgstr "Lista"

#: includes/options/woocommerce.php:593
msgid "WooCommerce Load Cart Fragments Script"
msgstr "WooCommerce Cart Fragments szkript betöltése"

