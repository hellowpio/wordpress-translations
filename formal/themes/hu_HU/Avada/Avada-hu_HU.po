msgstr "WooCommerce mennyiségi mező háttérszíne"

#: includes/options/woocommerce.php:781
msgid "Controls the background color of the WooCommerce quantity box."
msgstr "A WooCommerce mennyiségi mező háttérszínét szabályozza."

#: includes/options/woocommerce.php:793
msgid "WooCommerce Quantity Box Hover Background Color"
msgstr "WooCommerce mennyiségi mező háttérszíne rámutatáskor"

#: includes/options/woocommerce.php:794
msgid "Controls the hover color of the WooCommerce quantity box."
msgstr "A WooCommerce mennyiségi mező rámutatáskor érvényes színét szabályozza."

#: includes/options/woocommerce.php:806
msgid "WooCommerce Order Dropdown Background Color"
msgstr "WooCommerce sorrendválasztó legördülő menü háttérszíne"

#: includes/options/woocommerce.php:807
msgid "Controls the background color of the WooCommerce order dropdowns."
