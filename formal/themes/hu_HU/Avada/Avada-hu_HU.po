msgstr "Kapcsolja be a kosárikon megjelenítéséhez a főmenüben. Nem kompatibilis az Ubermenu-val."

#: includes/options/woocommerce.php:425
msgid "WooCommerce Menu Cart Icon Counter"
msgstr "WooCommerce menüben megjelenő kosárikon számlálója"

#: includes/options/woocommerce.php:426
