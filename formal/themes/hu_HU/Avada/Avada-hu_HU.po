msgstr "ToTop gomb pozíciója"

#: includes/options/extra.php:1137
msgid ""
"Controls the position of the ToTop button. On mobiles also non-floating "
"layouts will be floating."
msgstr ""
"A ToTop gomb pozícióját szabályozza. Mobilon a nem lebegő elrendezések is "
"lebegők lesznek."

#: includes/options/extra.php:1143
msgid "Left Floating"
msgstr "Balra lebegő"

#: includes/options/extra.php:1145
msgid "Right Floating"
msgstr "Jobbra lebegő"

#: includes/options/extra.php:1173
msgid "ToTop Border Radius"
msgstr "ToTop gomb sarkainak lekerekítése"

#: includes/options/extra.php:1174
msgid ""
"Controls the border radius of the ToTop button. For non-floating layouts the"
" border radius will only apply to the upper corners."
msgstr ""
"A ToTop gomb sarkainak lekerekítését szabályozza. Nem lebegő elrendezéseknél"
" a lekerekítés csak a felső sarkokra érvényes."

#: includes/options/extra.php:1199
msgid "ToTop Background"
msgstr "ToTop háttere"

#: includes/options/extra.php:1200
msgid "Controls the background color of the ToTop button."
msgstr "A ToTop gomb háttérszínét szabályozza."

#: includes/options/extra.php:1220
msgid "ToTop Background Hover Color"
msgstr "ToTop háttérszíne rámutatáskor"

#: includes/options/extra.php:1221
msgid "Controls the background hover color of the ToTop button."
msgstr "A ToTop gomb rámutatáskor használt háttérszínét szabályozza."

#: includes/options/extra.php:1241
msgid "ToTop Icon Color"
msgstr "ToTop ikon színe"

#: includes/options/extra.php:1242
msgid "Controls the icon color color of the ToTop button."
msgstr "A ToTop gomb ikonjának színét szabályozza."

#: includes/options/extra.php:1262
msgid "ToTop Icon Hover Color"
msgstr "ToTop ikon színe rámutatáskor"

#: includes/options/extra.php:1263
msgid "Controls the icon hover color of the ToTop button."
msgstr "A ToTop gomb ikonjának rámutatáskor használt színét szabályozza."

#: includes/options/extra.php:1283
msgid "ToTop Show Scroll Progress"
msgstr "A görgetés előrehaladásának megjelenítése a ToTop gombon"

#: includes/options/extra.php:1284
msgid "Turn on to show the page scroll progress within the ToTop Button."
msgstr "Kapcsolja be, hogy a ToTop gombon az oldal görgetésének előrehaladása is megjelenjen."

#: includes/options/extra.php:1323
msgid "ToTop Show on Scroll Down Only"
msgstr "ToTop megjelenítése csak lefelé görgetéskor"

#: includes/options/extra.php:1324
msgid ""
"Turn on to show the ToTop button on scroll down only. Otherwise it will "
"always show if the page is scrolled."
msgstr "Kapcsolja be, hogy a ToTop gomb csak lefelé görgetéskor jelenjen meg. Egyébként az oldal görgetése után mindig megjelenik."

#: includes/options/footer.php:60
msgid "Footer Content"
msgstr "Lábléc tartalom"

#. translators: %1$s: Content|Footer|Page Title Bar. %2$s: Layout selection
