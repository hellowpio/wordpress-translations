msgid "Query loop"
msgstr "Lekérdezési ciklus"

#: includes/abilities/element-settings-schema.php:242
msgid "Enable a query loop on this layout element."
msgstr "Lekérdezési ciklus bekapcsolása ennél az elrendezéselemnél."

