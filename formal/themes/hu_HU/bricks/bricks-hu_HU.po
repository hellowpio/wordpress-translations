#: includes/elements/code.php:185 includes/elements/svg.php:79
#: includes/unified-global-transfer.php:227
msgid "Code execution"
msgstr "Kód végrehajtása"

#: includes/admin/admin-screen-settings.php:3154
msgid "Allow specific user roles or individual users to execute code."
msgstr ""
"Engedélyezze meghatározott felhasználói szerepköröknek vagy egyes "
"felhasználóknak a kód végrehajtását."

#: includes/admin/admin-screen-settings.php:3171
#, php-format
msgid ""
"Code execution has been explicitly disabled by the %s filter. This filter is"
" currently overriding your Bricks settings."
msgstr "A %s szűrő kifejezetten letiltotta a kód végrehajtását. Ez a szűrő jelenleg felülírja a Bricks beállításait."

#: includes/admin/admin-screen-settings.php:3177
msgid "Enable code execution"
msgstr "Kódvégrehajtás bekapcsolása"

#: includes/admin/admin-screen-settings.php:3182
msgid ""
"Exercise great caution with granting code execution privileges. Enable them "
"sparingly and only for trusted roles or ideally only specific users. Grant "
"the least permissions necessary to maintain tight security."
msgstr "Járjon el rendkívüli körültekintéssel a kódvégrehajtási jogosultságok megadásakor. Csak takarékosan, és kizárólag megbízható szerepköröknek, ideális esetben pedig csak konkrét felhasználóknak engedélyezze. A lehető legkevesebb jogosultságot adja meg a szoros biztonság fenntartása érdekében."

#: includes/admin/admin-screen-settings.php:3184
#, php-format
msgid ""
"Function names called through the \"echo\" tag must be whitelisted via the "
"%s filter."
msgstr "Az „echo” címkén keresztül meghívott függvényneveket a %s szűrővel kell felvenni az engedélyezési listára."

#: includes/admin/admin-screen-settings.php:3186
msgid "User roles with code execution capability"
msgstr "Kódfuttatási jogosultsággal rendelkező felhasználói szerepkörök"

#: includes/admin/admin-screen-settings.php:3215
msgid "Individual users with code execution capability"
msgstr "Kódfuttatási jogosultsággal rendelkező egyéni felhasználók"

#: includes/admin/admin-screen-settings.php:3233
msgid ""
"Set code execution capability for individual users by editing their user "
"profile."
msgstr ""
"Állítsa be az egyes felhasználók kódfuttatási jogosultságát a felhasználói "
"profiljuk szerkesztésével."

#: includes/admin/admin-screen-settings.php:3247
msgid ""
"Code that requires execution only runs when it has a valid code signature."
msgstr ""
"A végrehajtást igénylő kód csak akkor fut, ha érvényes kódaláírással "
"rendelkezik."

#: includes/admin/admin-screen-settings.php:3248
msgid ""
"Regenerate code signatures whenever your WordPress salts (secret keys) "
"change."
msgstr "Regenerálja a kódaláírásokat, valahányszor megváltoznak a WordPress-sók (titkos kulcsok)."

#: includes/admin/admin-screen-settings.php:3252
msgid ""
"Please create a full-site backup and perform a \"Code review\" (see above) "
"before generating code signatures globally."
msgstr "Kérjük, készítsen biztonsági mentést a teljes webhelyről, és végezzen kódellenőrzést (lásd fent) a kódaláírások globális létrehozása előtt."

#: includes/admin/admin-screen-settings.php:3260
msgid ""
"Valid code signatures are required for all Code (element), SVG (element) and"
" Query editor instances to run."
msgstr ""
"Érvényes kódaláírás szükséges az összes Kód (elem), SVG (elem) és Lekérdezés"
" szerkesztő példány futtatásához."

#: includes/admin/admin-screen-settings.php:3265
msgid "Regenerate code signatures"
msgstr "Kódaláírások újragenerálása"

#: includes/admin/admin-screen-settings.php:3285
msgid ""
"Custom CSS and JavaScript added below are loaded on your entire website."
msgstr ""
"Az alább hozzáadott egyedi CSS és JavaScript a teljes webhelyen betöltődik."

#: includes/admin/admin-screen-settings.php:3285
msgid "Use the builder to add custom code to a specific page."
msgstr ""
"Használja a Buildert, hogy egy adott oldalhoz egyedi kódot adjon hozzá."

