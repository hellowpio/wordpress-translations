#. Theme Name of the theme
#. Author of the theme
#: style.css includes/builder.php:1122
msgid "Bricks"
msgstr "Bricks"

#. Theme URI of the theme
#. Author URI of the theme
#: style.css
msgid "https://bricksbuilder.io/"
msgstr "https://bricksbuilder.io/"

#. Description of the theme
#: style.css
msgid "Visual website builder for WordPress."
msgstr "Vizuális weboldal-készítő WordPresshez."

#: 404.php:10
msgid "Whoops, that page is gone"
msgstr "Hoppá, az az oldal már nem elérhető"

#. translators: %1$s: Bricks (theme name), %2$s: PHP version
#: functions.php:237
#, php-format
msgid "%1$s requires PHP version %2$s+."
msgstr "%1$s %2$s+ verziójú PHP-t igényel."

#: includes/abilities/agent-file.php:35
msgid ""
"Return a compact authoritative summary by default. Use document only when "
"the complete canonical readback is required."
msgstr "Alapértelmezés szerint adjon tömör, hiteles összefoglalót. Csak akkor használjon dokumentumot, ha a teljes, kanonikus visszaolvasás szükséges."

#: includes/abilities/breakpoints.php:88
msgid ""
"Whether the site is using custom breakpoints instead of Bricks defaults. "
"Writable through `bricks/set-breakpoints` via `customEnabled`, not through "
"`bricks/set-global-settings`."
msgstr "Annak jelzése, hogy a webhely a Bricks alapértelmezett töréspontjai helyett egyéni töréspontokat használ-e. A `bricks/set-breakpoints` végponton keresztül, a `customEnabled` használatával írható; a `bricks/set-global-settings` végponton keresztül nem."

#: includes/abilities/breakpoints.php:92
msgid ""
"True when the smallest breakpoint is the `base`. CSS is emitted with min-"
"width rules."
msgstr "Igaz, ha a legkisebb töréspont az `base`. A CSS min-width szabályokkal készül."

#: includes/abilities/breakpoints.php:96
msgid "Key of the base breakpoint."
msgstr "Az alap töréspont kulcsa."

#: includes/abilities/breakpoints.php:100
msgid "Width in pixels of the base breakpoint."
msgstr "Az alap töréspont szélessége képpontban."

#: includes/abilities/breakpoints.php:104
msgid ""
"All breakpoints, sorted by width according to the active paradigm. Each row "
"has { key, label, width, icon, base? }."
msgstr "Az összes töréspont szélesség szerint, az aktív működési elvnek megfelelően rendezve. Minden sor a következőket tartalmazza: { key, label, width, icon, base? }."

#: includes/abilities/breakpoints.php:108
msgid "The built-in default breakpoints (reference for reset operations)."
msgstr "A beépített alapértelmezett töréspontok (az alaphelyzetbe állítási műveletek referenciája)."

#: includes/abilities/breakpoints.php:128
msgid ""
"Full replacement set of breakpoints. Each row requires { key (string), label"
" (string), width (integer ≥ 0) } and may include { icon (string), base "
"(boolean) }. Exactly one row must be `base: true`. Keys must be unique."
msgstr "A töréspontok teljes lecserélésére szolgáló készlet. Minden sorban kötelező a { key (string), label (string), width (integer ≥ 0) }; emellett tartalmazhatja a következőt: { icon (string), base (boolean) }. Pontosan egy sorban kell szerepelnie a `base: true` értéknek. A kulcsoknak egyedinek kell lenniük."

#: includes/abilities/breakpoints.php:146
msgid ""
"Optional master toggle for custom breakpoints. Omit to leave the current "
"toggle unchanged. Set true to apply the stored custom set, or false to make "
"Bricks fall back to its built-in defaults."
msgstr "Opcionális főkapcsoló az egyéni töréspontokhoz. Ha nincs megadva, az aktuális beállítás változatlan marad. Állítsa true értékre a tárolt egyéni készlet alkalmazásához, false értékre pedig ahhoz, hogy a Bricks visszatérjen a beépített alapértelmezésekhez."

#: includes/abilities/breakpoints.php:150
msgid ""
"Required breakpoint ownership envelope returned by the latest `bricks/list-"
"breakpoints` or `bricks/set-breakpoints` response."
msgstr "A legutóbbi `bricks/list-breakpoints` vagy `bricks/set-breakpoints` válaszban visszaadott, töréspontokra vonatkozó kötelező tulajdonosi keret."

#: includes/abilities/breakpoints.php:154
msgid ""
"Required global-settings ownership envelope when `customEnabled` is present."
msgstr "Kötelező tulajdonosi keret a globális beállításokhoz, ha a `customEnabled` jelen van."

#: includes/abilities/breakpoints.php:158
msgid ""
"Required and must be literal true when the replacement removes or renames "
"any current breakpoint key. This acknowledges that existing responsive "
"settings can retain references to removed keys. Width, label, icon, "
"ordering, and additive edits do not require it."
msgstr "Kötelező, és csak a szó szerinti `true` érték fogadható el, ha a csere eltávolít vagy átnevez bármely aktuális töréspontkulcsot. Ez jelzi, hogy a meglévő reszponzív beállítások továbbra is hivatkozhatnak az eltávolított kulcsokra. A szélesség, a címke, az ikon, a sorrend és a hozzáadással járó módosítások nem igénylik ezt."

#: includes/abilities/breakpoints.php:189
msgid ""
"Follow-up guidance, for example \"run bricks/regenerate-css-files\" when "
"`cssLoading` is set to `file`."
msgstr "Következő lépésekre vonatkozó útmutatás, például „futtassa a bricks/regenerate-css-files parancsot”, ha a `cssLoading` értéke `file`."

#: includes/abilities/breakpoints.php:416
msgid ""
"This replacement removes or renames existing breakpoint keys. Preserve those"
" keys, or pass allowRemovedBreakpoints=true after reviewing the bounded "
"usage evidence. Existing responsive settings are not rewritten "
"automatically."
msgstr "Ez a csere eltávolít vagy átnevez meglévő töréspontkulcsokat. Őrizze meg ezeket a kulcsokat, vagy a korlátozott körű használati bizonyítékok áttekintése után adja meg az allowRemovedBreakpoints=true értéket. A meglévő reszponzív beállítások nem íródnak át automatikusan."

#: includes/abilities/breakpoints.php:483
msgid ""
"Breakpoints were not saved, but the custom-breakpoint setting could not be "
"restored without overwriting a concurrent settings change. Re-read settings "
"and repair the toggle if needed."
msgstr "A töréspontok mentése nem történt meg, de az egyéni töréspont beállítása nem állítható vissza egyidejű beállításmódosítás felülírása nélkül. Olvassa be újra a beállításokat, és szükség esetén javítsa a kapcsoló állapotát."

#: includes/abilities/breakpoints.php:585
msgid ""
"One or more breakpoint resources committed, but the live authority could not"
" be proven to equal this write. Re-read breakpoints before another mutation "
"and manually reconcile the reported committed resources when required."
msgstr "Egy vagy több töréspont-erőforrás mentése megtörtént, de nem sikerült bizonyítani, hogy az aktuális állapot megegyezik ezzel az írással. Újabb módosítás előtt olvassa be újra a töréspontokat, és szükség esetén egyeztesse manuálisan a jelentett, mentett erőforrásokat."

#: includes/abilities/breakpoints.php:690
msgid ""
"Call `bricks/regenerate-css-files` - cssLoading=file means Bricks caches CSS"
" on disk and breakpoint changes are not yet reflected."
msgstr "Futtassa a `bricks/regenerate-css-files` parancsot – ha a cssLoading=file, a Bricks a CSS-t a lemezen gyorsítótárazza, ezért a töréspontok módosításai még nem jelennek meg."

#: includes/abilities/breakpoints.php:886
#: includes/abilities/pseudo-classes.php:589
msgid ""
"Review evidence only. A zero count does not prove that no references exist."
msgstr "Csak a bizonyítékokat tekintse át. A nulla darabszám nem bizonyítja, hogy nincsenek hivatkozások."

#: includes/abilities/cms.php:51
msgid ""
"Source to introspect: wp (post types + taxonomies), acf (field groups), "
"jetengine (CCTs + meta boxes), metabox, cmb2, pods, toolset, or woo. Omit to"
" receive a directory of available sources on this site."
msgstr "Az áttekintendő forrás: wp (bejegyzéstípusok és taxonómiák), acf (mezőcsoportok), jetengine (CCT-k és metadobozok), metabox, cmb2, pods, toolset vagy woo. Hagyja ki, ha ezen a webhelyen az elérhető források listáját szeretné megkapni."

#: includes/abilities/cms.php:71
msgid "Echoes the requested source, or null when returning the directory."
msgstr "A kért forrást adja vissza, vagy null értéket, ha a források listáját adja vissza."

#: includes/abilities/cms.php:75
msgid "Per-source availability: [{ source, active, reason? }]."
msgstr "Forrásonkénti elérhetőség: [{ source, active, reason? }]."

#: includes/abilities/cms.php:80
msgid ""
"Source-specific payload. The shape varies per source and is documented "
"inline."
msgstr "Forrásspecifikus adatcsomag. A felépítés forrásonként változik, és az adott forrásnál van dokumentálva."

#: includes/abilities/cms.php:198
msgid ""
"WordPress front page mode. Use `posts` for latest posts or `page` for a "
"static front page."
msgstr "A WordPress címoldalmódja. A legutóbbi bejegyzésekhez használja a `posts`, statikus címoldalhoz pedig a `page` értéket."

#: includes/abilities/cms.php:203
msgid "Page ID to use as the static homepage. Pass 0 to clear."
msgstr "A statikus címoldalként használandó oldal ID-je. A kiürítéshez adja meg a 0 értéket."

#: includes/abilities/cms.php:207
msgid "Page ID to use as the posts page. Pass 0 to clear."
msgstr "A bejegyzések oldalaként használandó oldal ID-je. A kiürítéshez adja meg a 0 értéket."

#: includes/abilities/cms.php:211
msgid ""
"Number of blog posts to show per page (the headline \"Blog pages show at "
"most\" field on Settings > Reading). Must be a positive integer, max 1000."
msgstr "Oldalanként megjelenítendő blogbejegyzések száma (a Beállítások > Olvasás oldalon található „A blogoldalakon legfeljebb ennyi bejegyzés jelenjen meg” mező). Pozitív egész számnak kell lennie, legfeljebb 1000 lehet."

#: includes/abilities/cms.php:217
msgid ""
"Number of items to show in syndication (RSS) feeds. Must be a positive "
"integer, max 1000."
msgstr "A szindikációs (RSS) hírcsatornákban megjelenítendő tételek darabszáma. Pozitív egész számnak kell lennie, legfeljebb 1000 lehet."

#: includes/abilities/cms.php:223
msgid ""
"For each post in a feed, include the excerpt (true) or full text (false)."
msgstr "A hírcsatornában minden bejegyzéshez a kivonatot (true) vagy a teljes szöveget (false) kell megadni."

#: includes/abilities/cms.php:243
msgid "Current `show_on_front` option: posts or page."
msgstr "Az aktuális `show_on_front` beállítás: posts vagy page."

#: includes/abilities/cms.php:247
msgid "Current static homepage summary, or null when unset."
msgstr "Az aktuális statikus címoldal összefoglalója, vagy null, ha nincs beállítva."

#: includes/abilities/cms.php:251
msgid "Current posts page summary, or null when unset."
msgstr "Az aktuális bejegyzések oldalának összefoglalója, vagy null, ha nincs beállítva."

#: includes/abilities/cms.php:255
msgid "Current `posts_per_page` option."
msgstr "Az aktuális `posts_per_page` beállítás."

#: includes/abilities/cms.php:259
msgid "Current `posts_per_rss` option."
msgstr "Az aktuális `posts_per_rss` beállítás."

#: includes/abilities/cms.php:263
msgid "Current `rss_use_excerpt` option."
msgstr "Az aktuális `rss_use_excerpt` beállítás."

#: includes/abilities/content.php:42
msgid "Post title."
msgstr "Bejegyzés címe."

#: includes/abilities/content.php:46
msgid "Post type slug. Default: page. Must be a Bricks-enabled post type."
msgstr "A bejegyzéstípus slugja. Alapértelmezett: page. Olyan bejegyzéstípusnak kell lennie, amelynél engedélyezve van a Bricks."

#: includes/abilities/content.php:50
msgid "Post status. Default: draft."
msgstr "A bejegyzés állapota. Alapértelmezett: draft."

#: includes/abilities/content.php:55
msgid "URL slug. Auto-generated from title if omitted."
msgstr "URL-slug. Ha nincs megadva, automatikusan jön létre a címből."

#: includes/abilities/content.php:59
msgid "Parent post ID (for hierarchical post types like pages)."
msgstr "Szülő bejegyzés ID-je (hierarchikus bejegyzéstípusok, például oldalak esetén)."

#: includes/abilities/content.php:63
msgid ""
"Bricks element objects to seed the page with, not JSON strings. When "
"provided, the tree is saved atomically with the post; partial state is never"
" written. Element `id` values are internal 6-character Bricks IDs used by "
"builder references and default frontend selectors. In nested format, you may"
" omit ids and Bricks generates them while preserving parent-child nesting. "
"In flat format, ids and parent references must be valid 6-character ids."
msgstr "Az oldal kezdeti feltöltéséhez használandó Bricks-elemobjektumok, nem JSON-karakterláncok. Ha megadja őket, a fa a bejegyzéssel együtt, atomikusan kerül mentésre; részleges állapot soha nem kerül mentésre. Az elem `id` értékei belső, 6 karakteres Bricks ID-k, amelyeket a szerkesztő hivatkozásai és az alapértelmezett felületi szelektorok használnak. Beágyazott formátumban az ID-k elhagyhatók, a Bricks pedig létrehozza őket a szülő-gyermek hierarchia megőrzésével. Lapos formátumban az ID-knek és a szülőre mutató hivatkozásoknak érvényes, 6 karakteres ID-knek kell lenniük."

#: includes/abilities/content.php:94
msgid "Revision ID if elements were seeded."
msgstr "Az elemekkel való feltöltés esetén a változat ID-je."

#: includes/abilities/content.php:245
msgid "Title for the duplicate. Default: \"{original title} (Copy)\"."
msgstr "A duplikátum címe. Alapértelmezett: „{original title} (másolat)”."

#: includes/abilities/content.php:249
msgid "Slug for the duplicate. Auto-generated if omitted."
msgstr "A duplikátum slugja. Ha nincs megadva, automatikusan jön létre."

#: includes/abilities/content.php:253
msgid "Status for the duplicate. Default: draft."
msgstr "A duplikátum állapota. Alapértelmezett: draft."

#: includes/abilities/content.php:465
msgid "Permanently delete instead of trashing. Default: false."
msgstr "Végleges törlés a kukába helyezés helyett. Alapértelmezett: false."

#: includes/abilities/content.php:488
msgid "True if moved to trash (recoverable). False if permanently deleted."
msgstr "True, ha a kukába került (visszaállítható). False, ha véglegesen törölték."

#: includes/abilities/content.php:592
msgid ""
"Public http/https URL to sideload the media from. Private, loopback, link-"
"local, unsafe-port, and credentialed URLs are rejected. Mutually exclusive "
"with base64."
msgstr "Nyilvános http/https URL, ahonnan a médiafájl importálható. A privát, loopback, link-local, nem biztonságos portot használó és hitelesítő adatokat tartalmazó URL-ek elutasításra kerülnek. A base64 értékkel nem használható együtt."

#: includes/abilities/content.php:596
msgid "Base64-encoded file data. Mutually exclusive with url."
msgstr "Base64-kódolású fájladatok. Az url értékkel nem használható együtt."

#: includes/abilities/content.php:600
msgid ""
"Filename including extension (e.g. \"hero.jpg\"). Required when using "
"base64."
msgstr "A fájlnév a kiterjesztéssel együtt (például „hero.jpg”). Base64 használata esetén kötelező."

#: includes/abilities/content.php:604
msgid "Attachment title."
msgstr "A csatolmány címe."

#: includes/abilities/content.php:608
msgid "Alt text for the image."
msgstr "A kép alternatív szövege."

#: includes/abilities/content.php:612
msgid "Attachment caption."
msgstr "A csatolmány képaláírása."

#: includes/abilities/content.php:616
msgid "Attachment description."
msgstr "A csatolmány leírása."

#: includes/abilities/content.php:644
msgid "Available image sizes with url, width, and height."
msgstr "Elérhető képméretek URL-lel, szélességgel és magassággal."

#: includes/abilities/content.php:739
msgid "Search by filename, title, or alt text."
msgstr "Keresés fájlnév, cím vagy alternatív szöveg alapján."

#: includes/abilities/content.php:743
msgid "Filter by MIME type (e.g. \"image\", \"image/jpeg\", \"application/pdf\")."
msgstr "Szűrés MIME-típus szerint (például „image”, „image/jpeg”, „application/pdf”)."

#: includes/abilities/content.php:747
msgid "Max results (default 10, max 50)."
msgstr "Találatok maximális száma (alapértelmezés: 10, maximum: 50)."

#: includes/abilities/content.php:751
msgid "Sort order: modified (default), title, date."
msgstr "Rendezési sorrend: modified (alapértelmezett), title, date."

#: includes/abilities/content.php:756
msgid ""
"Response detail: full returns all image size variants (default); compact "
"returns core metadata plus common thumbnail URLs."
msgstr "A válasz részletessége: a full az összes képméret-változatot adja vissza (alapértelmezett); a compact az alapvető metaadatokat és a gyakori bélyegkép-URL-eket adja vissza."

#: includes/abilities/content.php:813
msgid "Media attachment ID to delete."
msgstr "A törlendő médiacsatolmány ID-je."

#: includes/abilities/content.php:817
msgid ""
"Permanently delete instead of trashing when WordPress media trash is "
"enabled. Default false."
msgstr "Végleges törlés a kukába helyezés helyett, ha a WordPressben engedélyezve van a médiafájlok kukába helyezése. Alapértelmezés szerint false."

#: includes/abilities/content.php:840
msgid "True if moved to trash. False if permanently deleted."
msgstr "True, ha a kukába került. False, ha véglegesen törölték."

#: includes/abilities/content.php:844
msgid "Attachment snapshot before deletion."
msgstr "A csatolmány pillanatképe törlés előtt."

#: includes/abilities/conversion.php:40
msgid ""
"The post/page/template ID to use as rendering context. When elements are "
"omitted, the ability renders this post's current saved Bricks tree."
msgstr "A megjelenítési környezetként használandó bejegyzés, oldal vagy sablonminta ID-je. Ha az elemek nincsenek megadva, a képesség ennek a bejegyzésnek az aktuálisan mentett Bricks-fáját jeleníti meg."

#: includes/abilities/conversion.php:44
msgid ""
"Optional proposed Bricks element tree. Omit after a save to render the "
"current stored tree without reading and resending it."
msgstr "Opcionális, javasolt Bricks-elemfa. Mentés után hagyja ki, ha a jelenleg tárolt fát szeretné megjeleníteni annak beolvasása és újbóli elküldése nélkül."

#: includes/abilities/conversion.php:52
msgid ""
"Optional frozen Bricks area. When supplied, it must match the target post or"
" template area."
msgstr "Opcionális, rögzített Bricks-terület. Ha meg van adva, egyeznie kell a célbejegyzés vagy a sablonminta területével."

#: includes/abilities/conversion.php:57
msgid ""
"Use `summary` for compact post-save verification of generated markup, "
"landmarks, headings, and responsive CSS. Default `detailed` returns full "
"HTML and CSS."
msgstr "A `summary` használatával tömör, mentés utáni ellenőrzést kaphat a generált jelölésről, tájékozódási pontokról, címsorokról és reszponzív CSS-ről. Az alapértelmezett `detailed` teljes HTML-t és CSS-t ad vissza."

#: includes/abilities/conversion.php:77
msgid "Rendered HTML output."
msgstr "Megjelenített HTML-kimenet."

#: includes/abilities/conversion.php:81
msgid "Generated inline CSS for the elements."
msgstr "Az elemekhez generált beágyazott CSS."

#: includes/abilities/conversion.php:85
msgid "Compact render verification when responseFormat is summary."
msgstr "Tömör megjelenítési ellenőrzés, ha a responseFormat értéke summary."

#: includes/abilities/conversion.php:593
msgid ""
"Raw HTML string to convert to Bricks elements. Can include inline <style> "
"and <script> tags. Optional when css is provided."
msgstr "Nyers HTML-karakterlánc, amely Bricks-elemekké alakítható. Beágyazott <style> és <script> címkéket is tartalmazhat. Opcionális, ha a css meg van adva."

#: includes/abilities/conversion.php:597
msgid ""
"Raw CSS string. With html, this CSS styles the converted markup. Without "
"html, this returns global classes, variables, element updates for provided "
"context, and fallback Code elements when needed."
msgstr "Nyers CSS-karakterlánc. A html megadásakor ez a CSS a konvertált jelölést formázza. A html megadása nélkül globális osztályokat, változókat, a megadott kontextushoz tartozó elemmódosításokat, valamint szükség esetén tartalék kódelemeket ad vissza."

#: includes/abilities/conversion.php:601
msgid ""
"Post/page/template ID. Non-administrators must supply a valid, editable "
"Bricks-enabled target with the necessary Builder permissions for HTML and "
"CSS-only conversion. Administrators may omit postId. For CSS-only "
"conversion, also provides optional existing-element context."
msgstr "Bejegyzés-/oldal-/sablonminta-ID. A nem adminisztrátoroknak érvényes, szerkeszthető, Bricks-kompatibilis célt kell megadniuk a HTML- és CSS-alapú konverzióhoz szükséges Builder-jogosultságokkal. Az adminisztrátorok elhagyhatják a postId értékét. A kizárólag CSS-alapú konverzióhoz opcionális, meglévő elemkörnyezet is megadható."

#: includes/abilities/conversion.php:605
msgid ""
"Optional existing Bricks elements used as context for CSS-only conversion."
msgstr "Opcionális, meglévő Bricks-elemek, amelyek a kizárólag CSS-alapú konverzió kontextusaként szolgálnak."

#: includes/abilities/conversion.php:612
msgid "Optional conversion options."
msgstr "Opcionális konverziós opciók."

#: includes/abilities/conversion.php:616
msgid ""
"Whether to create global classes from CSS class selectors. Default true."
msgstr "Globális osztályok létrehozása CSS-osztálykijelölőkből. Alapértelmezés szerint true."

#: includes/abilities/conversion.php:620
msgid "Whether to extract CSS custom properties from :root. Default true."
msgstr "CSS egyéni tulajdonságainak kinyerése a :root elemből. Alapértelmezés szerint true."

#: includes/abilities/conversion.php:625
msgid ""
"Optional source document root font size in pixels. Must be supplied with "
"target_root_font_size_px to translate rem values and preserve the effective "
"content-root font size."
msgstr "Opcionális, forrásdokumentumhoz tartozó gyökérbetűméret képpontban. A rem-értékek átalakításához és a tartalom gyökérelemén érvényes tényleges betűméret megőrzéséhez a target_root_font_size_px értékkel együtt kell megadni."

#: includes/abilities/conversion.php:630
msgid ""
"Optional target Bricks root font size in pixels. Must be supplied with "
"source_root_font_size_px to translate rem values while the converter scopes "
"source base typography to page roots."
msgstr "Opcionális, célként használt Bricks-gyökérelem betűmérete képpontban. A rem-értékek átalakításához a source_root_font_size_px értékkel együtt kell megadni, miközben az átalakító a forrás alaptipográfiáját az oldal gyökérelemeire korlátozza."

#: includes/abilities/conversion.php:634
msgid ""
"Scope otherwise-global CSS selectors to the converted page roots instead of "
"generating a Code element. Intended for authoritative full-page imports."
msgstr "A globális CSS-kijelölőket az átalakított oldal gyökérelemeire korlátozza, ahelyett, hogy kódelemet hozna létre. Hiteles, teljes oldalas importáláshoz készült."

#: includes/abilities/conversion.php:638
msgid ""
"Preserve the deterministic semantic HTML baseline for tags present in an "
"authoritative page import. Enabling this also scopes global CSS to the "
"converted roots. Defaults to false."
msgstr "Megőrzi a determinisztikus szemantikus HTML-alapbeállításokat a hiteles oldalimportban szereplő címkékhez. Ennek bekapcsolása a globális CSS-t is az átalakított gyökérelemekre korlátozza. Alapértelmezés szerint false."

#: includes/abilities/conversion.php:662
msgid "Flat array of Bricks elements."
msgstr "Bricks-elemek lapos tömbje."

#: includes/abilities/conversion.php:669
msgid ""
"New global class objects with stable 6-character IDs. Persist this array "
"once with `bricks-batch-create-global-classes`; do not create classes one by"
" one or remap element references."
msgstr "Új globális osztályobjektumok stabil, 6 karakteres ID-kkel. Ezt a tömböt egyszer mentse a `bricks-batch-create-global-classes` használatával; ne hozzon létre osztályokat egyesével, és ne képezze le újra az elemek hivatkozásait."

#: includes/abilities/conversion.php:676
msgid "New global variable objects to create."
msgstr "Létrehozandó új globális változóobjektumok."

#: includes/abilities/conversion.php:683
msgid ""
"Extracted CSS custom properties that matched an existing global-variable "
"name. Compare their values before relying on the existing variable."
msgstr "A meglévő globális változónevekhez illeszkedő, kinyert CSS-egyéni tulajdonságok. Mielőtt a meglévő változóra támaszkodna, hasonlítsa össze az értékeket."

#: includes/abilities/conversion.php:690
msgid "Whether the HTML contained inline or external JavaScript."
msgstr "Azt jelzi, hogy a HTML tartalmazott-e beágyazott vagy külső JavaScriptet."

#: includes/abilities/conversion.php:694
msgid ""
"Whether the returned elements contain code-sensitive content. Code elements "
"retain their existing execution and signature requirements. CSS follows "
"target editing permissions, JavaScript requires unfiltered_html, and PHP "
"requires BRICKS_ENABLE_PHP_ABILITIES and PHP authorization."
msgstr "Azt jelzi, hogy a visszaadott elemek tartalmaznak-e kódérzékeny tartalmat. A kódelemekre továbbra is érvényesek a meglévő végrehajtási és aláírási követelmények. A CSS-hez a cél szerkesztési jogosultságai, a JavaScripthez az unfiltered_html, a PHP-hez pedig a BRICKS_ENABLE_PHP_ABILITIES és a PHP-jogosultság szükséges."

#: includes/abilities/conversion.php:698
msgid "Whether the current caller has the Bricks execute-code capability."
msgstr "Azt jelzi, hogy az aktuális hívó rendelkezik-e a Bricks kódvégrehajtási jogosultságával."

#: includes/abilities/conversion.php:702
msgid ""
"True when code-sensitive elements must be replaced or removed before any "
"conversion-derived write, including classes, variables, or the element tree."
msgstr "True, ha a kódérzékeny elemeket ki kell cserélni vagy el kell távolítani bármilyen, a konverzióból eredő írási művelet előtt, beleértve az osztályokat, változókat és az elemfát is."

#: includes/abilities/conversion.php:706
msgid ""
"IDs of returned elements whose code-sensitive payload cannot be saved "
"through Bricks abilities."
msgstr "A visszaadott elemek azon ID-jei, amelyek kódérzékeny tartalma nem menthető a Bricks képességeivel."

#: includes/abilities/conversion.php:711
msgid ""
"Compact descriptors for code-sensitive elements so blocked callers can "
"branch without rescanning the full tree."
msgstr "A kódérzékeny elemek tömör leírói, amelyek lehetővé teszik a korlátozott jogosultságú hívók számára, hogy a teljes fa újbóli átvizsgálása nélkül válasszanak műveletet."

#: includes/abilities/conversion.php:726
msgid "Non-fatal conversion warnings."
msgstr "Nem végzetes konverziós figyelmeztetések."

#: includes/abilities/conversion.php:733
msgid ""
"Non-fatal conversion errors (the response only reaches this shape on overall"
" success; fatal errors return WP_Error instead)."
msgstr "Nem végzetes konverziós hibák (a válasz csak teljes siker esetén veszi fel ezt az alakot; végzetes hiba esetén a rendszer WP_Error értéket ad vissza)."

#: includes/abilities/conversion.php:740
msgid "Conversion mode: `html_css` or `css`."
msgstr "Konverziós mód: `html_css` vagy `css`."

#: includes/abilities/conversion.php:744
msgid ""
"Explicit rem root normalization state and token counts. Inspect this before "
"persisting an external source migration."
msgstr "Explicit rem-gyökérnormalizálási állapot és tokenek száma. Külső forrás áttelepítésének mentése előtt ellenőrizze ezt."

#: includes/abilities/conversion.php:757
msgid ""
"Deterministic semantic HTML baseline applied before authored CSS for "
"authoritative page imports."
msgstr "A szerzői CSS előtt alkalmazott determinisztikus szemantikus HTML-alapbeállítás hiteles oldalak importálásakor."

#: includes/abilities/conversion.php:769
msgid "CSS class name to Bricks global class ID mapping."
msgstr "CSS-osztálynevek és a Bricks globális osztályainak ID-i közötti leképezés."

#: includes/abilities/conversion.php:773
msgid ""
"Patch-only CSS class updates for matched context elements. Contains element "
"IDs and `_cssGlobalClasses`/`_cssClasses` changes only; never full element "
"settings."
msgstr "Csak a CSS-osztályokra vonatkozó frissítések az illeszkedő kontextuselemekhez. Csak elem-ID-ket és `_cssGlobalClasses`/`_cssClasses` módosításokat tartalmaz; teljes elembeállításokat soha nem tartalmaz."

#: includes/abilities/conversion.php:780
msgid ""
"CSS-only fallback elements generated for CSS that cannot be represented as "
"globals or variables."
msgstr "A csak CSS-alapú konverzióhoz generált tartalékelemek azokhoz a CSS-szabályokhoz, amelyek nem ábrázolhatók globális osztályként vagy változóként."

#: includes/abilities/conversion.php:787
msgid "CSS-only fallback CSS stored in generated Code elements."
msgstr "A csak CSS-alapú konverzió tartalék CSS-kódja, amelyet a rendszer a generált kódelemekben tárol."

#: includes/abilities/conversion.php:791
msgid "CSS-only keyframe CSS assigned to owning global classes."
msgstr "A kizárólag CSS-alapú konverzió kulcsképkocka-CSS-e a hozzá tartozó globális osztályokhoz rendelve."

#: includes/abilities/conversion.php:941
#: includes/abilities/conversion.php:1032
msgid ""
"The conversion contains content this user cannot author. Check the listed "
"elements and their required code permissions. HTML/CSS page import can omit "
"disallowed elements and report a partial result."
msgstr "A konverzió olyan tartalmat tartalmaz, amelyet ez a felhasználó nem hozhat létre. Ellenőrizze a felsorolt elemeket és a hozzájuk szükséges kódjogosultságokat. A HTML-/CSS-oldalimportálás kihagyhatja a nem engedélyezett elemeket, és részleges eredményről adhat jelentést."

#: includes/abilities/design-workspace.php:84
msgid ""
"Explicitly acknowledge removed component slots after reviewing their use. "
"Bound into the frozen preview."
msgstr "A használatuk áttekintése után kifejezetten vegye tudomásul az eltávolított komponenshelyeket. Ez a nyugtázás a rögzített előnézethez kötődik."

#: includes/abilities/design.php:85
msgid ""
"Required for item-level update and delete operations. Copy the complete "
"itemOwnership envelope returned for that item."
msgstr "Tételszintű frissítési és törlési műveletekhez kötelező. Másolja ki az adott tételhez visszaadott teljes itemOwnership-objektumot."

#: includes/abilities/design.php:671
msgid "Return a single palette by ID. Omit to list all palettes."
msgstr "Egyetlen paletta visszaadása ID alapján. Hagyja ki az összes paletta listázásához."

#: includes/abilities/design.php:692
msgid ""
"Array of complete color palettes. Each palette and color includes a digest "
"plus ready itemOwnership calculated from the complete authoritative record "
"before response decoration."
msgstr "Teljes színpaletták tömbje. Minden paletta és szín egy lenyomatot, valamint egy, a teljes hiteles rekordból a válasz kiegészítése előtt kiszámított, használatra kész itemOwnership-értéket tartalmaz."

#: includes/abilities/design.php:700
msgid ""
"Compact color-palette resource ownership. Pass it unchanged for creates and "
"as the base of item-bound update/delete ownership."
msgstr "Tömör színpaletta-erőforrás tulajdonosi adatai. Létrehozáskor változatlanul adja meg, tételhez kötött frissítés/törlés esetén pedig használja az itemOwnership alapjaként."

#: includes/abilities/design.php:1429
msgid ""
"The palette ID to add the color to. If omitted, adds to the first palette."
msgstr "Annak a palettának az ID-je, amelyhez hozzá kell adni a színt. Ha nincs megadva, a rendszer az első palettához adja hozzá."

#: includes/abilities/design.php:1433
msgid ""
"Light mode color value (hex, rgb, etc.). REQUIRED when creating a root "
"palette color (i.e. when neither `parent` nor `type` is set). Not in the "
"JSON Schema `required` array because shade rows omit it."
msgstr "Világos mód színértéke (hex, rgb stb.). Gyökérpaletta-szín létrehozásakor KÖTELEZŐ (vagyis ha sem a `parent`, sem a `type` nincs beállítva). Nem szerepel a JSON Schema `required` tömbjében, mert az árnyalatsorok kihagyják."

#: includes/abilities/design.php:1437
msgid ""
"Dark mode color value. For root colors, this enables dark mode. For shade "
"rows, this stores a dark-mode shade and requires a dark-mode parent."
msgstr "Sötét mód színértéke. Gyökérszíneknél bekapcsolja a sötét módot. Árnyalatsoroknál sötét módú árnyalatot tárol, és sötét módú szülőelemet igényel."

#: includes/abilities/design.php:1441
msgid ""
"CSS variable reference/name. Normalized to `var(--name)`. If omitted, "
"generated as `var(--bricks-color-{id})`."
msgstr "CSS-változó hivatkozása/neve. A normalizált alakja: `var(--name)`. Ha nincs megadva, a rendszer `var(--bricks-color-{id})` formátumban generálja."

#: includes/abilities/design.php:1445
msgid ""
"Enable the builder dark-mode pair for a root color. When true and dark is "
"omitted, the dark value is derived from light using the builder HSL "
"inversion."
msgstr "A Builder sötét módú színpárjának bekapcsolása egy gyökérszínhez. Ha az értéke true, és a sötét érték nincs megadva, akkor a rendszer a világos értékből, a Builder HSL-inverziójával származtatja a sötét értéket."

#: includes/abilities/design.php:1449 includes/abilities/design.php:1764
msgid ""
"Parent root-color ID for a shade. Parent and type must be provided together."
msgstr "Egy árnyalat szülő gyökérszínének ID-ja. A szülőt és a típust együtt kell megadni."

#: includes/abilities/design.php:1454 includes/abilities/design.php:1769
msgid ""
"Shade type. One of: light, dark, transparent. Parent and type must be "
"provided together."
msgstr "Az árnyalat típusa. A lehetséges értékek: világos, sötét, átlátszó. A szülőt és a típust együtt kell megadni."

#: includes/abilities/design.php:1459 includes/abilities/design.php:1774
msgid "Required non-negative shade index for shade colors."
msgstr "Az árnyalatszínekhez megadandó, nem negatív árnyalatindex."

#: includes/abilities/design.php:1463 includes/abilities/design.php:1778
msgid ""
"Enabled color utility class groups, e.g. bg, text, border, outline, fill, "
"stroke."
msgstr "Bekapcsolt színsegédosztály-csoportok, például bg, text, border, outline, fill, stroke."

#: includes/abilities/design.php:1466
msgid ""
"Required exact color-palette resource ownership from the latest list or "
"palette write. Color creation depends on reviewed membership, variable "
"uniqueness, parent relationships, and order."
msgstr "A legutóbbi listából vagy palettaírásból származó, színpaletta-erőforrás feletti pontos tulajdonjog igazolása kötelező. A szín létrehozása az ellenőrzött palettatagságtól, a változók egyediségétől, a szülőkapcsolatoktól és a sorrendtől függ."

#: includes/abilities/design.php:1487
msgid "The created color object with generated ID."
msgstr "A létrehozott színobjektum a generált ID-val."

#: includes/abilities/design.php:1491
msgid "The palette ID the color was added to."
msgstr "Annak a palettának az ID-ja, amelyhez a színt hozzáadták."

#: includes/abilities/design.php:1739
msgid "The color ID to update."
msgstr "A frissítendő szín ID-ja."

#: includes/abilities/design.php:1744
msgid ""
"Optional palette ID to scope the lookup. If omitted, the color is searched "
"across all palettes."
msgstr "Opcionális paletta-ID a keresés szűkítéséhez. Ha nincs megadva, a rendszer az összes palettában megkeresi a színt."

#: includes/abilities/design.php:1748
msgid "New light mode value (top-level convenience)."
msgstr "Új világos módú érték (kényelmi mező a legfelső szinten)."

#: includes/abilities/design.php:1752
msgid "New dark mode value (top-level convenience)."
msgstr "Új sötét módú érték (kényelmi mező a legfelső szinten)."

#: includes/abilities/design.php:1756
msgid "New CSS variable reference (top-level convenience)."
msgstr "Új CSS-változó-hivatkozás (kényelmi mező a legfelső szinten)."

#: includes/abilities/design.php:1760
msgid ""
"Enable/disable the builder dark-mode pair. Enabling derives dark from light "
"when dark is omitted; disabling removes dark values and dark-mode shades."
msgstr "A szerkesztő sötét módú párjának be- vagy kikapcsolása. Bekapcsoláskor a rendszer a világos értékből származtatja a sötét értéket, ha az nincs megadva; kikapcsoláskor eltávolítja a sötét értékeket és a sötét módú árnyalatokat."

#: includes/abilities/design.php:1782
msgid ""
"Full nested color shape. Any of: { light, dark, raw, darkModeEnabled, "
"parent, type, index, utilityClasses }. If both top-level and nested forms "
"are provided, nested wins."
msgstr "Teljes beágyazott színstruktúra. Lehetséges mezők: { light, dark, raw, darkModeEnabled, parent, type, index, utilityClasses }. Ha a legfelső szintű és a beágyazott formátum is meg van adva, a beágyazott formátum élvez elsőbbséget."

#: includes/abilities/design.php:1785
msgid ""
"Required color-palette ownership including this color colorDigest from the "
"latest palette read or write. Graph-affecting changes also validate the "
"included resourceDigest."
msgstr "A legutóbbi palettaolvasásból vagy -írásból származó, színpaletta-erőforrás feletti pontos tulajdonjogot igazoló adat megadása kötelező, és tartalmaznia kell ennek a színnek a colorDigest értékét is. A gráfot érintő módosításoknál a rendszer a megadott resourceDigest értékét is ellenőrzi."

#: includes/abilities/design.php:1807
msgid "The updated color object."
msgstr "A frissített színobjektum."

#: includes/abilities/design.php:2205
msgid "Display name for the palette."
msgstr "A paletta megjelenített neve."

#: includes/abilities/design.php:2210
msgid ""
"Optional initial colors. Shade rows require paired parent/type, a root "
"parent in this palette, an allowed type, and a non-negative index. Shade "
"parent/type/index/mode and raw values must be unique. IDs are preserved when"
" supplied so parent relationships survive imports; missing IDs/raw values "
"are generated."
msgstr "Opcionális kezdeti színek. Az árnyalatsoroknál együtt kell megadni a szülőt és a típust; továbbá egy gyökérszülőnek kell szerepelnie ebben a palettában, engedélyezett típust és nem negatív indexet kell használni. Az árnyalat szülőjének, típusának, indexének és módjának, valamint a raw értékeknek egyedieknek kell lenniük. A megadott ID-k megmaradnak, így az importálás után is fennmaradnak a szülőkapcsolatok; a hiányzó ID-ket és raw értékeket a rendszer generálja."

#: includes/abilities/design.php:2213
msgid ""
"Required exact color-palette resource ownership from the latest palette read"
" or write. Creation validates names, color IDs, variable uniqueness, graph "
"membership, and order against that resource."
msgstr "A legutóbbi palettaolvasásból vagy -írásból származó, színpaletta-erőforrás feletti pontos tulajdonjogot igazoló adat megadása kötelező. A létrehozás az erőforrás alapján ellenőrzi a neveket, a szín-ID-kat, a változók egyediségét, a gráfhoz tartozást és a sorrendet."

#: includes/abilities/design.php:2234
msgid "The created palette ({ id, name, colors })."
msgstr "A létrehozott paletta ({ id, name, colors })."

#: includes/abilities/design.php:2560
msgid "The palette ID to update."
msgstr "A frissítendő paletta ID-ja."

#: includes/abilities/design.php:2565
msgid "New display name."
msgstr "Új megjelenített név."

#: includes/abilities/design.php:2568
msgid ""
"Required color-palette ownership including this palette paletteDigest from "
"the latest palette read or write."
msgstr "A legutóbbi palettaolvasásból vagy -írásból származó, a színpaletta feletti tulajdonjogot igazoló adat megadása kötelező, és tartalmaznia kell ennek a palettának a paletteDigest értékét is."

#: includes/abilities/design.php:2590
msgid "The updated palette ({ id, name, colors })."
msgstr "A frissített paletta ({ id, name, colors })."

#: includes/abilities/design.php:2706
msgid "The color ID to delete."
msgstr "A törlendő szín ID-ja."

#: includes/abilities/design.php:2711
msgid "Optional palette ID to scope the lookup."
msgstr "Opcionális paletta-ID a keresés szűkítéséhez."

#: includes/abilities/design.php:2714
msgid ""
"Required color-palette ownership including this color colorDigest. Deleting "
"a root also removes its shades, so the included resourceDigest protects the "
"reviewed graph."
msgstr "Kötelező a színpaletta feletti tulajdonjogot igazoló adatot megadni, amely ennek a színnek a colorDigest értékét is tartalmazza. A gyökérszín törlése az árnyalatait is eltávolítja, ezért a megadott resourceDigest védi az ellenőrzött gráf épségét."

#: includes/abilities/design.php:2719
msgid ""
"Required and must be literal true when the deletion removes any named CSS "
"variable, including root shades. Fresh reference evidence is not a "
"guarantee."
msgstr "Kötelező, és értékének szó szerint true-nak kell lennie, ha a törlés bármely elnevezett CSS-változót eltávolít, a gyökérszínek árnyalatait is beleértve. A friss hivatkozásokra vonatkozó bizonyíték nem jelent garanciát."

#: includes/abilities/design.php:2740
msgid ""
"Snapshot of the deleted color ({ id, light, dark?, raw?, paletteId, "
"deletedShades? }). Deleting a root color also removes its shades to match "
"the builder."
msgstr "A törölt szín pillanatképe ({ id, light, dark?, raw?, paletteId, deletedShades? }). Egy gyökérszín törlése a szerkesztő működésének megfelelően az árnyalatait is eltávolítja."

#: includes/abilities/design.php:2916
msgid "The palette ID to delete."
msgstr "A törlendő paletta ID-ja."

#: includes/abilities/design.php:2919
msgid ""
"Required color-palette ownership including this palette paletteDigest. The "
"resourceDigest protects the reviewed palette graph."
msgstr "A színpaletta feletti tulajdonjogot igazoló adatnak kötelezően tartalmaznia kell ennek a palettának a paletteDigest értékét. A resourceDigest védi az ellenőrzött palettagráfot."

#: includes/abilities/design.php:2924
msgid ""
"Required and must be literal true when any named CSS variables are removed "
"with the palette. Fresh reference evidence is not a guarantee."
msgstr "Kötelező, és értékének szó szerint true-nak kell lennie, ha a paletta törlése elnevezett CSS-változókat távolít el. A friss hivatkozásokra vonatkozó bizonyíték nem jelent garanciát."

#: includes/abilities/design.php:2945
msgid "Snapshot of the deleted palette (id, name, color count)."
msgstr "A törölt paletta pillanatképe (ID, név, színek száma)."

#: includes/abilities/design.php:3093
msgid "Filter by category ID. Omit to list all classes."
msgstr "Szűrés kategória-ID alapján. Ha nincs megadva, az összes osztály listázása."

#: includes/abilities/design.php:3114
msgid "Array of global classes with id, name, settings, selectors, category."
msgstr "Globális osztályok tömbje ID-val, névvel, beállításokkal, szelektorokkal és kategóriával."

#: includes/abilities/design.php:3122
msgid "Array of class categories with id and name."
msgstr "Kategóriák tömbje ID-val és névvel."

#: includes/abilities/design.php:3126
msgid "Array of locked class IDs."
msgstr "Zárolt osztály-ID-k tömbje."

#: includes/abilities/design.php:3130
msgid ""
"Exact global-class resource ownership. Each returned class also has an "
"itemDigest derived from its complete authoritative row."
msgstr "A globális osztályok erőforrása feletti pontos tulajdonjog igazolása. Minden visszaadott osztályhoz tartozik egy itemDigest is, amely az adott teljes, hiteles sorból származik."

#: includes/abilities/design.php:3134
msgid ""
"Exact lock-resource ownership required together with class ownership for "
"update and delete."
msgstr "A frissítéshez és törléshez az osztály feletti tulajdonjog igazolása mellett a zárolási erőforrás feletti pontos tulajdonjog igazolása is kötelező."

#: includes/abilities/design.php:3138
msgid ""
"Exact category-resource ownership required when assigning a non-empty "
"category."
msgstr "Nem üres kategória hozzárendelésekor kötelező a kategória-erőforrás feletti pontos tulajdonjog igazolása."

#: includes/abilities/design.php:3366
msgid "CSS class name (e.g. \"my-button\"). Must be unique."
msgstr "CSS-osztálynév (például „my-button”). Egyedinek kell lennie."

#: includes/abilities/design.php:3371
msgid ""
"CSS settings object. Keys follow the pattern: _controlKey, "
"_controlKey:breakpoint, _controlKey:pseudoClass. E.g. { \"_typography\": { "
"\"font-size\": \"16px\" }, \"_padding\": { \"top\": \"10px\" }, "
"\"_background:hover\": { \"color\": { \"hex\": \"#ff0000\" } } }."
msgstr "CSS-beállítások objektuma. A kulcsok a következő mintát követik: _controlKey, _controlKey:breakpoint, _controlKey:pseudoClass. Például: { \"_typography\": { \"font-size\": \"16px\" }, \"_padding\": { \"top\": \"10px\" }, \"_background:hover\": { \"color\": { \"hex\": \"#ff0000\" } } }."

#: includes/abilities/design.php:3375
msgid ""
"Custom CSS sub-selectors. Each with: id, selector (e.g. \"&::before\"), "
"settings, label."
msgstr "Egyéni CSS-alválasztók. Mindegyik a következőket tartalmazza: ID, szelektor (például „&::before”), beállítások és címke."

#: includes/abilities/design.php:3380
msgid ""
"Category ID to assign. Optional. A non-empty value requires "
"expectedCategoryOwnership from list-global-classes."
msgstr "A hozzárendelendő kategória ID-ja. Opcionális. Nem üres érték esetén az expectedCategoryOwnership mezőt is meg kell adni a list-global-classes műveletből."

#: includes/abilities/design.php:3383 includes/abilities/design.php:4074
msgid ""
"Required when category is non-empty. Copy categoryOwnership from the same "
"latest class read."
msgstr "Kötelező, ha a kategória nem üres. Másolja át a categoryOwnership értékét ugyanabból a legutóbbi osztálylekérdezésből."

#: includes/abilities/design.php:3403
msgid "The created global class object."
msgstr "A létrehozott globális osztály objektuma."

#: includes/abilities/design.php:3526
msgid ""
"Optional 6-character source ID to preserve, such as an ID returned by the "
"HTML/CSS converter."
msgstr "Opcionális, megőrzendő 6 karakteres forrás-ID, például a HTML/CSS-konverter által visszaadott ID."

#: includes/abilities/design.php:3534
msgid ""
"Global classes to validate and create in one atomic option write. Pass "
"converter `global_classes` directly to preserve their IDs and element "
"references."
msgstr "Egyetlen atomi beállításfrissítés során érvényesítendő és létrehozandó globális osztályok. Az ID-k és az elemhivatkozások megőrzéséhez adja át közvetlenül a konverter `global_classes` értékét."

#: includes/abilities/design.php:3538
msgid ""
"Required exact global-class ownership from the latest class read or write. "
"Batch creation is a full-store append and rejects any intervening class "
"change."
msgstr "A globális osztályokra vonatkozó pontos tulajdonjog-igazolás megadása kötelező, és a legutóbbi osztálylekérdezésből vagy -írásból kell származnia. A kötegelt létrehozás az új osztályokat a teljes tárolóhoz fűzi hozzá, és elutasítja a műveletet, ha közben bármelyik osztály megváltozik."

#: includes/abilities/design.php:3541
msgid ""
"Required when any class has a non-empty category. Copy categoryOwnership "
"from the same latest class read."
msgstr "Akkor kötelező, ha bármelyik osztálynak nem üres kategóriája van. Másolja át a categoryOwnership értékét ugyanabból a legutóbbi osztálylekérdezésből."

#: includes/abilities/design.php:3545
msgid "Validate and normalize every class without saving. Defaults to false."
msgstr "Érvényesítse és normalizálja az összes osztályt mentés nélkül. Alapértelmezett értéke false."

#: includes/abilities/design.php:3549
msgid ""
"Return full normalized class objects. Defaults to false to keep large "
"conversion batches compact."
msgstr "A teljes, normalizált osztályobjektumok visszaadása. Alapértelmezett értéke false, hogy a nagy konverziós kötegek tömörek maradjanak."

#: includes/abilities/design.php:3578
msgid "Full normalized classes, only when returnClasses is true."
msgstr "Teljes, normalizált osztályok, csak akkor, ha a returnClasses értéke true."

#: includes/abilities/design.php:4053
msgid "The global class ID to update."
msgstr "A frissítendő globális osztály ID-ja."

#: includes/abilities/design.php:4058
msgid "New CSS class name. Optional."
msgstr "Új CSS-osztálynév. Opcionális."

#: includes/abilities/design.php:4062
msgid ""
"Settings to deep-merge with existing (only provided keys are updated). "
"Optional."
msgstr "Beállítások, amelyeket a rendszer a meglévőkkel együtt, azok mélyebb szintjein is egyesít (csak a megadott kulcsok frissülnek). Opcionális."

#: includes/abilities/design.php:4066
msgid "New selectors array (full replacement). Optional."
msgstr "Új selectors tömb (teljes csere). Opcionális."

#: includes/abilities/design.php:4071
msgid ""
"New category ID. Optional. A non-empty value requires "
"expectedCategoryOwnership from list-global-classes."
msgstr "Új kategória-ID. Opcionális. Nem üres érték esetén a list-global-classes műveletből származó expectedCategoryOwnership érték is szükséges."

#: includes/abilities/design.php:4077 includes/abilities/design.php:4348
msgid ""
"Required global-class ownership including this class itemDigest from the "
"latest class read or write."
msgstr "A legutóbbi osztályolvasásból vagy -írásból származó kötelező adat, amely igazolja a globális osztály tulajdonjogát, és tartalmazza ennek az osztálynak az itemDigest értékét."

#: includes/abilities/design.php:4081
msgid ""
"Required lock ownership from the same latest class read. The exact lock row "
"is guarded in the final class commit."
msgstr "Az ugyanabból a legutóbbi osztályolvasásból származó kötelező, zárolási tulajdonjogot igazoló adat. A végleges osztálymódosításkor a rendszer a pontos zárolási sort is ellenőrzi."

#: includes/abilities/design.php:4101
msgid "The updated global class object."
msgstr "A frissített globális osztályobjektum."

#: includes/abilities/design.php:4345
msgid "The global class ID to delete."
msgstr "A törlendő globális osztály ID-ja."

#: includes/abilities/design.php:4352
msgid ""
"Required lock ownership from the same latest class read. The exact lock row "
"is guarded in the final delete."
msgstr "Az ugyanabból a legutóbbi osztályolvasásból származó kötelező, zárolási tulajdonjogot igazoló adat. A végleges törléskor a rendszer a pontos zárolási sort is ellenőrzi."

#: includes/abilities/design.php:4356
msgid ""
"Required and must be literal true for every deletion, even when fresh usage "
"evidence is zero. Class reference discovery is audit evidence, not a "
"guarantee."
msgstr "Kötelező, és minden törlésnél a literális true értéknek kell lennie, akkor is, ha a friss használati bizonyíték értéke nulla. Az osztályhivatkozások felderítése auditbizonyíték, nem garancia."

#: includes/abilities/design.php:4376
msgid "Complete unredacted class row that was deleted."
msgstr "A törölt teljes, kitakarás nélküli osztálysor."

#: includes/abilities/design.php:4877
msgid ""
"Return a single theme style by ID. Omit to list all style IDs and labels "
"(without full settings)."
msgstr "Egyetlen sablonstílus visszaadása ID alapján. Hagyja ki, ha az összes stílus ID-ját és címkéjét szeretné listázni (teljes beállítások nélkül)."

#: includes/abilities/design.php:4896
msgid ""
"Theme styles. With style filter: single style with full settings. Without: "
"all styles with labels only."
msgstr "Sablonstílusok. Stílusszűrővel: egyetlen stílus teljes beállításokkal. Szűrő nélkül: az összes stílus, csak címkékkel."

#: includes/abilities/design.php:4900
msgid ""
"Digest by style ID, always calculated from each complete unredacted "
"authoritative style, including when styles are summarized."
msgstr "Stílus-ID szerinti digest, amelyet mindig a teljes, kitakarás nélküli, hiteles stílusból számít ki, akkor is, ha a stílusok összefoglalva jelennek meg."

#: includes/abilities/design.php:5000
msgid ""
"Theme styles with id, label, condition summary, and settings group keys (no "
"full settings)."
msgstr "Sablonstílusok ID-val, címkével, feltétel-összefoglalóval és a beállítási csoportok kulcsaival (teljes beállítások nélkül)."

#: includes/abilities/design.php:5082
msgid "Display label for the theme style."
msgstr "A sablonstílus megjelenítési címkéje."

#: includes/abilities/design.php:5087
msgid ""
"Optional condition rules. Same shape as template conditions (e.g. `[{ main: "
"\"any\" }]` for site-wide). Stored under `settings.conditions.conditions`, "
"which is the shape Bricks reads at render time. Use `any` (NOT "
"`entireWebsite`) and `terms` (NOT `archiveTerm`)."
msgstr "Opcionális feltételszabályok. Szerkezetük megegyezik a sablonok feltételeiével (például `[{ main: \"any\" }]` a teljes webhelyre vonatkozóan). A rendszer a `settings.conditions.conditions` alatt tárolja őket; ezt a szerkezetet olvassa be a Bricks megjelenítéskor. Használja az `any` értéket (NEM az `entireWebsite` értéket) és a `terms` értéket (NEM az `archiveTerm` értéket)."

#: includes/abilities/design.php:5091
msgid ""
"Optional initial settings, grouped by section (general, typography, colors, "
"buttons, forms, sectionContainer, sectionRows, etc.). Pass `{}` to start "
"blank."
msgstr "Opcionális kezdeti beállítások, szakaszonként csoportosítva (general, typography, colors, buttons, forms, sectionContainer, sectionRows stb.). Az üres kezdéshez adja meg a `{}` értéket."

#: includes/abilities/design.php:5113
msgid ""
"The created theme style. Conditions are persisted under "
"`settings.conditions.conditions`."
msgstr "A létrehozott sablonstílus. A feltételek tárolási helye: `settings.conditions.conditions`."

#: includes/abilities/design.php:5222
msgid "The theme style ID to update."
msgstr "A frissítendő sablonstílus ID-ja."

#: includes/abilities/design.php:5227
msgid "New display label."
msgstr "Új megjelenítési címke."

#: includes/abilities/design.php:5231
msgid "Replace conditions array. Pass omitted to leave unchanged."
msgstr "A conditions tömb cseréje. Hagyja ki, ha nem szeretné módosítani."

#: includes/abilities/design.php:5235
msgid ""
"Settings patch. Deep-merged into the existing settings; pass `null` at any "
"leaf to clear it, or omit `settings` entirely to leave the existing values "
"untouched."
msgstr "Beállításmódosító adatcsomag. A rendszer ezt mélyen egyesíti a meglévő beállításokkal; bármelyik levélszinten megadhatja a `null` értéket az adott érték törléséhez, vagy teljesen kihagyhatja a `settings` mezőt, ha változatlanul szeretné hagyni a meglévő értékeket."

#: includes/abilities/design.php:5239
msgid ""
"If true, `settings` REPLACES the entire settings tree instead of merging. "
"Default false."
msgstr "Ha true, a `settings` a teljes beállításfát lecseréli az egyesítés helyett. Alapértelmezett értéke false."

#: includes/abilities/design.php:5242 includes/abilities/design.php:5411
msgid ""
"Required theme-style ownership including this style itemDigest from the "
"latest theme-style read or write."
msgstr "A legutóbbi sablonstílus-olvasásból vagy -írásból származó kötelező adat, amely igazolja a sablonstílus tulajdonjogát, és tartalmazza ennek a stílusnak az itemDigest értékét."

#: includes/abilities/design.php:5265
msgid "The updated theme style."
msgstr "A frissített sablonstílus."

#: includes/abilities/design.php:5407
msgid "Theme style ID to delete."
msgstr "A törlendő sablonstílus ID-ja."

#: includes/abilities/design.php:5416
msgid ""
"Required and must be literal true when the style has settings or conditions."
" The response includes fresh bounded impact evidence."
msgstr "Kötelező, és akkor is a literális true értéknek kell lennie, ha a stílusnak vannak beállításai vagy feltételei. A válasz friss, korlátozott hatásvizsgálati adatokat tartalmaz."

#: includes/abilities/design.php:5439
msgid "Snapshot of the removed theme style."
msgstr "Az eltávolított sablonstílus pillanatképe."

#: includes/abilities/design.php:5583
msgid ""
"Array of component summaries with id, label, desc, category, properties, "
"variants, slot count, element count, and componentDigest for safe writes."
msgstr "Komponens-összefoglalók tömbje: ID, címke, leírás, kategória, tulajdonságok, változatok, slotok száma, elemek száma és componentDigest a biztonságos íráshoz."

#: includes/abilities/design.php:5707
msgid "The component ID (same as root element ID)."
msgstr "A komponens ID-ja (megegyezik a gyökérelem ID-jával)."

#: includes/abilities/design.php:5728
msgid ""
"Component data: elements, full property definitions, variants, and slots. "
"Code-sensitive settings are redacted when the caller cannot execute code; "
"componentPayloadRedacted reports that state."
msgstr "Komponensadatok: elemek, teljes tulajdonságdefiníciók, változatok és slotok. A kódérzékeny beállítások kitakarva jelennek meg, ha a hívó nem futtathat kódot; ezt az állapotot a componentPayloadRedacted jelzi."

#: includes/abilities/design.php:5732
msgid ""
"Current design-system version. Pass this as expectedDesignSystemVersion when"
" updating or deleting this component."
msgstr "Az aktuális tervezőrendszer verziója. Adja meg ezt expectedDesignSystemVersion értékként a komponens frissítésekor vagy törlésekor."

#: includes/abilities/design.php:5736
msgid ""
"SHA-256 digest of the complete authoritative component record, including "
"unredacted code-sensitive settings and opaque fields. Pass it unchanged as "
"expectedComponentDigest for update/delete."
msgstr "A teljes, hiteles komponensrekord SHA-256 digestje, beleértve a kitakarás nélküli, kódérzékeny beállításokat és az átlátszatlan mezőket. Változatlanul adja meg expectedComponentDigest értékként a frissítéshez vagy törléshez."

#: includes/abilities/design.php:5740
msgid ""
"True when code-sensitive element settings were hidden. The authoritative "
"digest remains usable, but do not replace `elements` from this redacted "
"payload; omit `elements` for metadata-only edits or use a code-authorized "
"read."
msgstr "Igaz, ha a kódérzékeny elembeállítások rejtve voltak. A hiteles digest továbbra is használható, de ne cserélje le az `elements` értékét ebből a kitakart adatcsomagból; csak metaadatokat érintő szerkesztésnél hagyja ki az `elements` értéket, vagy használjon kód futtatására jogosult olvasást."

#: includes/abilities/design.php:5822
msgid "Display label. Must be unique across components."
msgstr "Megjelenítési címke. Egyedinek kell lennie a komponensek között."

#: includes/abilities/design.php:5827
msgid ""
"Elements tree for the component. The first element is the root (id will be "
"set as componentId). Pass `parent: \"0\"` on flat root input. In nested "
"format, you may omit ids. All ids are reassigned on create to avoid "
"collisions and remain 6-character Bricks ids."
msgstr "A komponens elemeinek fája. Az első elem a gyökér (az ID-ja componentId értékre lesz beállítva). Lapos gyökérbemenetnél adja meg a `parent: \"0\"` értéket. Beágyazott formátumban az ID-k elhagyhatók. Létrehozáskor minden ID új értéket kap az ütközések elkerülése érdekében, és 6 karakteres Bricks ID marad."

#: includes/abilities/design.php:5832
msgid ""
"Optional property definitions. Each entry follows the Bricks component "
"property shape: `{ id, label, type, connections, default, desc, group, "
"options, multiple, replace }`. For `type: \"class\"`, `multiple` controls "
"single vs multi-select instance input, `replace` controls merge vs replace "
"behavior, and custom `options` get stable option IDs so instance values can "
"reference presets instead of raw class-id arrays."
msgstr "Opcionális tulajdonságdefiníciók. Minden bejegyzés a Bricks komponens-tulajdonságainak megfelelő szerkezetet követi: `{ id, label, type, connections, default, desc, group, options, multiple, replace }`. `type: \"class\"` esetén a `multiple` határozza meg, hogy a példányban egy vagy több elem választható-e ki, a `replace` pedig az egyesítés vagy a csere módját szabályozza. Az egyéni `options` stabil opció-ID-kat kapnak, így a példányértékek nyers class-ID-tömbök helyett előre beállított opciókra hivatkozhatnak."

#: includes/abilities/design.php:5836
msgid "Optional variant definitions. Each: { id, name }."
msgstr "Opcionális változatdefiníciók. Mindegyik formája: { id, name }."

#: includes/abilities/design.php:5840
msgid ""
"Optional category label for grouping in the builder panel. Reuse an existing"
" component category string when appropriate or provide a new label."
msgstr "Opcionális kategóriacímke a szerkesztőpanelen történő csoportosításhoz. Ha megfelelő, használjon egy meglévő komponenskategória-értéket, vagy adjon meg új címkét."

#: includes/abilities/design.php:5844 includes/abilities/design.php:6733
msgid "Optional component description shown in the builder panel."
msgstr "Opcionális komponensleírás, amely a szerkesztőpanelen jelenik meg."

#: includes/abilities/design.php:5848
msgid "Optional property groups. Each: { id, name }."
msgstr "Opcionális tulajdonságcsoportok. Mindegyik formája: { id, name }."

#: includes/abilities/design.php:5852
msgid ""
"Whether this component is enabled as a block when Bricks component blocks "
"are manual."
msgstr "Megadja, hogy ez a komponens blokként be van-e kapcsolva, amikor a Bricks komponensblokkjai kézi kezelésűek."

#: includes/abilities/design.php:5856
msgid "Optional WordPress block category slug."
msgstr "Opcionális slug a WordPress-blokk kategóriájához."

#: includes/abilities/design.php:5860
msgid "Optional block icon settings."
msgstr "Opcionális blokkikon-beállítások."

#: includes/abilities/design.php:5864
msgid "Optional block preview image settings."
msgstr "Opcionális blokk-előnézeti kép beállításai."

#: includes/abilities/design.php:5884
msgid "The created component (id, elements, properties, variants)."
msgstr "A létrehozott komponens (ID, elemek, tulajdonságok, változatok)."

#: includes/abilities/design.php:6040
msgid "The component ID to update."
msgstr "A frissítendő komponens ID-je."

#: includes/abilities/design.php:6045 includes/abilities/design.php:6497
msgid ""
"Required safety precondition. Pass designSystemVersion from list-"
"components/get-component. From get-design-context, pass "
"designSystemSnapshot.resources.components.version; its top-level version is "
"only the legacy current-site counter on multisite."
msgstr "Kötelező biztonsági előfeltétel. Adja meg a list-components/get-component által visszaadott designSystemVersion értéket. A get-design-context esetén adja meg a designSystemSnapshot.resources.components.version értékét; a legfelső szintű version többwebhelyes rendszerben csak az aktuális webhely régi számlálója."

#: includes/abilities/design.php:6052 includes/abilities/design.php:6504
msgid ""
"Required SHA-256 componentDigest from list-components/get-component or the "
"latest component mutation response. It covers the full authoritative "
"component, including hidden code-sensitive and opaque fields."
msgstr "A list-components/get-component vagy a legutóbbi komponensmódosítási válasz által visszaadott kötelező SHA-256 componentDigest. A teljes, mérvadó komponenst lefedi, beleértve a rejtett, kódérzékeny és nem átlátszó mezőket is."

#: includes/abilities/design.php:6057
msgid "New label. Must remain unique across components."
msgstr "Új címke. A komponensek között egyedinek kell lennie."

#: includes/abilities/design.php:6061
msgid ""
"Replacement elements tree. Passing this replaces the full tree; to edit a "
"single element, read the component first and pass the modified tree back. "
"Element `id` values are internal 6-character Bricks IDs used by builder "
"references and default frontend selectors. In nested format, you may omit "
"ids. In flat format, ids and parent references must be valid 6-character "
"ids."
msgstr "A helyettesítő elemek fája. Ennek megadásával a teljes fa lecserélődik; egyetlen elem szerkesztéséhez először olvassa be a komponenst, majd adja vissza a módosított fát. Az elem `id` értékei a Bricks belső, 6 karakteres ID-i, amelyeket a szerkesztő hivatkozásai és az alapértelmezett frontend-szelektorok használnak. Beágyazott formátumban az ID-k elhagyhatók. Lapos formátumban az ID-knek és a szülőhivatkozásoknak érvényes, 6 karakteres ID-knek kell lenniük."

#: includes/abilities/design.php:6065
msgid ""
"Replacement properties array. For `type: \"class\"`, `multiple` controls "
"single vs multi-select instance input, `replace` controls merge vs replace "
"behavior, and custom `options` get stable option IDs so instance values can "
"reference presets instead of raw class-id arrays."
msgstr "Tulajdonságok tömbjének lecserélése. `type: \"class\"` esetén a `multiple` szabályozza, hogy az elem példányának bevitele egy vagy több érték kiválasztását teszi-e lehetővé, a `replace` pedig az összevonás vagy a csere viselkedését. Az egyéni `options` stabil opcióazonosítókat kapnak, így az elem példányainak értékei nyers class-ID-tömbök helyett előre beállított értékekre hivatkozhatnak."

#: includes/abilities/design.php:6069
msgid "Replacement variants array."
msgstr "A helyettesítő változatok tömbje."

#: includes/abilities/design.php:6073
msgid ""
"Required only when the replacement removes an existing slot. Pass literal "
"true to acknowledge that removing any slot can orphan instance content, even"
" when the current usage scan finds none. Slot IDs are preserved by order "
"where possible. The usage scan is review evidence, not a guarantee that "
"every reference was found."
msgstr "Csak akkor kötelező, ha a helyettesítés egy meglévő slotot távolít el. A slot eltávolításának jóváhagyásához adja meg a szó szerinti true értéket akkor is, ha az aktuális használati ellenőrzés nem talál használatot. A slotok ID-i lehetőség szerint sorrend alapján maradnak meg. A használati ellenőrzés felülvizsgálati bizonyíték, nem garantálja, hogy minden hivatkozást megtalált."

#: includes/abilities/design.php:6077
msgid "New category label, or empty string to clear."
msgstr "Új kategóriacímke, vagy üres karakterlánc a kiürítéshez."

#: includes/abilities/design.php:6081
msgid "New description, or empty string to clear."
msgstr "Új leírás, vagy üres karakterlánc a kiürítéshez."

#: includes/abilities/design.php:6085
msgid "Replacement property groups array. Each: { id, name }."
msgstr "A helyettesítő tulajdonságcsoportok tömbje. Mindegyik: { id, name }."

#: includes/abilities/design.php:6089
msgid ""
"Enable or disable this component as a block when Bricks component blocks are"
" manual."
msgstr "A komponens blokként való bekapcsolása vagy kikapcsolása, ha a Bricks komponensblokkjai manuálisan vannak kezelve."

#: includes/abilities/design.php:6093
msgid "New WordPress block category slug, or empty string to clear."
msgstr "Új WordPress-blokk-kategória slug, vagy üres karakterlánc a kiürítéshez."

#: includes/abilities/design.php:6097
msgid "Replacement block icon settings."
msgstr "A helyettesítő blokkikon beállításai."

#: includes/abilities/design.php:6101
msgid "Replacement block preview image settings."
msgstr "A helyettesítő blokk-előnézeti kép beállításai."

#: includes/abilities/design.php:6125
msgid ""
"Present only when slots were removed. Records the explicit allowSlotOrphans "
"acknowledgement, removed slot IDs, and fresh usage-scan evidence. The "
"evidence is not a guarantee that every reference was found."
msgstr "Csak akkor jelenik meg, ha slotokat távolítottak el. Rögzíti az explicit allowSlotOrphans jóváhagyást, az eltávolított slotok ID-it és a friss használati ellenőrzés bizonyítékait. A bizonyíték nem garantálja, hogy minden hivatkozást megtalált."

#: includes/abilities/design.php:6492
msgid "The component ID to delete."
msgstr "A törlendő komponens ID-je."

#: includes/abilities/design.php:6509
msgid ""
"Required and must be literal true for every deletion, including when current"
" usage is zero. This explicitly accepts that deleting a component can leave "
"missing instances which a usage scan may not discover."
msgstr "Minden törléshez kötelező, és szó szerinti true értéknek kell lennie akkor is, ha az aktuális használat nulla. Ezzel kifejezetten elfogadja, hogy a komponens törlése hiányzó példányokat hagyhat maga után, amelyeket a használati ellenőrzés esetleg nem talál meg."

#: includes/abilities/design.php:6514
msgid ""
"Required review precondition. Delete only if the current fresh usage count "
"matches the reviewed count. This is audit evidence and does not guarantee "
"that every component reference was found; allowOrphans=true is still "
"mandatory."
msgstr "Kötelező felülvizsgálati előfeltétel. Csak akkor töröljön, ha az aktuális, friss használati darabszám megegyezik a felülvizsgált darabszámmal. Ez auditbizonyíték, és nem garantálja, hogy minden komponenshivatkozást megtalált; az allowOrphans=true továbbra is kötelező."

#: includes/abilities/design.php:6536
msgid ""
"Deletion audit snapshot: id, label, componentDigest, elementCount, "
"usageCount, usedOnPosts, and orphaningAccepted. The digest covers the full "
"authoritative component. Usage is computed fresh after the digest "
"precondition passes, but is review evidence rather than a guarantee that "
"every reference was found."
msgstr "Törlési auditpillanatkép: id, label, componentDigest, elementCount, usageCount, usedOnPosts és orphaningAccepted. A digest a teljes, mérvadó komponenst lefedi. A használat kiszámítása frissen történik, miután a digest előfeltétele teljesült, de ez felülvizsgálati bizonyíték, nem garancia arra, hogy minden hivatkozást megtalált."

#: includes/abilities/design.php:6710
msgid "Post ID to extract from."
msgstr "A kinyerés forrásául szolgáló bejegyzés ID-je."

#: includes/abilities/design.php:6715
msgid ""
"Element id that becomes the new component root. Its subtree is cloned into "
"the component; the original element is replaced in-place with a component "
"instance reference."
msgstr "Az elem ID-je, amely az új komponens gyökéreleme lesz. A rendszer az elem részfáját a komponensbe másolja; az eredeti elemet a helyén egy komponenspéldány-hivatkozás váltja fel."

#: includes/abilities/design.php:6720
msgid "Component label. Must be unique across components."
msgstr "A komponens címkéje. A komponensek között egyedinek kell lennie."

#: includes/abilities/design.php:6725
msgid ""
"Which area of the post holds the element: \"content\" (default), \"header\","
" or \"footer\"."
msgstr "A bejegyzés azon területe, amely az elemet tartalmazza: „content” (alapértelmezett), „header” vagy „footer”."

#: includes/abilities/design.php:6729
msgid ""
"Optional category label for grouping the new component in the builder panel."
msgstr "Opcionális kategóriacímke az új komponens szerkesztőpanelen történő csoportosításához."

#: includes/abilities/design.php:6758
msgid ""
"Revision snapshot ID captured before the post write. Pass it to "
"`bricks/restore-revision` to undo."
msgstr "A bejegyzés mentése előtt rögzített változatpillanatkép ID-je. A visszavonáshoz adja meg a `bricks/restore-revision` függvénynek."

#: includes/abilities/design.php:8784
msgid "Filter by category ID. Omit to list all variables."
msgstr "Szűrés kategória-ID alapján. Hagyja el a paramétert az összes változó listázásához."

#: includes/abilities/design.php:8805
msgid ""
"Array of global variables with id, name, value, category, and ready "
"itemOwnership. Returned rows can be passed directly to set-global-variables."
msgstr "Globális változók tömbje id, name, value, category és kész itemOwnership értékekkel. A visszaadott sorok közvetlenül átadhatók a set-global-variables függvénynek."

#: includes/abilities/design.php:8813
msgid ""
"Array of variable categories with id, name, scale config, and ready "
"itemOwnership."
msgstr "Változókategóriák tömbje id, name, scale config és kész itemOwnership értékekkel."

#: includes/abilities/design.php:8907
msgid ""
"Array of variables to upsert. Each: { id, name, value, category, scale?, "
"paletteImportSource? }. Preserve paletteImportSource from returned rows: it "
"identifies unchanged copies awaiting a palette import. Ready rows from list-"
"global-variables can be passed directly; response-only itemDigest and "
"itemOwnership are stripped before validation. Variables with matching id are"
" updated, new variables are appended. Existing variables not in this array "
"are preserved. For typography/spacing scale variables, use bricks/generate-"
"scale-variables."
msgstr "A hozzáadandó vagy frissítendő változók tömbje. Mindegyik: { id, name, value, category, scale?, paletteImportSource? }. Őrizze meg a visszaadott sorok paletteImportSource értékét: ez azonosítja a palettaimportálásra váró, változatlan másolatokat. A list-global-variables által visszaadott kész sorok közvetlenül átadhatók; a csak a válaszban szereplő itemDigest és itemOwnership mezők a validálás előtt eltávolításra kerülnek. Az egyező id értékű változók frissülnek, az új változók hozzáfűződnek. Azok a meglévő változók, amelyek nem szerepelnek ebben a tömbben, megmaradnak. Tipográfiai vagy térközskála-változókhoz használja a bricks/generate-scale-variables függvényt."

#: includes/abilities/design.php:8912
msgid ""
"Reserved for a future atomic variables-and-categories transaction. Omit this"
" field: combined category writes are currently rejected before any mutation "
"so a conflict cannot leave the two stores torn."
msgstr "A jövőbeli atomikus változó- és kategória-tranzakció számára fenntartva. Hagyja ki ezt a mezőt: a kategóriák és változók együttes írása jelenleg minden módosítás előtt elutasításra kerül, így ütközés esetén a két adattár nem kerülhet inkonzisztens állapotba."

#: includes/abilities/design.php:8915
msgid ""
"Required exact variable ownership from the latest list or variable write."
msgstr "A legutóbbi listázásból vagy változóírásból származó pontos változótulajdonlási adat kötelező."

#: includes/abilities/design.php:8918
msgid ""
"Required exact category ownership from the same latest list. Categories are "
"a guarded validation dependency."
msgstr "Az ugyanazon legutóbbi listázásból származó pontos kategóriatulajdonlási adat kötelező. A kategóriák védett validálási függőséget jelentenek."

#: includes/abilities/design.php:8938
msgid "The saved variables array."
msgstr "A mentett változók tömbje."

#: includes/abilities/design.php:8942
msgid "The saved categories array."
msgstr "A mentett kategóriák tömbje."

#: includes/abilities/design.php:8946
msgid ""
"Non-blocking warnings about category mismatches or scale categories that "
"should use generate-scale-variables."
msgstr "Nem blokkoló figyelmeztetések a kategóriaeltérésekről vagy azokról a skálakategóriákról, amelyekhez a generate-scale-variables függvényt kell használni."

#: includes/abilities/design.php:9763
msgid ""
"Complete replacement global-variable category list. Preserve opaque fields "
"returned by the latest read; response-only itemDigest and itemOwnership "
"fields are stripped before persistence."
msgstr "A globális változók kategóriáinak teljes, helyettesítő listája. Őrizze meg a legutóbbi beolvasásból visszaadott, nem értelmezett mezőket; a csak a válaszban szereplő itemDigest és itemOwnership mezők mentés előtt eltávolításra kerülnek."

#: includes/abilities/design.php:9766
msgid ""
"Required exact category ownership from the latest global-variable read or "
"category write."
msgstr "A legutóbbi globálisváltozó-beolvasásból vagy kategóriaírásból származó pontos kategóriatulajdonlási adat kötelező."

#: includes/abilities/design.php:9769
msgid ""
"Required exact variable ownership from the same latest global-variable read."
" Category removals are guarded against this variable store."
msgstr "Ugyanazon legutóbbi globálisváltozó-beolvasásból származó pontos változótulajdonlási adat kötelező. A kategóriák eltávolítását a rendszer a változótárral összevetve ellenőrzi."

#: includes/abilities/design.php:10007
msgid "Global variable ID to delete."
msgstr "A törlendő globális változó ID-je."

#: includes/abilities/design.php:10011
msgid ""
"Required ready itemOwnership from the latest global-variable read or write."
msgstr "A legutóbbi globálisváltozó-beolvasásból vagy -írásból származó kész itemOwnership kötelező."

#: includes/abilities/design.php:10015
msgid ""
"Required and must be literal true for every deletion, even when fresh "
"bounded usage evidence is zero. Reference discovery is audit evidence, not a"
" guarantee."
msgstr "Minden törléshez kötelező, és szó szerinti true értéknek kell lennie akkor is, ha a friss, korlátozott hatókörű használati vizsgálat eredménye nulla. A hivatkozások feltárása auditbizonyíték, nem garancia."

#: includes/abilities/design.php:10038
msgid "Snapshot of the removed variable."
msgstr "Az eltávolított változó pillanatképe."

#: includes/abilities/design.php:10299
msgid ""
"Include `usedOnPosts` per component, limited to posts the caller can edit in"
" the Builder. Off by default: the first computation scans every Bricks post "
"and can take a few seconds on large sites. Usage is cached for one hour and "
"filtered for the current caller on every read."
msgstr "A usedOnPosts értéket komponensenként tartalmazza, és csak azokra a bejegyzésekre korlátozza, amelyeket a hívó a szerkesztőben módosíthat. Alapértelmezés szerint kikapcsolva: az első számítás minden Bricks-bejegyzést átvizsgál, ami nagy webhelyeken néhány másodpercig tarthat. A használati adatok egy órán át gyorsítótárazva maradnak, és minden beolvasáskor az aktuális hívóra szűrődnek."

#: includes/abilities/design.php:10304
msgid ""
"Use `summary` for session orientation: includes counts, breakpoints, and "
"capped resource lists. Default `detailed` preserves the full current "
"response."
msgstr "A munkamenet áttekintéséhez használja a `summary` értéket: darabszámokat, töréspontokat és korlátozott elemszámú erőforráslistákat tartalmaz. Az alapértelmezett `detailed` érték megőrzi a teljes aktuális választ."

#: includes/abilities/design.php:10310
msgid ""
"Maximum items per large list when `responseFormat` is `summary`. Default "
"100."
msgstr "Az egyes nagy listák legfeljebb ennyi tételt tartalmazhatnak, ha a `responseFormat` értéke `summary`. Alapértelmezett érték: 100."

#: includes/abilities/design.php:10335
msgid ""
"Global variable categories, including scale configs used by generate-scale-"
"variables."
msgstr "Globális változókategóriák, beleértve a generate-scale-variables által használt skálabeállításokat."

#: includes/abilities/design.php:10339
msgid ""
"Current responsive breakpoint contract: customEnabled, isMobileFirst, "
"baseKey, baseWidth, and active breakpoint items."
msgstr "Az aktuális reszponzív töréspont-szerződés: customEnabled, isMobileFirst, baseKey, baseWidth és az aktív töréspontok tételei."

#: includes/abilities/design.php:10343
msgid "Present in summary responses when large lists were capped."
msgstr "Akkor jelenik meg az összefoglaló válaszokban, ha a nagy listák korlátozva voltak."

#: includes/abilities/design.php:10347
msgid ""
"Legacy current-site design counter. On mixed-authority multisite setups, use"
" designSystemSnapshot and the resource-specific versions instead."
msgstr "Régi, az aktuális webhelyre vonatkozó dizájnszámláló. Vegyes jogosultságú multisite-beállítások esetén használja inkább a designSystemSnapshot értékét és az erőforrás-specifikus verziókat."

#: includes/abilities/design.php:10351
msgid ""
"Authority-correct design snapshot. Use its resource version for focused "
"writes and its token for workspace drift checks."
msgstr "A jogosultságoknak megfelelő dizájn-pillanatkép. Célzott írásokhoz használja az erőforrás verzióját, a munkaterület eltéréseinek ellenőrzéséhez pedig a tokenjét."

#: includes/abilities/design.php:10362
msgid ""
"True when component usage was served from the transient. Absent when "
"`includeUsage` was not requested."
msgstr "Igaz, ha a komponenshasználat a transient tárolóból származik. Nem szerepel, ha az includeUsage paramétert nem kérte."

#: includes/abilities/design.php:11034
msgid ""
"ID of the palette that owns the base color. Required when `save` is true."
msgstr "Annak a palettának az ID-ja, amelyhez az alapszín tartozik. Kötelező, ha a save értéke true."

#: includes/abilities/design.php:11038
msgid "ID of the base color inside the palette. Required when `save` is true."
msgstr "Az alapszín ID-ja a palettán belül. Kötelező, ha a save értéke true."

#: includes/abilities/design.php:11042
msgid ""
"Raw base color string (hex, rgb(a), or hsl(a)). Required when `paletteId` / "
"`colorId` are omitted. Lets you preview shades without needing an existing "
"palette."
msgstr "Az alapszín nyers színkarakterlánca (hex, rgb(a) vagy hsl(a)). Kötelező, ha a paletteId / colorId nincs megadva. Lehetővé teszi az árnyalatok előnézetét meglévő paletta nélkül."

#: includes/abilities/design.php:11046
msgid ""
"Optional CSS variable reference for the base (e.g. `var(--primary)`). When "
"present, shade `raw` becomes `var(--{name}-{l|d|t}-{index})` to match the "
"builder's auto-naming."
msgstr "Opcionális CSS-változó-hivatkozás az alaphoz (például `var(--primary)`). Ha meg van adva, az árnyalat `raw` értéke `var(--{name}-{l|d|t}-{index})` lesz, a szerkesztő automatikus elnevezésének megfelelően."

#: includes/abilities/design.php:11050
msgid ""
"Param name is exactly `shadeType` (NOT `type`). One of: light (mix toward "
"white), dark (mix toward black), transparent (reduce alpha on base HSL)."
msgstr "A paraméter neve pontosan `shadeType` (NEM `type`). Lehetséges értékek: light (fehérrel keverés), dark (feketével keverés), transparent (az alapszín HSL-értékének alfa-csökkentése)."

#: includes/abilities/design.php:11056
msgid ""
"Param name is exactly `steps` (NOT `count`). How many shades to generate "
"(excluding the original color). Matches the builder's \"Shade steps\" input."
" Clamped to 1-20."
msgstr "A paraméter neve pontosan `steps` (NEM `count`). A létrehozandó árnyalatok száma (az eredeti szín nélkül). Megfelel a szerkesztő „Árnyalati lépések” mezőjének. Az érték 1 és 20 közé van korlátozva."

#: includes/abilities/design.php:11063
msgid ""
"light (default) or dark. When dark, shades are stored in each shade's `dark`"
" field to match the builder's dark-mode pair. Only set dark if the base "
"color has darkModeEnabled."
msgstr "light (alapértelmezett) vagy dark. dark esetén az árnyalatok az egyes árnyalatok `dark` mezőjébe kerülnek, a szerkesztő sötét módú párjának megfelelően. A dark értéket csak akkor állítsa be, ha az alapszínnél be van kapcsolva a darkModeEnabled."

#: includes/abilities/design.php:11068
msgid ""
"When true, remove any existing shades of the same type/parent/mode from the "
"palette and insert the new ones. When false (default), return the generated "
"shades for review."
msgstr "Ha true, eltávolítja a palettából az azonos típusú, szülőelemű és módú meglévő árnyalatokat, majd beszúrja az újakat. Ha false (alapértelmezett), ellenőrzésre visszaadja a létrehozott árnyalatokat."

#: includes/abilities/design.php:11071
msgid ""
"Required when save is true. Use saveOwnership from a preview targeting this "
"palette color. Includes the parent color digest and complete palette "
"resource digest."
msgstr "Kötelező, ha a save értéke true. Használjon egy, erre a palettaszínre irányuló előnézetből származó saveOwnership értéket. Tartalmazza a szülőszín kivonatát és a teljes palettaerőforrás kivonatát."

#: includes/abilities/design.php:11092
msgid "Generated shade objects: { id, type, raw, light|dark, index, parent }."
msgstr "Létrehozott árnyalati objektumok: { id, type, raw, light|dark, index, parent }."

#: includes/abilities/design.php:11454
msgid ""
"ID of an existing global variable category with a scale config. Mutually "
"exclusive with `category`."
msgstr "Skálakonfigurációval rendelkező globális változókategória ID-ja. Nem használható együtt a `category` paraméterrel."

#: includes/abilities/design.php:11458
msgid ""
"Inline category definition for preview-only generation. Use this to preview "
"a scale before saving the category. Must include `scale` object. Mutually "
"exclusive with `categoryId`."
msgstr "Beágyazott kategóriameghatározás, kizárólag előnézeti létrehozáshoz. Ezzel a kategória mentése előtt megtekintheti a skála előnézetét. Tartalmaznia kell egy `scale` objektumot. Nem használható együtt a `categoryId` paraméterrel."

#: includes/abilities/design.php:11462
msgid ""
"Inclusive range of scale steps relative to baseline. Default: { from: -2, "
"to: 4 }. Example: -1 is one step below baseline, +2 is two steps above."
msgstr "A skálalépések inkluzív tartománya az alapértékhez viszonyítva. Alapértelmezett érték: { from: -2, to: 4 }. Példa: a -1 egy lépéssel az alapérték alatt, a +2 pedig két lépéssel felette van."

#: includes/abilities/design.php:11470
msgid ""
"Reserved for atomic preview/apply. Direct two-store persistence currently "
"fails closed; use the preview rows with ownership-guarded variable/category "
"abilities."
msgstr "Az atomikus előnézethez és alkalmazáshoz van fenntartva. A két tárolóba történő közvetlen mentés jelenleg biztonsági okból meghiúsul; használja az előnézeti sorokat a tulajdonjog-ellenőrzéssel védett változó-/kategóriaképességekkel."

#: includes/abilities/design.php:11473
msgid "Variable ownership returned in saveOwnership by the preview."
msgstr "A változó tulajdonjogi adatai, amelyeket az előnézet a saveOwnership mezőben ad vissza."

#: includes/abilities/design.php:11474
msgid "Category resource ownership returned in saveOwnership by the preview."
msgstr "A kategória-erőforrás tulajdonjogi adatai, amelyeket az előnézet a saveOwnership mezőben ad vissza."

#: includes/abilities/design.php:11492
msgid "Generated variable objects (id, name, value, category, scale)."
msgstr "Létrehozott változóobjektumok (id, name, value, category, scale)."

#: includes/abilities/design.php:11496
msgid ""
"Step names for the generated range, in order. Written back to the category "
"when `save` is true."
msgstr "A létrehozott tartomány lépésnevei sorrendben. A rendszer visszaírja őket a kategóriába, ha a `save` értéke true."

#: includes/abilities/design.php:11500
msgid "Whether the variables were persisted to the global variables store."
msgstr "Jelzi, hogy a változók mentése megtörtént-e a globális változótárolóba."

#: includes/abilities/design.php:11504
msgid "Math basis used: htmlFontSizePx, minScreenWidth, maxScreenWidth, unit."
msgstr "A használt matematikai alap: htmlFontSizePx, minScreenWidth, maxScreenWidth, unit."

#: includes/abilities/design.php:12067
msgid ""
"Filter which audit categories to run. `orphans` = references to missing "
"resources (broken). `unused` = resources referenced nowhere (cleanup). "
"`theme-styles` = theme styles with no conditions (dead). `palettes` = "
"fragmentation signals. `all` runs everything."
msgstr "Adja meg, mely ellenőrzési kategóriákat futtassa. Az `orphans` a hiányzó erőforrásokra mutató hivatkozásokat (hibás hivatkozások), az `unused` a sehol sem hivatkozott erőforrásokat (tisztítás), a `theme-styles` a feltétel nélküli sablonstílusokat (inaktív), a `palettes` pedig a töredezettségre utaló jeleket jelenti. Az `all` mindent futtat."

#: includes/abilities/design.php:12072
msgid ""
"Skip the posts and templates scan. Faster, but disables unused-class, "
"unused-variable, unused-component, and orphan-class detection. Only the "
"palette and theme-style configuration are checked."
msgstr "Kihagyja a bejegyzések és sablonminták vizsgálatát. Gyorsabb, de kikapcsolja a nem használt CSS-osztályok, változók és komponensek, valamint az árva CSS-osztályok észlelését. Csak a paletta és a sablonstílusok konfigurációját ellenőrzi."

#: includes/abilities/design.php:12349 includes/abilities/design.php:12397
msgid "--"
msgstr "--"

#: includes/abilities/design.php:12381
msgid "."
msgstr "."

#: includes/abilities/element-conditions.php:186
msgid "The element ID whose display conditions you want to read."
msgstr "Annak az elemnek az ID-ja, amelynek megjelenítési feltételeit le szeretné kérni."

#: includes/abilities/element-conditions.php:211
msgid ""
"Element display conditions. Outer array is OR groups, inner arrays are AND "
"items."
msgstr "Az elem megjelenítési feltételei. A külső tömb VAGY-csoportokat, a belső tömbök pedig ÉS-tételeket tartalmaznak."

#: includes/abilities/element-conditions.php:275
#: includes/abilities/interactions.php:472
msgid "The element ID."
msgstr "Az elem ID-ja."

#: includes/abilities/element-conditions.php:279
msgid ""
"Full replacement of the `_conditions` array. Outer array is OR groups, inner"
" arrays are AND items. Pass an empty array to clear all conditions."
msgstr "A `_conditions` tömb teljes cseréje. A külső tömb VAGY-csoportokat, a belső tömbök pedig ÉS-tételeket tartalmaznak. Az összes feltétel kiürítéséhez adjon meg egy üres tömböt."

#: includes/abilities/element-conditions.php:310
#: includes/abilities/filters.php:440 includes/abilities/forms.php:502
#: includes/abilities/interactions.php:505
msgid "Revision ID of the pre-save snapshot."
msgstr "A mentés előtti pillanatkép változatának ID-ja."

#: includes/abilities/element-conditions.php:385
msgid "Unique condition row ID. Generated when omitted."
msgstr "Egyedi feltételsor-ID. Ha nincs megadva, a rendszer automatikusan létrehozza."

#: includes/abilities/element-conditions.php:389
msgid "Condition type."
msgstr "A feltétel típusa."

#: includes/abilities/element-conditions.php:393
msgid "Comparison operator. Defaults to `==` when omitted."
msgstr "Összehasonlító operátor. Alapértelmezett értéke `==`, ha nincs megadva."

#: includes/abilities/element-conditions.php:398
msgid ""
"Value to compare against. Not required when compare is `empty` or "
"`empty_not`."
msgstr "Az összehasonlításhoz használt érték. Nem kötelező, ha a compare értéke `empty` vagy `empty_not`."

#: includes/abilities/element-conditions.php:402
msgid ""
"Dynamic data tag used by key `dynamic_data`, for example `{post_title}`."
msgstr "A `dynamic_data` kulcs által használt dinamikusadat-címke, például `{post_title}`."

