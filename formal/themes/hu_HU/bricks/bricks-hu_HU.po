"Browse and insert templates and components from other Bricks installations."
msgstr "Sablonok és komponensek böngészése és beszúrása más Bricks-telepítésekből."

#: includes/admin/admin-screen-settings.php:1487
msgid "Name to display instead of the site URL in the source dropdown."
msgstr "A webhely URL-je helyett megjelenítendő név a források legördülő listájában."

#: includes/admin/admin-screen-settings.php:1491
