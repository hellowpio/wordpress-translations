#. Plugin Name of the plugin
#. translators: The plugin's own name, used as a link text, as a link tooltip
#. and as the admin menu label. It is a product name and stays in English.
#: wpml-woocommerce.php classes/AdminNotices/ExportImport.php:189
#: inc/admin-menus/class-wcml-admin-menus.php:419
msgid "WPML Multilingual & Multicurrency for WooCommerce"
msgstr "WPML Multilingual & Multicurrency for WooCommerce"

#. Plugin URI of the plugin
#: wpml-woocommerce.php
msgid ""
"https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml"

#. Description of the plugin
#: wpml-woocommerce.php
msgid ""
"Make your store multilingual and enable multiple currencies | <a "
"href=\"https://wpml.org/documentation/wpml-core-and-add-on-"
"plugins/woocommerce-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml\">Documentation</a>"
msgstr "Tedd többnyelvűvé az áruházadat, és tedd lehetővé több pénznem használatát | <a href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/woocommerce-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=wcml\">dokumentáció</a>"

#. Author of the plugin
#: wpml-woocommerce.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: wpml-woocommerce.php
msgid "http://www.onthegosystems.com/"
msgstr "http://www.onthegosystems.com/"

#. translators: Description of the language input offered to an AI assistant
#. that queries WooCommerce products and orders.
#: classes/Abilities/Hooks.php:75
msgid "Language of the content to read."
msgstr "Az olvasandó tartalom nyelve."

#. translators: Description of the currency input offered to an AI assistant
#. that queries WooCommerce products and orders.
#: classes/Abilities/Hooks.php:87
msgid "Currency for the returned prices."
msgstr "A visszaadott árak pénzneme."

#. translators: Heading of an admin notice about a caching plugin. "WPML
#. Multilingual & Multicurrency for WooCommerce" is the plugin name and stays
#. in English.
#: classes/AdminNotices/CachePlugins.php:34
msgid ""
"WPML Multilingual & Multicurrency for WooCommerce detected an active cache "
"plugin on your site."
msgstr "A WPML Multilingual & Multicurrency for WooCommerce aktív gyorsítótár-bővítményt észlelt a webhelyeden."

#. translators: First line of the admin notice about a caching plugin, under
#. the heading.
#: classes/AdminNotices/CachePlugins.php:36
msgid ""
"Caching may cause currency display issues for your customers if you are "
"using the multicurrency feature."
msgstr "Ha a többpénznemű funkciót használod, a gyorsítótárazás miatt problémák merülhetnek fel a pénznemek megjelenítésével a vásárlóidnál."

#. translators: Last line of the admin notice about a caching plugin; "this"
#. is the wrong currency being shown to shoppers.
#: classes/AdminNotices/CachePlugins.php:38
msgid ""
"To avoid this, set your cache plugin to not cache pages for visitors that "
"have a cookie set in their browser."
msgstr "Ennek elkerüléséhez állítsd be a gyorsítótár-bővítményt úgy, hogy ne tárolja gyorsítótárban azokat az oldalakat, amelyeket olyan látogatók keresnek fel, akiknek a böngészőjében cookie van beállítva."

#. translators: Heading of an admin notice telling the shop owner that Twig
#. currency-switcher templates are going away. Keep the bold tags around the
#. feature name.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:56
msgid "Important: Action Needed for Your <b>Currency Switcher</b>"
msgstr "Fontos: teendő a <b>pénznemváltóval</b> kapcsolatban"

#. translators: First paragraph of the admin notice about Twig currency-
#. switcher templates. Keep the bold tags around the feature name; "Twig" is a
#. template technology and stays in English.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:58
msgid ""
"We detected that your site is using a <b>Currency Switcher</b> built with "
"Twig templates. For security reasons, support for Twig-based templates will "
"be discontinued in the upcoming version of WPML Multilingual & Multicurrency"
" for WooCommerce 5.6."
msgstr "Észleltük, hogy a webhelyed Twig-sablonokkal készült <b>pénznemváltót</b> használ. Biztonsági okokból a Twig-alapú sablonok támogatása megszűnik a WPML Multilingual & Multicurrency for WooCommerce 5.6 közelgő verziójában."

#. translators: Line that introduces the list of steps in the admin notice
#. about Twig currency-switcher templates. Keep the bold tags around the
#. feature name.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:60
msgid "To ensure your <b>Currency Switcher</b> continues working smoothly:"
msgstr "A <b>pénznemváltó</b> zavartalan működésének biztosításához:"

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:66
#, php-format
msgid ""
"- Switch to a PHP-based template - you can select one from the "
"%1$sconfiguration page%2$s."
msgstr "- Válts PHP-alapú sablonra – kiválaszthatsz egyet a %1$skonfigurációs oldalról%2$s."

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:74
#, php-format
msgid ""
"- Need a custom solution? %1$sContact our support%2$s - we’re here to help "
"you migrate safely."
msgstr "- Egyedi megoldásra van szükséged? %1$sLépj kapcsolatba a támogatási csapatunkkal%2$s - segítünk biztonságosan átállni."

#. translators: Closing paragraph of the admin notice about Twig currency-
#. switcher templates. Keep the bold tags around the feature name.
#: classes/AdminNotices/CurrencySwitcherUseTwigTemplate.php:81
msgid ""
"We recommend updating your <b>Currency Switcher</b> as soon as possible to "
"avoid disruptions when the new version of WPML Multilingual & Multicurrency "
"for WooCommerce is released."
msgstr "Javasoljuk, hogy a lehető leghamarabb frissítsd a <b>pénznemváltót</b>, hogy elkerüld a fennakadásokat a WPML Multilingual & Multicurrency for WooCommerce új verziójának megjelenésekor."

#. translators: %s is a link.
#: classes/AdminNotices/ExportImport.php:154
#, php-format
msgid ""
"Migrating your multilingual shop? With %s you can transfer your translated "
"content to a new site, including cross-sells, up-sells, and product "
"attributes."
msgstr "Migrálod a többnyelvű áruházadat? A %s segítségével átviheted a lefordított tartalmadat egy új webhelyre, beleértve a keresztértékesítéseket, a felülértékesítéseket és a termékattribútumokat."

#. translators: %1$s and %2$s are both links.
#: classes/AdminNotices/ExportImport.php:165
#, php-format
msgid ""
"Looking to import your multilingual shop? With %1$s and %2$s in both your "
"original and new site, you can export and import your translations "
"automatically."
msgstr "Többnyelvű áruházadat szeretnéd importálni? Ha %1$s és %2$s megtalálható mind az eredeti, mind az új webhelyeden, a fordításokat automatikusan exportálhatod és importálhatod."

#. translators: Name of the WPML Export and Import plugin, used as a link text
#. and as the link's tooltip in an admin notice. It is a product name and
#. stays in English.
#: classes/AdminNotices/ExportImport.php:177
msgid "WPML Export and Import"
msgstr "WPML Export and Import"

#: classes/AdminNotices/LegacySubscriptionsOnV9.php:85
msgid "Your subscription products are hidden from the shop"
msgstr "Az előfizetéses termékeid rejtve vannak az áruházban"

#: classes/AdminNotices/LegacySubscriptionsOnV9.php:86
msgid ""
"This site has Simple subscription or Variable subscription products. "
"WooCommerce Subscriptions 9 hides them from your shop while those product "
"types are turned off. Their data and translations are safe. To sell them "
"again, turn the product types on under Subscription product creation in the "
"subscription settings."
msgstr "Ezen a webhelyen egyszerű előfizetéses vagy változó előfizetéses termékek vannak. A WooCommerce Subscriptions 9 elrejti őket az áruházból, amíg ezek a terméktípusok ki vannak kapcsolva. Az adataik és fordításaik biztonságban vannak. Az újbóli értékesítésükhöz kapcsold be a terméktípusokat az előfizetés beállításainál, az előfizetéses termékek létrehozása szakaszban."

#: classes/AdminNotices/LegacySubscriptionsOnV9.php:90
msgid "Open subscription settings"
msgstr "Előfizetési beállítások megnyitása"

#. translators: Heading of an admin notice shown when multicurrency is on but
#. only one currency exists.
#: classes/AdminNotices/MultiCurrencyMissing.php:52
msgid "You haven't added any secondary currencies"
msgstr "Még nem adtál hozzá másodlagos pénznemet"

#. translators: Body of the admin notice shown when multicurrency is on but
#. only one currency exists; "this setting" is multicurrency mode.
#: classes/AdminNotices/MultiCurrencyMissing.php:54
msgid ""
"Please add another currency to fully utilize multicurrency mode. If you do "
"not need multiple currencies, you can disable this setting to improve your "
"site's performance."
msgstr "Adj hozzá egy másik pénznemet, hogy teljes mértékben kihasználd a többpénznemű módot. Ha nincs szükséged több pénznemre, kikapcsolhatod ezt a beállítást a webhely teljesítményének javítása érdekében."

#. translators: Link text at the end of the admin notice about having only one
#. currency; it opens the multicurrency settings tab.
#: classes/AdminNotices/MultiCurrencyMissing.php:58
msgid "Configure multicurrency mode"
msgstr "Többpénznemű mód beállítása"

#. translators: Button label in an admin notice that opens the plugin's review
#. page on WordPress.org. Verb, imperative: write a review.
#: classes/AdminNotices/Review.php:48
msgid "Review WPML Multilingual & Multicurrency for WooCommerce"
msgstr "A WPML Multilingual & Multicurrency for WooCommerce értékelése"

#. translators: Heading of the admin notice that congratulates the shop owner
#. on the first order paid in a secondary currency.
#: classes/AdminNotices/Review.php:60
msgid "Congrats on making your first multicurrency sale!"
msgstr "Gratulálunk az első többpénznemű értékesítésedhez!"

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/AdminNotices/Review.php:66
#, php-format
msgid ""
"Want to help <strong>WPML Multilingual & Multicurrency for "
"WooCommerce</strong> plugin? %1$sGive us a review%2$s!"
msgstr "Szeretnéd támogatni a <strong>WPML Multilingual & Multicurrency for WooCommerce</strong> bővítményt? %1$sÍrj értékelést a bővítményről%2$s!"

#. translators: %s is a comma-separated list of terms with their language
#. code, for example "Kitchen (EN)".
#: classes/Coupons/AdminRestrictionsHooks.php:81
#, php-format
msgid "Also in other languages: %s. These stay saved."
msgstr "Más nyelveken is: %s. Ezek elmentve maradnak."

#: classes/Coupons/AdminRestrictionsHooks.php:230
msgid "Product categories"
msgstr "Termékkategóriák"

#: classes/Coupons/AdminRestrictionsHooks.php:231
msgid "Exclude categories"
msgstr "Kategóriák kizárása"

#: classes/Coupons/AdminRestrictionsHooks.php:232
msgid "Product brands"
msgstr "Termékmárkák"

#: classes/Coupons/AdminRestrictionsHooks.php:233
msgid "Exclude brands"
msgstr "Márkák kizárása"

#. translators: Only entry of the currency dropdown on the WooCommerce
#. reports, shown when the shop has no orders yet.
#: classes/currencies/class-wcml-admin-currency-selector.php:89
#: inc/currencies/class-wcml-multi-currency-reports.php:164
msgid "Currency - no orders found"
msgstr "Pénznem - nem találhatók rendelések"

#. translators: Error returned when a request carries an expired or missing
#. security token.
#: classes/currencies/class-wcml-admin-currency-selector.php:108
#: classes/Multicurrency/StripeConnect/Hooks.php:68
#: compatibility/WcBookings/MulticurrencyHooks.php:712
#: inc/class-wcml-orders.php:215
#: inc/currencies/class-wcml-multi-currency-orders.php:439
#: inc/currencies/class-wcml-multi-currency-reports.php:139
msgid "Invalid nonce"
msgstr "Érvénytelen nonce"

#. translators: First line of the notice shown after saving a variable
#. product, when only the product's own fields were synced.
#: classes/EditorScopedSync/Notices.php:196
msgid "WPML synced translations for product-level changes only."
msgstr "A WPML csak a termékszintű módosítások fordításait szinkronizálta."

#. translators: 1: number of synced variations, 2: total variations in product
#: classes/EditorScopedSync/Notices.php:200
#, php-format
msgid "WPML synced translations for %1$d of %2$d variations."
msgstr "A WPML a %2$d variáció közül %1$d fordítását szinkronizálta."

#. translators: %d: number of variations that were not checked
#: classes/EditorScopedSync/Notices.php:214
#, php-format
msgid ""
"%d other variation was not checked because its data didn't change here."
msgid_plural ""
"%d other variations were not checked because their data didn't change here."
msgstr[0] "%d egyéb variáció ellenőrzése kimaradt, mert itt nem változtak az adatai."
msgstr[1] "%d egyéb variáció ellenőrzése kimaradt, mert itt nem változtak az adataik."

#. translators: %s: "Force update all" label
#: classes/EditorScopedSync/Notices.php:228
#, php-format
msgid ""
"If you've made changes <strong>outside this editor</strong> (for example, "
"retranslating an attribute term), use <em>%s</em> below to make sure every "
"translation is current."
msgstr "Ha <strong>ezen a szerkesztőn kívül</strong> módosítottál valamit (például újrafordítottál egy attribútumkifejezést), használd az alábbi <em>%s</em> lehetőséget, hogy minden fordítás aktuális legyen."

#. translators: Name of the button on the same notice, used inside the
#. sentence above it. Verb phrase, imperative: sync every variation now.
#: classes/EditorScopedSync/Notices.php:230
msgid "Force update all"
msgstr "Összes frissítésének kényszerítése"

#. translators: Button label on the notice shown after saving a variable
#. product. Verb, imperative.
#: classes/EditorScopedSync/Notices.php:236
msgid "Force update all variation translations"
msgstr "Az összes variációfordítás kényszerített frissítése"

#. translators: %s: link to the WCML Settings page
#: classes/EditorScopedSync/Notices.php:243
#, php-format
msgid "You can switch to <em>\"Always check all variations\"</em> on the %s."
msgstr "A %s oldalon átválthatsz a <em>„Mindig az összes variáció ellenőrzése”</em> beállításra."

#. translators: Link text pointing at the plugin's Settings page, inside the
#. notice shown after saving a variable product.
#: classes/EditorScopedSync/Notices.php:248
#: classes/EditorScopedSync/Notices.php:444
msgid "WCML Settings page"
msgstr "WCML-beállítások oldala"

#. translators: Text read out by screen readers after a link that opens in a
#. new browser tab.
#: classes/EditorScopedSync/Notices.php:250
#: classes/EditorScopedSync/Notices.php:446
msgid "(opens in a new tab)"
msgstr "(új lapon nyílik meg)"

#. translators: Label the button changes to while it is syncing every
#. variation of the product.
#: classes/EditorScopedSync/Notices.php:264
msgid "Syncing all variations…"
msgstr "Összes variáció szinkronizálása…"

#. translators: Label the button changes to when syncing every variation has
#. finished.
#: classes/EditorScopedSync/Notices.php:275
msgid "Done — all variations synced"
msgstr "Kész — az összes variáció szinkronizálva"

#. translators: Confirmation shown next to the button after every variation
#. was synced. %d: the product's numeric ID.
#: classes/EditorScopedSync/Notices.php:278
#, php-format
msgid "Sync completed for product #%d."
msgstr "A(z) #%d termék szinkronizálása befejeződött."

#. translators: Label the button changes to when syncing the variations
#. failed; "console" is the browser's developer console.
#: classes/EditorScopedSync/Notices.php:281
msgid "Failed — see console"
msgstr "Sikertelen — nézd meg a konzolt"

#. translators: Start of the button label when syncing the variations threw an
#. error; the error text is appended after it. Keep the trailing space.
#: classes/EditorScopedSync/Notices.php:285
msgid "Error — "
msgstr "Hiba — "

#. translators: Accessible label (screen readers) of the close button that
#. hides an admin notice. Verb, imperative.
#: classes/EditorScopedSync/Notices.php:413
#: inc/admin-menus/class-wcml-admin-menus.php:356
#: inc/class-wcml-cart-sync-warnings.php:96
msgid "Dismiss"
msgstr "Bezárás"

#. translators: 1: number of variations checked, 2: number of translation
#. languages
#: classes/EditorScopedSync/Notices.php:418
#, php-format
msgid ""
"WPML verified %1$d variation × %2$d language on this save. None of them had "
"changes that needed syncing."
msgid_plural ""
"WPML verified %1$d variations × %2$d languages on this save. None of them "
"had changes that needed syncing."
msgstr[0] "A WPML %1$d variációt × %2$d nyelvet ellenőrzött ennél a mentésnél. Egyiknél sem volt szinkronizálást igénylő változás."
msgstr[1] "A WPML %1$d variációt × %2$d nyelvet ellenőrzött ennél a mentésnél. Egyiknél sem volt szinkronizálást igénylő változás."

#. translators: Second paragraph of the notice shown after a save that checked
#. every variation and changed none; the quoted text is the name of a setting
#. on the plugin's Settings page and is translated the same way there.
#: classes/EditorScopedSync/Notices.php:432
msgid ""
"That's wasted work. Switching to <em>\"Only sync variations edited in the "
"editor\"</em> would make saves like this much faster — WPML will only sync "
"the variations you actually changed and tell you what was skipped."
msgstr "Ez felesleges munka. Ha átváltasz a <em>„Csak a szerkesztőben módosított variációk szinkronizálása”</em> beállításra, az ilyen mentések sokkal gyorsabbak lesznek — a WPML csak az általad ténylegesen módosított variációkat szinkronizálja, és jelzi, mi maradt ki."

#. translators: %s: link to the WCML Settings page
#: classes/EditorScopedSync/Notices.php:439
#, php-format
msgid "You can switch on the %s."
msgstr "A(z) %s oldalon válthatsz át erre."

#. translators: Link text that permanently hides the notice about variation
#. syncing. Verb phrase, imperative.
#: classes/EditorScopedSync/Notices.php:452
msgid "Don't show this again on this site"
msgstr "Ne jelenjen meg újra ezen a webhelyen"

#. translators: Heading of the section on the plugin's Settings page that
#. controls how variations are synced.
#: classes/EditorScopedSync/Settings.php:81
msgid "Variation translation sync on product save"
msgstr "Variációfordítások szinkronizálása termékmentéskor"

#. translators: Tooltip of the help icon next to the variation-sync heading on
#. the Settings page. "Translation Dashboard" and "Translate Everything
#. Automatically" are WPML screen names.
#: classes/EditorScopedSync/Settings.php:82
msgid ""
"Choose how WPML updates variation translations when you save a variable "
"product. Affects saves in the WooCommerce product editor only — Translation "
"Dashboard and Translate Everything Automatically always run a complete sync."
msgstr "Válaszd ki, hogyan frissítse a WPML a változatok fordításait egy változó termék mentésekor. Ez csak a WooCommerce termékszerkesztőjében végzett mentésekre vonatkozik — a Fordítási vezérlőpult és a Minden automatikus fordítása mindig teljes szinkronizálást végez."

#. translators: First line under the variation-sync heading on the Settings
#. page.
#: classes/EditorScopedSync/Settings.php:87
msgid ""
"Choose how WPML updates variation translations when you save a variable "
"product."
msgstr "Válaszd ki, hogyan frissítse a WPML a variációfordításokat változó termék mentésekor."

#. translators: Second line under the variation-sync heading on the Settings
#. page. Keep the bold tags around the WPML screen names.
#: classes/EditorScopedSync/Settings.php:90
msgid ""
"Affects saves in the WooCommerce product editor only. <b>Translation "
"Dashboard</b> and <b>Translate Everything</b> Automatically always run a "
"complete sync."
msgstr "Csak a WooCommerce termékszerkesztőjében végzett mentésekre vonatkozik. A <b>Fordítási vezérlőpult</b> és a <b>Minden</b> automatikus fordítása mindig teljes szinkronizálást végez."

#. translators: Label of the first radio button of the variation-sync setting.
#. Verb phrase, imperative.
#: classes/EditorScopedSync/Settings.php:99
msgid "Always check all variations"
msgstr "Mindig az összes variáció ellenőrzése"

#. translators: Explanation under the first radio button of the variation-sync
#. setting.
#: classes/EditorScopedSync/Settings.php:101
msgid ""
"On every save, WPML checks every variation in every language and syncs "
"anything that's out of date."
msgstr "A WPML minden mentéskor minden nyelven ellenőrzi az összes variációt, és szinkronizálja az elavultakat."

#. translators: Label of the second radio button of the variation-sync
#. setting. Verb phrase, imperative; "the editor" is the WooCommerce product
#. editor.
#: classes/EditorScopedSync/Settings.php:111
msgid "Only sync variations edited in the editor"
msgstr "Csak a szerkesztőben módosított variációk szinkronizálása"

#. translators: Explanation under the second radio button of the variation-
#. sync setting.
#: classes/EditorScopedSync/Settings.php:113
msgid ""
"WPML syncs only the variations changed in this save. After each save, WPML "
"shows what was synced and offers a one-click full sync."
msgstr "A WPML csak az ebben a mentésben módosított variációkat szinkronizálja. Minden mentés után megmutatja, mit szinkronizált, és felajánlja a teljes szinkronizálást egyetlen kattintással."

#. translators: %1$s and %2$s are opening and closing HTML link tags
#: classes/Email/Settings/TranslationControls.php:148
#, php-format
msgid ""
"To translate custom WooCommerce email notifications, go to the "
"%1$sTranslation Dashboard%2$s."
msgstr "Egyéni WooCommerce e-mail értesítések fordításához lépj a %1$sFordítási vezérlőpultra%2$s."

#. translators: %d is the number of membership plan translations that were
#. merged.
#: classes/Entities/OneRecord/Migration/TranslatedPlans.php:431
#, php-format
msgid ""
"WPML merged %d translated membership plan into its original; the translation"
" is now a String Package translation."
msgid_plural ""
"WPML merged %d translated membership plans into their originals; the "
"translations are now String Package translations."
msgstr[0] "A WPML %d lefordított tagsági csomagot egyesített az eredetivel; a fordítás mostantól String Package-fordítás."
msgstr[1] "A WPML %d lefordított tagsági csomagot egyesített az eredetiekkel; a fordítások mostantól String Package-fordítások."

