#: views/part-settings-files-tree-row.php:23
msgid "Loading..."
msgstr "Betöltés..."

#: classes/Admin/AdminBar.php:162 views/part-upsell.php:74
msgid "Upgrade your plan now for more!"
msgstr "Frissítsd most az előfizetési csomagodat további lehetőségekért!"

#: classes/Admin/AdminBar.php:163 views/part-upsell.php:75
msgid "From $5.99/month only, keep going with image optimization!"
msgstr "Már havi $5.99-tól folytathatod a képoptimalizálást!"

#: classes/Admin/AdminBar.php:164
msgid "Upgrade My Plan"
msgstr "Előfizetésem frissítése"

#: classes/Admin/AdminBar.php:167
