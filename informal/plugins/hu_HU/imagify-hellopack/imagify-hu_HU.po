#: views/part-bulk-optimization-header.php:13
msgid "Bulk Optimization"
msgstr "Tömeges optimalizálás"

#: classes/Admin/AdminBar.php:95 classes/Admin/AdminSubscriber.php:55
msgid "Documentation"
msgstr "Dokumentáció"

#. translators: %s is WordPress.org.
#: classes/Admin/AdminBar.php:109
#, php-format
msgid "Rate Imagify on %s"
msgstr "Értékeld az Imagify-t a %s oldalon"

