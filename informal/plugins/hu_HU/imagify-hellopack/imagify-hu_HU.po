#. Plugin Name of the plugin
#: imagify-hellopack.php
msgid "Imagify (HelloPack)"
msgstr "Imagify (HelloPack)"

#. Plugin URI of the plugin
#. translators: Plugin URI of the plugin/theme
#: imagify-hellopack.php inc/functions/common.php:261
msgid "https://wordpress.org/plugins/imagify/"
msgstr "https://wordpress.org/plugins/imagify/"

#. Description of the plugin
#: imagify-hellopack.php
msgid ""
"Dramatically reduce image file sizes without losing quality, make your "
"website load faster, boost your SEO and save money on your bandwidth using "
"Imagify, the new most advanced image optimization tool."
msgstr "Csökkentsd drámaian a képfájlok méretét minőségromlás nélkül, gyorsítsd fel honlapod betöltését, növeld SEO-teljesítményedet, és takaríts meg sávszélesség-költséget az Imagify segítségével, az új, legfejlettebb képoptimalizáló eszközzel."

#. Author of the plugin
#: imagify-hellopack.php
msgid "HelloWP"
msgstr "HelloWP"

#. Author URI of the plugin
#: imagify-hellopack.php
msgid "https://hellowp.io"
msgstr "https://hellowp.io"

#: classes/Abilities/AbstractAbility.php:154
msgid ""
"Your Imagify API key is invalid or missing. Update it in the Imagify "
"settings before retrying."
msgstr "Az Imagify API-kulcsod hibás vagy hiányzik. Újrapróbálkozás előtt frissítsd az Imagify beállításaiban."

#: classes/Abilities/AbstractAbility.php:168
msgid ""
"Your Imagify quota is exhausted. Wait for the next reset date or upgrade "
"your plan to continue."
msgstr "Kimerítetted az Imagify-keretedet. Várd meg a keret következő alaphelyzetbe állításának dátumát, vagy válts magasabb csomagra a folytatáshoz."

#. translators: 1: number of units about to be processed, 2: total number of
#. units, 3: unit label
#: classes/Abilities/AbstractAbility.php:217
#, php-format
msgid ""
"This action will process %1$d of %2$d %3$s. Add \"confirm\": true to the "
"same call to proceed."
msgstr "Ez a művelet a teljes mennyiségből %1$d elemet dolgoz fel (%2$d %3$s). A folytatáshoz add hozzá ezt ugyanahhoz a híváshoz: „confirm”: true."

#. translators: 1: number of units about to be processed, 2: unit label
#: classes/Abilities/AbstractAbility.php:224
#, php-format
msgid ""
"This action will process %1$d %2$s. Add \"confirm\": true to the same call "
"to proceed."
msgstr "Ez a művelet %1$d %2$s elemet dolgoz fel. A folytatáshoz add hozzá ezt ugyanahhoz a híváshoz: „confirm”: true."

#. translators: 1: number of units about to be consumed, 2: total number of
#. units, 3: unit label
#: classes/Abilities/AbstractAbility.php:232
#, php-format
msgid ""
"This action will consume Imagify quota: %1$d of %2$d %3$s. Add \"confirm\": "
"true to the same call to proceed."
msgstr "Ez a művelet az Imagify-keretből %1$d egységet használ fel; a teljes keret %2$d %3$s. A folytatáshoz add hozzá ezt ugyanahhoz a híváshoz: „confirm”: true."

#. translators: 1: number of units about to be consumed, 2: unit label
#: classes/Abilities/AbstractAbility.php:239
#, php-format
msgid ""
"This action will consume Imagify quota: %1$d %2$s. Add \"confirm\": true to "
"the same call to proceed."
msgstr "Ez a művelet %1$d %2$s egységet használ fel az Imagify-keretedből. A folytatáshoz add hozzá ezt ugyanahhoz a híváshoz: „confirm”: true."

#: classes/Abilities/BulkOptimize.php:70
msgid "Bulk optimize"
msgstr "Tömeges optimalizálás"

#: classes/Abilities/BulkOptimize.php:71
msgid ""
"Schedule a bulk image optimization run for the WordPress media library or "
"custom folders."
msgstr "Tömeges képtömörítési folyamatot ütemez a WordPress médiatárában vagy egyéni mappákban."

#: classes/Abilities/BulkOptimize.php:78
msgid ""
"Optimization context: \"wp\" for the WordPress media library or \"custom-"
"folders\" for custom folder sources."
msgstr "Optimalizálási környezet: „wp” a WordPress médiatárához vagy „custom-folders” az egyéni mappákhoz."

#: classes/Abilities/BulkOptimize.php:83
msgid ""
"Optimization level: 0 (normal), 1 (aggressive), or 2 (ultra). Defaults to "
"the global Imagify setting."
msgstr "Optimalizálási szint: 0 (normál), 1 (agresszív) vagy 2 (ultra). Alapértelmezés szerint az Imagify globális beállítását használja."

#: classes/Abilities/BulkOptimize.php:89
#: classes/Abilities/GenerateMissingNextgen.php:94
#: classes/Abilities/OptimizeMedia.php:74
msgid ""
"Set to true to execute after reviewing the credit-consumption preview "
"returned by a prior call without this flag."
msgstr "Állítsd true értékre, ha az előző, ezt a jelzőt nem tartalmazó hívásban visszakapott keretfelhasználási előnézet áttekintése után szeretnéd végrehajtani."

#: classes/Abilities/BulkOptimize.php:100
msgid ""
"Result status: \"scheduled\", \"error\", \"confirmation_required\", "
"\"insufficient_quota\", or \"invalid_api_key\"."
msgstr "Az eredmény állapota: „scheduled”, „error”, „confirmation_required”, „insufficient_quota” vagy „invalid_api_key”."

#: classes/Abilities/BulkOptimize.php:105
msgid "The requested optimization context, echoed back."
msgstr "A visszaadott, kért optimalizálási környezet."

#: classes/Abilities/BulkOptimize.php:109
#: classes/Abilities/OptimizeMedia.php:101
#: classes/Abilities/RestoreMedia.php:58
msgid "Human-readable error message on failure, or null on success."
msgstr "Közérthető hibaüzenet sikertelenség esetén, siker esetén pedig null."

#: classes/Abilities/BulkOptimize.php:165
msgid "unoptimized images in custom folders"
msgstr "optimalizálatlan képek az egyéni mappákban"

#: classes/Abilities/BulkOptimize.php:169
msgid "unoptimized images in the WordPress media library"
msgstr "optimalizálatlan képek a WordPress médiatárában"

#: classes/Abilities/GenerateMissingNextgen.php:86
#: views/part-settings-webp.php:195
msgid "Generate missing next-gen versions"
msgstr "Hiányzó új generációs verziók létrehozása"

#: classes/Abilities/GenerateMissingNextgen.php:87
msgid ""
"Queues generation of missing next-gen (WebP/AVIF) versions for all optimized"
" media. Runs asynchronously via Action Scheduler."
msgstr "Sorba állítja a hiányzó új generációs (WebP/AVIF) verziók létrehozását az összes optimalizált médiatartalomhoz. Az Action Scheduler segítségével aszinkron módon fut."

#: classes/Abilities/GenerateMissingNextgen.php:166
msgid "optimized images missing a next-gen version"
msgstr "új generációs verzióval nem rendelkező optimalizált képek"

#: classes/Abilities/GenerateMissingNextgen.php:243
msgid "Imagify account is over quota or the API key is invalid."
msgstr "Az Imagify-fiók kerete kimerült, vagy az API-kulcs hibás."

#: classes/Abilities/GenerateMissingNextgen.php:245
msgid "No backup available; next-gen versions cannot be generated."
msgstr "Nem áll rendelkezésre biztonsági másolat; nem hozhatók létre új generációs verziók."

#: classes/Abilities/GetAccount.php:50
msgid "Get Imagify account status"
msgstr "Imagify-fiók állapotának lekérése"

#: classes/Abilities/GetAccount.php:51
msgid "Returns account quota, plan details, and API key validity."
msgstr "Visszaadja a fiók keretét, a csomag részleteit és az API-kulcs érvényességét."

#: classes/Abilities/GetMediaStatus.php:54
msgid "Get Media Status"
msgstr "Médiatartalom állapotának lekérése"

#: classes/Abilities/GetMediaStatus.php:55
msgid ""
"Retrieve the optimization status and metrics for a WordPress media library "
"attachment."
msgstr "Lekéri egy WordPress-médiatári csatolmány optimalizálási állapotát és mutatóit."

#: classes/Abilities/GetMediaStatus.php:62
msgid ""
"The WordPress attachment ID. Provide media_filename or media_url instead "
"when the ID is unknown."
msgstr "A WordPress-csatolmány ID-je. Ha az ID ismeretlen, helyette add meg a media_filename vagy a media_url értékét."

#: classes/Abilities/GetMediaStatus.php:71
msgid "Optimization status: \"success\", \"error\", or \"unoptimized\"."
msgstr "Optimalizálási állapot: „success”, „error” vagy „unoptimized”."

#: classes/Abilities/GetMediaStatus.php:76
msgid "0 = lossless, 1 = aggressive, 2 = ultra. Null when not optimized."
msgstr "0 = veszteségmentes, 1 = agresszív, 2 = ultra. Ha nincs optimalizálva, null."

#: classes/Abilities/GetMediaStatus.php:80
msgid "File size in bytes before optimization."
msgstr "A fájl optimalizálás előtti mérete bájtban."

#: classes/Abilities/GetMediaStatus.php:84
msgid "File size in bytes after optimization."
msgstr "A fájl optimalizálás utáni mérete bájtban."

#: classes/Abilities/GetMediaStatus.php:88
msgid "True when a WebP version of the full-size image has been generated."
msgstr "Igaz, ha létrejött a teljes méretű képből egy WebP-verzió."

#: classes/Abilities/GetMediaStatus.php:92
msgid "True when an AVIF version of the full-size image has been generated."
msgstr "Igaz, ha létrejött a teljes méretű képből egy AVIF-verzió."

#: classes/Abilities/GetMediaStatus.php:96
msgid "Human-readable error message when status is \"error\". Null otherwise."
msgstr "Ember által is érthető hibaüzenet, ha az állapot „error”. Egyébként null."

#: classes/Abilities/GetNextgenCoverage.php:69
msgid "Get next-gen coverage"
msgstr "Új generációs verziók lefedettségének lekérése"

#: classes/Abilities/GetNextgenCoverage.php:70
msgid ""
"Returns the number of optimized images missing a next-gen version and the "
"configured next-gen format."
msgstr "Visszaadja az új generációs verzióval nem rendelkező optimalizált képek darabszámát és a beállított új generációs formátumot."

#: classes/Abilities/GetSettings.php:50
msgid "Get Imagify settings"
msgstr "Imagify-beállítások lekérése"

#: classes/Abilities/GetSettings.php:51
msgid "Returns all Imagify configuration options and their current values."
msgstr "Visszaadja az összes Imagify-konfigurációs opciót és azok aktuális értékét."

#: classes/Abilities/GetStats.php:44
msgid "Get Imagify optimization stats"
msgstr "Imagify optimalizálási statisztikáinak lekérése"

#: classes/Abilities/GetStats.php:45
msgid "Returns optimization statistics for WP media and custom folders."
msgstr "Visszaadja a WP-médiatár és az egyéni mappák optimalizálási statisztikáit."

#: classes/Abilities/MediaResolver.php:49
msgid ""
"The media file name, for example \"hero-banner.jpg\". Use instead of "
"media_id when only the file name is known."
msgstr "A médiafájl neve, például „hero-banner.jpg”. Akkor használd a media_id helyett, ha csak a fájlnév ismert."

#: classes/Abilities/MediaResolver.php:53
msgid ""
"The absolute URL of the media. Use instead of media_id when only the URL is "
"known."
msgstr "A média abszolút URL-je. Akkor használd a media_id helyett, ha csak az URL ismert."

#: classes/Abilities/MediaResolver.php:82
msgid ""
"Provide one of media_id, media_url, or media_filename to identify the media."
msgstr "Add meg a media_id, a media_url vagy a media_filename egyikét a média azonosításához."

#. translators: %s: media URL provided by the caller.
#: classes/Abilities/MediaResolver.php:120
#, php-format
msgid "No media in the library matches the URL \"%s\"."
msgstr "A médiatárban nincs olyan média, amelynek URL-je „%s”."

#: classes/Abilities/MediaResolver.php:192
msgid "The media_filename provided is not a valid file name."
msgstr "A megadott media_filename nem érvényes fájlnév."

#. translators: %s: media file name provided by the caller.
#: classes/Abilities/MediaResolver.php:235
#, php-format
msgid "No media in the library is named \"%s\"."
msgstr "A médiatárban nincs „%s” nevű média."

#. translators: 1: media file name provided by the caller, 2: number of
#. attachments listed.
#: classes/Abilities/MediaResolver.php:246
#, php-format
msgid ""
"More than %2$d media are named \"%1$s\". Retry with media_id, or with the "
"full path such as \"2026/08/%1$s\"."
msgstr "Több mint %2$d média neve „%1$s”. Próbáld újra a media_id megadásával, vagy a teljes elérési úttal, például így: „2026/08/%1$s”."

#. translators: 1: media file name provided by the caller, 2: comma-separated
#. list of attachment IDs.
#: classes/Abilities/MediaResolver.php:258
#, php-format
msgid ""
"Several media are named \"%1$s\" (IDs: %2$s). Retry with media_id set to the"
" one you want."
msgstr "Több média neve „%1$s” (ID-k: %2$s). Próbáld újra a kívánt media_id megadásával."

#: classes/Abilities/OptimizeMedia.php:53
msgid ""
"The WordPress attachment ID to optimize. Provide media_filename or media_url"
" instead when the ID is unknown."
msgstr "Az optimalizálandó WordPress-csatolmány ID-je. Ha nem tudod az ID-t, add meg inkább a media_filename vagy a media_url értékét."

#: classes/Abilities/OptimizeMedia.php:60
msgid "Optimize media"
msgstr "Média optimalizálása"

#: classes/Abilities/OptimizeMedia.php:61
msgid "Optimizes a specific media on-demand using Imagify."
msgstr "Egy adott média igény szerinti optimalizálása az Imagify segítségével."

#: classes/Abilities/OptimizeMedia.php:68
msgid ""
"Optimization level: 0 (normal), 1 (aggressive), or 2 (ultra). If omitted, "
"uses the global setting."
msgstr "Optimalizálási szint: 0 (normál), 1 (agresszív) vagy 2 (ultra). Ha nincs megadva, a globális beállítást használja."

#: classes/Abilities/OptimizeMedia.php:84
msgid ""
"Result status: \"success\", \"error\", \"confirmation_required\", "
"\"insufficient_quota\", or \"invalid_api_key\"."
msgstr "Az eredmény állapota: „success”, „error”, „confirmation_required”, „insufficient_quota” vagy „invalid_api_key”."

#: classes/Abilities/OptimizeMedia.php:89
msgid "Original file size in bytes before optimization, or null on error."
msgstr "Az eredeti fájl mérete bájtban az optimalizálás előtt, hiba esetén null."

#: classes/Abilities/OptimizeMedia.php:93
msgid ""
"Optimized file size in bytes after optimization, or null on error or if not "
"yet available."
msgstr "Az optimalizált fájl mérete bájtban az optimalizálás után, hiba esetén vagy ha még nem érhető el, null."

#: classes/Abilities/OptimizeMedia.php:97
msgid "Percentage savings, or null on error."
msgstr "A megtakarítás százalékos aránya, hiba esetén null."

#: classes/Abilities/RestoreMedia.php:32
msgid "Restore media"
msgstr "Média visszaállítása"

#: classes/Abilities/RestoreMedia.php:33
msgid ""
"Restores an optimized media to its original state using the stored backup "
"file."
msgstr "Visszaállítja az optimalizált médiafájlt az eredeti állapotába a tárolt biztonságimásolat-fájl segítségével."

#: classes/Abilities/RestoreMedia.php:40
msgid ""
"The WordPress attachment ID to restore. Provide media_filename or media_url "
"instead when the ID is unknown."
msgstr "A visszaállítandó WordPress-csatolmány ID-je. Ha nem tudod az ID-t, add meg inkább a media_filename vagy a media_url értékét."

#: classes/Abilities/RestoreMedia.php:49
msgid "Result status: \"success\" or \"error\"."
msgstr "Az eredmény állapota: „success” vagy „error”."

#: classes/Abilities/RestoreMedia.php:54
msgid "Restored original file size in bytes, or null on error."
msgstr "A visszaállított eredeti fájl mérete bájtban, hiba esetén null."

#: classes/Abilities/UpdateSettings.php:50
msgid "Update Imagify settings"
msgstr "Imagify beállításainak frissítése"

#: classes/Abilities/UpdateSettings.php:51
msgid ""
"Updates one or more Imagify configuration options. Only supplied keys are "
"changed; others remain unchanged."
msgstr "Egy vagy több Imagify-konfigurációs opciót frissít. Csak a megadott kulcsok változnak; a többi változatlan marad."

#: classes/Abilities/UpdateSettings.php:69
msgid ""
"Imagify API key. Cannot be updated when IMAGIFY_API_KEY constant is defined."
msgstr "Imagify API-kulcs. Nem frissíthető, ha az IMAGIFY_API_KEY konstans definiálva van."

#: classes/Abilities/UpdateSettings.php:75
msgid "Optimization aggressiveness: 0 = normal, 1 = aggressive, 2 = ultra."
msgstr "Optimalizálás erőssége: 0 = normál, 1 = agresszív, 2 = ultra."

#: classes/Abilities/UpdateSettings.php:80
msgid "Enable lossless compression (0 = off, 1 = on)."
msgstr "Veszteségmentes tömörítés bekapcsolása (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:85
msgid "Automatically optimize images on upload (0 = off, 1 = on)."
msgstr "Képek automatikus optimalizálása feltöltéskor (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:90
msgid "Keep a backup of original images (0 = off, 1 = on)."
msgstr "Biztonsági másolat készítése az eredeti képekről (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:95
msgid "Resize images wider than resize_larger_w (0 = off, 1 = on)."
msgstr "A resize_larger_w értéknél szélesebb képek átméretezése (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:99
msgid "Maximum image width in pixels when resize_larger is enabled."
msgstr "A képek maximális szélessége pixelben, ha a resize_larger be van kapcsolva."

#: classes/Abilities/UpdateSettings.php:104
msgid "Serve next-gen images to supported browsers (0 = off, 1 = on)."
msgstr "Következő generációs képek megjelenítése az azokat támogató böngészőkben (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:109
msgid "Delivery method for next-gen images: picture element or URL rewrite."
msgstr "A következő generációs képek megjelenítési módja: picture elem vagy URL-átírás."

#: classes/Abilities/UpdateSettings.php:114
msgid "Serve WebP images to supported browsers (0 = off, 1 = on)."
msgstr "WebP-képek megjelenítése az azokat támogató böngészőkben (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:119
msgid "Delivery method for WebP images: picture element or URL rewrite."
msgstr "A WebP-képek megjelenítési módja: picture elem vagy URL-átírás."

#: classes/Abilities/UpdateSettings.php:123
msgid "CDN base URL for serving optimized images."
msgstr "Optimalizált képek kiszolgálására szolgáló CDN-alap-URL."

#: classes/Abilities/UpdateSettings.php:127
msgid "Image sizes excluded from optimization, keyed by size slug."
msgstr "Az optimalizálásból kihagyott képméretek, méret-slug szerint megadva."

#: classes/Abilities/UpdateSettings.php:132
msgid "Show Imagify entry in the WordPress admin bar (0 = off, 1 = on)."
msgstr "Imagify-menüpont megjelenítése a WordPress adminisztrációs sávjában (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:137
msgid "Show partner links in the Imagify admin area (0 = off, 1 = on)."
msgstr "Partnerhivatkozások megjelenítése az Imagify adminisztrációs felületén (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:142
msgid "Convert images to AVIF format (0 = off, 1 = on)."
msgstr "Képek konvertálása AVIF-formátumba (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:147
msgid "Convert images to WebP format (0 = off, 1 = on)."
msgstr "Képek konvertálása WebP-formátumba (0 = ki, 1 = be)."

#: classes/Abilities/UpdateSettings.php:152
msgid "Output format for optimized images."
msgstr "Az optimalizált képek kimeneti formátuma."

#: classes/Abilities/UpdateSettings.php:163
msgid "Keys whose values changed after the update."
msgstr "Azok a kulcsok, amelyek értéke megváltozott a frissítés után."

#: classes/Abilities/UpdateSettings.php:167
msgid "Full post-update settings, excluding api_key and version."
msgstr "A frissítés utáni teljes beállítások, az api_key és a version kivételével."

#. translators: 1: setting key name, 2: list of allowed values.
#: classes/Abilities/UpdateSettings.php:205
#: classes/Abilities/UpdateSettings.php:219
#: classes/Abilities/UpdateSettings.php:234
#, php-format
msgid "Invalid value for \"%1$s\". Expected one of: %2$s."
msgstr "Érvénytelen érték ehhez: „%1$s”. A megengedett értékek: %2$s."

#. translators: %s: the unknown setting key name.
#: classes/Abilities/UpdateSettings.php:294
#: classes/Abilities/UpdateSettings.php:305
#, php-format
msgid "\"%s\" is not a valid Imagify setting key."
msgstr "A(z) „%s” nem érvényes Imagify-beállításkulcs."

#. translators: IMAGIFY_API_KEY is a PHP constant name, do not translate it.
#: classes/Abilities/UpdateSettings.php:315
msgid "api_key cannot be updated when IMAGIFY_API_KEY constant is defined."
msgstr "Az api_key nem frissíthető, ha az IMAGIFY_API_KEY konstans definiálva van."

#: classes/Admin/AdminBar.php:84 classes/Admin/AdminSubscriber.php:74
#: inc/3rd-party/nextgen-gallery/inc/admin/menu.php:17
#: inc/3rd-party/nextgen-gallery/inc/admin/menu.php:18
