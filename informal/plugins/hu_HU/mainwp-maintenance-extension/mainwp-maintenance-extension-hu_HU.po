msgid "Remove drafts, trash posts, and older revisions to keep content lean."
msgstr "Távolítsd el a piszkozatokat, a lomtárban lévő bejegyzéseket és a régebbi változatokat, hogy a tartalom ne legyen túlzsúfolt."

#: class/manage-maintenance.class.php:71
msgid "Comment Cleanup"
msgstr "Hozzászólások tisztítása"

#: class/manage-maintenance.class.php:72
msgid "Clear spam, pending, and trash comments to keep moderation tidy."
msgstr "Töröld a spamként megjelölt, függőben lévő és a lomtárban lévő hozzászólásokat, hogy rendezett maradjon a moderálás."

#: class/manage-maintenance.class.php:76
msgid "Taxonomy Cleanup"
msgstr "Osztályozás (taxonomy) tisztítása"

#: class/manage-maintenance.class.php:77
msgid ""
"Remove empty tags and categories to declutter filters. Posts will not be "
"affected."
msgstr "Távolítsd el az üres címkéket és kategóriákat a szűrők áttekinthetőbbé tételéhez. Ez nem érinti a bejegyzéseket."

#: class/manage-maintenance.class.php:81
msgid "Database Optimization"
msgstr "Adatbázis-optimalizálás"

#: class/manage-maintenance.class.php:82
msgid ""
"Optimize tables on selected sites. Best used during low-traffic periods."
msgstr "Optimalizáld a táblákat a kiválasztott webhelyeken. Ezt érdemes alacsony forgalmú időszakban elvégezni."

#: class/manage-maintenance.class.php:91
msgid ""
"Choose the cleanup tasks for selected sites. Start with content and "
"comments; database optimization can be more resource-intensive."
msgstr "Válaszd ki a kiválasztott webhelyeken végrehajtandó tisztítási feladatokat. Kezdd a tartalommal és a hozzászólásokkal; az adatbázis optimalizálása több erőforrást igényelhet."

#: class/manage-maintenance.class.php:121
