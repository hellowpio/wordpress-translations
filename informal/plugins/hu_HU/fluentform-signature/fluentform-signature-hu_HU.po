#. Plugin Name of the plugin
#: fluentform-signature.php
msgid "Fluent Forms Signature Addon"
msgstr "Fluent Forms aláírás-kiegészítő"

#. Plugin URI of the plugin
#: fluentform-signature.php
msgid "https://wpmanageninja.com/downloads/signature-add-on-for-wp-fluentform"
msgstr "https://wpmanageninja.com/downloads/signature-add-on-for-wp-fluentform"

#. Description of the plugin
#: fluentform-signature.php
msgid ""
"The signature field for Fluent Forms, the most advanced drag and drop form "
"builder plugin for WordPress."
msgstr "A Fluent Forms aláírásmezője, a WordPress legfejlettebb fogd és vidd űrlapkészítő bővítménye."

#. Author of the plugin
#: fluentform-signature.php
msgid "WPFluentForm"
msgstr "WPFluentForm"

#. Author URI of the plugin
#: fluentform-signature.php
msgid "https://fluentforms.com"
msgstr "https://fluentforms.com"

#: src/Component.php:24 src/Component.php:33
msgid "Signature"
msgstr "Aláírás"

#: src/Component.php:32
msgid "Sign Here"
msgstr "Írd alá itt"

#: src/Component.php:37
msgid "This field is required"
msgstr "Ez a mező kötelező"

#: src/Component.php:100
msgid "Pad Background Color"
msgstr "Aláírófelület háttérszíne"

#: src/Component.php:101
msgid "The Background color of the signature pad"
msgstr "Az aláírómező háttérszíne"

#: src/Component.php:105
msgid "Border Color"
msgstr "Szegélyszín"

#: src/Component.php:106
msgid "The Border color of the signature pad"
msgstr "Az aláírómező szegélyének színe"

#: src/Component.php:110
msgid "Pen Color"
msgstr "Toll színe"

#: src/Component.php:111
msgid "The Pen color of the signature pad"
msgstr "Az aláírómező tollának színe"

#: src/Component.php:116
msgid "Pen Size"
msgstr "Tollméret"

#: src/Component.php:117
msgid "Size of your Pen"
msgstr "A tollad mérete"

#: src/Component.php:121
msgid "Sign Instruction"
msgstr "Aláírási utasítás"

#: src/Component.php:122
msgid "Write Label that will show under the signature pad"
msgstr "Írd be az aláírómező alatt megjelenő címkét"

#: src/Component.php:127
msgid "Pad Height"
msgstr "Mezőmagasság"

#: src/Component.php:128
msgid "Height of the signature pad"
msgstr "Az aláírómező magassága"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:69
#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:104
#, php-format
msgid "The %s license needs to be activated. %sActivate Now%s"
msgstr "A %s licencet aktiválni kell. %sAktiválás most%s"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:170
msgid "License Key"
msgstr "Licenckulcs"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:171
#, php-format
msgid "Thank you for purchasing %s!  Please enter your license key below."
msgstr "Köszönjük a(z) %s megvásárlását!  Add meg alább a licenckulcsodat."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:214
#, php-format
msgid "Any questions or problems with your license? %sContact us%s!"
msgstr "Kérdéseid vagy problémáid vannak a licenccel? %sLépj kapcsolatba velünk%s!"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:231
msgid "Sorry! You do not have permission to activate this license."
msgstr "Sajnáljuk! Nincs jogosultságod ennek a licencnek az aktiválásához."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:299
msgid ""
"Error when contacting with license server. Please check that your server "
"have curl installed"
msgstr "Hiba történt a licencszerverrel való kapcsolatfelvételkor. Ellenőrizd, hogy telepítve van-e a curl a szervereden"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:358
msgid "Sorry! You do not have permission to deactivate this license."
msgstr "Sajnáljuk! Nincs jogosultságod ennek a licencnek a kikapcsolásához."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:393
msgid ""
"There was an error deactivating the license, please try again or contact "
"support."
msgstr "Hiba történt a licenc kikapcsolásakor, próbáld meg újra, vagy lépj kapcsolatba a támogatással."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:411
msgid "License deactivated"
msgstr "Licenc deaktiválva"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:420
msgid "Unable to deactivate license, please try again or contact support."
msgstr "A licencet nem sikerült kikapcsolni, próbáld meg újra, vagy lépj kapcsolatba a támogatással."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:502
msgid ""
"There was an error activating the license, please verify your license is "
"correct and try again or contact support."
msgstr "Hiba történt a licenc aktiválásakor. Ellenőrizd, hogy helyes-e a licenced, majd próbáld újra, vagy vedd fel a kapcsolatot a támogatással."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:506
#, php-format
msgid ""
"Your license has been expired at %s Please <a target=\"_blank\" "
"href=\"%s\">click here</a> to renew your license"
msgstr "A licenced %s dátummal lejárt. A megújításhoz <a target=\"_blank\" href=\"%s\">kattints ide</a>"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:508
#, php-format
msgid ""
"No Activation Site left: You have activated all the sites that your license "
"offer. Please go to wpmanageninja.com account and review your sites. You may"
" deactivate your unused sites from wpmanageninja account, or you can "
"purchase another license. <a target=\"_blank\" href=\"%s\">Click Here to "
"purchase another license</a>"
msgstr "Nincs több aktiválható webhely: a licenced által biztosított összes webhelyet aktiváltad. Lépj be a wpmanageninja.com-fiókodba, és tekintsd át a webhelyeidet. A nem használt webhelyeket kikapcsolhatod a wpmanageninja.com-fiókodban, vagy vásárolhatsz egy másik licencet. <a target=\"_blank\" href=\"%s\">Kattints ide egy másik licenc vásárlásához</a>"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:510
msgid ""
"The given license key is not valid. Please verify that your license is "
"correct. You may login to wpmanageninja.com account and get your valid "
"license key for your purchase."
msgstr "A megadott licenckulcs nem érvényes. Ellenőrizd, hogy helyes-e a licenced. Lépj be a wpmanageninja.com-fiókodba, és keresd meg a vásárláshoz tartozó érvényes licenckulcsot."

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:591
#, php-format
msgid ""
"<p>Your %s license has been <b>expired at %s</b>, Please <a "
"href=\"%s\"><b>Click Here to Renew Your License</b></a></p>"
msgstr "<p>A(z) %s licenced <b>%s dátummal lejárt</b>. A megújításhoz <a href=\"%s\"><b>kattints ide</b></a></p>"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:620
#, php-format
msgid "<p>Your license was expired at <b>%s</b></p>"
msgstr "<p>A licenced <b>%s dátummal lejárt</b></p>"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:621
#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:629
msgid "Click here to renew your license"
msgstr "Kattints ide a licenced megújításához"

#: src/libs/ff_plugin_updater/updater/FluentFormSignatureAddOnChecker.php:628
#, php-format
msgid "<p>Your license will be expired in %s days</p>"
msgstr "<p>A licenced %s nap múlva lejár</p>"
