msgstr "Nem sikerült megosztható linket létrehozni ehhez a fájlhoz: %s"

#: includes/class-gf-dropbox-api.php:206
msgid "Something went wrong trying to retrieve an access token from Dropbox."
msgstr "Hiba történt a hozzáférési token Dropboxból való lekérése közben."

