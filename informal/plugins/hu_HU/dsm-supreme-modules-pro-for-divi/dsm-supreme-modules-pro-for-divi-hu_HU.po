msgid "Appearance"
msgstr "Megjelenés"

#: divi-5/public/extensions.js:2
msgid "Primary Colour"
msgstr "Elsődleges szín"

#: divi-5/public/extensions.js:2
msgid "Main fill or stroke colour for the cursor."
msgstr "A kurzor fő kitöltésének vagy körvonalának színe."

#: divi-5/public/extensions.js:2
msgid "Secondary Colour"
msgstr "Másodlagos szín"

#: divi-5/public/extensions.js:2
msgid "Cursor Size"
msgstr "Kurzor mérete"

#: divi-5/public/extensions.js:2
msgid "Primary cursor diameter (inner dot or main circle)."
msgstr "Az elsődleges kurzor átmérője (belső pont vagy fő kör)."

#: divi-5/public/extensions.js:2
msgid "Trail Size"
msgstr "Nyomvonal mérete"

#: divi-5/public/extensions.js:2
msgid "Blend Mode"
msgstr "Keverési mód"

#: divi-5/public/extensions.js:2
msgid ""
"CSS mix-blend-mode applied to cursor layers. Try Difference or Exclusion on "
"light/dark backgrounds."
msgstr "A kurzorrétegekre alkalmazott CSS mix-blend-mode értéke. Világos vagy sötét háttéren próbáld ki a Difference vagy az Exclusion értéket."

#: divi-5/public/extensions.js:2 divi-5/public/modules.js:13
msgid "Animation Speed"
msgstr "Animáció sebessége"

#: divi-5/public/extensions.js:2
msgid "How quickly the cursor follows the pointer (higher = snappier)."
msgstr "Milyen gyorsan követi a kurzor a mutatót (a magasabb érték gyorsabb követést jelent)."

#: divi-5/public/extensions.js:2
msgid "Opacity"
msgstr "Átlátszatlanság"

#: divi-5/public/extensions.js:2
msgid "Cursor opacity (0–1)."
msgstr "A kurzor átlátszatlansága (0–1)."

