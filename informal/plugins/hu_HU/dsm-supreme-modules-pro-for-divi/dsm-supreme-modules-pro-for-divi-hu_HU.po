#, js-format
msgid "And %d more columns. Open Edit Table Data to see the full table."
msgstr "És még %d oszlop. A teljes táblázat megtekintéséhez nyisd meg a „Táblázatadatok szerkesztése” felületet."

#: divi-5/public/modules.js:23
msgid "Importing CSV…"
msgstr "CSV importálása…"

#. translators: %d: rows imported so far
#: divi-5/public/modules.js:25
#, js-format
msgid "Imported %d rows…"
msgstr "%d sor importálva…"

#. translators: %d: imported row count
#: divi-5/public/modules.js:26
#, js-format
msgid "Imported %d rows."
msgstr "%d sor importálva."

#: divi-5/public/modules.js:26 divi-5/public/modules.js:34
