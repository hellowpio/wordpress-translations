msgid "Product Image Placement"
msgstr "Termékkép elhelyezése"

#: divi-5/public/modules.js:13
msgid "Show the product photo above the review, or below the reviewer."
msgstr "Jelenítsd meg a termékképet a vélemény fölött vagy a véleményező neve alatt."

#: divi-5/public/modules.js:13
msgid "Top of card"
msgstr "A kártya tetején"

#: divi-5/public/modules.js:13
msgid "Bottom of card"
msgstr "A kártya alján"

