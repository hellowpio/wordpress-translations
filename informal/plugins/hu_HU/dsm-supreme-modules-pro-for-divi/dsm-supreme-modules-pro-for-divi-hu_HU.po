#: divi-5/public/modules.js:37
msgid "Apply Label"
msgstr "Az alkalmazás címkéje"

#: divi-5/public/modules.js:37
msgid "Text on the slider Apply button."
msgstr "A diavetítés alkalmazása gomb felirata."

#: divi-5/public/modules.js:37
msgid "Symbol before the price if WooCommerce is off."
msgstr "A WooCommerce kikapcsolt állapotában az ár elé kerülő szimbólum."

#: divi-5/public/modules.js:37
msgid "Symbol after the price if WooCommerce is off."
msgstr "A WooCommerce kikapcsolt állapotában az ár után kerülő szimbólum."

#: divi-5/public/modules.js:37
msgid "Quick Range Pills"
msgstr "Gyors árintervallum-gombok"

#: divi-5/public/modules.js:37
msgid "Show shortcut price buttons under the slider."
msgstr "Gyors árintervallum-gombok megjelenítése a diavetítés alatt."

#: divi-5/public/modules.js:37
msgid "Shortcut Count"
msgstr "Gyorsgombok száma"

#: divi-5/public/modules.js:37
msgid ""
"How many shortcut buttons to show. Each one covers an even slice of your "
"prices."
msgstr "A megjelenítendő gyorsgombok száma. Mindegyik az árak egyenlő részét fedi le."

#: divi-5/public/modules.js:37
msgid "Show Distribution"
msgstr "Eloszlás megjelenítése"

#: divi-5/public/modules.js:37
msgid "Show bars for how many products sit at each price."
msgstr "Oszlopok megjelenítése arról, hogy az egyes árkategóriákba hány termék tartozik."

#: divi-5/public/modules.js:37
msgid "Distribution Bars"
msgstr "Eloszlási oszlopok"

#: divi-5/public/modules.js:37
msgid "How many of those bars to show."
msgstr "A megjelenítendő oszlopok száma."

#: divi-5/public/modules.js:37
msgid "Rating UI"
msgstr "Értékelési felület"

#: divi-5/public/modules.js:37
msgid "How people pick a star rating."
msgstr "Hogyan választhatnak a látogatók csillagos értékelést."

#: divi-5/public/modules.js:37
msgid "Filters products by star rating."
msgstr "Csillagos értékelés alapján szűri a termékeket."

#: divi-5/public/modules.js:37
msgid "Filters products by in stock, out of stock, or on backorder."
msgstr "Készleten lévő, elfogyott vagy utánrendelhető termékek alapján szűr."

#: divi-5/public/modules.js:37
msgid "Option Gap"
msgstr "Opciók közötti távolság"

#: divi-5/public/modules.js:37
msgid "Wrap Options"
msgstr "Tördelési opciók"

#: divi-5/public/modules.js:37
msgid "Option Labels"
msgstr "Opciócímkék"

#: divi-5/public/modules.js:37
msgid "Label Text"
msgstr "Felirat szövege"

#: divi-5/public/modules.js:37
msgid "Color of the hint text in the date boxes."
msgstr "A dátummezők súgószövegének színe."

#: divi-5/public/modules.js:37
msgid "Color of the hint text in the price boxes."
msgstr "Az ármezők súgószövegének színe."

#: divi-5/public/modules.js:37
msgid "Color of the hint text in the search box."
msgstr "A keresőmező súgószövegének színe."

#: divi-5/public/modules.js:37
msgid "Border color when someone clicks this field."
msgstr "A mezőre kattintáskor megjelenő keret színe."

#: divi-5/public/modules.js:37
msgid "Size of the radio buttons."
msgstr "A rádiógombok mérete."

#: divi-5/public/modules.js:37
msgid "Size of the checkboxes."
msgstr "A jelölőnégyzetek mérete."

#: divi-5/public/modules.js:37
msgid "Color when a radio is not selected."
msgstr "A ki nem jelölt rádiógomb színe."

#: divi-5/public/modules.js:37
msgid "Color when a box is not checked."
msgstr "A be nem jelölt jelölőnégyzet színe."

#: divi-5/public/modules.js:37
msgid "Color when a radio is selected."
msgstr "A kijelölt rádiógomb színe."

#: divi-5/public/modules.js:37
msgid "Color when a box is checked."
msgstr "A bejelölt jelölőnégyzet színe."

#: divi-5/public/modules.js:37
msgid "Space between the rating choices."
msgstr "A választási lehetőségek közötti távolság az értékelésnél."

#: divi-5/public/modules.js:37
msgid "Space between the radio choices."
msgstr "A rádiógombos lehetőségek közötti távolság."

#: divi-5/public/modules.js:37
msgid "Space between the checkbox choices."
msgstr "A jelölőnégyzetes lehetőségek közötti távolság."

#: divi-5/public/modules.js:37
msgid "Let the rating choices wrap onto the next line."
msgstr "Az értékelési lehetőségek új sorba tördelésének engedélyezése."

#: divi-5/public/modules.js:37
msgid "Let the radio choices wrap onto the next line."
msgstr "A rádiógombos lehetőségek új sorba tördelésének engedélyezése."

#: divi-5/public/modules.js:37
msgid "Let the checkbox choices wrap onto the next line."
msgstr "A jelölőnégyzetes lehetőségek új sorba tördelésének engedélyezése."

#: divi-5/public/modules.js:37
msgid "Tooltip Offset"
msgstr "Eszköztipp eltolása"

#: divi-5/public/modules.js:37
msgid "How far the price sits above the handle."
msgstr "Milyen messze legyen az ár a csúszkagomb felett."

#: divi-5/public/modules.js:37
msgid ""
"Visual chrome for this placeable control (pill / icon / switch). Independent"
" of content mode."
msgstr "Ennek az elhelyezhető vezérlőelemnek a vizuális megjelenése (kapszula / ikon / kapcsoló). A tartalommódtól független."

#: divi-5/public/modules.js:37
msgid "Switch"
msgstr "Váltás"

#: divi-5/public/modules.js:37
msgid ""
"Default keeps the CSS sun/moon icons. Choose custom icons, text labels, "
"both, or images for light/dark pairs."
msgstr "Az alapértelmezett beállítás a CSS nap- és holdikonokat használja. Világos és sötét módhoz egyéni ikonokat, szöveges címkéket, mindkettőt vagy képeket választhatsz."

#: divi-5/public/modules.js:37
msgid ""
"Icon shown while the site is in light mode (click switches to dark). Leave "
"empty to use the default sun."
msgstr "Világos módban megjelenő ikon (kattintásra sötét módra vált). Hagyd üresen az alapértelmezett nap használatához."

#: divi-5/public/modules.js:37
msgid ""
"Icon shown while the site is in dark mode. Leave empty to use the default "
"moon."
msgstr "Sötét módban megjelenő ikon. Hagyd üresen az alapértelmezett hold használatához."

#: divi-5/public/modules.js:37
msgid "Text shown while the site is in light mode."
msgstr "Világos módban megjelenő szöveg."

#: divi-5/public/modules.js:37
msgid "Text shown while the site is in dark mode."
msgstr "Sötét módban megjelenő szöveg."

#: divi-5/public/modules.js:37
msgid "Image shown while the site is in light mode."
msgstr "Világos módban megjelenő kép."

#: divi-5/public/modules.js:37
msgid "Image shown while the site is in dark mode."
msgstr "Sötét módban megjelenő kép."

#: divi-5/public/modules.js:37
msgid "Horizontal alignment of the toggle within the module."
msgstr "A kapcsoló vízszintes illesztése a modulon belül."

#: divi-5/public/modules.js:37
msgid "Label Typography"
msgstr "Címke tipográfiája"

#: divi-5/public/modules.js:37
msgid "Switch Style"
msgstr "Kapcsoló stílusa"

#: divi-5/public/modules.js:37
msgid ""
"Toggle background while the site is in light mode. Used when floating design"
" sync is off."
msgstr "A kapcsoló háttere világos módban. Akkor használatos, ha a lebegő dizájn szinkronizálása ki van kapcsolva."

#: divi-5/public/modules.js:37
msgid "Toggle background while the site is in dark mode."
msgstr "A kapcsoló háttere sötét módban."

#: divi-5/public/modules.js:37
msgid ""
"Icon and label colour in light mode. Leave Label Font colour empty to "
"inherit this."
msgstr "Az ikon és a címke színe világos módban. Hagyd üresen a címke betűszínét, ha ezt szeretnéd örökölni."

#: divi-5/public/modules.js:37
msgid "Icon and label colour in dark mode."
msgstr "Az ikon és a címke színe sötét módban."

#: divi-5/public/modules.js:37
msgid "Colour of custom icons in light mode. Leave empty to use Foreground."
msgstr "Az egyéni ikonok színe világos módban. Hagyd üresen az előtér színének használatához."

#: divi-5/public/modules.js:37
msgid "Colour of custom icons in dark mode. Leave empty to use Foreground."
msgstr "Az egyéni ikonok színe sötét módban. Hagyd üresen az előtér színének használatához."

#: divi-5/public/modules.js:37
msgid "Focus outline and switch-style thumb in dark mode."
msgstr "A fókusz körvonala és a kapcsoló csúszkagombja sötét módban."

#: divi-5/public/modules.js:37
msgid "Track background for the Switch style."
msgstr "A kapcsoló stílusú vezérlő sínjének háttere."

#: divi-5/public/modules.js:37
msgid "Base width and height of the toggle control."
msgstr "A kapcsolóvezérlő alapméretei (szélesség és magasság)."
