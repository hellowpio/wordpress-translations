msgstr "Még nincsenek külső címzettek."

#: build/tools.js:5
msgid "Remove"
msgstr "Eltávolítás"

#: build/tools.js:5
msgid "Add a recipient"
msgstr "Címzett hozzáadása"

#: build/tools.js:5
msgid "Please enter a valid email address."
msgstr "Adj meg egy érvényes e-mail-címet."

#: build/tools.js:5
msgid "Add"
msgstr "Hozzáadás"

#: build/tools.js:5
msgid "Previously unsubscribed"
msgstr "Korábban leiratkozott"

#: build/tools.js:5
msgid ""
"These recipients clicked an unsubscribe link in a past report. They will not"
