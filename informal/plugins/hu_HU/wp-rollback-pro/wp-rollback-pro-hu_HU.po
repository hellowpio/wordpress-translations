#: build/tools.js:2 build/tools.js:6
msgid "Email Reports"
msgstr "E-mail-jelentések"

#: build/tools.js:2
msgid ""
"Email reports are not yet available on multisite installs. Track progress at"
" docs.wprollback.com/status-reports."
msgstr "Az e-mail-jelentések még nem érhetők el több webhelyes telepítéseknél. Kövesd a fejleményeket a docs.wprollback.com/status-reports oldalon."

#: build/tools.js:2
msgid ""
"Recurring email reports that show admins exactly how WP Rollback Pro is "
"protecting this site — rollbacks performed, archives stored, and premium "
"plugins covered."
msgstr "Rendszeres e-mail-jelentések, amelyek pontosan megmutatják az adminoknak, hogyan védi a WP Rollback Pro ezt a webhelyet — milyen visszaállítások történtek, milyen archívumokat tárol, és mely prémium bővítmények tartoznak a védelem alá."

#: build/tools.js:2
msgid ""
"Email reports require HTTPS because the unsubscribe link must be HTTPS-only "
"per RFC 8058. Configure HTTPS before enabling reports in production."
msgstr "Az e-mail-jelentésekhez HTTPS szükséges, mert az RFC 8058 előírása szerint a leiratkozási link csak HTTPS-en keresztül érhető el. A jelentések éles környezetben való bekapcsolása előtt állítsd be a HTTPS-t."

#: build/tools.js:2
msgid ""
"Local development site detected — reports will send over HTTP for testing. "
"Production sites must be served over HTTPS for unsubscribe links to comply "
"with RFC 8058."
msgstr "Helyi fejlesztői webhelyet észleltünk — teszteléshez a jelentéseket HTTP-n keresztül küldjük el. Az éles webhelyeknek HTTPS-en kell működniük ahhoz, hogy a leiratkozási linkek megfeleljenek az RFC 8058 előírásainak."

#: build/tools.js:2
msgid ""
"Your site’s admin email address is missing or invalid. Set a valid address "
"in Settings → General before enabling email reports."
msgstr "Hiányzik vagy hibás a webhelyed admin e-mail címe. Az e-mailes jelentések bekapcsolása előtt adj meg egy érvényes címet a beállítások → általános részen."

#: build/tools.js:2
msgid "Schedule"
msgstr "Ütemezés"

#: build/tools.js:2
msgid ""
"Choose how often a report is sent and confirm when the next one will "
"dispatch."
msgstr "Válaszd ki, milyen gyakran küldjön a rendszer jelentést, és erősítsd meg, mikor küldi el a következőt."

#: build/tools.js:2
msgid "Send email reports"
msgstr "E-mail-jelentések küldése"

#: build/tools.js:2
msgid ""
"When enabled, recipients receive an email summary on the cadence you choose "
"below."
msgstr "Bekapcsolás esetén a címzettek az alább kiválasztott gyakorisággal e-mailes összefoglalót kapnak."

#: build/tools.js:2
msgid "Frequency"
msgstr "Gyakoriság"

#: build/tools.js:2
msgid "Next scheduled report"
msgstr "Következő ütemezett jelentés"

#: build/tools.js:2
msgid "Not scheduled"
msgstr "Nincs időzítve"

#: build/tools.js:2
msgid "(after saving)"
msgstr "(mentés után)"

#: build/tools.js:2
msgid "Recipients"
msgstr "Címzettek"

#: build/tools.js:2
msgid ""
"Reports are sent individually to each recipient with a per-recipient one-"
"click unsubscribe link."
msgstr "A jelentéseket egyenként küldjük el minden címzettnek, és mindegyikben egy kattintással használható, személyre szabott leiratkozási link található."

#. translators: %d: total recipients
#: build/tools.js:3
#, js-format
msgid ""
"You have %d recipients on the list. Sending to many recipients may slow down"
" the cron run; the hard cap is 50."
msgstr "%d címzett van a listán. Ha sok címzettnek küldesz, az lelassíthatja a cron futását; a felső korlát 50."

#: build/tools.js:3
msgid "WordPress administrators"
msgstr "WordPress-adminisztrátorok"

#: build/tools.js:3
msgid ""
"You’ve customized the recipient list. New administrators added later will "
"not automatically receive reports unless added here."
msgstr "Testre szabtad a címzettek listáját. A később hozzáadott adminisztrátorok nem kapnak automatikusan jelentéseket, amíg fel nem veszed őket ide."

#: build/tools.js:3
msgid ""
"Currently sending to all current and future administrators. Un-check anyone "
"below to lock the list to specific users."
msgstr "Jelenleg az összes jelenlegi és jövőbeli adminisztrátornak küldünk. Ha csak bizonyos felhasználóknak szeretnél küldeni, vedd ki a jelölést az alábbi listában."

#: build/tools.js:3
msgid "(unsubscribed)"
msgstr "(leiratkozott)"

#. translators: %d: count of stale user IDs
