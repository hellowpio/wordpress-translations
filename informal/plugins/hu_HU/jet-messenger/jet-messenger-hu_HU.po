msgid "Rate limiter table is missing"
msgstr "Hiányzik a sebességkorlátozó tábla"

#: includes/admin/observability/diagnostics-service.php:256
msgid ""
"JetMessenger could not find the SQL rate limiter table for the current site."
" Rate limiting will fail open until it is repaired."
msgstr "A JetMessenger nem találta az aktuális webhelyhez tartozó SQL sebességkorlátozó táblát. A javításig hiba esetén a sebességkorlátozás nem blokkolja a kéréseket."

