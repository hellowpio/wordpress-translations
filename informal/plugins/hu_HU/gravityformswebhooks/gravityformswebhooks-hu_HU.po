#. Plugin Name of the plugin
msgid "Gravity Forms Webhooks Add-On"
msgstr "Gravity Forms Webhooks kiegészítő"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
msgid ""
"Integrates Gravity Forms with third party services using custom webhooks."
msgstr "Egyéni webhookokkal kapcsolja össze a Gravity Formsot külső szolgáltatásokkal."

#. Author of the plugin
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-webhooks.php:213
msgid "Admin Ajax URL"
msgstr "Admin Ajax URL"

#: class-gf-webhooks.php:214
msgid "REST API URL"
msgstr "REST API URL"

#: class-gf-webhooks.php:239
msgid "Send webhook only when payment is received."
msgstr "Webhook küldése csak a fizetés beérkezésekor."

#: class-gf-webhooks.php:296 class-gf-webhooks.php:303
#: class-gf-webhooks.php:397 class-gf-webhooks.php:480
msgid "Name"
msgstr "Név"

#: class-gf-webhooks.php:304
msgid "Enter a feed name to uniquely identify this setup."
msgstr "Adj meg egy feednevet, amellyel egyedileg azonosítható ez a beállítás."

#: class-gf-webhooks.php:312 class-gf-webhooks.php:319
#: class-gf-webhooks.php:481
msgid "Request URL"
msgstr "Kérés URL-je"

#: class-gf-webhooks.php:320
msgid "Enter the URL to be used in the webhook request."
msgstr "Add meg a webhookkérésben használandó URL-t."

#: class-gf-webhooks.php:325 class-gf-webhooks.php:332
msgid "Request Method"
msgstr "Kérés metódusa"

#: class-gf-webhooks.php:333
msgid "Select the HTTP method used for the webhook request."
msgstr "Válaszd ki a webhookkéréshez használt HTTP-módszert."

#: class-gf-webhooks.php:359 class-gf-webhooks.php:366
msgid "Request Format"
msgstr "Kérés formátuma"

#: class-gf-webhooks.php:367
msgid "Select the format for the webhook request."
msgstr "Válaszd ki a webhookkérés formátumát."

#: class-gf-webhooks.php:371
msgid "JSON"
msgstr "JSON"

#: class-gf-webhooks.php:375
msgid "FORM"
msgstr "ŰRLAP"

#: class-gf-webhooks.php:385 class-gf-webhooks.php:391
msgid "Request Headers"
msgstr "Kérés fejlécei"

#: class-gf-webhooks.php:392
msgid "Setup the HTTP headers to be sent with the webhook request."
msgstr "Állítsd be a webhookkéréssel küldendő HTTP-fejléceket."

#: class-gf-webhooks.php:409 class-gf-webhooks.php:418
msgid "Request Body"
msgstr "Kérés törzse"

#: class-gf-webhooks.php:419
msgid ""
"Select if all fields or select fields should be sent with the webhook "
"request."
msgstr "Válaszd ki, hogy az összes mező vagy a kiválasztott mezők kerüljenek elküldésre a webhookkérésben."

#: class-gf-webhooks.php:423
msgid "All Fields"
msgstr "Összes mező"

#: class-gf-webhooks.php:427
msgid "Select Fields"
msgstr "Mezők kiválasztása"

#: class-gf-webhooks.php:433 class-gf-webhooks.php:440
msgid "Field Values"
msgstr "Mezőértékek"

#: class-gf-webhooks.php:441
msgid "Setup the fields to be sent in the webhook request."
msgstr "Állítsd be a webhookkérésben elküldendő mezőket."

#: class-gf-webhooks.php:455
msgid "Webhook Condition"
msgstr "Webhook-feltétel"

#: class-gf-webhooks.php:456
msgid "Enable Condition"
msgstr "Feltétel engedélyezése"

#: class-gf-webhooks.php:457
msgid "Execute Webhook if"
msgstr "Webhook végrehajtása, ha"

#: class-gf-webhooks.php:497
msgid "Select a Name"
msgstr "Válassz egy nevet"

#: class-gf-webhooks.php:755
msgid "Webhook was not processed because request URL was empty."
msgstr "A webhook feldolgozása nem történt meg, mert a kérés URL-je üres volt."

#. translators: 1: the errors message 2: the response code
#: class-gf-webhooks.php:788
msgid "Webhook was not successfully executed. %1$s (%2$d)"
msgstr "A webhook végrehajtása nem sikerült. %1$s (%2$d)"

#. translators: The response code
#: class-gf-webhooks.php:793
msgid "Webhook sent. Response code: %d."
msgstr "Webhook elküldve. Válaszkód: %d."

#: class-gf-webhooks.php:964
msgid "The URL you have entered is malformed."
msgstr "A megadott URL hibás formátumú."

#: class-gf-webhooks.php:965
msgid ""
"The URL you have entered is not valid. For security reasons, some characters"
" are not allowed."
msgstr "A megadott URL nem érvényes. Biztonsági okokból bizonyos karakterek nem engedélyezettek."

#: class-gf-webhooks.php:972
msgid "Fix it"
msgstr "Javítás"
