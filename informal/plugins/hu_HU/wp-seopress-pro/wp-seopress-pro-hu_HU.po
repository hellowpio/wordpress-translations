"We found <strong>%d</strong> meta robots in your page. There is probably "
"something wrong with your theme!"
msgstr "Az oldaladon <strong>%d</strong> meta robots címkét találtunk. Valószínűleg valami nincs rendben a sablonoddal!"

#: src/Helpers/Audit/SEOIssueDesc.php:238
msgid "<strong>noindex</strong> is on! Search engines can't index this page."
msgstr "<strong>noindex</strong> be van kapcsolva! A keresőmotorok nem tudják indexelni ezt az oldalt."

#: src/Helpers/Audit/SEOIssueDesc.php:241
msgid ""
"<strong>nofollow</strong> is on! Search engines can't follow your links on "
"this page."
msgstr "<strong>nofollow</strong> be van kapcsolva! A keresőmotorok nem tudják követni az oldaladon található hivatkozásokat."

#: src/Helpers/Audit/SEOIssueDesc.php:244
msgid ""
"<strong>noimageindex</strong> is on! Google will not index your images on "
"this page (but if someone makes a direct link to one of your image in this "
"page, it will be indexed)."
msgstr "<strong>noimageindex</strong> be van kapcsolva! A Google nem indexeli az ezen az oldalon lévő képeidet (de ha valaki közvetlen hivatkozást hoz létre az egyik képedre ezen az oldalon, azt indexelni fogja)."

#: src/Helpers/Audit/SEOIssueDesc.php:247
msgid ""
"<strong>nosnippet</strong> is on! Search engines will not display a snippet "
"of this page in search results."
msgstr "<strong>nosnippet</strong> be van kapcsolva! A keresőmotorok nem jelenítenek meg kódrészletet erről az oldalról a keresési találatok között."

#: src/Helpers/Audit/SEOIssueDesc.php:264
msgid ""
"We could not find any image in your content. Content with media is a plus "
"for your SEO."
msgstr "Nem találtunk képet a tartalmadban. A médiával kiegészített tartalom előnyös a SEO szempontjából."

#: src/Helpers/Audit/SEOIssueDesc.php:281
msgid "This page doesn't have any outbound links."
msgstr "Ezen az oldalon nincsenek kimenő hivatkozások."

#: src/Helpers/Audit/SEOIssueDesc.php:284
msgid ""
"This page doesn't have any internal links from other content. Links from "
"archive pages are not considered internal links due to lack of context."
msgstr "Más tartalmakból nem mutatnak belső linkek erre az oldalra. Az archívumoldalakról származó linkeket a kontextus hiánya miatt nem tekintjük belső linkeknek."

#: src/Helpers/Audit/SEOIssueDesc.php:287
msgid "You must fix this. Canonical URL duplication is bad for SEO."
msgstr "Ezt mindenképpen javítanod kell. A kanonikus URL-ek ismétlődése árt a SEO-nak."

#: src/Helpers/Audit/SEOIssueDesc.php:290
msgid "This page doesn't have any canonical URL."
msgstr "Ezen az oldalon nincs kanonikus URL."

#. translators: %d: word count
#: src/Helpers/Audit/SEOIssueDesc.php:297
