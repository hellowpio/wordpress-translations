#. translators: %s: the Apache directive that was rejected, e.g. SetHandler.
#: inc/admin/ajax.php:323
msgid ""
"For security reasons, the \"%s\" directive is not allowed here: it can "
"expose the source code of your PHP files, including wp-config.php, or run "
"code on the server. Please remove it and try again."
msgstr "Biztonsági okokból a(z) „%s” direktíva itt nem engedélyezett: felfedheti a PHP-fájljaid, köztük a wp-config.php forráskódját, vagy kódot futtathat a szerveren. Távolítsd el, majd próbáld újra."

#: inc/admin/ajax.php:338
msgid "Impossible to write in file: "
msgstr "Nem lehet írni a fájlba: "

#: inc/admin/ajax.php:358
msgid ""
".htaccess could not be saved: the homepage check failed and the previous "
"file has been restored. This usually indicates a syntax error in your "
".htaccess, or a server-side loopback issue (firewall, Basic Auth, broken "
"DNS). Please verify your homepage is reachable and try again."
msgstr "A .htaccess fájlt nem sikerült menteni: a kezdőlap ellenőrzése sikertelen volt, ezért visszaállítottuk az előző fájlt. Ez általában szintaktikai hibát jelez a .htaccess fájlban vagy szerveroldali loopback-problémát (tűzfal, Basic Auth, hibás DNS). Ellenőrizd, hogy elérhető-e a kezdőlap, majd próbáld újra."

#: inc/admin/ajax.php:361
msgid ".htaccess successfully updated!"
msgstr ".htaccess sikeresen frissítve!"

#: inc/admin/ajax.php:365
msgid "Your .htaccess is not writable."
msgstr "A .htaccess fájlod nem írható."

