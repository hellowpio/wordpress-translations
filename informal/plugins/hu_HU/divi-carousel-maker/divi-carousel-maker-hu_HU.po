msgstr "A bővítmény már aktív."

msgid "Plugin activated successfully."
msgstr "A bővítmény sikeresen aktiválva."

msgid "Unable to fetch plugin news from the server."
msgstr "Nem sikerült lekérni a bővítmény híreit a szerverről."

msgid "No plugin news found."
msgstr "Nem találhatók bővítményhírek."

msgid "Unable to fetch newsletter data."
msgstr "Nem sikerült lekérni a hírlevél adatait."

msgid "No newsletter posts found."
msgstr "Nem találhatók hírlevél-bejegyzések."

