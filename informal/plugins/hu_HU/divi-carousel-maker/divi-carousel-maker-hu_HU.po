msgstr "Hibás vagy hiányzó adatok az importfájlban."

msgid "Settings imported successfully!"
msgstr "A beállítások importálása sikeres!"

msgid "Settings reset successfully!"
msgstr "A beállítások alaphelyzetbe állítása sikerült!"

msgid "The temporary support account cannot change support access."
msgstr "Az ideiglenes támogatási fiók nem módosíthatja a támogatási hozzáférést."

msgid "Support access enabled and a temporary support user was created."
msgstr "A támogatási hozzáférés bekapcsolva, és létrejött egy ideiglenes támogatási felhasználó."

msgid "Support access disabled and the temporary support user was removed."
msgstr "A támogatási hozzáférés kikapcsolva, és az ideiglenes támogatási felhasználó eltávolítva."

msgid ""
"A real user account already uses the support email address, so temporary "
"support access cannot be enabled."
msgstr "Egy valódi felhasználói fiók már használja a támogatási e-mail címet, ezért az ideiglenes támogatási hozzáférés nem kapcsolható be."

msgid "Access link reset successfully."
msgstr "A hozzáférési link alaphelyzetbe állítása sikerült."

msgid ""
"The Divi Carousel Maker requires PHP version 7.4 or higher. Please upgrade "
