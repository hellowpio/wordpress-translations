msgid "Order"
msgstr "Rendelés"

#: includes/class-wc-table-rate-shipping.php:205
msgid "Item"
msgstr "Tétel"

#: includes/class-wc-table-rate-shipping.php:206
msgid "Line Item"
msgstr "Tételsor"

#: includes/class-wc-table-rate-shipping.php:207
#: includes/functions-admin.php:178
msgid "Class"
msgstr "Osztály"

