#. Plugin Name of the plugin
msgid "Gravity Forms Square Add-On"
msgstr "Gravity Forms Square kiegészítő"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
msgid ""
"Integrates Gravity Forms with Square, enabling end users to purchase goods "
"and services through Gravity Forms."
msgstr "A Gravity Forms és a Square integrációjával a felhasználók árukat és szolgáltatásokat vásárolhatnak a Gravity Forms segítségével."

#. Author of the plugin
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-square.php:279
msgid ""
"An error occurred while processing your request, please try again later."
msgstr "Hiba történt a kérés feldolgozása közben. Próbáld újra később."

#: class-gf-square.php:326
msgid "The credit card field will initiate once the payment condition is met."
msgstr "A bankkártyamező akkor aktiválódik, amikor teljesül a fizetési feltétel."

#: class-gf-square.php:327
msgid "Please enter a full name."
msgstr "Add meg a teljes nevedet."

#: class-gf-square.php:328
msgid "Please enter a valid card number."
msgstr "Adj meg érvényes kártyaszámot."

#: class-gf-square.php:329
msgid "Please enter a valid security code."
msgstr "Adj meg egy érvényes biztonsági kódot."

#: class-gf-square.php:330
msgid "Please enter a valid expiration date."
msgstr "Adj meg egy érvényes lejárati dátumot."

