msgid "Please enter a valid zip code."
msgstr "Adj meg egy érvényes irányítószámot."

#: class-gf-square.php:332
msgid "Please fill in all credit card details."
msgstr "Töltsd ki a bankkártya összes adatát."

#: class-gf-square.php:333
msgid "Card is not supported."
msgstr "A kártya nem támogatott."

#: class-gf-square.php:339
msgid "SCA Verification failed, please try again."
msgstr "Az SCA-ellenőrzés sikertelen. Próbáld újra."

#: class-gf-square.php:367
msgid "Are you sure you want to refund this payment?"
msgstr "Biztosan visszatéríted ezt a fizetést?"

#: class-gf-square.php:368
msgid "Are you sure you want to cancel this subscription?"
msgstr "Biztosan le szeretnéd mondani ezt az előfizetést?"

#: class-gf-square.php:378
msgid "Square Receipt URL"
msgstr "Square-bizonylat URL-je"

#: class-gf-square.php:880
msgid "Missing authentication data."
msgstr "Hiányoznak a hitelesítési adatok."

#: class-gf-square.php:892
msgid ""
"No locations found. Please confirm your Square locations support credit card"
" processing with a currency matching Gravity Forms settings."
msgstr "Nem találhatók helyszínek. Ellenőrizd, hogy a Square-helyszíneid támogatják-e a bankkártyás fizetést a Gravity Forms beállításaiban megadott pénznemben."

#: class-gf-square.php:896
msgid "Invalid authentication data."
msgstr "Hibás hitelesítési adatok."

#: class-gf-square.php:957
msgid "Cannot complete request, please contact us for further assistance."
msgstr "A kérést nem sikerült teljesíteni. További segítségért vedd fel velünk a kapcsolatot."

#: class-gf-square.php:986
msgid "Access denied."
msgstr "Hozzáférés megtagadva."

#: class-gf-square.php:1038
msgid "Unable to revoke token at Square."
msgstr "Nem sikerült visszavonni a tokent a Square-nél."

#: class-gf-square.php:1092
msgid "Payment could not be captured."
msgstr "A fizetést nem sikerült véglegesíteni."

#: class-gf-square.php:1132
msgid "Unable to find entry."
msgstr "Nem található bejegyzés."

#: class-gf-square.php:1139
msgid "Unable to find payment on Square"
msgstr "Nem található fizetés a Square-ben."

#: class-gf-square.php:1144
msgid "This payment has a pending refund"
msgstr "Ehhez a fizetéshez függőben lévő visszatérítés tartozik."

#: class-gf-square.php:1286
msgid "Unable to connect your Square account."
msgstr "Nem sikerült csatlakozni a Square-fiókodhoz."

#. translators: 1: reauthentication version number 2: open <a> tag, 3: close
#. </a> tag
#: class-gf-square.php:1306
msgid ""
"Gravity Forms Square v%1$s offers new features which require a re-"
"authentication with Square. %2$sPlease disconnect and reconnect%3$s to "
"reauthenticate your site to take advantage of these new features."
msgstr "A Gravity Forms Square v%1$s olyan új funkciókat kínál, amelyek használatához újra hitelesítened kell magad a Square-ben. %2$sVálaszd le, majd csatlakoztasd újra%3$s a webhelyedet az új funkciók használatához."

