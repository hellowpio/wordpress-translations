#: includes/class-gf-field-square-creditcard.php:557
msgid ""
"This page is unsecured. Do not enter a real credit card number! Use this "
"field only for testing purposes. "
msgstr "Ez az oldal nem biztonságos. Ne adj meg valódi hitelkártyaszámot! Ezt a mezőt csak tesztelési célokra használd."

#: includes/class-gf-field-square-creditcard.php:603
msgid "Field Style"
msgstr "Mező stílusa"

#: includes/class-gf-field-square-creditcard.php:609
