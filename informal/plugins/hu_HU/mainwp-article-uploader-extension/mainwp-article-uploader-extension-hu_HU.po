#. Plugin Name of the plugin
#: mainwp-article-uploader-extension.php
msgid "MainWP Article Uploader Extension"
msgstr "MainWP Cikkfeltöltő bővítmény"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-article-uploader-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-article-uploader-extension.php
msgid ""
"MainWP Article Uploader Extension allows you to bulk upload articles to your"
" dashboard and publish to child sites."
msgstr "A MainWP Cikkfeltöltő bővítmény lehetővé teszi cikkek tömeges feltöltését a vezérlőpultra és közzétételét a gyermekwebhelyeken."

#. Author of the plugin
#: mainwp-article-uploader-extension.php
msgid "MainWP"
msgstr "MainWP"

