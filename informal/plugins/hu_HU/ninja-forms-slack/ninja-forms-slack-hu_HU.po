#: includes/Config/ActionSlackSettings.php:14
msgid "Botname"
msgstr "Bot neve"

#: includes/Config/ActionSlackSettings.php:18
msgid "This is the name that will appear in your slack channel."
msgstr "Ez a név fog megjelenni a Slack-csatornádban."

#: includes/Config/ActionSlackSettings.php:46
msgid "Slack URL"
msgstr "Slack URL"

#: includes/Config/ActionSlackSettings.php:49
msgid ""
"Go To https://'your-team-name'.slack.com/services/new/incoming-webhook to "
"get this URL."
msgstr "Lépj a https://'your-team-name'.slack.com/services/new/incoming-webhook címre az URL megszerzéséhez."

#: includes/Config/ActionSlackSettings.php:62
msgid "Slack Emoji"
msgstr "Slack-emoji"

#: includes/Config/ActionSlackSettings.php:65
msgid "Insert one of slack's emoji codes for example :simple_smile:"
msgstr "Illeszd be a Slack egyik emoji-kódját, például ezt: :simple_smile:"

#: includes/Config/ActionSlackSettings.php:79
msgid "Allow Mentions"
msgstr "Említések engedélyezése"

#: includes/Config/ActionSlackSettings.php:82
msgid ""
"Enabling this setting will allow targeted notifications in your slack "
"channel with the @ command."
msgstr "A beállítás engedélyezésével célzott értesítéseket küldhetsz a Slack-csatornádra a @ paranccsal."

