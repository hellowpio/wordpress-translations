#: destinations/gdrive/_configure.php:243 destinations/s32/_configure.php:151
#: destinations/s33/_configure.php:165 destinations/stash2/_configure.php:193
#: destinations/stash3/_configure.php:185
msgid "Full backup limit"
msgstr "Teljes biztonsági mentések korlátja"

#: destinations/gdrive/_configure.php:244
#: destinations/stash2/_configure.php:194
#: destinations/stash3/_configure.php:186
msgid ""
"[Example: 5] - Enter 0 for no limit. This is the maximum number of Full "
