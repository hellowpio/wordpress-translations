msgstr "Értesítési feltételek"

#: includes/alerts/config/class-alerts-config.php:71
msgid "Email send request fails"
msgstr "Sikertelen e-mail-küldési kérés"

#: includes/alerts/config/class-alerts-config.php:72
msgid ""
"Enable this option send an alert when an email send attempt fails for any "
"reason."
msgstr "Kapcsold be ezt az opciót riasztás küldéséhez, ha egy e-mail-küldési kísérlet bármilyen okból meghiúsul."

#: includes/alerts/config/class-alerts-config.php:73
msgid "Failure Amount"
msgstr "Hibák száma"

#: includes/alerts/config/class-alerts-config.php:74
msgid "The number of failures to trigger an alert."
msgstr "A riasztást kiváltó hibák száma."

