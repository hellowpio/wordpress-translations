#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:77
msgid "Registering new strings found on your site…"
msgstr "Új, a webhelyeden talált szövegek regisztrálása…"

#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:78
msgid "New strings were registered."
msgstr "Az új szövegek regisztrálása megtörtént."

#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:79
msgid "Refresh the page to see them"
msgstr "Frissítsd az oldalt, hogy lásd őket"

#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:80
msgid ""
"String registration is paused: there is not enough PHP memory to continue. "
"Increase the memory limit or retry."
msgstr "A szövegek regisztrálása szünetel: nincs elég PHP-memória a folytatáshoz. Növeld a memóriakorlátot, vagy próbáld újra."

#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:81
msgid "String registration is paused after many background requests."
msgstr "A szövegek regisztrálása sok háttérkérés után szünetel."

#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:82
msgid "String registration was interrupted by a server error."
msgstr "A szövegek regisztrálását egy szerverhiba megszakította."

#. translators: Button label in the string registration notice: it starts the
#. interrupted registration again. Verb, imperative.
#: StringTranslation/Infrastructure/WordPress/HookHandler/PendingStringsQueueWorkerAssetsAction.php:84
msgid "Retry"
msgstr "Újrapróbálás"
