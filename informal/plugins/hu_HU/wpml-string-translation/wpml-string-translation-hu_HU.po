#: menu/string-translation.php:850
msgid "Select domain:"
msgstr "Domain kiválasztása:"

#: menu/string-translation.php:865
msgid "Also include translations"
msgstr "A fordítások bevonása is"

#: menu/string-translation.php:901
msgid "Remove strings by domain"
msgstr "Sztringek eltávolítása domain szerint"

#: menu/string-translation.php:919
msgid "Set the original language of themes and plugins"
msgstr "A sablonok és bővítmények eredeti nyelvének beállítása"

#: menu/string-translation.php:928
msgid ""
"By default WPML assumes that strings in themes and plugins are in English. "
"If you're using a theme or plugin that has strings in other languages you "
"can set the language of text-domains."
msgstr "Alapértelmezés szerint a WPML feltételezi, hogy a sablonok és bővítmények sztringjei angol nyelvűek. Ha olyan sablont vagy bővítményt használsz, amelynek sztringjei más nyelvűek, beállíthatod a szövegdomainek nyelvét."

#: menu/string-translation.php:935
msgid "Set the language of text-domains"
msgstr "A szövegdomainek nyelvének beállítása"

#: menu/string-translation.php:949
msgid "Not seeing strings that you are looking for?"
msgstr "Nem látod a keresett sztringeket?"

#. translators: Note in the box on the String Translation page about texts the
#. user cannot find. %1$s: opening link tag, %2$s: closing link tag, around
#. the name of the Admin Text Translation page.
#: menu/string-translation.php:954
#, php-format
msgid ""
"You can add to the String Translations table texts that appear in the admin "
"screens of the theme and plugins. To do this, go to %1$sAdmin Texts "
"Translation%2$s"
msgstr "Hozzáadhatsz a Sztringfordítások táblázatához olyan szövegeket, amelyek a sablon és a bővítmények adminfelületein jelennek meg. Ehhez lépj a %1$sAdmin szövegek fordítása%2$s oldalra"

#: menu/string-translation.php:965
msgid "Translate User properties"
msgstr "Felhasználói tulajdonságok fordítása"

