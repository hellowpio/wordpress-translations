msgid "MainWP WP Rocket"
msgstr "MainWP WP Rocket"

#: class/mainwp-rocket-abilities.class.php:34
msgid "Read WP Rocket settings stored on this Dashboard."
msgstr "A vezérlőpulton tárolt WP Rocket-beállítások beolvasása."

#: class/mainwp-rocket-abilities.class.php:90
msgid "List WP Rocket Sites"
msgstr "WP Rocket-webhelyek listázása"

#: class/mainwp-rocket-abilities.class.php:90
msgid "Get WP Rocket Site Settings"
msgstr "WP Rocket-webhely beállításainak lekérése"

#: class/mainwp-rocket-abilities.class.php:91
msgid ""
"List accessible sites with stored WP Rocket rows. Does not sync or contact "
"child sites."
msgstr "Tárolt WP Rocket-sorokkal rendelkező, elérhető webhelyek listázása. Nem szinkronizálja és nem keresi meg az alwebhelyeket."

#: class/mainwp-rocket-abilities.class.php:91
msgid ""
"Read saved WP Rocket feature switches and cache lifespan, selecting a valid "
"site override or global settings. Does not sync or contact child sites."
msgstr "A mentett WP Rocket-funkciókapcsolók és a gyorsítótár élettartamának beolvasása, érvényes webhelyszintű felülbírálás vagy globális beállítások kiválasztásával. Nem szinkronizálja és nem keresi meg az alwebhelyeket."

#: class/mainwp-rocket-abilities.class.php:161
msgid "A positive integer site_id is required."
msgstr "A site_id értékének pozitív egész számnak kell lennie."

#: class/mainwp-rocket-abilities.class.php:191
msgid "Use a positive page and a per_page value from 1 to 100."
msgstr "Adj meg pozitív oldalszámot, a per_page értéke pedig 1 és 100 közé essen."

#: class/mainwp-rocket-abilities.class.php:590
msgid "You do not have permission to read WP Rocket settings."
msgstr "Nincs jogosultságod a WP Rocket beállításainak beolvasásához."

