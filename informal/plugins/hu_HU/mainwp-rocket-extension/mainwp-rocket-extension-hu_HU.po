#. Plugin Name of the plugin
#: mainwp-rocket-extension.php
msgid "WP Rocket Integration"
msgstr "WP Rocket integráció"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-rocket-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-rocket-extension.php
msgid ""
"WP Rocket Integration combines the power of your MainWP Dashboard with the "
"popular WP Rocket Plugin. It allows you to mange WP Rocket settings and "
"quickly Clear and Preload cache on your child sites."
msgstr "A WP Rocket integráció egyesíti a MainWP vezérlőpultod erejét a népszerű WP Rocket bővítménnyel. Lehetővé teszi a WP Rocket beállításainak kezelését, valamint a gyorsítótár gyors kiürítését és előtöltését a gyermek webhelyeiden."

#. Author of the plugin
#: mainwp-rocket-extension.php
msgid "MainWP"
msgstr "MainWP"

