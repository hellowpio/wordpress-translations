#. Plugin Name of the plugin
msgid "WP Grid Builder - Caching"
msgstr "WP Grid Builder - gyorsítótárazás"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://www.wpgridbuilder.com"
msgstr "https://www.wpgridbuilder.com"

#. Description of the plugin
msgid ""
"Speed up loading time when filtering grids by caching content and facets."
msgstr "Csökkentsd a betöltési időt a rácsok szűrésekor a tartalom és a szűrők gyorsítótárazásával."

#. Author of the plugin
msgid "Loïc Blascos"
msgstr "Loïc Blascos"

