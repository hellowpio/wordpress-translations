msgid "Display a quick-action menu in the admin bar."
msgstr "Gyorsműveleti menü megjelenítése az admin sávban."

#: includes/controls.php:96
msgid ""
"<strong>If you change cache lifespan</strong>, please clear the cache to "
"prevent any issue. Otherwise, several cache versions from different "
"lifespans can be mixed."
msgstr "<strong>Ha módosítod a gyorsítótár élettartamát</strong>, a problémák elkerülése érdekében ürítsd ki a gyorsítótárat. Ellenkező esetben különböző élettartamú gyorsítótár-verziók keveredhetnek."

#: includes/fields.php:61
msgid "Cache Menu"
msgstr "Gyorsítótár menü"

#: includes/fields.php:67
msgid "Display a menu of quick actions in the admin bar to clear cache."
msgstr "Gyorsműveleti menü megjelenítése az admin sávban a gyorsítótár törléséhez."

#: includes/fields.php:107
msgid "Cache Behaviour"
msgstr "Gyorsítótár működése"

#: includes/fields.php:113
msgid ""
"Purge cache automatically when updating your posts, taxonomy terms, users "
"and any related data."
msgstr "A gyorsítótár automatikus ürítése a bejegyzéseid, az osztályozási kifejezések, a felhasználók és minden kapcsolódó adat frissítésekor."

#: includes/fields.php:120
msgid ""
"The whole cache will be automatically cleared according to the time period "
"you specified."
msgstr "A teljes gyorsítótár automatikusan kiürül az általad megadott időközönként."

#: includes/fields.php:146
msgid "Cache Content"
msgstr "Gyorsítótár tartalma"

#: includes/fields.php:152
msgid "Processing..."
msgstr "Feldolgozás alatt..."

#: includes/fields.php:153
msgid "Clear cache"
msgstr "Gyorsítótár kiürítése"

#: includes/fields.php:154
msgid "Please refresh the page to get cache stats."
msgstr "Frissítsd az oldalt a gyorsítótár statisztikáinak megtekintéséhez."

#: includes/fields.php:154
msgid "Loading cache stats..."
msgstr "Gyorsítótár-statisztikák betöltése..."

#: includes/fields.php:160
msgid ""
"<strong>If you change cache lifespan</strong>, please clear the cache to "
"prevent any issue.<br>Otherwise, several cache versions from different "
"lifespans can be mixed."
msgstr "<strong>Ha módosítod a gyorsítótár élettartamát</strong>, a problémák elkerülése érdekében ürítsd ki a gyorsítótárat.<br>Ellenkező esetben különböző élettartamú gyorsítótár-verziók keveredhetnek."

