#: class-gf-advancedpostcreation.php:3571
#: includes/blocks/class-gf-block-apc-posts.php:302
msgid "Status"
msgstr "Állapot"

#: class-gf-advancedpostcreation.php:740
msgid "Post Status"
msgstr "Bejegyzés állapota"

#: class-gf-advancedpostcreation.php:741
msgid ""
"Select the status for the post. If published status is selected and the post"
" date is in the future, it will automatically be changed to scheduled."
msgstr "Válaszd ki a bejegyzés állapotát. Ha a közzétéve állapotot választod, és a bejegyzés dátuma a jövőben van, az állapot automatikusan ütemezettre változik."

#: class-gf-advancedpostcreation.php:746
#: class-gf-advancedpostcreation.php:3572
#: includes/blocks/class-gf-block-apc-posts.php:303
msgid "Date"
msgstr "Dátum"

#: class-gf-advancedpostcreation.php:753
msgid "Post Date"
msgstr "Bejegyzés dátuma"

#: class-gf-advancedpostcreation.php:754
msgid ""
"Define the post publish date. Custom date & time can be a specific date and "
"time or a relative time (e.g. \"today\", \"next week\")."
msgstr "Add meg a bejegyzés közzétételének dátumát. Az egyéni dátum és idő lehet egy konkrét dátum és idő, vagy egy relatív időpont (például „ma”, „jövő héten”)."

#: class-gf-advancedpostcreation.php:759
msgid "Author"
msgstr "Szerző"

#: class-gf-advancedpostcreation.php:766
msgid "Post Author"
msgstr "Bejegyzés szerzője"

#: class-gf-advancedpostcreation.php:767
msgid "Select the user to be assigned to the post."
msgstr "Válaszd ki a bejegyzéshez hozzárendelendő felhasználót."

#: class-gf-advancedpostcreation.php:772
msgid "Discussion"
msgstr "Beszélgetés"

#: class-gf-advancedpostcreation.php:776
msgid "Allow Comments"
msgstr "Hozzászólások engedélyezése"

#: class-gf-advancedpostcreation.php:780
msgid "Allow Trackbacks and Pingbacks"
msgstr "Visszakövetések és pingbackek engedélyezése"

#: class-gf-advancedpostcreation.php:788 class-gf-advancedpostcreation.php:808
