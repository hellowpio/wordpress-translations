msgid "Type"
msgstr "Típus"

#: class-gf-advancedpostcreation.php:727
#: class-gf-advancedpostcreation.php:2053
msgid "Post Type"
msgstr "Bejegyzés típusa"

#: class-gf-advancedpostcreation.php:728
msgid "Select one of the defined WordPress post types for the post."
msgstr "Válaszd ki a bejegyzéshez használni kívánt, meghatározott WordPress-bejegyzéstípusok egyikét."

#: class-gf-advancedpostcreation.php:733
