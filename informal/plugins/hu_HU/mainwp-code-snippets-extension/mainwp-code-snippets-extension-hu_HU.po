#. Plugin Name of the plugin
#: mainwp-code-snippets-extension.php
msgid "MainWP Code Snippets Extension"
msgstr "MainWP kódrészlet-bővítmény"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-code-snippets-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-code-snippets-extension.php
msgid ""
"The MainWP Code Snippets Extension is a powerful PHP platform that enables "
"you to execute php code and scripts on your child sites and view the output "
"on your Dashboard. Requires the MainWP Dashboard plugin."
msgstr "A MainWP kódrészlet-bővítmény egy hatékony PHP-platform, amely lehetővé teszi, hogy PHP-kódot és szkripteket futtass a gyermekwebhelyeiden, és megtekintsd a kimenetet a vezérlőpulton. A MainWP vezérlőpult-bővítmény szükséges hozzá."

#. Author of the plugin
#: mainwp-code-snippets-extension.php
msgid "MainWP"
msgstr "MainWP"

#: class/mainwp-cs.class.php:191
msgid "Snippet cannot be empty. Please, enter the snippet and try again."
msgstr "A kódrészlet nem lehet üres. Add meg a kódrészletet, majd próbáld újra."

#: class/mainwp-cs.class.php:277
msgid ""
"PHP snippets cannot include top-level namespace, declare, or use statements."
" Snippets are executed as raw PHP code, not standalone PHP files. Remove the"
" file-scope directive before saving."
msgstr "A PHP-kódrészletek nem tartalmazhatnak legfelső szintű namespace, declare vagy use utasításokat. A kódrészletek nyers PHP-kódként futnak le, nem önálló PHP-fájlként. Mentés előtt távolítsd el a fájlszintű utasítást."

#. translators: %s: PHP parser error message.
#: class/mainwp-cs.class.php:288
#, php-format
msgid "PHP syntax check failed: %s"
msgstr "A PHP szintaxisának ellenőrzése sikertelen: %s"

#: class/mainwp-cs.class.php:390
msgid ""
"No child sites found. Please make sure your sites are properly connected."
msgstr "Nem találhatók gyermekwebhelyek. Győződj meg arról, hogy a webhelyeid megfelelően vannak összekapcsolva."

#: class/mainwp-cs.class.php:505
msgid "Snippet ID is empty."
msgstr "A kódrészlet ID-ja üres."

#: class/mainwp-cs.class.php:512 class/mainwp-cs.class.php:736
msgid "Snippet not found."
msgstr "A kódrészlet nem található."

#: class/mainwp-cs.class.php:542
msgid ""
"No selected child sites found. Snippet has been deleted from the database."
msgstr "Nem találhatók kiválasztott gyermekwebhelyek. A kódrészletet töröltük az adatbázisból."

#: class/mainwp-cs.class.php:544
msgid ""
"No selected child sites found. Snippet could not be deleted. Please try "
"again."
msgstr "Nem találhatók kiválasztott gyermekwebhelyek. A kódrészletet nem sikerült törölni. Próbáld újra."

#: class/mainwp-cs.class.php:560
msgid "Cleaning Sites"
msgstr "Webhelyek tisztítása"

#. translators: %d: Number of selected child sites.
#: class/mainwp-cs.class.php:571
#, php-format
msgid "0 / %d Processed"
msgstr "0 / %d feldolgozva"

#: class/mainwp-cs.class.php:730
msgid "Snippet ID empty."
msgstr "A kódrészlet ID-ja üres."

#: class/mainwp-cs.class.php:775
msgid "Snippet is empty."
msgstr "A kódrészlet üres."

#: class/mainwp-cs.class.php:904
msgid "Snippet has been saved."
msgstr "A kódrészlet mentve."

#: class/mainwp-cs.class.php:906
msgid "Saving snippet failed. Please, try again."
msgstr "A kódrészlet mentése sikertelen. Próbáld újra."

#: class/mainwp-cs.class.php:916
msgid "Execute on Site"
msgstr "Futtatás a webhelyen"

#: class/mainwp-cs.class.php:917
msgid ""
"Runs this snippet on selected child sites and saves it there, in child site "
"database."
msgstr "A rendszer lefuttatja a kódrészletet a kiválasztott gyermekwebhelyeken, és elmenti azok adatbázisába."

#: class/mainwp-cs.class.php:923
msgid "Return Info"
msgstr "Visszaadott információ"

#: class/mainwp-cs.class.php:924
msgid ""
"Runs this snippet on selected child sites and displays returned output in "
"the console."
msgstr "Ez a kódrészlet lefut a kiválasztott gyermekwebhelyeken, a visszaadott kimenetet pedig megjeleníti a konzolon."

#: class/mainwp-cs.class.php:930
msgid "Add to wp-config.php"
msgstr "Hozzáadás a wp-config.php fájlhoz"

#: class/mainwp-cs.class.php:931
msgid ""
"Saves this snippet to wp-config.php on selected child sites and executes "
"from there."
msgstr "A kódrészletet elmenti a kiválasztott gyermekwebhelyek wp-config.php fájljába, és onnan futtatja."

#: class/mainwp-cs.class.php:960
msgid "Snippet Title"
msgstr "Kódrészlet címe"

#: class/mainwp-cs.class.php:960
msgid "(required)"
msgstr "(kötelező)"

#: class/mainwp-cs.class.php:966
msgid "Snippet Description"
msgstr "Kódrészlet leírása"

#: class/mainwp-cs.class.php:977
msgid "Snippet Type"
msgstr "Kódrészlet típusa"

#: class/mainwp-cs.class.php:1003
msgid ""
"MainWP is not responsible for the code that you run on your sites. Use this "
"tool with extreme care and at your own risk. It is recommended that you run "
"any code on a test site before releasing on live sites."
msgstr "A MainWP nem vállal felelősséget az általad a webhelyeiden futtatott kódért. Ezt az eszközt fokozott óvatossággal és saját felelősségedre használd. Javasolt, hogy a kódot először tesztwebhelyen futtasd, mielőtt éles webhelyeken alkalmaznád."

#: class/mainwp-cs.class.php:1009
msgid "Select Sites"
msgstr "Webhelyek kiválasztása"

#: class/mainwp-cs.class.php:1020 class/mainwp-cs.class.php:1251
msgid "Run Snippet"
msgstr "Kódrészlet futtatása"

#: class/mainwp-cs.class.php:1023
msgid "Save"
msgstr "Mentés"

#: class/mainwp-cs.class.php:1027 class/mainwp-cs.class.php:1150
msgid "Delete"
msgstr "Törlés"

#: class/mainwp-cs.class.php:1038
msgid "Console"
msgstr "Konzol"

#: class/mainwp-cs.class.php:1039
msgid "Ready"
msgstr "Kész"

#: class/mainwp-cs.class.php:1051
msgid "Stop Process"
msgstr "Folyamat leállítása"

#: class/mainwp-cs.class.php:1054
msgid "Back to Snippets"
msgstr "Vissza a kódrészletekhez"

#: class/mainwp-cs.class.php:1055
msgid "Edit Snippet"
msgstr "Kódrészlet szerkesztése"

#: class/mainwp-cs.class.php:1076
msgid "Snippet"
msgstr "Kódrészlet"

#: class/mainwp-cs.class.php:1077
msgid "Type"
msgstr "Típus"

#: class/mainwp-cs.class.php:1078
msgid "Target"
msgstr "Cél"

#: class/mainwp-cs.class.php:1079
msgid "Last Edited"
msgstr "Utoljára szerkesztve"

#: class/mainwp-cs.class.php:1097
msgid ""
"You don't have any saved code snippets yet. Go to the Execute Snippets page "
"to create and save your first snippet."
msgstr "Még nincs elmentett kódrészleted. Nyisd meg a kódrészletek futtatása oldalt, hogy létrehozd és elmentsd az első kódrészletedet."

#: class/mainwp-cs.class.php:1128
msgid "Delete Snippet"
msgstr "Kódrészlet törlése"

#: class/mainwp-cs.class.php:1131
msgid "Do you want to keep the snippet on the child sites?"
msgstr "Szeretnéd megtartani a kódrészletet az alárendelt webhelyeken?"

#: class/mainwp-cs.class.php:1136
msgid "Yes, keep it."
msgstr "Igen, tartsd meg."

#: class/mainwp-cs.class.php:1142
msgid "No, remove it from sites."
msgstr "Nem, távolítsd el a webhelyekről."

#: class/mainwp-cs.class.php:1167
msgid "Execute"
msgstr "Végrehajtás"

#: class/mainwp-cs.class.php:1168
msgid "Return"
msgstr "Visszatérési érték"

#: class/mainwp-cs.class.php:1169
msgid "wp-config.php"
msgstr "wp-config.php"

#: class/mainwp-cs.class.php:1249
msgid "Snippets"
msgstr "Kódrészletek"

#: class/mainwp-cs.class.php:1253 class/mainwp-cs.class.php:1261
msgid "New Snippet"
msgstr "Új kódrészlet"

#: mainwp-code-snippets-extension.php:115
msgid "Check for updates"
msgstr "Frissítések keresése"

#: mainwp-code-snippets-extension.php:115
msgid "Check for updates now"
msgstr "Frissítések ellenőrzése most"

#: mainwp-code-snippets-extension.php:324
msgid ""
"MainWP Code Snippets Extension requires <a href=\"https://mainwp.com/\" "
"target=\"_blank\" rel=\"noopener noreferrer\">MainWP Dashboard Plugin</a> to"
" be activated in order to work. Please install and activate <a "
"href=\"https://mainwp.com/\" target=\"_blank\" rel=\"noopener "
"noreferrer\">MainWP Dashboard Plugin</a> first."
msgstr "A MainWP Code Snippets Extension működéséhez be kell kapcsolni a <a href=\"https://mainwp.com/\" target=\"_blank\" rel=\"noopener noreferrer\">MainWP vezérlőpult bővítményt</a>. Először telepítsd és kapcsold be a <a href=\"https://mainwp.com/\" target=\"_blank\" rel=\"noopener noreferrer\">MainWP vezérlőpult bővítményt</a>."
