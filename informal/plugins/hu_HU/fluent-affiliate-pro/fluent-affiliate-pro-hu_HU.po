#: app/Services/PayPal/PayPalPayouts.php:59
msgid "PayPal Payouts"
msgstr "PayPal Payouts"

#: app/Services/PayPal/PayPalPayouts.php:113
msgid "This payout was already sent to PayPal."
msgstr "Ezt a kifizetést már elküldtük a PayPalnak."

#: app/Services/PayPal/PayPalPayouts.php:117
msgid ""
"PayPal may already have this payout. Add its PayPal batch ID instead of "
"sending it again."
msgstr "Lehet, hogy a PayPal már megkapta ezt a kifizetést. Küldés helyett add meg a PayPal-köteg ID-jét."

#: app/Services/PayPal/PayPalPayouts.php:131
msgid "This payout has no transactions to send."
msgstr "Ehhez a kifizetéshez nincsenek elküldhető tranzakciók."

#. translators: %d: maximum number of payments in one PayPal payout
#: app/Services/PayPal/PayPalPayouts.php:137
#, php-format
msgid ""
"PayPal can send at most %d payments in one payout. Split this payout into "
"smaller payouts."
msgstr "A PayPal legfeljebb %d kifizetést tud küldeni egy kifizetési csomagban. Oszd fel ezt a kifizetési csomagot kisebb csomagokra."

#: app/Services/PayPal/PayPalPayouts.php:158
msgid ""
"The referrals in this payout use more than one currency. PayPal can send one"
" currency in one payout."
msgstr "A kifizetési csomagban szereplő ajánlások több pénznemet használnak. A PayPal egy kifizetési csomagban csak egy pénznemet tud küldeni."

#. translators: %s: currency code, for example USD
#: app/Services/PayPal/PayPalPayouts.php:164
#, php-format
msgid "PayPal does not support the currency %s."
msgstr "A PayPal nem támogatja ezt a pénznemet: %s."

#: app/Services/PayPal/PayPalPayouts.php:176
msgid "This payout is already being sent."
msgstr "A kifizetés küldése már folyamatban van."

#: app/Services/PayPal/PayPalPayouts.php:227
msgid "The affiliate has no valid PayPal email."
msgstr "A partnerhez nem tartozik érvényes PayPal-e-mail cím."

#. translators: %s: site name
#: app/Services/PayPal/PayPalPayouts.php:240
#, php-format
msgid "Affiliate commission from %s"
msgstr "Partneri jutalék innen: %s"

#: app/Services/PayPal/PayPalPayouts.php:245
msgid "No transaction in this payout can be sent."
msgstr "A kifizetési csomagban nincs elküldhető tranzakció."

#: app/Services/PayPal/PayPalPayouts.php:257
msgid ""
"This payout was sent to PayPal more than 29 days ago, so it is not sent "
"again. Check the payout in your PayPal account. If it is there, add its "
"batch ID. If it is not there, mark it as not in PayPal."
msgstr "Ezt a kifizetést több mint 29 napja küldték el a PayPalnak, ezért nem küldjük el újra. Ellenőrizd a kifizetést a PayPal-fiókodban. Ha megtalálod, add meg a köteg ID-jét. Ha nem találod, jelöld meg úgy, hogy nincs a PayPalnál."

#. translators: %s: site name
#: app/Services/PayPal/PayPalPayouts.php:270
#, php-format
msgid "You have a payment from %s"
msgstr "Fizetés érkezett tőle: %s"

#: app/Services/PayPal/PayPalPayouts.php:271
msgid "You received an affiliate commission payment."
msgstr "Partneri jutalékból származó kifizetést kaptál."

#: app/Services/PayPal/PayPalPayouts.php:293
msgid ""
"PayPal already has this payout, but its batch ID did not come back. Add the "
"PayPal batch ID to get the payment status."
msgstr "A PayPal már megkapta ezt a kifizetést, de a köteg ID-je nem érkezett vissza. A fizetési állapot lekéréséhez add meg a PayPal-köteg ID-jét."

#: app/Services/PayPal/PayPalPayouts.php:301
msgid ""
"PayPal took the payout, but its batch ID did not come back. Check the payout"
" in your PayPal account, then add its batch ID."
msgstr "A PayPal fogadta a kifizetést, de a köteg ID-je nem érkezett vissza. Ellenőrizd a kifizetést a PayPal-fiókodban, majd add meg a köteg ID-jét."

#: app/Services/PayPal/PayPalPayouts.php:309
msgid ""
"PayPal did not answer, so the payout may be sent. Check the payout in your "
"PayPal account. If it is there, add its batch ID. If it is not there, send "
"it again."
msgstr "A PayPal nem válaszolt, ezért lehet, hogy a kifizetést elküldték. Ellenőrizd a kifizetést a PayPal-fiókodban. Ha megtalálod, add meg a köteg ID-jét. Ha nem találod, küldd el újra."

#: app/Services/PayPal/PayPalPayouts.php:328
msgid "Only a payout that PayPal may not have can be marked as not in PayPal."
msgstr "Csak az a kifizetés jelölhető úgy, hogy nincs a PayPalnál, amelyet a PayPal esetleg nem kapott meg."

#: app/Services/PayPal/PayPalPayouts.php:334
msgid ""
"Send the payout again instead. PayPal refuses it if it already has the "
"payout."
msgstr "Ehelyett küldd el újra a kifizetést. A PayPal elutasítja, ha már megkapta."

#: app/Services/PayPal/PayPalPayouts.php:343
msgid "PayPal did not get this payout. An admin checked the PayPal account."
msgstr "A PayPal nem kapta meg ezt a kifizetést. Egy admin ellenőrizte a PayPal-fiókot."

#: app/Services/PayPal/PayPalPayouts.php:374
msgid "This payout does not need a PayPal batch ID."
msgstr "Ehhez a kifizetéshez nincs szükség PayPal-köteg ID-re."

#: app/Services/PayPal/PayPalPayouts.php:378
msgid "Enter a valid PayPal batch ID. It has letters and digits only."
msgstr "Adj meg egy érvényes PayPal-köteg ID-t. Csak betűket és számjegyeket tartalmazhat."

#: app/Services/PayPal/PayPalPayouts.php:391
msgid ""
"This PayPal batch does not belong to this payout. Check the batch ID in your"
" PayPal account."
msgstr "Ez a PayPal-köteg nem ehhez a kifizetéshez tartozik. Ellenőrizd a köteg ID-ját a PayPal-fiókodban."

#: app/Services/PayPal/PayPalPayouts.php:416
msgid "This payout was not sent to PayPal yet."
msgstr "Ezt a kifizetést még nem küldtük el a PayPalnak."

#: app/Services/PayPal/PayPalPayouts.php:456
msgid "PayPal denied this payout."
msgstr "A PayPal elutasította ezt a kifizetést."

#: app/Services/PayPal/PayPalPayouts.php:780
msgid "PayPal did not return a payout batch."
msgstr "A PayPal nem adott vissza kifizetési köteget."

#: app/Services/PayPal/PayPalPayouts.php:786
msgid ""
"Payouts is not enabled on this PayPal account. Turn on Payouts in PayPal, "
"then try again."
msgstr "A kifizetések funkció nincs bekapcsolva ezen a PayPal-fiókon. Kapcsold be a kifizetéseket a PayPalon, majd próbáld újra."

