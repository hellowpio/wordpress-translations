#, php-format
msgid ""
"Hi %1$s <p> we just noticed that you tried to make a order, but "
"unfortunately, you haven't complete. Is there anything we can help you? "
"</p><p> Here is a link to continue where you left off : <br> %s </p>"
msgstr "Szia %1$s <p>Észrevettük, hogy megpróbáltál rendelni, de sajnos nem fejezted be. Van valamiben, amiben segíthetünk?</p><p>Itt folytathatod, ahol abbahagytad: <br> %s </p>"

#: includes/settings/wcj-settings-cart-abandonment.php:153
msgid ""
"The message customers will receive. Use placeholders like %1$customer_name%,"
" %2$checkout_link%, and %3$coupon_code% to personalize the email. Keep it "
"friendly and helpful, not pushy."
msgstr "Az üzenet, amelyet a vásárlók kapnak. Használj olyan helyőrzőket, mint a %1$customer_name%, a %2$checkout_link% és a %3$coupon_code%, hogy személyre szabd az e-mailt. Legyen barátságos és segítőkész, ne rámenős."

#: includes/settings/wcj-settings-cart-abandonment.php:156
msgid "Email Trigger Time"
msgstr "E-mail küldésének ideje"

#: includes/settings/wcj-settings-cart-abandonment.php:160
