#. Plugin Name of the plugin
#: index.php
msgid "WP Booking System - Multiple Currencies"
msgstr "WP Booking System - Több pénznem"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: index.php
msgid "https://www.wpbookingsystem.com/"
msgstr "https://www.wpbookingsystem.com/"

#. Description of the plugin
#: index.php
msgid ""
"Allow your customers to switch between currencies when making a payment."
msgstr "Engedélyezd a vásárlóidnak, hogy fizetéskor pénznemet váltsanak."

#. Author of the plugin
#: index.php
msgid "Veribo, Roland Murg"
msgstr "Veribo, Roland Murg"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:3
msgid "Multiple Currencies"
msgstr "Több pénznem"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:8
msgid "Additional Currencies"
msgstr "További pénznemek"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:20
msgid ""
"Additional currencies that the customer can switch between. Make sure the "
"Payment Gateways you use all support the selected currencies."
msgstr "További pénznemek, amelyek között a vásárló válthat. Győződj meg róla, hogy az általad használt fizetési átjárók mind támogatják a kiválasztott pénznemeket."

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:25
msgid "Auto Rates"
msgstr "Automatikus árfolyamok"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:36
msgid ""
"Enabling this will automatically retrieve the conversion rates from "
"https://fixer.io/. Rates are updated daily."
msgstr "Ennek bekapcsolása automatikusan lekéri az átváltási árfolyamokat a https://fixer.io/ oldalról. Az árfolyamok naponta frissülnek."

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:43
msgid ""
"You will need to sign up for a free API key at <a href=\"https://fixer.io/\""
" target=\"_blank\">https://fixer.io/</a>"
msgstr "Ingyenes API-kulcs igényléséhez regisztrálnod kell itt: <a href=\"https://fixer.io/\" target=\"_blank\">https://fixer.io/</a>"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:50
msgid "Auto Rates - API Key"
msgstr "Automatikus árfolyamok - API-kulcs"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:57
msgid ""
"Your <a href=\"https://fixer.io/\" target=\"_blank\">https://fixer.io/</a> "
"API Key."
msgstr "A <a href=\"https://fixer.io/\" target=\"_blank\">https://fixer.io/</a> API-kulcsod."

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:66
msgid "Conversion Rates"
msgstr "Átváltási árfolyamok"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:103
msgid ""
"After selecting some currencies and saving the page, the conversion rates "
"will appear here."
msgstr "Miután kiválasztottál néhány pénznemet és elmentetted az oldalt, az átváltási árfolyamok itt jelennek meg."

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:112
msgid "Revert to default currency on checkout"
msgstr "Visszaállítás az alapértelmezett pénznemre a pénztárnál"

#: includes/base/admin/settings/views/view-payment-settings-multiple-currencies.php:123
msgid ""
"Enabling this option will only display the currency conversions, the default"
" currency will be used on the checkout screen."
msgstr "Ha bekapcsolod ezt az opciót, csak a pénznemek közötti átváltások jelennek meg; a pénztárnál az alapértelmezett pénznemet használja a rendszer."

#: includes/base/functions.php:36
msgid "Currency"
msgstr "Pénznem"

#: index.php:132
msgid ""
"The <strong>Multiple Currencies</strong> Add-on requires WP Booking System "
"version "
msgstr "A <strong>Több pénznem</strong> kiegészítő a WP Booking System verzióját igényli "
