#: src/Integrations/Subscriptions/Events/GA4/Activate_Subscription.php:58
msgid "Activate Subscription"
msgstr "Előfizetés aktiválása"

#: src/Integrations/Subscriptions/Events/GA4/Activate_Subscription.php:67
#: src/Integrations/Subscriptions/Events/Universal_Analytics/Activated_Subscription.php:67
msgid "Triggered when a customer activates their subscription."
msgstr "Akkor váltódik ki, amikor a vásárló bekapcsolja az előfizetését."

#: src/Integrations/Subscriptions/Events/GA4/Cancel_Subscription.php:55
msgid "Cancel Subscription"
msgstr "Előfizetés lemondása"

#: src/Integrations/Subscriptions/Events/GA4/Cancel_Subscription.php:64
#: src/Integrations/Subscriptions/Events/Universal_Analytics/Cancelled_Subscription.php:64
msgid "Triggered when a customer cancels their subscription."
msgstr "Akkor váltódik ki, amikor az ügyfél lemondja az előfizetését."

#: src/Integrations/Subscriptions/Events/GA4/Reactivate_Subscription.php:57
msgid "Reactivate Subscription"
msgstr "Előfizetés újraaktiválása"

#: src/Integrations/Subscriptions/Events/GA4/Reactivate_Subscription.php:66
#: src/Integrations/Subscriptions/Events/Universal_Analytics/Reactivated_Subscription.php:64
msgid "Triggered when a customer reactivates their subscription."
msgstr "Akkor váltódik ki, amikor a vásárló újra bekapcsolja az előfizetését."

#: src/Integrations/Subscriptions/Events/GA4/Renew_Subscription.php:54
msgid "Renew Subscription"
msgstr "Előfizetés megújítása"

#: src/Integrations/Subscriptions/Events/GA4/Renew_Subscription.php:63
msgid "Triggered when a customer renews their subscription."
msgstr "Akkor váltódik ki, amikor az ügyfél megújítja az előfizetését."

#: src/Integrations/Subscriptions/Events/GA4/Subscription_Expiration.php:54
msgid "Subscription Expiration"
msgstr "Előfizetés lejárata"

#: src/Integrations/Subscriptions/Events/GA4/Subscription_Expiration.php:63
#: src/Integrations/Subscriptions/Events/Universal_Analytics/Subscription_Expired.php:63
msgid "Triggered when a subscription expires."
msgstr "Akkor váltódik ki, amikor egy előfizetés lejár."

#: src/Integrations/Subscriptions/Events/GA4/Subscription_Free_Trial_End.php:55
msgid "Subscription Free Trial End"
msgstr "Előfizetés ingyenes próbaidőszakának vége"

#: src/Integrations/Subscriptions/Events/GA4/Subscription_Free_Trial_End.php:64
#: src/Integrations/Subscriptions/Events/Universal_Analytics/Subscription_Free_Trial_Ended.php:64
