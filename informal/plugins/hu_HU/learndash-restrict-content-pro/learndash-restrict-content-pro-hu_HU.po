#: includes/class-tools.php:42
#, php-format
msgid ""
"After configuring LearnDash - Restrict Content Pro integration settings, "
"please <a href=\"%s\">click here</a> to start retroactive member access "
"process."
msgstr "Miután beállítottad a LearnDash–Restrict Content Pro-integráció beállításait, <a href=\"%s\">kattints ide</a> a tagok hozzáférésének visszamenőleges biztosítására szolgáló folyamat elindításához."

#: includes/class-tools.php:63
msgid "The process is being done. Please be patient."
msgstr "A folyamat végrehajtása folyamatban van. Légy türelemmel."

#: includes/class-tools.php:100
