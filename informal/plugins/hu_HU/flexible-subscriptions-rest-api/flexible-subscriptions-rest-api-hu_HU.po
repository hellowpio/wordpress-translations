"The &#8220;%s&#8221; plugin requires activating %s plugin. <a "
"href=\"%s\">Activate %s</a>"
msgstr "A(z) &#8222;%s&#8221; bővítményhez be kell kapcsolnod a(z) %s bővítményt. <a href=\"%s\">A(z) %s bekapcsolása</a>"

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:516
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run without %s PHP module installed. "
"Please contact your host and ask them to install %s."
msgstr ""
"A(z) &#8220;%s&#8221; bővítmény futtatásához telepíteni kell a(z) %s PHP-"
