msgstr "A(z) &#8222;%1$s&#8221; bővítmény megfelelő működéséhez legalább a(z) %3$s %2$s verziója szükséges. Frissítsd a legújabb verzióra."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:416
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run without %s active. Please install and"
" activate %s plugin."
msgstr "A(z) &#8222;%s&#8221; bővítmény futtatásához aktív %s szükséges. Telepítsd és kapcsold be a(z) %s bővítményt."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:468
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin requires free %s plugin. <a href=\"%s\">Install "
