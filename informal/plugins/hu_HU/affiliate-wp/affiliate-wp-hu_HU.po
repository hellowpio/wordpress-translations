msgstr "payout_method_restricted — a kifizetési mód le van tiltva"

#: includes/DevTools/Tools/Core/class-failed-payout-tester.php:408
msgid "recalled — Stripe or the merchant pulled it back"
msgstr "recalled — a Stripe vagy a kereskedő visszavonta"

#: includes/DevTools/Tools/Core/class-failed-payout-tester.php:409
msgid "(no reason given — tests the generic message)"
msgstr "(nincs megadva ok — az általános üzenetet teszteli)"

#: includes/DevTools/Tools/Core/class-failed-payout-tester.php:485
msgid "nothing moved"
msgstr "Nem történt pénzmozgás"

#: includes/DevTools/Tools/Core/class-failed-payout-tester.php:501
#: includes/DevTools/Tools/Core/class-failed-payout-tester.php:548
