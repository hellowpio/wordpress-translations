#: affiliate-wp.php:134
#: includes/libraries/affwp/class-affiliatewp-requirements-check-v1-1.php:279
msgid "AffiliateWP Requirements"
msgstr "AffiliateWP követelményei"

#: includes/abilities/abstracts/class-ability-group.php:172
msgid "How many records to return."
msgstr "A visszaadandó rekordok száma."

#: includes/abilities/abstracts/class-ability-group.php:179
msgid "How many records to skip, for paging."
msgstr "A lapozáskor kihagyandó rekordok száma."

#: includes/abilities/abstracts/class-ability-group.php:199
msgid "Column to sort by."
msgstr "A rendezés oszlopa."

#: includes/abilities/abstracts/class-ability-group.php:205
msgid "Sort direction."
msgstr "A rendezés iránya."

#: includes/abilities/abstracts/class-ability-group.php:227
msgid "Inclusive start date in YYYY-MM-DD format."
msgstr "Kezdő dátum YYYY-MM-DD formátumban, a dátumot is beleértve."

#: includes/abilities/abstracts/class-ability-group.php:232
msgid "Inclusive end date in YYYY-MM-DD format."
msgstr "Befejezés dátuma YYYY-MM-DD formátumban, a dátumot is beleértve."

#: includes/abilities/abstracts/class-ability-group.php:255
msgid "Total records matching the filters, ignoring paging."
msgstr "A szűrőknek megfelelő rekordok összesített száma, a lapozást figyelmen kívül hagyva."

#: includes/abilities/abstracts/class-ability-group.php:311
msgid "Affiliate ID."
msgstr "Partner-ID."

#: includes/abilities/abstracts/class-ability-group.php:316
msgid ""
"WordPress username of the affiliate. Used when affiliate_id is not given."
msgstr "A partner WordPress-felhasználóneve. Akkor használd, ha nincs megadva affiliate_id."

#: includes/abilities/abstracts/class-ability-group.php:320
msgid ""
"Account email of the affiliate. Used when neither affiliate_id nor username "
"is given."
msgstr "A partnerfiók e-mail címe. Akkor használd, ha sem affiliate_id, sem felhasználónév nincs megadva."

#: includes/abilities/abstracts/class-ability-group.php:413
#: includes/abilities/class-affiliate-abilities.php:736
#: includes/abilities/class-referral-abilities.php:263
msgid "No affiliate exists with that ID."
msgstr "Nincs ilyen ID-jű partner."

#: includes/abilities/abstracts/class-ability-group.php:421
msgid "Provide an affiliate_id, username, or email."
msgstr "Add meg az affiliate_id értékét, a felhasználónevet vagy az e-mail címet."

#: includes/abilities/abstracts/class-ability-group.php:427
msgid "No affiliate matches that user."
msgstr "Nincs ilyen felhasználóhoz tartozó partner."

#: includes/abilities/class-abilities.php:100
msgid ""
"AffiliateWP does not allow AI to make changes. Turn on Enable MCP Write "
"Access under Affiliates > Tools > AI MCP."
msgstr "Az AffiliateWP nem engedélyezi, hogy az AI módosításokat hajtson végre. Kapcsold be az MCP írási hozzáférés engedélyezése beállítást az Affiliates > Tools > AI MCP menüpontban."

#: includes/abilities/class-abilities.php:146
msgid ""
"Read affiliate program data and manage affiliates, referrals, payouts, "
"visits, campaigns, and creatives in AffiliateWP."
msgstr "Olvasd a partnerprogram adatait, és kezeld a partnereket, az ajánlásokat, a kifizetéseket, a látogatásokat, a kampányokat és a kreatívokat az AffiliateWP-ben."

#: includes/abilities/class-affiliate-abilities.php:30
msgid "First name on the affiliate's WordPress account."
msgstr "A partner WordPress-fiókjában megadott keresztnév."

#: includes/abilities/class-affiliate-abilities.php:34
msgid "Last name on the affiliate's WordPress account."
msgstr "A partner WordPress-fiókjában megadott vezetéknév."

#: includes/abilities/class-affiliate-abilities.php:41
msgid "List affiliates"
msgstr "Partnerek listázása"

#: includes/abilities/class-affiliate-abilities.php:42
msgid ""
"Lists affiliates with their status, rate, earnings, referral and visit "
"counts, and referral URL. Filter by status, search by name or email, and "
"page through results."
msgstr "Listázza a partnereket az állapotukkal, jutalékrátájukkal, bevételeikkel, ajánlásaik és látogatásaik számával, valamint az ajánlói URL-jükkel együtt. Szűrj állapot szerint, keress név vagy e-mail cím alapján, és lapozz az eredmények között."

#: includes/abilities/class-affiliate-abilities.php:50
msgid "Match against the affiliate name, username, or email."
msgstr "Egyezés keresése a partner neve, felhasználóneve vagy e-mail címe alapján."

#: includes/abilities/class-affiliate-abilities.php:54
#: includes/abilities/class-affiliate-abilities.php:139
msgid "Only affiliates with this status."
msgstr "Csak az ilyen állapotú partnerek."

#: includes/abilities/class-affiliate-abilities.php:57
msgid "Only affiliates registered in this date range."
msgstr "Csak az ebben a dátumtartományban regisztrált partnerek."

#: includes/abilities/class-affiliate-abilities.php:68
msgid "Get affiliate"
msgstr "Partner lekérése"

#: includes/abilities/class-affiliate-abilities.php:69
msgid ""
"Returns one affiliate by ID, username, or email, including their rate, "
"group, notes, lifetime earnings, counts, and referral URL."
msgstr "Egy partner adatait adja vissza ID, felhasználónév vagy e-mail cím alapján, beleértve a jutalékrátáját, csoportját, jegyzeteit, eddigi összes bevételét, statisztikai adatait és ajánlói URL-jét."

#: includes/abilities/class-affiliate-abilities.php:78
msgid "Get affiliate performance"
msgstr "Partner teljesítményének lekérése"

#: includes/abilities/class-affiliate-abilities.php:79
msgid ""
"Returns one affiliate plus their referrals, paid and unpaid earnings, "
"visits, and conversion rate. Optionally limited to a date range. Use this to"
" answer how an affiliate did this week or this month. Lifetime totals stay "
"on get-affiliate."
msgstr "Egy partner adatait adja vissza az ajánlásainak, kifizetett és ki nem fizetett bevételeinek, látogatásainak és konverziós arányának adataival együtt. Opcionálisan dátumtartományra is korlátozható. Ezzel azt is megválaszolhatod, hogyan teljesített egy partner ezen a héten vagy ebben a hónapban. Az eddigi összesített adatok továbbra is a get-affiliate lekérdezésből érhetők el."

#: includes/abilities/class-affiliate-abilities.php:86
msgid ""
"Limit referrals, earnings, and visits to this date range. Omit for all time."
msgstr "Korlátozd az ajánlásokat, a bevételeket és a látogatásokat erre a dátumtartományra. Hagyd ki, ha az összes időszak adataira van szükség."

#: includes/abilities/class-affiliate-abilities.php:101
msgid "List affiliate coupons"
msgstr "Partnerkuponok listázása"

#: includes/abilities/class-affiliate-abilities.php:102
msgid ""
"Lists the coupon codes that credit one affiliate, with the discount each "
"gives and its integration. Covers coupons assigned by hand and coupons "
"AffiliateWP generates. Coupons only come from integrations that are on, and "
"the result names any that are off."
msgstr "Listázza azokat a kuponkódokat, amelyek az értékesítéseket egy partnerhez rendelik, feltüntetve az általuk biztosított kedvezményt és az integrációjukat. Tartalmazza a kézzel hozzárendelt és az AffiliateWP által létrehozott kuponokat is. Kuponok csak bekapcsolt integrációkból származnak, az eredmény pedig megnevezi a kikapcsolt integrációkat."

#: includes/abilities/class-affiliate-abilities.php:117
msgid ""
"Integrations that can provide coupons but are turned off in AffiliateWP, so "
"their coupons are not listed."
msgstr "Azok az integrációk, amelyek biztosíthatnak kuponokat, de ki vannak kapcsolva az AffiliateWP-ben, ezért a kuponjaik nem jelennek meg."

#: includes/abilities/class-affiliate-abilities.php:122
msgid "Tell the user this when it is not empty."
msgstr "Mondd el ezt a felhasználónak, ha nem üres."

#: includes/abilities/class-affiliate-abilities.php:130
msgid "List top affiliates"
msgstr "Legjobb partnerek listázása"

#: includes/abilities/class-affiliate-abilities.php:131
msgid ""
"Ranks affiliates by earnings in a date range, with their referrals and "
"visits for the same period. Use this to answer who earned the most this "
"month. Without a date range, it ranks by lifetime paid earnings."
msgstr "A partnereket egy adott dátumtartományban elért bevételük alapján rangsorolja, és az ugyanebben az időszakban szerzett ajánlásaikat és látogatásaikat is megjeleníti. Ezzel válaszolhatsz arra, hogy ki kereste a legtöbbet ebben a hónapban. Dátumtartomány nélkül az összesített, kifizetett bevételük alapján rangsorol."

#: includes/abilities/class-affiliate-abilities.php:142
msgid ""
"Rank by earnings in this date range. Omit to rank by lifetime paid earnings."
msgstr "Rangsorolás az ebben a dátumtartományban elért bevétel alapján. Hagyd üresen az összesített, kifizetett bevétel szerinti rangsoroláshoz."

#: includes/abilities/class-affiliate-abilities.php:159
msgid "Lifetime paid earnings. Ranks the list when no date range is given."
msgstr "Összesített, kifizetett bevétel. Dátumtartomány megadása nélkül ez alapján rangsorolja a listát."

#: includes/abilities/class-affiliate-abilities.php:163
msgid "Lifetime unpaid earnings."
msgstr "Összesített, ki nem fizetett bevétel."

#: includes/abilities/class-affiliate-abilities.php:173
msgid "List affiliate groups"
msgstr "Partnercsoportok listázása"

#: includes/abilities/class-affiliate-abilities.php:174
msgid ""
"Lists affiliate groups, including any group rate that overrides the program "
"default and how many affiliates are in each group."
msgstr "Listázza a partnercsoportokat, beleértve az esetleges, a program alapértelmezett jutalékrátáját felülbíráló csoportszintű jutalékrátát, valamint az egyes csoportokban lévő partnerek számát."

#: includes/abilities/class-affiliate-abilities.php:182
msgid "Match against the group name."
msgstr "Egyezés a csoport neve alapján."

#: includes/abilities/class-affiliate-abilities.php:193
msgid "Add affiliate"
msgstr "Partner hozzáadása"

#: includes/abilities/class-affiliate-abilities.php:194
msgid ""
"Registers an existing WordPress user as an affiliate, or creates a new user "
"from an email address and registers them. Pass first_name and last_name to "
"name the affiliate. Percentage rates use the percent value, e.g. 20 for 20%."
" Fails if the user is already an affiliate."
msgstr "Egy meglévő WordPress-felhasználót partnerként regisztrál, vagy új felhasználót hoz létre egy e-mail cím alapján, majd regisztrálja partnerként. A partner nevének megadásához add meg a first_name és last_name értéket. A százalékos rátáknál a százalék értékét használd, például 20 értéket 20%-hoz. Sikertelen, ha a felhasználó már partner."

#: includes/abilities/class-affiliate-abilities.php:201
msgid "Existing WordPress user ID to register as an affiliate."
msgstr "A partnerként regisztrálandó meglévő WordPress-felhasználó felhasználói azonosítója (ID)."

#: includes/abilities/class-affiliate-abilities.php:206
msgid ""
"Email of the user to register. If no user has this email, a new user is "
"created."
msgstr "A regisztrálandó felhasználó e-mail címe. Ha nincs ilyen e-mail címmel rendelkező felhasználó, új felhasználó jön létre."

#: includes/abilities/class-affiliate-abilities.php:211
#: includes/abilities/class-referral-abilities.php:111
msgid "Initial status."
msgstr "Kezdeti állapot."

#: includes/abilities/class-affiliate-abilities.php:217
msgid ""
"Custom referral rate, e.g. 20 for 20% or 5 for a flat 5.00. Leave empty to "
"use the program default."
msgstr "Egyéni ajánlási arány, például 20 a 20%-hoz vagy 5 a fix 5,00 összeghez. Hagyd üresen a program alapértelmezett értékének használatához."

#: includes/abilities/class-affiliate-abilities.php:221
msgid "Custom rate type. Leave empty to use the program default."
msgstr "Egyéni rátatípus. Hagyd üresen a program alapértelmezett értékének használatához."

#: includes/abilities/class-affiliate-abilities.php:226
#: includes/abilities/class-affiliate-abilities.php:298
msgid "Payment email, if different from the account email."
msgstr "Fizetési e-mail cím, ha eltér a fiók e-mail címétől."

#: includes/abilities/class-affiliate-abilities.php:231
#: includes/abilities/class-formatter.php:126
msgid "Private admin notes about the affiliate."
msgstr "Privát admin-jegyzetek a partnerről."

#: includes/abilities/class-affiliate-abilities.php:235
msgid "Send the affiliate welcome email."
msgstr "Üdvözlő e-mail küldése a partnernek."

#: includes/abilities/class-affiliate-abilities.php:247
msgid "Set affiliate status"
msgstr "Partner állapotának beállítása"

#: includes/abilities/class-affiliate-abilities.php:248
msgid ""
"Changes an affiliate's status. Use active to approve a pending application, "
"rejected to decline it, and inactive to pause an affiliate without deleting "
"them."
msgstr "Módosítja a partner állapotát. Használd az aktív értéket egy függőben lévő jelentkezés jóváhagyásához, az elutasított értéket az elutasításához, a kikapcsolva értéket pedig a partner szüneteltetéséhez, törlés nélkül."

#: includes/abilities/class-affiliate-abilities.php:257
#: includes/abilities/class-referral-abilities.php:190
msgid "New status."
msgstr "Új állapot."

#: includes/abilities/class-affiliate-abilities.php:278
msgid "Update affiliate"
msgstr "Partner frissítése"

#: includes/abilities/class-affiliate-abilities.php:279
msgid ""
"Updates an affiliate's first or last name, personal referral rate, rate "
"type, payment email, admin notes, or affiliate group. Percentage rates use "
"the percent value, e.g. 20 for 20%. Leave rate empty to fall back to the "
"program default. Set group_id to 0 to remove the affiliate from their group."
" Use set-affiliate-status to approve, reject, or pause."
msgstr "Frissíti a partner keresztnevét vagy vezetéknevét, személyes ajánlási rátáját, rátatípusát, fizetési e-mail címét, admin-jegyzeteit vagy partnercsoportját. A százalékos rátáknál a százalék értékét használd, például 20 értéket 20%-hoz. Hagyd üresen a rátát, hogy a program alapértelmezett értéke lépjen életbe. A partner csoportjából való eltávolításához állítsd a group_id értékét 0-ra. A jóváhagyáshoz, elutasításhoz vagy szüneteltetéshez használd a set-affiliate-status lehetőséget."

#: includes/abilities/class-affiliate-abilities.php:289
msgid ""
"Personal referral rate, e.g. 20 for 20%. Empty string clears it so the "
"program default applies."
msgstr "Személyes jutalékráta, például 20 (azaz 20%). Az üres karakterlánc törli az értéket, így a program alapértelmezett értéke lép életbe."

#: includes/abilities/class-affiliate-abilities.php:293
msgid ""
"Personal rate type. Empty string clears it so the program default applies."
msgstr "Személyes jutalékráta típusa. Az üres karakterlánc törli az értéket, így a program alapértelmezett értéke lép életbe."

#: includes/abilities/class-affiliate-abilities.php:303
msgid "Private admin notes. Replaces the existing notes."
msgstr "Privát admin-jegyzetek. Felülírja a meglévő jegyzeteket."

#: includes/abilities/class-affiliate-abilities.php:307
msgid ""
"Affiliate group to assign. 0 removes the affiliate from their current group."
msgstr "Hozzárendelendő partnercsoport. A 0 eltávolítja a partnert az aktuális csoportjából."

#: includes/abilities/class-affiliate-abilities.php:392
msgid "Provide a user_id or an email."
msgstr "Adj meg egy user_id értéket vagy egy e-mail címet."

#: includes/abilities/class-affiliate-abilities.php:396
msgid "No user exists with that ID."
msgstr "Nem létezik felhasználó ezzel az ID-vel."

#: includes/abilities/class-affiliate-abilities.php:403
msgid "That user is already an affiliate."
msgstr "Ez a felhasználó már partner."

#: includes/abilities/class-affiliate-abilities.php:437
msgid "The affiliate could not be added."
msgstr "A partnert nem sikerült hozzáadni."

#: includes/abilities/class-affiliate-abilities.php:463
msgid "The affiliate status could not be changed."
msgstr "Nem sikerült módosítani a partner állapotát."

#. translators: %s: comma-separated integration names.
#: includes/abilities/class-affiliate-abilities.php:530
#, php-format
msgid ""
"Coupons from integrations that are turned off are not listed: %s. If the "
"store uses one of them, turn it on under AffiliateWP > Settings > "
"Integrations."
msgstr "A kikapcsolt integrációkból származó kuponok nem jelennek meg: %s. Ha az áruház használja valamelyiket, kapcsold be az AffiliateWP > beállítások > integrációk menüpontban."

#: includes/abilities/class-affiliate-abilities.php:661
#: includes/abilities/class-affiliate-abilities.php:668
msgid "Affiliate groups could not be listed."
msgstr "Nem sikerült listázni a partnercsoportokat."

#: includes/abilities/class-affiliate-abilities.php:787
msgid "You do not have permission to change this user's name."
msgstr "Nincs jogosultságod módosítani ennek a felhasználónak a nevét."

#: includes/abilities/class-affiliate-abilities.php:791
msgid "The affiliate's name could not be updated."
msgstr "Nem sikerült frissíteni a partner nevét."

#: includes/abilities/class-affiliate-abilities.php:885
msgid "No affiliate group exists with that ID."
msgstr "Nem létezik partnercsoport ezzel az ID-vel."

#: includes/abilities/class-affiliate-abilities.php:889
msgid "That group is not an affiliate group."
msgstr "Ez a csoport nem partnercsoport."

#: includes/abilities/class-affiliate-abilities.php:903
#: includes/abilities/class-affiliate-abilities.php:910
#: includes/abilities/class-affiliate-abilities.php:929
#: includes/abilities/class-affiliate-abilities.php:936
msgid "The affiliate group could not be updated."
msgstr "Nem sikerült frissíteni a partnercsoportot."

#: includes/abilities/class-campaign-abilities.php:28
msgid "List campaigns"
msgstr "Kampányok listázása"

#: includes/abilities/class-campaign-abilities.php:29
msgid ""
"Lists lifetime campaign performance: visits, unique visits, referrals, "
"conversion rate, and earnings. Each row is one campaign slug for one "
"affiliate. Filter by affiliate or campaign slug, and sort by visits, "
"referrals, or conversion rate. Use this to see which campaigns convert. "
"Date-scoped campaign stats are not stored; filter list-visits or list-"
"referrals by campaign for a date range."
msgstr "A kampányok teljes időszakra vonatkozó teljesítményét listázza: látogatások, egyedi látogatások, ajánlások, konverziós arány és bevétel. Minden sor egy partnerhez tartozó kampányslugot jelöl. Partner vagy kampányslug alapján szűrhetsz, és látogatások, ajánlások vagy konverziós arány szerint rendezhetsz. Ezzel megnézheted, mely kampányok konvertálnak. A dátumtartományhoz kötött kampányadatokat a rendszer nem tárolja; dátumtartományra vonatkozó adatokhoz a list-visits vagy a list-referrals lekérdezését szűrd kampány szerint."

#: includes/abilities/class-campaign-abilities.php:37
msgid "Only campaigns for this affiliate."
msgstr "Csak ennek a partnernek a kampányai."

#: includes/abilities/class-campaign-abilities.php:42
msgid "Only this campaign slug, e.g. spring-sale."
msgstr "Csak ez a kampányslug, például spring-sale."

#: includes/abilities/class-creative-abilities.php:28
msgid "List creatives"
msgstr "Kreatívok listázása"

#: includes/abilities/class-creative-abilities.php:29
msgid ""
"Lists the banners, text links, and other creatives affiliates can use to "
"promote the site, with the page each one links to and its status."
msgstr "Listázza azokat a bannereket, szöveges linkeket és egyéb kreatívokat, amelyeket a partnerek a webhely népszerűsítésére használhatnak, valamint az általuk hivatkozott oldalt és az állapotukat."

#: includes/abilities/class-creative-abilities.php:37
msgid "Only creatives with this status."
msgstr "Csak az ilyen állapotú kreatívok."

#: includes/abilities/class-creative-abilities.php:42
msgid "Only creatives of this type."
msgstr "Csak az ilyen típusú kreatívok."

#: includes/abilities/class-creative-abilities.php:55
msgid "Add creative"
msgstr "Kreatív hozzáadása"

#: includes/abilities/class-creative-abilities.php:56
msgid ""
"Adds a text link, image banner, or QR code that affiliates can use to "
"promote the site. Each affiliate's copy carries their own referral link to "
"the url. An image creative needs the URL of an image already in the media "
"library or elsewhere."
msgstr "Szöveges linket, képes bannert vagy QR-kódot ad hozzá, amelyet a partnerek a webhely népszerűsítésére használhatnak. Minden partner másolatában a saját, az URL-re mutató ajánlói linkje szerepel. A képes kreatívhoz egy, a médiatárban vagy máshol már meglévő kép URL-je szükséges."

#: includes/abilities/class-creative-abilities.php:63
msgid "Name affiliates see in their list of creatives."
msgstr "A név, amelyet a partnerek a kreatívjaik listájában látnak."

#: includes/abilities/class-creative-abilities.php:68
