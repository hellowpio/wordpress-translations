msgstr "Tag Manager-eseményindító"

#: includes/settings/class-form-settings.php:272
#: includes/settings/class-form-settings.php:281
msgid ""
"Set the trigger that will be sent to tag manager when this feed is "
"processed."
msgstr "Állítsd be az adatfolyam feldolgozásakor a címkekezelőnek elküldendő eseményindítót."

#: includes/settings/class-form-settings.php:352
msgid "Parameter names and values must be strings."
msgstr "A paraméterneveknek és -értékeknek karakterláncoknak kell lenniük."

#: includes/settings/class-form-settings.php:356
msgid "Parameter names must be 40 characters or less."
msgstr "A paraméternevek legfeljebb 40 karakterből állhatnak."

#: includes/settings/class-form-settings.php:360
msgid "Parameter values must be 100 characters or less."
msgstr "A paraméterértékek legfeljebb 100 karakterből állhatnak."

#: includes/settings/class-form-settings.php:364
msgid ""
"Parameter names cannot begin or end with an underscore, and must contain "
"only letters, numbers, and underscores."
msgstr "A paraméternevek nem kezdődhetnek és nem végződhetnek aláhúzásjellel, és csak betűket, számokat és aláhúzásjeleket tartalmazhatnak."

#: includes/settings/class-form-settings.php:502
msgid "Name"
msgstr "Név"

#: includes/settings/class-form-settings.php:505
msgid "Trigger"
msgstr "Eseményindító"

#: includes/settings/class-form-settings.php:532
#: includes/settings/class-form-settings.php:563
