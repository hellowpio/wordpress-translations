#. Plugin Name of the plugin
#: mainwp-cache-control-extension.php
msgid "MainWP Cache Control Extension"
msgstr "MainWP Cache Control Extension"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-cache-control-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-cache-control-extension.php
msgid ""
"MainWP Cache Control allows you to automatically purge the Cache on your "
"child sites after performing an update of WP Core, Theme, or a Plugin "
"through the MainWP Dashboard."
msgstr "A MainWP Cache Control lehetővé teszi a gyermekwebhelyeid gyorsítótárának automatikus ürítését a WP Core, a sablon vagy egy bővítmény MainWP vezérlőpulton keresztüli frissítése után."

#. Author of the plugin
#: mainwp-cache-control-extension.php
msgid "MainWP"
msgstr "MainWP"

#: class/class-mainwp-cache-control-abilities.php:51
#: class/class-mainwp-cache-control-purge-view.php:986
msgid "MainWP Cache Control"
msgstr "MainWP Cache Control"

#: class/class-mainwp-cache-control-abilities.php:52
msgid ""
"Abilities for bounded Cache Control operations on this MainWP Dashboard."
msgstr "Képességek a korlátozott gyorsítótár-vezérlési műveletek végrehajtásához ezen a MainWP vezérlőpulton."

#: class/class-mainwp-cache-control-abilities.php:69
msgid "Get MainWP Site Cache Control Status"
msgstr "MainWP-webhely gyorsítótár-vezérlési állapotának lekérése"

#: class/class-mainwp-cache-control-abilities.php:70
msgid ""
"Read current Dashboard Cache Control configuration and cached Child "
"observations for one authorized MainWP site without refreshing or purging "
"it."
msgstr "Az aktuális vezérlőpult gyorsítótár-vezérlési konfigurációjának és egy engedélyezett MainWP-webhely gyorsítótárazott gyermekwebhely-megfigyeléseinek beolvasása frissítés vagy ürítés nélkül."

#: class/class-mainwp-cache-control-abilities.php:90
msgid "List MainWP Site Cache Control Statuses"
msgstr "MainWP-webhelyek gyorsítótár-vezérlési állapotainak listázása"

#: class/class-mainwp-cache-control-abilities.php:91
msgid ""
"List bounded Dashboard cache policy and cached Child observations for sites "
"visible to the current principal."
msgstr "A jelenlegi felhasználó számára látható webhelyek korlátozott vezérlőpult-gyorsítótár-házirendjének és gyorsítótárazott gyermekwebhely-megfigyeléseinek listázása."

#: class/class-mainwp-cache-control-abilities.php:100
msgid "Get MainWP Global Cache Control Configuration"
msgstr "MainWP globális gyorsítótár-vezérlési konfigurációjának lekérése"

#: class/class-mainwp-cache-control-abilities.php:101
msgid ""
"Get non-secret global cache policy and bounded Cloudflare credential-"
"envelope readiness."
msgstr "A nem titkos globális gyorsítótár-házirend és a korlátozott Cloudflare-hitelesítőadat-tároló állapotának lekérése."

#: class/class-mainwp-cache-control-abilities.php:110
msgid "Set MainWP Global Cache Control Policy"
msgstr "MainWP globális gyorsítótár-vezérlési házirendjének beállítása"

#: class/class-mainwp-cache-control-abilities.php:111
msgid ""
"Set the global auto-purge and Cloudflare enablement flags without changing "
"credentials or synchronizing sites."
msgstr "A globális automatikus ürítési és Cloudflare-bekapcsolási jelzők beállítása a hitelesítő adatok módosítása vagy a webhelyek szinkronizálása nélkül."

#: class/class-mainwp-cache-control-abilities.php:120
msgid "Set MainWP Site Cache Control Policy"
msgstr "MainWP-webhely gyorsítótár-vezérlési házirendjének beállítása"

#: class/class-mainwp-cache-control-abilities.php:121
msgid ""
"Set one authorized site’s auto-purge and Cloudflare source modes without "
"changing credentials or synchronizing the Child."
msgstr "Egy engedélyezett webhely automatikus ürítési és Cloudflare-forrásmódjainak beállítása a hitelesítő adatok módosítása vagy a gyermekwebhely szinkronizálása nélkül."

#: class/class-mainwp-cache-control-abilities.php:130
msgid "Validate MainWP Site Cloudflare Credentials"
msgstr "MainWP-webhely Cloudflare-hitelesítő adatainak érvényesítése"

#: class/class-mainwp-cache-control-abilities.php:131
msgid ""
"Validate the effective stored Cloudflare credentials for one authorized site"
" and return only a bounded classification."
msgstr "Egy engedélyezett webhely ténylegesen tárolt Cloudflare-hitelesítő adatainak érvényesítése, majd csak egy korlátozott besorolás visszaadása."

#: class/class-mainwp-cache-control-abilities.php:140
msgid "Purge MainWP Site Cache"
msgstr "MainWP-webhely gyorsítótárának ürítése"

#: class/class-mainwp-cache-control-abilities.php:141
msgid ""
"Request a cache purge on one authorized Child and return bounded per-layer "
"confirmation provenance."
msgstr "Gyorsítótár-ürítés kérése egy engedélyezett gyermekwebhelyen, majd a rétegenkénti megerősítések eredetére vonatkozó korlátozott adatok visszaadása."

#: class/class-mainwp-cache-control-abilities.php:152
msgid "Get MainWP Site Cache Purge Outcome"
msgstr "MainWP-webhely gyorsítótár-ürítési eredményének lekérése"

#: class/class-mainwp-cache-control-abilities.php:153
msgid ""
"Get the last bounded structured purge outcome cached from one authorized "
"Child."
msgstr "Egy engedélyezett gyermekwebhelyről gyorsítótárazott legutóbbi korlátozott, strukturált ürítési eredmény lekérése."

#: class/class-mainwp-cache-control-abilities.php:581
msgid "You do not have permission to view Cache Control status for this site."
msgstr "Nincs jogosultságod megtekinteni a gyorsítótár-vezérlés állapotát ezen a webhelyen."

#: class/class-mainwp-cache-control-abilities.php:594
msgid "You do not have permission to use this Cache Control operation."
msgstr "Nincs jogosultságod használni ezt a gyorsítótár-vezérlési műveletet."

#: class/class-mainwp-cache-control-abilities.php:612
msgid ""
"Positive MainWP site ID as an integer or canonical decimal string for GET "
"transport."
msgstr "Pozitív MainWP webhelyazonosító (ID) egész számként vagy kanonikus decimális szövegként GET-adatátvitelhez."

#: class/class-mainwp-cache-control-abilities.php:632
msgid "Authorized MainWP site ID."
msgstr "Engedélyezett MainWP webhelyazonosító (ID)."

#: class/class-mainwp-cache-control-abilities.php:637
msgid ""
"Always false because this read does not contact the Child or a cache "
"provider."
msgstr "Mindig hamis, mivel ez a beolvasás nem lép kapcsolatba a gyermekwebhellyel vagy egy gyorsítótár-szolgáltatóval."

#: class/class-mainwp-cache-control-abilities.php:655
msgid ""
"Current Dashboard configuration, which may not yet be applied on the Child."
msgstr "Aktuális vezérlőpult-konfiguráció, amelyet még nem feltétlenül alkalmaztak a gyermekwebhelyen."

#: class/class-mainwp-cache-control-abilities.php:660
msgid "Identifies current Dashboard-local configuration as the source."
msgstr "Azt jelzi, hogy a vezérlőpult helyi konfigurációja a forrás."

#: class/class-mainwp-cache-control-abilities.php:665
msgid "Configured auto-purge mode: 0 disabled, 1 enabled, 2 inherit global."
msgstr "Beállított automatikus gyorsítótár-ürítési mód: 0 = kikapcsolva, 1 = bekapcsolva, 2 = globális beállítás öröklése."

#: class/class-mainwp-cache-control-abilities.php:669
msgid ""
"Effective current Dashboard auto-purge configuration, not confirmed Child "
"state."
msgstr "A vezérlőpulton aktuálisan érvényes automatikus gyorsítótár-ürítési konfiguráció, nem pedig a gyermekwebhelyen visszaigazolt állapot."

#: class/class-mainwp-cache-control-abilities.php:674
msgid ""
"Configured Cloudflare mode: 0 use global, 1 site configuration, 2 disabled."
msgstr "Beállított Cloudflare-mód: 0 = globális beállítás használata, 1 = webhelykonfiguráció, 2 = kikapcsolva."

#: class/class-mainwp-cache-control-abilities.php:678
msgid ""
"Effective current Dashboard Cloudflare configuration, not provider "
"reachability."
msgstr "A vezérlőpult aktuális, érvényes Cloudflare-konfigurációja; nem jelzi a szolgáltató elérhetőségét."

#: class/class-mainwp-cache-control-abilities.php:683
msgid ""
"Always unknown because this extension has no verified Child configuration "
"readback."
msgstr "Mindig ismeretlen, mert ez a kiterjesztés nem tudja ellenőrzötten lekérni a gyermekwebhely konfigurációját."

#: class/class-mainwp-cache-control-abilities.php:699
msgid ""
"Last cached Child observations stored on the Dashboard; not live provider "
"state."
msgstr "A vezérlőpulton tárolt, gyermekwebhelyről származó legutóbbi gyorsítótárazott megfigyelések; nem a szolgáltató élő állapota."

#: class/class-mainwp-cache-control-abilities.php:704
msgid "Identifies cached Child-reported Dashboard state as the source."
msgstr "A gyorsítótárazott, gyermekwebhely által jelentett vezérlőpultállapotot jelöli meg forrásként."

#: class/class-mainwp-cache-control-abilities.php:709
msgid ""
"Sanitized cache solution last reported by the Child, or an empty string."
msgstr "A gyermekwebhely által legutóbb jelentett, megtisztított gyorsítótárazási megoldás vagy üres karakterlánc."

#: class/class-mainwp-cache-control-abilities.php:714
msgid "Unix timestamp last reported by the Child, or 0 when unavailable."
msgstr "A gyermekwebhely által legutóbb jelentett Unix-időbélyeg, vagy 0, ha nem érhető el."

#: class/class-mainwp-cache-control-admin.php:177
msgid "Cache Control"
msgstr "Gyorsítótár-vezérlés"

#: class/class-mainwp-cache-control-admin.php:215
msgid "Undefined site id. Please, try again."
msgstr "Nincs megadva a webhely ID-ja. Próbáld újra."

#: class/class-mainwp-cache-control-operations.php:1374
msgid "A positive integer site ID is required."
msgstr "Pozitív egész számú webhelyazonosító (ID) szükséges."

#: class/class-mainwp-cache-control-operations.php:1387
msgid "The Cache Control input is invalid."
msgstr "A gyorsítótár-vezérlés bemenete hibás."

#: class/class-mainwp-cache-control-operations.php:1401
msgid "The global Cache Control policy could not be saved."
msgstr "Nem sikerült menteni a gyorsítótár-kezelés globális szabályzatát."

#: class/class-mainwp-cache-control-operations.php:1418
msgid "The site Cache Control policy could not be saved."
msgstr "Nem sikerült menteni a webhely gyorsítótár-kezelési szabályzatát."

#: class/class-mainwp-cache-control-operations.php:1434
msgid "Cache Control site statuses could not be read."
msgstr "Nem sikerült beolvasni a webhelyek gyorsítótár-vezérlési állapotait."

#: class/class-mainwp-cache-control-operations.php:1447
msgid "Stored Cloudflare credential state could not be read."
msgstr "Nem sikerült beolvasni a tárolt Cloudflare-hitelesítő adatok állapotát."

#: class/class-mainwp-cache-control-operations.php:1460
msgid "A cache purge is already in progress for this site."
msgstr "A gyorsítótár ürítése már folyamatban van ennél a webhelynél."

#: class/class-mainwp-cache-control-operations.php:1473
msgid "The cache purge result could not be confirmed."
msgstr "Nem sikerült megerősíteni a gyorsítótár ürítésének eredményét."

#: class/class-mainwp-cache-control-operations.php:1486
msgid "The Child returned an invalid cache purge result."
msgstr "A gyermekwebhely hibás gyorsítótár-ürítési eredményt adott vissza."

#: class/class-mainwp-cache-control-operations.php:1499
msgid "The Cache Control Child integration is unavailable."
msgstr "A gyermekwebhely gyorsítótár-vezérlési integrációja nem érhető el."

#: class/class-mainwp-cache-control-operations.php:1512
msgid "The requested MainWP site is not available for cache purging."
msgstr "A kért MainWP-webhelyen nem érhető el a gyorsítótár ürítése."

#: class/class-mainwp-cache-control-operations.php:1525
msgid "You do not have permission to purge this site cache."
msgstr "Nincs jogosultságod a webhely gyorsítótárának ürítéséhez."

#: class/class-mainwp-cache-control-operations.php:1538
msgid "The purge completed, but its structured outcome could not be stored."
msgstr "Az ürítés befejeződött, de a strukturált eredményt nem sikerült tárolni."

#: class/class-mainwp-cache-control-operations.php:1551
msgid "The requested MainWP site was not found."
msgstr "A kért MainWP-webhely nem található."

