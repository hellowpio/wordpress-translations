msgstr "1. Válassz kézi munkafolyamatot"

#. translators: %(count)d: number of items, %(dataType)s: type of item e.g.
#. 'orders'
#: admin/assets/build/index.js:7
msgid ""
"This workflow could potentially match %(count)d %(dataType)s which will take"
" some time to process. Try adding more rules to the workflow so there are "
"fewer matches."
msgstr "Ez a munkafolyamat potenciálisan %(count)d egyező tételt találhat (%(dataType)s); ezek feldolgozása némi időt vesz igénybe. Próbálj további szabályokat hozzáadni a munkafolyamathoz, hogy kevesebb egyezés legyen."

#: admin/assets/build/index.js:7
msgid "Warning!"
msgstr "Figyelem!"

#: admin/assets/build/index.js:7 admin/assets/build/index.js:13
msgid "Edit workflow"
msgstr "Munkafolyamat szerkesztése"

#: admin/assets/build/index.js:7
msgid "Continue anyway"
msgstr "Folytatás mindenképpen"

#: admin/assets/build/index.js:7
msgid "If you leave this page the process will stop."
msgstr "Ha elhagyod ezt az oldalt, a folyamat leáll."

#. translators: %d: the number of items
#: admin/assets/build/index.js:10
#, js-format
msgid "Total: %d"
msgstr "Összesen: %d"

#. translators: %s: The type of data e.g. 'orders'
#: admin/assets/build/index.js:13
#, js-format
msgid "There are no matching %s for the selected manual workflow."
msgstr "Nem található egyező %s a kiválasztott kézi munkafolyamathoz."

#. translators: %(itemCount)d: number of items, %(dataType)s: type of item
#. e.g. 'orders'
#: admin/assets/build/index.js:16
msgid "Run workflow for %(itemCount)d %(dataType)s"
msgstr "Munkafolyamat futtatása: %(itemCount)d tétel, típus: %(dataType)s"

#. translators: %1$s: type of item e.g. 'orders', %2$s: the workflow title
#: admin/assets/build/index.js:19
#, js-format
msgid ""
"Searching for %1$s that match the rules used in the \"%2$s\" workflow. If "
"you leave this page the process will stop."
msgstr "A(z) „%2$s” munkafolyamat szabályainak megfelelő %1$s keresése. Ha elhagyod ezt az oldalt, a folyamat leáll."

#. translators: %s: type of item e.g. 'orders'
#: admin/assets/build/index.js:22
#, js-format
msgid "2. Find matching %s"
msgstr "2. Egyező %s keresése"

#: admin/assets/build/index.js:22
msgid "3. Add to workflow queue"
msgstr "3. Hozzáadás a munkafolyamat várólistájához"

#. translators: %(itemCount)d: number of matching items, %(dataType)s: type of
#. item
#: admin/assets/build/index.js:25
msgid "Woo! %(itemCount)d %(dataType)s were successfully added to the queue."
msgstr "Hurrá! %(itemCount)d %(dataType)s sikeresen felkerült a várólistára."

#: admin/assets/build/index.js:25
msgid "View in queue"
msgstr "Megtekintés a várólistában"

#. translators: %(itemCount)d: number of matching items, %(dataType)s: type of
#. item, %(workflow)s: workflow title
#: admin/assets/build/index.js:28
msgid ""
"Adding %(itemCount)d matching %(dataType)s to the queue for the "
"\"%(workflow)s\" workflow. If you leave this page the process will stop."
msgstr "A(z) „%(workflow)s” munkafolyamat várólistájához %(itemCount)d egyező %(dataType)s hozzáadása. Ha elhagyod ezt az oldalt, a folyamat leáll."

#: admin/assets/build/index.js:28
msgid "orders"
msgstr "rendelések"

#: admin/assets/build/index.js:28
msgid "subscriptions"
msgstr "előfizetések"

#: admin/assets/build/index.js:28
msgid "items"
msgstr "elemek"

#: admin/assets/build/index.js:28
msgid "Error loading the workflow data."
msgstr "Hiba a munkafolyamat adatainak betöltésekor."

#: admin/assets/build/index.js:28
msgid "(no title)"
msgstr "(nincs cím)"

#: admin/assets/build/index.js:28
msgid "The workflow couldn't be loaded from the URL."
msgstr "A munkafolyamatot nem sikerült betölteni az URL-ről."

#: admin/assets/build/index.js:28
msgid "Find"
msgstr "Keresés"

#: admin/assets/build/index.js:28
msgid "There was an error loading presets. Please try again."
msgstr "Hiba történt az előbeállítások betöltésekor. Próbáld meg újra."

#: admin/assets/build/index.js:28
msgid "Reload"
msgstr "Újratöltés"

#: admin/assets/build/index.js:28
msgid "Error: The workflow couldn't be created."
msgstr "Hiba: A munkafolyamatot nem sikerült létrehozni."

#: admin/assets/build/index.js:31
msgid "My workflows"
msgstr "Saját munkafolyamatok"

#: admin/assets/build/index.js:31
msgid "Manual Runner"
msgstr "Kézi futtató"

#: admin/assets/build/index.js:31
