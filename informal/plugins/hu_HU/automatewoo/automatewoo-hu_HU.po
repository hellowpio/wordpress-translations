msgstr "Letölthető termékek"

#: includes/Triggers/Downloadable_Product_Purchased.php:41
msgid ""
"Select downloadable products here to have this workflow trigger only for "
"those specific products. Leave blank to run for all products."
msgstr "Válaszd ki itt a letölthető termékeket, hogy ez a munkafolyamat csak azokra a konkrét termékekre induljon. Hagyd üresen, hogy minden termékre fusson."

#: includes/Triggers/File_Downloaded.php:19
msgid "File Downloaded"
msgstr "Fájl letöltve"

#: includes/Triggers/File_Downloaded.php:20
msgid "This trigger fires after a file is downloaded."
msgstr "Ez a kiváltó akkor fut le, amikor egy fájlt letöltenek."

#: includes/Triggers/File_Not_Yet_Downloaded.php:19
msgid "File Not Yet Downloaded"
msgstr "Fájl még nincs letöltve"

#: includes/Triggers/File_Not_Yet_Downloaded.php:20
