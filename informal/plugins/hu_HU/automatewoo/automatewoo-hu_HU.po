"This trigger fires after a MailChimp for WordPress form is successfully "
"submitted."
msgstr "Ez a kiváltó akkor fut le, amikor egy MailChimp for WordPress űrlapot sikeresen beküldenek."

#: includes/Triggers/MC4WP_Form_Submission.php:33
msgid "MailChimp for WordPress"
msgstr "MailChimp for WordPress"

#: includes/Triggers/MC4WP_Form_Submission.php:49
msgid "Form"
msgstr "Űrlap"

#: includes/Triggers/MC4WP_Form_Submission.php:52
msgid ""
"Choose which MailChimp for WordPress form this workflow should trigger for."
msgstr "Válaszd ki, melyik MailChimp for WordPress űrlapra induljon ez a munkafolyamat."

#: includes/Triggers/Membership_Created.php:36
msgid "Membership Created"
msgstr "Tagság létrehozva"

#: includes/Triggers/Membership_Status_Changed.php:28
msgid "Membership Status Changed"
msgstr "A tagság állapota megváltozott"

#: includes/Triggers/Membership_Status_Changed.php:40
