#. Plugin Name of the plugin
#: woocommerce-additional-fees.php
msgid "WooCommerce Payment Gateway Based Fees"
msgstr "Fizetési átjáró alapján számított WooCommerce-díjak"

#. Plugin URI of the plugin
#: woocommerce-additional-fees.php
msgid "https://www.woothemes.com/products/payment-gateway-based-fees/"
msgstr "https://www.woothemes.com/products/payment-gateway-based-fees/"

#. Description of the plugin
#: woocommerce-additional-fees.php
msgid ""
"Add fees to an order automatically depending on the payment gateway. The "
"fees are calculated on product level and/or on total cart value on checkout "
"page, pay-for-order page and admin order page. The admin can change the "
"amount added in the backend and can also disable calculation of fees for a "
"specific order for the pay-for-order page."
msgstr "A fizetési átjárótól függően automatikusan díjakat ad a rendeléshez. A díjakat termékszinten és/vagy a teljes kosárérték alapján számítja ki a pénztár oldalon, a rendelés kifizetési oldalán és az admin rendelési oldalán. Az admin az adminfelületen módosíthatja a hozzáadott összeget, és a rendelés kifizetési oldalán egy adott rendelésnél a díjszámítást is kikapcsolhatja."

