#: includes/Actions/Signup.php:22 includes/Actions/SotSignup.php:34
#: includes/Fields/Signup.php:28
msgid "MailPoet Signup"
msgstr "MailPoet-feliratkozás"

#: includes/Actions/Signup.php:28 includes/Actions/SotSignup.php:40
#: includes/Fields/Signup.php:39
msgid "Note:"
msgstr "Megjegyzés:"

#: includes/Actions/Signup.php:28 includes/Actions/SotSignup.php:40
msgid ""
"If you include a MailPoet Signup field in your list of fields, then the user"
" will have the choice of signing up for the MailPoet list or not."
msgstr "Ha felveszel egy MailPoet-feliratkozási mezőt a mezők listájába, a felhasználó eldöntheti, hogy feliratkozik-e a MailPoet-listára."

#: includes/Actions/Signup.php:80 includes/Actions/SotSignup.php:93
msgid "Email"
msgstr "E-mail-cím"

#: includes/Actions/Signup.php:84 includes/Actions/SotSignup.php:97
msgid "First name"
msgstr "Keresztnév"

#: includes/Actions/Signup.php:88 includes/Actions/SotSignup.php:101
msgid "Last name"
msgstr "Vezetéknév"

#: includes/Fields/Signup.php:32
msgid "Users must opt-in (Unchecked)"
msgstr "A felhasználóknak fel kell iratkozniuk (nincs bejelölve)"

#: includes/Fields/Signup.php:33
msgid "Users must opt-out (Checked)"
msgstr "A felhasználóknak le kell iratkozniuk (bejelölve)"

#: includes/Fields/Signup.php:39
msgid ""
"This field can only be used in combination with the MailPoet Signup action. "
"This field gives the user the choice to choose whether to subscribe to the "
"MailPoet list or not."
msgstr "Ez a mező csak a MailPoet-feliratkozási művelettel együtt használható. A mezőben a felhasználó eldöntheti, hogy feliratkozik-e a MailPoet-listára."

#: nf-mailpoet.php:162
msgid "MailPoet Fields"
msgstr "MailPoet-mezők"
