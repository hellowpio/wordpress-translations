msgid "Check for updates"
msgstr "Frissítések keresése"

#: class/class-mainwp-early-access-page.php:268
msgid "Roll Back Child Plugins on Sites to Latest Stable Release"
msgstr "Child bővítmények visszaállítása a legújabb stabil kiadásra a webhelyeken"

#: class/class-mainwp-early-access-page.php:270
#: class/class-mainwp-early-access-page.php:1914
