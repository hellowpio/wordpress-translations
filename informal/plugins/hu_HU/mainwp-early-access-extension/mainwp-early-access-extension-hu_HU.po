msgid "Common Use Cases"
msgstr "Gyakori felhasználási esetek"

#: class/class-mainwp-early-access-page.php:1312
msgid ""
"<strong>List all sites:</strong> <code>mainwpcontrol abilities run list-"
"sites-v1 --json</code>"
msgstr "<strong>összes webhely listázása:</strong> <code>mainwpcontrol abilities run list-sites-v1 --json</code>"

#: class/class-mainwp-early-access-page.php:1319
msgid ""
"<strong>Check for pending updates:</strong> <code>mainwpcontrol abilities "
"run list-updates-v1 --json</code>"
msgstr "<strong>függőben lévő frissítések ellenőrzése:</strong> <code>mainwpcontrol abilities run list-updates-v1 --json</code>"

#: class/class-mainwp-early-access-page.php:1326
msgid ""
"<strong>Update plugins and wait for completion:</strong> <code>mainwpcontrol"
" abilities run update-site-plugins-v1 --input '{\"site_id\": 1}' --wait "
"--json</code>"
msgstr "<strong>bővítmények frissítése és a befejezés megvárása:</strong> <code>mainwpcontrol abilities run update-site-plugins-v1 --input '{\"site_id\": 1}' --wait --json</code>"

#: class/class-mainwp-early-access-page.php:1333
msgid ""
"<strong>Check configuration and connectivity:</strong> <code>mainwpcontrol "
