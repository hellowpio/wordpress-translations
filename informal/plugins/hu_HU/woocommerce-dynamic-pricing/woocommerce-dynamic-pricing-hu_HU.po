#: ../../admin/classes/taxonomy_pricing_rules_admin.class.php:38
msgid ""
"If the discount will apply to multiples of the receive amount or if the "
"discount will only be applied to exactly the number of receive items"
msgstr "Arra vonatkozik, hogy a kedvezmény a kapott mennyiség többszöröseire is érvényes-e, vagy csak pontosan a megadott számú tételre."

#: ../../admin/classes/category_pricing_rules_admin.class.php:27
msgid "Items from the selected categories will be eligible for the discount"
msgstr "A kijelölt kategóriákba tartozó tételekre érvényes lesz a kedvezmény."

#: ../../admin/classes/category_pricing_rules_admin.class.php:28
msgid ""
"Items from the selected categories will contribute to the total required "
"before the discount will be applied"
msgstr "A kijelölt kategóriákba tartozó tételek beleszámítanak abba az összegbe, amelyet a kedvezmény alkalmazása előtt el kell érni."

#: ../../admin/classes/category_pricing_rules_admin.class.php:29,
#: ../../admin/classes/taxonomy_pricing_rules_admin.class.php:41
msgid ""
