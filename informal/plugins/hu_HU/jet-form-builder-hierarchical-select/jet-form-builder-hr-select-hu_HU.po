#: includes/BaseHrSelectField.php:357
msgid "Term's meta field key/ID"
msgstr "A kifejezés metaadatmezőjének kulcsa vagy ID-je"

#: includes/BaseHrSelectField.php:358
msgid "Get calculated value from term meta"
msgstr "Számított érték lekérése a kifejezés metaadataiból"

#: includes/BaseHrSelectField.php:359
