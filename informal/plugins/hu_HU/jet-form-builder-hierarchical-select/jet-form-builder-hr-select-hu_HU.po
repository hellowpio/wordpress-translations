#. Description of the plugin
#: jet-form-builder-hierarchical-select.php
msgid ""
"A form-enriching tweak that allows you to output multi-level Select field "
"groups."
msgstr "Űrlapot gazdagító kiegészítés, amellyel többszintű Select mezőcsoportokat jeleníthetsz meg."

#. Author of the plugin
#: jet-form-builder-hierarchical-select.php
msgid "Crocoblock"
msgstr "crocoblock"

#. Author URI of the plugin
#: jet-form-builder-hierarchical-select.php
msgid "https://crocoblock.com/"
msgstr "https://crocoblock.com/"

#: includes/BaseHrSelectField.php:304
msgid "Term ID"
msgstr "Kifejezés ID"

#: includes/BaseHrSelectField.php:308
msgid "Term Name"
msgstr "Kifejezés neve"

#: includes/BaseHrSelectField.php:312
msgid "Term Slug"
msgstr "Kifejezés slug"

#: includes/BaseHrSelectField.php:316
msgid "Term Meta"
msgstr "Kifejezés metaadatai"

#: includes/BaseHrSelectField.php:329
msgid "Current Post"
