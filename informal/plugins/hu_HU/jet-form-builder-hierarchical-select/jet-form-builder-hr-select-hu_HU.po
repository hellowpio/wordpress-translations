msgstr "Számítások csak numerikus értékek esetén lehetségesek."

#: includes/BaseHrSelectField.php:377
msgid ""
"Works only if the term from the previous select field doesn't have any child"
" terms"
msgstr "Csak akkor működik, ha az előző Select mezőben kiválasztott kifejezésnek nincsenek gyermekkifejezései"

#: includes/JetFormBuilder/Blocks/ManagerBlocks.php:32
msgid ""
"<b>Warning</b>: <b>JetFormBuilder Hierarchical Select</b> needs "
"<b>JetFormBuilder</b> update."
msgstr "<b>Figyelmeztetés</b>: A <b>JetFormBuilder Hierarchical Select</b>-hez a <b>JetFormBuilder</b> frissítése szükséges."

#: jet-form-builder-hierarchical-select.php:86
msgid ""
"<b>Error:</b> <b>JetFormBuilder Hierarchical Select</b> plugin requires a "
"PHP version \">= 7.0.0\" to work properly!"
msgstr "<b>hiba:</b> A <b>JetFormBuilder Hierarchical Select</b> bővítmény megfelelő működéséhez \">= 7.0.0\" PHP-verzió szükséges!"

#: jet-form-builder-hierarchical-select.php:107
