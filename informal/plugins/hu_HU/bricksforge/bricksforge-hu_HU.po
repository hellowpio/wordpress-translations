msgstr "Válaszd ki a PDF papírméretét. A támogatott méreteket itt találod: https://github.com/dompdf/dompdf/blob/v0.8.2/src/Adapter/CPDF.php#L45 VAGY adj meg egy tömböt egyéni mérethez, például: [0, 0, 164.44, 842.07]"

#: includes/elements/pro-forms/ProForms.php:6726
msgid "Portrait"
msgstr "Álló"

#: includes/elements/pro-forms/ProForms.php:6727
