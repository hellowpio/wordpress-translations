msgstr "Hiányzik vagy lejárt a frissítési tokened. Generálj új engedélyezési kódot és frissítési tokent."

#: includes/Comm/authentication/class-salesforce-security-credentials.php:128
msgid "Please generate an authorization code and a refresh token"
msgstr "Generálj engedélyezési kódot és frissítési tokent"

#: includes/Comm/authentication/class-salesforce-security-credentials.php:146
