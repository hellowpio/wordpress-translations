msgid "Your Salesforce Consumer Secret is not stored in Settings."
msgstr "A Salesforce fogyasztói titkod nincs elmentve a beállítások között."

#: includes/Comm/authentication/class-salesforce-security-credentials.php:108
msgid "Please enter your consumer secret"
msgstr "Add meg a fogyasztói titkodat"

#: includes/Comm/authentication/class-salesforce-security-credentials.php:125
msgid ""
"Your Refresh Token is missing or expired.  Please generate a new "
