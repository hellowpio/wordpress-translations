#: includes/Config/ActionFieldMapSettings.php:15
msgid "Salesforce Field Map"
msgstr "Salesforce-mezőleképezés"

#: includes/Config/ActionFieldMapSettings.php:15
msgid "Add New"
msgstr "Új hozzáadása"

#: includes/Config/ActionFieldMapSettings.php:22
msgid "Form Field"
msgstr "Űrlapmező"

#: includes/Config/ActionFieldMapSettings.php:27
msgid "Salesforce Field"
msgstr "Salesforce-mező"

#: includes/Config/ActionFieldMapSettings.php:32
msgid "Data Handling Instructions"
msgstr "Adatkezelési utasítások"

#: includes/Config/ContextualHelp.php:19
msgid "Your text field value is too long for the Salesforce field"
msgstr "A szövegmező értéke túl hosszú a Salesforce-mezőhöz"

#: includes/Config/ContextualHelp.php:20
msgid ""
"Please limit your Ninja Forms input field the maximum number specified "
"below."
msgstr "Korlátozd a Ninja Forms beviteli mezőjét az alább megadott maximális értékre."

#: includes/Config/ContextualHelp.php:29
msgid "A field required by Salesforce is missing in the submission"
msgstr "Hiányzik a beküldésből egy Salesforce által kötelezővé tett mező"

#: includes/Config/ContextualHelp.php:30
msgid "Please ensure:"
msgstr "Ellenőrizd, hogy:"

#: includes/Config/ContextualHelp.php:31
msgid "1. You have field mapped a value to the required field"
msgstr "1. Hozzárendeltél egy értéket a kötelező mezőhöz"

#: includes/Config/ContextualHelp.php:32
msgid "2. Your form requires that a value be entered for that field"
msgstr "Az űrlap megköveteli, hogy adj meg egy értéket ehhez a mezőhöz"

#: includes/Config/ContextualHelp.php:33
msgid "Here is the field with issues:"
msgstr "Itt találod a problémás mezőt:"

#: includes/Config/ContextualHelp.php:42
msgid "The submission is sending a non-number to a currency field."
msgstr "A beküldés nem számot küld egy pénznem típusú mezőhöz."

#: includes/Config/ContextualHelp.php:43
msgid ""
"1. Find the submission value specified in the \"Cannot deserialize instance "
"of currency\" line below"
msgstr "1. Keresd meg az alábbi „Cannot deserialize instance of currency” sorban megadott beküldési értéket"

#: includes/Config/ContextualHelp.php:44
msgid "2. Find the Salesforce Field Name getting that value."
msgstr "2. Keresd meg annak a Salesforce-mezőnek a nevét, amely ezt az értéket kapja."

#: includes/Config/ContextualHelp.php:45
msgid "3. Go to your Add to Salesforce field map and find that field."
msgstr "3. Nyisd meg a Salesforce-hoz való hozzáadás mezőleképezését, és keresd meg ezt a mezőt."

#: includes/Config/ContextualHelp.php:46
msgid ""
"4. Select \"Format for Salesforce Currency\" in the special instruction "
"column for that field"
msgstr "4. Válaszd ki ennél a mezőnél a „Formázás Salesforce-pénznemként” lehetőséget a speciális utasítás oszlopában"

#: includes/Config/ContextualHelp.php:55
msgid ""
"The submission is sending a non-integer value to a field requiring an "
"integer"
msgstr "A beküldés nem egész szám értéket küld egy egész számot igénylő mezőhöz"

#: includes/Config/ContextualHelp.php:56
msgid ""
"1. Find the submission value specified in the \"Cannot deserialize instance "
"of int\" line below"
msgstr "1. Keresd meg a beküldés értékét, amelyet az alábbi „Cannot deserialize instance of int” sor jelez"

#: includes/Config/ContextualHelp.php:57 includes/Config/ContextualHelp.php:69
#: includes/Config/ContextualHelp.php:81
msgid "2. Find the Salesforce Field getting that value."
msgstr "2. Keresd meg azt a Salesforce-mezőt, amely ezt az értéket kapja."

#: includes/Config/ContextualHelp.php:58
msgid ""
"3. In your form design, change that field to a Ninja Forms Number field "
"type, or use a mask."
msgstr "3. Az űrlap szerkesztésénél állítsd át ezt a mezőt a Ninja Forms „Szám” mezőtípusára, vagy használj maszkolást."

#: includes/Config/ContextualHelp.php:67
msgid "The submission is sending a non-date value to a field requiring a date"
msgstr "A beküldés nem dátumértéket küld a dátumot igénylő mezőnek"

#: includes/Config/ContextualHelp.php:68
msgid ""
"1. Find the submission value specified in the \"Cannot deserialize instance "
"of date\" line below"
msgstr "1. Keresd meg a beküldés értékét, amelyet az alábbi „Cannot deserialize instance of date” sor jelez"

#: includes/Config/ContextualHelp.php:70
msgid ""
"3. In your form design, change that field to a Ninja Forms Date field type, "
"or use a mask."
msgstr "3. Az űrlap szerkesztésénél állítsd át ezt a mezőt Ninja Forms dátummezőtípusra, vagy használj maszkolást."

#: includes/Config/ContextualHelp.php:79
msgid "The submission is sending a non-email value to an email field"
msgstr "A beküldés nem e-mail-címet küld egy e-mail mezőnek"

#: includes/Config/ContextualHelp.php:80
msgid ""
"1. Find the submission value sending the non-email value specifid below"
msgstr "1. Keresd meg azt a beküldési értéket, amely az alább megadott, e-mail-címnek nem megfelelő értéket küldi"

#: includes/Config/ContextualHelp.php:82
msgid "3. In your form design, change that field to an Email field type."
msgstr "3. Az űrlap szerkesztésénél állítsd át ezt a mezőt e-mail mezőtípusra."

#: includes/Config/ContextualHelp.php:91
msgid ""
"An incorrect value is being sent to an ID field (a field that identifies a "
"record in your Salesforce Account)"
msgstr "Helytelen érték kerül egy ID-mezőbe (olyan mezőbe, amely egy rekordot azonosít a Salesforce-fiókodban)"

#: includes/Config/ContextualHelp.php:92
msgid ""
"If you are creating multiple objects in a single form, check that all "
"objects above this one in the list are corrected first."
msgstr "Ha egyetlen űrlapon több objektumot hozol létre, először ellenőrizd, hogy a listában e fölött szereplő összes objektum javítva van-e."

#: includes/Config/ContextualHelp.php:93
msgid ""
"If you are manually adding an ID, ensure that you have the correct value for"
" the ID.  You may need to check with your Salesforce rep."
msgstr "Ha manuálisan adsz meg egy ID-t, ellenőrizd, hogy a megfelelő értéket használod-e. Előfordulhat, hogy egyeztetned kell a Salesforce-kapcsolattartóddal."

#: includes/Config/ContextualHelp.php:102
msgid "Your website had an error trying to communicate with Salesforce"
msgstr "Hiba történt, amikor a honlapod megpróbált kommunikálni a Salesforce-szal"

#: includes/Config/ContextualHelp.php:103
msgid ""
