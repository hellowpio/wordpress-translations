#. Plugin Name of the plugin
msgid "Gravity Forms Signature Add-On"
msgstr "Gravity Forms aláírás-kiegészítő"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://gravityforms.com"
msgstr "https://gravityforms.com"

#. Description of the plugin
msgid ""
"Creates a Gravity Forms signature field that allows users to sign online "
"using a mouse or stylus."
msgstr "Olyan Gravity Forms-aláírásmezőt hoz létre, amellyel a felhasználók online, egérrel vagy érintőceruzával írhatnak alá."

#. Author of the plugin
msgid "Gravity Forms"
msgstr "Gravity Forms"

#: class-gf-signature.php:193
msgid ""
"Are you sure you want to permanently delete this signature? 'Cancel' to "
"stop. 'OK' to delete."
msgstr "Biztosan véglegesen törölni szeretnéd ezt az aláírást? A megszakításhoz válaszd a „mégsem”, a törléshez az „OK” lehetőséget."

#: class-gf-signature.php:194
msgid "Delete Signature"
msgstr "Aláírás törlése"

#: class-gf-signature.php:196
msgid "Signature cleared. You can sign again."
msgstr "Az aláírás törölve. Újra aláírhatsz."

#: class-gf-signature.php:197
msgid "Signature deleted."
msgstr "Aláírás törölve."

#: class-gf-signature.php:198
msgid "Signature drawn."
msgstr "Aláírás megrajzolva."

#: class-gf-signature.php:199
msgid "Signature pad, empty. Draw your signature here."
msgstr "Aláírófelület, üres. Rajzold ide az aláírásodat."

#: class-gf-signature.php:200
msgid "Signature pad, signature added."
msgstr "Aláírófelület, aláírás hozzáadva."

#: class-gf-signature.php:293 class-gf-signature.php:320
msgid "Background Color"
msgstr "Háttérszín"

#: class-gf-signature.php:293
msgid "Select the color to be used for the background of the signature area."
msgstr "Válaszd ki az aláírási terület háttérszínét."

#: class-gf-signature.php:294 class-gf-signature.php:327
msgid "Border Color"
msgstr "Szegélyszín"

#: class-gf-signature.php:294
msgid "Select the color to be used for the border around the signature area."
msgstr "Válaszd ki az aláírási terület keretének színét."

#: class-gf-signature.php:295 class-gf-signature.php:363
msgid "Pen Color"
msgstr "Toll színe"

#: class-gf-signature.php:295
msgid "Select the color of the pen to be used for the signature."
msgstr "Válaszd ki az aláíráshoz használt toll színét."

#: class-gf-signature.php:296
msgid "Width"
msgstr "Szélesség"

#: class-gf-signature.php:296
msgid "Enter the width for the signature area in pixels."
msgstr "Add meg az aláírási terület szélességét képpontban."

#: class-gf-signature.php:297 class-gf-signature.php:346
msgid "Border Style"
msgstr "Szegély stílusa"

#: class-gf-signature.php:297
msgid "Select the border style to be used around the signature area."
msgstr "Válaszd ki az aláírási terület keretének stílusát."

#: class-gf-signature.php:298 class-gf-signature.php:370
msgid "Pen Size"
msgstr "Tollméret"

#: class-gf-signature.php:298
msgid "Select the width of the pen to be used for the signature."
msgstr "Válaszd ki az aláíráshoz használt toll szélességét."

#: class-gf-signature.php:299 class-gf-signature.php:334
msgid "Border Width"
msgstr "Keret szélessége"

#: class-gf-signature.php:299
msgid "Select the border width to be used around the signature area."
msgstr "Válaszd ki az aláírási terület keretének szélességét."

#: class-gf-signature.php:300
msgid "Message"
msgstr "Üzenet"

#: class-gf-signature.php:300
msgid ""
"Write the message you would like to be sent. You can insert fields submitted"
" by the user by selecting them from the 'Insert Variable' drop down."
msgstr "Írd meg az elküldeni kívánt üzenetet. A felhasználó által beküldött mezőket a „változó beszúrása” legördülő listából választhatod ki."

#: class-gf-signature.php:301 class-gf-signature.php:392
#: includes/class-gf-field-signature.php:336
msgid "Font Options"
msgstr "Betűtípus-opciók"

#: class-gf-signature.php:301
msgid ""
"This setting controls whether the dropdown with font options is displayed, "
"allowing users to change the font for their typed signature. On mobile "
"devices, this dropdown is not visible regardless of this setting."
msgstr "Ez a beállítás határozza meg, hogy megjelenjen-e a betűtípus-opciókat tartalmazó legördülő menü, amelyben a felhasználók módosíthatják a gépelt aláírás betűtípusát. Mobilkészülékeken ez a legördülő menü ettől a beállítástól függetlenül nem látható."

#: class-gf-signature.php:302 class-gf-signature.php:398
msgid "Default Font"
msgstr "Alapértelmezett betűtípus"

#: class-gf-signature.php:302
msgid ""
"Select the font that will be used by default for typed signatures. Not "
"available in mobile devices, a default cursive font will be used instead."
msgstr "Válaszd ki a gépelt aláírásokhoz alapértelmezés szerint használt betűtípust. Mobilkészülékeken nem érhető el, helyette egy alapértelmezett folyóírásos betűtípus jelenik meg."

#: class-gf-signature.php:338
msgid "None"
msgstr "Nincs"

