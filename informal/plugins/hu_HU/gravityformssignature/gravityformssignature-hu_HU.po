msgstr "Kicsi"

#: class-gf-signature.php:340 class-gf-signature.php:375
msgid "Medium"
msgstr "Közepes"

#: class-gf-signature.php:341 class-gf-signature.php:376
msgid "Large"
msgstr "Nagy"

#: class-gf-signature.php:350
msgid "Dotted"
msgstr "Pontozott"

#: class-gf-signature.php:351
msgid "Dashed"
msgstr "Szaggatott"

#: class-gf-signature.php:352
msgid "Groove"
msgstr "Barázda"

#: class-gf-signature.php:353
msgid "Ridge"
msgstr "Domború"

#: class-gf-signature.php:354
msgid "Inset"
msgstr "Süllyesztett"

#: class-gf-signature.php:355
msgid "Outset"
msgstr "Kiemelkedő"

#: class-gf-signature.php:356
msgid "Double"
msgstr "Dupla"

#: class-gf-signature.php:357
msgid "Solid"
msgstr "Folytonos"

#: class-gf-signature.php:381
msgid "Field Width"
msgstr "Mező szélessége"

#: class-gf-signature.php:402
msgid "Script"
msgstr "Folyóírásos"

#: class-gf-signature.php:403
msgid "Handwritten"
msgstr "Kézírásos"

#: class-gf-signature.php:404
msgid "Print"
msgstr "Nyomtatás"

#: class-gf-signature.php:908
msgid "There was an issue deleting this signature."
msgstr "Hiba történt az aláírás törlésekor."

#: includes/class-gf-field-signature.php:29
msgid "Signature"
msgstr "Aláírás"

#: includes/class-gf-field-signature.php:53
msgid "Allows users to sign online using a mouse or stylus."
msgstr "Lehetővé teszi a felhasználóknak, hogy egérrel vagy érintőceruzával írjanak alá online."

#: includes/class-gf-field-signature.php:246
#: includes/class-gf-field-signature.php:637
msgid "Signature Image"
msgstr "Aláírás képe"

#: includes/class-gf-field-signature.php:255
msgid "Download file"
msgstr "Fájl letöltése"

#: includes/class-gf-field-signature.php:263
msgid "Delete file"
msgstr "Fájl törlése"

#: includes/class-gf-field-signature.php:303
#: includes/class-gf-field-signature.php:338
msgid "Type your signature"
msgstr "Írd be az aláírásodat"

#: includes/class-gf-field-signature.php:308
#: includes/class-gf-field-signature.php:315
#: includes/class-gf-field-signature.php:319
#: includes/class-gf-field-signature.php:323
msgid "Your Name"
msgstr "A neved"

#: includes/class-gf-field-signature.php:369
msgid "Reset to sign again"
msgstr "Alaphelyzetbe állítás az újbóli aláíráshoz"

