msgstr "Válaszd ki a foglalási mód típusát. Ez a választott módhoz igazítja a foglalási felület megjelenését és működését."

#: templates/admin/jet-abaf-settings/settings-general.php:12
msgid "WooCommerce based"
msgstr "WooCommerce-alapú"

#: templates/admin/jet-abaf-settings/settings-general.php:21
msgid ""
"Booking system focusing on the core functionality for managing bookings."
msgstr "A foglalások kezelésének alapfunkcióira összpontosító foglalási rendszer."

#: templates/admin/jet-abaf-settings/settings-general.php:26
#, php-format
msgid ""
"<p>Requires <a href=\"%s\" target=\"_blank\">WooCommerce</a> to be installed"
" and activated.</p>"
msgstr "<p>A <a href=\"%s\" target=\"_blank\">WooCommerce</a> telepítése és bekapcsolása szükséges.</p>"

#: templates/admin/jet-abaf-settings/settings-general.php:32
#, php-format
msgid ""
"<p>Create booking products to start using this functionality. <a href=\"%s\""
" target=\"_blank\">Create the first product</a>.</p>"
msgstr "<p>A funkció használatához hozz létre foglalási termékeket. <a href=\"%s\" target=\"_blank\">Hozd létre az első terméket</a>.</p>"

