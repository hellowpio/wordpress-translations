msgstr "Termékenkénti szállítási költség engedélyezése"

#: includes/class-wc-shipping-per-product-admin.php:185
msgid "Per-variation shipping"
msgstr "Változatonkénti szállítás"

#: includes/class-wc-shipping-per-product-admin.php:251
msgid "Adjust Shipping Costs"
msgstr "Szállítási költségek módosítása"

#: includes/class-wc-shipping-per-product-admin.php:252
msgid "Add per-product shipping cost to all shipping method rates?"
msgstr "Hozzáadod a termékenkénti szállítási költséget minden szállítási módszer díjához?"

#. translators: %1$s and %2$s is html tags.
#: includes/class-wc-shipping-per-product-admin.php:313
msgid ""
"%1$sNOTICE:%2$s Only tables with %3$d rules or fewer can be edited within "
"the product editor. %4$sPlease export your rules, modify as needed, and use "
"the \"Import CSV (override)\" button to update this product's rules."
msgstr "%1$sFIGYELMEZTETÉS:%2$s A termékszerkesztőben csak a legfeljebb %3$d szabályt tartalmazó táblák szerkeszthetők. %4$sExportáld a szabályokat, végezd el a szükséges módosításokat, majd használd a „CSV importálása (felülbírálás)” gombot a termék szabályainak frissítéséhez."

#: includes/class-wc-shipping-per-product-admin.php:618
msgid "Insufficient privileges to export product shipping rules."
msgstr "Nincs elegendő jogosultság a termék szállítási szabályainak exportálásához."

#: includes/class-wc-shipping-per-product-admin.php:628
msgid "Invalid product ID."
msgstr "Hibás termék ID."

