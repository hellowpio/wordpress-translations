msgstr "Szabály mentése..."

#: includes/class-wc-shipping-per-product-admin.php:123
msgid "There is no rules yet."
msgstr "Még nincsenek szabályok."

#: includes/class-wc-shipping-per-product-admin.php:167
msgid "Per-product shipping"
msgstr "Termékenkénti szállítás"

#: includes/class-wc-shipping-per-product-admin.php:168
