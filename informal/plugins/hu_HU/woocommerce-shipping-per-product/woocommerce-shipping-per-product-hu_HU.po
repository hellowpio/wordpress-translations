msgid ""
"This will remove all existing shipping rules and replace them with the "
"rule(s) in your imported CSV file. Are you sure this is what you intend to "
"do?"
msgstr "Ez eltávolítja az összes meglévő szállítási szabályt, és az importált CSV-fájlban található szabályokkal helyettesíti őket. Biztosan ezt szeretnéd?"

#: includes/class-wc-shipping-per-product-admin.php:121
msgid "Loading the rule..."
msgstr "Szabály betöltése..."

#: includes/class-wc-shipping-per-product-admin.php:122
