msgid "The country code does not exist."
msgstr "Az országkód nem létezik."

#: includes/class-wc-shipping-per-product-admin.php:99
msgid "A 2 digit country code, e.g. US. Leave blank to apply to all."
msgstr "2 jegyű országkód, pl. US. Hagyd üresen, ha mindegyikre érvényes."

#: includes/class-wc-shipping-per-product-admin.php:101
msgid "A state code, e.g. AL. Leave blank to apply to all."
msgstr "Államkód, pl. AL. Hagyd üresen, ha mindegyikre érvényes."

#: includes/class-wc-shipping-per-product-admin.php:103
msgid ""
"Postcode for this rule. Wildcards (*) can be used. Leave blank to apply to "
"all areas."
msgstr "Irányítószám ehhez a szabályhoz. Helyettesítő karakterek (*) használhatók. Hagyd üresen, ha minden területre érvényes."

#: includes/class-wc-shipping-per-product-admin.php:104
msgid "Line Cost (Excl. Tax)"
msgstr "Sor költsége (adó nélkül)"

#: includes/class-wc-shipping-per-product-admin.php:105
msgid "Decimal cost for the line as a whole."
msgstr "A teljes sor költsége tizedes formátumban."

#: includes/class-wc-shipping-per-product-admin.php:106
msgid "Item Cost (Excl. Tax)"
msgstr "Tétel költsége (adó nélkül)"

#: includes/class-wc-shipping-per-product-admin.php:107
msgid "Decimal cost for the item (multiplied by qty)."
msgstr "A tétel költsége tizedes formátumban (a mennyiséggel megszorozva)."

