#: includes/class-wc-shipping-legacy-per-product.php:39
msgid "Per-product (legacy)"
msgstr "Termékenkénti (régi)"

#. translators: %s: Admin shipping settings URL
#: includes/class-wc-shipping-legacy-per-product.php:41
msgid ""
"This method is deprecated in Per Product Shipping 2.3.0 and will be removed "
"in future versions - we recommend disabling it and instead setting up a new "
"rate within your <a href=\"%s\">Shipping zones</a>."
msgstr "Ez a módszer a Per Product Shipping 2.3.0-ban elavult, és a jövőbeli verziókban el lesz távolítva – javasoljuk, hogy tiltsd le, és ehelyett állíts be új díjtételt a <a href=\"%s\">szállítási zónák</a> között."

#: includes/class-wc-shipping-legacy-per-product.php:79
