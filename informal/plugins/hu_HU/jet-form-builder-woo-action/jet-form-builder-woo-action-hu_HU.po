#. Description of the plugin
#: jet-form-builder-woo-action.php
msgid "An addon that integrates forms and WooCommerce checkout."
msgstr "A formákat és a WooCommerce pénztárat integráló bővítmény."

#. Author of the plugin
#: jet-form-builder-woo-action.php
msgid "Crocoblock"
msgstr "crocoblock"

#. Author URI of the plugin
