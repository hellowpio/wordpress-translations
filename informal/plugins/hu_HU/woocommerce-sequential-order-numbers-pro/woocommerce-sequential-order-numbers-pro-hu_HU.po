#. Plugin Name of the plugin
#: woocommerce-sequential-order-numbers-pro.php
#: class-wc-seq-order-number-pro.php:1739
msgid "WooCommerce Sequential Order Numbers Pro"
msgstr "WooCommerce Sequential Order Numbers Pro"

#. Plugin URI of the plugin
#: woocommerce-sequential-order-numbers-pro.php
msgid "http://www.woocommerce.com/products/sequential-order-numbers-pro/"
msgstr "http://www.woocommerce.com/products/sequential-order-numbers-pro/"

#. Description of the plugin
#: woocommerce-sequential-order-numbers-pro.php
msgid "Provides custom incrementing order numbers for WooCommerce orders."
msgstr "Egyedi, növekvő rendelési számokat biztosít a WooCommerce-rendelésekhez."

#. Author of the plugin
#: woocommerce-sequential-order-numbers-pro.php
msgid "SkyVerge"
msgstr "SkyVerge"

#. Author URI of the plugin
#: woocommerce-sequential-order-numbers-pro.php
msgid "http://www.woocommerce.com"
msgstr "http://www.woocommerce.com"

#: class-wc-seq-order-number-pro.php:666
msgid "Draft"
msgstr "Piszkozat"

#: class-wc-seq-order-number-pro.php:856
msgid "Order Number Start must be a number greater than or equal to 0."
msgstr "A rendelési szám kezdőértékének 0-nak vagy annál nagyobb számnak kell lennie."

#. translators: Placeholders: %1$s - highest order number, %2$s - current
#. order number set
#: class-wc-seq-order-number-pro.php:882
msgid ""
"There is an existing order (%1$s) with a number greater than or equal to "
"%2$s. To set a new order number start please choose a higher number or "
"permanently delete the relevant order(s)."
msgstr "Már létezik egy rendelés (%1$s), amelynek száma eléri vagy meghaladja a %2$s értéket. Új kezdő rendelési szám beállításához válassz nagyobb számot, vagy véglegesen töröld az érintett rendeléseket."

#: class-wc-seq-order-number-pro.php:908
msgid "Order Numbers"
msgstr "Rendelési számok"

#: class-wc-seq-order-number-pro.php:910
msgid ""
"Use sequential, formatted order numbers to track your orders. Change the "
"starting number, or add prefixes and suffixes for accounting."
msgstr "Használj egymást követő, formázott rendelési számokat a rendelések nyomon követéséhez. Módosítsd a kezdő számot, vagy adj hozzá elő- és utótagokat a könyveléshez."

#: class-wc-seq-order-number-pro.php:915
msgid "Sample order number"
msgstr "Példa rendelési számra"

#: class-wc-seq-order-number-pro.php:923
msgid "Order Number Format"
msgstr "Rendelési szám formátuma"

#. translators: Placeholders: %1$s - opening <a> link tag, %2$s - closing </a>
#. link tag
#: class-wc-seq-order-number-pro.php:925
msgid ""
"See the %1$splugin documentation%2$s for the full set of available patterns."
msgstr "Az elérhető blokkminták teljes készletéről a %1$sbővítmény dokumentációjában%2$s olvashatsz."

#: class-wc-seq-order-number-pro.php:926
msgid ""
"Enter prefixes, suffixes, or patterns for order numbers. You can use leading"
" 0s to control order number length."
msgstr "Add meg az előtagokat, utótagokat vagy mintákat a rendelési számokhoz. A rendelési szám hosszát vezető nullákkal szabályozhatod."

#: class-wc-seq-order-number-pro.php:932 src/Admin/Onboarding_Tips.php:412
msgid "Skip Free Orders"
msgstr "Ingyenes rendelések kihagyása"

#: class-wc-seq-order-number-pro.php:933
msgid "Skip order numbers for free orders"
msgstr "Rendelési számok kihagyása az ingyenes rendelések esetén"

#: class-wc-seq-order-number-pro.php:934
msgid ""
"Use a different sequence and prefix for free orders. Example: FREE-123."
msgstr "Használj eltérő sorszámozást és előtagot az ingyenes rendelésekhez. Példa: FREE-123."

#: class-wc-seq-order-number-pro.php:942
msgid "Free Order Identifer"
msgstr "Ingyenes rendelés azonosítója"

#. translators: Placeholders: %s - sample order number
#: class-wc-seq-order-number-pro.php:944
msgid "Example free order identifier: %s"
msgstr "Példa az ingyenes rendelés azonosítójára: %s"

#: class-wc-seq-order-number-pro.php:945
msgid ""
"The text to display in place of the order number for free orders. This will "
"be displayed anywhere an order number would otherwise be shown: to the "
"customer, in emails, and in the admin."
msgstr "Az ingyenes rendelések esetén a rendelési szám helyett megjelenítendő szöveg. Mindenhol megjelenik, ahol egyébként a rendelési szám látszana: a vásárlónál, e-mailekben és az admin felületen."

#. translators: FREE- as in free purchase order
#: class-wc-seq-order-number-pro.php:950
#: class-wc-seq-order-number-pro.php:1691
msgid "FREE-"
msgstr "FREE-"

#: class-wc-seq-order-number-pro.php:1042
msgid "{mm}"
msgstr "{mm}"

#: class-wc-seq-order-number-pro.php:1043
msgid "Prefix"
msgstr "Előtag"

#: class-wc-seq-order-number-pro.php:1049
msgid "Number"
msgstr "Szám"

#: class-wc-seq-order-number-pro.php:1055
msgid "{yyyy}"
msgstr "{yyyy}"

#: class-wc-seq-order-number-pro.php:1056
msgid "Suffix"
msgstr "Utótag"

#: class-wc-seq-order-number-pro.php:1395
msgid "Sequential Order Number"
msgstr "Rendelési sorszám"

#: src/Admin/Onboarding_Tips.php:110
msgid "Yes, let's go!"
msgstr "Igen, kezdjük!"

#: src/Admin/Onboarding_Tips.php:111
msgid "Not now"
msgstr "Most nem"

#. translators: Placeholders: %1$s - opening <strong> HTML tag, %2$s -
#. localized plugin name, %3$s - closing </strong> HTML tag
#: src/Admin/Onboarding_Tips.php:120
msgid ""
"%1$sThanks for purchasing %2$s%3$s! Would you like to set up the plugin now?"
msgstr "%1$sKöszönjük, hogy megvásároltad a(z) %2$s%3$s bővítményt! Szeretnéd most beállítani a bővítményt?"

#: src/Admin/Onboarding_Tips.php:140
msgid "Sign me up!"
msgstr "Feliratkozás!"

#: src/Admin/Onboarding_Tips.php:141
msgid "No thanks"
msgstr "Nem, köszönöm"

#. translators: Placeholders: %1$s - opening <strong> HTML tag, %2$s -
#. localized plugin name, %3%s - closing </strong> HTML tag
#: src/Admin/Onboarding_Tips.php:150
msgid ""
"%1$sNice work! You’re all set up with %2$s%3$s. To learn more about your "
"plugins, SkyVerge, and running a successful eCommerce store, sign up for our"
" newsletter!"
msgstr "%1$sSzép munka! A %2$s%3$s beállítása kész. Ha többet szeretnél megtudni a bővítményeidről, a SkyVerge-ről és a sikeres e-kereskedelmi áruház működtetéséről, iratkozz fel a hírlevelünkre!"

#: src/Admin/Onboarding_Tips.php:351
msgid "Order Number Start"
msgstr "Rendelési szám kezdőértéke"

#: src/Admin/Onboarding_Tips.php:352
msgid ""
"Set your starting order number for new orders. You can use leading zeroes to"
" control the required order number length (e.g., “0001” for order numbers "
"that must be four digits long)."
msgstr "Állítsd be az új rendelések kezdő rendelési számát. A rendelési szám hosszát vezető nullákkal szabályozhatod (pl. „0001” a négyjegyű rendelési számokhoz)."

#: src/Admin/Onboarding_Tips.php:368
msgid "Order Number Prefix"
msgstr "Rendelési szám előtagja"

#. translators: Placeholders: %1$s - opening <a> link HTML tag, %2$s closing
#. </a> link HTML tag
#: src/Admin/Onboarding_Tips.php:371
msgid ""
"Add a custom prefix to your order numbers for new orders. %1$sClick here for"
" prefix patterns%2$s that can add special values, such as the month or year,"
" to your order numbers."
msgstr "Az új rendelések rendelési számaihoz egyéni előtagot adhatsz. %1$sKattints ide az előtagmintákért%2$s, amelyekkel speciális értékeket, például a hónapot vagy az évet adhatsz a rendelési számokhoz."

#: src/Admin/Onboarding_Tips.php:390
msgid "Order Number Suffix"
msgstr "Rendelési szám utótagja"

#. translators: Placeholders: %1$s - opening <a> link HTML tag, %2$s closing
#. </a> link HTML tag
#: src/Admin/Onboarding_Tips.php:393
msgid ""
"Add a custom suffix to your order numbers for new orders. %1$sClick here for"
" suffix%2$s patterns that can add special values, such as the month or year,"
" to your order numbers."
msgstr "Adj egyéni utótagot az új rendelések rendelési számaihoz. %1$sKattints ide az utótagmintákért%2$s, amelyek speciális értékeket, például hónapot vagy évet adhatnak a rendelési számokhoz."

#. translators: Placeholders: %1$s - opening <strong> HTML tag, %2$s closing
#. </strong> link HTML tag
#: src/Admin/Onboarding_Tips.php:415
msgid ""
"Select this setting to skip free orders in your order number sequence. When "
"enabled, you can set a %1$sFree Order Identifier%2$s to add a prefix to free"
" orders."
msgstr "Válaszd ezt a beállítást az ingyenes rendelések kihagyásához a rendelési számsorozatból. Bekapcsolása után az ingyenes rendelések előtagját a %1$sIngyenes rendelés azonosítója%2$s mezőben állíthatod be."

#: src/Admin/Onboarding_Tips.php:430
msgid "Save Changes"
msgstr "Módosítások mentése"

#. translators: Placeholders: %1$s - opening <strong> HTML tag, %2$s closing
#. </strong> link HTML tag
#: src/Admin/Onboarding_Tips.php:433
msgid "Click %1$sSave Changes%2$s to save your settings."
msgstr "Kattints a %1$sVáltoztatások mentése%2$s gombra a beállítások mentéséhez."

#: src/Admin/Onboarding_Tips.php:496
msgid "Dismiss"
msgstr "Bezárás"

#: src/Admin/Onboarding_Tips.php:500
msgid "Next"
msgstr "Következő"

#: src/Admin/Onboarding_Tips.php:503
msgid "Finish"
msgstr "Befejezés"
