#: src/Abilities.php:28
msgid "Abilities for Meta Box data (post types, taxonomies, fields, etc.)."
msgstr "A Meta Box adataihoz (bejegyzéstípusokhoz, taxonómiákhoz, mezőkhöz stb.) kapcsolódó képességek."

#: src/Abilities.php:37
msgid "Get expected value format for a field"
msgstr "A mezőhöz tartozó elvárt értékformátum lekérése"

#: src/Abilities.php:38
msgid ""
"Return expected value format and example for a Meta Box field. Provide "
"field_type for type-level info, or field_id + object_id for field-level info"
" that accounts for multiple/clone settings."
msgstr "A Meta Box-mező elvárt értékformátumának és példájának visszaadása. A típusszintű információkhoz add meg a field_type értékét, a többszörös vagy klónozási beállításokat is figyelembe vevő mezőszintű információkhoz pedig a field_id és az object_id értékét."

#: src/Abilities.php:44
msgid "Meta Box field type slug. Alternative to field_id."
msgstr "A Meta Box mezőtípusának slug értéke. A field_id alternatívája."

#: src/Abilities.php:48
msgid ""
"Field meta key. When given, resolves field settings (multiple/clone) for "
"precise format."
msgstr "A mező meta kulcsa. Ha meg van adva, a pontos formátum meghatározásához feloldja a mező beállításait (multiple/clone)."

#: src/Abilities.php:52
msgid ""
"Object ID (post, term, user ID, or option name). Required when field_id is "
"given."
msgstr "Objektumazonosító (bejegyzés, kifejezés, felhasználói azonosító (ID) vagy beállítás neve). Kötelező, ha a field_id meg van adva."

#: src/Abilities.php:58
msgid "Object type. Used with field_id."
msgstr "Objektumtípus. A field_id értékével együtt használd."

#: src/Abilities.php:68
msgid "The field type."
msgstr "A mező típusa."

#: src/Abilities.php:72
msgid "Human-readable description of expected value format."
msgstr "Az elvárt értékformátum közérthető leírása."

#: src/Abilities.php:75
msgid "Example of a valid value."
msgstr "Érvényes érték példája."

#: src/Abilities.php:79
msgid "Whether value is an array."
msgstr "Azt jelzi, hogy az érték tömb-e."

#: src/Abilities.php:83
msgid "Whether field has multiple=true (allows selecting multiple values)."
msgstr "Azt jelzi, hogy a mező multiple=true beállítású-e (több érték kiválasztását teszi lehetővé)."

#: src/Abilities.php:87
msgid "Whether field has clone=true (stores array of values)."
msgstr "Azt jelzi, hogy a mező clone=true beállítású-e (értéktömböt tárol)."

#: src/Abilities.php:92
msgid ""
"Overall value shape. scalar = single value; array = array of values "
"(multiple or clone); array_of_arrays = nested array (multiple + clone)."
msgstr "Az érték általános szerkezete. A scalar egyetlen értéket, az array értéktömböt (multiple vagy clone), az array_of_arrays pedig beágyazott tömböt (multiple + clone) jelent."

#: src/Abilities.php:127
msgid "Get a custom field value"
msgstr "Egyéni mezőérték lekérése"

#: src/Abilities.php:128
msgid ""
"Retrieve the stored value of a Meta Box custom field for a given object."
msgstr "Egy adott objektum Meta Box egyéni mezőjében tárolt érték lekérése."

#: src/Abilities.php:134
msgid "The stored field value."
msgstr "A tárolt mezőérték."

#: src/Abilities.php:158
msgid "Update (or create) a custom field value"
msgstr "Egy egyéni mező értékének frissítése (vagy létrehozása)"

#: src/Abilities.php:159
msgid ""
"Set the value of a Meta Box custom field. Creates the field value if it does"
" not exist yet."
msgstr "Meta Box egyéni mező értékének beállítása. Létrehozza a mező értékét, ha az még nem létezik."

#: src/Abilities.php:166
msgid "Whether the value was saved."
msgstr "Hogy sikerült-e elmenteni az értéket."

#: src/Abilities.php:191
msgid "Delete a custom field value"
msgstr "Egy egyéni mező értékének törlése"

#: src/Abilities.php:192
msgid "Remove the stored value of a Meta Box custom field for a given object."
msgstr "Egy adott objektum Meta Box egyéni mezőjében tárolt érték eltávolítása."

#: src/Abilities.php:199
msgid "Whether the value was deleted."
msgstr "Hogy sikerült-e törölni az értéket."

#: src/Abilities.php:232
msgid "The custom field meta key."
msgstr "Az egyéni mező meta kulcsa."

#: src/Abilities.php:236
msgid "The object ID (post, term, user ID, or settings page slug)."
msgstr "Az objektum ID-ja (bejegyzés, kifejezés, felhasználói azonosító (ID) vagy beállítási oldal slugja)."

#: src/Abilities.php:242
msgid "The object type the field belongs to."
msgstr "Az objektum típusa, amelyhez a mező tartozik."

#: src/Abilities.php:245
msgid ""
"The value to store. Required for update; ignored for get and delete. Use "
"meta-box/get-field-value-format ability to get expected format for a "
"specific field type."
msgstr "A tárolandó érték. Frissítéshez kötelező; lekéréskor és törléskor figyelmen kívül marad. A mező adott típusához tartozó elvárt formátum lekéréséhez használd a meta-box/get-field-value-format képességet."

