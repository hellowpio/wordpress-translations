#, php-format
msgid ""
"The <strong>Maximum Quantity</strong> of <strong>%1$s</strong> must be a "
"multiple of <strong>%2$d</strong>. Its value has been adjusted from "
"<strong>%3$d</strong> to <strong>%4$d</strong>."
msgstr "A(z) <strong>%1$s</strong> <strong>maximális mennyiségének</strong> a(z) <strong>%2$d</strong> többszörösének kell lennie. Az értéke <strong>%3$d</strong> helyett <strong>%4$d</strong> lett beállítva."

#. translators: Product name
#. translators: Category name
#: includes/admin/class-wc-min-max-quantities-admin.php:456
#: includes/admin/class-wc-min-max-quantities-admin.php:606
#: includes/admin/class-wc-min-max-quantities-admin.php:1026
#, php-format
msgid ""
"The <strong>Maximum Quantity</strong> of <strong>%s</strong> was not valid "
"and has been adjusted. Please enter a positive number equal to or higher "
"than the <strong>Minimum Quantity</strong>, or leave the <strong>Maximum "
"Quantity</strong> field empty for an unlimited maximum quantity."
msgstr "A(z) <strong>%s</strong> <strong>maximális mennyisége</strong> érvénytelen volt, ezért módosítottuk. Adj meg a <strong>Minimális mennyiséggel</strong> megegyező vagy annál nagyobb pozitív számot, vagy hagyd üresen a <strong>Maximális mennyiség</strong> mezőt korlátlan maximális mennyiséghez."

#: includes/admin/class-wc-min-max-quantities-admin.php:640
msgid ""
"Use this option to override 'Minimum/Maximum quantity' and 'Group of' rules "
"at variation level. Can be checked only when <strong>Product Data > General "
"> Combine Variations</strong> is disabled."
msgstr "Ezzel az opcióval felülírhatod a 'Minimális/maximális mennyiség' és 'csoportméret' szabályokat variációszinten. Csak akkor jelölheted be, ha a <strong>termékadatok > általános > variációk összevonása</strong> ki van kapcsolva."

#: includes/admin/class-wc-min-max-quantities-admin.php:728
msgid ""
"Don't count the quantity and cost of this variation when checking order "
"rules."
msgstr "Ne számold bele e variáció mennyiségét és költségét a rendelési szabályok ellenőrzésekor."

#: includes/admin/class-wc-min-max-quantities-admin.php:741
msgid "Exclude from Order rules"
msgstr "Kizárás a rendelési szabályokból"

#: includes/admin/class-wc-min-max-quantities-admin.php:741
msgid ""
"Exclude this variation from order rules (minimum/maximum quantity and "
"value)."
msgstr "Zárd ki ezt a variációt a rendelési szabályokból (minimális/maximális mennyiség és érték)."

#: includes/admin/class-wc-min-max-quantities-admin.php:744
msgid "Exclude from Category rules"
msgstr "Kizárás a kategóriaszabályokból"

#: includes/admin/class-wc-min-max-quantities-admin.php:744
msgid "Exclude this variation from all category quantity rules."
msgstr "Zárd ki ezt a variációt minden kategória mennyiségi szabályából."

#: includes/admin/class-wc-min-max-quantities-admin.php:760
#: includes/admin/class-wc-min-max-quantities-admin.php:789
msgid "Minimum Quantity"
msgstr "Minimális mennyiség"

#: includes/admin/class-wc-min-max-quantities-admin.php:762
#: includes/admin/class-wc-min-max-quantities-admin.php:792
msgid "Enter a minimum required quantity for products in this category."
msgstr "Add meg a kategóriába tartozó termékek kötelező minimális mennyiségét."

#: includes/admin/class-wc-min-max-quantities-admin.php:765
#: includes/admin/class-wc-min-max-quantities-admin.php:796
msgid "Maximum Quantity"
msgstr "Maximális mennyiség"

#: includes/admin/class-wc-min-max-quantities-admin.php:767
#: includes/admin/class-wc-min-max-quantities-admin.php:799
msgid "Enter a maximum required quantity for products in this category."
msgstr "Add meg a kategóriába tartozó termékek kötelező maximális mennyiségét."

#: includes/admin/class-wc-min-max-quantities-admin.php:772
#: includes/admin/class-wc-min-max-quantities-admin.php:806
msgid ""
"Enter a value to require customers to purchase products from this category "
"in multiples."
msgstr "Adj meg egy értéket, hogy a vásárlók a kategóriába tartozó termékekből csak ennek többszöröseit vásárolhassák meg."

#: includes/admin/class-wc-min-max-quantities-admin.php:850
msgid ""
"The <strong>Group of</strong> value of this category could not be saved. "
"Please enter a positive number, or leave the <strong>Group of</strong> field"
" empty."
msgstr "A kategóriához tartozó <strong>csoportméret</strong> mező értékét nem sikerült menteni. Adj meg egy pozitív számot, vagy hagyd üresen a <strong>csoportméret</strong> mezőt."

#: includes/admin/class-wc-min-max-quantities-admin.php:857
msgid ""
"The <strong>Minimum Quantity</strong> value of this category could not be "
"saved. Please enter a positive number, or leave the <strong>Minimum "
"Quantity</strong> field empty."
msgstr "A kategória <strong>Minimális mennyiség</strong> mezőjének értékét nem sikerült menteni. Adj meg egy pozitív számot, vagy hagyd üresen a <strong>Minimális mennyiség</strong> mezőt."

#: includes/admin/class-wc-min-max-quantities-admin.php:864
msgid ""
"The <strong>Maximum Quantity</strong> value of this category could not be "
"saved. Please enter a positive number, or leave the <strong>Maximum "
"Quantity</strong> field empty."
msgstr "A kategória <strong>Maximális mennyiség</strong> mezőjének értékét nem sikerült menteni. Adj meg egy pozitív számot, vagy hagyd üresen a <strong>Maximális mennyiség</strong> mezőt."

#: includes/admin/class-wc-min-max-quantities-admin.php:871
msgid ""
"The <strong>Maximum Quantity</strong> value of this category could not be "
"saved. Please enter a positive number equal to or higher than the "
"<strong>Minimum Quantity</strong>, or leave the <strong>Maximum "
"Quantity</strong> field empty for an unlimited maximum quantity."
msgstr "A kategória <strong>Maximális mennyiség</strong> mezőjének értékét nem sikerült menteni. Adj meg a <strong>Minimális mennyiség</strong> értékével megegyező vagy annál nagyobb pozitív számot, vagy hagyd üresen a <strong>Maximális mennyiség</strong> mezőt a korlátlan maximális mennyiség beállításához."

#: includes/admin/class-wc-min-max-quantities-admin.php:886
msgid ""
"The <strong>Minimum Quantity</strong> value of this category could not be "
"saved. It must be a multiple of the <strong>Group of</strong> field."
msgstr "A kategória <strong>Minimális mennyiség</strong> mezőjének értékét nem sikerült menteni. Ennek a <strong>csoportméret</strong> mezőben megadott érték többszörösének kell lennie."

#: includes/admin/class-wc-min-max-quantities-admin.php:897
msgid ""
"The <strong>Maximum Quantity</strong> value of this category could not be "
"saved. It must be a multiple of the <strong>Group of</strong> field."
msgstr "A kategória <strong>Maximális mennyiség</strong> mezőjének értékét nem sikerült menteni. Ennek a <strong>csoportméret</strong> mezőben megadott érték többszörösének kell lennie."

