#. Plugin Name of the plugin
#: jet-form-builder-drag-and-drop-file-upload.php
#: jet-form-builder-drag-and-drop-file-upload.php:88
#: jet-form-builder-drag-and-drop-file-upload.php:103
msgid "JetFormBuilder Drag and Drop File Upload"
msgstr "JetFormBuilder fogd és vidd fájlfeltöltés"

#. Plugin URI of the plugin
#: jet-form-builder-drag-and-drop-file-upload.php
msgid "https://jetformbuilder.com/addons/drag-and-drop-file-upload/"
msgstr "https://jetformbuilder.com/addons/drag-and-drop-file-upload/"

#. Description of the plugin
#: jet-form-builder-drag-and-drop-file-upload.php
msgid ""
"Adds drag and drop file upload capabilities for JetFormBuilder. This plugin "
"enhances file management and provides additional file-related features."
msgstr "Fogd és vidd fájlfeltöltési lehetőségeket ad a JetFormBuilderhez. Ez a bővítmény fejleszti a fájlkezelést, és további, fájlokkal kapcsolatos funkciókat biztosít."

#. Author of the plugin
#: jet-form-builder-drag-and-drop-file-upload.php
msgid "Crocoblock"
msgstr "crocoblock"

#. Author URI of the plugin
#: jet-form-builder-drag-and-drop-file-upload.php
msgid "https://crocoblock.com/"
msgstr "https://crocoblock.com/"

#: includes/ajax-handler.php:47
msgid "Security check failed"
msgstr "A biztonsági ellenőrzés sikertelen"

#: includes/ajax-handler.php:55
msgid "Instant upload requires authentication and proper permissions"
msgstr "Az azonnali feltöltéshez hitelesítés és megfelelő jogosultságok szükségesek"

#: includes/ajax-handler.php:65
msgid "Upload failed"
msgstr "A feltöltés sikertelen"

#: includes/ajax-handler.php:146
msgid "Invalid file"
msgstr "Hibás fájl"

#: includes/ajax-handler.php:227
msgid "File saving is disabled for this field"
msgstr "A fájlok mentése ki van kapcsolva ennél a mezőnél"

#. translators: %s is the file extension
#: includes/ajax-handler.php:440
#, php-format
msgid ""
"File extension \"%s\" is not recognized. Please ensure the file type is "
"allowed."
msgstr "A(z) „%s” fájlkiterjesztés nem ismert. Ellenőrizd, hogy engedélyezett-e ez a fájltípus."

#. translators: %1$s is the file MIME type, %2$s is the list of allowed types
#: includes/ajax-handler.php:464
#, php-format
msgid "File type \"%1$s\" is not allowed. Allowed types: %2$s"
msgstr "A(z) „%1$s” fájltípus nem engedélyezett. Engedélyezett típusok: %2$s"

#: includes/blocks/advanced-media-field-block.php:90
#: includes/blocks/advanced-media-field-block.php:414
#: includes/blocks/advanced-media-field-block.php:632
msgid "This field is required. Please upload or select at least one file."
msgstr "Ez a mező kötelező. Tölts fel vagy válassz ki legalább egy fájlt."

#. translators: %s is the maximum number of files allowed
#: includes/blocks/advanced-media-field-block.php:92
#: includes/blocks/advanced-media-field-block.php:406
#: includes/blocks/advanced-media-field-block.php:650
#, php-format
msgid "Maximum %s files allowed"
msgstr "Legfeljebb %s fájl engedélyezett"

#: includes/blocks/advanced-media-field-block.php:401
msgid "File type is not allowed"
msgstr "A fájltípus nem engedélyezett"

#: includes/blocks/advanced-media-field-block.php:402
msgid "File already exist"
msgstr "A fájl már létezik"

#. translators: %s is the file size in MB
#: includes/blocks/advanced-media-field-block.php:404
#, php-format
msgid "File size exceeds %sMB limit"
msgstr "A fájl mérete meghaladja a %s MB-os korlátot"

#. translators: %s is the maximum number of files allowed
#: includes/blocks/advanced-media-field-block.php:408
#, php-format
msgid "Maximum %s files allowed."
msgstr "Legfeljebb %s fájl engedélyezett."

#. translators: %s is the list of rejected files
#: includes/blocks/advanced-media-field-block.php:410
#, php-format
msgid "File(s) was rejected: %s"
msgstr "Elutasított fájl(ok): %s"

#: includes/blocks/advanced-media-field-block.php:411
#, php-format
msgid "File '%s' was rejected: %s"
msgstr "A(z) „%s” fájl elutasítva: %s"

#: includes/blocks/advanced-media-field-block.php:412
msgid "Please wait, files are still uploading..."
msgstr "Várj, a fájlok feltöltése még folyamatban van..."

#: includes/blocks/advanced-media-field-block.php:413
msgid "File reading timeout"
msgstr "Fájlbeolvasási időtúllépés"

#: includes/blocks/advanced-media-field-parser.php:71
msgid ""
"Guest users are not allowed to use this field. Please log in to continue."
msgstr "Vendégfelhasználók nem használhatják ezt a mezőt. A folytatáshoz jelentkezz be."

#: includes/blocks/advanced-media-field-parser.php:81
msgid "You do not have permission to use this field."
msgstr "Nincs jogosultságod ennek a mezőnek a használatához."

#: includes/blocks/advanced-media-field-parser.php:106
msgid "Instant upload requires user authentication"
msgstr "Az azonnali feltöltéshez felhasználói hitelesítés szükséges"

#: includes/blocks/manager.php:113
msgid "Any registered user"
msgstr "Bármely regisztrált felhasználó"

#: includes/blocks/manager.php:117
msgid "Any user who is allowed to upload files"
msgstr "Bármely felhasználó, aki feltölthet fájlokat"

#: includes/blocks/manager.php:121
msgid "Any user who is allowed to edit posts"
msgstr "Bármely felhasználó, aki szerkesztheti a bejegyzéseket"

#: includes/blocks/manager.php:125
msgid "Any user (incl. Guest)"
msgstr "Bármely felhasználó (vendégeket is beleértve)"

#: includes/blocks/manager.php:131
msgid "Attachment ID"
msgstr "Melléklet ID"

#: includes/blocks/manager.php:135
msgid "Attachment URL"
msgstr "Csatolmány URL-je"

#: includes/blocks/manager.php:139
msgid "Array with attachment ID and URL"
msgstr "Csatolmány-ID-t és URL-t tartalmazó tömb"

#: includes/blocks/manager.php:143
msgid "Array of attachment IDs"
msgstr "Csatolmány-ID-k tömbje"

#: includes/styles/blocks-style-manager/migrator/ui.php:43
#: includes/styles/blocks-style-manager/migrator/ui.php:59
#: includes/styles/blocks-style-manager/migrator/ui.php:106
msgid "The link is expired. Please reload the page and try again."
msgstr "A link lejárt. Töltsd újra az oldalt, és próbáld meg újra."

#: includes/styles/blocks-style-manager/migrator/ui.php:65
msgid "Migration process is not completed or already cleaned up."
msgstr "Az áttelepítési folyamat még nem fejeződött be, vagy az adatok törlése már megtörtént."

#: includes/styles/blocks-style-manager/migrator/ui.php:91
msgid ""
"Legacy data cleaned up successfully. You can now deactivate the "
"JetStyleManager plugin to optimize your website performance."
msgstr "A régi adatok törlése sikerült. Most kikapcsolhatod a JetStyleManager bővítményt a honlapod teljesítményének optimalizálásához."

#: includes/styles/blocks-style-manager/migrator/ui.php:116
msgid "No more posts to migrate."
msgstr "Nincs több áttelepítendő bejegyzés."

#. translators: %d is the number of migrated posts
#: includes/styles/blocks-style-manager/migrator/ui.php:144
#, php-format
msgid "Migrated %d posts successfully. Migration completed."
msgstr "Sikeresen áttelepítettünk %d bejegyzést. Az áttelepítés befejeződött."

#. translators: %d is the number of migrated posts
#: includes/styles/blocks-style-manager/migrator/ui.php:156
#, php-format
msgid "Migrated %d posts successfully."
msgstr "Sikeresen áttelepítettünk %d bejegyzést."

#: includes/styles/blocks-style-manager/migrator/ui.php:170
#: includes/styles/blocks-style-manager/migrator/ui.php:201
#: includes/styles/blocks-style-manager/migrator/ui.php:211
msgid "JetStyleManager Migration"
msgstr "JetStyleManager áttelepítése"

#: includes/styles/blocks-style-manager/migrator/ui.php:171
msgid "Migration"
msgstr "Áttelepítés"

#: includes/styles/blocks-style-manager/migrator/ui.php:184
msgid "You do not have sufficient permissions to access this page."
msgstr "Nincs megfelelő jogosultságod az oldal eléréséhez."

#: includes/styles/blocks-style-manager/migrator/ui.php:190
msgid "Please note:"
msgstr "Vedd figyelembe:"

#. translators: %1$s is the opening link tag, %2$s is the closing link tag
#: includes/styles/blocks-style-manager/migrator/ui.php:193
#, php-format
msgid ""
" The new Styles Manager uses fonts installed on your website. You can "
"%1$smanage these fonts here%2$s."
msgstr "Az új stíluskezelő a honlapodra telepített betűtípusokat használja. %1$sItt kezelheted ezeket a betűtípusokat%2$s."

#: includes/styles/blocks-style-manager/migrator/ui.php:202
msgid ""
"Migration process is already completed. You can now deactivate the "
"JetStyleManager plugin to optimize your website performance."
msgstr "Az áttelepítési folyamat már befejeződött. Most kikapcsolhatod a JetStyleManager bővítményt a honlapod teljesítményének optimalizálásához."

#: includes/styles/blocks-style-manager/migrator/ui.php:212
msgid ""
"This page allows you to migrate your styling settings to the new Style "
"Manager module."
msgstr "Ezen az oldalon áttelepítheted a stílusbeállításaidat az új stíluskezelő modulba."

#: includes/styles/blocks-style-manager/migrator/ui.php:224
msgid ""
"Migration process is completed. Please check your content. If everything is "
"ok, you can click the button below to remove the legacy data and than "
"deactive JetStyleManager plugin."
msgstr "Az áttelepítési folyamat befejeződött. Ellenőrizd a tartalmaidat. Ha minden rendben van, az alábbi gombra kattintva törölheted a régi adatokat, majd kikapcsolhatod a JetStyleManager bővítményt."

#: includes/styles/blocks-style-manager/migrator/ui.php:228
msgid "Cleanup Legacy Data"
msgstr "Régi adatok törlése"

#: includes/styles/blocks-style-manager/migrator/ui.php:230
msgid ""
"If something went wrong click the button below to rollback to the legacy "
"JetStyleManager."
msgstr "Ha valami nem sikerült, kattints az alábbi gombra, hogy visszaállj a régi JetStyleManagerre."

#: includes/styles/blocks-style-manager/migrator/ui.php:232
msgid "Rollback to legacy JetStyleManager"
msgstr "Visszaállás a régi JetStyleManagerre"

#: includes/styles/blocks-style-manager/migrator/ui.php:238
msgid ""
"Click the button below to start the migration process. After migration, you "
"can deactivate the JetStyleManager plugin to optimize your website "
"performance."
msgstr "Az áttelepítés elindításához kattints az alábbi gombra. Az áttelepítés után kikapcsolhatod a JetStyleManager bővítményt a honlapod teljesítményének optimalizálásához."

#. translators: %d is the total number of posts to migrate
#: includes/styles/blocks-style-manager/migrator/ui.php:245
#, php-format
msgid "Total posts to migrate: %d"
msgstr "Áttelepítendő bejegyzések összesen: %d"

#: includes/styles/blocks-style-manager/migrator/ui.php:249
msgid "Start Migration"
msgstr "Áttelepítés indítása"

#: includes/styles/blocks-style-manager/migrator/ui.php:253
msgid ""
"No posts to migrate. You can just disable an old JetStyleManager plugin and "
"use the new functionality."
msgstr "Nincs áttelepítendő bejegyzés. Kikapcsolhatod a régi JetStyleManager bővítményt, és használhatod az új funkciókat."

#: includes/styles/blocks-style-manager/migrator/ui.php:288
msgid ""
"Are you sure you want to start the migration? This process cannot be undone."
msgstr "Biztosan el szeretnéd indítani az áttelepítést? Ez a folyamat nem vonható vissza."

#: includes/styles/blocks-style-manager/migrator/ui.php:365
msgid "Are you sure you want to clean up the legacy data?"
msgstr "Biztosan szeretnéd törölni a régi adatokat?"

#: includes/styles/blocks-style-manager/migrator/ui.php:432
msgid ""
"JetStyleManager as a separate plugin is replaced with a built-in Style "
"Manager module for the plugins where it supported. You can migrate your "
"styling settings to the new style management module and deactivate "
"JetStyleManager plugin to optimize your website performance."
msgstr "A JetStyleManager különálló bővítményt az azt támogató bővítményekben beépített stíluskezelő modul váltja fel. Áttelepítheted a stílusbeállításaidat az új stíluskezelő modulba, majd kikapcsolhatod a JetStyleManager bővítményt, hogy optimalizáld a honlapod teljesítményét."

#: includes/styles/blocks-style-manager/migrator/ui.php:433
msgid "Go to Migration Page"
msgstr "Tovább az áttelepítési oldalra"

#: jet-form-builder-drag-and-drop-file-upload.php:89
msgid "requires JetFormBuilder plugin to be installed and activated."
msgstr "A JetFormBuilder bővítmény telepítése és bekapcsolása szükséges."

#. translators: %1$s is the required version, %2$s is the current version
#: jet-form-builder-drag-and-drop-file-upload.php:106
#, php-format
msgid "requires JetFormBuilder version %1$s or higher. Current version: %2$s"
msgstr "A JetFormBuilder %1$s vagy újabb verziója szükséges. Aktuális verzió: %2$s"

#: templates/advanced-media-field.php:82
msgid "Configuration Error:"
msgstr "Konfigurációs hiba:"

#: templates/advanced-media-field.php:83
msgid ""
"Please enable at least one upload method: Drag and Drop UI or WP Media "
"Library."
msgstr "Kapcsold be legalább az egyik feltöltési módot: a fogd és vidd felületet vagy a WP médiatárat."

