#. Plugin Name of the plugin
#: woocommerce-account-funds.php:3
msgid "Account Funds for WooCommerce"
msgstr "Számlaegyenleg a WooCommerce-hez"

#. Plugin URI of the plugin
#: woocommerce-account-funds.php:4
msgid "https://woocommerce.com/products/account-funds/"
msgstr "https://woocommerce.com/products/account-funds/"

#. Description of the plugin
#: woocommerce-account-funds.php:5
msgid ""
"Allow customers to deposit funds into their accounts and pay with account "
"funds during checkout."
msgstr "Engedélyezd a vásárlóknak, hogy befizessenek az egyenlegükre, és a pénztárnál az egyenlegükkel fizessenek."

#. Author of the plugin
#: woocommerce-account-funds.php:6
msgid "Kestrel"
msgstr "Kestrel"

#. Author URI of the plugin
#: woocommerce-account-funds.php:7
msgid "http://kestrelwp.com"
msgstr "http://kestrelwp.com"

