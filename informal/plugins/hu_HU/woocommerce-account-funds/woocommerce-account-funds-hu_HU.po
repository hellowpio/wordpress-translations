#: src/Admin/Screens/Store_Credit/Cashback_Screen.php:229
msgid ""
"The order must reach this value (after discounts, before tax and shipping) "
"to qualify for cashback."
msgstr "A rendelésnek el kell érnie ezt az értéket (kedvezmények után, adó és szállítás előtt), hogy jogosult legyen pénzvisszatérítésre."

#: src/Admin/Screens/Store_Credit/Cashback_Screen.php:230
