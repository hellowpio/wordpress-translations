#: src/Admin/Screens/Store_Credit/Cashback_Screen.php:246
msgid "Award cashback only if the order total is less than this amount."
msgstr "Csak akkor adj pénzvisszatérítést, ha a rendelés végösszege kisebb ennél az összegnél."

#: src/Admin/Screens/Store_Credit/Cashback_Screen.php:247
