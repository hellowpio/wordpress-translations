#. translators: %s and %s are HTML tags.
#: class/mainwp-wordfence-firewall.class.php:97
#, php-format
msgid ""
"We recommend whitelisting your Dashboard and your IP before making "
"changes%1$sDashboard IP: %2$sYour IP:%3$s"
msgstr "Javasoljuk, hogy a módosítások előtt helyezd engedélyezési listára a vezérlőpultod IP-címét és a saját IP-címedet%1$sVezérlőpult IP-címe: %2$sAz IP-címed:%3$s"

#. translators: %s and %s are HTML tags.
#: class/mainwp-wordfence-firewall.class.php:113
#, php-format
msgid ""
"Separate multiple IP's with commas. You can specify ranges using the "
"following format: 123.23.34.[1-50]%1$sWordfence automatically whitelists "
"%2$sprivate networks%3$s because these are not routable on the public "
"Internet."
msgstr "Több IP-t vesszővel válassz el. Tartományokat a következő formátumban adhatsz meg: 123.23.34.[1-50]%1$sA Wordfence automatikusan engedélyezési listára veszi a %2$sprivát hálózatokat%3$s, mivel ezek nem irányíthatók a nyilvános interneten."

#: class/mainwp-wordfence-firewall.class.php:136
