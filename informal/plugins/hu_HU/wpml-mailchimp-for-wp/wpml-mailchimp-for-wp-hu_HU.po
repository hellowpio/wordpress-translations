#. Description of the plugin
#: plugin.php
msgid ""
"This 'glue' plugin makes it easier to translate with WPML content provided "
"in MailChimp for WordPress plugin. | <a "
"href=\"https://wpml.org/documentation/wpml-core-and-add-on-"
"plugins/mailchimp-"
"multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=mcml\">Documentation</a>"
msgstr "Ez az összekötő bővítmény megkönnyíti a MailChimp for WordPress bővítményben megadott tartalom WPML-lel történő fordítását. | <a href=\"https://wpml.org/documentation/wpml-core-and-add-on-plugins/mailchimp-multilingual/?utm_source=plugin&utm_medium=gui&utm_campaign=mcml\">dokumentáció</a>"

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "https://wpml.org"
msgstr "https://wpml.org"

#. translators: Warning notice in the WordPress admin, shown when the
#. MailChimp form was duplicated into a language instead of translated. %s:
#. the name of that language. "WPML Translation Management" is a path through
#. the WordPress admin and should read as that screen is named in this
#. language.
#: classes/class-wpml-compatibility-mailchimp-redirection.php:43
#, php-format
msgid ""
"WPML Translation Management > MailChimp Form in %s is duplicated, please "
"translate it separately."
msgstr "WPML Translation Management > A(z) %s helyen található MailChimp-űrlap duplikált, fordítsd le külön."

#. translators: Warning notice in the WordPress admin, shown when the
#. MailChimp form has no translation in the language being viewed. %s: the
#. name of that language. "WPML Translation Management" is a path through the
#. WordPress admin and should read as that screen is named in this language.
#: classes/class-wpml-compatibility-mailchimp-redirection.php:48
#, php-format
msgid "WPML Translation Management > Please translate MailChimp Form to %s."
msgstr "WPML Translation Management > Fordítsd le a MailChimp-űrlapot a(z) %s nyelvre."
