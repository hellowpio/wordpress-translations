{"translation-revision-date":"2026-10-31 19:27+0100","generator":"WP-CLI\/2.12.0","source":"core\/admin-pages\/entries\/settings\/utils.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"hu_HU","plural-forms":"nplurals=2; plural=(n != 1);"},"Firewall":["T\u0171zfal"],"Your site must support SSL.":["A webhelyednek t\u00e1mogatnia kell az SSL-t."],"The '%s' feature flag must be enabled.":["A(z) \u201e%s\u201d funkci\u00f3jelz\u0151nek bekapcsolva kell lennie."],"Multisite must be enabled.":["A Multisite-nak bekapcsolva kell lennie."],"Multisite is not supported.":["A Multisite nem t\u00e1mogatott."],"You must be running PHP version %s or later.":["A PHP %s vagy \u00fajabb verzi\u00f3j\u00e1t kell futtatnod."],"The %s PHP extension is required.":["A(z) %s PHP-kiterjeszt\u00e9s sz\u00fcks\u00e9ges."],"The following PHP extension is required: %l.":["A k\u00f6vetkez\u0151 PHP-kiterjeszt\u00e9s sz\u00fcks\u00e9ges: %l.","A k\u00f6vetkez\u0151 PHP-kiterjeszt\u00e9sek sz\u00fcks\u00e9gesek: %l."],"Loading Kadence Security via an MU-Plugin is not supported.":["A Kadence Security MU-b\u0151v\u00edtm\u00e9nyen kereszt\u00fcli bet\u00f6lt\u00e9se nem t\u00e1mogatott."],"Loading Kadence Security without an MU-Plugin is not supported.":["A Kadence Security MU-b\u0151v\u00edtm\u00e9ny n\u00e9lk\u00fcli bet\u00f6lt\u00e9se nem t\u00e1mogatott."],"Advanced":["Halad\u00f3"],"Login Security":["Bejelentkez\u00e9si biztons\u00e1g"],"Site Check":["Webhelyellen\u0151rz\u00e9s"],"Utilities":["Seg\u00e9dprogramok"],"You must select an IP Detection method in <a>Global Settings<\/a>. <help>Learn more<\/help>.":["Ki kell v\u00e1lasztanod egy IP-\u00e9szlel\u00e9si m\u00f3dszert az <a>\u00e1ltal\u00e1nos be\u00e1ll\u00edt\u00e1sokban<\/a>. <help>tov\u00e1bbi tudnival\u00f3k<\/help>."]}}}