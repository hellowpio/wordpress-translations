#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:206
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run on PHP versions older than %s. Please"
" contact your host and ask them to upgrade."
msgstr "A(z) &#8222;%s&#8221; bővítmény nem futtatható %s-nél régebbi PHP-verzióval. Kérd meg a tárhelyszolgáltatódat a frissítésre."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:209
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run on WordPress versions older than %s. "
"Please update WordPress."
msgstr "A(z) &#8222;%s&#8221; bővítmény nem futtatható %s-nél régebbi WordPress-verzióval. Frissítsd a WordPress-t."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:212
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run on WooCommerce versions older than "
"%s. Please update WooCommerce."
msgstr "A(z) &#8222;%s&#8221; bővítmény nem futtatható %s-nél régebbi WooCommerce-verzióval. Frissítsd a WooCommerce-t."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:215
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run without OpenSSL module version at "
"least %s. Please update OpenSSL module."
msgstr "A(z) &#8222;%s&#8221; bővítmény futtatásához legalább %s verziójú OpenSSL-modul szükséges. Frissítsd az OpenSSL-modult."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:310
#, php-format
msgid ""
"The &#8220;%1$s&#8221; plugin requires at least %2$s version of %3$s to work"
" correctly. Please update it to its latest release."
msgstr "A(z) &#8222;%1$s&#8221; bővítmény megfelelő működéséhez legalább a(z) %3$s %2$s verziója szükséges. Frissítsd a legújabb verzióra."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:416
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run without %s active. Please install and"
" activate %s plugin."
msgstr "A(z) &#8222;%s&#8221; bővítmény futtatásához aktív %s szükséges. Telepítsd és kapcsold be a(z) %s bővítményt."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:468
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin requires free %s plugin. <a href=\"%s\">Install "
"%s</a>"
msgstr "A(z) &#8222;%s&#8221; bővítményhez az ingyenes %s bővítmény szükséges. <a href=\"%s\">A(z) %s telepítése</a>"

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:474
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin requires activating %s plugin. <a "
"href=\"%s\">Activate %s</a>"
msgstr "A(z) &#8222;%s&#8221; bővítményhez be kell kapcsolnod a(z) %s bővítményt. <a href=\"%s\">A(z) %s bekapcsolása</a>"

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:516
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run without %s PHP module installed. "
"Please contact your host and ask them to install %s."
msgstr ""
"A(z) &#8220;%s&#8221; bővítmény futtatásához telepíteni kell a(z) %s PHP-"
"modult. Kérd meg a tárhelyszolgáltatódat a(z) %s telepítésére."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker.php:541
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin cannot run without %s PHP setting set to %s. "
"Please contact your host and ask them to set %s."
msgstr "A(z) &#8220;%s&#8221; bővítmény futtatásához a(z) %s PHP-beállítás értéke legyen %s. Kérd meg a tárhelyszolgáltatódat, hogy állítsa be a(z) %s értékét."

#: vendor_prefixed/wpdesk/wp-basic-requirements/src/Basic_Requirement_Checker_With_Update_Disable.php:29
#, php-format
msgid ""
"The &#8220;%s&#8221; plugin is temporarily disabled since the required %s "
"plugin is being upgraded."
msgstr ""
"A(z) &#8220;%s&#8221; bővítmény átmenetileg ki van kapcsolva, mert a "
"szükséges %s bővítmény frissítése folyamatban van."

