msgstr "Válassz háttérszínt az összecsukható almenük ikonjához."

#: includes/modules/divi-menu-module.php:185
msgid "Close Mobile Menu By Clicking Outside Dropdown"
msgstr "Mobilmenü bezárása a legördülőn kívülre kattintva"

#: includes/modules/divi-menu-module.php:187
#: includes/setup/theme-options.php:567
msgid ""
