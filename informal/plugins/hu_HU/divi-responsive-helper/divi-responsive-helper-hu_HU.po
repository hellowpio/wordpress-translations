#: includes/modules/divi-menu-module.php:125
msgid "Collapse Mobile Menu Submenus"
msgstr "Mobilmenü almenüinek összecsukása"

#: includes/modules/divi-menu-module.php:127
#: includes/setup/theme-options.php:530
