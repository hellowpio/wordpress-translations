#: integrations/formatter/includes/tags.php:33
msgid ""
"Rounds a number, replace \"VALUE\" by the value of your choice. Replace "
"\"ROUND\" by the round of your choice, accepts INT, 1DECIMAL, 2DECIMALS, "
"ROUND_UP and ROUND_DOWN. By default rounds to INT."
msgstr "Kerekít egy darabszámot. Cseréld le a „VALUE” szöveget az általad választott értékre. Cseréld le a „ROUND” szöveget az általad választott kerekítési módra; a következő értékek fogadhatók el: INT, 1DECIMAL, 2DECIMALS, ROUND_UP és ROUND_DOWN. Alapértelmezés szerint egész számra kerekít."

#: integrations/formatter/includes/tags.php:37
msgid "Floor"
msgstr "Alsó egészrész"

#: integrations/formatter/includes/tags.php:39
msgid ""
"Rounds a number to the next lowest integer value (eg: 4.3 to 4), replace "
"\"VALUE\" by the value of your choice."
msgstr "A darabszámot a következő kisebb egész számra kerekíti (pl. 4,3 → 4); cseréld le a „VALUE” szöveget az általad választott értékre."

#: integrations/formatter/includes/tags.php:43
msgid "Ceil"
msgstr "Felső egészrész"

#: integrations/formatter/includes/tags.php:45
msgid ""
"Rounds a number to the next highest integer value (eg: 4.3 to 5), replace "
"\"VALUE\" by the value of your choice."
msgstr "A számot a következő nagyobb egész számra kerekíti (pl. 4,3 → 5); a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:49
msgid "Remove HTML"
msgstr "HTML eltávolítása"

#: integrations/formatter/includes/tags.php:51
