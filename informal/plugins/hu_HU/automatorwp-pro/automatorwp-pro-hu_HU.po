"Remove HTML tags from a value, replace \"VALUE\" by the value of your "
"choice."
msgstr "Eltávolítja a HTML-címkéket az értékből; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:55
msgid "Trim"
msgstr "Levágás"

#: integrations/formatter/includes/tags.php:57
msgid ""
"Remove whitespace, tabs and line breaks from the beginning and end of a "
"value, replace \"VALUE\" by the value of your choice."
msgstr "Eltávolítja a szóközöket, tabulátorokat és sortöréseket egy érték elejéről és végéről; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:63
msgid "Format to lowercase, replace \"VALUE\" by the value of your choice."
msgstr "Alakítsd kisbetűssé az értéket; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:69
msgid "Format to uppercase, replace \"VALUE\" by the value of your choice."
msgstr "Alakítsd nagybetűssé az értéket; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:75
msgid ""
"Capitalize the first letter of a value, replace \"VALUE\" by the value of "
"your choice."
msgstr "Egy érték első betűjét alakítsd nagybetűssé; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:79
