"Capitalize the first letter of each word of a value, replace \"VALUE\" by "
"the value of your choice."
msgstr "Egy érték minden szavának első betűjét alakítsd nagybetűssé; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:87
msgid "Reverse a value, replace \"VALUE\" by the value of your choice."
msgstr "Fordítsd meg az értéket; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:93
msgid ""
"Shuffle all the characters of a value, replace \"VALUE\" by the value of "
"your choice."
msgstr "Keverd össze egy érték összes karakterét; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:99
msgid ""
"Shuffle all words of a value, replace \"VALUE\" by the value of your choice."
msgstr "Keverd össze egy érték összes szavát; a „VALUE” helyére írd be a kívánt értéket."

#: integrations/formatter/includes/tags.php:105
msgid "Slugify a value, replace \"VALUE\" by the value of your choice."
msgstr "Készíts slugot az értékből; a „VALUE” helyére írd be a kívánt értéket."

