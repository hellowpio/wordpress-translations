#: includes/data/eu-vat-number-settings.php:30
msgid "EU VAT Number Handling"
msgstr "EU-áfaszám kezelése"

#: includes/data/eu-vat-number-settings.php:34
msgid "VAT Number Field Label"
msgstr "Áfaszám mező címkéje"

#: includes/data/eu-vat-number-settings.php:35
msgid "The label that appears at checkout for the VAT number field."
msgstr "A pénztárnál az áfaszám mezőjénél megjelenő címke."

