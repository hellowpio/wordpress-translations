msgstr "[link]Ismerd meg, hogyan javíthatod ezt a hibát és állíthatod vissza a működést[/link]"

#: lib/Util/Notices/InactiveSubscribersNotice.php:61
msgid "Go to the Advanced Settings"
msgstr "Ugrás a haladó beállításokhoz"

