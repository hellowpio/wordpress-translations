#: lib/Util/Notices/SenderDomainAuthenticationNotices.php:107
#, php-format
msgid ""
"<strong>Update your sender email address to a branded domain to continue sending your campaigns.</strong>\n"
"<span>MailPoet can no longer send from email addresses on shared 3rd party domains like <strong>%1$s</strong>. Please change your campaigns to send from an email address on your site's branded domain. Your existing scheduled and active emails will temporarily be sent from <strong>%2$s</strong>.</span> <p>%3$s &nbsp; %4$s</p>"
msgstr "<strong>Frissítsd a feladó e-mail-címedet saját domainre a kampányaid további küldéséhez.</strong>\n<span>A MailPoet már nem tud e-maileket küldeni megosztott, harmadik féltől származó domainekről, mint például <strong>%1$s</strong>. Állítsd át a kampányaidat úgy, hogy a webhelyed saját domainjéhez tartozó e-mail-címről küldjék őket. A meglévő ütemezett és aktív e-maileket ideiglenesen a következő címről küldjük: <strong>%2$s</strong>.</span> <p>%3$s &nbsp; %4$s</p>"

#: lib/Util/Notices/SenderDomainAuthenticationNotices.php:118
#, php-format
msgid ""
"<strong>Your newsletters and post notifications have been paused. Update your sender email address to a branded domain to continue sending your campaigns.</strong>\n"
"<span>MailPoet can no longer send from email addresses on shared 3rd party domains like <strong>%1$s</strong>. Please change your campaigns to send from an email address on your site's branded domain. Your marketing automations and transactional emails will temporarily be sent from <strong>%2$s</strong>.</span> <p>%3$s &nbsp; %4$s</p>"
msgstr "<strong>A hírleveleid és bejegyzésértesítéseid küldése szünetel. A kampányaid további küldéséhez frissítsd a feladó e-mail-címedet saját domainre.</strong>\n<span>A MailPoet már nem tud e-maileket küldeni megosztott, harmadik féltől származó domainekről, mint például <strong>%1$s</strong>. Állítsd át a kampányaidat úgy, hogy a webhelyed saját domainjéhez tartozó e-mail-címről küldjék őket. A marketingautomatizálásokat és tranzakciós e-maileket ideiglenesen a következő címről küldjük: <strong>%2$s</strong>.</span> <p>%3$s &nbsp; %4$s</p>"

#: lib/Util/Notices/SenderDomainAuthenticationNotices.php:131
#, php-format
msgid ""
"<strong>Authenticate your sender domain to improve email delivery rates.</strong>\n"
"<span>Major mailbox providers require you to authenticate your sender domain to confirm you sent the emails, and may place unauthenticated emails in the “Spam” folder. Please authenticate your sender domain to ensure your marketing campaigns are compliant and will reach your contacts.</span><p>%1$s &nbsp; %2$s</p>"
msgstr "<strong>Hitelesítsd a feladói domainedet az e-mailek kézbesítési arányának javításához.</strong>\n<span>A nagy levelezőszolgáltatók megkövetelik a feladó domained hitelesítését annak megerősítésére, hogy te küldted az e-maileket, a nem hitelesített e-maileket pedig a „Spam” mappába helyezhetik. Hitelesítsd a feladó domainedet, hogy a marketingkampányaid megfeleljenek az előírásoknak, és eljussanak a címzettekhez.</span><p>%1$s &nbsp; %2$s</p>"

#: lib/Util/Notices/SenderDomainAuthenticationNotices.php:141
#, php-format
msgid ""
"<strong>Authenticate your sender domain to send new emails.</strong>\n"
"      <span>Major mailbox providers require you to authenticate your sender domain to confirm you sent the emails, and may place unauthenticated emails in the “Spam” folder. Please authenticate your sender domain to ensure your marketing campaigns are compliant and will reach your contacts. Your existing scheduled and active emails will temporarily be sent from <strong>%1$s</strong>.</span> <p>%2$s &nbsp; %3$s</p>"
msgstr "<strong>Hitelesítsd a feladói domainedet új e-mailek küldéséhez.</strong>\n      <span>A nagy levelezőszolgáltatók megkövetelik a feladó domained hitelesítését annak megerősítésére, hogy te küldted az e-maileket, a nem hitelesített e-maileket pedig a „Spam” mappába helyezhetik. Hitelesítsd a feladó domainedet, hogy a marketingkampányaid megfeleljenek az előírásoknak, és eljussanak a címzettekhez. A meglévő ütemezett és aktív e-maileket ideiglenesen a következő címről küldjük: <strong>%1$s</strong>.</span> <p>%2$s &nbsp; %3$s</p>"

#: lib/Util/Notices/SenderDomainAuthenticationNotices.php:151
#, php-format
msgid ""
"<strong>Your newsletters and post notifications have been paused. Authenticate your sender domain to continue sending.</strong>\n"
"<span>Major mailbox providers require you to authenticate your sender domain to confirm you sent the emails, and may place unauthenticated emails in the “Spam” folder. Please authenticate your sender domain to ensure your marketing campaigns are compliant and will reach your contacts. Your marketing automations and transactional emails will temporarily be sent from <strong>%1$s</strong>.</span> <p>%2$s &nbsp; %3$s</p>"
msgstr "<strong>A hírleveleid és bejegyzésértesítéseid küldése szünetel. A küldés folytatásához hitelesítsd a feladói domainedet.</strong>\n<span>A nagy levelezőszolgáltatók megkövetelik a feladó domained hitelesítését annak megerősítésére, hogy te küldted az e-maileket, a nem hitelesített e-maileket pedig a „Spam” mappába helyezhetik. Hitelesítsd a feladó domainedet, hogy a marketingkampányaid megfeleljenek az előírásoknak, és eljussanak a címzettekhez. A marketingautomatizálásokat és tranzakciós e-maileket ideiglenesen a következő címről küldjük: <strong>%1$s</strong>.</span> <p>%2$s &nbsp; %3$s</p>"

