#: lib/Util/Notices/InactiveSubscribersNotice.php:65
#, php-format
msgid ""
"Good news! MailPoet won’t send emails to your %s inactive subscribers. This "
"is a standard practice to maintain good deliverability and open rates. But "
"if you want to disable it, you can do so in settings. [link]Read "
"more.[/link]"
msgstr ""

#. translators: %1$s is the site environment type, for example "staging" or
#. "local".
#: lib/Util/Notices/NonProductionSendingNotice.php:71
#, php-format
msgid "MailPoet isn’t sending emails because this is a %1$s site."
msgstr "A MailPoet nem küld e-maileket, mert ez egy %1$s webhely."

#: lib/Util/Notices/NonProductionSendingNotice.php:74
msgid ""
"Newsletters, post notifications, automation emails and bulk confirmation "
"resends wait in the queue. Sign-up confirmations, test emails, WordPress and"
" WooCommerce emails, and the Premium “Send notification email” automation "
"step still go out. Everything waiting in the queue goes out once sending is "
"on."
msgstr "A hírlevelek, bejegyzésértesítések, automatizálási e-mailek és a megerősítő e-mailek tömeges újraküldése a várólistán marad. A feliratkozást megerősítő e-mailek, a teszt-e-mailek, a WordPress- és WooCommerce-e-mailek, valamint a Premium „Értesítő e-mail küldése” automatizálási lépéséből küldött e-mailek továbbra is eljutnak a címzettekhez. A várólistán várakozó összes e-mailt a rendszer elküldi, amint a küldés be van kapcsolva."

#: lib/Util/Notices/NonProductionSendingNotice.php:78
msgid ""
"If this is your live site, turn sending on. You can change this later in "
"Settings › Advanced."
msgstr "Ha ez az éles webhelyed, kapcsold be a küldést. Ezt később a Beállítások › Haladó menüpontban módosíthatod."

#: lib/Util/Notices/NonProductionSendingNotice.php:81
msgid "If this is your live site, ask an administrator to turn sending on."
msgstr "Ha ez az éles webhelyed, kérj meg egy adminisztrátort, hogy kapcsolja be a küldést."

#: lib/Util/Notices/NonProductionSendingNotice.php:97
msgid "Turn sending on"
msgstr "Küldés bekapcsolása"

#: lib/Util/Notices/PendingApprovalNotice.php:43
msgid "MailPoet is [link]reviewing your subscription[/link]."
msgstr "A MailPoet [link]felülvizsgálja az előfizetésedet[/link]."

#. translators: %s is the email subject, which will always be in English
#: lib/Util/Notices/PendingApprovalNotice.php:57
#, php-format
msgid ""
"You can use all MailPoet features and send [link1]email previews[/link1] to "
"your [link2]authorized email addresses[/link2], but sending to your email "
"list contacts is temporarily paused until we review your subscription. If "
"you don't hear from us within 48 hours, please check the inbox and spam "
"folders of your MailPoet account email for follow-up emails with the subject"
" \"%s\" and reply, or [link3]contact us[/link3]."
msgstr "Használhatod a MailPoet összes funkcióját, és küldhetsz [link1]e-mail-előnézeteket[/link1] az [link2]engedélyezett e-mail-címekre[/link2], de az e-mail-listádon szereplő címekre történő küldés ideiglenesen szünetel, amíg felülvizsgáljuk az előfizetésedet. Ha 48 órán belül nem kapsz tőlünk választ, ellenőrizd a MailPoet-fiókodhoz tartozó e-mail-cím beérkező leveleit és spam mappáját, keresd az utánkövető e-maileket, amelyek tárgya „%s”, és válaszolj rájuk, vagy [link3]lépj kapcsolatba velünk[/link3]."

#. translators: %1$s is the PHP version the site is running, %2$s is the
#. recommended PHP version
#: lib/Util/Notices/PHPVersionWarnings.php:76
#, php-format
msgid ""
"Your website is running an outdated version of PHP (%1$s), on which MailPoet"
" might stop working in the future. We recommend upgrading to %2$s or "
"greater. Read our [link]simple PHP upgrade guide.[/link]"
msgstr "A webhelyed a PHP egy elavult verzióját (%1$s) futtatja, amelyen a MailPoet a jövőben esetleg nem fog működni. Javasoljuk a %2$s vagy újabb verzióra történő frissítést. Olvasd el az [link]egyszerű PHP-frissítési útmutatónkat.[/link]"

#. translators: %1$s is the PHP version the site is running, %2$s is the date
#. the requirement takes effect, already translated and in the site’s date
#. format (e.g. February 23, 2027), %3$s is the required PHP version, %4$s is
#. the recommended PHP version
#: lib/Util/Notices/PHPVersionWarnings.php:90
#, php-format
msgid ""
"Your website is running PHP %1$s. Starting %2$s, new versions of MailPoet "
"will require PHP %3$s or newer. MailPoet will keep working on this site, but"
" it won’t receive updates, including security fixes. Ask your hosting "
"provider to upgrade PHP. We recommend PHP %4$s. Read our [link]simple PHP "
"upgrade guide.[/link]"
msgstr "A webhelyed PHP %1$s verziót futtat. A %2$s időponttól kezdve a MailPoet új verzióihoz PHP %3$s vagy újabb verzió szükséges. A MailPoet továbbra is működni fog ezen a webhelyen, de nem kap frissítéseket, beleértve a biztonsági javításokat is. Kérd meg a tárhelyszolgáltatódat a PHP frissítésére. A PHP %4$s verziót javasoljuk. Olvasd el az [link]egyszerű PHP-frissítési útmutatónkat.[/link]"

#. translators: %1$s is the PHP version the site is running, %2$s is the date
#. the requirement took effect, already translated and in the site’s date
#. format (e.g. February 23, 2027), %3$s is the required PHP version, %4$s is
#. the recommended PHP version
#: lib/Util/Notices/PHPVersionWarnings.php:93
#, php-format
msgid ""
"Your website is running PHP %1$s. Since %2$s, new versions of MailPoet "
"require PHP %3$s or newer. This site no longer receives MailPoet updates, "
"including security fixes. Ask your hosting provider to upgrade PHP. We "
"recommend PHP %4$s. Read our [link]simple PHP upgrade guide.[/link]"
msgstr "A webhelyed PHP %1$s verziót futtat. A %2$s időpont óta a MailPoet új verzióihoz PHP %3$s vagy újabb verzió szükséges. Ez a webhely már nem kap MailPoet-frissítéseket, beleértve a biztonsági javításokat is. Kérd meg a tárhelyszolgáltatódat a PHP frissítésére. A PHP %4$s verziót javasoljuk. Olvasd el az [link]egyszerű PHP-frissítési útmutatónkat.[/link]"

