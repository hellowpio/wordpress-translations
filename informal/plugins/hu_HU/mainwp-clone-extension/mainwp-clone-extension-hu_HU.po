#. Plugin Name of the plugin
#: mainwp-clone-extension.php
msgid "MainWP Clone Extension"
msgstr "MainWP Clone Extension"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: mainwp-clone-extension.php
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin
#: mainwp-clone-extension.php
msgid ""
"MainWP Clone Extension is an extension for the MainWP plugin that enables "
"you to clone your child sites with no technical knowledge required."
msgstr "A MainWP Clone kiterjesztés a MainWP bővítményhez készült, és lehetővé teszi, hogy technikai ismeretek nélkül klónozd a gyermekwebhelyeidet."

#. Author of the plugin
#: mainwp-clone-extension.php
msgid "MainWP"
msgstr "MainWP"

#: class/MainWPCloneAbilities.class.php:49
msgid "MainWP Clone"
msgstr "MainWP Clone"

#: class/MainWPCloneAbilities.class.php:50
msgid "Abilities for reading and managing bounded MainWP Clone policy state."
msgstr "A korlátozott MainWP Clone-szabályzat állapotának beolvasására és kezelésére szolgáló képességek."

#: class/MainWPCloneAbilities.class.php:67
msgid "Get MainWP Site Clone Policy Status"
msgstr "MainWP-webhely klónozási szabályzata állapotának lekérése"

#: class/MainWPCloneAbilities.class.php:68
msgid ""
"Read the current Dashboard-stored Clone policy for one authorized MainWP "
"site without synchronizing or starting a clone."
msgstr "Az aktuális, vezérlőpulton tárolt klónozási szabályzat beolvasása egy engedélyezett MainWP-webhelyhez, szinkronizálás vagy klónozás indítása nélkül."

#: class/MainWPCloneAbilities.class.php:88
msgid "Set MainWP Clone Feature Enabled"
msgstr "A MainWP Clone funkció bekapcsolása"

#: class/MainWPCloneAbilities.class.php:89
msgid ""
"Enable or disable Dashboard-stored Clone policy; affected Children receive "
"it only on a later successful individual sync."
msgstr "A vezérlőpulton tárolt klónozási szabályzat bekapcsolása vagy kikapcsolása; az érintett gyermekwebhelyek csak egy későbbi, sikeres, egyéni szinkronizáláskor kapják meg."

#: class/MainWPCloneAbilities.class.php:101
msgid "Set MainWP Site Clone Participation"
msgstr "A MainWP-webhely klónozásban való részvételének beállítása"

#: class/MainWPCloneAbilities.class.php:102
msgid ""
"Allow or disallow one authorized site in Dashboard-stored Clone policy "
"without synchronizing or starting a clone."
msgstr "Egy engedélyezett webhely részvételének engedélyezése vagy letiltása a vezérlőpulton tárolt klónozási szabályzatban, szinkronizálás vagy klónozás indítása nélkül."

#: class/MainWPCloneAbilities.class.php:348
msgid "You do not have permission to view Clone policy for this site."
msgstr "Nincs engedélyed megtekinteni a webhely klónozási szabályzatát."

#: class/MainWPCloneAbilities.class.php:361
msgid "You do not have permission to manage this Clone policy."
msgstr "Nincs engedélyed kezelni ezt a klónozási szabályzatot."

#: class/MainWPCloneAbilities.class.php:374
msgid "Site whose Dashboard Clone policy will be read."
msgstr "Az a webhely, amelynek vezérlőpulton tárolt klónozási szabályzatát be kell olvasni."

#: class/MainWPCloneAbilities.class.php:380
msgid ""
"Positive MainWP site ID as an integer or canonical decimal string for GET "
"transport."
msgstr "Pozitív MainWP webhelyazonosító (ID) egész számként vagy kanonikus decimális szövegként GET-adatátvitelhez."

#: class/MainWPCloneAbilities.class.php:396
msgid "Dashboard-stored Clone policy for the authorized site."
msgstr "Az engedélyezett webhely vezérlőpulton tárolt klónozási szabályzata."

#: class/MainWPCloneAbilities.class.php:401
msgid "Authorized MainWP destination site ID."
msgstr "Az engedélyezett MainWP-célwebhely ID-je."

#: class/MainWPCloneAbilities.class.php:406
msgid "Identifies current Dashboard-stored policy as the source."
msgstr "Az aktuális, vezérlőpulton tárolt szabályzatot forrásként azonosítja."

#: class/MainWPCloneAbilities.class.php:410
msgid "Whether the current Dashboard Clone policy is globally enabled."
msgstr "Globálisan be van-e kapcsolva az aktuális vezérlőpult klónozási szabályzata."

#: class/MainWPCloneAbilities.class.php:414
msgid ""
"Whether the current Dashboard policy excludes this destination from "
"receiving Clone choices on a future successful sync."
msgstr "Kizárja-e az aktuális vezérlőpult-szabályzat ezt a célhelyet abból, hogy egy későbbi, sikeres szinkronizáláskor klónozási lehetőségeket kapjon."

#: class/MainWPCloneAbilities.class.php:418
msgid ""
"Whether Dashboard policy permits this destination to receive Clone choices "
"on a future successful sync; this is not clone readiness or applied Child "
"state."
msgstr "Engedélyezi-e a vezérlőpult-szabályzat, hogy ez a célwebhely egy későbbi, sikeres szinkronizáláskor klónozási lehetőségeket kapjon; ez nem a klónozásra való készenlétet és nem is a gyermekwebhelyen alkalmazott állapotot jelenti."

#: class/MainWPCloneAbilities.class.php:423
msgid "Always unknown because this read performs no sync or Child request."
msgstr "Mindig ismeretlen, mert ez a beolvasás nem végez szinkronizálást és nem küld kérést a gyermekwebhelynek."

#: class/MainWPCloneAbilities.class.php:456
msgid "New Dashboard-wide Clone enablement policy."
msgstr "Új, a teljes vezérlőpultra érvényes szabályzat a klónozás bekapcsolására."

#: class/MainWPCloneAbilities.class.php:460
msgid "True to enable Clone in Dashboard policy; false to disable it."
msgstr "Igaz értékkel bekapcsolja a klónozást a vezérlőpult szabályzatában; hamis értékkel kikapcsolja."

#: class/MainWPCloneAbilities.class.php:476
msgid "Verified persisted Dashboard Clone enablement result."
msgstr "A vezérlőpulton tárolt, klónozásra vonatkozó bekapcsolási beállítás ellenőrzött eredménye."

#: class/MainWPCloneAbilities.class.php:481
#: class/MainWPCloneAbilities.class.php:543
msgid "Whether persisted policy bytes changed."
msgstr "Azt jelzi, hogy megváltoztak-e a mentett szabályzat bájtjai."

#: class/MainWPCloneAbilities.class.php:486
msgid "Provenance of the returned desired policy."
msgstr "A visszaadott kívánt szabályzat eredete."

#: class/MainWPCloneAbilities.class.php:490
msgid "Verified persisted global Clone policy."
msgstr "Az ellenőrzött, mentett globális klónozási szabályzat."

#: class/MainWPCloneAbilities.class.php:495
msgid "Child application is not performed or read by this Ability."
msgstr "Ez a képesség nem alkalmazza és nem olvassa be a gyermekwebhelyen érvényes beállítást."

#: class/MainWPCloneAbilities.class.php:511
msgid "One site's desired participation in Dashboard Clone policy."
msgstr "Egy webhely kívánt részvétele a vezérlőpult klónozási szabályzatában."

#: class/MainWPCloneAbilities.class.php:517
msgid "Canonical positive MainWP site ID."
msgstr "Kanonikus, pozitív MainWP-webhely-ID."

#: class/MainWPCloneAbilities.class.php:521
msgid "True to remove the site from the disallowed set; false to add it."
msgstr "Igaz értékkel távolítsd el a webhelyet a tiltottak közül; hamis értékkel add hozzá."

#: class/MainWPCloneAbilities.class.php:536
msgid "Verified persisted per-site Clone policy result."
msgstr "A mentett, webhelyenkénti klónozási szabályzat ellenőrzött eredménye."

#: class/MainWPCloneOperations.class.php:254
msgid "The Clone policy changed concurrently. Retry the request."
msgstr "A klónozási szabályzat időközben megváltozott. Próbáld újra a kérést."

#: class/MainWPCloneOperations.class.php:260
msgid "The Clone policy could not be persisted."
msgstr "A klónozási szabályzat mentése sikertelen."

#: class/MainWPCloneOperations.class.php:273
msgid "A positive integer site ID is required."
msgstr "Pozitív egész számú webhelyazonosító (ID) szükséges."

#: class/MainWPCloneOperations.class.php:286
msgid "The enabled field must be a JSON boolean."
msgstr "Az enabled mező értékének JSON-logikai értéknek kell lennie."

#: class/MainWPCloneOperations.class.php:299
msgid "A positive site ID and a JSON boolean allowed field are required."
msgstr "Pozitív webhely-ID és JSON-logikai értékű allowed mező megadása kötelező."

#: class/MainWPCloneOperations.class.php:312
msgid "The requested MainWP site was not found."
msgstr "A kért MainWP-webhely nem található."

#: class/MainWPCloneSite.class.php:144
msgid "Enable the Clone feature"
msgstr "Klónozási funkció bekapcsolása"

#: class/MainWPCloneSite.class.php:157
msgid ""
"The saved Clone site policy is not a site list, so every site below is shown"
" as allowed. Saving the selection replaces the unreadable policy."
msgstr "A mentett klónozási webhelyszabályzat nem webhelylista, ezért az összes alábbi webhely engedélyezettként jelenik meg. A kijelölés mentése felülírja az olvashatatlan szabályzatot."

#: class/MainWPCloneSite.class.php:159
msgid ""
"The saved Clone site policy or visible-site list could not be read "
"completely. Selection controls are disabled until the data is available."
msgstr "A mentett klónozási webhelyszabályzat vagy a látható webhelyek listája nem olvasható be teljes egészében. A kijelölési vezérlők addig ki vannak kapcsolva, amíg az adatok elérhetővé nem válnak."

#: class/MainWPCloneSite.class.php:169
msgid ""
"Settings saved successfully. Please resync your sites to apply these "
"changes."
msgstr "A beállítások sikeresen elmentve. Kérlek, szinkronizáld újra a webhelyeidet a módosítások alkalmazásához."

#: class/MainWPCloneSite.class.php:176
msgid "Clone setting could not be saved. Please try again."
msgstr "A klónozási beállítás mentése sikertelen. Próbáld újra."

#: class/MainWPCloneSite.class.php:185
msgid ""
"Selection updated successfully. Please resync your sites to apply these "
"changes."
msgstr "A kijelölés sikeresen frissítve. Kérlek, szinkronizáld újra a webhelyeidet a módosítások alkalmazásához."

#: class/MainWPCloneSite.class.php:192
msgid "Clone site selection could not be saved. Please try again."
msgstr "A klónozási webhelykijelölés mentése sikertelen. Próbáld újra."

#: class/MainWPCloneSite.class.php:202
msgid "Site"
msgstr "Webhely"

#: class/MainWPCloneSite.class.php:203
msgid "Size (approximate)"
msgstr "Méret (hozzávetőleges)"

#: class/MainWPCloneSite.class.php:261
msgid "Jump to the child site WP Admin"
msgstr "Ugrás a gyermekwebhely WP Admin felületére"

#: class/MainWPCloneSite.class.php:263
msgid "Open the child site overview"
msgstr "A gyermekwebhely áttekintésének megnyitása"

#: class/MainWPCloneSite.class.php:277
msgid "Save Selection"
msgstr "Kiválasztás mentése"

#: class/MainWPCloneSite.class.php:278
msgid "Allow All"
msgstr "Összes engedélyezése"

#: class/MainWPCloneSite.class.php:279
msgid "Disallow All"
msgstr "Összes letiltása"

#: mainwp-clone-extension.php:164
#, php-format
msgid ""
"requires %1$sMainWP Dashboard Plugin%2$s to be activated in order to work. "
"Please install and activate %3$sMainWP Dashboard Plugin%4$s first."
msgstr "A működéshez be kell kapcsolnod a %1$sMainWP vezérlőpult-bővítményt%2$s. Először telepítsd és kapcsold be a %3$sMainWP vezérlőpult-bővítményt%4$s."
