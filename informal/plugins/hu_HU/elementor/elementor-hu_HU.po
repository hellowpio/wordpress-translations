#: assets/js/packages/editor-audits/editor-audits.strings.js:6
msgid ""
"Install the Ally plugin to add an accessibility policy to your website."
msgstr "Telepítsd az Ally bővítményt, hogy akadálymentességi szabályzatot adj hozzá a honlapodhoz."

#: assets/js/packages/editor-audits/editor-audits.js:1749
#: assets/js/packages/editor-audits/editor-audits.strings.js:7
