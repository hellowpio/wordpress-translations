#: assets/js/packages/editor-audits/editor-audits.strings.js:30
msgid "Deprecated widgets"
msgstr "Elavult widgetek"

#: assets/js/packages/editor-audits/editor-audits.js:1841
#: assets/js/packages/editor-audits/editor-audits.strings.js:31
