#: assets/js/packages/editor-audits/editor-audits.strings.js:55
msgid "Open the image's settings and add an Alt Text describing the image."
msgstr "Nyisd meg a kép beállításait, és adj meg a képet leíró alternatív szöveget."

#: assets/js/packages/editor-audits/editor-audits.js:2249
#: assets/js/packages/editor-audits/editor-audits.js:2291
#: assets/js/packages/editor-audits/editor-audits.strings.js:56
#: assets/js/packages/editor-audits/editor-audits.strings.js:61
msgid "No images"
msgstr "Nincsenek képek"

