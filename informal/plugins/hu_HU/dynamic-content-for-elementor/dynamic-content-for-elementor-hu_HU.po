msgstr "Adj hozzá kalkulátormezőt az Elementor Pro űrlapjához"

#: class/features.php:436
msgid "Range Field for Elementor Pro Form"
msgstr "Tartománymező az Elementor Pro űrlapjához"

#: class/features.php:437
msgid "Add a Range Field to Elementor Pro Form"
msgstr "Adj hozzá tartománymezőt az Elementor Pro űrlapjához"

#: class/features.php:447
msgid "International Phone Field for Elementor Pro Form"
msgstr "Nemzetközi telefonszámmező az Elementor Pro űrlapjához"

#: class/features.php:448
msgid ""
"Add an International Phone Field with country selection to Elementor Pro "
"Form"
msgstr "Nemzetközi telefonszámmező hozzáadása országválasztóval az Elementor Pro űrlapjához"

#: class/features.php:458
msgid "Rating Field for Elementor Pro Form"
msgstr "Értékelési mező az Elementor Pro űrlapjához"

#: class/features.php:459
msgid "Add a star rating field to Elementor Pro Form."
msgstr "Csillagos értékelési mező hozzáadása az Elementor Pro űrlapjához."

#: class/features.php:470
msgid "Field Description for Elementor Pro Form"
msgstr "Mezőleírás az Elementor Pro űrlapjához"

#: class/features.php:471
msgid ""
"Describe your form field to help users better understand each field. You can"
" add a tooltip or insert text"
msgstr "Írj leírást az űrlapmezőhöz, hogy a felhasználók jobban megértsék az egyes mezőket. Hozzáadhatsz eszköztippet vagy beszúrhatsz szöveget"

#: class/features.php:481
msgid "Dynamic Email for Elementor Pro Form"
msgstr "Dinamikus e-mail az Elementor Pro űrlapjához"

#: class/features.php:482
msgid "Add Dynamic Email action to Elementor Pro Form"
msgstr "Adj hozzá dinamikus e-mail-műveletet az Elementor Pro űrlapjához"

#: class/features.php:492
msgid "Favorites Action for Elementor Pro Form"
msgstr "Kedvencekhez kapcsolódó művelet az Elementor Pro űrlapjához"

#: class/features.php:493
msgid ""
"Add favorites via Elementor forms. Useful to use in combination with the "
"\"Add to Favorites\" and \"Favorites\" widgets"
msgstr "Adj hozzá kedvenceket Elementor űrlapokon keresztül. Hasznos az \"Add to Favorites\" és \"Favorites\" widgetekkel együtt használva"

#: class/features.php:503
msgid "Export for Elementor Pro Form"
msgstr "Export az Elementor Pro Formhoz"

#: class/features.php:504
msgid "Add Export action to Elementor Pro Form"
msgstr "Adj hozzá exportálási műveletet az Elementor Pro űrlapjához"

#: class/features.php:514
msgid "WooCommerce Add to Cart for Elementor Pro Form"
msgstr "WooCommerce-termék kosárba helyezése az Elementor Pro űrlapjával"

#: class/features.php:515
msgid ""
"Add products to WooCommerce cart after form submission by reading product "
"IDs from a field"
msgstr "Termékek hozzáadása a WooCommerce kosárhoz az űrlap elküldése után, a termékazonosítók mezőből való beolvasásával"

#: class/features.php:526
msgid "Icons for Elementor Pro Form"
msgstr "Ikonok az Elementor Pro űrlapjához"

#: class/features.php:527
msgid "Add icons on the label or inside the input of form fields"
msgstr "Helyezz el ikonokat az űrlapmezők címkéjén vagy a beviteli mezőkben"

#: class/features.php:538
msgid "Inline Align for Elementor Pro Form"
msgstr "Sorközi igazítás az Elementor Pro űrlapjához"

#: class/features.php:539
msgid "Choose the inline align type for checkbox and radio fields"
msgstr "Válaszd ki a jelölőnégyzet- és rádiógombmezők sorközi igazításának típusát"

#: class/features.php:550
msgid "Field Length for Elementor Pro Form"
msgstr "Mezőhossz az Elementor Pro űrlapjához"

#: class/features.php:551
msgid ""
"Choose a minimum and maximum characters length for your text and textarea "
"fields"
msgstr "Válaszd ki a szöveges és a többsoros szövegmezők minimális és maximális karakterszámát"

#: class/features.php:561
msgid "Message Generator for Elementor Pro Form"
msgstr "Üzenetgenerátor az Elementor Pro űrlapjához"

#: class/features.php:562
msgid "Options to customize the Elementor Pro Form success message"
msgstr "Beállítások az Elementor Pro Form sikerüzenetének testreszabásához"

#: class/features.php:572
msgid "Method for Elementor Pro Form"
msgstr "Módszer az Elementor Pro űrlapjához"

#: class/features.php:573
msgid ""
"Add a different method attribute on your forms that specifies how to send "
"form-data"
msgstr "Adj hozzá egy másik method attribútumot az űrlapjaidhoz, amely meghatározza, hogyan kell elküldeni az űrlapadatokat"

#: class/features.php:584
msgid "Password Visibility for Elementor Pro Form"
msgstr "Jelszó láthatósága az Elementor Pro űrlapján"

#: class/features.php:585
msgid "Allow your users to show or hide their password on Elementor Pro Form"
msgstr "Engedélyezd a felhasználóidnak, hogy megjelenítsék vagy elrejtsék a jelszavukat az Elementor Pro űrlapon"

#: class/features.php:595
msgid "Unique ID Field for Elementor Pro Form"
msgstr "Egyedi ID-mező az Elementor Pro űrlaphoz"

#: class/features.php:596
msgid ""
"With this hidden field you can generate a unique ID to be used in PDF "
"Generator or Dynamic Email"
msgstr "Ezzel a rejtett mezővel egyedi ID-t generálhatsz, amely használható a PDF Generatorban vagy a Dynamic Emailben"

#: class/features.php:606
msgid "Counter Field for Elementor Pro Form"
msgstr "Számlálómező az Elementor Pro űrlaphoz"

#: class/features.php:607
msgid ""
"Perfect for keeping track of submissions or the sum of another form field"
msgstr "Tökéletes a beküldések nyomon követéséhez vagy egy másik űrlapmező összegének számon tartásához"

