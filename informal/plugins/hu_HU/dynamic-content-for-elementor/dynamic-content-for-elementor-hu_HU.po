msgid "PDF Generator for Elementor Pro Form"
msgstr "PDF Generator az Elementor Pro űrlaphoz"

#: class/features.php:618
msgid "Add PDF creation action to Elementor Pro Form"
msgstr "Adj hozzá PDF-létrehozási műveletet az Elementor Pro Formhoz"

#: class/features.php:628
msgid "PHP Action for Elementor Pro Form"
msgstr "PHP-művelet az Elementor Pro űrlaphoz"

#: class/features.php:629
msgid "Add PHP code to the actions of a form"
msgstr "Adj hozzá PHP-kódot az űrlap műveleteihez"

#: class/features.php:639
msgid "Cookie Action for Elementor Pro Form"
msgstr "Cookie-művelet az Elementor Pro űrlaphoz"

