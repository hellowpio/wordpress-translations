msgid ""
"LearnDash LMS - Migration add-on requires the following plugin(s) be active:"
msgstr "A LearnDash LMS - áttelepítési kiegészítő működéséhez a következő bővítmény(ek)nek aktívnak kell lenniük:"

#: src/App/Admin/Settings_Section.php:54 src/App/Admin/Settings_Section.php:55
msgid "Migration"
msgstr "Áttelepítés"

#. Translators: courses label.
#: src/App/Admin/Settings_Section.php:59
msgid "Migrate %s data from other LMS platforms to LearnDash."
msgstr "Telepítsd át a(z) %s adatait más LMS-platformokról a LearnDashre."

#: src/App/Admin/Settings_Section.php:85
msgid "Available Integrations"
msgstr "Elérhető integrációk"

#: src/App/Admin/Settings_Section.php:96
msgid "LMS"
msgstr "LMS"

#: src/App/Admin/Settings_Section.php:97
msgid "Source LMS the data will be migrated from."
msgstr "Forrás-LMS, ahonnan áttelepíted az adatokat."

#. Translators: course label.
#: src/App/Admin/Settings_Section.php:109
msgid "Select the %s you want to migrate."
