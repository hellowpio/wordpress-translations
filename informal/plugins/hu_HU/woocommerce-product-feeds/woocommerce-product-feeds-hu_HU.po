msgstr "Add meg egy adott visszaküldési cím azonosítóját [a Shopping Actions-integrációhoz]"

#: src/Configuration/Configuration.php:666
msgid "Return policy label"
msgstr "Visszaküldési szabályzat címkéje"

#: src/Configuration/Configuration.php:667
msgid ""
"use this to apply a non-default return policy to a product or group of "
"products. "
msgstr "Ezzel alapértelmezettől eltérő visszaküldési szabályzatot alkalmazhatsz egy termékre vagy termékcsoportra. "

#: src/Configuration/Configuration.php:677
msgid "Pickup method"
msgstr "Átvételi mód"

#: src/Configuration/Configuration.php:678
msgid ""
"Specify the store pickup option for items [for Local Product integration]"
msgstr "Add meg a tételek üzletben történő átvételére vonatkozó beállítást [a helyi termékintegrációhoz]"

#: src/Configuration/Configuration.php:687
msgid "Pickup SLA"
msgstr "Átvételi SLA"

