#: includes/Actions/CleverReachSubscribe.php:20
#: includes/Actions/SotCleverReachSubscribe.php:38
msgid "CleverReach"
msgstr "CleverReach"

#: includes/Actions/CleverReachSubscribe.php:534
#: includes/Actions/SotCleverReachSubscribe.php:545
msgid ""
"You have either no groups or no associated forms in your CleverReach "
"Account. Please add both and click reload."
msgstr "A CleverReach-fiókodban vagy nincsenek csoportok, vagy nincsenek hozzájuk rendelt űrlapok. Add hozzá mindkettőt, majd kattints az újratöltésre."

#: includes/Actions/CleverReachSubscribe.php:622
#: includes/Actions/SotCleverReachSubscribe.php:633
msgid "CleverReach API Error:"
msgstr "CleverReach API-hiba:"

#: includes/Admin/GenerateAuthorization.php:170
msgid ""
"The redirect URI, which is set in the authorization class, is incorrect.  "
"Please contact Ninja Forms Support"
msgstr "Az engedélyezési osztályban beállított átirányítási URI hibás. Kérj támogatást a Ninja Forms ügyfélszolgálatától."

#: includes/Admin/GenerateAuthorization.php:173
msgid ""
"The authorization code has expired.  The authorization code must be used "
"within a few minutes.  Please retry the authorization from the Ninja Forms "
"settings dashboard."
msgstr "Az engedélyezési kód lejárt. Az engedélyezési kódot néhány percen belül fel kell használni. Próbáld újra az engedélyezést a Ninja Forms beállításainak vezérlőpultján."

#: includes/Config/ActionCleverReachSettings.php:18
