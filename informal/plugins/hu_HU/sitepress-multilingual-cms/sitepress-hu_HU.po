#. translators: Option in the dropdown that picks the form of the XLIFF file.
#. %s: the version number, for example 1.2.
#: menu/xliff-options.php:51
#, php-format
msgid "XLIFF %s"
msgstr "XLIFF %s"

#: menu/xliff-options.php:61
msgid "New lines character"
msgstr "Újsorkarakter"

#: menu/xliff-options.php:63
msgid "How new lines characters in XLIFF files should be handled?"
msgstr "Hogyan kell kezelni az XLIFF-fájlokban lévő újsorkaraktereket?"

#. translators: Notice on the screen where content types are set up. %1$s: the
#. name of the group of items, for example post types, %2$s: the names of the
#. items, each in italics and separated by commas.
#: menu/_custom_types_translation.php:24
#, php-format
msgid ""
"You haven't set your synchronization preferences for these %1$s: %2$s. "
"Default value was selected."
msgstr "A következőkhöz nem adtad meg a szinkronizálási beállításokat (%1$s): %2$s. Az alapértelmezett érték lett kiválasztva."

#. translators: Heading above the list of content types on the screen where
#. they are set up.
#: menu/_custom_types_translation.php:86
msgid "Post types"
msgstr "Bejegyzéstípusok"

#: menu/_login_translation_options.php:21
msgid "Allow translating the login and registration pages"
msgstr "A belépési és regisztrációs oldalak fordításának engedélyezése"

#: menu/_login_translation_options.php:32
msgid "Show Language Switcher on login and registration pages"
msgstr "Nyelvválasztó megjelenítése a belépési és regisztrációs oldalakon"

#. translators: Notice on WPML settings. nginx is a product name and stays as
#. it is.
#: menu/_login_translation_options.php:52
msgid "If your site uses nginx, please add a rewrite rule for each language."
msgstr "Ha a webhelyed nginxet használ, adj hozzá egy átírási szabályt minden nyelvhez."

#. translators: Second sentence of the same notice, explaining why the rules
#. are needed.
#: menu/_login_translation_options.php:53
msgid ""
"nginx does not read the .htaccess file. Without these rules, the login and "
"registration pages return a 404 error in secondary languages."
msgstr "Az nginx nem olvassa be a .htaccess fájlt. E szabályok nélkül a belépési és regisztrációs oldalak 404-es hibát adnak a másodlagos nyelveken."

#. translators: Click target on WPML settings that opens the nginx rewrite
#. rules for this site. It is the user's own question.
#: menu/_login_translation_options.php:56
msgid "Which rules do I add?"
msgstr "Milyen szabályokat adjak hozzá?"

#: menu/_posts_sync_options.php:14
