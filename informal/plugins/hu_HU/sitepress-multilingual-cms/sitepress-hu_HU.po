#. translators: Question asked before the language of a post is changed.
#. {post_name} is replaced with the title of the post and stays as it is.
#: sitepress.class.php:1892
msgid "You are about to change the language of {post_name}."
msgstr "A következő bejegyzés nyelvének megváltoztatására készülsz: {post_name}."

#: sitepress.class.php:1893
msgid "All categories and tags will be translated if possible."
msgstr "Minden kategória és címke le lesz fordítva, ha lehetséges."

#: sitepress.class.php:1894
msgid ""
"The following terms do not have a translation in the chosen language and "
"will be disconnected from this post:"
msgstr "A következő kifejezéseknek nincs fordításuk a kiválasztott nyelven, ezért le lesznek választva erről a bejegyzésről:"

#. translators: Text shown while the language details of a post are being
#. loaded. {post_name} is replaced with the title of the post and stays as it
#. is.
#: sitepress.class.php:1896
msgid "Loading Language Data for {post_name}"
msgstr "Nyelvi adatok betöltése ehhez: {post_name}"

#: sitepress.class.php:1897
msgid ""
"Please make sure that you've saved all the changes. We will have to reload "
"the page."
msgstr "Győződj meg róla, hogy minden módosítást elmentettél. Újra kell töltenünk az oldalt."

#: sitepress.class.php:1898
msgid "Do you want to continue?"
msgstr "Szeretnéd folytatni?"

#: sitepress.class.php:1900
msgid "(No title for this post yet)"
msgstr "(Ennek a bejegyzésnek még nincs címe)"

#. translators: Shown on the menu synchronization screen when applying the
#. changes was refused and the server gave no reason of its own.
#: sitepress.class.php:1972
msgid ""
"These changes could not be synchronized. Please reload the page and try "
"again."
msgstr "Ezeket a módosításokat nem sikerült szinkronizálni. Töltsd újra az oldalt, és próbáld újra."

#. translators: Heading above the list of custom taxonomies on the screen
