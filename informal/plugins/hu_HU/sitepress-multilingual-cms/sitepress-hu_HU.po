msgstr "Jelszó szinkronizálása a jelszóval védett bejegyzéseknél"

#: menu/_posts_sync_options.php:42
msgid "Synchronize private flag"
msgstr "Privát jelölő szinkronizálása"

#: menu/_posts_sync_options.php:46
