#. Plugin Name of the plugin
#: meta-box-template.php
msgid "MB Template"
msgstr "MB sablonminta"

#. Plugin URI of the plugin
#: meta-box-template.php
msgid "http://metabox.io/plugins/meta-box-template/"
msgstr "http://metabox.io/plugins/meta-box-sablonminta/"

#. Description of the plugin
#: meta-box-template.php
msgid "Configure field groups easily with YAML templates."
msgstr "Mezőcsoportok egyszerű beállítása YAML-sablonokkal."

#. Author of the plugin
#: meta-box-template.php
msgid "MetaBox.io"
msgstr "MetaBox.io"

#. Author URI of the plugin
#: meta-box-template.php
msgid "https://metabox.io"
msgstr "https://metabox.io"

#. Translators: %s - URL to the plugin settings page.
#: src/Register.php:38
#, php-format
msgid ""
"Your input or files contain invalid YAML for Meta Box. Please go to the <a "
"href=\"%s\">plugin settings page</a> and fix it."
msgstr "A megadott szöveg vagy a fájlok hibás YAML-t tartalmaznak a Meta Boxhoz. Lépj a <a href=\"%s\">bővítmény beállítási oldalára</a>, és javítsd ki ott."

#: src/Settings.php:18
msgid "Enter template:"
msgstr "Add meg a sablonmintát:"

#: src/Settings.php:19
msgid "Or specify path to config file(s):"
msgstr "Vagy add meg a konfigurációs fájl(ok) elérési útját:"

#: src/Settings.php:25 src/Settings.php:26
msgid "Template"
msgstr "Sablon"

#. Translators: %s - URL to the documentation.
#: src/Settings.php:59
#, php-format
msgid ""
"SYNTAX ERROR: Your input or files contain invalid YAML for Meta Box. Please "
"<a href=\"%s\" target=\"_blank\">follow the documentation</a> and try again."
msgstr "SZINTAXISHIBA: A bemenet vagy a fájlok hibás YAML-t tartalmaznak a Meta Boxhoz. <a href=\"%s\" target=\"_blank\">Kövesd a dokumentációt</a>, és próbáld újra."

#: src/Settings.php:77
msgid "Save Changes"
msgstr "Módosítások mentése"

#. Translators: %s - docs link.
#: src/Settings.php:93
#, php-format
msgid "Supports YAML format. See <a href=\"%s\" target=\"_blank\">documentation</a>."
msgstr "Támogatja a YAML formátumot. Lásd a <a href=\"%s\" target=\"_blank\">dokumentációt</a>."

#: src/Settings.php:107
msgid ""
"Enter absolute path to <code>.yml</code> files or folders containing "
"<code>.yml</code> files. Separate multiple items with commas. Supports "
"following variables (no trailing slash):"
msgstr "Add meg a <code>.yml</code> fájlokhoz vagy <code>.yml</code> fájlokat tartalmazó mappákhoz vezető abszolút elérési utat. Több elemet vesszővel válassz el. A következő változókat támogatja (nincs záró perjel):"

#: src/Settings.php:112
msgid "Path to <code>wp-content</code> directory"
msgstr "Elérési út a <code>wp-content</code> könyvtárhoz"

#: src/Settings.php:116
msgid "Path to <code>wp-content/plugins</code> directory"
msgstr "Elérési út a <code>wp-content/plugins</code> könyvtárhoz"

#. Translators: %s - function URL.
#: src/Settings.php:124
#, php-format
msgid ""
"Path to <code>wp-content/themes</code> directory. Same as the <a href=\"%s\""
" target=\"_blank\">get_theme_root()</a> function."
msgstr "Elérési út a <code>wp-content/themes</code> könyvtárhoz. Megegyezik a <a href=\"%s\" target=\"_blank\">get_theme_root()</a> függvénnyel."

#. Translators: %s - function URL.
#: src/Settings.php:136
#, php-format
msgid ""
"Path to current theme directory. Same as the <a href=\"%s\" "
"target=\"_blank\">get_template_directory()</a> function."
msgstr "Az aktuális sablon könyvtárának elérési útja. Megegyezik a <a href=\"%s\" target=\"_blank\">get_template_directory()</a> függvénnyel."

#. Translators: %s - function URL.
#: src/Settings.php:148
#, php-format
msgid ""
"Path to current child theme directory. Same as the <a href=\"%s\" "
"target=\"_blank\">get_stylesheet_directory()</a> function."
msgstr "Az aktuális gyermeksablon könyvtárának elérési útja. Megegyezik a <a href=\"%s\" target=\"_blank\">get_stylesheet_directory()</a> függvénnyel."
