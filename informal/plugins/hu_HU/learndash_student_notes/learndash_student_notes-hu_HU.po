msgid "Instructor Response to Your Note"
msgstr "Az oktató válasza a jegyzetedre"

#: admin/sections/class-learndash-notes-settings-section-email.php:83
msgid ""
"Hello {student_first_name},<br><br>Your instructor {instructor_first_name} "
"{instructor_last_name} has responded to your "
"note.<br><br><strong>Course/Lesson:</strong> "
"{student_post_link}<br><br>Please log in to view the full response.<br>"
msgstr "Üdv, {student_first_name},<br><br>{instructor_first_name} {instructor_last_name} oktatód válaszolt a jegyzetedre.<br><br><strong>Kurzus/lecke:</strong> {student_post_link}<br><br>Jelentkezz be a teljes válasz megtekintéséhez.<br>"

