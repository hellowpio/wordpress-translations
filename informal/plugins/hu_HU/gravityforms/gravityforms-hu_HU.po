#: includes/abilities/class-gf-mcp-settings.php:1111
msgid "Learn more about installing agent skills (opens in a new tab)"
msgstr "További tudnivalók az ügynökkészségek telepítéséről (új lapon nyílik meg)"

#: includes/abilities/class-gf-mcp-settings.php:1119
msgid "Download Gravity Forms Skill"
msgstr "Gravity Forms-készség letöltése"

#. translators: %s: add-on name, e.g. "Gravity Flow".
#: includes/abilities/class-gf-mcp-settings.php:1134
