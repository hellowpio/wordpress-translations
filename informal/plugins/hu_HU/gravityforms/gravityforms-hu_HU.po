#: includes/abilities/handlers/class-gf-abilities-handler-notifications.php:286
msgid "a message"
msgstr "egy üzenet"

#. translators: %s: the list of missing notification fields
#: includes/abilities/handlers/class-gf-abilities-handler-notifications.php:301
msgid "A notification requires %s."
msgstr "Az értesítéshez %s szükséges."

#: includes/abilities/handlers/class-gf-abilities-handler-system.php:111
msgid ""
"Set fields to an array of child field definitions using the same shape as "
"top-level form fields. Child field types must have repeatable=true."
msgstr "A fields értékét a felső szintű űrlapmezőkkel azonos szerkezetű, gyermekmező-definíciókat tartalmazó tömbként add meg. A gyermekmezők típusánál a repeatable értéknek true-nak kell lennie."

#: includes/abilities/schemas/class-gf-ability-schemas.php:27
msgid ""
"Entry status to match. Defaults to active; spam and trash are excluded "
"unless explicitly requested."
msgstr "A bejegyzéseknek megfelelő állapot. Alapértelmezés szerint aktív; a spam és a kukába helyezett bejegyzések nem szerepelnek, hacsak kifejezetten nem kéred őket."

#: includes/abilities/schemas/class-gf-ability-schemas.php:32
msgid "Field-level filters used to narrow entry results."
msgstr "A bejegyzések találatainak szűkítésére használt mezőszintű szűrők."

#: includes/abilities/schemas/class-gf-ability-schemas.php:38
msgid "Field or property key to filter on."
msgstr "A szűréshez használt mező vagy tulajdonság kulcsa."

#: includes/abilities/schemas/class-gf-ability-schemas.php:42
msgid "Value to compare against."
msgstr "Az összehasonlítás alapjául szolgáló érték."

#: includes/abilities/schemas/class-gf-ability-schemas.php:47
msgid "Comparison operator for the filter."
msgstr "A szűrő összehasonlító operátora."

#: includes/abilities/schemas/class-gf-ability-schemas.php:57
msgid ""
"Inclusive start date for matching entries. Format: YYYY-MM-DD or YYYY-MM-DD "
"HH:MM:SS."
msgstr "A találatok kezdő dátuma; ez a dátum is beleszámít. Formátum: YYYY-MM-DD vagy YYYY-MM-DD HH:MM:SS."

#: includes/abilities/schemas/class-gf-ability-schemas.php:61
msgid ""
"Inclusive end date for matching entries. Format: YYYY-MM-DD or YYYY-MM-DD "
"HH:MM:SS."
msgstr "A találatok befejezésének dátuma; ez a dátum is beleszámít. Formátum: YYYY-MM-DD vagy YYYY-MM-DD HH:MM:SS."

#: includes/abilities/schemas/class-gf-ability-schemas.php:67
msgid ""
"How to combine field_filters: \"all\" requires every filter to match (AND), "
"\"any\" requires at least one to match (OR). Defaults to \"all\"."
msgstr "A field_filters szűrők kombinálásának módja: az „all” értékhez minden szűrőnek egyeznie kell (AND), az „any” értékhez legalább egynek (VAGY). Alapértelmezés szerint „all”."

#: includes/abilities/schemas/class-gf-ability-schemas.php:88
msgid "Property name used for sorting."
msgstr "A rendezéshez használt tulajdonságnév."

#: includes/abilities/schemas/class-gf-ability-schemas.php:93
msgid "Sort direction."
msgstr "A rendezés iránya."

#: includes/abilities/schemas/class-gf-ability-schemas.php:98
msgid "Whether the sort key should be treated as numeric."
msgstr "Azt jelzi, hogy a rendezési kulcsot számként kell-e kezelni."

#: includes/abilities/schemas/class-gf-ability-schemas.php:121
msgid "Zero-based starting offset."
msgstr "A kezdő eltolás nullától számozva."

#: includes/abilities/schemas/class-gf-ability-schemas.php:128
msgid "Maximum number of results to return."
msgstr "A visszaadandó találatok maximális darabszáma."

#: includes/abilities/schemas/class-gf-ability-schemas.php:147
msgid "Whether the form is active."
msgstr "Azt jelzi, hogy az űrlap aktív-e."

#: includes/abilities/schemas/class-gf-ability-schemas.php:148
msgid "Date the form was created."
msgstr "Az űrlap létrehozásának dátuma."

#: includes/abilities/schemas/class-gf-ability-schemas.php:149
msgid "Whether the form is in the trash."
msgstr "Hogy az űrlap a lomtárban van-e."

#: includes/abilities/schemas/class-gf-ability-schemas.php:150
msgid "Number of fields in the form."
msgstr "Az űrlap mezőinek száma."

#: includes/abilities/schemas/class-gf-ability-schemas.php:190
msgid ""
"The form ID(s) to target. Pass a single integer or an array of form IDs (max"
" 100)."
msgstr "A célként megadandó űrlapok ID-ja vagy ID-i. Adj meg egyetlen egész számot vagy űrlap-azonosítók tömbjét (legfeljebb 100)."

#: includes/abilities/schemas/class-gf-ability-schemas.php:223
msgid "The ID of the new form."
msgstr "Az új űrlap ID-ja."

#: includes/abilities/schemas/class-gf-ability-schemas.php:224
msgid "Admin URL to open and edit the new form."
msgstr "Az új űrlap megnyitására és szerkesztésére szolgáló admin URL."

#: includes/abilities/schemas/class-gf-ability-schemas.php:244
msgid ""
"Field type slug. Call gravityforms/system-field-types to get the full list "
"of available types and their capabilities."
msgstr "A mezőtípus slugja. Az elérhető típusok és képességeik teljes listájáért hívd meg a gravityforms/system-field-types végpontot."

#: includes/abilities/schemas/class-gf-ability-schemas.php:245
msgid "Field label displayed to users."
msgstr "A felhasználóknak megjelenített mezőcímke."

#: includes/abilities/schemas/class-gf-ability-schemas.php:246
msgid "Whether the field is required."
msgstr "A mező kötelező-e."

#: includes/abilities/schemas/class-gf-ability-schemas.php:249
msgid ""
"For select/radio/checkbox fields — array of {text, value} choice objects."
msgstr "Kiválasztás, rádiógomb vagy jelölőnégyzet mezőknél: {text, value} választási objektumok tömbje."

#: includes/abilities/schemas/class-gf-ability-schemas.php:253
msgid "The display label for the choice."
msgstr "A választási lehetőség megjelenített címkéje."

#: includes/abilities/schemas/class-gf-ability-schemas.php:254
msgid "The submitted value for the choice."
msgstr "A választási lehetőség beküldött értéke."

#: includes/abilities/schemas/class-gf-ability-schemas.php:258
msgid "Default field value."
msgstr "Alapértelmezett mezőérték."

#: includes/abilities/schemas/class-gf-ability-schemas.php:261
msgid ""
"Pricing fields only (quantity, option): the ID of the product field this "
"belongs to. If omitted, it links to the nearest preceding product field, or "
"to the first product on the form when none precedes it — set it explicitly "
"on multi-product forms."
msgstr "Csak árazási mezőknél (mennyiség, opció): annak a termékmezőnek az ID-ja, amelyhez ez tartozik. Ha nincs megadva, a legközelebbi előző termékmezőhöz kapcsolódik, vagy ha nincs ilyen, az űrlap első termékéhez. Több terméket tartalmazó űrlapoknál add meg kifejezetten."

#: includes/abilities/schemas/class-gf-ability-schemas.php:266
msgid ""
"Phone fields only — always set it explicitly. 'standard' is the US format "
"(###) ###-####, 'international' is a plain unformatted input, 'formatted' "
"renders the international phone UI with a country selector (pair with "
"defaultCountry) and stores the value as JSON."
msgstr "Csak telefonszámmezőknél – mindig add meg kifejezetten. A „standard” az amerikai formátum (###) ###-####, az „international” egy formázatlan mező, a „formatted” pedig országválasztóval ellátott nemzetközi telefonszámmezőt jelenít meg (használd a defaultCountry beállítással), és JSON-ként tárolja az értéket."

#: includes/abilities/schemas/class-gf-ability-schemas.php:268
msgid "Placeholder text."
msgstr "Helyőrző szöveg."

#: includes/abilities/schemas/class-gf-ability-schemas.php:269
msgid ""
"Email fields only — render a second Confirm Email input that must match. The"
" two sub-inputs are added automatically."
msgstr "Csak e-mail cím mezőknél: jeleníts meg egy második, megerősítő e-mail cím mezőt, amelynek egyeznie kell az elsővel. A két almező automatikusan hozzáadódik."

#: includes/abilities/schemas/class-gf-ability-schemas.php:270
msgid "Field description / help text."
msgstr "A mező leírása vagy súgószövege."

#: includes/abilities/schemas/class-gf-ability-schemas.php:271
msgid ""
"Custom CSS class. Do NOT use deprecated Ready Classes (gf_left_half, "
"gf_right_half, gf_left_third, etc.) — they are removed automatically and "
"reported in the response. Use layoutGroupId and layoutGridColumnSpan for "
"layout instead."
msgstr "Egyéni CSS-osztály. NE használj elavult Ready Classes osztályokat (gf_left_half, gf_right_half, gf_left_third stb.) – ezeket a rendszer automatikusan eltávolítja, és jelzi a válaszban. Az elrendezéshez inkább a layoutGroupId és layoutGridColumnSpan beállításokat használd."

#: includes/abilities/schemas/class-gf-ability-schemas.php:272
msgid ""
"Layout group identifier. Fields sharing the same layoutGroupId render on the"
" same row. Use any readable name (e.g. \"row1\", \"name-row\") — the server "
"normalizes to an internal ID."
msgstr "Az elrendezési csoport azonosítója. Az azonos layoutGroupId értékkel rendelkező mezők ugyanabban a sorban jelennek meg. Bármilyen könnyen olvasható nevet használhatsz (például „row1” vagy „name-row”) – a szerver belső azonosítóvá alakítja."

#: includes/abilities/schemas/class-gf-ability-schemas.php:273
msgid ""
"Number of grid columns this field spans (1–12). Fields default to 12 (full "
"width). Use 6 for half-width (two per row), 4 for third-width (three per "
"row), etc. Fields in the same layoutGroupId render side-by-side."
msgstr "Azon rácsoszlopok száma, amelyeket ez a mező elfoglal (1–12). A mezők alapértelmezés szerint 12 oszlopot foglalnak el (teljes szélesség). Fél szélességű mezőkhöz (soronként kettő) használj 6-ot, egyharmad szélességű mezőkhöz (soronként három) pedig 4-et stb. Az azonos layoutGroupId értékű mezők egymás mellett jelennek meg."

#: includes/abilities/schemas/class-gf-ability-schemas.php:276
msgid ""
"Sub-input definitions for compound fields (name, address, time). Each input "
"has an id suffix (e.g., .3 for First Name) and label. Use "
"gravityforms/system-field-types to see default_inputs for compound field "
"types."
msgstr "Összetett mezők (név, cím, idő) almezőinek definíciói. Minden mezőhöz tartozik egy ID-utótag (például .3 a keresztnévhez) és egy címke. Az összetett mezőtípusok alapértelmezett bemeneteinek megtekintéséhez használd a gravityforms/system-field-types végpontot."

#: includes/abilities/schemas/class-gf-ability-schemas.php:280
msgid ""
"Input ID suffix (e.g., '.3' for First Name on a name field). The full input "
"ID is {field_id}{suffix}."
msgstr "A bemeneti mező ID-utótagja (például „.3” egy névmezőben a keresztnévhez). A teljes bemeneti ID: {field_id}{suffix}."

#: includes/abilities/schemas/class-gf-ability-schemas.php:281
msgid "Input label."
msgstr "Bemeneti címke."

#: includes/abilities/schemas/class-gf-ability-schemas.php:282
msgid "Whether this sub-input is hidden."
msgstr "Hogy ez az almező rejtett-e."

#: includes/abilities/schemas/class-gf-ability-schemas.php:292
msgid ""
"Repeater fields only — nested child field definitions. Child fields use the "
"same shape recursively and must be field types whose repeatable property is "
"true."
msgstr "Csak ismétlőmezőknél: beágyazott gyermekmezők definíciói. A gyermekmezők ugyanazt a rekurzív szerkezetet használják, és csak olyan mezőtípusok lehetnek, amelyeknél a repeatable értéke true."

#: includes/abilities/schemas/class-gf-ability-schemas.php:295
msgid "Nested child field definition using the same field shape recursively."
msgstr "Beágyazott gyermekmező definíciója, amely rekurzívan ugyanazt a mezőszerkezetet használja."

#: includes/abilities/schemas/class-gf-ability-schemas.php:298
msgid ""
"Repeater fields only — maximum number of rows a user can add. Omit or use 0 "
"for no explicit limit."
msgstr "Csak ismétlőmezőknél: a felhasználó által hozzáadható sorok maximális száma. Korlátlan számú sorhoz hagyd ki, vagy használd a 0 értéket."

#: includes/abilities/schemas/class-gf-ability-schemas.php:299
msgid "Repeater fields only — custom text for the Add button."
msgstr "Csak ismétlőmezőknél: a hozzáadás gomb egyéni szövege."

#: includes/abilities/schemas/class-gf-ability-schemas.php:300
msgid "Repeater fields only — custom text for the Remove button."
msgstr "Csak ismétlőmezőknél: az eltávolítás gomb egyéni szövege."

#: includes/abilities/schemas/class-gf-ability-schemas.php:301
msgid "Repeater fields only — label used for each row, e.g. \"Participant\"."
msgstr "Csak ismétlőmezőknél: az egyes sorokhoz használt címke, például „Résztvevő”."

#: includes/abilities/schemas/class-gf-ability-schemas.php:302
msgid "Repeater fields only — whether row labels should be visible."
msgstr "Csak ismétlőmezőknél: hogy láthatók legyenek-e a sorcímkék."

#: includes/abilities/schemas/class-gf-ability-schemas.php:305
msgid ""
"Field ID. Required when updating existing fields; omit for new fields being "
"added."
msgstr "Mező ID. Meglévő mezők frissítésekor kötelező; új mező hozzáadásakor hagyd ki."

#: includes/abilities/schemas/class-gf-ability-schemas.php:346
msgid ""
"Enable form scheduling. When true, the form only accepts entries between "
"scheduleStart and scheduleEnd dates."
msgstr "Űrlapidőzítés bekapcsolása. Ha true értékű, az űrlap csak a scheduleStart és scheduleEnd dátumok között fogad bejegyzéseket."

#: includes/abilities/schemas/class-gf-ability-schemas.php:347
msgid ""
"Schedule start date (MM/DD/YYYY). Form shows schedulePendingMessage before "
"this date. Omit to start immediately."
msgstr "Az időzítés kezdő dátuma (MM/DD/YYYY). Az űrlapon a schedulePendingMessage üzenet jelenik meg e dátum előtt. Az azonnali kezdéshez hagyd ki."

#: includes/abilities/schemas/class-gf-ability-schemas.php:348
msgid ""
"Schedule end date (MM/DD/YYYY). Form shows scheduleMessage after this date. "
"To pause a form immediately, set to a past date."
msgstr "Az időzítés befejezésének dátuma (MM/DD/YYYY). Az űrlapon a scheduleMessage üzenet jelenik meg e dátum után. Az űrlap azonnali szüneteltetéséhez adj meg egy múltbeli dátumot."

#: includes/abilities/schemas/class-gf-ability-schemas.php:349
msgid ""
"Message displayed after the schedule end date. Defaults to \"Sorry. This "
"form is no longer available.\""
msgstr "Az időzítés befejezésének dátuma után megjelenő üzenet. Alapértelmezés szerint: „Sajnáljuk. Ez az űrlap már nem érhető el.”"

#: includes/abilities/schemas/class-gf-ability-schemas.php:350
msgid ""
"Message displayed before the schedule start date. Defaults to \"This form is"
" not yet available.\""
msgstr "Az időzítés kezdő dátuma előtt megjelenő üzenet. Alapértelmezés szerint: „Ez az űrlap még nem érhető el.”"

#: includes/abilities/schemas/class-gf-ability-schemas.php:351
msgid ""
"Enable entry limit. When true, form stops accepting entries after "
"limitEntriesCount is reached."
msgstr "Bejegyzéskorlát bekapcsolása. Ha true értékű, az űrlap leállítja a bejegyzések fogadását, amikor eléri a limitEntriesCount értéket."

#: includes/abilities/schemas/class-gf-ability-schemas.php:352
msgid "Maximum number of entries allowed."
msgstr "Az engedélyezett bejegyzések maximális száma."

#: includes/abilities/schemas/class-gf-ability-schemas.php:353
msgid ""
"Period for the entry limit. Empty string means total (all-time). Other "
"values reset the count per period."
msgstr "A bejegyzéskorlát időszaka. Az üres szöveg az összes időszakra (teljes időtartamra) vonatkozik. Más értékek esetén a számláló időszakonként visszaáll."

#: includes/abilities/schemas/class-gf-ability-schemas.php:354
msgid ""
"Message displayed when the entry limit is reached. Defaults to \"Sorry. This"
" form is no longer accepting new submissions.\""
msgstr "A bejegyzéskorlát elérésekor megjelenő üzenet. Alapértelmezés szerint: „Sajnáljuk. Ez az űrlap már nem fogad új beküldéseket.”"

#: includes/abilities/schemas/class-gf-ability-schemas.php:355
msgid ""
"Enable the anti-spam honeypot field. Required for the submission speed check"
" to run."
msgstr "A levélszemét elleni honeypot mező bekapcsolása. A beküldési sebesség ellenőrzésének futtatásához kötelező."

#: includes/abilities/schemas/class-gf-ability-schemas.php:356
msgid ""
"Flag submissions completed faster than submitSpeedCheckThreshold as spam. "
"Only runs when the honeypot is enabled — enabling this also enables "
"enableHoneypot."
msgstr "A submitSpeedCheckThreshold értéknél gyorsabban befejezett beküldések megjelölése levélszemétként. Csak akkor működik, ha a honeypot be van kapcsolva – ennek bekapcsolása az enableHoneypot beállítást is bekapcsolja."

#: includes/abilities/schemas/class-gf-ability-schemas.php:357
msgid ""
"Submissions completed in fewer milliseconds than this are flagged as spam. "
"Defaults to 2000."
msgstr "Az ennél kevesebb ezredmásodperc alatt befejezett beküldéseket a rendszer levélszemétként jelöli meg. Alapértelmezett értéke: 2000."

#: includes/abilities/schemas/class-gf-ability-schemas.php:371
msgid ""
"Field values keyed by input name (e.g., 'input_1': 'John', 'input_2': "
"'john@example.com'). Most fields use string values. Multiselect fields "
"accept an array of selected values (e.g., 'input_3': ['Red', 'Blue']). "
"Repeater child fields submit as arrays keyed by the child input name (e.g., "
"'input_4': ['Alice', 'Bob'])."
msgstr "A mezőértékek kulcsa a bemenet neve (például: „input_1”: „János”, „input_2”: „janos@example.com”). A legtöbb mező szöveges értékeket használ. A többes választású mezők kiválasztott értékek tömbjét fogadják el (például: „input_3”: [„Piros”, „Kék”]). Az ismétlőmezők gyermekmezőinek értékei a gyermekmező bemeneti neve alapján kulcsolt tömbökként kerülnek beküldésre (például: „input_4”: [„Alice”, „Bob”])."

#: includes/abilities/schemas/class-gf-ability-schemas.php:389
msgid ""
"Field-level validation errors keyed by field ID (only if is_valid is false)."
msgstr "A mezőazonosító szerint megadott mezőszintű érvényesítési hibák (csak akkor, ha az is_valid értéke false)."

#: includes/abilities/schemas/class-gf-ability-schemas.php:403
msgid "Entry ID."
msgstr "Bejegyzés ID."

#: includes/abilities/schemas/class-gf-ability-schemas.php:404
msgid "The form this entry belongs to."
msgstr "Az az űrlap, amelyhez ez a bejegyzés tartozik."

#: includes/abilities/schemas/class-gf-ability-schemas.php:405
msgid "Submission date (UTC)."
msgstr "Beküldés dátuma (UTC)."

#: includes/abilities/schemas/class-gf-ability-schemas.php:406
msgid "Last update date (UTC)."
msgstr "Utolsó frissítés dátuma (UTC)."

#: includes/abilities/schemas/class-gf-ability-schemas.php:407
#: includes/webapi/v2/includes/controllers/class-controller-form-entries.php:326
msgid "Whether the entry is starred."
msgstr "Hogy a bejegyzés csillagozva van-e."

#: includes/abilities/schemas/class-gf-ability-schemas.php:408
#: includes/webapi/v2/includes/controllers/class-controller-form-entries.php:331
msgid "Whether the entry has been read."
msgstr "Hogy elolvasták-e a bejegyzést."

#: includes/abilities/schemas/class-gf-ability-schemas.php:409
msgid "Submitter IP address."
msgstr "A beküldő IP-címe."

#: includes/abilities/schemas/class-gf-ability-schemas.php:410
msgid "Source URL for the submission."
msgstr "A beküldés forrás-URL-je."

#: includes/abilities/schemas/class-gf-ability-schemas.php:412
msgid "WordPress user ID if logged in."
msgstr "Bejelentkezés esetén a WordPress-felhasználói azonosító (ID)."

#: includes/addon/class-gf-addon.php:778
msgid "Required Gravity Forms Add-On is missing: %s."
msgstr "A szükséges Gravity Forms-kiegészítő hiányzik: %s."

#: includes/addon/class-gf-addon.php:786
msgid ""
"Required Gravity Forms Add-On \"%s\" does not meet minimum version "
"requirement: %s."
msgstr "A szükséges Gravity Forms-kiegészítő „%s” nem felel meg a minimális verziókövetelménynek: %s."

#: includes/addon/class-gf-addon.php:812
msgid "Required WordPress plugin is missing: %1$s %2$s or newer."
msgstr "A szükséges WordPress-bővítmény hiányzik: %1$s %2$s vagy újabb verziója szükséges."

#: includes/addon/class-gf-addon.php:814
msgid "Required WordPress plugin is missing: %s."
msgstr "A szükséges WordPress-bővítmény hiányzik: %s."

#: includes/addon/class-gf-addon.php:830
msgid ""
"Required WordPress plugin \"%1$s\" is installed but does not meet minimum "
"version requirement: %2$s."
msgstr "A szükséges WordPress-bővítmény („%1$s”) telepítve van, de nem felel meg a minimális verziókövetelménynek: %2$s."

#: includes/addon/class-gf-addon.php:841
msgid ""
"Current PHP version (%s) does not meet minimum PHP version requirement (%s)."
msgstr "A jelenlegi PHP-verzió (%s) nem felel meg a minimális PHP-verzióra vonatkozó követelménynek (%s)."

#: includes/addon/class-gf-addon.php:858
msgid "Required PHP extension missing: %s"
msgstr "Hiányzik a szükséges PHP-kiterjesztés: %s"

#: includes/addon/class-gf-addon.php:865
msgid ""
"Required PHP extension \"%s\" does not meet minimum version requirement: %s."
msgstr "A szükséges PHP-kiterjesztés („%s”) nem felel meg a minimális verziókövetelménynek: %s."

#: includes/addon/class-gf-addon.php:880
msgid "Required PHP function missing: %s"
msgstr "Hiányzik a szükséges PHP-függvény: %s"

#: includes/addon/class-gf-addon.php:893
msgid ""
"Current WordPress version (%s) does not meet minimum WordPress version "
"requirement (%s)."
msgstr "A jelenlegi WordPress-verzió (%s) nem felel meg a minimális WordPress-verzióra vonatkozó követelménynek (%s)."

#: includes/addon/class-gf-addon.php:932
msgid ""
"%s is not able to run because your WordPress environment has not met the "
"minimum requirements."
msgstr "A(z) %s nem tud futni, mert a WordPress-környezeted nem felel meg a minimális követelményeknek."

#: includes/addon/class-gf-addon.php:933
msgid "Please resolve the following issues to use %s:"
msgstr "A(z) %s használatához oldd meg a következő problémákat:"

#: includes/addon/class-gf-addon.php:1750
msgid "GF Add-Ons"
msgstr "GF-kiegészítők"

#: includes/addon/class-gf-addon.php:1810
msgid "Add-On Page"
msgstr "Kiegészítő oldala"

#: includes/addon/class-gf-addon.php:1813
