msgid "Plugify"
msgstr "Plugify"

#. Author URI of the plugin
#: products-linked-by-variations-for-woocommerce.php
msgid "https://woocommerce.com/vendor/plugify/"
msgstr "https://woocommerce.com/vendor/plugify/"

