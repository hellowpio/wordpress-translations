#: src/Email/CompletedRenewalOrderEmail.php:23
msgid "Completed Renewal Order"
msgstr "Teljesített megújítási rendelés"

#: src/Email/CompletedRenewalOrderEmail.php:24
msgid ""
"Sent to the customer when a subscription renewal order is marked complete."
msgstr "A rendszer akkor küldi el a vásárlónak, amikor egy előfizetés megújítására leadott rendelést teljesítettként jelölnek meg."

#: src/Email/CompletedRenewalOrderEmail.php:27
msgid "Your renewal order is complete"
msgstr "A megújítási rendelésed teljesült"

#: src/Email/CompletedRenewalOrderEmail.php:28
msgid "Your {blogname} renewal order from {order_date} is complete"
msgstr "A(z) {blogname} {order_date} dátumú megújítási rendelésed teljesült"

#: src/Email/CustomerOnHoldRenewalOrderEmail.php:23
msgid "On-hold Renewal Order"
msgstr "Függőben lévő megújítási megrendelés"

#: src/Email/CustomerOnHoldRenewalOrderEmail.php:24
msgid ""
"Sent to the customer when a renewal order awaits manual payment "
"confirmation."
msgstr "A rendszer akkor küldi el a vásárlónak, amikor a megújításra leadott rendelés kézi fizetési visszaigazolásra vár."

#: src/Email/CustomerOnHoldRenewalOrderEmail.php:26
msgid "Your {blogname} renewal order has been received!"
msgstr "Megérkezett a(z) {blogname} megújítási rendelésed!"

#: src/Email/CustomerOnHoldRenewalOrderEmail.php:27
msgid "Thank you for your renewal order"
msgstr "Köszönjük a megújítási megrendelésedet"

#: src/Email/CustomerRenewalInvoiceEmail.php:23
msgid "Customer Renewal Invoice"
msgstr "Vásárlói megújítási számla"

#: src/Email/CustomerRenewalInvoiceEmail.php:24
msgid ""
"Sent to a customer when a manual renewal payment is required or when an "
"automatic renewal fails and needs manual confirmation."
msgstr "A rendszer akkor küldi el a vásárlónak, ha kézi megújítási fizetés szükséges, vagy ha az automatikus megújítás sikertelen, és kézi visszaigazolásra van szükség."

#: src/Email/CustomerRenewalInvoiceEmail.php:27
msgid "Invoice for renewal order {order_number} from {order_date}"
msgstr "Számla a(z) {order_date} dátumú, {order_number} számú megújítási rendeléshez"

#: src/Email/CustomerRenewalInvoiceEmail.php:28
msgid "Invoice for renewal order {order_number}"
msgstr "Számla a(z) {order_number} számú megújítási rendeléshez"

#: src/Email/ExpiredSubscriptionEmail.php:19
msgid "Expired Subscription"
msgstr "Lejárt előfizetés"

#: src/Email/ExpiredSubscriptionEmail.php:20
msgid "Sent to the store admin when a subscription expires."
msgstr "A rendszer akkor küldi el az áruház adminjának, amikor egy előfizetés lejár."

#: src/Email/ExpiredSubscriptionEmail.php:21
msgid "Subscription Expired"
msgstr "Előfizetés lejárt"

#: src/Email/ExpiredSubscriptionEmail.php:22
msgid "[{blogname}] Subscription Expired"
msgstr "[{blogname}] előfizetés lejárt"

#: src/Email/NewRenewalOrderEmail.php:23
msgid "New Renewal Order"
msgstr "Új megújítási megrendelés"

#: src/Email/NewRenewalOrderEmail.php:24
msgid "Sent to the admin when a subscription renewal payment is processed."
msgstr "A rendszer akkor küldi el az adminnak, amikor feldolgozza egy előfizetés megújításának fizetését."

#: src/Email/NewRenewalOrderEmail.php:25
msgid "New subscription renewal order"
msgstr "Új előfizetés-megújítási megrendelés"

#: src/Email/NewRenewalOrderEmail.php:26
msgid ""
"[{blogname}] New subscription renewal order ({order_number}) - {order_date}"
msgstr "[{blogname}] Új előfizetés-megújítási rendelés ({order_number}) – {order_date}"

#: src/Email/OnHoldSubscriptionEmail.php:19
msgid "Suspended Subscription"
msgstr "Előfizetés felfüggesztve"

#: src/Email/OnHoldSubscriptionEmail.php:20
msgid ""
"Sent to the store admin when a subscription is manually suspended or placed "
"on hold."
msgstr "A rendszer akkor küldi el az áruház adminjának, ha egy előfizetést kézzel felfüggesztenek vagy függőben tartanak."

#: src/Email/OnHoldSubscriptionEmail.php:21
msgid "Subscription Suspended"
msgstr "Előfizetés felfüggesztve"

#: src/Email/OnHoldSubscriptionEmail.php:22
msgid "[{blogname}] Subscription Suspended"
msgstr "[{blogname}] Felfüggesztett előfizetés"

#: src/Email/ProcessingRenewalOrderEmail.php:23
msgid "Processing Renewal Order"
msgstr "Feldolgozás alatt álló megújítási rendelés"

#: src/Email/ProcessingRenewalOrderEmail.php:24
msgid ""
"Sent to the customer after a subscription renewal payment is completed and "
"the order is processing."
msgstr "A rendszer akkor küldi el a vásárlónak, miután az előfizetés megújításához kapcsolódó fizetés befejeződött, és a rendelés feldolgozás alatt áll."

#: src/Email/ProcessingRenewalOrderEmail.php:27
msgid "Thank you for your order"
msgstr "Köszönjük a megrendelésedet"

#: src/Email/ProcessingRenewalOrderEmail.php:28
msgid "Your {blogname} renewal order receipt from {order_date}"
msgstr "A(z) {order_date} dátumú {blogname} megújítási rendelésed bizonylata"

