msgstr "WordPress hírek"

#: class/mainwp-branding.class.php:828
msgid "Suppress update notifications for WordPress core"
msgstr "A WordPress alaprendszerének frissítéseivel kapcsolatos értesítések kikapcsolása"

#: class/mainwp-branding.class.php:829
msgid "Opt to suppress notifications related to WordPress updates."
msgstr "Válaszd a WordPress-frissítésekkel kapcsolatos értesítések kikapcsolását."

#: class/mainwp-branding.class.php:834
msgid "Hide screen options"
msgstr "Képernyőbeállítások elrejtése"

#: class/mainwp-branding.class.php:835
msgid "Choose to conceal the \"Screen Options\" tab on associated sites."
msgstr "Válaszd a „képernyő beállításai” fül elrejtését a társított webhelyeken."

#: class/mainwp-branding.class.php:840
