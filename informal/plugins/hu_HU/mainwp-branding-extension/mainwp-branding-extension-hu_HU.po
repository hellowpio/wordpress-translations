#: class/mainwp-branding.class.php:859
msgid "Send trackbacks"
msgstr "Visszakövetések küldése"

#: class/mainwp-branding.class.php:863
msgid "Hide default WordPress page meta boxes"
msgstr "Az alapértelmezett metadobozok elrejtése a WordPress-oldalakon"

#: class/mainwp-branding.class.php:872
msgid "Page attributes"
msgstr "Oldal attribútumai"

#: class/mainwp-branding.class.php:877
msgid "Global footer content"
msgstr "A lábléc globális tartalma"

#: class/mainwp-branding.class.php:878
msgid "Input personalized content for the footer of associated sites."
msgstr "Adj meg személyre szabott tartalmat a kapcsolt webhelyek láblécéhez."

#: class/mainwp-branding.class.php:895
msgid "Dashboard footer content"
msgstr "A vezérlőpult láblécének tartalma"

#: class/mainwp-branding.class.php:896
msgid "Input tailored content for the WP Admin footer on affiliated sites."
msgstr "Adj meg testreszabott tartalmat a kapcsolt webhelyek WP Admin láblécéhez."

#: class/mainwp-branding.class.php:913
msgid "Site generator options"
msgstr "A webhelygenerátor opciói"

#: class/mainwp-branding.class.php:914
msgid "Provide a unique generator text."
msgstr "Adj meg egy egyedi generátorszöveget."

#: class/mainwp-branding.class.php:914
msgid "Generator text"
msgstr "Generátorszöveg"

#: class/mainwp-branding.class.php:915
msgid "Specify a distinctive generator link."
msgstr "Adj meg egy egyedi generátorhivatkozást."

#: class/mainwp-branding.class.php:915
msgid "Generator link"
msgstr "Generátorhivatkozás"

#: class/mainwp-branding.class.php:918
msgid "Custom admin CSS"
msgstr "Egyedi admin CSS"

#: class/mainwp-branding.class.php:919
msgid ""
"Input a custom CSS script for the WP Admin section on affiliated sites."
msgstr "Adj meg egy egyedi CSS-kódot a kapcsolt webhelyek WP Admin felületéhez."

#: class/mainwp-branding.class.php:924
msgid "Custom login CSS"
