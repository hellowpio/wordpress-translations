msgstr "Az asszisztens kérése sorba állt, és automatikusan helyreállítjuk."

#: includes/assistant/background/recovery.php:61
msgid "Every minute (JetGEO assistant recovery)"
msgstr "Percenként (JetGEO-asszisztens helyreállítása)"

