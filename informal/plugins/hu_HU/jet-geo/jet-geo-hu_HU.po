#: includes/assistant/background/recovery.php:216
msgid ""
"The assistant request was ended because the module changed. Send it again."
msgstr "Az asszisztens kérése azért ért véget, mert a modul megváltozott. Küldd el újra."

#: includes/assistant/background/recovery.php:166
msgid ""
"The assistant took too long to respond, so this request was stopped. Try "
"again."
msgstr "Az asszisztens túl sokáig nem válaszolt, ezért leállítottuk ezt a kérést. Próbáld újra."

#: includes/assistant/background/recovery.php:212
#: includes/assistant/background/recovery.php:219
msgid "The assistant request changed before recovery."
msgstr "Az asszisztens kérése megváltozott a helyreállítás előtt."

#: includes/assistant/background/retention-cleanup.php:97
msgid "The assistant conversation became active before cleanup."
msgstr "Az asszisztens beszélgetése aktívvá vált a törlés előtt."

#: includes/assistant/background/retention-cleanup.php:114
msgid "The assistant conversation changed during cleanup."
msgstr "Az asszisztens beszélgetése megváltozott a törlés során."

#: includes/assistant/background/worker-rest-controller.php:60
