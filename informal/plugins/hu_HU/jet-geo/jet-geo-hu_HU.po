msgstr "Az asszisztenskérést már lefoglalták, vagy az időközben megváltozott."

#: includes/assistant/background/worker.php:161
msgid "The stored assistant request context is invalid."
msgstr "A tárolt asszisztenskérés kontextusa hibás."

#: includes/assistant/background/worker.php:181
#: includes/assistant/background/worker.php:236
#: includes/assistant/background/worker.php:273
