msgstr "Az asszisztens háttérfolyamatának zárolása már nem aktuális."

#: includes/assistant/background/worker.php:279
msgid "The assistant request changed before failure could be stored."
msgstr "Az asszisztens kérése megváltozott, mielőtt a hibát el lehetett volna menteni."

#: includes/assistant/background/worker.php:331
msgid "The assistant worker token is invalid or expired."
msgstr "Az asszisztens háttérfolyamatának tokenje hibás vagy lejárt."

#: includes/assistant/context-budgeter.php:261
msgid "The required assistant context is too large for the selected model."
msgstr "A kötelező asszisztensi kontextus túl nagy a kiválasztott modell számára."

#: includes/assistant/conversation-service.php:58
msgid "The assistant conversation could not be reset."
msgstr "Az asszisztens beszélgetését nem sikerült alaphelyzetbe állítani."

#: includes/assistant/conversation-service.php:76
#: includes/assistant/conversation-service.php:95
msgid "The assistant conversation changed. Reload it before resetting."
msgstr "Az asszisztens beszélgetése megváltozott. Töltsd újra az alaphelyzetbe állítás előtt."

#: includes/assistant/conversation-service.php:128
#: includes/assistant/persistence/conversation-repository.php:200
#: includes/assistant/persistence/conversation-repository.php:253
#: includes/assistant/request-service.php:531
msgid "The assistant conversation changed. Reload it before continuing."
msgstr "Az asszisztens beszélgetése megváltozott. Töltsd újra a folytatás előtt."

#: includes/assistant/conversation-service.php:152
msgid "The assistant conversation was not found."
msgstr "Az asszisztens beszélgetése nem található."

#: includes/assistant/conversation-service.php:193
msgid "The assistant response could not be stored."
msgstr "Az asszisztens válaszát nem sikerült elmenteni."

#: includes/assistant/conversation-service.php:225
msgid "The assistant request changed before completion."
msgstr "Az asszisztens kérése megváltozott a befejezés előtt."

#: includes/assistant/cursor-codec.php:133
msgid "The assistant message cursor is invalid."
msgstr "Az asszisztens üzenetének kurzora hibás."

#: includes/assistant/environment.php:214
#: src/components/assistant/assistant-entry.js:96
#: src/components/llms-txt-app.js:48
msgid "The AI assistant requires WordPress 7.0 or later."
msgstr "Az AI-asszisztenshez WordPress 7.0 vagy újabb verzió szükséges."

#: includes/assistant/lifecycle-cleanup.php:86
msgid "Assistant recovery events could not be unscheduled."
msgstr "Az asszisztens helyreállítási eseményeit nem sikerült törölni az ütemezésből."

#: includes/assistant/lifecycle-cleanup.php:90
msgid "Assistant cleanup events could not be unscheduled."
msgstr "Az asszisztens törlési eseményeit nem sikerült törölni az ütemezésből."

#: includes/assistant/lifecycle-cleanup.php:122
msgid "Assistant deactivation cleanup did not complete successfully."
msgstr "Az asszisztens kikapcsolásakor végzett törlés nem fejeződött be sikeresen."

#: includes/assistant/persistence/attempt-repository.php:54
#: includes/assistant/persistence/attempt-repository.php:73
msgid "The assistant request attempt is invalid."
msgstr "Az asszisztenskéréshez tartozó próbálkozás hibás."

#: includes/assistant/persistence/attempt-repository.php:236
msgid "The assistant dispatch token is invalid."
msgstr "Az asszisztens továbbítási tokenje hibás."

#: includes/assistant/persistence/attempt-repository.php:356
msgid "The assistant request transition is invalid."
msgstr "Az asszisztenskérés állapotátmenete hibás."

#: includes/assistant/persistence/attempt-repository.php:486
msgid "The assistant request ended because JetGEO was deactivated."
msgstr "Az asszisztens kérése azért ért véget, mert a JetGEO-t kikapcsolták."

#: includes/assistant/persistence/attempt-repository.php:530
msgid "The assistant request state could not be stored."
msgstr "Az asszisztens kérésének állapotát nem sikerült tárolni."

#: includes/assistant/persistence/brief-repository.php:58
#: includes/assistant/persistence/brief-repository.php:101
msgid "The assistant brief is invalid."
msgstr "Az asszisztens útmutatója hibás."

#: includes/assistant/persistence/brief-repository.php:76
msgid ""
"The assistant brief changed before this request was accepted. Send the "
"request again with the latest brief."
msgstr "Az asszisztens útmutatója megváltozott, mielőtt ezt a kérést elfogadtuk. Küldd el újra a kérést a legfrissebb útmutatóval."

#: includes/assistant/persistence/brief-repository.php:207
msgid "The stored assistant brief is invalid."
msgstr "A tárolt asszisztensi útmutató hibás."

#: includes/assistant/persistence/brief-repository.php:244
msgid "The assistant brief changed. Reload the latest brief before saving."
msgstr "Az asszisztens útmutatója megváltozott. Mentés előtt töltsd be újra a legfrissebb útmutatót."

#: includes/assistant/persistence/brief-repository.php:271
msgid "The assistant brief could not be stored."
msgstr "Az asszisztens útmutatóját nem sikerült tárolni."

#: includes/assistant/persistence/conversation-repository.php:54
msgid "The assistant conversation owner is invalid."
msgstr "Az asszisztens beszélgetésének tulajdonosa hibás."

#: includes/assistant/persistence/conversation-repository.php:113
msgid "The assistant conversation data is invalid."
msgstr "Az asszisztens beszélgetési adatai hibásak."

#: includes/assistant/persistence/conversation-repository.php:163
msgid "The assistant conversation update is invalid."
msgstr "Az asszisztens beszélgetésének frissítése hibás."

#: includes/assistant/persistence/conversation-repository.php:299
msgid "The assistant request lock is invalid."
msgstr "Az asszisztens kérésének zárolása hibás."

#: includes/assistant/persistence/conversation-repository.php:303
msgid "The assistant summary update is invalid."
msgstr "Az asszisztens összefoglalójának frissítése hibás."

#: includes/assistant/persistence/conversation-repository.php:333
msgid "The assistant request lock changed before it could be released."
msgstr "Az asszisztens kérésének zárolása megváltozott, mielőtt fel lehetett volna oldani."

#: includes/assistant/persistence/conversation-repository.php:504
msgid "The assistant conversation could not be stored."
msgstr "Az asszisztens beszélgetését nem sikerült tárolni."

#: includes/assistant/persistence/lifecycle-state-repository.php:95
msgid "Assistant execution changed before this request could continue."
msgstr "Az asszisztens végrehajtása megváltozott, mielőtt ez a kérés folytatódhatott volna."

#: includes/assistant/persistence/lifecycle-state-repository.php:149
msgid "The assistant lifecycle could not be opened."
msgstr "Az asszisztens életciklusát nem sikerült megnyitni."

#: includes/assistant/persistence/lifecycle-state-repository.php:156
msgid "The assistant lifecycle could not be verified."
msgstr "Az asszisztens életciklusát nem sikerült ellenőrizni."

#: includes/assistant/persistence/lifecycle-state-repository.php:207
msgid ""
"The assistant lifecycle close failed and was revoked through its fail-closed"
" fallback."
msgstr "Az asszisztens életciklusának bezárása sikertelen volt, ezért a rendszer a biztonságos tartalékmegoldással visszavonta azt."

#: includes/assistant/persistence/lifecycle-state-repository.php:214
msgid ""
"The assistant lifecycle could not be revoked through its primary or fallback"
" mutation."
msgstr "Az asszisztens életciklusát sem az elsődleges, sem a tartalék módosítással nem sikerült visszavonni."

#: includes/assistant/persistence/lifecycle-state-repository.php:232
msgid "The assistant lifecycle state could not be read."
msgstr "Az asszisztens életciklusának állapotát nem sikerült beolvasni."

#: includes/assistant/persistence/lifecycle-state-repository.php:332
msgid "The stored assistant lifecycle state is invalid."
msgstr "A tárolt asszisztensi életciklus állapota hibás."

#: includes/assistant/persistence/message-repository.php:65
#: includes/assistant/persistence/message-repository.php:69
#: includes/assistant/persistence/message-repository.php:95
msgid "The assistant message is invalid."
msgstr "Az asszisztens üzenete hibás."

#: includes/assistant/persistence/message-repository.php:490
msgid "The assistant candidate could not be stored."
msgstr "Az asszisztens jelöltjét nem sikerült tárolni."

#: includes/assistant/persistence/message-repository.php:515
msgid "Assistant messages could not be stored."
msgstr "Az asszisztens üzeneteit nem sikerült tárolni."

#: includes/assistant/persistence/payload-codec.php:27
#: includes/assistant/persistence/payload-codec.php:51
msgid "Assistant data contains invalid UTF-8."
msgstr "Az asszisztens adatai hibás UTF-8-kódolásúak."

#: includes/assistant/persistence/payload-codec.php:35
msgid "Assistant data could not be encoded."
msgstr "Az asszisztens adatait nem sikerült kódolni."

#: includes/assistant/persistence/payload-codec.php:59
msgid ""
"JetGEO could not read this assistant item. Reset the conversation if the "
"problem continues."
msgstr "A JetGEO nem tudta beolvasni ezt az asszisztensi tételt. Ha a probléma továbbra is fennáll, állítsd alaphelyzetbe a beszélgetést."

#: includes/assistant/persistence/preference-repository.php:77
msgid "The assistant provider preference could not be saved."
msgstr "Az asszisztens szolgáltatójára vonatkozó beállítást nem sikerült menteni."

#: includes/assistant/persistence/schema.php:73
msgid "The assistant storage requires WordPress 7.0 or later."
msgstr "Az asszisztens adattárolásához WordPress 7.0 vagy újabb verzió szükséges."

#: includes/assistant/persistence/schema.php:92
msgid "The assistant database version could not be stored."
msgstr "Az asszisztens adatbázis-verzióját nem sikerült tárolni."

#: includes/assistant/persistence/schema.php:95
msgid "The assistant database version could not be updated."
msgstr "Az asszisztens adatbázisának verzióját nem sikerült frissíteni."

#: includes/assistant/persistence/schema.php:155
msgid "The assistant database schema could not be verified."
msgstr "Az asszisztens adatbázisának sémáját nem sikerült ellenőrizni."

#: includes/assistant/persistence/schema.php:172
msgid "A required assistant database table is missing."
msgstr "Hiányzik az asszisztens adatbázisának egy kötelező táblája."

#: includes/assistant/persistence/schema.php:181
msgid "The assistant database schema is incomplete."
msgstr "Az asszisztens adatbázisának sémája nem teljes."

#: includes/assistant/persistence/throttle-repository.php:79
msgid "Assistant rate-limit data is invalid."
msgstr "Az asszisztens sebességkorlátozási adatai hibásak."

#: includes/assistant/persistence/throttle-repository.php:112
msgid "Too many assistant requests were accepted. Retry later."
msgstr "Túl sok asszisztenskérést fogadtunk el. Próbáld újra később."

#: includes/assistant/persistence/throttle-repository.php:197
msgid "Assistant rate-limit data could not be stored."
msgstr "Az asszisztens sebességkorlátozási adatait nem sikerült tárolni."

#: includes/assistant/persistence/transaction-manager.php:72
msgid "The assistant database operation could not be completed."
msgstr "Az asszisztens adatbázis-műveletét nem sikerült befejezni."

#: includes/assistant/provider/error-normalizer.php:28
msgid ""
"The AI provider rejected the API key. Check or replace the key in Connectors"
" settings."
msgstr "Az AI-szolgáltató elutasította az API-kulcsot. Ellenőrizd vagy cseréld ki a kulcsot a csatlakozók beállításaiban."

#: includes/assistant/provider/error-normalizer.php:29
msgid ""
"The AI provider denied access. Check the API key permissions and access to "
"the selected model."
msgstr "Az AI-szolgáltató megtagadta a hozzáférést. Ellenőrizd az API-kulcs jogosultságait és a kiválasztott modellhez való hozzáférést."

#: includes/assistant/provider/error-normalizer.php:30
msgid ""
"The AI provider reported a regional availability restriction. Check whether "
"the API and billing tier support the server region."
msgstr "Az AI-szolgáltató területi elérhetőségi korlátozást jelzett. Ellenőrizd, hogy az API és a számlázási csomag támogatja-e a szerver régióját."

#: includes/assistant/provider/error-normalizer.php:31
msgid ""
"The AI provider requires billing for this request. Enable billing for the "
"API project."
msgstr "Az AI-szolgáltató számlázást követel meg ehhez a kéréshez. Kapcsold be a számlázást az API-projekthez."

#: includes/assistant/provider/error-normalizer.php:32
msgid ""
"The AI provider reported exhausted quota or credits. Check the API project "
"quota and billing."
msgstr "Az AI-szolgáltató szerint elfogyott a kvóta vagy a kredit. Ellenőrizd az API-projekt kvótáját és számlázását."

#: includes/assistant/provider/error-normalizer.php:33
msgid ""
"An AI provider limit was reached. Check its quota and rate limits in the API"
" project settings."
msgstr "Elérted az AI-szolgáltató egyik korlátozását. Ellenőrizd a kvótát és a sebességkorlátozásokat az API-projekt beállításaiban."

#: includes/assistant/provider/error-normalizer.php:34
msgid ""
"The selected AI model is unavailable. Check model access or choose another "
"available model."
msgstr "A kiválasztott AI-modell nem érhető el. Ellenőrizd a modellhez való hozzáférést, vagy válassz másik elérhető modellt."

#: includes/assistant/provider/error-normalizer.php:35
msgid ""
"The AI provider rejected the response schema. Review the technical details "
"to check the integration compatibility."
msgstr "Az AI-szolgáltató elutasította a válasz sémáját. A technikai részletek alapján ellenőrizd az integráció kompatibilitását."

#: includes/assistant/provider/error-normalizer.php:36
msgid ""
"The AI provider could not accept the request parameters. Review the "
"technical details to check the integration."
msgstr "Az AI-szolgáltató nem tudta elfogadni a kérés paramétereit. A technikai részletek alapján ellenőrizd az integrációt."

#: includes/assistant/provider/error-normalizer.php:37
msgid ""
"JetGEO could not reach the AI provider. Check the server connection and try "
"again."
msgstr "A JetGEO nem tudta elérni az AI-szolgáltatót. Ellenőrizd a szerverkapcsolatot, majd próbáld újra."

#: includes/assistant/provider/error-normalizer.php:44
msgid "The assistant provider took too long to respond. Try again."
msgstr "Az asszisztens szolgáltatója túl sokáig nem válaszolt. Próbáld újra."

#: includes/assistant/provider/error-normalizer.php:48
msgid ""
"The response ended before the template was complete. Choose another "
"compatible model and try again."
msgstr "A válasz a sablonminta befejezése előtt véget ért. Válassz másik kompatibilis modellt, majd próbáld újra."

#: includes/assistant/provider/error-normalizer.php:52
msgid ""
"The AI provider declined this request. Review its settings or try another "
"model."
msgstr "Az AI-szolgáltató elutasította ezt a kérést. Nézd át a beállításait, vagy próbálj ki egy másik modellt."

#: includes/assistant/provider/error-normalizer.php:56
msgid ""
"The AI provider returned a response JetGEO could not use. Try another model."
msgstr "Az AI-szolgáltató olyan választ adott, amelyet a JetGEO nem tudott használni. Próbálj ki egy másik modellt."

#: includes/assistant/provider/error-normalizer.php:60
msgid ""
"The AI provider’s rate limit was reached. Wait a moment, then try again."
msgstr "Elérted az AI-szolgáltató sebességkorlátját. Várj egy kicsit, majd próbáld újra."

#: includes/assistant/provider/error-normalizer.php:64
msgid ""
"JetGEO could not use the AI provider. Check its connection and settings."
msgstr "A JetGEO nem tudta használni az AI-szolgáltatót. Ellenőrizd a kapcsolatot és a beállításokat."

#: includes/assistant/provider/error-normalizer.php:68
msgid ""
"The AI provider could not complete this request. Try again or choose another"
" provider."
msgstr "Az AI-szolgáltató nem tudta teljesíteni ezt a kérést. Próbáld újra, vagy válassz másik szolgáltatót."

#: includes/assistant/provider/error-normalizer.php:71
msgid "JetGEO could not finish this assistant request. Try again."
msgstr "A JetGEO nem tudta befejezni ezt az asszisztenskérést. Próbáld újra."

#: includes/assistant/provider/wordpress-ai-provider.php:41
msgid "AI is disabled by this site configuration."
msgstr "Az AI használatát a webhely konfigurációja kikapcsolta."

#: includes/assistant/provider/wordpress-ai-provider.php:48
#: includes/assistant/readiness-service.php:40
#: includes/assistant/readiness-service.php:48
#: includes/assistant/readiness-service.php:54
msgid ""
"No AI provider is available for this site. Connect one in WordPress, then "
"refresh."
msgstr "Ehhez a webhelyhez nem érhető el AI-szolgáltató. Csatlakoztass egyet a WordPressben, majd frissítsd az oldalt."

#: includes/assistant/provider/wordpress-ai-provider.php:61
msgid ""
"An AI provider is available but not connected. Open Connectors settings to "
"finish setup."
msgstr "Egy AI-szolgáltató elérhető, de nincs csatlakoztatva. A beállítás befejezéséhez nyisd meg a csatlakozók beállításait."

#: includes/assistant/provider/wordpress-ai-provider.php:67
msgid "No configured model supports this assistant response format."
msgstr "Egyik beállított modell sem támogatja ezt az asszisztens-válaszformátumot."

#: includes/assistant/provider/wordpress-ai-provider.php:70
msgid "The AI assistant is ready."
msgstr "Az AI-asszisztens készen áll."

#: includes/assistant/provider/wordpress-ai-provider.php:87
#: includes/assistant/selection-service.php:35
msgid "Compatible assistant providers could not be loaded."
msgstr "Nem sikerült betölteni a kompatibilis asszisztensszolgáltatókat."

#: includes/assistant/provider/wordpress-ai-provider.php:97
msgid "The assistant response format is not supported."
msgstr "Az asszisztens válaszformátuma nem támogatott."

#: includes/assistant/provider/wordpress-ai-provider.php:145
msgid "The provider could not complete this request."
msgstr "A szolgáltató nem tudta teljesíteni ezt a kérést."

#: includes/assistant/provider/wordpress-ai-provider.php:222
#: includes/assistant/selection-service.php:39
#: includes/assistant/selection-service.php:61
msgid "The selected assistant provider or model is unavailable."
msgstr "A kiválasztott asszisztensszolgáltató vagy modell nem érhető el."

#: includes/assistant/readiness-service.php:44
msgid ""
