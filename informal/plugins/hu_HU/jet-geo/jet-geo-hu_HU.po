msgstr "Az asszisztens háttérfolyamatának kérése hibás."

#: includes/assistant/background/worker.php:116
#: includes/modules/llms-txt/assistant/rest-controller.php:298
msgid "The assistant request was not found."
msgstr "Az asszisztens kérése nem található."

#: includes/assistant/background/worker.php:152
