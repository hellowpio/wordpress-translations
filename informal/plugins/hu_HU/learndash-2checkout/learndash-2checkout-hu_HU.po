msgstr "2Checkout-beállítások"

#: sfwd-2checkout.php:59
msgid "You do not have sufficient permissions to access this page."
msgstr "Nincs megfelelő jogosultságod az oldal eléréséhez."

#: sfwd-2checkout.php:79
msgid "settings saved."
msgstr "beállítások elmentve."

#: sfwd-2checkout.php:87
msgid "LearnDash - 2Checkout Payment Gateway Settings"
msgstr "LearnDash – 2Checkout fizetési átjáró beállításai"

#: sfwd-2checkout.php:89
msgid "2CO Account # (SID):"
msgstr "2CO-fiók száma (SID):"

#: sfwd-2checkout.php:91
msgid "Your 2Checkout account number."
msgstr "A 2Checkout-fiókod száma."

#: sfwd-2checkout.php:93
msgid "2CO Account Secret Word:"
msgstr "2CO-fiók titkos szava:"

#: sfwd-2checkout.php:95
msgid ""
"Must match with the secret word setting in your 2Checkout account. Located "
"under Account > Site Management > Checkout Options."
msgstr "Egyeznie kell a 2Checkout-fiókodban beállított titkos szóval. Az Account > Site Management > Checkout Options menüpont alatt találod."

#: sfwd-2checkout.php:97
msgid "2Checkout Approved URL"
msgstr "2Checkout-jóváhagyási URL"

#: sfwd-2checkout.php:99
msgid ""
"Enter this URL into approved URL setting in your 2Checkout account. Located "
"under Account > Site Management > Checkout Options."
msgstr "Add meg ezt az URL-t a 2Checkout-fiókod jóváhagyott URL-beállításánál. Az Account > Site Management > Checkout Options menüpont alatt találod."

#: sfwd-2checkout.php:102
msgid "Check to enable demo mode."
msgstr "Jelöld be a demó mód bekapcsolásához."

