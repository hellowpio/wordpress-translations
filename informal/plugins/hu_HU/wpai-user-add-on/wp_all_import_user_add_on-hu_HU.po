#: views/admin/import/options/_main_options_template.php:4
msgid "User's Data"
msgstr "A felhasználó adatai"

#: views/admin/import/options/_main_options_template.php:13
msgid "<b>First Name</b>"
msgstr "<b>Keresztnév</b>"

#: views/admin/import/options/_main_options_template.php:13
msgid "The user's first name. "
msgstr "A felhasználó keresztneve."

#: views/admin/import/options/_main_options_template.php:17
msgid "<b>Last Name</b>"
msgstr "<b>Vezetéknév</b>"

#: views/admin/import/options/_main_options_template.php:17
msgid "The user's last name."
msgstr "A felhasználó vezetékneve."

#: views/admin/import/options/_main_options_template.php:21
msgid "<b>Role</b>"
msgstr "<b>Szerepkör</b>"

#: views/admin/import/options/_main_options_template.php:21
msgid ""
"A string with role slug used to set the user's role. Default role is "
"subscriber."
msgstr "A szerepkör beállításához használt, slugot tartalmazó karakterlánc. Az alapértelmezett szerepkör az előfizető."

#: views/admin/import/options/_main_options_template.php:25
msgid "<b>Nickname</b>"
msgstr "<b>Becenév</b>"

#: views/admin/import/options/_main_options_template.php:25
msgid "The user's nickname, defaults to the user's username. "
msgstr "A felhasználó beceneve, alapértelmezés szerint a felhasználóneve."

#: views/admin/import/options/_main_options_template.php:29
msgid "<b>Description</b>"
msgstr "<b>Leírás</b>"

#: views/admin/import/options/_main_options_template.php:29
msgid "A string containing content about the user."
msgstr "A felhasználóról szóló tartalmat tartalmazó karakterlánc."

#: views/admin/import/options/_main_options_template.php:33
msgid "<b>* Login</b>"
msgstr "<b>* Belépés</b>"

#: views/admin/import/options/_main_options_template.php:33
msgid "A string that contains the user's username for logging in."
msgstr "A belépéshez használt felhasználónevet tartalmazó karakterlánc."

#: views/admin/import/options/_main_options_template.php:37
msgid "<b>Password</b>"
msgstr "<b>Jelszó</b>"

#: views/admin/import/options/_main_options_template.php:37
msgid "A string that contains the plain text password for the user."
msgstr "A felhasználó egyszerű szöveges jelszavát tartalmazó karakterlánc."

#: views/admin/import/options/_main_options_template.php:41
msgid "<b>Nicename</b>"
msgstr "<b>URL-barát név</b>"

#: views/admin/import/options/_main_options_template.php:41
msgid ""
"A string that contains a URL-friendly name for the user. The default is the "
"user's username."
msgstr "A felhasználó URL-barát nevét tartalmazó karakterlánc. Alapértelmezés szerint ez a felhasználóneve."

#: views/admin/import/options/_main_options_template.php:45
msgid "<b>* Email</b>"
msgstr "<b>* E-mail cím</b>"

#: views/admin/import/options/_main_options_template.php:45
msgid "A string containing the user's email address."
msgstr "A felhasználó e-mail címét tartalmazó karakterlánc."

#: views/admin/import/options/_main_options_template.php:49
msgid "<b>Registered</b>"
msgstr "<b>Regisztrálva</b>"

#: views/admin/import/options/_main_options_template.php:49
msgid "The date the user registered. Format is Y-m-d H:i:s"
msgstr "A felhasználó regisztrációjának dátuma. A formátum: Y-m-d H:i:s"

#: views/admin/import/options/_main_options_template.php:53
msgid "<b>Display Name</b>"
msgstr "<b>Megjelenített név</b>"

#: views/admin/import/options/_main_options_template.php:53
msgid ""
"A string that will be shown on the site. Defaults to user's username. It is "
"likely that you will want to change this, for both appearance and security "
"through obscurity (that is if you dont use and delete the default admin "
"user). "
msgstr "A webhelyen megjelenő karakterlánc. Alapértelmezés szerint a felhasználó felhasználóneve jelenik meg. Ezt valószínűleg érdemes megváltoztatnod a megjelenés és a biztonság érdekében, hogy ne legyen könnyű kitalálni a felhasználónevet (vagyis ha nem használod és törlöd az alapértelmezett admin felhasználót)."

#: views/admin/import/options/_main_options_template.php:57
msgid "<b>URL</b>"
msgstr "<b>URL</b>"

#: views/admin/import/options/_main_options_template.php:57
msgid "A string containing the user's URL for the user's web site. "
msgstr "A felhasználó webhelyének URL-jét tartalmazó karakterlánc."

#: views/admin/import/options/_reimport_options.php:1
msgid "When WP All Import finds new or changed data..."
msgstr "Amikor a WP All Import új vagy módosult adatokat talál..."

#: views/admin/import/options/_reimport_options.php:5
msgid "Create new users from records newly present in your file"
msgstr "Új felhasználók létrehozása a fájlodban újonnan szereplő rekordokból"

#: views/admin/import/options/_reimport_options.php:10
msgid "Delete users that are no longer present in your file"
msgstr "A fájlodban már nem szereplő felhasználók törlése"

#: views/admin/import/options/_reimport_options.php:12
msgid ""
"Records removed from the import file can only be deleted when importing into"
" New Items. This feature cannot be enabled when importing into Existing "
"Items."
msgstr "Az importfájlból eltávolított rekordok csak új tételek importálásakor törölhetők. Meglévő tételek importálásakor ez a funkció nem kapcsolható be."

#: views/admin/import/options/_reimport_options.php:19
msgid "Instead of deletion, set Meta Field"
msgstr "Törlés helyett metamező beállítása"

#: views/admin/import/options/_reimport_options.php:20
msgid ""
"Check this option if you want to update users meta fields from the previous "
"import operation which are not found among newly imported set."
msgstr "Jelöld be ezt az opciót, ha frissíteni szeretnéd azoknak a korábban importált felhasználóknak a metamezőit, akik nem szerepelnek az újonnan importált adatok között."

#: views/admin/import/options/_reimport_options.php:23
#: views/admin/import/options/_reimport_template.php:100
msgid "Name"
msgstr "Név"

#: views/admin/import/options/_reimport_options.php:25
#: views/admin/import/options/_reimport_template.php:102
msgid "Value"
msgstr "Érték"

#: views/admin/import/options/_reimport_options.php:34
msgid "Update existing users with changed data in your file"
msgstr "A meglévő felhasználók frissítése a fájlodban szereplő módosult adatokkal"

#: views/admin/import/options/_reimport_options.php:38
msgid "Update all data"
msgstr "Minden adat frissítése"

#: views/admin/import/options/_reimport_options.php:41
msgid "Choose which data to update"
msgstr "A frissítendő adatok kiválasztása"

#: views/admin/import/options/_reimport_options.php:50
msgid ""
"Check this option if you want previously imported users to change their "
