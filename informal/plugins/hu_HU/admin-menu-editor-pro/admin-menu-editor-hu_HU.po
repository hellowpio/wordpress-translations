#. Plugin Name of the plugin
#: menu-editor.php
msgid "Admin Menu Editor Pro"
msgstr "Admin Menu Editor Pro"

#. Plugin URI of the plugin
#: menu-editor.php
msgid "http://adminmenueditor.com/"
msgstr "http://adminmenueditor.com/"

#. Description of the plugin
#: menu-editor.php
msgid ""
"Lets you directly edit the WordPress admin menu. You can re-order, hide or "
"rename existing menus, add custom menus, and more."
msgstr ""
"Lehetővé teszi a WordPress-adminmenü közvetlen szerkesztését. Átrendezheted,"
" elrejtheted vagy átnevezheted a meglévő menüket, egyéni menüket adhatsz "
"hozzá és még sok mást."

#. Author of the plugin
#: menu-editor.php
msgid "Janis Elsts"
msgstr "Janis Elsts"

#. Author URI of the plugin
#: menu-editor.php
msgid "http://w-shadow.com/"
msgstr "http://w-shadow.com/"

