#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:144
msgid "Add some custom subscription plans to this product."
msgstr "Adj hozzá néhány egyedi előfizetési tervet ehhez a termékhez."

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:145
msgid "These plans will override your global subscription plans."
msgstr "Ezek a tervek felülírják a globális előfizetési terveket."

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:153
msgid "Advanced Settings"
msgstr "Speciális beállítások"

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:161
msgid "One-time purchase"
msgstr "Egyszeri vásárlás"

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:164
msgid ""
"Disable this option if you want to prevent one-time purchases of this "
"product."
msgstr "Kapcsold ki ezt az opciót, ha meg akarod akadályozni a termék egyszeri vásárlását."

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:173
msgid ""
"Optional text/html to display above the available purchase plan options. "
"Supports html and shortcodes."
msgstr "Opcionális szöveg/HTML, amely a rendelkezésre álló vásárlási terv opciói felett jelenik meg. Támogatja a HTML-t és a shortcode-okat."

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:191
msgid "Flat"
msgstr "Lapos"

#: includes/admin/meta-boxes/class-wcs-att-meta-box-product-data.php:192
