#. Plugin Name of the plugin
#: index.php
msgid "WP Booking System - GoPay Add-on"
msgstr "WP Booking System - GoPay kiegészítő"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: index.php
msgid "https://www.wpbookingsystem.com/"
msgstr "https://www.wpbookingsystem.com/"

#. Description of the plugin
#: index.php
msgid ""
"Allow customers to pay with their credit cards or via bank transfer through "
"GoPay."
msgstr "Lehetővé teszi az ügyfeleknek, hogy bankkártyájukkal vagy banki átutalással fizessenek a GoPay-en keresztül."

#. Author of the plugin
#: index.php
msgid "Veribo, Roland Murg"
msgstr "Veribo, Roland Murg"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:9
#: includes/base/functions.php:54
msgid "GoPay"
msgstr "GoPay"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:10
msgid "Give the customer the option to pay with a credit card using GoPay."
msgstr "Lehetővé teszi a vásárlónak, hogy GoPay használatával bankkártyával fizessen."

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:17
msgid "Enable GoPay"
msgstr "GoPay engedélyezése"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:33
#, php-format
msgid "Please note that GoPay does not support the %s currency."
msgstr "Felhívjuk a figyelmedet, hogy a GoPay nem támogatja ezt a pénznemet: %s."

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:40
msgid "Display name"
msgstr "Megjelenített név"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:47
msgid "The payment method name that appears on the booking form."
msgstr "A foglalási űrlapon megjelenő fizetési mód neve."

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:74
msgid "Description"
msgstr "Leírás"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:81
msgid "The payment method description that appears on the booking form."
msgstr "A foglalási űrlapon megjelenő fizetési mód leírása."

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:107
msgid "Invoice Item Name"
msgstr "Számlatétel neve"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:114
msgid ""
"The name of the product that appears on the GoPay invoice. Eg. \"Booking at "
"Anne's house.\""
msgstr "A GoPay-számlán megjelenő termék neve. Pl.: „Foglalás Anna házánál.”"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:139
msgid "API Credentials"
msgstr "API-hitelesítő adatok"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:143
msgid ""
"If you need help getting your API Keys, <a target=\"_blank\" "
"href=\"https://www.wpbookingsystem.com/documentation/gopay-"
"integration/\">check out our guide</a> which offers step by step "
"instructions."
msgstr "Ha segítségre van szükséged az API-kulcsok beszerzéséhez, <a target=\"_blank\" href=\"https://www.wpbookingsystem.com/documentation/gopay-integration/\">tekintsd meg az útmutatónkat</a>, amely lépésről lépésre végigvezet."

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:149
msgid "Enable Test Mode"
msgstr "Tesztmód bekapcsolása"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:159
msgid ""
"We recommend enabling test mode and testing the payment integration before "
"going live."
msgstr "Javasoljuk a tesztmód bekapcsolását és a fizetési integráció tesztelését az élesítés előtt."

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:167
msgid "Test GoID"
msgstr "Teszt GoID"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:178
msgid "Test Client ID"
msgstr "Teszt Client ID"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:189
msgid "Test Client Secret Key"
msgstr "Teszt kliens titkos kulcsa"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:200
msgid "Live GoID"
msgstr "Éles GoID"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:211
msgid "Live Client ID"
msgstr "Éles ügyfél-ID"

#: includes/base/admin/settings/views/view-payment-settings-gopay.php:222
msgid "Live Client Secret Key"
msgstr "Éles kliens titkos kulcsa"

#: includes/base/functions-actions-gopay.php:56
#: includes/base/functions-part-payments.php:34
msgid "Please add your API keys in the plugin's Settings Page."
msgstr "Add hozzá az API-kulcsaidat a bővítmény beállítási oldalán."

#: includes/base/functions-actions-gopay.php:77
msgid "Something went wrong. Please refresh the page and try again."
msgstr "Valami hiba történt. Kérlek, frissítsd az oldalt, és próbáld újra."

#: includes/base/functions-actions-gopay.php:99
msgid "The minimum payable amount is 0.50$"
msgstr "A minimálisan fizetendő összeg 0,50 $"

#: includes/base/functions-actions-gopay.php:139
#: includes/base/functions-part-payments.php:64
msgid "GoPay Test mode is enabled."
msgstr "A GoPay tesztmódja be van kapcsolva."

#: includes/base/functions-refunds.php:36
msgid "Deposit"
msgstr "Előleg"

#: includes/base/functions-refunds.php:42
msgid "Final Payment"
msgstr "Végső fizetés"

#: includes/base/functions.php:55
msgid "Pay with your credit card or bank account through GoPay."
msgstr "Fizess bankkártyáddal vagy bankszámládról a GoPay-en keresztül."

#: index.php:137
msgid "The <strong>GoPay</strong> Add-on requires WP Booking System version "
msgstr "A <strong>GoPay</strong> kiegészítő a WP Booking System verzióját igényli "
