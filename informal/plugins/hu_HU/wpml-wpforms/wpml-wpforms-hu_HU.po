#: vendor/wpml/forms/classes/UI/Notices.php:21
#, php-format
msgid ""
"WPML Forms: Please activate the WPML CMS Plugin and the %1$sString "
"Translation add-on%2$s"
msgstr "WPML Forms: Kapcsold be a WPML CMS bővítményt és a %1$sString Translation kiegészítőt%2$s"

#: vendor/wpml/forms/templates/welcome.php:6
msgid ""
"Your website's forms were automatically detected and added to WPML > "
"Translation Management."
msgstr "A webhelyed űrlapjait a rendszer automatikusan felismerte, és hozzáadta őket a WPML > Fordításkezelés részhez."

#: vendor/wpml/forms/templates/welcome.php:7
msgid ""
"You can send them to your local translators, use one of our partner "
"translation services, or use automatic machine translation via the Advanced "
"Translation Editor."
msgstr "Elküldheted őket a helyi fordítóidnak, igénybe veheted valamelyik partner fordítási szolgáltatásunkat, vagy használhatod az automatikus gépi fordítást a haladó fordítószerkesztőn keresztül."
