#: includes/class-wc-additional-variation-images-admin.php:55
msgid "Additional Images"
msgstr "További képek"

#: includes/class-wc-additional-variation-images-admin.php:56
msgid "Add Additional Images"
msgstr "További képek hozzáadása"

#: includes/class-wc-additional-variation-images-admin.php:57
msgid "Add to Variation"
msgstr "Hozzáadás a variációhoz"

#: includes/class-wc-additional-variation-images-admin.php:58
msgid "Variation Images"
msgstr "Variáció képei"

#: includes/class-wc-additional-variation-images-admin.php:59
msgid ""
"Click on link below to add additional images. Click on image itself to "
"remove the image. Click and drag image to re-order the image position."
msgstr "További képek hozzáadásához kattints az alábbi linkre. A kép eltávolításához kattints magára a képre. Kattints a képre, és húzd a kívánt sorrendbe."

#. translators: 1: html link for downloading WC
#: woocommerce-additional-variation-images.php:94
msgid ""
"WooCommerce Additional Variation Images Plugin requires WooCommerce to be "
"installed and active. You can download %s here."
msgstr "A WooCommerce Additional Variation Images bővítmény használatához a WooCommerce-nek telepítve és aktívnak kell lennie. Itt letöltheted: %s."

#. Plugin Name of the plugin/theme
msgid "WooCommerce Additional Variation Images"
msgstr "WooCommerce Additional Variation Images"

#. Plugin URI of the plugin/theme
msgid ""
"https://woocommerce.com/products/woocommerce-additional-variation-images/"
msgstr "https://woocommerce.com/products/woocommerce-additional-variation-images/"

#. Description of the plugin/theme
msgid ""
"A WooCommerce plugin/extension that adds ability for shop/store owners to "
"add variation specific images in a group."
msgstr "Egy WooCommerce-bővítmény/kiterjesztés, amely lehetővé teszi az üzlet tulajdonosainak a variációkhoz tartozó képek csoportos hozzáadását."

#. Author of the plugin/theme
msgid "WooCommerce"
msgstr "WooCommerce"

#. Author URI of the plugin/theme
msgid "https://woocommerce.com/"
msgstr "https://woocommerce.com/"
