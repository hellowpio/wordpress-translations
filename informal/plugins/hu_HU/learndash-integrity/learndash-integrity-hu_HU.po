#: learndash-integrity.php
msgid "Protect your LearnDash site from content theft."
msgstr "Védd a LearnDash-webhelyedet a tartalomlopástól."

#. Author of the plugin
#: learndash-integrity.php
msgid "LearnDash"
msgstr "LearnDash"

#: includes/admin/class-settings-page.php:28
#: includes/admin/class-settings-section.php:38
msgid "Integrity Settings"
msgstr "Integritás beállításai"

#: includes/admin/class-settings-page.php:29
msgid "Integrity"
msgstr "Integritás"

#: includes/admin/class-settings-section.php:94
msgid "Prevent Hotlinking"
msgstr "Hotlinkelés megakadályozása"

#: includes/admin/class-settings-section.php:95
msgid "Protect videos and images hosted on this site from hotlinking."
msgstr "Védd az ezen a webhelyen tárolt videókat és képeket a hotlinkeléstől."

#: includes/admin/class-settings-section.php:106
msgid "Prevent Concurrent Login"
msgstr "Egyidejű bejelentkezés megakadályozása"

#: includes/admin/class-settings-section.php:107
msgid "Enable concurrent logins per user."
msgstr "Engedélyezd a felhasználónkénti egyidejű bejelentkezéseket."

#: includes/admin/class-settings-section.php:118
msgid "Exclude User Role(s)"
msgstr "Felhasználói szerepkörök kizárása"

#: includes/admin/class-settings-section.php:119
msgid ""
"Choose one or more user roles to exclude from the prevent concurrent login "
"feature."
msgstr "Válassz ki egy vagy több felhasználói szerepkört, amelyeket ki szeretnél zárni az egyidejű bejelentkezés megakadályozása funkcióból."

#: includes/admin/class-settings-section.php:127
msgid "Prevent Content Copy"
msgstr "Tartalommásolás megakadályozása"

#: includes/admin/class-settings-section.php:128
msgid "Prevent content on this site from being copied."
msgstr "Akadályozd meg az ezen a webhelyen található tartalom másolását."

#: includes/admin/class-settings-section.php:139
msgid "Enable reCaptcha"
msgstr "reCaptcha engedélyezése"

#: includes/admin/class-settings-section.php:141
#, php-format
msgid ""
"reCaptcha safeguards your website from fraud and abuse while providing a "
"smooth user experience. Enable only one version of reCaptcha at a time. <a "
"target=\"_blank\" href=\"%s\">Set it up at here.</a>"
msgstr "A reCaptcha megóvja webhelyedet a csalástól és a visszaélésektől, miközben zökkenőmentes felhasználói élményt biztosít. Egyszerre csak egy reCaptcha-verziót engedélyezz. <a target=\"_blank\" href=\"%s\">Állítsd be itt.</a>"

#: includes/admin/class-settings-section.php:157
msgid "reCaptcha v3 (Invisible)"
msgstr "reCaptcha v3 (láthatatlan)"

#: includes/admin/class-settings-section.php:168
#: includes/admin/class-settings-section.php:211
msgid "Site Key"
msgstr "Webhelykulcs"

#: includes/admin/class-settings-section.php:175
#: includes/admin/class-settings-section.php:218
msgid "Secret Key"
msgstr "Titkos kulcs"

#: includes/admin/class-settings-section.php:183
msgid "Score"
msgstr "Pontszám"

#: includes/admin/class-settings-section.php:184
msgid ""
"Minimum score user has to get to be able to bypass reCAPTCHA verification. "
"reCAPTCHA v3 returns a score (1.0 is very likely a good interaction, 0.0 is "
"very likely a bot)."
msgstr "Minimális pontszám, amelyet a felhasználónak el kell érnie a reCAPTCHA-ellenőrzés megkerüléséhez. A reCAPTCHA v3 pontszámot ad vissza (1.0 esetén nagy valószínűséggel jó az interakció, 0.0 esetén nagy valószínűséggel bot)."

#: includes/admin/class-settings-section.php:200
msgid "reCaptcha v2 (checkbox)"
msgstr "reCaptcha v2 (jelölőnégyzet)"

#: includes/admin/class-settings-section.php:225
msgid "Location"
msgstr "Hely"

#: includes/admin/class-settings-section.php:226
msgid "Choose the forms for which reCaptcha will be displayed."
msgstr "Válaszd ki, mely űrlapokon jelenjen meg a reCaptcha."

#: includes/admin/class-settings-section.php:231
msgid "Login"
msgstr "Bejelentkezés"

#: includes/admin/class-settings-section.php:232
msgid "Register"
msgstr "Regisztrálás"

#: includes/class-prevent-concurrent-login.php:63
msgid "Your account has exceeded the maximum concurrent logins."
msgstr "A fiókoddal túllépted az egyidejű bejelentkezések megengedett számát."

#: includes/class-prevent-concurrent-login.php:189
msgid "Bypass Concurrent Login Lockout ( LearnDash Integrity )"
msgstr "Egyidejű bejelentkezés miatti kizárás megkerülése ( LearnDash Integrity )"

#: includes/class-prevent-concurrent-login.php:195
msgid ""
"Prevent this user from being locked out when attempting to log into "
"concurrent sessions."
msgstr "Akadályozd meg, hogy a rendszer kizárja ezt a felhasználót, amikor több munkamenetbe próbál egyidejűleg bejelentkezni."

#: includes/class-recaptcha.php:375 includes/class-recaptcha.php:466
msgid "<strong>Error:</strong> Please complete the captcha"
msgstr "<strong>hiba:</strong> Töltsd ki a captcha-t"

#: includes/class-recaptcha.php:382 includes/class-recaptcha.php:429
#: includes/class-recaptcha.php:434
msgid "Invalid captcha."
msgstr "Érvénytelen captcha."

#: includes/class-recaptcha.php:473
msgid "<strong>Error:</strong> Invalid captcha."
msgstr "<strong>hiba:</strong> Érvénytelen captcha."

#: includes/class-recaptcha.php:491
msgid "Please complete the captcha"
msgstr "Töltsd ki a captchát"

#: includes/class-recaptcha.php:557
msgid "Please complete the captcha to log in."
msgstr "A bejelentkezéshez töltsd ki a captchát."

