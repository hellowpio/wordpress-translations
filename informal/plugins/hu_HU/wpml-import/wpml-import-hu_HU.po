#. Plugin Name of the plugin
#: plugin.php classes/Integrations/Base/Notice.php:148
#: classes/UI/AdminPageHooks.php:72
msgid "WPML Export and Import"
msgstr "WPML Export and Import"

#. Plugin URI of the plugin
#: plugin.php
msgid ""
"https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpml-export-and-"
"import/"
msgstr "https://wpml.org/documentation/wpml-core-and-add-on-plugins/wpml-export-and-import/"

#. Description of the plugin
#: plugin.php
msgid "A multipurpose plugin to export and import multilingual content."
msgstr "Többcélú bővítmény többnyelvű tartalom exportálásához és importálásához."

#. Author of the plugin
#: plugin.php
msgid "OnTheGoSystems"
msgstr "OnTheGoSystems"

#. Author URI of the plugin
#: plugin.php
msgid "http://www.onthegosystems.com"
msgstr "http://www.onthegosystems.com"

#. translators: Text of the page returned when the import trigger is called
#. the old way, with the key in the address.
#: classes/API/Hooks.php:45
msgid ""
"The import trigger no longer accepts the key in the URL. Send it in a POST "
"body."
msgstr "Az importálást elindító végpont már nem fogadja el a kulcsot az URL-ben. Küldd el a POST-kérés törzsében."

#. translators: Title of the page returned when the import trigger is called
#. the old way, with the key in the address. It is the name of HTTP status
#. 405.
#: classes/API/Hooks.php:47
msgid "Method Not Allowed"
msgstr "Nem engedélyezett metódus"

#. translators: Text and title of the page returned when the import trigger is
#. called with a wrong or missing key. It is the name of HTTP status 401.
#: classes/API/Hooks.php:61 classes/API/Hooks.php:62
msgid "Unauthorized"
msgstr "Jogosulatlan"

#. translators: Text of the page returned when the import trigger runs and
#. there is nothing left to import.
#: classes/API/Hooks.php:70
msgid "No items to process"
msgstr "Nincs feldolgozandó tétel"

#. translators: Title of the page returned when the import trigger runs and
#. there is nothing left to import. It is the name of HTTP status 204.
#: classes/API/Hooks.php:72
msgid "No Content"
msgstr "Nincs tartalom"

#. translators: Text of the page returned when the import trigger runs while
#. another import process is running.
#: classes/API/Hooks.php:81
msgid "Another import process is running"
msgstr "Egy másik importálási folyamat fut"

#. translators: Title of the page returned when the import trigger runs while
#. another import process is running. It is the name of HTTP status 409.
#: classes/API/Hooks.php:83
msgid "Conflict"
msgstr "Ütközés"

#. translators: Text of the page returned when the import trigger has finished
#. running.
#: classes/API/Hooks.php:90
msgid "Import process completed"
msgstr "Az importálási folyamat befejeződött"

#. translators: Title of the page returned when the import trigger has
#. finished running. It is the name of HTTP status 200.
#: classes/API/Hooks.php:92
msgid "Success"
msgstr "Sikeres"

#. translators: Text of the page returned when the import trigger stopped on
#. an error.
#: classes/API/Hooks.php:103
msgid "Import process failed"
msgstr "Az importálási folyamat sikertelen"

#. translators: Title of the page returned when the import trigger stopped on
#. an error. It is the name of HTTP status 500.
#: classes/API/Hooks.php:105
msgid "Internal Server Error"
msgstr "Belső szerverhiba"

#: classes/CLI/Commands.php:19
msgid ""
"Another import process is running. Wait until it ends, then run this command"
" again."
msgstr "Egy másik importálási folyamat fut. Várd meg, amíg befejeződik, majd futtasd újra ezt a parancsot."

#. translators: Warning printed by the WP-CLI import command for an item it
#. did not assign to a language. %1$s: the name of the import step, for
#. example "Setting Posts’ Language". %2$d: the ID of the item. %3$s: the
#. reason, for example: the language code "xx" is not an active language on
#. this site.
#: classes/CLI/Commands.php:73
#, php-format
msgid "%1$s: item %2$d was not assigned to a language: %3$s."
msgstr "%1$s: a %2$d. tételhez nem lett nyelv rendelve: %3$s."

#. translators: Warning printed by the WP-CLI import command when a step could
#. not finish. %1$s: the name of the import step, for example "Updating Final
#. Post Status". %2$d: the number of items that were left unprocessed.
#: classes/CLI/Commands.php:99
#, php-format
msgid "%1$s: %2$d item could not be processed and was skipped."
msgid_plural "%1$s: %2$d items could not be processed and were skipped."
msgstr[0] "%1$s: a(z) %2$d tétel feldolgozása nem sikerült, ezért kimaradt."
msgstr[1] "%1$s: a(z) %2$d tétel feldolgozása nem sikerült, ezért kimaradtak."

#. translators: Part of a warning printed by the WP-CLI import command. %s:
#. the language code an imported item carries, for example "fr".
#: classes/Commands/Base/SetEntitiesLanguage.php:175
#, php-format
msgid "its translation group already has an item in \"%s\""
msgstr "a fordítási csoportjában már van egy tétel „%s” nyelven"

#. translators: Part of a warning printed by the WP-CLI import command. %s:
#. the language code an imported item carries, for example "de".
#: classes/Commands/Base/SetEntitiesLanguage.php:178
#, php-format
msgid ""
"its translation group already has an original, so the item in \"%s\" cannot "
"be a second one"
msgstr "a fordítási csoportjában már van egy eredeti, ezért a „%s” nyelvű tétel nem lehet egy második eredeti"

#. translators: Part of a warning printed by the WP-CLI import command. %s:
#. the language code an imported item carries, for example "xx".
#: classes/Commands/Base/SetEntitiesLanguage.php:181
#, php-format
msgid "the language code \"%s\" is not an active language on this site"
msgstr "a(z) „%s” nyelvkód nem aktív nyelv ezen a webhelyen"

#. translators: Part of a warning printed by the WP-CLI import command. %s:
#. the source language code an imported item carries, for example "xx".
#: classes/Commands/Base/SetEntitiesLanguage.php:184
#, php-format
msgid "the source language code \"%s\" is not an active language on this site"
msgstr "a(z) „%s” forrásnyelvi kód nem aktív nyelv ezen a webhelyen"

#. translators: Part of a warning printed by the WP-CLI import command. %s:
#. the language code an imported item carries, for example "EN".
#: classes/Commands/Base/SetEntitiesLanguage.php:187
#, php-format
msgid "the language code \"%s\" is the language of its own source"
msgstr "a(z) „%s” nyelvkód a saját forrásának nyelve"

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/CleanupPostFields.php:12
msgid "Cleaning Up Post Data"
msgstr "Bejegyzésadatok tisztítása"

#: classes/Commands/CleanupPostFields.php:19
msgid "Removing temporary and import-related post meta data."
msgstr "Ideiglenes és importáláshoz kapcsolódó bejegyzés-metaadatok eltávolítása."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/CleanupTermFields.php:12
msgid "Cleaning Up Term Data"
msgstr "Kifejezésadatok tisztítása"

#: classes/Commands/CleanupTermFields.php:19
msgid "Removing temporary and import-related term meta data."
msgstr "Ideiglenes és importáláshoz kapcsolódó kifejezés-metaadatok eltávolítása."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/ConnectPostImageAttachments.php:39
msgid "Connecting Post Image Attachments"
msgstr "Bejegyzésképek csatolmányainak összekapcsolása"

#: classes/Commands/ConnectPostImageAttachments.php:46
msgid ""
"Updating thumbnail and gallery attachment IDs on translated posts, products,"
" and CPTs to point to their translated equivalents."
msgstr "A lefordított bejegyzések, termékek és CPT-k bélyegkép- és galériacsatolmány-azonosítóinak frissítése, hogy a megfelelő fordításokra mutassanak."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/ConnectTermTranslationsByPostsWithOnlyOneAssignment.php:45
msgid "Connecting Inline Term Translations"
msgstr "Soron belüli kifejezésfordítások összekapcsolása"

#: classes/Commands/ConnectTermTranslationsByPostsWithOnlyOneAssignment.php:52
msgid ""
"Scanning posts with a single taxonomy term in order to identify and connect "
"the terms assigned to these posts with their translations."
msgstr "Egyetlen osztályozási (taxonomy) kifejezéssel rendelkező bejegyzések átvizsgálása, hogy azonosítsa és összekapcsolja a hozzájuk rendelt kifejezéseket a fordításaikkal."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/DeleteOriginalsOfDuplicatedTerms.php:30
msgid "Deleting Obsolete Original Terms"
msgstr "Elavult eredeti kifejezések törlése"

#: classes/Commands/DeleteOriginalsOfDuplicatedTerms.php:37
msgid ""
"Removing original terms that are no longer needed after creating duplicates "
"for same-named terms. Ensuring no posts are linked to these original terms."
msgstr "Az azonos nevű kifejezések másolatainak létrehozása után már szükségtelenné vált eredeti kifejezések eltávolítása. Annak biztosítása, hogy egyetlen bejegyzés se legyen ezekhez az eredeti kifejezésekhez kapcsolva."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/DuplicateTermsAssignedToPostsInDifferentLanguage.php:63
msgid "Duplicating Terms with Shared Names Across Languages"
msgstr "Több nyelven azonos nevű kifejezések másolása"

#: classes/Commands/DuplicateTermsAssignedToPostsInDifferentLanguage.php:70
msgid ""
"Creating duplicates in the correct language for terms that share the same "
"name across languages, but belong to posts in different languages."
msgstr "A több nyelven azonos nevű, de különböző nyelvű bejegyzésekhez tartozó kifejezések duplikálása a megfelelő nyelven."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/FixImportedPostSlugs.php:30
msgid "Fixing Imported Post Slugs"
msgstr "Importált bejegyzések slugjainak javítása"

#: classes/Commands/FixImportedPostSlugs.php:34
msgid ""
"Regenerating translated post slugs to prevent conflicts with the originals."
msgstr "A lefordított bejegyzések slugjainak újragenerálása az eredetikkel való ütközések megelőzésére."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/FlushTranslationsCache.php:11
msgid "Clearing Translations Cache"
msgstr "Fordítások gyorsítótárának törlése"

#. translators: Description of the "Clearing Translations Cache" import step,
#. shown under the step name; "it" is the cache.
#: classes/Commands/FlushTranslationsCache.php:16
msgid "Invalidating the persistent cache so it can be regenerated."
msgstr "A tartós gyorsítótár érvénytelenítése, hogy újra létre lehessen hozni."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/MarkAncestorsForParentLanguageFix.php:42
msgid "Marking Parent Terms for Connection"
msgstr "Szülő kifejezések megjelölése az összekapcsoláshoz"

#. translators: Description of the "Marking Parent Terms for Connection"
#. import step, shown under the step name; "their" refers to the parent terms.
#: classes/Commands/MarkAncestorsForParentLanguageFix.php:50
msgid ""
"Collecting parent terms to connect their translations in the next step."
msgstr "Szülő kifejezések összegyűjtése, hogy a következő lépésben összekapcsolhatók legyenek a fordításaik."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/ReassignPostsToTranslatedTerms.php:40
msgid "Connecting Posts with Correct Term Translations"
msgstr "Bejegyzések összekapcsolása a megfelelő kifejezésfordításokkal"

#: classes/Commands/ReassignPostsToTranslatedTerms.php:47
msgid ""
"Ensuring posts are connected to terms in the correct language, especially if"
" you have the same term names across languages."
msgstr "Annak biztosítása, hogy a bejegyzések a megfelelő nyelvű kifejezésekhez legyenek kapcsolva, különösen, ha több nyelven azonos nevű kifejezéseid vannak."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/RegisterImportedTranslations.php:46
msgid "Registering Imported Translations"
msgstr "Importált fordítások regisztrálása"

#: classes/Commands/RegisterImportedTranslations.php:53
msgid ""
"Marking the imported translations as complete, so that WPML knows when the "
"original changes."
msgstr "Az importált fordítások készre jelölése, hogy a WPML tudja, mikor változik az eredeti."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SendPostsToAutomaticTranslation.php:44
msgid "Sending Posts for Automatic Translation"
msgstr "Bejegyzések küldése automatikus fordításra"

#: classes/Commands/SendPostsToAutomaticTranslation.php:51
msgid ""
"Creating automatic translation jobs for posts flagged for auto-translation "
"in the exported data."
msgstr "Automatikus fordítási feladatok létrehozása az exportált adatokban automatikus fordításra megjelölt bejegyzésekhez."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SetAttachmentsLanguage.php:34
msgid "Setting Attachments' Language"
msgstr "Mellékletek nyelvének beállítása"

#: classes/Commands/SetAttachmentsLanguage.php:41
msgid "Assigning a language to imported attachments."
msgstr "Nyelv hozzárendelése az importált mellékletekhez."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SetFinalPostsStatus.php:39
msgid "Updating Final Post Status"
msgstr "Végleges bejegyzésállapot beállítása"

#: classes/Commands/SetFinalPostsStatus.php:46
msgid ""
"Setting the post status based on the "
"\"_wpml_import_after_process_post_status\" field from the import file (if "
"provided)."
msgstr "A bejegyzés állapotának beállítása az importfájl „_wpml_import_after_process_post_status” mezője alapján, ha meg van adva."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SetInlineTermsLanguage.php:45
msgid "Identifying Inline Term Languages"
msgstr "Beágyazott kifejezések nyelvének azonosítása"

#: classes/Commands/SetInlineTermsLanguage.php:52
msgid ""
"Identifying and setting the language of terms created during post imports."
msgstr "A bejegyzések importálása közben létrehozott kifejezések nyelvének azonosítása és beállítása."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SetPostsLanguage.php:17
msgid "Setting Posts’ Language"
msgstr "Bejegyzések nyelvének beállítása"

#: classes/Commands/SetPostsLanguage.php:24
msgid "Connecting posts to the default language and translations."
msgstr "Bejegyzések összekapcsolása az alapértelmezett nyelvvel és a fordításokkal."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SetTermsLanguage.php:18
msgid "Setting Terms’ Language"
msgstr "Kifejezések nyelvének beállítása"

#: classes/Commands/SetTermsLanguage.php:25
msgid ""
"Connecting taxonomy terms to the default (original) language and "
"translations."
msgstr "Az osztályozás (taxonomy) kifejezéseinek összekapcsolása az alapértelmezett (eredeti) nyelvvel és a fordításokkal."

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
#: classes/Commands/SetUnassignedParentTermsLanguage.php:39
msgid "Setting Parent Terms' Language"
msgstr "Szülő kifejezések nyelvének beállítása"

#: classes/Commands/SetUnassignedParentTermsLanguage.php:46
msgid ""
"Assigning language to parent taxonomy terms that don't have one, based on "
"the language assigned to their children."
msgstr "Nyelv hozzárendelése olyan szülő osztályozás (taxonomy) kifejezésekhez, amelyek még nem rendelkeznek ilyennel, a gyermekelemeikhez rendelt nyelv alapján."

#. translators: Notice shown on the WordPress export screen. %s: a link to the
#. WPML Export and Import documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:83
#, php-format
msgid ""
"Migrating your multilingual site? Remember to also install %s on your new "
"site before importing your content so we can restore all the translations."
msgstr "Többnyelvű webhelyet költöztetsz? Ne felejtsd el a %s bővítményt is telepíteni az új webhelyeden, mielőtt importálod a tartalmat, hogy visszaállíthassuk az összes fordítást."

#. translators: Notice shown on the WooCommerce product export screen when
#. WooCommerce Multilingual is not installed. %1$s: a link to the WooCommerce
#. Multilingual documentation, %2$s: a link to the WPML Export and Import
#. documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:95
#, php-format
msgid ""
"Migrating your multilingual shop? With %1$s and %2$s you can transfer your "
"translated content to a new site, including cross-sells, up-sells, and "
"product attributes."
msgstr "Többnyelvű webáruházat költöztetsz? A(z) %1$s és %2$s segítségével átviheted a lefordított tartalmat az új webhelyre, beleértve a keresztértékesítéseket, a felülértékesítéseket és a termékattribútumokat."

#. translators: Notice shown on the WooCommerce product export screen when
#. WooCommerce Multilingual is installed. %1$s: a link to the WooCommerce
#. Multilingual documentation, %2$s: a link to the WPML Export and Import
#. documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:102
#, php-format
msgid ""
"Migrating your multilingual shop? Remember to install %1$s and %2$s on your "
"new site before importing your content so we can restore all the "
"translations."
msgstr "Többnyelvű webáruházat költöztetsz? Ne felejtsd el a(z) %1$s és a(z) %2$s bővítményeket telepíteni az új webhelyeden, mielőtt importálod a tartalmat, hogy visszaállíthassuk az összes fordítást."

#. translators: Notice shown on the WordPress import screen. %s: a link to the
#. WPML Export and Import documentation, with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:114
#, php-format
msgid ""
"Looking to import your multilingual content? Remember to install %s in your "
"original site before exporting its content so we can import all the "
"translations here."
msgstr "Többnyelvű tartalmat szeretnél importálni? Ne felejtsd el a %s bővítményt telepíteni az eredeti webhelyeden a tartalom exportálása előtt, hogy itt importálhassuk az összes fordítást."

#. translators: First line of the notice shown on the WooCommerce product
#. import screen when WooCommerce Multilingual is not installed; a second line
#. follows it. %1$s: a link to the WooCommerce Multilingual documentation,
#. with the plugin name as its text.
#: classes/Integrations/Base/Notice.php:126
#, php-format
msgid ""
"Looking to import your multilingual content? Install %1$s on this site."
msgstr "Többnyelvű tartalmat szeretnél importálni? Telepítsd a(z) %1$s bővítményt ezen a webhelyen."

#. translators: Second line of the notice shown on the WooCommerce product
#. import screen when WooCommerce Multilingual is not installed; the numbering
#. continues from the first line. %2$s: a link to the WooCommerce Multilingual
#. documentation, %3$s: a link to the WPML Export and Import documentation.
#. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:129
#, php-format
msgid ""
"Remember to also enable %2$s and %3$s in your original shop before exporting"
" its content so we can import all the translations here."
msgstr "Ne felejtsd el a(z) %2$s és a(z) %3$s bővítményeket is bekapcsolni az eredeti webáruházadban a tartalom exportálása előtt, hogy itt importálhassuk az összes fordítást."

#. translators: Notice shown on the WooCommerce product import screen when
#. WooCommerce Multilingual is installed. %1$s: a link to the WooCommerce
#. Multilingual documentation, %2$s: a link to the WPML Export and Import
#. documentation. Each link reads as the plugin's name.
#: classes/Integrations/Base/Notice.php:137
#, php-format
msgid ""
"Looking to import your multilingual content? Remember to enable %1$s and "
"%2$s in your original shop before exporting its content so we can import all"
" the translations here."
msgstr "Többnyelvű tartalmat szeretnél importálni? Ne felejtsd el a %1$s és %2$s bővítményeket bekapcsolni az eredeti webáruházadban a tartalom exportálása előtt, hogy itt importálhassuk az összes fordítást."

#. translators: Name of the WooCommerce Multilingual plugin, used as the text
#. and the tooltip of a link to its documentation. Keep the product name in
#. English.
#: classes/Integrations/Base/Notice.php:160
msgid "WooCommerce Multilingual"
msgstr "WooCommerce Multilingual"

#: classes/Integrations/Base/Notice.php:178
msgid "Switch to all languages"
msgstr "Váltás az összes nyelvre"

#. translators: Name of a step in the list of steps WPML Export and Import
#. runs, shown on its screen and by its WP-CLI command. A noun phrase naming
#. what the step does, not an instruction to the user.
