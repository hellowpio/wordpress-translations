msgstr "%s&quot; hozzáadva a rendelésedhez. Fejezd be alább a rendelést."

#. translators: %s: product title
#: woocommerce-one-page-checkout.php:1152
msgid "&quot;%s&quot; was successfully removed from your order."
msgstr "Sikeresen eltávolítottuk a rendelésedből: „%s”"

#. translators: %s: product title
#: woocommerce-one-page-checkout.php:1160
msgid "&quot;%s&quot; could not be removed from your order."
msgstr "Nem sikerült eltávolítani a rendelésedből: „%s”"

#: woocommerce-one-page-checkout.php:1275
#: woocommerce-one-page-checkout.php:1334
msgid "Please choose product options&hellip;"
msgstr "Kérlek, válaszd ki a termékopciókat&hellip;"

#: woocommerce-one-page-checkout.php:1492
msgid ""
"Error processing your request. Please try refreshing the page. Contact us if"
" you continue to have issues."
msgstr "Hiba történt a kérés feldolgozása során. Próbáld meg frissíteni az oldalt. Ha továbbra is problémáid vannak, lépj kapcsolatba velünk."

#. translators: %s: homepage URL
#: woocommerce-one-page-checkout.php:1780
msgid ""
"Sorry, your session has expired. <a href=\"%s\">Return to homepage "
"&rarr;</a>"
msgstr "Sajnáljuk, a munkamenet lejárt. <a href=\"%s\">vissza a kezdőlapra &rarr;</a>"

#: woocommerce-one-page-checkout.php:1781
msgid "You must select a product."
msgstr "Ki kell választanod egy terméket."

