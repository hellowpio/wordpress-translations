msgstr "Engedélyezi a vásárlóknak, hogy hitelkártyával fizessenek a Stripe-on keresztül."

#. Author of the plugin
#: index.php
msgid "Veribo, Roland Murg"
msgstr "Veribo, Roland Murg"

#: includes/base/admin/booking/functions.php:35
msgid ""
"Authorization expired. You can still accept the booking but no payment will "
"be made."
msgstr "A fizetési engedély lejárt. A foglalást továbbra is elfogadhatod, de fizetésre nem kerül sor."

#: includes/base/admin/booking/functions.php:41
msgid "Payment not captured, please click here to retry."
msgstr "A fizetés nem került levonásra, kattints ide az újbóli próbálkozáshoz."

