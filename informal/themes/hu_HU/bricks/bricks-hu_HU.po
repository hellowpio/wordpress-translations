#: ../includes/admin/admin-screen-settings.php:1761
msgid "Remember linked state"
msgstr "Összekapcsolt állapot megjegyzése"

#: ../includes/admin/admin-screen-settings.php:1762
msgid ""
"Remember and apply the linked state (unlinked, opposites linked, all sides "
"linked) per spacing or dimensions setting."
msgstr ""
"Az összekapcsolt állapot (nincs összekapcsolás, ellentétes oldalak "
"összekapcsolása, minden oldal összekapcsolása) megjegyzése és alkalmazása "
"minden térköz- vagy méretbeállításnál."

#: ../includes/admin/admin-screen-settings.php:1766
