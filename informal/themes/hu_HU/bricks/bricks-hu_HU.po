#: ../includes/admin/admin-screen-settings.php:1911,
#: ../includes/admin/admin-screen-settings.php:1916,
#: ../includes/admin/admin-screen-settings.php:1921,
#: ../includes/admin/admin-screen-settings.php:1926,
#: ../includes/admin/admin-screen-settings.php:1931
msgid "MB"
msgstr "MB"

#: ../includes/admin/admin-screen-settings.php:1933
msgid ""
"Set a threshold to 0 to disable oversized-file warnings for that media type."
msgstr ""
"Állítsd a küszöbértéket 0-ra az adott médiatípus túlméretezett fájljaira "
"vonatkozó figyelmeztetések kikapcsolásához."

#: ../includes/admin/admin-screen-settings.php:1938
msgid "Obsolete file extensions"
msgstr "Elavult fájlkiterjesztések"

#: ../includes/admin/admin-screen-settings.php:1940
msgid ""
"Comma-separated file extensions to flag as obsolete, without leading dots."
msgstr ""
"Vesszővel elválasztott fájlkiterjesztések, amelyeket elavultként kell "
"megjelölni, kezdő pontok nélkül."

#: ../includes/admin/admin-screen-settings.php:1947
msgid "Post/page selector"
msgstr "Bejegyzés-/oldalválasztó"

#: ../includes/admin/admin-screen-settings.php:1950
msgid "Show URL path"
msgstr "URL-útvonal megjelenítése"

#: ../includes/admin/admin-screen-settings.php:1956
msgid "Canvas"
msgstr "Vászon"

#: ../includes/admin/admin-screen-settings.php:1959
msgid "Disable element spacing"
msgstr "Elemek közötti térköz letiltása"

#: ../includes/admin/admin-screen-settings.php:1963
msgid "Auto scroll element into view"
msgstr "Elem automatikus görgetése a látható területre"

#: ../includes/admin/admin-screen-settings.php:1967
msgid ""
"Selecting an element in the structure panel scrolls it into view on the "
"canvas."
msgstr ""
"A struktúrapanelen kiválasztott elem a vásznon a látható területre "
"görgetődik."

#: ../includes/admin/admin-screen-settings.php:1968
msgid ""
"Set to \"50%\" to scroll active element into center or \"off\" to disable "
"auto-scroll."
msgstr ""
"Állítsd „50%”-ra az aktív elem középre görgetéséhez, vagy „off”-ra az "
"automatikus görgetés kikapcsolásához."

#: ../includes/admin/admin-screen-settings.php:1973
msgid "Structure panel"
msgstr "Struktúrapanel"

#: ../includes/admin/admin-screen-settings.php:1975,
#: ../includes/admin/admin-screen-settings.php:1997
msgid "Element actions"
msgstr "Elem műveletei"

#: ../includes/admin/admin-screen-settings.php:1987
msgid "Collapse on page load"
msgstr "Összecsukás oldalbetöltéskor"

#: ../includes/admin/admin-screen-settings.php:1991
msgid "Expand active element & scroll into view"
msgstr "Aktív elem kibontása és odagörgetése a látható területre"

#: ../includes/admin/admin-screen-settings.php:1999
msgid "Wrap element"
