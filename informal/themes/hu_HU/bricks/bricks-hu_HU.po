msgid "Show default element names"
msgstr "Alapértelmezett elemnevek megjelenítése"

#: ../includes/admin/admin-screen-settings.php:1771
msgid "Show custom element names"
msgstr "Egyéni elemnevek megjelenítése"

#: ../includes/admin/admin-screen-settings.php:1776
msgid "Responsive control indicator"
msgstr "Reszponzív vezérlő jelzése"

